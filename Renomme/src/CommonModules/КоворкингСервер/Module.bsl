Функция ЕстьКоворкингСчета(Заявка) Экспорт 
Запрос = Новый Запрос("ВЫБРАТЬ ПЕРВЫЕ 1
                      |	КоворкингСчета.Ссылка КАК Ссылка
                      |ИЗ
                      |	Документ.КоворкингСчета КАК КоворкингСчета
                      |ГДЕ
                      |	КоворкингСчета.КоворкингЗаявка = &КоворкингЗаявка");

Запрос.УстановитьПараметр("КоворкингЗаявка", Заявка); 

Результат = Запрос.Выполнить();
Возврат НЕ Результат.Пустой();
КонецФункции
//// - Заявка

Процедура ЗаполнитьЧасыСписокВыбора(ЧасССписокВыбора, ЧасПоСписокВыбора) Экспорт 
ЧасССписокВыбора.Очистить();	
ЧасПоСписокВыбора.Очистить();	

Индекс = Константы.КоворкингНачальныйЧас.Получить();
КоворкингКонечныйЧас = Константы.КоворкингКонечныйЧас.Получить();
Пока Истина Цикл
	ЧасССписокВыбора.Добавить(Индекс);
	ЧасПоСписокВыбора.Добавить(Индекс);
	
	Индекс = Индекс + 1;
	Если Индекс > КоворкингКонечныйЧас Тогда Прервать; КонецЕсли;
КонецЦикла;
КонецПроцедуры

//// + Счета
Функция СледующийСчетДатаС(ЗаявкаОбъект) Экспорт
Запрос = Новый Запрос("ВЫБРАТЬ
                      |	МАКСИМУМ(КоворкингСчета.ДатаПо) КАК ДатаПо
                      |ИЗ
                      |	Документ.КоворкингСчета КАК КоворкингСчета
                      |ГДЕ
                      |	КоворкингСчета.ПометкаУдаления = ЛОЖЬ
                      |	И КоворкингСчета.КоворкингЗаявка = &КоворкингЗаявка");	
Запрос.УстановитьПараметр("КоворкингЗаявка", ЗаявкаОбъект.Ссылка);	
Выборка = Запрос.Выполнить().Выбрать();

Выборка.Следующий();
Если ЗначениеЗаполнено(Выборка.ДатаПо) Тогда
	ДатаС = Выборка.ДатаПо + 86400;
Иначе
	ДатаС = ЗаявкаОбъект.ДатаС;
КонецЕсли;

Возврат ДатаС;
КонецФункции



