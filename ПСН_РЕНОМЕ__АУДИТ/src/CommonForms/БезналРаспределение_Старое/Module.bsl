//
&НаКлиенте
Процедура ВыгрузкаПлатежиПолучательПлатежаПриИзменении(Элемент)
ТД = Элементы.ВыгрузкаПлатежи.ТекущиеДанные;
Если ЗначениеЗаполнено(ТД.ДокументОплаты) Тогда
	ТД.ПолучательПлатежа = ПолучательПлатежа_OldValue;
	
	ПоказатьПредупреждение(, "Есть документ оплаты (выписка) для этого платежа.
	|
	|ИЗМЕНЕНИЕ НЕ РАЗРЕШЕНО ...
	|
	|Для изменения получателя платежа удалите документ оплаты (выписку)."
	);
	
	Элементы.ВыгрузкаПлатежи.ЗакончитьРедактированиеСтроки(Ложь);
	Возврат;
КонецЕсли;

ЗаполнитьСуммаПолучательПлатежа(ТД);

Элементы.ВыгрузкаПлатежи.ЗакончитьРедактированиеСтроки(Ложь);
КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьСуммаПолучательПлатежа(ТД)
Для Каждого Строка Из БезналНастройкиРаспределениеПлатежей Цикл
	Если Строка.ПолучательПлатежаЗначениеСпискаВыбора = ТД.ПолучательПлатежа Тогда 
		ТД[Строка.ИмяРеквизитаФормы] = ТД.СуммаПлатежа;
	Иначе
		ТД[Строка.ИмяРеквизитаФормы] = 0;
	КонецЕсли;
КонецЦикла;
КонецПроцедуры
//

//
&НаКлиенте
Процедура ВыгрузкаПлатежиПередОкончаниемРедактирования(Элемент, НоваяСтрока, ОтменаРедактирования, Отказ)
Если ОтменаРедактирования Тогда Возврат; КонецЕсли;	
	
ТД = Элемент.ТекущиеДанные;

Отказ = ПроверкаСуммыПлатежейПередОкончаниемРедактирования(ТД)
КонецПроцедуры

&НаКлиенте
Функция ПроверкаСуммыПлатежейПередОкончаниемРедактирования(ТД)
ИтогоСуммаПолучателиПлатежа = 0;
Для Каждого Строка Из БезналНастройкиРаспределениеПлатежей Цикл
	ИтогоСуммаПолучателиПлатежа = ИтогоСуммаПолучателиПлатежа +	ТД[Строка.ИмяРеквизитаФормы];
КонецЦикла;	

Если ИтогоСуммаПолучателиПлатежа = 0 Тогда Возврат Ложь; КонецЕсли;

Если ИтогоСуммаПолучателиПлатежа <> ТД.СуммаПлатежа Тогда
	ПоказатьПредупреждение(, "ВНИМАНИЕ: Сумма распределенных платежей НЕ равна сумме платежа");
	Возврат Истина;	
КонецЕсли;

Возврат Ложь;	
КонецФункции

&НаКлиенте
Процедура ВыгрузкаПлатежиПриОкончанииРедактирования(Элемент, НоваяСтрока, ОтменаРедактирования)
ПлатежиПриОкончанииРедактирования("ВыгрузкаПлатежи", Элемент, НоваяСтрока, ОтменаРедактирования);	
КонецПроцедуры

&НаКлиенте
Процедура ПлатежиПриОкончанииРедактирования(ТаблицаДанные, Элемент, НоваяСтрока, ОтменаРедактирования)
Если ОтменаРедактирования Тогда	
	ПоказатьПредупреждение(, "Отмена редактирования
							|
							|ДАННЫЕ НЕ СОХРАНЕНЫ");
	
	ТД = Элемент.ТекущиеДанные; 	
	Для Каждого Строка Из БезналНастройкиРаспределениеПлатежей Цикл
		ТД[Строка.ИмяРеквизитаФормы] = ТД[Строка.ИмяРеквизитаФормы + "_OldValue"]; 
	КонецЦикла;		

	Возврат; 
КонецЕсли;

ТС = Элемент.ТекущаяСтрока; 
ПлатежиПриОкончанииРедактированияНаСервере(ТаблицаДанные, ТС);
КонецПроцедуры

&НаСервере
Процедура ПлатежиПриОкончанииРедактированияНаСервере(ТаблицаДанные, ТС)
ТД = ЭтаФорма[ТаблицаДанные].НайтиПоИдентификатору(ТС);

УстановитьСуммыПлатежейТолькоПросмотр(ТД, ТД);

ОбновитьЗаписьБезнал(ТД);
КонецПроцедуры

&НаСервере
Процедура ОбновитьЗаписьБезнал(ТД)
Запись = РегистрыСведений.БезналЗагрузка.СоздатьМенеджерЗаписи();
Запись.ГУИД = ТД.ГУИД;
Запись.Прочитать();

Запись.ПолучательПлатежа = ТД.ПолучательПлатежа; 

Для Каждого Строка Из БезналНастройкиРаспределениеПлатежей Цикл
	Запись[Строка.ИмяРеквизитаДанные] = ТД[Строка.ИмяРеквизитаФормы]; 
КонецЦикла;

Запись.Записать();
КонецПроцедуры
