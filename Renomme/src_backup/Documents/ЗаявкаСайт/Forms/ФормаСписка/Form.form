  <attributes>
    <name>Список</name>
    <id>1</id>
    <valueType>
      <types>DynamicList</types>
    </valueType>
    <view>
      <common>true</common>
    </view>
    <edit>
      <common>true</common>
    </edit>
    <main>true</main>
    <extInfo xsi:type="form:DynamicListExtInfo">
      <queryText>ВЫБРАТЬ
	ДокументЗаявкаСайт.Ссылка КАК Ссылка,
	ДокументЗаявкаСайт.ПометкаУдаления КАК ПометкаУдаления,
	ДокументЗаявкаСайт.Номер КАК Номер,
	ДокументЗаявкаСайт.Дата КАК Дата,
	ДокументЗаявкаСайт.Проведен КАК Проведен,
	ДокументЗаявкаСайт.ИДСайт КАК ИДСайт,
	ДокументЗаявкаСайт.ДатаЗагрузки КАК ДатаЗагрузки,
	ДокументЗаявкаСайт.ДатаОбновления КАК ДатаОбновления,
	ДокументЗаявкаСайт.ДатаБронирования КАК ДатаБронирования,
	ДокументЗаявкаСайт.ДатаЗаезда КАК ДатаЗаезда,
	ДокументЗаявкаСайт.ДатаВыезда КАК ДатаВыезда,
	ДокументЗаявкаСайт.ВремяЗаезда КАК ВремяЗаезда,
	ДокументЗаявкаСайт.ВремяВыезда КАК ВремяВыезда,
	ДокументЗаявкаСайт.Фамилия КАК Фамилия,
	ДокументЗаявкаСайт.Имя КАК Имя,
	ДокументЗаявкаСайт.Телефон КАК Телефон,
	ДокументЗаявкаСайт.КатегорияНомера КАК КатегорияНомера,
	ДокументЗаявкаСайт.КатегорияНомераСайт КАК КатегорияНомераСайт,
	ДокументЗаявкаСайт.РаздельныеКровати КАК РаздельныеКровати,
	ДокументЗаявкаСайт.Завтрак КАК Завтрак,
	ДокументЗаявкаСайт.Комментарий КАК Комментарий,
	ДокументЗаявкаСайт.ОбщаяСтоимостьПроживания КАК ОбщаяСтоимостьПроживания,
	ДокументЗаявкаСайт.Тариф КАК Тариф,
	ДокументЗаявкаСайт.СуммаОплаченнаяКлиентом КАК СуммаОплаченнаяКлиентом,
	ДокументЗаявкаСайт.ТипОплаты КАК ТипОплаты,
	ДокументЗаявкаСайт.ФлагОплаты КАК ФлагОплаты,
	ДокументЗаявкаСайт.EMail КАК EMail,
	НЕ ЗаявкаНаБронирование.Ссылка ЕСТЬ NULL КАК ЕстьЗаявкаНаБронирование,
	ВЫБОР
		КОГДА ДокументЗаявкаСайт.Фамилия &lt;> &quot;&quot;
			ТОГДА ВЫБОР
					КОГДА ДокументЗаявкаСайт.Имя &lt;> &quot;&quot;
						ТОГДА ДокументЗаявкаСайт.Фамилия + &quot; &quot; + ДокументЗаявкаСайт.Имя
					ИНАЧЕ ДокументЗаявкаСайт.Фамилия
				КОНЕЦ
		ИНАЧЕ ВЫБОР
				КОГДА ДокументЗаявкаСайт.Имя &lt;> &quot;&quot;
					ТОГДА ДокументЗаявкаСайт.Имя
				ИНАЧЕ &quot;&quot;
			КОНЕЦ
	КОНЕЦ КАК ФИО
ИЗ
	Документ.ЗаявкаСайт КАК ДокументЗаявкаСайт
		ЛЕВОЕ СОЕДИНЕНИЕ Документ.ЗаявкаНаБронирование КАК ЗаявкаНаБронирование
		ПО ДокументЗаявкаСайт.Ссылка = ЗаявкаНаБронирование.ЗаявкаСайт
ГДЕ
	ВЫБОР
			КОГДА &amp;ТолькоНовые
				ТОГДА ЗаявкаНаБронирование.Ссылка ЕСТЬ NULL
			ИНАЧЕ ИСТИНА
		КОНЕЦ</queryText>
      <mainTable>Document.ЗаявкаСайт</mainTable>
      <dynamicDataRead>true</dynamicDataRead>
      <autoFillAvailableFields>true</autoFillAvailableFields>
      <customQuery>true</customQuery>
      <autoSaveUserSettings>true</autoSaveUserSettings>
      <getInvisibleFieldPresentations>true</getInvisibleFieldPresentations>
    </extInfo>
  </attributes>
