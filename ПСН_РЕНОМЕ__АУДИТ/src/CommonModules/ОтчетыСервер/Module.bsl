					  //|		ИЗ
					  //|			Документ.КассовыйДокумент КАК КассовыйДокумент
					  //|				ЛЕВОЕ СОЕДИНЕНИЕ Документ.КассоваяСмена КАК КассоваяСмена
					  //|				ПО КассовыйДокумент.НомерСменыККМ = КассоваяСмена.НомерСменыККТ
					  //|					И (ВЫБОР
					  //|						КОГДА КассоваяСмена.НачалоКассовойСмены ЕСТЬ NULL
					  //|							ТОГДА ИСТИНА
					  //|						ИНАЧЕ НАЧАЛОПЕРИОДА(КассоваяСмена.НачалоКассовойСмены, ГОД) = НАЧАЛОПЕРИОДА(КассовыйДокумент.ДатаОплаты, ГОД)
					  //|					КОНЕЦ)
					  //|		
					  //|		СГРУППИРОВАТЬ ПО
					  //|			КассовыйДокумент.Ссылка,
					  //|			КассоваяСмена.НомерСменыККТ) КАК КассоваяСмена
					  //|		ПО ЗаявкаНаБронированиеРаспределениеОплатДолги.ДокументОплаты = КассоваяСмена.ДокументОплаты
                      |ГДЕ
                      |	ЗаявкаНаБронированиеРаспределениеОплатДолги.Ссылка В (&Заявки)
					  | И НЕ ЗаявкаНаБронированиеРаспределениеОплатДолги.ДокументОплаты.ОтКого ЕСТЬ NULL
                      |
                      |УПОРЯДОЧИТЬ ПО
                      |	ДокументОплатыДатаОплаты,
                      |	ДокументОплаты");


Запрос.УстановитьПараметр("Заявки", Заявки);
ТЗ_Оплаты = Запрос.Выполнить().Выгрузить();	

//
ТЗ_Оплаты_ДокументыОплаты = ТЗ_Оплаты.Скопировать(, "ДокументОплаты");
ТЗ_Оплаты_ДокументыОплаты.Свернуть("ДокументОплаты");
Массив_Оплаты_ДокументыОплаты = ТЗ_Оплаты_ДокументыОплаты.ВыгрузитьКолонку("ДокументОплаты");

Запрос = Новый Запрос("ВЫБРАТЬ
                      |	КассовыйДокумент.Ссылка КАК ДокументОплаты,
                      |	КассоваяСмена.НомерСменыККТ КАК НомерСменыККТ,
                      |	МАКСИМУМ(КассоваяСмена.НачалоКассовойСмены) КАК НачалоКассовойСмены
                      |ИЗ
                      |	Документ.КассовыйДокумент КАК КассовыйДокумент
                      |		ЛЕВОЕ СОЕДИНЕНИЕ Документ.КассоваяСмена КАК КассоваяСмена
                      |		ПО КассовыйДокумент.НомерСменыККМ = КассоваяСмена.НомерСменыККТ
                      |			И (ВЫБОР
                      |				КОГДА КассоваяСмена.НачалоКассовойСмены ЕСТЬ NULL
                      |					ТОГДА ИСТИНА
                      |				ИНАЧЕ НАЧАЛОПЕРИОДА(КассоваяСмена.НачалоКассовойСмены, ГОД) = НАЧАЛОПЕРИОДА(КассовыйДокумент.ДатаОплаты, ГОД)
                      |			КОНЕЦ)
                      |ГДЕ
                      |	КассовыйДокумент.Ссылка В(&ДокументыОплаты)
                      |
                      |СГРУППИРОВАТЬ ПО
                      |	КассовыйДокумент.Ссылка,
                      |	КассоваяСмена.НомерСменыККТ");

Запрос.УстановитьПараметр("ДокументыОплаты", Массив_Оплаты_ДокументыОплаты);

ТЗ = Запрос.Выполнить().Выгрузить();

Для Каждого СтрокаОплаты Из ТЗ_Оплаты Цикл
	СтрокаТЗ = ТЗ.Найти(СтрокаОплаты.ДокументОплаты, "ДокументОплаты");
	Если ЗначениеЗаполнено(СтрокаТЗ) ТОгда
		СтрокаОплаты.ДатаСменыККМ = СтрокаТЗ.НачалоКассовойСмены;
	Иначе
		СтрокаОплаты.ДатаСменыККМ = '00010101';
	КонецЕсли;	
		
КонецЦикла;
//

ТЗ_Оплаты.Колонки.Добавить("ПроцентЭквайринга");
ТЗ_Оплаты.Колонки.Добавить("ПроцентЭквайрингаСБП");
Для Каждого СтрокаОплаты Из ТЗ_Оплаты Цикл
	Запрос = Новый Запрос("ВЫБРАТЬ ПЕРВЫЕ 1
	                      |	ПроцентыЭквайринга.ПроцентЭквайринга КАК ПроцентЭквайринга,
	                      |	ПроцентыЭквайринга.ПроцентЭквайрингаСБП КАК ПроцентЭквайрингаСБП
	                      |ИЗ
	                      |	РегистрСведений.ПроцентыЭквайринга КАК ПроцентыЭквайринга
	                      |ГДЕ
	                      |	ПроцентыЭквайринга.ДатаУстановкиПроцентаЭквайринга < &ДатаУстановкиПроцентаЭквайринга
	                      |
	                      |УПОРЯДОЧИТЬ ПО
	                      |	ПроцентыЭквайринга.ДатаУстановкиПроцентаЭквайринга УБЫВ");

	Если ЗначениеЗаполнено(СтрокаОплаты.ДокументОплаты) Тогда
		ДатаОплаты = СтрокаОплаты.ДокументОплаты.ДатаОплаты;
	Иначе
		ДатаОплаты = '00010101';
	КонецЕсли;
	Запрос.УстановитьПараметр("ДатаУстановкиПроцентаЭквайринга", ДатаОплаты);
	ТЗ = Запрос.Выполнить().Выгрузить();
	ПроцентЭквайринга = ?(ТЗ.Количество() = 0, 0, ТЗ[0].ПроцентЭквайринга); 			
	ПроцентЭквайрингаСБП = ?(ТЗ.Количество() = 0, 0, ТЗ[0].ПроцентЭквайрингаСБП); 			
		
	СтрокаОплаты.ПроцентЭквайринга = ПроцентЭквайринга;
	СтрокаОплаты.ПроцентЭквайрингаСБП = ПроцентЭквайрингаСБП;
КонецЦикла;
	
Для Каждого Строка Из ТЗ_Оплаты Цикл
	Строка.ОстатокДокументаОплаты = Строка.СуммаДокументаОплаты - Строка.СуммаВозвратаДокументаОплаты;
		
	Если ТипЗнч(Строка.ДокументОплаты) = Тип("ДокументСсылка.ВыпискаБанка") Тогда
		Строка.ОстатокДокументаОплаты = Строка.ОстатокДокументаОплаты
			- Строка.ОплатыДокументОплатыВыписка;	
	ИначеЕсли ТипЗнч(Строка.ДокументОплаты) = Тип("ДокументСсылка.КассовыйДокумент") Тогда
		Строка.ОстатокДокументаОплаты = Строка.ОстатокДокументаОплаты
			- Строка.ОплатыДокументОплатыКасса;	
	ИначеЕсли ТипЗнч(Строка.ДокументОплаты) = Тип("ДокументСсылка.ПрочиеОплаты") Тогда
		Строка.ОстатокДокументаОплаты = Строка.ОстатокДокументаОплаты
			- Строка.ОплатыДокументОплатыПрочиеОплаты;	
	КонецЕсли;
	
	Если НЕ ЗначениеЗаполнено(Строка.КонтрагентНаименование) Тогда
		Строка.КонтрагентНаименование = Строка.ДокументОплатыОтКого.Наименование;	
	КонецЕсли;
	
КонецЦикла;

//Для Каждого Строка Из ТЗ_Оплаты Цикл
//	Если НЕ ЗначениеЗаполнено(Строка.КонтрагентНаименование) Тогда
//		Строка.КонтрагентНаименование = Строка.ДокументОплатыОтКого.Наименование;	
//	КонецЕсли;
//КонецЦикла;

Возврат ТЗ_Оплаты;
КонецФункции

Функция ТЗ_ОплатыЗаявка(ТЗ_ОплатыЗаявки, Заявка) Экспорт
ОтборСтроки = Новый Структура("Заявка", Заявка); 
ТЗ_ОплатыЗаявка = ТЗ_ОплатыЗаявки.Скопировать(ОтборСтроки);	

Возврат ТЗ_ОплатыЗаявка;		
КонецФункции
//

Функция ТЗ_ОплатыЗаявка_ЧерезЗапрос(Заявка) Экспорт
                     
Запрос = Новый Запрос("ВЫБРАТЬ
                      |	ЗаявкаНаБронированиеРаспределениеОплатДолги.Ссылка КАК Заявка,
                      |	ЗаявкаНаБронированиеРаспределениеОплатДолги.ДокументОплаты КАК ДокументОплаты,
                      |	ЗаявкаНаБронированиеРаспределениеОплатДолги.СчетГУИД КАК СчетГУИД,
                      |	ЗаявкаНаБронированиеРаспределениеОплатДолги.Услуга КАК Услуга,
                      |	ЗаявкаНаБронированиеРаспределениеОплатДолги.ДолгиГУИД КАК ДолгиГУИД,
                      |	ЗаявкаНаБронированиеРаспределениеОплатДолги.СуммаОплаты КАК СуммаОплаты,
					  |	ЗаявкаДетальноОплаты.ГрупповаяОплата КАК ГрупповаяОплата,
					  //|	ЛОЖЬ КАК ГрупповаяОплата,
                      |	ЗаявкаНаБронированиеРаспределениеОплатДолги.ДокументОплаты.ДатаОплаты КАК ДокументОплатыДатаОплаты,
                      |	ЗаявкаНаБронированиеРаспределениеОплатДолги.ДокументОплаты.Номер КАК НомерДокументаОплаты,
                      |	ЗаявкаНаБронированиеРаспределениеОплатДолги.ДокументОплаты.Дата КАК ДатаДокументаОплаты,
                      |	ЕСТЬNULL(ЗаявкаНаБронированиеРаспределениеОплатДолги.ДокументОплаты.Сумма, 0) КАК СуммаДокументаОплаты,
                      |	ЗаявкаНаБронированиеРаспределениеОплатДолги.ДокументОплаты.ОтКого КАК ДокументОплатыОтКого,
                      |	ВЫБОР
                      |		КОГДА ЗаявкаНаБронированиеРаспределениеОплатДолги.ДокументОплаты.ОтКого.ТипКлиента = ЗНАЧЕНИЕ(Перечисление.ТипыКлиентов.ЮрЛицо)
                      |			ТОГДА ЗаявкаНаБронированиеРаспределениеОплатДолги.ДокументОплаты.ОтКого.НаименованиеЮрЛица
                      |		ИНАЧЕ ЗаявкаНаБронированиеРаспределениеОплатДолги.ДокументОплаты.ОтКого.Наименование
                      |	КОНЕЦ КАК КонтрагентНаименование,
                      |	ВЫБОР
                      |		КОГДА ТИПЗНАЧЕНИЯ(ЗаявкаНаБронированиеРаспределениеОплатДолги.ДокументОплаты) = ТИП(Документ.КассовыйДокумент)
                      |			ТОГДА ЗаявкаНаБронированиеРаспределениеОплатДолги.ДокументОплаты.Сумма
                      |		ИНАЧЕ 0
                      |	КОНЕЦ КАК СуммаДокументаОплатыКасса,
                      |	ВЫБОР
                      |		КОГДА ТИПЗНАЧЕНИЯ(ЗаявкаНаБронированиеРаспределениеОплатДолги.ДокументОплаты) = ТИП(Документ.КассовыйДокумент)
                      |			ТОГДА ЗаявкаНаБронированиеРаспределениеОплатДолги.ДокументОплаты.СуммаНаличные
                      |		ИНАЧЕ 0
                      |	КОНЕЦ КАК СуммаДокументаОплатыНаличные,
                      |	ВЫБОР
                      |		КОГДА ТИПЗНАЧЕНИЯ(ЗаявкаНаБронированиеРаспределениеОплатДолги.ДокументОплаты) = ТИП(Документ.КассовыйДокумент)
                      |			ТОГДА ЗаявкаНаБронированиеРаспределениеОплатДолги.ДокументОплаты.СуммаКарта
                      |		ИНАЧЕ 0
                      |	КОНЕЦ КАК СуммаДокументаОплатыКарта,
                      |	ВЫБОР
                      |		КОГДА ТИПЗНАЧЕНИЯ(ЗаявкаНаБронированиеРаспределениеОплатДолги.ДокументОплаты) = ТИП(Документ.ВыпискаБанка)
                      |			ТОГДА ЕСТЬNULL(ВозвратыВыписка.Сумма, 0)
                      |		КОГДА ТИПЗНАЧЕНИЯ(ЗаявкаНаБронированиеРаспределениеОплатДолги.ДокументОплаты) = ТИП(Документ.КассовыйДокумент)
                      |			ТОГДА ЕСТЬNULL(ВозвратыКасса.Сумма, 0)
                      |		ИНАЧЕ 0
                      |	КОНЕЦ КАК СуммаВозвратаДокументаОплаты,
                      |	ВЫБОР
                      |		КОГДА ТИПЗНАЧЕНИЯ(ЗаявкаНаБронированиеРаспределениеОплатДолги.ДокументОплаты) = ТИП(Документ.КассовыйДокумент)
                      |			ТОГДА ЕСТЬNULL(ВозвратыКасса.СуммаКарта, 0)
                      |		ИНАЧЕ 0
                      |	КОНЕЦ КАК СуммаВозвратаДокументаОплатыКарта,
                      |	ВЫБОР
                      |		КОГДА ТИПЗНАЧЕНИЯ(ЗаявкаНаБронированиеРаспределениеОплатДолги.ДокументОплаты) = ТИП(Документ.КассовыйДокумент)
                      |			ТОГДА ЕСТЬNULL(ВозвратыКасса.СуммаНаличные, 0)
                      |		ИНАЧЕ 0
                      |	КОНЕЦ КАК СуммаВозвратаДокументаОплатаНаличные,
                      |	0 КАК ОстатокДокументаОплаты,
                      |	ЕСТЬNULL(ОплатыДокументОплатыВыписка.Сумма, 0) КАК ОплатыДокументОплатыВыписка,
                      |	ЕСТЬNULL(ОплатыДокументОплатыКасса.Сумма, 0) КАК ОплатыДокументОплатыКасса,
                      |	ЕСТЬNULL(ОплатыДокументОплатыПрочиеОплаты.Сумма, 0) КАК ОплатыДокументОплатыПрочиеОплаты,
                      |	ВЫБОР
                      |		КОГДА ТИПЗНАЧЕНИЯ(ЗаявкаНаБронированиеРаспределениеОплатДолги.ДокументОплаты) = ТИП(Документ.ПрочиеОплаты)
                      |			ТОГДА ВЫБОР
                      |					КОГДА ЗаявкаНаБронированиеРаспределениеОплатДолги.ДокументОплаты.ВидОперации = ЗНАЧЕНИЕ(Справочник.ВидыОпераций.Взаимозачет)
                      |						ТОГДА 9
                      |					КОГДА ЗаявкаНаБронированиеРаспределениеОплатДолги.ДокументОплаты.ВидОперации = ЗНАЧЕНИЕ(Справочник.ВидыОпераций.Списание)
                      |						ТОГДА 10
                      |					КОГДА ЗаявкаНаБронированиеРаспределениеОплатДолги.ДокументОплаты.ВидОперации = ЗНАЧЕНИЕ(Справочник.ВидыОпераций.СписаниеДопУслуг)
                      |						ТОГДА 11
                      |					КОГДА ЗаявкаНаБронированиеРаспределениеОплатДолги.ДокументОплаты.ВидОперации = ЗНАЧЕНИЕ(Справочник.ВидыОпераций.СписаниеЗачет)
                      |						ТОГДА 12
                      |					ИНАЧЕ 10
                      |				КОНЕЦ
                      |		ИНАЧЕ ВЫБОР
                      |				КОГДА ТИПЗНАЧЕНИЯ(ЗаявкаНаБронированиеРаспределениеОплатДолги.ДокументОплаты) = ТИП(Документ.ВыпискаБанка)
                      |					ТОГДА ВЫБОР
                      |							КОГДА ЗаявкаНаБронированиеРаспределениеОплатДолги.ДокументОплаты.ВидОперации = ЗНАЧЕНИЕ(Справочник.ВидыОпераций.оverbooking)
                      |								ТОГДА 8
                      |							КОГДА ЗаявкаНаБронированиеРаспределениеОплатДолги.ДокументОплаты.ЭтоЭквайринг
                      |								ТОГДА ВЫБОР
                      |										КОГДА ЗаявкаНаБронированиеРаспределениеОплатДолги.ДокументОплаты.ТекстПлатежа ПОДОБНО ""%СБП%""
                      |											ТОГДА 5
                      |										ИНАЧЕ 4
                      |									КОНЕЦ
                      |							ИНАЧЕ 3
                      |						КОНЕЦ
                      |				ИНАЧЕ ВЫБОР
                      |						КОГДА ЗаявкаНаБронированиеРаспределениеОплатДолги.ДокументОплаты.ВидОперации = ЗНАЧЕНИЕ(Справочник.ВидыОпераций.оverbooking)
                      |							ТОГДА 8
                      |						КОГДА ЗаявкаНаБронированиеРаспределениеОплатДолги.ДокументОплаты.СуммаНаличные = 0
                      |								И ЗаявкаНаБронированиеРаспределениеОплатДолги.ДокументОплаты.СуммаКарта > 0
                      |							ТОГДА 1
                      |						ИНАЧЕ ВЫБОР
                      |								КОГДА ЗаявкаНаБронированиеРаспределениеОплатДолги.ДокументОплаты.СуммаНаличные > 0
                      |										И ЗаявкаНаБронированиеРаспределениеОплатДолги.ДокументОплаты.СуммаКарта = 0
                      |									ТОГДА 2
                      |								ИНАЧЕ 0
                      |							КОНЕЦ
                      |					КОНЕЦ
                      |			КОНЕЦ
                      |	КОНЕЦ КАК ТипОплаты,
                      |	ВЫБОР
                      |		КОГДА ТИПЗНАЧЕНИЯ(ЗаявкаНаБронированиеРаспределениеОплатДолги.ДокументОплаты) = ТИП(Документ.ВыпискаБанка)
                      |			ТОГДА ЗаявкаНаБронированиеРаспределениеОплатДолги.ДокументОплаты.ЭтоЭквайринг
                      |		ИНАЧЕ ЛОЖЬ
                      |	КОНЕЦ КАК ЭтоЭквайринг,
                      |	ВЫБОР
                      |		КОГДА ТИПЗНАЧЕНИЯ(ЗаявкаНаБронированиеРаспределениеОплатДолги.ДокументОплаты) = ТИП(Документ.ВыпискаБанка)
                      |			ТОГДА ""ВБ""
                      |		КОГДА ТИПЗНАЧЕНИЯ(ЗаявкаНаБронированиеРаспределениеОплатДолги.ДокументОплаты) = ТИП(Документ.КассовыйДокумент)
                      |			ТОГДА ""КД""
                      |		КОГДА ТИПЗНАЧЕНИЯ(ЗаявкаНаБронированиеРаспределениеОплатДолги.ДокументОплаты) = ТИП(Документ.ПрочиеОплаты)
                      |			ТОГДА ""ПО""
                      |		ИНАЧЕ ""Ошибка""
