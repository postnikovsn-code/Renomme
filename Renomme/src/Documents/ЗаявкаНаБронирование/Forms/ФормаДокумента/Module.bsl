Функция РассчитатьСуммуЗаПроживание(СсылкаДок=Неопределено, ПеременныйТариф=Ложь)
СуммаПроживание = ДокументыСервер.РассчитатьСуммуЗаПроживание(Объект); 
Возврат СуммаПроживание; 
КонецФункции

&НаСервере
Функция ПолучитьСтруктуруРеквизитовПечатьДоговораНаСервере(Клиент)
Ответ = Новый Структура;
Ответ.Вставить("Номер", Объект.НомерВРезерв.Наименование);
Ответ.Вставить("Категория", Объект.КатегорияНомера.Наименование);
//Ответ.Вставить("Заезд", Формат(Объект.РезервС, "ДФ=dd.MM.yyyy"));
Заезд = ?(ЗначениеЗаполнено(Объект.ВремяЗаездаТочное), Формат(Объект.ВремяЗаездаТочное, "ДФ=dd.MM.yyyy")
								, Формат(Объект.РезервС, "ДФ=dd.MM.yyyy"));
Ответ.Вставить("Заезд", Заезд);
Ответ.Вставить("Выезд", Формат(Объект.РезервПо, "ДФ=dd.MM.yyyy"));
Ответ.Вставить("Сутки", Строка(Объект.КолВоДней));
Ответ.Вставить("ФИО", Клиент.Наименование);
Ответ.Вставить("ДатаРождения", Формат(Объект.Клиент.ДатаРождения, "ДФ=dd.MM.yyyy"));

Паспорт = Объект.Клиент.Серия + " " + Объект.Клиент.Номер;
Ответ.Вставить("Паспорт", Паспорт);
Ответ.Вставить("Выдан", Объект.Клиент.КемВыдан);
Ответ.Вставить("Заявка", Объект.Номер);

Ответ.Вставить("ДатаТекущая", Формат(ТекущаяДата(), "ДФ=dd.MM.yyyy"));    

Ответ.Вставить("ТелефонНомер", Объект.Клиент.Телефон);   

Возврат Ответ;
КонецФункции	

&НаСервере 
Функция ПолучитьДанныеОбъектаПечатьДоговораНаСервере(Клиент)
Ответ = Новый Структура;
Ответ.Вставить("КлиентНаименование", Клиент.Наименование);
//Ответ.Вставить("НомерВРезервКатегорияНомераНаименование", Объект.КатегорияНомера.Наименование);
Ответ.Вставить("КатегорияНомераНаименование", Объект.КатегорияНомера.Наименование);
Ответ.Вставить("КлиентСерия", Клиент.Серия);
Ответ.Вставить("КлиентНомер", Клиент.Номер);
Ответ.Вставить("КлиентКемВыдан", Клиент.КемВыдан);
Ответ.Вставить("КлиентДатаВыдачи", Клиент.ДатаВыдачи);

Возврат Ответ;
КонецФункции	
