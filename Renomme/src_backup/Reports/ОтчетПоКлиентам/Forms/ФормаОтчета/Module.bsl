&НаСервере
Функция СформироватьНаСервере() 
	////	Диалог = Новый ДиалогВыбораФайла(РежимДиалогаВыбораФайла.Открытие);
	////	Диалог.Каталог = "C:\";
	////	
	////	Диалог.Заголовок = "Выберите файл";
	////	Если Диалог.Выбрать() Тогда
	////		ФайлИмя = Диалог.ПолноеИмяФайла;
	////	КонецЕсли;
	
	//Макет=ПолучитьМакет("Макет1");
	Макет = Отчеты.ОтчетПоКлиентам.ПолучитьМакет("Макет1");
	
	ЗапросРаз=Новый Запрос("ВЫБРАТЬ
	                       |	ВложенныйЗапрос.Клиент,
	                       |	ВложенныйЗапрос.Ссылка
	                       |ИЗ
	                       |	(ВЫБРАТЬ
	                       |		ЗаявкаНаБронирование.Клиент КАК Клиент,
	                       |		КОЛИЧЕСТВО(РАЗЛИЧНЫЕ ЗаявкаНаБронирование.Ссылка) КАК Ссылка
	                       |	ИЗ
	                       |		Документ.ЗаявкаНаБронирование КАК ЗаявкаНаБронирование
	                       |	
	                       |	СГРУППИРОВАТЬ ПО
	                       |		ЗаявкаНаБронирование.Клиент) КАК ВложенныйЗапрос
	                       |ГДЕ
	                       |	ВложенныйЗапрос.Ссылка > 1");
						   
						   
	ТЗРаз=ЗапросРаз.Выполнить().Выгрузить();	
	////Обл=Макет.ПолучитьОбласть("Шапка");
	////Обл.Параметры.заголовок="Шахматка";
	////ЭлементыФормы.ПолеОтчета.Вывести(Обл);
	
	ВывестиШахматку(НачалоНедели(ТекущаяДата()),КонецНедели(ТекущаяДата()),"Час");
	
	ИмяФайла_Chess = Константы.Папка_C_BASE.Получить();
	ИмяФайла_Chess = ИмяФайла_Chess + "REP\Chess.xls"; 
	//ЭлементыФормы.ПолеОтчета.Записать("C:\BASE\REP\Chess.xls",ТипФайлаТабличногоДокумента.XLS97);
	ПолеОтчета.Записать(ИмяФайла_Chess,ТипФайлаТабличногоДокумента.XLS97);
	
	//ЭлементыФормы.ПолеОтчета.Очистить();
	ПолеОтчета.Очистить();
	
	Обл=Макет.ПолучитьОбласть("Шапка");
	Обл.Параметры.заголовок="Проживающие на "+ Формат(ТекущаяДата(), "ДФ=dd.MM.yy");
	//ЭлементыФормы.ПолеОтчета.Вывести(Обл);
	ПолеОтчета.Вывести(Обл);
	ТаблДок=Новый ТабличныйДокумент;
	
	Обл=Макет.ПолучитьОбласть("Шапка2|ШапкаВерх");
	
	ЗапросВиды=Новый Запрос("ВЫБРАТЬ РАЗЛИЧНЫЕ
	                        |	КлиентыПрочаяИнформация.ВидИнформации
	                        |ИЗ
	                        |	Справочник.Клиенты.ПрочаяИнформация КАК КлиентыПрочаяИнформация
	                        |ГДЕ
	                        |	КлиентыПрочаяИнформация.Ссылка В
	                        |			(ВЫБРАТЬ РАЗЛИЧНЫЕ
	                        |				ЗанятостьНомеров.Клиент
	                        |			ИЗ
	                        |				РегистрСведений.ЗанятостьНомеров КАК ЗанятостьНомеров
	                        |			ГДЕ
	                        |				ЗанятостьНомеров.ПериодРезерва МЕЖДУ &ДН И &ДК
	                        |				И ЗанятостьНомеров.Регистратор.Статус = &Статус)
	                        |	И КлиентыПрочаяИнформация.ВидИнформации.Наименование <> ""Возраст""");
	ЗапросВиды.УстановитьПараметр("Статус",Перечисления.СтатусБрони.Проживает);			 								   
	ЗапросВиды.УстановитьПараметр("ДН",НачалоДня(ТекущаяДата()));			 
	ЗапросВиды.УстановитьПараметр("ДК",КонецДня(ТекущаяДата()));

	ТЗИнфПоКл=ЗапросВиды.Выполнить().Выгрузить();
	
	
	ЗапросВиды=Новый Запрос("ВЫБРАТЬ РАЗЛИЧНЫЕ
	                        |	ЗаявкаНаБронированиеДопПожелания.ВидИнформации
	                        |ИЗ
	                        |	Документ.ЗаявкаНаБронирование.ДопПожелания КАК ЗаявкаНаБронированиеДопПожелания
	                        |ГДЕ
	                        |	ЗаявкаНаБронированиеДопПожелания.Ссылка.Клиент В
	                        |			(ВЫБРАТЬ РАЗЛИЧНЫЕ
	                        |				ЗанятостьНомеров.Клиент
	                        |			ИЗ
	                        |				РегистрСведений.ЗанятостьНомеров КАК ЗанятостьНомеров
	                        |			ГДЕ
	                        |				ЗанятостьНомеров.ПериодРезерва МЕЖДУ &ДН И &ДК
	                        |				И ЗанятостьНомеров.Регистратор.Статус = &Статус)
	                        |	И ЗаявкаНаБронированиеДопПожелания.ВидИнформации.Наименование <> ""Возраст""");
	ЗапросВиды.УстановитьПараметр("Статус",Перечисления.СтатусБрони.Проживает);			 								   
	ЗапросВиды.УстановитьПараметр("ДН",НачалоДня(ТекущаяДата()));			 
	ЗапросВиды.УстановитьПараметр("ДК",КонецДня(ТекущаяДата()));

	ТЗИнфПоПос=ЗапросВиды.Выполнить().Выгрузить();
	ТаблДок.Присоединить(Обл);
	Обл=Макет.ПолучитьОбласть("Шапка2|Инф");
	Обл.Параметры.Инф="Возраст";
		ТаблДок.Присоединить(Обл);
		Обл.Параметры.Инф="Город";
		ТаблДок.Присоединить(Обл);
		Обл.Параметры.Инф="Страна";
		ТаблДок.Присоединить(Обл);
		Обл.Параметры.Инф="Скидка";
		ТаблДок.Присоединить(Обл);

	Для каждого Стр Из ТЗИнфПоКл Цикл
		Если Стр.ВидИнформации.Наименование="" тогда
			Продолжить;
		конецесли;
		Обл.Параметры.Инф=?(Стр.ВидИнформации.Наименование="","Город/Страна",Стр.ВидИнформации.Наименование);
		ТаблДок.Присоединить(Обл);		
	КонецЦикла; 
	Для каждого Стр Из ТЗИнфПоПос Цикл
		Если Стр.ВидИнформации.Наименование="" тогда
			Продолжить;
		конецесли;
		
		Обл.Параметры.Инф=?(Стр.ВидИнформации.Наименование="","Администратор",Стр.ВидИнформации.Наименование);
		ТаблДок.Присоединить(Обл);		
	КонецЦикла; 	
	//ЭлементыФормы.ПолеОтчета.Вывести(ТаблДок);
	ПолеОтчета.Вывести(ТаблДок);
	
	ЗапросПроживающих=Новый Запрос("ВЫБРАТЬ РАЗЛИЧНЫЕ
	                               |	ЗанятостьНомеров.Клиент,
	                               |	ЗанятостьНомеров.Номер КАК Номер,
	                               |	ЗанятостьНомеров.Регистратор
	                               |ИЗ
	                               |	РегистрСведений.ЗанятостьНомеров КАК ЗанятостьНомеров
	                               |ГДЕ
	                               |	ЗанятостьНомеров.ПериодРезерва МЕЖДУ &ДН И &ДК
	                               |	И ЗанятостьНомеров.Регистратор.Статус = &Статус
	                               |
	                               |УПОРЯДОЧИТЬ ПО
	                               |	ЗанятостьНомеров.Номер.Наименование");
	ЗапросПроживающих.УстановитьПараметр("Статус",Перечисления.СтатусБрони.Проживает);			 								   
	ЗапросПроживающих.УстановитьПараметр("ДН",НачалоДня(ТекущаяДата()));			 
	ЗапросПроживающих.УстановитьПараметр("ДК",КонецДня(ТекущаяДата()));
	СписокПроживающих=ЗапросПроживающих.Выполнить().Выгрузить();
	
	Для каждого Прож Из СписокПроживающих Цикл
		ТаблДок=Новый ТабличныйДокумент;

		Обл=Макет.ПолучитьОбласть("Строка|ШапкаВерх");
		//Проживает	Бронирует	Оплачивает	Дата заезда	Дата выезда	Номер  ДатаЗаезда	ДатаВыезда
		Обл.Параметры.Проживает=Прож.Клиент.Наименование;
		//Обл.Параметры.Бронирует=Прож.Регистратор.бронирует.Наименование;
		//Обл.Параметры.Оплачивает=Прож.Регистратор.Оплачивает.Наименование;
		ПоискКол=ТЗРаз.Найти(Прож.Клиент,"Клиент");
		Обл.Параметры.Раз=?(ПоискКол=Неопределено,"1",ПоискКол.Ссылка);
		Обл.Параметры.ДатаЗаезда=Формат(Прож.Регистратор.РезервС, "ДФ=dd.MM.yy");
		Обл.Параметры.ДатаВыезда=Формат(Прож.Регистратор.РезервПо, "ДФ=dd.MM.yy");
		Обл.Параметры.Номер=Прож.Регистратор.НомерВРезерв.Наименование;
		ТаблДок.Присоединить(Обл);
		Обл=Макет.ПолучитьОбласть("Строка|Инф");
		Возраст=Окр(((ТекущаяДата()-Прож.Клиент.ДатаРождения)/86400)/365);
		Обл.Параметры.Инф=?(Возраст>100,"--",Возраст);
		ТаблДок.Присоединить(Обл);
		Обл.Параметры.Инф=Прож.Клиент.Город.Наименование;
		ТаблДок.Присоединить(Обл);
		Обл.Параметры.Инф=Прож.Клиент.Страна.Наименование;
		ТаблДок.Присоединить(Обл);
		Обл.Параметры.Инф=?(Прож.Клиент.Категория.Пустая(),"0",Строка(Прож.Клиент.Категория.Скидка));
		ТаблДок.Присоединить(Обл);

				Для каждого Стр Из ТЗИнфПоКл Цикл
			Если Стр.ВидИнформации.Наименование="" тогда
				Продолжить;
			конецесли;
			Поиск=Прож.Клиент.ПрочаяИнформация.найти(Стр.ВидИнформации,"ВидИнформации");
			Если Поиск=Неопределено тогда
