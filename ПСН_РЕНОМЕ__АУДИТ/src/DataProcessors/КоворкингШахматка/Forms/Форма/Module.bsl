// + Выбор
&НаКлиенте
Процедура ПолеОтчетаВыбор(Элемент, Область, СтандартнаяОбработка)
ИмяЭлемента = Элемент.Имя;
Если ИмяЭлемента = "ПолеШахматкиДни" Тогда
	ДниЧасы = "Дни";
ИначеЕсли ИмяЭлемента = "ПолеШахматкиЧасы" Тогда
	ДниЧасы = "Часы";
Иначе
	Возврат;
КонецЕсли;
	
Тек=ОпределитьПоКоординатам(Область.Лево-2,Область.Верх-3, ДниЧасы);	
Если НЕ ЗначениеЗаполнено(Тек.Клиент) тогда Возврат; КонецЕсли;

Если ТипЗнч(Тек.Регистратор) = Тип("ДокументСсылка.КоворкингСчета") тогда
	ПараметрыФормы = Новый Структура("Ключ", Тек.Регистратор);
	
	ОткрытьФорму("Документ.КоворкингСчета.Форма.ФормаДокумента", ПараметрыФормы, ЭтаФорма
		,,,,, РежимОткрытияОкнаФормы.Независимый);
		
Иначе
	ПараметрыФормы = Новый Структура("Ключ", Тек.Регистратор);
	ОткрытьФорму("Документ.КоворкингЗаявка.Форма.ФормаДокумента", ПараметрыФормы, ЭтаФорма
		,,,,, РежимОткрытияОкнаФормы.Независимый);
		
конецесли;
КонецПроцедуры

&НаКлиенте
Функция ОпределитьПоКоординатам(х,у, ДниЧасы)
	
ВозврСтр=Новый Структура("Клиент, Номер, Период, Регистратор, Счет"
	,ПредопределенноеЗначение("Справочник.Клиенты.ПустаяСсылка")
	,ПредопределенноеЗначение("Справочник.КоворкингНомера.ПустаяСсылка")
	,ТекущаяДата()
	,ПредопределенноеЗначение("Документ.КоворкингЗаявка.ПустаяСсылка")
	,ПредопределенноеЗначение("Документ.КоворкингСчета.ПустаяСсылка"));
	
	
Отбор=Новый Структура("Х,У",Х,У);
Если ДниЧасы = "Дни" Тогда
	Стр=ТЗШахматкаДни.НайтиСтроки(Отбор);
ИначеЕсли ДниЧасы = "Часы" Тогда
	Стр=ТЗШахматкаЧасы.НайтиСтроки(Отбор);
Иначе
	Возврат ВозврСтр;
КонецЕсли;
	
Если Стр.Количество()=0 тогда
	Возврат ВозврСтр;
иначе
	ВозврСтр.Клиент=Стр[0].Клиент;
	ВозврСтр.Номер=Стр[0].Номер;
	ВозврСтр.Период=Стр[0].Период;

	ВозврСтр.Регистратор=Стр[0].Регистратор;
	//ВозврСтр.Счет=Стр[0].Счет;
	
	//ВозврСтр.Документ=Стр[0].Документ;
	Возврат ВозврСтр;
КонецЕсли;
КонецФункции
// - Выбор


