Функция ЦенаДня(ДТН, ТЗЦен, КатегорияНомера, БезЗавтрака, ПроцентСкидкиБезЗавтрака, БазоваяЦенаОдноместный, БазоваяЦенаДвухместный) Экспорт
Если ТЗЦен.Количество()=0 тогда
	ИзменениеЦеныОдноместный = 0;
	ИзменениеЦеныДвухместный = 0;
Иначе
	Если ПроцентСкидкиБезЗавтрака <> 0 И БезЗавтрака Тогда
		БезЗавтрака_П = Ложь;
	Иначе
		БезЗавтрака_П = БезЗавтрака;
	КонецЕсли;
			
	ПоискЦ = ТЗЦен.НайтиСтроки(Новый Структура("ДатаЦены, КатегорияНомера, БезЗавтрака, Двухместный"
		, ДТН, КатегорияНомера, БезЗавтрака_П, Ложь));
	Если ПоискЦ.Количество() = 0 Тогда
		ИзменениеЦеныОдноместный = 0;
	Иначе
		ИзменениеЦеныОдноместный = ?(ПоискЦ.Количество()=0, 0, ПоискЦ[0].ПроцентИзменения);
	КонецЕсли;
	
	ПоискЦ2=ТЗЦен.НайтиСтроки(Новый Структура("ДатаЦены, КатегорияНомера, БезЗавтрака,Двухместный"
		, ДТН, КатегорияНомера, БезЗавтрака_П, Истина));
	Если ПоискЦ2.Количество() = 0 Тогда
		ИзменениеЦеныДвухместный = 0;
	Иначе
		ИзменениеЦеныДвухместный=?(ПоискЦ2.Количество()=0, 0, ПоискЦ2[0].ПроцентИзменения);
	КонецЕсли;
КонецЕсли;

ЦенаДняОдноместный = БазоваяЦенаОдноместный + ИзменениеЦеныОдноместный;
ЦенаДняДвухместный = БазоваяЦенаДвухместный + ИзменениеЦеныДвухместный;

Если БезЗавтрака И ПроцентСкидкиБезЗавтрака <> 0 Тогда
	ЦенаДняОдноместный = ДокументыСервер_Старый.ЦенаПроцентСкидкиБезЗавтрака(ЦенаДняОдноместный, ПроцентСкидкиБезЗавтрака); 
	ЦенаДняДвухместный = ДокументыСервер_Старый.ЦенаПроцентСкидкиБезЗавтрака(ЦенаДняДвухместный, ПроцентСкидкиБезЗавтрака); 
КонецЕсли;

Результат = Новый Структура("ЦенаДняОдноместный, ИзменениеЦеныОдноместный, ЦенаДняДвухместный, ИзменениеЦеныДвухместный"
	, ЦенаДняОдноместный, ИзменениеЦеныОдноместный, ЦенаДняДвухместный, ИзменениеЦеныДвухместный);
Возврат Результат;
КонецФункции
