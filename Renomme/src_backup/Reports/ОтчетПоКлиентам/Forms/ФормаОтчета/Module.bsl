&НаСервере
Функция ОтчетАудитНаСервере(ДТ)
	Запрос=Новый Запрос("ВЫБРАТЬ
	                    |	ЕжедневныйАудитПроданныеНомера.Ссылка,
	                    |	ЕжедневныйАудитПроданныеНомера.НомерСтроки КАК НомерСтроки,
	                    |	ЕжедневныйАудитПроданныеНомера.Бронь,
	                    |	ЕжедневныйАудитПроданныеНомера.Клиент,
	                    |	ЕжедневныйАудитПроданныеНомера.НомерВРезерв,
	                    |	ЕжедневныйАудитПроданныеНомера.Коэф,
	                    |	ЕжедневныйАудитПроданныеНомера.СуммаЗаПроживание,
	                    |	ЕжедневныйАудитПроданныеНомера.Заезд,
	                    |	ЕжедневныйАудитПроданныеНомера.ЗаездКоррекция,
	                    |	ЕжедневныйАудитПроданныеНомера.Выезд,
	                    |	ЕжедневныйАудитПроданныеНомера.ВыездКоррекция,
	                    |	ЕжедневныйАудитПроданныеНомера.Тариф_НеИспользуется,
	                    |	ЕжедневныйАудитПроданныеНомера.ТарифКоррекция,
	                    |	ЕжедневныйАудитПроданныеНомера.СуммаКоррекция,
	                    |	ЕжедневныйАудитПроданныеНомера.СуммаЗаПроживаниеПлан,
	                    |	ЕжедневныйАудитПроданныеНомера.Комментарий
	                    |ИЗ
	                    |	Документ.ЕжедневныйАудит.ПроданныеНомера КАК ЕжедневныйАудитПроданныеНомера
	                    |ГДЕ
	                    |	ЕжедневныйАудитПроданныеНомера.Ссылка.Дата МЕЖДУ &ДН И &ДК
	                    |
	                    |УПОРЯДОЧИТЬ ПО
	                    |	НомерСтроки");	
	Запрос.УстановитьПараметр("ДН",НачалоДня(ДТ));
	Запрос.УстановитьПараметр("ДК",КонецДня(ДТ));
	ТЗ=Запрос.Выполнить().Выгрузить();
	
	//Макет=ПолучитьМакет("МакетАудит");
	Макет = Отчеты.ОтчетПоКлиентам.ПолучитьМакет("МакетАудит");
	
	ТабДок=Новый ТабличныйДокумент;
	
	Обл=Макет.ПолучитьОбласть("Шапка");
	ТабДок.Вывести(Обл);
	
	Для каждого стр из ТЗ цикл
		Обл=Макет.ПолучитьОбласть("Строка");
		Обл.Параметры.Заполнить(стр);
		ТабДок.Вывести(Обл);
	КонецЦикла;
	
	////ТабДок.Показать();
	
	ИмяФайла = Константы.Папка_C_BASE.Получить();
	ИмяФайла = ИмяФайла + "REP\Audit_"+Формат(ДТ, "ДФ=ddMMyy")+".xls";  
	//ТабДок.Записать("C:\BASE\REP\Audit_"+Формат(ДТ, "ДФ=ddMMyy")+".xls",ТипФайлаТабличногоДокумента.XLS97);
	ТабДок.Записать(ИмяФайла, ТипФайлаТабличногоДокумента.XLS97);
	
	// + ПСН Переносено в Аудит  
	//ОтправитьМыломАудит("Аудит за " + Формат(ДТ, "ДФ=dd.MM.yy"),"C:\BASE\REP\Audit_"+Формат(ДТ, "ДФ=ddMMyy")+".xls","","");
	// - ПСН Переносено в Аудит 
	
	Ответ = Новый Структура;
	Ответ.Вставить("Тема", "Аудит за " + Формат(ДТ, "ДФ=dd.MM.yy"));  
	Ответ.Вставить("Файл1", ИмяФайла);  
	//Ответ.Вставить("Файл2", "");  
	//Ответ.Вставить("Получатель", "");  
	
	Возврат Ответ;
КонецФункции
