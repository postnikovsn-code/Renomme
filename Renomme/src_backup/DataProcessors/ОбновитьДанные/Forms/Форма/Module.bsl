&НаКлиенте
Процедура ОбновитьПредварительныеГрупповыеСчета(Команда)
	ОбновитьПредварительныеГрупповыеСчетаНаСервере();
КонецПроцедуры

&НаСервере
Процедура ОбновитьПредварительныеГрупповыеСчетаНаСервере()
Запрос = Новый Запрос("ВЫБРАТЬ РАЗЛИЧНЫЕ
                      |	ЗаявкаНаБронированиеСчета.Ссылка КАК Ссылка
                      |ИЗ
                      |	Документ.ЗаявкаНаБронирование.Счета КАК ЗаявкаНаБронированиеСчета
                      |ГДЕ
                      |	ЗаявкаНаБронированиеСчета.Ссылка.ПометкаУдаления = ЛОЖЬ
                      |	И ЗаявкаНаБронированиеСчета.Контрагент.Турагентство = ИСТИНА
                      |
                      |СГРУППИРОВАТЬ ПО
                      |	ЗаявкаНаБронированиеСчета.Ссылка");

ТЗ = Запрос.Выполнить().Выгрузить();					  

Для Каждого Строка Из ТЗ Цикл
	ЗаявкаОбъект = Строка.Ссылка.ПолучитьОбъект();
	
	НеЗаписать = Истина;
	Для Каждого Счет Из ЗаявкаОбъект.Счета Цикл
		Если НЕ Счет.Контрагент.Турагентство Тогда Продолжить; КонецЕсли;
		Если Счет.ЭтоПредварительныйГрупповойСчет Тогда Продолжить; КонецЕсли;
		
		НеЗаписать = Ложь;
		
		Счет.ЭтоПредварительныйГрупповойСчет = Истина;
		
		ЭтоГрупповойСчет = ЗначениеЗаполнено(Счет.ГрупповойСчет);
		
		ОтборСтрокиДолги = Новый Структура("СчетГУИД", Счет.СчетГУИД); 
		НайденныеСчетаДетальноДолги = ЗаявкаОбъект.СчетаДетальноДолги.НайтиСтроки(ОтборСтрокиДолги);
		Для Каждого СтрокаДолг Из НайденныеСчетаДетальноДолги Цикл
			СтрокаДолг.ГрупповойСчет = ЭтоГрупповойСчет;
		КонецЦикла;
	КонецЦикла;
	
	Если НеЗаписать Тогда Продолжить; КонецЕсли;
	
	ЗаявкаОбъект.Записать(РежимЗаписиДокумента.Проведение);
КонецЦикла;
КонецПроцедуры

&НаСервере
Процедура ОбновитьПредварительныеГрупповыеСчетаНаСервере_1()
Запрос = Новый Запрос("ВЫБРАТЬ РАЗЛИЧНЫЕ
                      |	ЗаявкаНаБронированиеСчета.Ссылка КАК Ссылка
                      |ИЗ
                      |	Документ.ЗаявкаНаБронирование.Счета КАК ЗаявкаНаБронированиеСчета
                      |ГДЕ
                      |	ЗаявкаНаБронированиеСчета.Ссылка.ПометкаУдаления = ЛОЖЬ
                      |	И ЗаявкаНаБронированиеСчета.ЭтоПредварительныйГрупповойСчет = ИСТИНА");

ТЗ = Запрос.Выполнить().Выгрузить();					  

Для Каждого Строка Из ТЗ Цикл
	ЗаявкаОбъект = Строка.Ссылка.ПолучитьОбъект();
	
	ОтборСтроки = Новый Структура("ЭтоПредварительныйГрупповойСчет", Истина);
	НайденныеСчета = ЗаявкаОбъект.Счета.НайтиСтроки(ОтборСтроки); 
	
	Для Каждого Счет Из НайденныеСчета Цикл
		ЭтоГрупповойСчет = ЗначениеЗаполнено(Счет.ГрупповойСчет);
		
		ОтборСтрокиДолги = Новый Структура("СчетГУИД", Счет.СчетГУИД); 
		НайденныеСчетаДетальноДолги = ЗаявкаОбъект.СчетаДетальноДолги.НайтиСтроки(ОтборСтрокиДолги);
		Для Каждого СтрокаДолг Из НайденныеСчетаДетальноДолги Цикл
			СтрокаДолг.ГрупповойСчет = ЭтоГрупповойСчет;
		КонецЦикла;
	КонецЦикла;
			
	ЗаявкаОбъект.Записать(РежимЗаписиДокумента.Проведение);
КонецЦикла;
КонецПроцедуры
