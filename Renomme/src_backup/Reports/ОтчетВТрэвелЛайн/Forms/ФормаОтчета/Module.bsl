	                      |		СГРУППИРОВАТЬ ПО
	                      |			ЗаявкаНаБронирование.КатегорияНомера) КАК Данные
	                      |		ПО КатегорииНомеров.Ссылка = Данные.КатегорияНомера
	                      |
	                      |УПОРЯДОЧИТЬ ПО
	                      |	КатегорииНомеров.Номер_пп");
	
	Запрос.УстановитьПараметр("Дата", Дата_П);
	ТЗ = Запрос.Выполнить().Выгрузить();
	
	ЭтоПерваяСтрока = Истина;
	Для Каждого Строка Из ТЗ Цикл
		
		ОбластьСтрока = Макет.ПолучитьОбласть("Строка");
		
		ОбластьСтрока.Параметры.Дата = Формат(Дата_П, "ДФ=dd.MM.yyyy");;	
		ОбластьСтрока.Параметры.ТипНомера = Строка.КатегорияНомера;
		
		ОбластьСтрока.Параметры.ЗаездНомеров = Строка.Заезд;
		ОбластьСтрока.Параметры.ПроживаетНомеров = Строка.Проживает;
		
		ЗанятоНомеров = Строка.Заезд + Строка.Проживает;
		ОбластьСтрока.Параметры.ЗанятоНомеров = ЗанятоНомеров;
		
		ОтборСтрок = Новый Структура("КатегорияНомера", Строка.КатегорияНомера);
		НайденныеСтроки = ТЗКатегории.НайтиСтроки(ОтборСтрок);
		Если НайденныеСтроки.Количество() > 0 Тогда
			ВсегоНомеров = НайденныеСтроки[0].ВсегоНомеров;	
			ОбластьСтрока.Параметры.ВсегоНомеров = ВсегоНомеров;	
			
			Если ВсегоНомеров > 0 Тогда
				ПроцентЗанятыхНомеров = Окр((ЗанятоНомеров / ВсегоНомеров) * 100); 
				ОбластьСтрока.Параметры.ПроцентЗанятыхНомеров = ПроцентЗанятыхНомеров;
			КонецЕсли;
		Иначе
			Продолжить;
		КонецЕсли;
		
		Если ЭтоПерваяСтрока Тогда
			//Обл = ОбластьСтрока.Область(,1,,10);
			//Линия = Новый Линия(ТипЛинииЯчейкиТабличногоДокумента.Сплошная, 1);
			//Обл.ГраницаСверху = Линия;
			
			ЭтоПерваяСтрока = Ложь;
		КонецЕсли;
		
		СвободноНомеров = ВсегоНомеров - ЗанятоНомеров;
		ОбластьСтрока.Параметры.СвободноНомеров = СвободноНомеров;
		
//		
		ОбластьСтрока.Параметры.ЗаездГости = Строка.ЗаездГости;
		ОбластьСтрока.Параметры.ПроживаетГости = Строка.ПроживаетГости;
		
		ПрогнозГости = Строка.ЗаездГости + Строка.ПроживаетГости;
		ОбластьСтрока.Параметры.ПрогнозГости = ПрогнозГости;
//		
		ОбластьСтрока.Параметры.Продажи = Строка.СуммаБезСкидки;
		ОбластьСтрока.Параметры.Доходы = Строка.Сумма;
		
		ТабДок.Вывести(ОбластьСтрока);
	КонецЦикла;
	
	Дата_П = Дата_П + 24 * 60 * 60;
КонецЦикла;	

//ОбластьСтрока = Макет.ПолучитьОбласть("Строка");
//Обл = ОбластьСтрока.Область(,1,,10);
//Линия = Новый Линия(ТипЛинииЯчейкиТабличногоДокумента.Сплошная, 1);
//Обл.ГраницаСверху = Линия;

