ОтборСтроки = Новый Структура("ПолучательПлатежаЗначениеСпискаВыбора", ПолучательПлатежа_Константа);
НайденыеСтроки = БезналНастройкиРаспределениеПлатежей.НайтиСтроки(ОтборСтроки);
СтрокаРаспределениеПлатежей = НайденыеСтроки[0];
	
СуммаПлатежа = ЭквайрингВыгрузкаПлатежиТекущиеДанные[СтрокаРаспределениеПлатежей.ИмяРеквизитаФормы];

Если СуммаПлатежа = 0 Тогда
	ПоказатьПредупреждение(, "Платеж не распределен на " + СтрокаРаспределениеПлатежей.ПолучательПлатежа + " 
			|
			|НЕЧЕГО ОТМЕНЯТЬ ...");
	
	Возврат;
КонецЕсли;

СуммаАннулировано = ЭквайрингВыгрузкаПлатежиТекущиеДанные.СуммаАннулировано;

