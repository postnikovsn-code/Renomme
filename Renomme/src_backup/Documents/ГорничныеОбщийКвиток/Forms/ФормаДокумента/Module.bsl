&НаКлиенте
Процедура ГорничныеПриАктивизацииСтроки(Элемент)
ТД = Элемент.ТекущиеДанные;
Квиток.Очистить();
Если ТД = Неопределено Тогда Возврат; КонецЕсли;

ОтборСтроки = Новый Структура("Горничная", ТД.Горничная);
НайденныеСтроки = ТЗ_Квитки.НайтиСтроки(ОтборСтроки);
Если НайденныеСтроки.Количество() = 0 Тогда Возврат; КонецЕсли;

СуммаНачисления = 0;
СуммаВыплаты = 0;
Для Каждого Строка Из НайденныеСтроки Цикл
	НоваяСтрока = Квиток.Добавить();
	ЗаполнитьЗначенияСвойств(НоваяСтрока, Строка);
	
	Если Строка.Количество_Есть Тогда
		НоваяСтрока.Количество_Э = Строка.Количество_Р; 
	Иначе
		НоваяСтрока.Количество_Э = Строка.Количество; 
	КонецЕсли;	
	
	Если Строка.Сумма_Есть Тогда
		НоваяСтрока.Сумма_Э = Строка.Сумма_Р; 
	Иначе
		НоваяСтрока.Сумма_Э = Строка.Сумма; 
	КонецЕсли;	
	
	Если СтрНайти(НоваяСтрока.КодЗаполнения, "Помещение_") > 0 Тогда
		НоваяСтрока.Сумма_Э = НоваяСтрока.Количество_Э * НоваяСтрока.Цена;
	КонецЕсли;
	
	Если Строка.ТипСтроки = 1 Тогда
		СуммаНачисления = СуммаНачисления + НоваяСтрока.Сумма_Э;
	КонецЕсли;	
	
	Если Строка.ТипСтроки = -1 Тогда
		СуммаВыплаты = СуммаВыплаты + НоваяСтрока.Сумма_Э;
	КонецЕсли;	
КонецЦикла;

ОтборСтроки = Новый Структура("КодЗаполнения", "ИтогоНачисления");
НайденныеСтроки = Квиток.НайтиСтроки(ОтборСтроки);
НайденныеСтроки[0].Сумма_Э = СуммаНачисления;

ОтборСтроки = Новый Структура("КодЗаполнения", "ОстатокКВыплате");
НайденныеСтроки = Квиток.НайтиСтроки(ОтборСтроки);
НайденныеСтроки[0].Сумма_Э = СуммаНачисления - СуммаВыплаты;

КонецПроцедуры
//

&НаКлиенте
Функция КвитокИтоги()
СуммаНачисления = 0;
СуммаВыплаты = 0;
Для Каждого Строка Из Квиток Цикл
	Если Строка.ТипСтроки = 1 Тогда
		СуммаНачисления = СуммаНачисления + Строка.Сумма_Э;
	КонецЕсли;
		
	Если Строка.ТипСтроки = -1 Тогда
		СуммаВыплаты = СуммаВыплаты + Строка.Сумма_Э;
	КонецЕсли;
КонецЦикла;

ОстатокКВыплате = СуммаНачисления - СуммаВыплаты; 

КвитокИтоги = Новый Структура("ИтогоНачисления, ОстатокКВыплате", СуммаНачисления, ОстатокКВыплате);
Возврат КвитокИтоги;
КонецФункции	

