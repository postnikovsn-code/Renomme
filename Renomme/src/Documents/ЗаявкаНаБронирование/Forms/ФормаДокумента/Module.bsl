&НаКлиенте
Процедура СчетаПриАктивизацииСтроки(Элемент)
ТекущиеДанные = Элемент.ТекущиеДанные;	
Если ТекущиеДанные = Неопределено Тогда 
	СчетГУИД = ОбщийФункционалСервер.УникальныйИдентификаторПустой();
	Элементы.СчетаДетальноСтроки.ОтборСтрок = Новый ФиксированнаяСтруктура("СчетГУИД", СчетГУИД);	
	
	Возврат; 
КонецЕсли;

ЭтоПредварительныйГрупповойСчет_OldValue = ТекущиеДанные.ЭтоПредварительныйГрупповойСчет;
//ЭтоСчетЭквайринг_OldValue = ТекущиеДанные.ЭтоСчетЭквайринг;

СчетГУИД = ТекущиеДанные.СчетГУИД;
Элементы.СчетаДетальноСтроки.ОтборСтрок = Новый ФиксированнаяСтруктура("СчетГУИД", СчетГУИД);	
КонецПроцедуры
