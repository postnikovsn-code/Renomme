КонецПроцедуры

&НаСервере
Процедура ДобавитьПроданныеНомераОтклонения()
ТЗРеквизиты = ОбщийФункционалСервер.РеквизитыИзТабличнаяЧастьДокумента("ЕжедневныйАудит", "ПроданныеНомера");	

ИмяРеквизитаФормы = "ПроданныеНомераОтклонения";

МассивТипа = Новый Массив;
МассивТипа.Добавить(Тип("ТаблицаЗначений"));
ОписаниеТипа = Новый ОписаниеТипов(МассивТипа);
МассивРеквизитов = Новый Массив;
МассивРеквизитов.Добавить(Новый РеквизитФормы(ИмяРеквизитаФормы, ОписаниеТипа, ""));

Для Каждого Строка Из ТЗРеквизиты Цикл
	МассивРеквизитов.Добавить(Новый РеквизитФормы(Строка.Имя, Строка.Тип, ИмяРеквизитаФормы, Строка.Синоним));
КонецЦикла;

МассивТипа = Новый Массив;
МассивТипа.Добавить(Тип("Число"));
ОписаниеТипа = Новый ОписаниеТипов(МассивТипа, Новый КвалификаторыЧисла(4));
МассивРеквизитов.Добавить(Новый РеквизитФормы("НомерСтроки", ОписаниеТипа, ИмяРеквизитаФормы));

ИзменитьРеквизиты(МассивРеквизитов); 

ГруппаПроданныеНомераОтклонения = Элементы.ГруппаПроданныеНомераОтклонения;
ЭлементПроданныеНомераОтклонения = Элементы.Добавить(ИмяРеквизитаФормы, Тип("ТаблицаФормы"), ГруппаПроданныеНомераОтклонения);
ЭлементПроданныеНомераОтклонения.ПутьКДанным = ИмяРеквизитаФормы;
ЭлементПроданныеНомераОтклонения.Отображение = ОтображениеТаблицы.Список;

ЭлементПроданныеНомераОтклонения.УстановитьДействие("ПередНачаломДобавления", "Подключаемый_ПроданныеНомераОтклоненияПередНачаломДобавления");
ЭлементПроданныеНомераОтклонения.УстановитьДействие("ПередУдалением", "Подключаемый_ПроданныеНомераОтклоненияПередУдалением");

//ЭлементПроданныеНомераОтклонения.ПоложениеКоманднойПанели = ПоложениеКоманднойПанелиЭлементаФормы.Нет;  

//123456789012345
//ПроданныеНомера
//12345678901234567890123
//Объект.ПроданныеНомера
Для Каждого Элемент Из Элементы.ПроданныеНомера.ПодчиненныеЭлементы Цикл
	
	Если ТипЗнч(Элемент.Вид) = Тип("ВидГруппыФормы") Тогда 
		Имя = Сред(Элемент.Имя, 16); 
		НоваяГруппа = Элементы.Добавить(Имя, Тип("ГруппаФормы"), ЭлементПроданныеНомераОтклонения);  
		НоваяГруппа.Заголовок = Элемент.Заголовок;
		НоваяГруппа.Видимость = Элемент.Видимость;
		Для Каждого ЭлементГруппы Из Элемент.ПодчиненныеЭлементы Цикл
			ДобавитьЭлемент(ЭлементГруппы, ИмяРеквизитаФормы, НоваяГруппа);
		КонецЦикла
	Иначе
		ДобавитьЭлемент(Элемент, ИмяРеквизитаФормы, ЭлементПроданныеНомераОтклонения);
	КонецЕсли;    
КонецЦикла;
ЭлементКомментарий = ЭлементПроданныеНомераОтклонения.ПодчиненныеЭлементы.Найти(ИмяРеквизитаФормы + "Комментарий");
ЗаполнитьКомментарийСвойства(ЭлементКомментарий);

ЭлементКомментарий.УстановитьДействие("ПриИзменении", "ПроданныеНомераОтклоненияКомментарийПриИзменении");
КонецПроцедуры

