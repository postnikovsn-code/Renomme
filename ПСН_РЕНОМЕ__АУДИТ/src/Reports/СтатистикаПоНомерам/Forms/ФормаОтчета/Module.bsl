	Для каждого Строка Из Стр.Ссылка.Проживание Цикл
		Если Строка.ДеньПроживания < Отчет.ДН ИЛИ Строка.ДеньПроживания > Отчет.ДК
		Тогда Продолжить; КонецЕсли;
		
		КоличествоСутокВПериоде = КоличествоСутокВПериоде + Строка.Количество; 
	КонецЦикла;
	Обл.Параметры.СутокВПериоде = КоличествоСутокВПериоде;
	
	КоличествоСутокВПериодеИтого = КоличествоСутокВПериодеИтого + КоличествоСутокВПериоде;
	
	КоличествоЧеловекоНочей =  Стр.Ссылка.КолВоЧеловек * КоличествоСутокВПериоде;
	Обл.Параметры.КоличествоЧеловекоНочей = КоличествоЧеловекоНочей;
	
	КоличествоЧеловекоНочейИтого = КоличествоЧеловекоНочейИтого + КоличествоЧеловекоНочей;
	
	Если Стр.Ссылка.РаздельныеКровати Тогда
		//РК = Стр.Ссылка.КолВоЧеловек;
		РК = КоличествоСутокВПериоде;
		РКИтого = РКИтого + РК;
		
		Обл.Параметры.РК = РК;
	КонецЕсли;	
	
	СтрКом="";
	Для каждого Комм Из Стр.Ссылка.ДопПожелания Цикл
		СтрКом=СтрКом+" "+Комм.Информация; 
	КонецЦикла; 
	Обл.Параметры.Комент=СокрЛП(СтрКом);
	
	ПолеОтчета.Вывести(Обл);
КонецЦикла; 

