&НаСервере
Процедура ЗавершениеСостяниеНомераЗаявкаНаСервере(Результат)
Запрос = Новый Запрос("ВЫБРАТЬ
                      |	ДопУслуги.Ссылка КАК Услуга,
                      |	ДопУслуги.НоменклатураМинибара КАК НоменклатураМинибара
                      |ИЗ
                      |	Справочник.ДопУслуги КАК ДопУслуги
                      |ГДЕ
                      |	ДопУслуги.ПометкаУдаления = ЛОЖЬ
                      |	И ДопУслуги.НоменклатураМинибара <> ЗНАЧЕНИЕ(Справочник.НоменклатураМинибара.ПустаяСсылка)");

ТЗ_УслугиМинибар = Запрос.Выполнить().Выгрузить(); 

Для Каждого Строка Из Результат Цикл
	
	ЕстьСоответствие = Ложь;
	Для Каждого СтрокаУслуги Из Объект.ДопУслуги Цикл
		
		Если СтрокаУслуги.Услуга.НоменклатураМинибара = Строка.НоменклатураМинибара 
		И СтрокаУслуги.ДатаУслуги = Строка.ДатаОбслуживания 
		Тогда
			СтрокаУслуги.Цена = Строка.НоменклатураМинибара.Цена;
			СтрокаУслуги.Количество = Строка.Количество;
			
			ЕстьСоответствие = Истина;
			
			Прервать;
		КонецЕсли;
	КонецЦикла;
	
	Если НЕ ЕстьСоответствие Тогда
		ОтборСтроки = Новый Структура("НоменклатураМинибара", Строка.НоменклатураМинибара);
		НайденныеСтроки = ТЗ_УслугиМинибар.НайтиСтроки(ОтборСтроки);
		
		Если НайденныеСтроки.Количество() > 0 Тогда
			НоваяСтрока = Объект.ДопУслуги.Добавить();
			
			НоваяСтрока.ГУИД = Новый УникальныйИдентификатор;
			
			Услуга = НайденныеСтроки[0].Услуга; 
			НоваяСтрока.Услуга = Услуга;
			
			НоваяСтрока.Цена = Строка.НоменклатураМинибара.Цена;
			НоваяСтрока.Количество = Строка.Количество;
			НоваяСтрока.ДатаУслуги = Строка.ДатаОбслуживания;
			
			НоваяСтрока.ВСчет = Истина;
			НоваяСтрока.ЗагруженоГорничные = Истина;
		
		Иначе
			Сообщить("Не найдена услуга, соответствующая номенклатуре минибара: " 
				+ Строка.НоменклатураМинибара + Строка.НоменклатураМинибараНаименование 
				+ ". НОМЕНКЛАТУРА НЕ ВЫГРУЖЕНА ...");
		КонецЕсли;	
		
	КонецЕсли;
КонецЦикла;	
	
КонецПроцедуры
