Функция ТипОплатыСписокВыбора() Экспорт
СписокВыбора = Новый СписокЗначений;

СписокВыбора.Добавить("нал");
СписокВыбора.Добавить("к/к");
СписокВыбора.Добавить("смеш.");
СписокВыбора.Добавить("б/н");
СписокВыбора.Добавить("п/к");
СписокВыбора.Добавить("сбп");
СписокВыбора.Добавить("в/з");
СписокВыбора.Добавить("спис.");
СписокВыбора.Добавить("спис. услуги");
СписокВыбора.Добавить("спис. зачет");
СписокВыбора.Добавить("оverbooking");

Возврат СписокВыбора;
КонецФункции

Функция ТипОплатыНаименование(ТипОплаты) Экспорт
Если ТипОплаты = 0 Тогда	
	Возврат "смеш.";
ИначеЕсли ТипОплаты = 1 Тогда	
	Возврат "к/к";
ИначеЕсли ТипОплаты = 2 Тогда	
	Возврат "нал";
ИначеЕсли ТипОплаты = 3 Тогда	
	Возврат "б/н";
ИначеЕсли ТипОплаты = 4 Тогда	
	Возврат "п/к";
ИначеЕсли ТипОплаты = 5 Тогда	
	Возврат "сбп";
ИначеЕсли ТипОплаты = 8 Тогда	
	Возврат "оverbooking";
ИначеЕсли ТипОплаты = 9 Тогда	
	Возврат "в/з";
ИначеЕсли ТипОплаты = 10 ИЛИ ТипОплаты = 11 Тогда	
	Возврат "спис.";
ИначеЕсли ТипОплаты = 11 Тогда	
	Возврат "спис. услуги";
ИначеЕсли ТипОплаты = 12 Тогда	
	Возврат "спис. зачет";
КонецЕсли;

Возврат "";	
КонецФункции

Функция ТипПлатежаНаименование(ДокументПлатежа) Экспорт
Если ТипЗнч(ДокументПлатежа) = Тип("ДокументСсылка.ВыпискаБанка") Тогда	
	Возврат "ВБ";
ИначеЕсли ТипЗнч(ДокументПлатежа) = Тип("ДокументСсылка.ПрочиеОплаты") Тогда	
	Возврат "ПО";
ИначеЕсли ТипЗнч(ДокументПлатежа) = Тип("ДокументСсылка.КассовыйДокумент") Тогда	
	Возврат "КД";
КонецЕсли;

Возврат "";	
КонецФункции

Функция ОплатилНаименование(Строка) Экспорт
Если ЗначениеЗаполнено(Строка.ДокументОплаты) Тогда
	
	Если Строка.ТипОплаты = 0 Тогда	
		Возврат "Гость смеш.";
	ИначеЕсли Строка.ТипОплаты = 1 Тогда	
		Возврат "Гость к/к";
	ИначеЕсли Строка.ТипОплаты = 2 Тогда	
		Возврат "Гость нал";
	ИначеЕсли Строка.ТипОплаты = 3 Тогда	
		Возврат "" + Строка.КонтрагентНаименование + " б/н";
	ИначеЕсли Строка.ТипОплаты = 4 Тогда	
		Возврат "Гость п/к";
	ИначеЕсли Строка.ТипОплаты = 5 Тогда	
		Возврат "Гость сбп";
	ИначеЕсли Строка.ТипОплаты = 9 Тогда	
		//Возврат "" + Строка.ДокументОплаты.ОтКого + " в/з";
		Возврат "" + Строка.КонтрагентНаименование + " в/з";
	КонецЕсли;
Иначе
	Возврат "";	
КонецЕсли;
КонецФункции
