&НаСервере
Функция ПересеченияНомеровНаСервере(ДН,ДК,Вывести=Ложь)
	Запрос=Новый Запрос("ВЫБРАТЬ
	                    |	КОЛИЧЕСТВО(РАЗЛИЧНЫЕ ЗанятостьНомеров.Регистратор) КАК Регистратор,
	                    |	ЗанятостьНомеров.Номер,
	                    |	ЗанятостьНомеров.ПериодРезерва
	                    |ПОМЕСТИТЬ ТЕМП
	                    |ИЗ
	                    |	РегистрСведений.ЗанятостьНомеров КАК ЗанятостьНомеров
	                    |ГДЕ
	                    |	ЗанятостьНомеров.ПериодРезерва МЕЖДУ &П1 И &П2
	                    |
	                    |СГРУППИРОВАТЬ ПО
	                    |	ЗанятостьНомеров.Номер,
	                    |	ЗанятостьНомеров.ПериодРезерва
	                    |;
	                    |
	                    |////////////////////////////////////////////////////////////////////////////////
	                    |ВЫБРАТЬ
	                    |	КОЛИЧЕСТВО(ТЕМП.Регистратор) КАК Регистратор,
	                    |	ТЕМП.Номер КАК Номер,
	                    |	НАЧАЛОПЕРИОДА(ТЕМП.ПериодРезерва, ДЕНЬ) КАК ПериодРезерва
	                    |ПОМЕСТИТЬ ТЕМП2
	                    |ИЗ
	                    |	ТЕМП КАК ТЕМП
	                    |ГДЕ
	                    |	ТЕМП.Регистратор > 1
	                    |
	                    |СГРУППИРОВАТЬ ПО
	                    |	ТЕМП.Номер,
	                    |	НАЧАЛОПЕРИОДА(ТЕМП.ПериодРезерва, ДЕНЬ)
	                    |;
	                    |
	                    |////////////////////////////////////////////////////////////////////////////////
	                    |ВЫБРАТЬ
	                    |	ТЕМП2.Номер,
	                    |	ТЕМП2.ПериодРезерва как Дата
	                    |ИЗ
	                    |	ТЕМП2 КАК ТЕМП2
	                    |ГДЕ
	                    |	ТЕМП2.Регистратор > 1");
Запрос.УстановитьПараметр("П1",ДН);
Запрос.УстановитьПараметр("П2",ДК);

ТЗ=Запрос.Выполнить().Выгрузить();

//ЭлементыФормы.ОсновныеДействияФормы.Кнопки.ПересеченияНомеров.Текст="Пересечения броней (" + Строка(ТЗ.Количество())+")";
Элементы.ПересеченияНомеровКоманда.Заголовок = "Пересечения броней (" + Строка(ТЗ.Количество())+")";

Если Вывести тогда
	//Макет=ПолучитьМакет("Пересечения");
	Макет = Обработки.Интерфейс.ПолучитьМакет("Пересечения");
	
	ТабДок=новый ТабличныйДокумент;
	Обл=Макет.ПолучитьОбласть("Шапка");
	ТабДок.Вывести(Обл);
	Для каждого Стр Из ТЗ Цикл
		Обл=Макет.ПолучитьОбласть("Строка");
		Обл.Параметры.Заполнить(Стр);
		ТабДок.Вывести(Обл);
	КонецЦикла; 
	
	Возврат ТабДок;
	//Табдок.Показать();
конецесли;

Возврат Неопределено;

КонецФункции                                
