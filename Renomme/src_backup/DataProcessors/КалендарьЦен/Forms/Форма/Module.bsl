ТекПол = ПараметрыСеанса.ТекущийПользователь;
Если ТекПол.ТолькоПросмотр Тогда Возврат; КонецЕсли; 	
	
Область = ПолеОтчета.Область(ОбластьИмя);

Попытка
	Если Область.верх = 1 тогда // пн вт ..
		//Для Сч=1 По 12 Цикл
		ш =1;
		Для Сч = 0 По 11 Цикл
			//ОбластьПоиск=ПолеОтчета.Область(2 + сч * 4, Область.Лево, 2 + сч * 4, Область.Лево);
			ОбластьПоиск=ПолеОтчета.Область(2 + сч * 4 + (сч + 1) * 1 + Сч * Сдвиг, Область.Лево, 2 + сч * 4 + (сч + 1) * 1 + Сч * Сдвиг, Область.Лево);
			
			ДТ=ОбластьПоиск.Значение;
			
			Если ЗначениеЗаполнено(ДТ) тогда
				Если ДТ < ДокументыСервер.ДатаПереходаНаНовыйКалендарьЦен() Тогда
					Продолжить;
				КонецЕсли;	
				
				ПоискЗНЧ=СписВыбранных.НайтиПоЗначению(ДТ);
				Если ПоискЗНЧ=Неопределено тогда
					СписВыбранных.Добавить(ДТ);
					ПолеОтчета.Область(ОбластьПоиск.Верх,ОбластьПоиск.Лево,ОбластьПоиск.Верх + 3,ОбластьПоиск.Лево).ЦветФона=Новый Цвет(102, 144, 198);
				иначе
