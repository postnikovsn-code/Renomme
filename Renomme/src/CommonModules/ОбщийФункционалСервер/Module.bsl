Процедура УсловноеОформлениеДобавитьПоле(УсловноеОформление, 
	ЭлементыТабНаФормеИмя, ПутьКПолюОтбора, Вид_Сравнения, ПравоеЗначение, Web_Цвета) Экспорт	
    
    ЭлементОформления = УсловноеОформление.Элементы.Добавить();

    ПолеЭлемента = ЭлементОформления.Поля.Элементы.Добавить();
    ПолеЭлемента.Поле = Новый ПолеКомпоновкиДанных(ЭлементыТабНаФормеИмя);

    ОтборЭлемента = ЭлементОформления.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	ОтборЭлемента.ЛевоеЗначение = Новый ПолеКомпоновкиДанных(ПутьКПолюОтбора);
    ОтборЭлемента.ВидСравнения = Вид_Сравнения;
	ОтборЭлемента.ПравоеЗначение = ПравоеЗначение;
	ОтборЭлемента.Использование  = Истина;
	
	ЭлементОформления.Оформление.УстановитьЗначениеПараметра("ЦветФона", Web_Цвета);
	ЭлементОформления.Использование = Истина;
	//ЭлементОформления.Оформление.УстановитьЗначениеПараметра("ТолькоПросмотр", ТолькоПросмотр);	

КонецПроцедуры

Процедура ПолнаяПапкаРодитель(Ссылка, ТекущийРодитель) Экспорт
Если Ссылка = Справочники.Клиенты.ПустаяСсылка() Тогда Возврат; КонецЕсли;

Если Ссылка.ЭтоГруппа Тогда 
	НаименованиеГруппы = Ссылка.Наименование;
	ПолнаяПапкаРодительУстановить(Ссылка, ТекущийРодитель);
	ТекущийРодитель = ТекущийРодитель + НаименованиеГруппы + "\";
Иначе	
	ПолнаяПапкаРодительУстановить(Ссылка, ТекущийРодитель);
КонецЕсли;
КонецПроцедуры	

Процедура ПолнаяПапкаРодительУстановить(Ссылка, ТекущийРодитель) 
Если Ссылка = Справочники.Клиенты.ПустаяСсылка() Тогда Возврат; КонецЕсли;

Родитель = Ссылка.Родитель;	

ТекущийРодитель =  Родитель.Наименование + "\" + ТекущийРодитель;	

ПолнаяПапкаРодительУстановить(Родитель, ТекущийРодитель)
КонецПроцедуры	

