// ИсторияКлиента ЭТО Предпочтения Клиента
&НаСервере
Функция ПредпочтенияИсторияКлиента()
Если НЕ ЗначениеЗаполнено(Объект.Клиент) Тогда Возврат Неопределено; КонецЕсли;

ПолеОтчета.Очистить();
//	Макет=ПолучитьМакет("ПредпочтенияКлиента");
Макет=ПолучитьМакетНаСервере("Объект", "ПредпочтенияКлиента");

Обл=Макет.ПолучитьОбласть("Шапка");
ПолеОтчета.Вывести(Обл);

Обл=Макет.ПолучитьОбласть("Строка");
Обл.Параметры.Вид="Этаж";
Обл.Параметры.Значение=Объект.Клиент.ЖелательныйЭтаж;
ПолеОтчета.Вывести(Обл);

Обл=Макет.ПолучитьОбласть("Строка");
Обл.Параметры.Вид="Завтрак";
Обл.Параметры.Значение=Объект.Клиент.Завтрак;
ПолеОтчета.Вывести(Обл);

Обл=Макет.ПолучитьОбласть("Строка");
Обл.Параметры.Вид="Доп. принадлежности";
Обл.Параметры.Значение=Объект.Клиент.ДопПринадлежности;
ПолеОтчета.Вывести(Обл);

Обл=Макет.ПолучитьОбласть("Строка");
Обл.Параметры.Вид="Предпочтительный номер";
Обл.Параметры.Значение=Объект.Клиент.ПредпочтительныйНомер;
ПолеОтчета.Вывести(Обл);

Обл=Макет.ПолучитьОбласть("Строка");
Обл.Параметры.Вид="Балкон";
Обл.Параметры.Значение=Объект.Клиент.Балкон;
ПолеОтчета.Вывести(Обл);

Обл=Макет.ПолучитьОбласть("Строка");
Обл.Параметры.Вид="Вид из окна";
Обл.Параметры.Значение=Объект.Клиент.ВидИзОкна;
ПолеОтчета.Вывести(Обл);

Обл=Макет.ПолучитьОбласть("Строка");
Обл.Параметры.Вид="Ванна";
Обл.Параметры.Значение=Объект.Клиент.Ванна;
ПолеОтчета.Вывести(Обл);

Обл=Макет.ПолучитьОбласть("Строка");
Обл.Параметры.Вид="Иное";
Обл.Параметры.Значение=Объект.Клиент.Иное;
ПолеОтчета.Вывести(Обл);

Обл=Макет.ПолучитьОбласть("Строка");
ПолеОтчета.Вывести(Обл);

ПечатьСервер.ВывестиИсториюКлиента(ПолеОтчета, Объект.Клиент, Объект.Дата);
Возврат Неопределено;
КонецФункции
