&НаКлиенте
Процедура ОткрытьФормаВыбораОстаткиОплаты(ОтмененныйДокументДолг)
Если НЕ ЭтотОбъект.Записать(Новый Структура("РежимЗаписи", РежимЗаписиДокумента.Проведение)) Тогда Возврат; КонецЕсли;	
	
ПараметрыФормы = Новый Структура;
ПараметрыФормы.Вставить("ТолькоПросмотр", Истина);

Если ОтмененныйДокументДолг = Неопределено Тогда
	СписокКонтрагентов = Новый СписокЗначений;
Иначе	
	СписокКонтрагентов = СписокЗначенийКонтрагенты();
	ПараметрыФормы.Вставить("СписокКонтрагентов", СписокКонтрагентов);
КонецЕсли;

ДанныеОбъект = Объект;
СуммаКОплате = КоворкингСервер.СуммаКОплатеКоворкинг(ДанныеОбъект);

Если СуммаКОплате <= 0 Тогда ЭтаФорма.Модифицированность = Ложь; Возврат; КонецЕсли; 

ПараметрыФормы.Вставить("СуммаКОплате", СуммаКОплате);

ПараметрыФормы.Вставить("ОтмененныйДокументДолг", ОтмененныйДокументДолг);

ДопПараметры = Новый Структура;
ОписаниеОповещения = Новый ОписаниеОповещения("ЗакрытиеФормы_ФормаВыбораОплатыОстатки", ЭтаФорма, ДопПараметры);
	
ОткрытьФорму("Документ.КассовыйДокумент.Форма.ФормаВыбораОстаткиОплаты", ПараметрыФормы, ЭтаФорма 
	,,,,ОписаниеОповещения, РежимОткрытияОкнаФормы.БлокироватьВесьИнтерфейс);
КонецПроцедуры

&НаКлиенте
Процедура ЗакрытиеФормы_ФормаВыбораОплатыОстатки(Результат, ДополнительныеПараметры) Экспорт
Если НЕ ЗначениеЗаполнено(Результат) Тогда Возврат; КонецЕсли;

ДобавитьОплатаНаСервере(Результат);

//ЭтаФорма.Прочитать();
КонецПроцедуры

&НаСервере
Процедура ДобавитьОплатаНаСервере(ДокументОплаты)
НачатьТранзакцию();

СуммаРаспределено = 0;
КоворкингСервер.РаспределитьДокументОплатаКоворкингСчетОбъект(ДокументОплаты, Объект, СуммаРаспределено);

ДокументыОплатыКоворкинг = Объект.ДокументыОплаты;

НоваяОплата = ДокументыОплатыКоворкинг.Добавить();
НоваяОплата.ДокументОплаты = ДокументОплаты;
НоваяОплата.СуммаРаспределено = СуммаРаспределено;

ОплатыОбщееСервер.ДобавитьЗаменитьДокументОплатыДолгОплата(ДокументОплаты, Объект.Ссылка, Объект.СчетГУИД
	, СуммаРаспределено, Истина);   

ЭтаФорма.Записать(Новый Структура("РежимЗаписи", РежимЗаписиДокумента.Проведение));
ЗафиксироватьТранзакцию();
КонецПроцедуры
