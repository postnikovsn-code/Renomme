Процедура ПередЗаписью(Отказ, РежимЗаписи, РежимПроведения)
	
МассивКУдалению = Новый Массив;	
Для Каждого Счет Из Счета Цикл
	СчетГУИД = Счет.СчетГУИД;
	
	ОтборСтроки = Новый Структура("СчетГУИД", СчетГУИД);	
	СчетаДетальноДолги_П = СчетаДетальноДолги.НайтиСтроки(ОтборСтроки);
	Если СчетаДетальноДолги_П.Количество() = 0 Тогда 
		ОбщийФункционалСервер.УдалитьСтрокиОтборСтроки(ОтборСтроки, СчетаДетальноСтроки); 
		МассивКУдалению.Добавить(Счет);

		Продолжить;
	КонецЕсли;
	
	ЗаявкаСервер.ОбновитьСчетаСтроки(СчетаДетальноСтроки, Счета
		, СчетаДетальноДолги, РаспределениеОплатДолги,СчетГУИД);	
	
	Счет.Закрыт = ЗаявкаСервер.СчетЗакрытСчетаДетальноДолги(СчетаДетальноДолги_П);   
КонецЦикла;	

Для Каждого Строка Из МассивКУдалению Цикл
	Счета.Удалить(Строка);
КонецЦикла;

ДатаИзменения = ТекущаяДата();

Если НЕ ЗначениеЗаполнено(ЭтотОбъект.Ссылка) Тогда
	 ДатаСоздания = ТекущаяДата();
КонецЕсли;
КонецПроцедуры
