&НаКлиенте
Процедура СписокПередУдалением(Элемент, Отказ)
Если Элемент.ТекущиеДанные = Неопределено Тогда Отказ = Истина; Возврат; КонецЕсли;	

ГрупповойСчет = Элемент.ТекущаяСтрока;   

Если ГрупповойСчетСервер.ЕстьОплатыГрупповогоСчета(ГрупповойСчет) Тогда   
	ПоказатьПредупреждение(, "Есть оплаты группового счета.
	| 
	|УДАЛЕНИЕ НЕ РАЗРЕШЕНО ..."); 
	
	Отказ = Истина;
	Возврат;
КонецЕсли;

Оповещение = Новый ОписаниеОповещения("ЗавершениеВопросаПодтвердитеУдалениеДокументДолги", ЭтаФорма);
ПоказатьВопрос(Оповещение, "ПОДТВЕРДИТЕ УДАЛЕНИЕ ...", РежимДиалогаВопрос.ОКОтмена);
Отказ = Истина;
КонецПроцедуры

&НаКлиенте
Процедура ЗавершениеВопросаПодтвердитеУдалениеДокументДолги(Результат, ДополнительныеПараметры) Экспорт
Если Результат = КодВозвратаДиалога.Отмена Тогда Возврат; КонецЕсли;

УдалитьДокументыДолгиНаСервере();
КонецПроцедуры	

// Реальное Удаление заявок в модуле объекта
&НаСервере
Процедура УдалитьДокументыДолгиНаСервере()
НачатьТранзакцию();

ТекущаяСтрока = Элементы.Список.ТекущаяСтрока;
ТекущийОбъект = ТекущаяСтрока.ПолучитьОбъект();
ТекущийОбъект.Удалить();

ЗафиксироватьТранзакцию();

Элементы.Список.Обновить();
КонецПроцедуры
