&НаКлиенте
Асинх Процедура ЧекСчет(Команда)
Клиент = ОбщийФункционалСервер.ЗначениеРеквизитаНаСервере(Объект.КоворкингЗаявка, "Клиент");	
Контрагент = ?(ЗначениеЗаполнено(Объект.ОплачиваетСчет), Объект.ОплачиваетСчет, Клиент); 

Если КлиентыСервер.ЭтоЮрЛицо(Контрагент) Тогда 	
	//ПоказатьПредупреждение(,"Счет выписан на юр. лицо"	
	//	+ Символы.ПС + Символы.ПС + "ОПЛАТА НАЛИЧНЫМИ НЕ РАЗРЕШЕНА ...");		
		
	Результат = Ждать ВопросАсинх("Счет выписан на юр. лицо !!!
											|
											|ПРОДОЛЖИТЬ ФОРМИРОВАНИЕ ЧЕКА ?"
						, РежимДиалогаВопрос.ОКОтмена);
	Если Результат = КодВозвратаДиалога.Отмена Тогда Возврат; КонецЕсли; 
КонецЕсли;

Если Объект.Сумма = 0 Тогда
	ПоказатьПредупреждение(,"Сумма счета = 0"	
		+ Символы.ПС + Символы.ПС + "ОПЛАТА НЕ РАЗРЕШЕНА ...");		
		
	Возврат;
КонецЕсли;

Если ОплатыОбщееСервер.ЕстьОстаткиОплатКассаКонтрагент(Контрагент) Тогда
	Результат = Ждать ВопросАсинх("Есть кассовые остатки оплат для контрагента
											|
											|ПРОДОЛЖИТЬ ФОРМИРОВАНИЕ ЧЕКА ?"
						, РежимДиалогаВопрос.ОКОтмена);
	Если Результат = КодВозвратаДиалога.Отмена Тогда Возврат; КонецЕсли; 
КонецЕсли;


ЧекСчетДействие(Объект.Ссылка);
КонецПроцедуры

