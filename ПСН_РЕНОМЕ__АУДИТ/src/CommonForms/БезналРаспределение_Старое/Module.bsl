КонецПроцедуры
//

//
&НаКлиенте
Процедура ЭквайрингСвязатьОплатуСчет(Команда)
ЭквайрингСвязатьОплатуСчетНаСервере();
КонецПроцедуры

&НаСервере
Функция ЭквайрингСвязатьОплатуСчетНаСервере()
Результат = Новый Структура("КодОшибки, ТекстОшибки", 0 , "");	

ЭквайрингВыгрузкаПлатежиТекущаяСтрока = Элементы.ЭквайрингВыгрузкаПлатежи.ТекущаяСтрока;
Если ЭквайрингВыгрузкаПлатежиТекущаяСтрока = Неопределено Тогда Возврат Неопределено; КонецЕсли;
ЭквайрингВыгрузкаПлатежиТекущиеДанные = ЭквайрингВыгрузкаПлатежи.НайтиПоИдентификатору(ЭквайрингВыгрузкаПлатежиТекущаяСтрока);

Если ЭквайрингВыгрузкаПлатежиТекущиеДанные.ПолучательПлатежа <> ПолучательПлатежа_Смешанный 
И ЭквайрингВыгрузкаПлатежиТекущиеДанные.ПолучательПлатежа <> ПолучательПлатежа_Константа Тогда 
	Возврат Неопределено; 	
КонецЕсли;

Для Каждого ЭквайрингВыпискаСчетаТекущиеДанные Из ЭквайрингВыпискаСчета Цикл
	Если НЕ ЭквайрингВыпискаСчетаТекущиеДанные.Отметка Тогда Продолжить; КонецЕсли;

	ЭквайрингВыпискаСчетаТекущиеДанные.Отметка = Ложь;
	
	Если ЭквайрингВыгрузкаПлатежиТекущиеДанные.ОстатокПлатежа = 0 Тогда Прервать; КонецЕсли;	

	Если ЭквайрингВыпискаСчетаТекущиеДанные.ОстатокКЗакрытию = 0 Тогда Продолжить; КонецЕсли;
	
	Если ЭквайрингВыгрузкаПлатежиТекущиеДанные.ПолучательПлатежа = ПолучательПлатежа_Смешанный Тогда
		ОтборСтроки = Новый Структура("ПолучательПлатежаЗначениеСпискаВыбора", ПолучательПлатежа_Константа);
		НайденыеСтроки = БезналНастройкиРаспределениеПлатежей.НайтиСтроки(ОтборСтроки);
		СтрокаРаспределениеПлатежей = НайденыеСтроки[0];
		
		ОстатокПлатежа = ЭквайрингВыгрузкаПлатежиТекущиеДанные[СтрокаРаспределениеПлатежей.ИмяРеквизитаФормы]
			- ЭквайрингВыгрузкаПлатежиТекущиеДанные.СуммаВыписки - ЭквайрингВыгрузкаПлатежиТекущиеДанные.СуммаАннулировано ;

	Иначе  
		ОстатокПлатежа = ЭквайрингВыгрузкаПлатежиТекущиеДанные.ОстатокПлатежа; 
	КонецЕсли;
	
	Если ОстатокПлатежа >= ЭквайрингВыпискаСчетаТекущиеДанные.ОстатокКЗакрытию Тогда 
		СуммаРаспределено = ЭквайрингВыпискаСчетаТекущиеДанные.ОстатокКЗакрытию;
		ЭквайрингВыгрузкаПлатежиТекущиеДанные.ОстатокПлатежа = ЭквайрингВыгрузкаПлатежиТекущиеДанные.ОстатокПлатежа - СуммаРаспределено;
		ЭквайрингВыпискаСчетаТекущиеДанные.ОстатокКЗакрытию = 0;
	Иначе	
		СуммаРаспределено = ОстатокПлатежа;
		ЭквайрингВыпискаСчетаТекущиеДанные.ОстатокКЗакрытию = ЭквайрингВыпискаСчетаТекущиеДанные.ОстатокКЗакрытию - СуммаРаспределено;
		ЭквайрингВыгрузкаПлатежиТекущиеДанные.ОстатокПлатежа = 0;
	КонецЕсли;
	
	ЭквайрингВыгрузкаПлатежиТекущиеДанные.СуммаВыписки = ЭквайрингВыгрузкаПлатежиТекущиеДанные.СуммаВыписки + СуммаРаспределено;
	
	// + ПСН 2024.04.03
	ЭквайрингВыгрузкаПлатежиТекущиеДанные.ОстатокВыписки = ЭквайрингВыгрузкаПлатежиТекущиеДанные.ОстатокВыписки - СуммаРаспределено;
	// - ПСН 2024.04.03
	
	СуммаРаспределено_П = СуммаРаспределено;
	ДокументОплаты = ЭквайрингЗаполнитьДокументДолгДокументОплаты(ЭквайрингВыгрузкаПлатежиТекущиеДанные
		, ЭквайрингВыпискаСчетаТекущиеДанные, СуммаРаспределено_П);
	
	НоваяСвязь = ЭквайрингВыпискаСвязиОплатыСчета.Добавить();
	НоваяСвязь.ДокументОплаты = ДокументОплаты;
	НоваяСвязь.ДокументДолг = ЭквайрингВыпискаСчетаТекущиеДанные.ДокументДолг;
	НоваяСвязь.СчетГУИД = ЭквайрингВыпискаСчетаТекущиеДанные.СчетГУИД;
	НоваяСвязь.НомерСчета = ЭквайрингВыпискаСчетаТекущиеДанные.НомерСчета;
	НоваяСвязь.ДатаСчета = ЭквайрингВыпискаСчетаТекущиеДанные.ДатаСчета;
	НоваяСвязь.СуммаРаспределено = СуммаРаспределено;
	
	НоваяСвязь.ГУИД = ЭквайрингВыгрузкаПлатежиТекущиеДанные.ГУИД;
КонецЦикла;
	
ЭквайрингВыпискаСчетаОтмеченоИтого = 0;

Возврат Результат; 
КонецФункции

&НаСервере
Функция ЭквайрингЗаполнитьДокументДолгДокументОплаты(ЭквайрингВыгрузкаПлатежиТекущиеДанные
	, ЭквайрингВыпискаСчетаТекущиеДанные, СуммаРаспределено)
	
НачатьТранзакцию();
	
ДокументДолг = ЭквайрингВыпискаСчетаТекущиеДанные.ДокументДолг;
СчетГУИД = ЭквайрингВыпискаСчетаТекущиеДанные.СчетГУИД;
		
// + Выписка
ВыпискаОбъект = Документы.ВыпискаБанка.СоздатьДокумент();	
ВыпискаОбъект.Дата = ТекущаяДата();
ВыпискаОбъект.Приход = Истина;

ВыпискаОбъект.ДатаОплаты = ЭквайрингВыгрузкаПлатежиТекущиеДанные.ДатаПлатежа;

ВыпискаОбъект.ОтКого = ЭквайрингВыпискаСчетаТекущиеДанные.Контрагент;

ВыпискаОбъект.Сумма = СуммаРаспределено;

ВыпискаОбъект.ТекстПлатежа = "Эквайринг. " + ЭквайрингВыгрузкаПлатежиТекущиеДанные.ТекстПлатежа;
ВыпискаОбъект.ЭтоЭквайринг = Истина;

ВыпискаОбъект.ГУИДЗагрузка = ЭквайрингВыгрузкаПлатежиТекущиеДанные.ГУИД;
ВыпискаОбъект.ГУИДИсточникЗагрузка = ЭквайрингВыгрузкаПлатежиТекущиеДанные.ГУИДИсточникаСтрока;

ВыпискаОбъект.Записать(РежимЗаписиДокумента.Проведение);
// -Выписка

ДокументОплаты = ВыпискаОбъект.Ссылка;

ЗаполнитьДокументДолгДокументОплаты(ДокументОплаты, ДокументДолг, СчетГУИД, СуммаРаспределено);

ЗафиксироватьТранзакцию();

Возврат ДокументОплаты;
КонецФункции
//

//
&НаКлиенте
Процедура ЭквайрингВыпискаСвязиУдалить(Команда)
ЭквайрингВыпискаСвязиУдалитьНаСервере();
КонецПроцедуры

&НаСервере
Процедура ЭквайрингВыпискаСвязиУдалитьНаСервере()
НачатьТранзакцию();

МассивКУдалению = Новый Массив;
Для Каждого ТекущиеДанныеЭквайрингСвязиОплатыСчета Из ЭквайрингВыпискаСвязиОплатыСчета Цикл
	Если НЕ ТекущиеДанныеЭквайрингСвязиОплатыСчета.Отметка Тогда Продолжить; КонецЕсли;
	
	ДокументОплаты = ТекущиеДанныеЭквайрингСвязиОплатыСчета.ДокументОплаты;
	ДокументДолг = ТекущиеДанныеЭквайрингСвязиОплатыСчета.ДокументДолг;
	СчетГУИД = ТекущиеДанныеЭквайрингСвязиОплатыСчета.СчетГУИД;
	СуммаРаспределено = ТекущиеДанныеЭквайрингСвязиОплатыСчета.СуммаРаспределено;

	ОтборСтроки = Новый Структура("ГУИД", ТекущиеДанныеЭквайрингСвязиОплатыСчета.ГУИД);	
	НайденныеСтроки = ЭквайрингВыгрузкаПлатежи.НайтиСтроки(ОтборСтроки);	
	Если НайденныеСтроки.Количество() > 0 Тогда
		ТекущиеДанныеПлатежи = НайденныеСтроки[0];
		ТекущиеДанныеПлатежи.ОстатокПлатежа = ТекущиеДанныеПлатежи.ОстатокПлатежа + СуммаРаспределено; 
		
		ТекущиеДанныеПлатежи.СуммаВыписки = ТекущиеДанныеПлатежи.СуммаВыписки - СуммаРаспределено; 
		
		// + ПСН 2024.04.03
		ТекущиеДанныеПлатежи.ОстатокВыписки = ТекущиеДанныеПлатежи.ОстатокВыписки + СуммаРаспределено; 
		// - ПСН 2024.04.03
	КонецЕсли;

	ОтборСтроки = Новый Структура("СчетГУИД", СчетГУИД);	
	НайденныеСтроки = ЭквайрингВыпискаСчета.НайтиСтроки(ОтборСтроки);
	Если НайденныеСтроки.Количество() > 0 Тогда
		ТекущиеДанныеСчета = НайденныеСтроки[0];
		ТекущиеДанныеСчета.ОстатокКЗакрытию = ТекущиеДанныеСчета.ОстатокКЗакрытию + СуммаРаспределено; 
	КонецЕсли;

	ЭквайрингУдалитьДокументОплатыВДокументДолг(ДокументОплаты, ДокументДолг, СчетГУИД);

	МассивКУдалению.Добавить(ТекущиеДанныеЭквайрингСвязиОплатыСчета);
КонецЦикла;	

Для Каждого Элемент Из МассивКУдалению Цикл
	ЭквайрингВыпискаСвязиОплатыСчета.Удалить(Элемент);
КонецЦикла;

ЗафиксироватьТранзакцию();
КонецПроцедуры

&НаСервере
Функция ЭквайрингУдалитьДокументОплатыВДокументДолг(ДокументОплаты, ДокументДолг, СчетГУИД)
УдалитьДокументОплатыВДокументДолг(ДокументОплаты, ДокументДолг, СчетГУИД);

ДокументОплатыОбъект = ДокументОплаты.ПолучитьОбъект();
ДокументОплатыОбъект.Удалить();
КонецФункции
//
//// - Эквайринг Связи
////// +  Эквайринг


&НаКлиенте
Процедура ГруппаСтраницыПриСменеСтраницы(Элемент, ТекущаяСтраница)
Если ТекущаяСтраница.Имя = "ГруппаСтраницаВыгрузкаПлатежиВыписка" Тогда
	ВыгрузкаПлатежиГУИД_Предыдущий = ВыгрузкаПлатежиГУИД_Текущий;	
	ВыгрузкаЗагрузитьПлатежи(Неопределено);
	
	Если ЗначениеЗаполнено(ВыгрузкаПлатежиГУИД_Предыдущий) Тогда
		ОтборСтроки = Новый Структура("ГУИД", ВыгрузкаПлатежиГУИД_Предыдущий);	
		НайденныеСтроки = ВыгрузкаПлатежи.НайтиСтроки(ОтборСтроки);		
		Если НайденныеСтроки.Количество() > 0 Тогда
			ТекущаяСтрока = НайденныеСтроки[0].ПолучитьИдентификатор();
			Элементы.ВыгрузкаПлатежи.ТекущаяСтрока = ТекущаяСтрока;			
		КонецЕсли;
	КонецЕсли;

ИначеЕсли ТекущаяСтраница.Имя = "ГруппаЭквайринг" Тогда
	ЭквайрингВыгрузкаПлатежиГУИД_Предыдущий = ЭквайрингВыгрузкаПлатежиГУИД_Текущий;	
	ЭквайрингВыгрузкаПлатежиЗагрузитьПлатежи(Неопределено);
	
	Если ЗначениеЗаполнено(ЭквайрингВыгрузкаПлатежиГУИД_Предыдущий) Тогда
		ОтборСтроки = Новый Структура("ГУИД", ЭквайрингВыгрузкаПлатежиГУИД_Предыдущий);	
		НайденныеСтроки = ЭквайрингВыгрузкаПлатежи.НайтиСтроки(ОтборСтроки);		
		Если НайденныеСтроки.Количество() > 0 Тогда
			ТекущаяСтрока = НайденныеСтроки[0].ПолучитьИдентификатор();
			Элементы.ЭквайрингВыгрузкаПлатежи.ТекущаяСтрока = ТекущаяСтрока;			
		КонецЕсли;
	КонецЕсли;
	
ИначеЕсли ТекущаяСтраница.Имя = "ГруппаСтраницаВыпискаОплатыСчета" Тогда
	ВыпискаОплатыДокументОплаты_Предыдущий = ВыпискаОплатыДокументОплаты_Текущий;	
	ВыпискаОплатыЗагрузить(Неопределено);
	
	Если ЗначениеЗаполненоСервер(ВыпискаОплатыДокументОплаты_Предыдущий) Тогда
		ОтборСтроки = Новый Структура("ДокументОплаты", ВыпискаОплатыДокументОплаты_Предыдущий);	
		НайденныеСтроки = ВыпискаОплаты.НайтиСтроки(ОтборСтроки);		
		Если НайденныеСтроки.Количество() > 0 Тогда
			ТекущаяСтрока = НайденныеСтроки[0].ПолучитьИдентификатор();
			Элементы.ВыпискаОплаты.ТекущаяСтрока = ТекущаяСтрока;			
		КонецЕсли;
	КонецЕсли;	
КонецЕсли;
КонецПроцедуры

Функция ЗначениеЗаполненоСервер(Значение)
Возврат ЗначениеЗаполнено(Значение);	
КонецФункции
