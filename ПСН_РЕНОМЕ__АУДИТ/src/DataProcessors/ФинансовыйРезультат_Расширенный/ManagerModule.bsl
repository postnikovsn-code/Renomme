////
Функция СформироватьОтчетРаспределениеОплатНаСервере(Макет, ДатаОтчетаС, ДатаОтчетаПо, ЭтоОтчет) Экспорт
//ПолеОтчета.Очистить();
ПолеОтчета = Новый ТабличныйДокумент;      

ПолеОтчета.ОриентацияСтраницы = ОриентацияСтраницы.Ландшафт;
//ПолеОтчета.ОтображатьСетку = Истина;
//ПолеОтчета.ОтображатьЗаголовки = Истина;

Запрос = Новый Запрос("ВЫБРАТЬ
                      |	ДопУслуги.Ссылка КАК Папка,
                      |	ДопУслуги.НомерПП КАК НомерПП
                      |ИЗ
                      |	Справочник.ДопУслуги КАК ДопУслуги
                      |ГДЕ
                      |	ДопУслуги.ПометкаУдаления = ЛОЖЬ
                      |	И ДопУслуги.ЭтоГруппа = ИСТИНА
                      |	И ДопУслуги.Родитель = ЗНАЧЕНИЕ(Справочник.ДопУслуги.ПустаяСсылка)
                      |
                      |УПОРЯДОЧИТЬ ПО
                      |	НомерПП");

ТЗ_РодительУслуги = Запрос.Выполнить().Выгрузить();
ТЗ_РодительУслуги.Сортировать("НомерПП");

НоваяСтрока = ТЗ_РодительУслуги.Добавить();
НоваяСтрока.Папка = Справочники.ДопУслуги.ПустаяСсылка();

ОбластьЛево = Макет.ПолучитьОбласть("Шапка|КолонкиЛево");
ПолеОтчета.Вывести(ОбластьЛево, 0);

КоличествоКолонок = ОбластьЛево.ШиринаТаблицы; 

ОбластьШапка = ПолеОтчета.Область("R1"); 
ПолеОтчета.ПовторятьПриПечатиСтроки = ОбластьШапка;

ПолеОтчета.ФиксацияСверху = 2;
ПолеОтчета.НачатьАвтогруппировкуСтрок();

//

ИтогиДень = Новый Структура();
ИтогиДень.Вставить("СуммаОплаты", 0);
ИтогиДень.Вставить("СуммаНаличные", 0);
ИтогиДень.Вставить("СуммаКарта", 0);
ИтогиДень.Вставить("СуммаЭквайринга", 0);

ИтогиДень.Вставить("СуммаОплатыЗатраты", 0);
ИтогиДень.Вставить("СуммаОплатыНераспределено", 0);

//
ОбластьВидОплаты = Макет.ПолучитьОбласть("ЗаголовокВидОплаты|КолонкиЛево"); 
ОбластьВидОплаты.Параметры.ВидОплаты = "Касса";
ПолеОтчета.Вывести(ОбластьВидОплаты, 0);

Запрос = Новый Запрос("ВЫБРАТЬ
                      |	КассовыйДокумент.Ссылка КАК ДокументОплаты,
                      |	КассовыйДокумент.Приход КАК Приход,
                      |	КассовыйДокумент.СуммаКарта КАК СуммаКарта,
                      |	КассовыйДокумент.СуммаНаличные КАК СуммаНаличные,
                      |	КассовыйДокумент.НомерСменыККМ КАК НомерСменыККМ,
                      |	КассовыйДокумент.НомерЧекаККМ КАК НомерЧекаККМ,
                      |	ВЫБОР
                      |		КОГДА КассовыйДокумент.Приход
                      |			ТОГДА КассовыйДокумент.Сумма
                      |		ИНАЧЕ -КассовыйДокумент.Сумма
                      |	КОНЕЦ КАК СуммаОплаты,
                      |	ЕСТЬNULL(Возвраты.Сумма, 0) КАК СуммаВозврат,
                      |	КассовыйДокумент.ДатаОплаты КАК ДатаОплаты,
                      |	ВЫБОР
                      |		КОГДА КассовыйДокумент.СуммаНаличные = 0
                      |				И КассовыйДокумент.СуммаКарта > 0
                      |			ТОГДА 1
                      |		ИНАЧЕ ВЫБОР
                      |				КОГДА КассовыйДокумент.СуммаНаличные > 0
                      |						И КассовыйДокумент.СуммаКарта = 0
                      |					ТОГДА 2
                      |				ИНАЧЕ -1
                      |			КОНЕЦ
                      |	КОНЕЦ КАК ТипОплаты
                      |ИЗ
                      |	Документ.КассовыйДокумент КАК КассовыйДокумент
                      |		ЛЕВОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
                      |			СУММА(КассовыйДокумент.Сумма) КАК Сумма,
                      |			КассовыйДокумент.ВозвратДокумент КАК ВозвратДокумент
                      |		ИЗ
                      |			Документ.КассовыйДокумент КАК КассовыйДокумент
                      |		ГДЕ
                      |			КассовыйДокумент.ПометкаУдаления = ЛОЖЬ
                      |			И КассовыйДокумент.Приход = ЛОЖЬ
                      |		
                      |		СГРУППИРОВАТЬ ПО
                      |			КассовыйДокумент.ВозвратДокумент) КАК Возвраты
                      |		ПО КассовыйДокумент.Ссылка = Возвраты.ВозвратДокумент
                      |ГДЕ
                      |	КассовыйДокумент.ПометкаУдаления = ЛОЖЬ
                      |	И КассовыйДокумент.ДатаОплаты >= &ДатаОплатыC
                      |	И КассовыйДокумент.ДатаОплаты <= &ДатаОплатыПо
                      |
                      |УПОРЯДОЧИТЬ ПО
                      |	ДатаОплаты,
                      |	НомерСменыККМ");

Запрос.УстановитьПараметр("ДатаОплатыC", ДатаОтчетаС );
Запрос.УстановитьПараметр("ДатаОплатыПо", ДатаОтчетаПо );
ТЗ_Оплаты = Запрос.Выполнить().Выгрузить();	

ТЗ_Оплаты.Колонки.Добавить("ПроцентЭквайринга");
Для Каждого Строка Из ТЗ_Оплаты Цикл
	Запрос = Новый Запрос("ВЫБРАТЬ ПЕРВЫЕ 1
	                  |	ПроцентыЭквайринга.ПроцентЭквайринга КАК ПроцентЭквайринга
	                  |ИЗ
	                  |	РегистрСведений.ПроцентыЭквайринга КАК ПроцентыЭквайринга
	                  |ГДЕ
	                  |	ПроцентыЭквайринга.ДатаУстановкиПроцентаЭквайринга < &ДатаУстановкиПроцентаЭквайринга
	                  |
	                  |УПОРЯДОЧИТЬ ПО
	                  |	ПроцентыЭквайринга.ДатаУстановкиПроцентаЭквайринга УБЫВ");

	Запрос.УстановитьПараметр("ДатаУстановкиПроцентаЭквайринга", Строка.ДокументОплаты.ДатаОплаты);

	ТЗ = Запрос.Выполнить().Выгрузить();
	ПроцентЭквайринга = ?(ТЗ.Количество() = 0, 0, ТЗ[0].ПроцентЭквайринга); 			
	
	Строка.ПроцентЭквайринга = ПроцентЭквайринга;
КонецЦикла;
	
Дата_П = '00010101';
Для Каждого СтрокаОплаты Из ТЗ_Оплаты Цикл
	Если НЕ СтрокаОплаты.ДатаОплаты = Дата_П Тогда
		Если Дата_П <> '00010101' Тогда
			ИтогиДеньОплатыВывод(ПолеОтчета, Макет, ИтогиДень, Дата_П);						
		КонецЕсли;		
			
		ОбластьДатаОплаты = Макет.ПолучитьОбласть("ЗаголовокДата|КолонкиЛево"); 
		ОбластьДатаОплаты.Параметры.Дата = Формат(СтрокаОплаты.ДатаОплаты, "ДФ=dd.MM.yy");
		ПолеОтчета.Вывести(ОбластьДатаОплаты, 1);
		
		Дата_П = СтрокаОплаты.ДатаОплаты;
		
		ИтогиДень.СуммаОплаты = 0;
		ИтогиДень.СуммаНаличные = 0;
		ИтогиДень.СуммаКарта = 0;
		ИтогиДень.СуммаЭквайринга = 0;

		ИтогиДень.СуммаОплатыЗатраты = 0;
		ИтогиДень.СуммаОплатыНераспределено = 0;
	КонецЕсли;
	
	ОбластьСтрокаОплаты = Макет.ПолучитьОбласть("СтрокаОплаты|КолонкиЛево"); 
	ОбластьСтрокаОплаты.Параметры.Дата = Формат(СтрокаОплаты.ДатаОплаты, "ДФ=dd.MM.yy");
	
	ДокументОплатыПредставление = "Кассовый документ " + СтрокаОплаты.ДокументОплаты.Номер + " от " + Формат(СтрокаОплаты.ДокументОплаты.Дата, "ДФ=dd.MM.yy");
	ОбластьСтрокаОплаты.Параметры.ДокументОплаты = ДокументОплатыПредставление;
	ОбластьСтрокаОплаты.Параметры.ДокументОплатыРасшифровка = СтрокаОплаты.ДокументОплаты;
	
	ОбластьСтрокаОплаты.Параметры.ТипОплаты = ОтчетыСервер.ТипОплатыНаименование(СтрокаОплаты.ТипОплаты);

	ОбластьСтрокаОплаты.Параметры.ДатаОплаты = Формат(СтрокаОплаты.ДатаОплаты, "ДФ=dd.MM.yy");
	ОбластьСтрокаОплаты.Параметры.НомерСменыККМ = СтрокаОплаты.НомерСменыККМ;
	
	ОбластьСтрокаОплаты.Параметры.СуммаОплаты = СтрокаОплаты.СуммаОплаты;
	ОбластьСтрокаОплаты.Параметры.СуммаКарта = СтрокаОплаты.СуммаКарта;
	ОбластьСтрокаОплаты.Параметры.СуммаНаличные = СтрокаОплаты.СуммаНаличные;
	ОбластьСтрокаОплаты.Параметры.СуммаВозврат = СтрокаОплаты.СуммаВозврат;
	
	СуммаЭквайринга = ОтчетыСервер.СуммаЭквайринга(СтрокаОплаты);
	ОбластьСтрокаОплаты.Параметры.СуммаЭквайринга = СуммаЭквайринга;
	
	ВыведеннаяОласть = ПолеОтчета.Вывести(ОбластьСтрокаОплаты, 2);
	
	ИтогиДеньДобавить(ИтогиДень, СтрокаОплаты.СуммаОплаты, СтрокаОплаты.СуммаНаличные, СтрокаОплаты.СуммаКарта, СуммаЭквайринга
		, 0, 0);
	
//
	ЗапросПроживание = Новый Запрос("ВЫБРАТЬ
	                                |	ЗаявкаНаБронированиеРаспределениеОплатДолги.Ссылка КАК Заявка,
	                                |	ЗаявкаНаБронированиеРаспределениеОплатДолги.СуммаОплаты КАК СуммаОплаты,
	                                |	ЗаявкаНаБронированиеПроживание.ДеньПроживания КАК ДеньПроживания,
	                                |	ЗаявкаНаБронированиеПроживание.Цена КАК Цена,
	                                |	ЗаявкаНаБронированиеПроживание.Количество КАК Количество,
	                                |	ЗаявкаНаБронированиеПроживание.Сумма КАК Сумма,
	                                |	ЗаявкаНаБронированиеПроживание.СуммаБезСкидки КАК СуммаБезСкидки,
	                                |	ЗаявкаНаБронированиеПроживание.ПроцентСкидкиКлиента КАК ПроцентСкидкиКлиента
	                                |ИЗ
	                                |	Документ.ЗаявкаНаБронирование.РаспределениеОплатДолги КАК ЗаявкаНаБронированиеРаспределениеОплатДолги
	                                |		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.ЗаявкаНаБронирование.Проживание КАК ЗаявкаНаБронированиеПроживание
	                                |		ПО ЗаявкаНаБронированиеРаспределениеОплатДолги.Ссылка = ЗаявкаНаБронированиеПроживание.Ссылка
	                                |			И ЗаявкаНаБронированиеРаспределениеОплатДолги.ДолгиГУИД = ЗаявкаНаБронированиеПроживание.ГУИД
	                                |ГДЕ
	                                |	ЗаявкаНаБронированиеРаспределениеОплатДолги.Ссылка.ПометкаУдаления = ЛОЖЬ
	                                |	И ЗаявкаНаБронированиеРаспределениеОплатДолги.ДокументОплаты = &ДокументОплаты
	                                |
	                                |УПОРЯДОЧИТЬ ПО
	                                |	Заявка,
	                                |	ДеньПроживания");

	ЗапросПроживание.УстановитьПараметр("ДокументОплаты", СтрокаОплаты.ДокументОплаты);
	ТЗ_Проживание = ЗапросПроживание.Выполнить().Выгрузить();
	
	СуммаИтогоДокументОплатыЗатрат = 0;
	Для Каждого СтрокаПроживание Из ТЗ_Проживание Цикл
		ОбластьСтрокаЗатраты = Макет.ПолучитьОбласть("СтрокаЗатраты|КолонкиЛево"); 
		
		ЗаявкаПредставление = " " + СтрокаПроживание.Заявка.НомерВРезерв + " / ";
		ЗаявкаПредставление = ЗаявкаПредставление + 
			"Заявка " + СтрокаПроживание.Заявка.Номер + " от " + Формат(СтрокаПроживание.Заявка.Дата, "ДФ=dd.MM.yy");
		ОбластьСтрокаЗатраты.Параметры.ДокументЗатраты = ЗаявкаПредставление;
		ОбластьСтрокаЗатраты.Параметры.ДокументЗатратыРасшифровка = СтрокаПроживание.Заявка;
		
		ОбластьСтрокаЗатраты.Параметры.ДатаЗатрат = Формат(СтрокаПроживание.ДеньПроживания, "ДФ=dd.MM.yy");
		ОбластьСтрокаЗатраты.Параметры.ТипЗатрат = "Проживание";
		ОбластьСтрокаЗатраты.Параметры.СуммаОплаты = СтрокаПроживание.СуммаОплаты;
		
		ОбластьСтрокаЗатраты.Параметры.СуммаЗатрат = СтрокаПроживание.Сумма;
	
		ПолеОтчета.Вывести(ОбластьСтрокаЗатраты, 2);
	КонецЦикла;
	
	СуммаИтогоДокументОплатыЗатрат = СуммаИтогоДокументОплатыЗатрат + ТЗ_Проживание.Итог("СуммаОплаты");
//

//
	ЗапросУслуги = Новый Запрос("ВЫБРАТЬ
	                            |	ЗаявкаНаБронированиеРаспределениеОплатДолги.Ссылка КАК Заявка,
	                            |	ЗаявкаНаБронированиеРаспределениеОплатДолги.СуммаОплаты КАК СуммаОплаты,
	                            |	ЗаявкаНаБронированиеДопУслуги.Услуга КАК Услуга,
	                            |	ЗаявкаНаБронированиеДопУслуги.Цена КАК Цена,
	                            |	ЗаявкаНаБронированиеДопУслуги.Количество КАК Количество,
	                            |	ЗаявкаНаБронированиеДопУслуги.ДатаУслуги КАК ДатаУслуги,
	                            |	ЗаявкаНаБронированиеДопУслуги.Цена * ЗаявкаНаБронированиеДопУслуги.Количество КАК Сумма
	                            |ИЗ
	                            |	Документ.ЗаявкаНаБронирование.РаспределениеОплатДолги КАК ЗаявкаНаБронированиеРаспределениеОплатДолги
	                            |		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.ЗаявкаНаБронирование.ДопУслуги КАК ЗаявкаНаБронированиеДопУслуги
	                            |		ПО ЗаявкаНаБронированиеРаспределениеОплатДолги.Ссылка = ЗаявкаНаБронированиеДопУслуги.Ссылка
	                            |			И ЗаявкаНаБронированиеРаспределениеОплатДолги.ДолгиГУИД = ЗаявкаНаБронированиеДопУслуги.ГУИД
	                            |ГДЕ
	                            |	ЗаявкаНаБронированиеРаспределениеОплатДолги.Ссылка.ПометкаУдаления = ЛОЖЬ
	                            |	И ЗаявкаНаБронированиеРаспределениеОплатДолги.ДокументОплаты = &ДокументОплаты
	                            |	И ЗаявкаНаБронированиеДопУслуги.ВСчет = ИСТИНА
	                            |
	                            |УПОРЯДОЧИТЬ ПО
	                            |	Заявка");

	ЗапросУслуги.УстановитьПараметр("ДокументОплаты", СтрокаОплаты.ДокументОплаты);
	ТЗ_Услуги = ЗапросУслуги.Выполнить().Выгрузить();
	
	Для Каждого СтрокаУслуги Из ТЗ_Услуги Цикл
		ОбластьСтрокаЗатраты = Макет.ПолучитьОбласть("СтрокаЗатраты|КолонкиЛево"); 
		
		ЗаявкаПредставление = " " + СтрокаУслуги.Заявка.НомерВРезерв + " / ";
		ЗаявкаПредставление = ЗаявкаПредставление + 
			"Заявка " + СтрокаУслуги.Заявка.Номер + " от " + Формат(СтрокаУслуги.Заявка.Дата, "ДФ=dd.MM.yy");
		ОбластьСтрокаЗатраты.Параметры.ДокументЗатраты = ЗаявкаПредставление;
		ОбластьСтрокаЗатраты.Параметры.ДокументЗатратыРасшифровка = СтрокаУслуги.Заявка;
		
		ОбластьСтрокаЗатраты.Параметры.ДатаЗатрат = Формат(СтрокаУслуги.ДатаУслуги, "ДФ=dd.MM.yy");
		ОбластьСтрокаЗатраты.Параметры.ТипЗатрат = СтрокаУслуги.Услуга;
		ОбластьСтрокаЗатраты.Параметры.СуммаОплаты = СтрокаУслуги.СуммаОплаты;
		
		ОбластьСтрокаЗатраты.Параметры.СуммаЗатрат = СтрокаУслуги.Сумма;
	
		ПолеОтчета.Вывести(ОбластьСтрокаЗатраты, 2);
	КонецЦикла;

	СуммаИтогоДокументОплатыЗатрат = СуммаИтогоДокументОплатыЗатрат + ТЗ_Услуги.Итог("СуммаОплаты");
//
	
//
	ЗапросКоворкинг = Новый Запрос("ВЫБРАТЬ
	                               |	КоворкингСчетаДокументыОплаты.Ссылка КАК Ссылка,
	                               |	КоворкингСчетаДокументыОплаты.ДокументОплаты КАК ДокументОплаты,
	                               |	КоворкингСчетаДокументыОплаты.СуммаРаспределено КАК СуммаРаспределено,
	                               |	КоворкингСчетаДокументыОплаты.Ссылка.Сумма КАК СуммаЗатрат
	                               |ИЗ
	                               |	Документ.КоворкингСчета.ДокументыОплаты КАК КоворкингСчетаДокументыОплаты
	                               |ГДЕ
	                               |	КоворкингСчетаДокументыОплаты.Ссылка.ПометкаУдаления = ЛОЖЬ
	                               |	И КоворкингСчетаДокументыОплаты.ДокументОплаты = &ДокументОплаты");

	ЗапросКоворкинг.УстановитьПараметр("ДокументОплаты", СтрокаОплаты.ДокументОплаты);
	ТЗ_Коворкинг = ЗапросКоворкинг.Выполнить().Выгрузить();
	
	Для Каждого СтрокаКоворкинг Из ТЗ_Коворкинг Цикл
		ОбластьСтрокаЗатраты = Макет.ПолучитьОбласть("СтрокаЗатраты|КолонкиЛево"); 
		
		ДокументЗатратыПредставление = "Коворкинг " + СтрокаКоворкинг.Ссылка.Номер + " от " + Формат(СтрокаКоворкинг.Ссылка.Дата, "ДФ=dd.MM.yy");
		ОбластьСтрокаЗатраты.Параметры.ДокументЗатраты = ДокументЗатратыПредставление;
		ОбластьСтрокаЗатраты.Параметры.ДокументЗатратыРасшифровка = СтрокаКоворкинг.Ссылка;
		
		//ОбластьСтрокаЗатраты.Параметры.ДатаЗатрат = Формат(СтрокаУслуги.ДатаУслуги, "ДФ=dd.MM.yy");
		ОбластьСтрокаЗатраты.Параметры.ТипЗатрат = "Коворкинг";
		ОбластьСтрокаЗатраты.Параметры.СуммаОплаты = СтрокаКоворкинг.СуммаРаспределено;
		
		ОбластьСтрокаЗатраты.Параметры.СуммаЗатрат = СтрокаКоворкинг.СуммаЗатрат;
	
		ПолеОтчета.Вывести(ОбластьСтрокаЗатраты, 2);
	КонецЦикла;

	СуммаИтогоДокументОплатыЗатрат = СуммаИтогоДокументОплатыЗатрат + ТЗ_Коворкинг.Итог("СуммаРаспределено");
	
//
	ЗапросУслугиКоворкинг = Новый Запрос("ВЫБРАТЬ
	                                     |	КоворкингСчетаРаспределениеОплатКоворкинг.Ссылка КАК Счет,
	                                     |	КоворкингСчетаРаспределениеОплатКоворкинг.СуммаОплаты КАК СуммаОплаты,
	                                     |	КоворкингСчетаДопУслугиКоворкинг.Услуга КАК Услуга,
	                                     |	КоворкингСчетаДопУслугиКоворкинг.Цена КАК Цена,
	                                     |	КоворкингСчетаДопУслугиКоворкинг.Количество КАК Количество,
	                                     |	КоворкингСчетаДопУслугиКоворкинг.ДатаУслуги КАК ДатаУслуги,
	                                     |	КоворкингСчетаДопУслугиКоворкинг.Сумма КАК Сумма
	                                     |ИЗ
	                                     |	Документ.КоворкингСчета.РаспределениеОплатКоворкинг КАК КоворкингСчетаРаспределениеОплатКоворкинг
	                                     |		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.КоворкингСчета.ДопУслугиКоворкинг КАК КоворкингСчетаДопУслугиКоворкинг
	                                     |		ПО КоворкингСчетаРаспределениеОплатКоворкинг.Ссылка = КоворкингСчетаДопУслугиКоворкинг.Ссылка
	                                     |			И КоворкингСчетаРаспределениеОплатКоворкинг.ГУИДДолги = КоворкингСчетаДопУслугиКоворкинг.ГУИД
	                                     |ГДЕ
	                                     |	КоворкингСчетаРаспределениеОплатКоворкинг.Ссылка.ПометкаУдаления = ЛОЖЬ
	                                     |	И КоворкингСчетаРаспределениеОплатКоворкинг.ЭтоУслуга = ИСТИНА
	                                     |	И КоворкингСчетаРаспределениеОплатКоворкинг.ДокументОплаты = &ДокументОплаты
	                                     |
	                                     |УПОРЯДОЧИТЬ ПО
	                                     |	Счет");

	ЗапросУслугиКоворкинг.УстановитьПараметр("ДокументОплаты", СтрокаОплаты.ДокументОплаты);
	ТЗ_УслугиКоворкинг = ЗапросУслугиКоворкинг.Выполнить().Выгрузить();
	
	Для Каждого СтрокаУслуги Из ТЗ_УслугиКоворкинг Цикл
		ОбластьСтрокаЗатраты = Макет.ПолучитьОбласть("СтрокаЗатраты|КолонкиЛево"); 
		
		ДокументЗатраты = " " + СтрокаУслуги.Счет.КоворкингЗаявка.КоворкингНомер + " / ";
		ДокументЗатраты = ДокументЗатраты + 
			"Счет " + СтрокаУслуги.Счет.Номер + " от " + Формат(СтрокаУслуги.Счет.Дата, "ДФ=dd.MM.yy");
		ОбластьСтрокаЗатраты.Параметры.ДокументЗатраты = ДокументЗатраты;
		ОбластьСтрокаЗатраты.Параметры.ДокументЗатратыРасшифровка = СтрокаУслуги.Счет;
		
		ОбластьСтрокаЗатраты.Параметры.ДатаЗатрат = Формат(СтрокаУслуги.ДатаУслуги, "ДФ=dd.MM.yy");
		ОбластьСтрокаЗатраты.Параметры.ТипЗатрат = СтрокаУслуги.Услуга;
		ОбластьСтрокаЗатраты.Параметры.СуммаОплаты = СтрокаУслуги.СуммаОплаты;
		
		ОбластьСтрокаЗатраты.Параметры.СуммаЗатрат = СтрокаУслуги.Сумма;
	
		ПолеОтчета.Вывести(ОбластьСтрокаЗатраты, 2);
	КонецЦикла;

	СуммаИтогоДокументОплатыЗатрат = СуммаИтогоДокументОплатыЗатрат + ТЗ_Услуги.Итог("СуммаОплаты");
	//СуммаНеРаспределено = СтрокаОплаты.СуммаОплаты - СуммаИтогоДокументОплатыЗатрат;
	Если СтрокаОплаты.Приход Тогда
		СуммаНеРаспределено = СтрокаОплаты.СуммаОплаты - СтрокаОплаты.СуммаВозврат - СуммаИтогоДокументОплатыЗатрат;
	Иначе
		СуммаНеРаспределено = 0;
	КонецЕсли;
	
	Если СуммаНеРаспределено <> 0 Тогда 
		ОбластьСтрокаЗатраты = Макет.ПолучитьОбласть("СтрокаЗатраты|КолонкиЛево"); 
		
		ОбластьСтрокаЗатраты.Параметры.ТипЗатрат = "Не распределено";
		ОбластьСтрокаЗатраты.Параметры.СуммаОплаты = СуммаНеРаспределено;
		
		ВыведеннаяОбласть = ПолеОтчета.Вывести(ОбластьСтрокаЗатраты, 2);
		Для Индекс = 0 По КоличествоКолонок - 1 Цикл 
			ПолеОтчета.Область(ВыведеннаяОбласть.Верх, Индекс, ВыведеннаяОбласть.Низ, Индекс + 1).Шрифт 
			 //= Новый Шрифт(ОбластьОформления.Шрифт, ОбластьОформления.Шрифт.Размер, ,Истина);
			 	= Новый Шрифт("Arial", 8, ,Истина);
			ПолеОтчета.Область(ВыведеннаяОбласть.Верх, Индекс, ВыведеннаяОбласть.Низ, Индекс + 1).ЦветТекста = Новый Цвет(255, 0, 0);
		КонецЦикла;

	КонецЕсли;
	
	ИтогиДеньДобавить(ИтогиДень, 0, 0, 0, 0
		, СуммаИтогоДокументОплатыЗатрат, СуммаНеРаспределено);
КонецЦикла;

Если Дата_П <> '00010101' Тогда
	ИтогиДеньОплатыВывод(ПолеОтчета, Макет, ИтогиДень, Дата_П);						
КонецЕсли;	

Возврат ПолеОтчета;
КонецФункции

Процедура ИтогиДеньОплатыВывод(ПолеОтчета, Макет, ИтогиДень, Дата_П)
Область = Макет.ПолучитьОбласть("ИтогиДеньОплаты|КолонкиЛево");

Дата = Формат(Дата_П, "ДФ='д.МММ гг'" );  
Область.Параметры.Дата = Дата;		

Область.Параметры.СуммаОплаты = ИтогиДень.СуммаОплаты;
Область.Параметры.СуммаНаличные = ИтогиДень.СуммаНаличные;
Область.Параметры.СуммаКарта = ИтогиДень.СуммаКарта;
Область.Параметры.СуммаЭквайринга = ИтогиДень.СуммаЭквайринга;
ПолеОтчета.Вывести(Область, 1);

Если ИтогиДень.СуммаОплатыЗатраты <> 0 Тогда
	Область = Макет.ПолучитьОбласть("ИтогиДеньЗатраты|КолонкиЛево");
	Область.Параметры.ТипЗатрат = "Затраты";
	Область.Параметры.СуммаОплатыЗатраты = ИтогиДень.СуммаОплатыЗатраты;
	ПолеОтчета.Вывести(Область, 1);
КонецЕсли;

Если ИтогиДень.СуммаОплатыНераспределено <> 0 Тогда
	Область = Макет.ПолучитьОбласть("ИтогиДеньЗатраты|КолонкиЛево");
	Область.Параметры.ТипЗатрат = "Не распределено";
	Область.Параметры.СуммаОплатыЗатраты = ИтогиДень.СуммаОплатыНераспределено;
	ВыведеннаяОбласть = ПолеОтчета.Вывести(Область, 1);

	КоличествоКолонок = Область.ШиринаТаблицы;
	Для Индекс = 0 По КоличествоКолонок - 1 Цикл 
		ПолеОтчета.Область(ВыведеннаяОбласть.Верх, Индекс, ВыведеннаяОбласть.Низ, Индекс + 1).Шрифт 
		 //= Новый Шрифт(ОбластьОформления.Шрифт, ОбластьОформления.Шрифт.Размер, ,Истина);
		 	= Новый Шрифт("Arial", 8, ,Истина);
		ПолеОтчета.Область(ВыведеннаяОбласть.Верх, Индекс, ВыведеннаяОбласть.Низ, Индекс + 1).ЦветТекста = Новый Цвет(255, 0, 0);
	КонецЦикла;
КонецЕсли;
КонецПроцедуры

Процедура ИтогиДеньДобавить(ИтогиДень, СуммаОплаты, СуммаНаличные, СуммаКарта, СуммаЭквайринга
		, СуммаОплатыЗатраты, СуммаОплатыНераспределено)

ИтогиДень.СуммаОплаты = ИтогиДень.СуммаОплаты + СуммаОплаты;
ИтогиДень.СуммаНаличные = ИтогиДень.СуммаНаличные + СуммаНаличные ;
ИтогиДень.СуммаКарта = ИтогиДень.СуммаКарта + СуммаКарта ;
ИтогиДень.СуммаЭквайринга = ИтогиДень.СуммаЭквайринга + СуммаЭквайринга;

ИтогиДень.СуммаОплатыЗатраты = ИтогиДень.СуммаОплатыЗатраты + СуммаОплатыЗатраты;
ИтогиДень.СуммаОплатыНераспределено = ИтогиДень.СуммаОплатыНераспределено  + СуммаОплатыНераспределено ;
КонецПроцедуры
