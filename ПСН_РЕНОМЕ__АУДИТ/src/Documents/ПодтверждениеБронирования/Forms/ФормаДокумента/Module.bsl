Процедура ЗаполнитьНовоеПодтверждение()
	//НовоеПодтверждениеНаСервере();
	//
	//НовНомера=Новый ТаблицаЗначений;
	//НовНомера.Колонки.Добавить("Бронь");
	//НовНомера.Колонки.Добавить("РезервС");
	//НовНомера.Колонки.Добавить("РезервПо");
	//НовНомера.Колонки.Добавить("КолВо");
	//НовНомера.Колонки.Добавить("СТ");
	
	НовНомера.Очистить();
	Для каждого Ном Из Объект.Номера Цикл
		Если Ном.Бронь.НовыйРассчет Тогда 
			//Для каждого СтрИскл Из Ном.Бронь.Исключения Цикл
			Для каждого СтрИскл Из Ном.Бронь.Проживание Цикл
					Нов=НовНомера.Добавить();
					Нов.Бронь=Ном.Бронь;
					Нов.РезервС=Формат(СтрИскл.ДеньПроживания, "ДФ=dd.MM.yy");
					Нов.РезервПо=Формат(СтрИскл.ДеньПроживания+86400, "ДФ=dd.MM.yy");
					Нов.КолВо=СтрИскл.Количество;
					Нов.СТ=СтрИскл.Цена-СтрИскл.Цена*(СтрИскл.ПроцентСкидкиКлиента/100);	
			КонецЦикла; 
		Иначе 
			//Если Ном.Бронь.Исключения.Количество()=0 тогда 
			Если Ном.Бронь.Проживание.Количество()=0 тогда 
				Нов=НовНомера.Добавить();
				Нов.Бронь=Ном.Бронь;
				Нов.РезервС=Формат(Ном.Бронь.РезервС, "ДФ=dd.MM.yy")+" (" + Ном.Бронь.ВремяЗаезда+")";
				Нов.РезервПо=Формат(Ном.Бронь.РезервПо, "ДФ=dd.MM.yy")+" ("+Ном.Бронь.ВремяВыезда+")";
				Нов.КолВо=Ном.Бронь.КолВо;
				Нов.СТ=Ном.Бронь.Тариф_НеИспользуется.Цена-?(Ном.Бронь.Оплачивает.Категория.Пустая(),0,Ном.Бронь.Тариф_НеИспользуется.Цена*(Ном.Бронь.Оплачивает.Категория.Скидка/100));
			иначе
				Нов=НовНомера.Добавить();
				Нов.Бронь=Ном.Бронь;
				Нов.РезервС=Формат(Ном.Бронь.РезервС, "ДФ=dd.MM.yy")+" ("+Ном.Бронь.ВремяЗаезда+")";
				Нов.РезервПо=Формат(Ном.Бронь.РезервПо, "ДФ=dd.MM.yy")+" ("+Ном.Бронь.ВремяВыезда+")";
				Нов.КолВо=Ном.Бронь.КолВо-Ном.Бронь.Исключения.Количество();
				Нов.СТ=Ном.Бронь.Тариф_НеИспользуется.Цена-?(Ном.Бронь.Оплачивает.Категория.Пустая(),0,Ном.Бронь.Тариф_НеИспользуется.Цена*(Ном.Бронь.Оплачивает.Категория.Скидка/100));
				//	НБ=Документы.ЗаявкаНаБронирование.СоздатьДокумент();
				Для каждого СтрИскл Из Ном.Бронь.Исключения Цикл
					Нов=НовНомера.Добавить();
					Нов.Бронь=Ном.Бронь;
					Нов.РезервС=Формат(СтрИскл.ДеньПроживания, "ДФ=dd.MM.yy");
					Нов.РезервПо=Формат(СтрИскл.ДеньПроживания, "ДФ=dd.MM.yy");
					Нов.КолВо=1;
					Нов.СТ=СтрИскл.Тариф_НеИспользуется.Цена-?(Ном.Бронь.Оплачивает.Категория.Пустая(),0,СтрИскл.Тариф_НеИспользуется.Цена*(Ном.Бронь.Оплачивает.Категория.Скидка/100));	
				КонецЦикла; 
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
КонецПроцедуры

