&НаСервере
Процедура ПрошлыйПериодДопУслуги_Обновить()
ОтКого = Объект.Клиент;

ТЗ = ПрошлыйПериодДопУслуги.Выгрузить();

ТЗ.Свернуть("ПрочиеОплатыДокументОплаты, ПрочиеОплатыДокументДолг", "Сумма");

Запрос = Новый Запрос;
Запрос.Текст = ЗаявкаСервер.ПрошлыйПериодДопУслуги_ТекстЗапроса();
Запрос.Текст = Запрос.Текст + "
                      |	И ПрочиеОплаты.ОтКого = &ОтКого
                      |	И ЕСТЬNULL(Долги.Сумма, 0) - ЕСТЬNULL(Закрыто.СуммаЗакрыто, 0) - ЕСТЬNULL(ТЗ.Сумма, 0) > 0
                      |
                      |УПОРЯДОЧИТЬ ПО
                      |	ДатаДолга";

Запрос.УстановитьПараметр("ОтКого", ОтКого);
Запрос.УстановитьПараметр("ТЗ", ТЗ);

Результат = Запрос.Выполнить();
Если Результат.Пустой() Тогда
	Элементы.ДопУслугиПрошлыеДолгиДопУслуги.ЦветФона = Новый Цвет();
Иначе
	Элементы.ДопУслугиПрошлыеДолгиДопУслуги.ЦветФона = WebЦвета.Розовый;
КонецЕсли;
	
КонецПроцедуры

//// + ОбновитьДанныеКолонокТабличныхЧастей
&НаСервере
Процедура ОбновитьДанныеКолонокТабличныхЧастей()
СуммаОплаченоИтогоПроживание = 0;
Для Каждого Строка Из Объект.Проживание Цикл
	ОтборСтроки = Новый Структура("ДолгиГУИД", Строка.ГУИД);
	СуммаОплатыДолгиГУИД = ЗаявкаСервер.СуммаОплатыРаспределениеОплатДолгиОтборСтроки(ОтборСтроки, Объект.РаспределениеОплатДолги);
	
	Строка.СуммаОплачено = СуммаОплатыДолгиГУИД;	
	СуммаОплаченоИтогоПроживание = СуммаОплаченоИтогоПроживание + Строка.СуммаОплачено;
	
	Строка.НомерСчета = НомерСчетаГУИД(Строка.ГУИД);
КонецЦикла;

СуммаОплаченоИтогоДопУслуги = 0;
СуммаИтогоДопУслуги = 0;
Для Каждого Строка Из Объект.ДопУслуги Цикл
	Строка.Сумма = Строка.Цена * Строка.Количество;	
	СуммаИтогоДопУслуги = СуммаИтогоДопУслуги + Строка.Сумма;
	
	ОтборСтроки = Новый Структура("ДолгиГУИД", Строка.ГУИД);
	СуммаОплатыДолгиГУИД = ЗаявкаСервер.СуммаОплатыРаспределениеОплатДолгиОтборСтроки(ОтборСтроки, Объект.РаспределениеОплатДолги);
	
	Строка.СуммаОплачено = СуммаОплатыДолгиГУИД;	
	СуммаОплаченоИтогоДопУслуги = СуммаОплаченоИтогоДопУслуги + Строка.СуммаОплачено;
	
	Строка.НомерСчета = НомерСчетаГУИД(Строка.ГУИД);	
КонецЦикла;

// + Счета
СуммаСчетИтогоСчета = 0;
Для Каждого Строка Из Объект.Счета Цикл
	СуммаСчетаДолги = СуммаДолгиСчет(Строка.СчетГУИД);
	
	Строка.Сумма = СуммаСчетаДолги;	
	СуммаСчетИтогоСчета = СуммаСчетИтогоСчета + Строка.Сумма;
КонецЦикла;

СуммаСчетОплаченоИтогоСчета = 0;
Для Каждого Строка Из Объект.Счета Цикл
	СуммаОплатыСчет = СуммаОплатыСчет(Строка.СчетГУИД);
	
	Строка.СуммаОплачено = СуммаОплатыСчет;	
	СуммаСчетОплаченоИтогоСчета = СуммаСчетОплаченоИтогоСчета + Строка.СуммаОплачено;
КонецЦикла;

СуммаСчетКЗакрытиюИтогоСчета = 0;
Для Каждого Строка Из Объект.Счета Цикл
	СуммаКЗакрытиюСчет = СуммаКЗакрытиюСчет(Строка.СчетГУИД);
	
	Строка.СуммаКЗакрытию = СуммаКЗакрытиюСчет;	
	СуммаСчетКЗакрытиюИтогоСчета = СуммаСчетКЗакрытиюИтогоСчета + Строка.СуммаКЗакрытию;
КонецЦикла;
// - Счета

// + СчетаДетальноОплаты 
ОбновитьСчетаДетальноОплаты();
// - СчетаДетальноОплаты 

// + Распределение Оплат
РаспределениеОплат.Очистить();
ТЗ = Объект.РаспределениеОплатДолги.Выгрузить();
ТЗ.Свернуть("СчетГУИД, ДокументОплаты", "СуммаОплаты");
Для Каждого Строка Из ТЗ Цикл
	ОтборСтроки = Новый Структура("СчетГУИД", Строка.СчетГУИД);
	НайденныеСтроки = Объект.Счета.НайтиСтроки(ОтборСтроки);
	
	Если НайденныеСтроки.Количество() = 0 Тогда
		//Сообщить("ВНИМАНИЕ! В заявке - ошибочные данные. ОБРАТИТЕСЬ К АДМИНИСТРАТОРУ ПРОГРАММЫ");
		Продолжить;
	КонецЕсли;
		
	Счет = НайденныеСтроки[0];
	
	НоваяСтрока = РаспределениеОплат.Добавить();
	НоваяСтрока.НомерСчета = Счет.НомерСчета;
	НоваяСтрока.ДатаСчета = Счет.ДатаСчета;
	НоваяСтрока.ДокументОплаты = Строка.ДокументОплаты;
	НоваяСтрока.СуммаОплаты = Строка.СуммаОплаты;
КонецЦикла;
// - Распределение Оплат

ОбновитьСумму();
ОбновитьИсториюОплат();
