&НаКлиенте
Процедура Отобрать(Команда)
Если ТолькоПроживание И ТолькоУслуги Тогда
	ПоказатьПредупреждение(, "Установлены флажки 'Только проживание' и 'Только услуги'
	|
	|ОТБОР НЕ ВОЗМОЖЕН ...");
	Возврат;
КонецЕсли;
	
ОтобратьНаСервере()
КонецПроцедуры

&НаСервере
Процедура ОтобратьНаСервере()
Запрос = Новый Запрос;
Запрос.Текст = ГрупповойСчетСервер.ЗапросТекстОтборСчетовЗаявокГрупповойСчет();

Запрос.УстановитьПараметр("КонтрагентОтбор", КонтрагентОтбор);
Запрос.УстановитьПараметр("РезервС", ДатаОтбораС);

Если ЗначениеЗаполнено(ДатаОтбораПо) Тогда ДатаОтбораПо_П = ДатаОтбораПо; Иначе ДатаОтбораПо_П = '30010101'; КонецЕсли;
Запрос.УстановитьПараметр("РезервПо", ДатаОтбораПо_П);

Запрос.УстановитьПараметр("ТолькоПроживание", ТолькоПроживание);
Запрос.УстановитьПараметр("ТолькоУслуги", ТолькоУслуги);

ТЗРезультат = Запрос.Выполнить().Выгрузить();

ТаблицаОтбора.Очистить();
Для Каждого Строка Из ТЗРезультат Цикл
	Если Неоплачено тогда
		Если НЕ Строка.СуммаОплаты = 0 Тогда Продолжить; КонецЕсли;
	КонецЕсли;
	
	Если ТолькоПроживание И Строка.СуммаПроживание = 0 Тогда Продолжить; КонецЕсли;
	
	Если ТолькоУслуги И Строка.СуммаУслуги = 0 Тогда Продолжить; КонецЕсли;
	
	Если Строка.СуммаПроживание = 0 И Строка.СуммаУслуги = 0 Тогда Продолжить; КонецЕсли;
	
	НоваяСтрока = ТаблицаОтбора.Добавить();
	НоваяСтрока.ЗаявкаНаБронирование = Строка.Ссылка;
	НоваяСтрока.Контрагент = Строка.Оплачивает;
	НоваяСтрока.Проживает = Строка.Клиент;
	НоваяСтрока.Бронирует = Строка.Бронирует;
	НоваяСтрока.РезервС = Строка.РезервС;
	НоваяСтрока.РезервПо = Строка.РезервПо;
	НоваяСтрока.Номер = Строка.НомерВРезерв;
	НоваяСтрока.СуммаПроживание = Строка.СуммаПроживание;
	НоваяСтрока.СуммаУслуги = Строка.СуммаУслуги;
	НоваяСтрока.СуммаОплачено = Строка.СуммаОплаты;
	
	НоваяСтрока.ДатаЗаявки = Строка.Дата;
	НоваяСтрока.НомерЗаявки = Строка.Номер;
	
	НоваяСтрока.ТолькоПроживание = Строка.ТолькоПроживание;
	НоваяСтрока.ТолькоУслуги = Строка.ТолькоУслуги;
	
	НоваяСтрока.НомерСчета = Строка.НомерСчета;
	НоваяСтрока.ДатаСчета = Строка.ДатаСчета;
	НоваяСтрока.СчетГУИД = Строка.СчетГУИД;
КонецЦикла;	

ТаблицаОтбора.Сортировать("РезервС, ЗаявкаНаБронирование, НомерСчета, ДатаСчета"); 
КонецПроцедуры
