&НаКлиенте
Процедура КвитокКоличество_ЭПриИзменении(Элемент)
ТД = Элемент.Родитель.ТекущиеДанные;
Если ТД = Неопределено Тогда Возврат; КонецЕсли;

ТД.Количество_Есть = Истина;
ТД.Количество_Р = ТД.Количество_Э;

Если СтрНайти(ТД.КодЗаполнения, "Помещение_") > 0 Тогда
	ТД.Сумма_Э = ТД.Количество_Э * ТД.Цена;
Иначе
	ТД.Сумма_Э = КвитокСумма(ТД);
КонецЕсли;

ТД.Сумма_Есть = Истина;
ТД.Сумма_Р = ТД.Сумма_Э;
КонецПроцедуры

&НаКлиенте
Функция КвитокСумма(ТД)
ОтборСтроки = Новый Структура("РасчетСуммы, КодЗаполнения", Истина, ТД.КодЗаполнения);
НайденныеСтроки = Настройки.НайтиСтроки(ОтборСтроки);
Если НайденныеСтроки.Количество() = 0 Тогда Возврат 0; КонецЕсли;

ЦенаИмя = НайденныеСтроки[0].ЦенаИмя;
КвитокСумма = ТД.Количество_Э * ЭтаФорма[ЦенаИмя];
Возврат КвитокСумма; 	
КонецФункции

