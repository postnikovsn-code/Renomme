	Запрос=Новый Запрос("ВЫБРАТЬ
	|	ЗаявкаНаБронированиеЗабытыеВещи.Ссылка.РезервС КАК ДТ,
	|	ЗаявкаНаБронированиеЗабытыеВещи.ЗабытаяВещь КАК ЗабытыеВещи,
	|	ЗаявкаНаБронированиеЗабытыеВещи.Ссылка.Клиент.Наименование КАК ФИО,
	|	ЗаявкаНаБронированиеЗабытыеВещи.Ссылка.НомерВРезерв КАК Комната
	|ИЗ
	|	Документ.ЗаявкаНаБронирование.ЗабытыеВещи КАК ЗаявкаНаБронированиеЗабытыеВещи
	|ГДЕ
	|	ЗаявкаНаБронированиеЗабытыеВещи.Ссылка.РезервС >= &ВремяУброки
	|	И ЗаявкаНаБронированиеЗабытыеВещи.Отдана = ЛОЖЬ
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	УборкиНомеров.ВремяУброки,
	|	УборкиНомеров.ЗабытыеВещи,
	|	УборкиНомеров.Гость.Наименование,
	|	УборкиНомеров.Комната
	|ИЗ
	|	РегистрСведений.УборкиНомеров КАК УборкиНомеров
	|ГДЕ
	|	УборкиНомеров.ВремяУброки >= &ВремяУброки
	|	И (НЕ УборкиНомеров.КомментарийАдминистрации ПОДОБНО &КомментарийАдминистрации)
	|	И УборкиНомеров.ЗабытыеВещи <> """"");
	
	ЗапросФИО=Новый Запрос("ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	ЗанятостьНомеров.Клиент
	|ИЗ
	|	РегистрСведений.ЗанятостьНомеров КАК ЗанятостьНомеров
	|ГДЕ
	|	ЗанятостьНомеров.ПериодРезерва МЕЖДУ &ДН И &Дк
	|	И ЗанятостьНомеров.Номер = &Номер");
	
	Запрос.УстановитьПараметр("ВремяУброки", НачалоДня(ДобавитьМесяц(ТекущаяДата(),-6)));
	Запрос.УстановитьПараметр("КомментарийАдминистрации","%<Забытые вещи>%");
	
	ТЗ=Запрос.Выполнить().Выгрузить();
	
	//Макет=ПолучитьМакет("МакетЗабытые");
	//Макет = Отчеты.ОбщийОтчетПоГорничным.ПолучитьМакет("МакетЗабытые");
	ОтчетОбъект = РеквизитФормыВЗначение("Отчет");
	Макет = ОтчетОбъект.ПолучитьМакет("МакетЗабытые");
	
	Шапка=Макет.ПолучитьОбласть("Шапка");
	
	//ЭлементыФормы.ПолеОтчета.Очистить();
	ПолеОтчета.Очистить();
	
	//ЭлементыФормы.ПолеОтчета.Вывести(Шапка);
	ПолеОтчета.Вывести(Шапка);
	
	Для каждого Стр Из ТЗ Цикл
		Обл=Макет.ПолучитьОбласть("Строка");
		
		ЗапросФИО.УстановитьПараметр("ДН",НачалоДня(Стр.ДТ));
		ЗапросФИО.УстановитьПараметр("Дк",КонецДня(Стр.ДТ));
		ЗапросФИО.УстановитьПараметр("Номер",Стр.Комната);
		ТЗФИО=ЗапросФИО.Выполнить().Выгрузить();
		Стр.ФИО="";
		Для каждого СтрФ Из ТЗФИО Цикл
		
			Стр.ФИО = Стр.ФИО + СтрФ.Клиент.Наименование + ", ";	
		
		КонецЦикла; 
		
		Обл.Параметры.Заполнить(Стр);
		
		//ЭлементыФормы.ПолеОтчета.Вывести(Обл);
		ПолеОтчета.Вывести(Обл);
	КонецЦикла; 
	
КонецПроцедуры

