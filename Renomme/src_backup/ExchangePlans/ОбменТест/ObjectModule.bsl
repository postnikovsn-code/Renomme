	// + ПСН
	//Данные.ОбменДанными.Отправитель = ЧтениеСообщения.Отправитель;
	//Данные.ОбменДанными.Загрузка = Истина;
	//Данные.Записать();
	
	Результат = ОбменГостиницы.ЗаписатьПолученныеДанные(Данные);	
	
	Если Результат = -1 Тогда
		УдаленоКоличество = УдаленоКоличество + 1; 		
	ИначеЕсли Результат = 0 Тогда
		ДобавленоКоличество = ДобавленоКоличество + 1; 		
	ИначеЕсли Результат = 1 Тогда
		ЗамененоКоличество = ЗамененоКоличество + 1; 		
	КонецЕсли;	
	// - ПСН
КонецЦикла;

ЧтениеСообщения.ЗакончитьЧтение();
ЧтениеXML.Закрыть();

УдалитьФайлы(ИмяФайла);

//Результат = ОбщийМодульФТП.УдалитьФТПФайл(ИмяФайлаФТП);
//Если Результат.ЕстьОшибки Тогда
//	Сообщить("Ошибка удаления файла FTP: " + Результат.ОписаниеОшибки);
//КонецЕсли;

Сообщение = Новый СообщениеПользователю;
Сообщение.Текст = "-------- Конец загрузки ------------";
Сообщение.Сообщить();

Результат = Новый Структура("Удалено, Добавлено, Заменено"
	, УдаленоКоличество, ДобавленоКоличество, ЗамененоКоличество);
	
Возврат Результат;
КонецФункции
