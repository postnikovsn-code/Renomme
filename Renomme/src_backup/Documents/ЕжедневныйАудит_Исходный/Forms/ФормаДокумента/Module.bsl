		Нов.ЗаездКоррекция=Стр.Заезд;
		Нов.Выезд=Стр.Выезд;
		Нов.ВыездКоррекция=Стр.Выезд;
		Нов.Тариф_НеИспользуется=ТарифНаДату(Нов.Бронь,НАчалоДня(Объект.Дата));
		Нов.ТарифКоррекция=Нов.Тариф_НеИспользуется;
		//Политов
		Нов.Бронирует=Стр.Бронирует;  
		///Политов
		Для каждого СтрУ из Нов.Бронь.ДопУслуги цикл
			Если СтрУ.Услуга.Наименование="Ужин" и НачалоДня(СтрУ.ДатаУслуги)=НачалоДня(Объект.Дата) тогда 	
				////Нов.СуммаПолупансион=Нов.СуммаПолупансион+СтрУ.Цена*СтрУ.КолВо;
			иначеесли  СтрУ.Услуга.Родитель.Код="000000796" и НачалоДня(СтрУ.ДатаУслуги)=НачалоДня(Объект.Дата) тогда
				Нов.СуммаДопМесто=Нов.СуммаДопМесто+СтрУ.Цена*СтрУ.КолВо;
			иначеесли  СтрУ.Услуга.Родитель.Код="000000284" и НачалоДня(СтрУ.ДатаУслуги)=НачалоДня(Объект.Дата) тогда
				Нов.СуммаКоррекция=Нов.СуммаКоррекция+СтрУ.Цена*СтрУ.КолВо;
			конецесли;
			
		КонецЦикла;
		
		ОснРеквизит = Объект;
		Нов.СуммаЗаПроживание=РасчитатьСтоимостьФакт(ОснРеквизит, Нов)+Нов.СуммаДопМесто;
		Нов.СуммаЗаПроживаниеПлан=РасчитатьСтоимостьПлан(Нов);//+Нов.СуммаДопМесто;
		
		
	КонецЦикла; 
	Нов=Объект.ПроданныеНомера.Добавить();
	
	// Незаезды
	
	//ЗапросНезаездов=Новый запрос("ВЫБРАТЬ РАЗЛИЧНЫЕ
	//|	ЗанятостьНомеров.Регистратор,
	//|	ЗанятостьНомеров.Регистратор.Клиент КАК Клиент,
	//|	ЗанятостьНомеров.Регистратор.Тариф КАК Тариф,
