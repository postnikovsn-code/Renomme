

#Область ОбработчикиКомандФормы

Процедура ОперацияЗавершение(РезультатВыполнения, Параметры) Экспорт
	
	ЭтоСерверККМ = ФУ_Сервер.ЭтоСерверККМ();
	ИдентификаторОбъекта = ОбщийФункционалСервер.ПолучитьЗначениеКонстанты("СерверККМИдентификатор");
	
	Если РезультатВыполнения.Результат Тогда
		Если ЭтоСерверККМ Тогда
			Команда = Параметры.Команда;
			
			Если Команда = "ОткрытьСмену" Тогда
				ТекущееРабочееМесто = МенеджерОборудованияКлиентПовтИсп.РабочееМестоКлиента();    

				МассивОборудование = ФУ_Сервер.ПолучитьВсеУстройства(ИдентификаторОбъекта, ТекущееРабочееМесто);
				
				ДанныеОбработатьДанныеОперации = ФУ_Сервер.ПолучитьДанныеОбработатьДанныеОперации();
				
				Если ДанныеОбработатьДанныеОперации <> Неопределено Тогда
					
					Для Каждого Строка Из МассивОборудование Цикл
						ПараметрыПодключенияСерверОбработатьДанныеОперации  = ДанныеОбработатьДанныеОперации.ПараметрыПодключенияСервер;
						ПараметрыПодключенияСерверОбработатьДанныеОперации.ИдентификаторУстройства = Строка.ОборудованиеСсылка;
						ПараметрыПодключенияСерверОбработатьДанныеОперации.Наименование = Строка.ОборудованиеНаименование;
						
						КомандаОбработатьДанныеОперации = ДанныеОбработатьДанныеОперации.Команда;
						РезультатВыполненияОбработатьДанныеОперации = ДанныеОбработатьДанныеОперации.РезультатВыполнения;
						РезультатВыполненияОбработатьДанныеОперации.ИдентификаторУстройства = Строка.ОборудованиеСсылка; 
						
						ДанныеОперацииОбработатьДанныеОперации  = ДанныеОбработатьДанныеОперации.ДанныеОперации;
						
						//ОборудованиеЧекопечатающиеУстройстваВызовСервера.ОбработатьДанныеОперации(ПараметрыПодключенияСерверОбработатьДанныеОперации
						//	, КомандаОбработатьДанныеОперации, РезультатВыполненияОбработатьДанныеОперации, ДанныеОперацииОбработатьДанныеОперации);
						ОборудованиеЧекопечатающиеУстройстваКлиент.ОбработатьДанныеОперации(ПараметрыПодключенияСерверОбработатьДанныеОперации
							, КомандаОбработатьДанныеОперации, РезультатВыполненияОбработатьДанныеОперации, ДанныеОперацииОбработатьДанныеОперации);
					КонецЦикла;
				КонецЕсли;
				
			ИначеЕсли Команда = "ЗакрытьСмену" Тогда
				МассивОборудование = ФУ_Сервер.ПолучитьВсеУстройства(ИдентификаторОбъекта, ТекущееРабочееМесто);
				
				ДанныеОбработатьДанныеОперации = ФУ_Сервер.ПолучитьДанныеОбработатьДанныеОперации();
				
				Если ДанныеОбработатьДанныеОперации <> Неопределено Тогда
					
					Для Каждого Строка Из МассивОборудование Цикл
						
						ПараметрыПодключенияСерверОбработатьДанныеОперации  = ДанныеОбработатьДанныеОперации.ПараметрыПодключенияСервер;
						ПараметрыПодключенияСерверОбработатьДанныеОперации.ИдентификаторУстройства = Строка.ОборудованиеСсылка;
						ПараметрыПодключенияСерверОбработатьДанныеОперации.Наименование = Строка.ОборудованиеНаименование;
						
						КомандаОбработатьДанныеОперации = ДанныеОбработатьДанныеОперации.Команда;
						
						РезультатВыполненияОбработатьДанныеОперации = ДанныеОбработатьДанныеОперации.РезультатВыполнения;
						РезультатВыполненияОбработатьДанныеОперации.ИдентификаторУстройства = Строка.ОборудованиеСсылка; 
						
						ДанныеОперацииОбработатьДанныеОперации  = ДанныеОбработатьДанныеОперации.ДанныеОперации;
						
						ОписаниеПоследнейКассовойСмены = КассовыеСменыВызовСервера.ОписаниеПоследнейКассовойСмены(Строка.ОборудованиеСсылка);
						
						Если ОписаниеПоследнейКассовойСмены <> Неопределено Тогда
							ДанныеОперацииОбработатьДанныеОперации.КассоваяСмена = ОписаниеПоследнейКассовойСмены.КассоваяСмена;
							//ОборудованиеЧекопечатающиеУстройстваВызовСервера.ОбработатьДанныеОперации(ПараметрыПодключенияСерверОбработатьДанныеОперации
							//	, КомандаОбработатьДанныеОперации, РезультатВыполненияОбработатьДанныеОперации, ДанныеОперацииОбработатьДанныеОперации);
							ОборудованиеЧекопечатающиеУстройстваКлиент.ОбработатьДанныеОперации(ПараметрыПодключенияСерверОбработатьДанныеОперации
								, КомандаОбработатьДанныеОперации, РезультатВыполненияОбработатьДанныеОперации, ДанныеОперацииОбработатьДанныеОперации);
						КонецЕсли;		
					КонецЦикла;
				КонецЕсли;
			КонецЕсли;
		КонецЕсли;	
	КонецЕсли;	
	
	Форма = Параметры.Форма;
	//Доступность = Истина;
	Форма.Доступность = Истина;
	
	ТекстСообщения = ?(РезультатВыполнения.Результат, НСтр("ru='Операция успешно завершена.'"), РезультатВыполнения.ОписаниеОшибки);
	//ОбщегоНазначенияКлиент.СообщитьПользователю(ТекстСообщения);
	
	ОповещениеЗавершение = Параметры.ОповещениеЗавершение;
	Если ОповещениеЗавершение <> Неопределено Тогда
		Результат = Новый Структура;
		Результат.Вставить("Результат", РезультатВыполнения.Результат);
		Результат.Вставить("ТекстСообщения", ТекстСообщения);
		ВыполнитьОбработкуОповещения(ОповещениеЗавершение, Результат);
	Иначе	
		//ОбщегоНазначенияКлиент.СообщитьПользователю(ТекстСообщения);
		ОбщегоНазначенияБПОКлиент.СообщитьПользователю(ТекстСообщения);
	КонецЕсли;
КонецПроцедуры

