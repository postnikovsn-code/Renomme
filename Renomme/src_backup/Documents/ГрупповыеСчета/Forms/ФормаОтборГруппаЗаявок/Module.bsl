&НаКлиенте
Процедура ОтменаКоманда(Команда)
Закрыть();
КонецПроцедуры

&НаКлиенте
Процедура ДобавитьЗаявки(Команда)
МассивЗаявок = МассивЗаявок();
Если МассивЗаявок.Количество() = 0 Тогда 
		ПоказатьПредупреждение(, "Ничего не отмечено.");
	Возврат;
КонецЕсли;

ТекстПредупреждения = "";
Если НЕ ЗначениеЗаполнено(ТипГрупповогоСчета) Тогда 
		ТекстПредупреждения = ОбщийФункционалКлиентСервер.ДобавитьТекст(ТекстПредупреждения
			, "Заполните реквизит 'Тип группового счета'", Символы.ПС);
КонецЕсли;

Если НЕ ЗначениеЗаполнено(Контрагент) Тогда 
		ТекстПредупреждения = ОбщийФункционалКлиентСервер.ДобавитьТекст(ТекстПредупреждения
			, "Заполните реквизит 'Оплачивает'", Символы.ПС);
КонецЕсли;

Если НЕ ТекстПредупреждения = "" Тогда 
		ПоказатьПредупреждение(, ТекстПредупреждения);
	Возврат;
КонецЕсли;

ПараметрыЗакрытия = Новый Структура("ТипГрупповогоСчета, Оплачивает, ТолькоПроживание, ТолькоУслуги, МассивЗаявок"
	, ТипГрупповогоСчета, Контрагент, ТолькоПроживание, ТолькоУслуги, МассивЗаявок); 
Закрыть(ПараметрыЗакрытия);
КонецПроцедуры

&НаСервере
Функция МассивЗаявок()
ТаблицаОтбораПараметр = ТаблицаОтбора;	
МассивЗаявок = Новый Массив;
	
ОтборСтроки = Новый Структура("Отметка", Истина);
МассивОтборЗаявок = ТаблицаОтбора.НайтиСтроки(ОтборСтроки);
Если МассивОтборЗаявок.Количество() = 0 Тогда 
	Возврат МассивЗаявок; 
КонецЕсли; 

ТаблицаЗаявок = ТаблицаОтбора.Выгрузить(МассивОтборЗаявок);
ТаблицаЗаявок.Сортировать("РезервС, ЗаявкаНаБронирование, НомерСчета, ДатаСчета");

Для Каждого Строка Из ТаблицаЗаявок Цикл
	Данные = Новый Структура("ЗаявкаСсылка, СчетГУИД", Строка.ЗаявкаНаБронирование, Строка.СчетГУИД);
	
	МассивЗаявок.Добавить(Данные);
КонецЦикла;

Возврат МассивЗаявок;
КонецФункции


