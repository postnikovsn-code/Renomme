				   //|			ТОГДА ""Входит в Групповой счет Турагентству""
				   //|	КОНЕЦ КАК ТипДокумента,

	СтрокаОтчетаПараметры.ТипДокумента = Строка.ТипДокумента;
	Если Строка.ТипДокумента = "Счет Юрлицу" 
	ИЛИ Строка.ТипДокумента = "Прямой счет Турагентству" 	
	Тогда
		НомерДатаДокумента = ПечатьСервер.НомерДатаДокумента(Строка.Заявка, Строка.НомерСчета, Строка.ДатаПо);
		
