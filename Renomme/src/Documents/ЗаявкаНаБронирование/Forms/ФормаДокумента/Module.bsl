&НаСервере
Процедура УсловноеОформлениеИсторияОплат()
    ЭлементОформления = УсловноеОформление.Элементы.Добавить();     
    ПолеОформления = ЭлементОформления.Поля.Элементы.Добавить();	
    ПолеОформления.Поле = Новый ПолеКомпоновкиДанных(Элементы.ИсторияОплат.Имя); 
    ПолеОформления.Использование = Истина;
	
    ЭлементОтбора = ЭлементОформления.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
    ЭлементОтбора.ЛевоеЗначение  = Новый ПолеКомпоновкиДанных("ИсторияОплат.СуммаОплаты");   
    ЭлементОтбора.ВидСравнения   = ВидСравненияКомпоновкиДанных.Меньше;    
    ЭлементОтбора.ПравоеЗначение = 0;
    ЭлементОтбора.Использование  = Истина;
	
	ЭлементОформления.Оформление.УстановитьЗначениеПараметра("ЦветФона", WebЦвета.БледноЛиловый);
КонецПроцедуры

&НаСервере
Функция ПроверитьДанныеЗаявки()
// Проверка наличия счетов на основании РаспределениеОплатДолги 	
ТЗ = Объект.РаспределениеОплатДолги.Выгрузить();
ТЗ.Свернуть("СчетГУИД, ДокументОплаты", "СуммаОплаты");

Для Каждого Строка Из ТЗ Цикл
	ОтборСтроки = Новый Структура("СчетГУИД", Строка.СчетГУИД);
	НайденныеСтроки = Объект.Счета.НайтиСтроки(ОтборСтроки);
	
	Если НайденныеСтроки.Количество() = 0 Тогда Возврат Истина; КонецЕсли;
КонецЦикла;

Возврат Ложь;
КонецФункции

&НаСервере
Процедура ИсправитьДанныеЗаявки()
// Удаление несвязанных со счетами РаспределениеОплатДолги	
ТЗ = Объект.РаспределениеОплатДолги.Выгрузить();
ТЗ.Свернуть("СчетГУИД, ДокументОплаты", "СуммаОплаты");

МассивКУдалению = Новый Массив;
Для Каждого Строка Из ТЗ Цикл
	ОтборСтроки = Новый Структура("СчетГУИД", Строка.СчетГУИД);
	НайденныеСтроки = Объект.Счета.НайтиСтроки(ОтборСтроки);
	
	Если НайденныеСтроки.Количество() = 0 Тогда
		
		ОтборСтрокиРаспределениеОплатДолги = Новый Структура("СчетГУИД, ДокументОплаты", Строка.СчетГУИД, Строка.ДокументОплаты);
		НайденныеСтрокиРаспределениеОплатДолги = Объект.РаспределениеОплатДолги.НайтиСтроки(ОтборСтрокиРаспределениеОплатДолги);
		Для Каждого СтрокаРаспределениеОплатДолги Из НайденныеСтрокиРаспределениеОплатДолги Цикл
			МассивКУдалению.Добавить(СтрокаРаспределениеОплатДолги);
		КонецЦикла;
		
		ОтборСтрокиОплаты = Новый Структура("ДокументОплаты", Строка.ДокументОплаты);
		НайденныеСтрокиОплаты = Объект.СчетаДетальноОплаты.НайтиСтроки(ОтборСтрокиОплаты);
		Если НайденныеСтрокиОплаты.Количество() = 0 Тогда Продолжить; КонецЕсли;
		
		СтрокаОплаты = НайденныеСтрокиОплаты[0];
		СтрокаОплаты.СуммаРаспределено = СтрокаОплаты.СуммаРаспределено - Строка.СуммаОплаты; 
		
		Продолжить;
	КонецЕсли;
КонецЦикла;

Для Каждого Строка Из МассивКУдалению Цикл
	Объект.РаспределениеОплатДолги.Удалить(Строка);
КонецЦикла;

КонецПРоцедуры
