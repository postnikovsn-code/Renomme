
&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
ЭтаФорма.ТолькоПросмотр = Истина;	
	
Параметры.Свойство("РезервС", РезервС);	
Параметры.Свойство("РезервПо", РезервПо);	
Параметры.Свойство("ВремяЗаезда", ВремяЗаезда);	
Параметры.Свойство("ВремяВыезда", ВремяВыезда);	

Параметры.Свойство("БонШанс", БонШанс);	

//Параметры.Свойство("Курящий", Курящий);
Параметры.Свойство("КатегорияНомера", КатегорияНомера);

Ответ = ДокументыСервер.ЗанятостьНомераПериодРезерва(РезервС, РезервПо, ВремяЗаезда, ВремяВыезда);  

НачалоПериодаРезерва = Ответ.НачалоПериодаРезерва;
КонецПериодаРезерва = Ответ.КонецПериодаРезерва;

Если БонШанс Тогда
	Если НачалоПериодаРезерва > КонецПериодаРезерва Тогда  
		НачалоПериодаРезерва = НачалоДня(РезервС) + 3600 * 13;
		КонецПериодаРезерва = НачалоДня(РезервС) + 3600 * 18;
	КонецЕсли;	
КонецЕсли;
	
Список.Параметры.УстановитьЗначениеПараметра("ПериодРезерваС", НачалоПериодаРезерва);
Список.Параметры.УстановитьЗначениеПараметра("ПериодРезерваПо", КонецПериодаРезерва);
Список.Параметры.УстановитьЗначениеПараметра("БонШанс", БонШанс);

УсловноеОформлениеЗагрузить();
КонецПроцедуры

//
&НаСервере
Процедура УсловноеОформлениеЗагрузить()
УсловноеОформление.Элементы.Очистить();

ЭлементыТабНаФормеИмя = Элементы.Список.Имя;

ПутьКПолюОтбора = "Список.Зарезервирован";
Вид_Сравнения = ВидСравненияКомпоновкиДанных.Равно;
ПравоеЗначение = Истина;
Web_Цвета = WebЦвета.БледноКрасноФиолетовый;

ОбщийФункционалСервер.УсловноеОформлениеДобавитьПоле(УсловноеОформление
	, ЭлементыТабНаФормеИмя, ПутьКПолюОтбора, Вид_Сравнения, ПравоеЗначение, Web_Цвета );
КонецПроцедуры
