&НаСервере
Процедура СформироватьСтатистикуПоРаздельнымКроватямНаСервере()
	ЗапросРК=Новый Запрос("ВЫБРАТЬ
	                      |	ЗанятостьНомеров.Номер КАК Номер,
	                      |	ЗанятостьНомеров.Регистратор.РаздельныеКровати КАК рк,
	                      |	КОЛИЧЕСТВО(РАЗЛИЧНЫЕ ЗанятостьНомеров.Регистратор) КАК Кол
	                      |ИЗ
	                      |	РегистрСведений.ЗанятостьНомеров КАК ЗанятостьНомеров
	                      |ГДЕ
	                      |	ЗанятостьНомеров.ПериодРезерва МЕЖДУ &ДН И &ДК
	                      |	И ЗанятостьНомеров.Клиент.ВидКлиента.Наименование <> &Наименование
	                      |
	                      |СГРУППИРОВАТЬ ПО
	                      |	ЗанятостьНомеров.Номер,
	                      |	ЗанятостьНомеров.Регистратор.РаздельныеКровати
	                      |
	                      |УПОРЯДОЧИТЬ ПО
	                      |	Номер,
	                      |	рк");
	ЗапросРК.УстановитьПараметр("ДН",Отчет.ДН);						  
	ЗапросРК.УстановитьПараметр("ДК",Отчет.ДК);
	ЗапросРК.УстановитьПараметр("Наименование","Исключить из отчетов");
	ТЗ=ЗапросРК.Выполнить().Выгрузить();
	
	//Макет=ПолучитьМакет("МакетСтатистикаРК");
	Макет=отчеты.СтатистикаПоНомерам.ПолучитьМакет("МакетСтатистикаРК");
	
	Обл=Макет.ПолучитьОбласть("Шапка");
	
	//ЭлементыФормы.ПолеОтчета.Очистить();
	ПолеОтчета.Очистить();
	
	//ЭлементыФормы.ПолеОтчета.Вывести(Обл);
	ПолеОтчета.Вывести(Обл);
	
	ТЗНом=Новый ТаблицаЗначений;
	ТЗНом.Колонки.Добавить("НК");
	ТЗНом.Колонки.Добавить("О");
	ТЗНом.Колонки.Добавить("РК");
	Для каждого Стр Из ТЗ Цикл
		Поиск=ТЗНом.Найти(Стр.Номер,"НК");
		Если Поиск=Неопределено тогда
			НовНом=ТЗНом.Добавить();
			НовНом.НК=Стр.номер;
			НовНом.О=0;
			НовНом.РК=0;
			Поиск=НовНом;
		конецесли;
		Если Стр.РК тогда
			Поиск.РК=Стр.Кол;
		иначе
			Поиск.О=Стр.Кол;
		Конецесли;
		
	
		
	
	КонецЦикла; 
	Для каждого Стр Из ТЗНом Цикл
		Обл=Макет.ПолучитьОбласть("Строка");
		Обл.Параметры.Заполнить(Стр);
		
		//ЭлементыФормы.ПолеОтчета.Вывести(Обл);
		ПолеОтчета.Вывести(Обл);
	КонецЦикла; 
		Обл=Макет.ПолучитьОбласть("Строка");
		Обл.Параметры.НК="ИТОГО";
		Обл.Параметры.РК=ТЗНом.Итог("РК");
		Обл.Параметры.О=ТЗНом.Итог("О");
		
		//ЭлементыФормы.ПолеОтчета.Вывести(Обл);
		ПолеОтчета.Вывести(Обл);
КонецПроцедуры
