&НаКлиенте
Перем MSExcel, ДокументExcel;

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
Параметры.Свойство("ИмяФайла", ИмяФайла);
Параметры.Свойство("ПолноеИмяФайла", ПолноеИмяФайла);
Параметры.Свойство("ДокументДолгСсылка", ДокументДолгСсылка);
Параметры.Свойство("СчетГУИД", СчетГУИД);

//Если НЕ ЗначениеЗаполнено(СчетГУИД) Тогда
//	Отказ = Истина;
//	Возврат;
//КонецЕсли;	

Параметры.Свойство("НаАнглийском", НаАнглийском);

ЗаполнитьДанныеБрони();
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьДанныеБрони()
Если ТипЗнч(ДокументДолгСсылка) = Тип("ДокументСсылка.ЗаявкаНаБронирование") Тогда
	ЗаполнитьДанныеБрониЗаявка(ДокументДолгСсылка, СчетГУИД);
ИначеЕсли ТипЗнч(ДокументДолгСсылка) = Тип("ДокументСсылка.ГрупповыеСчета") Тогда	
	ЗаполнитьДанныеБрониГрупповойСчет(ДокументДолгСсылка, СчетГУИД);
КонецЕсли;
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьДанныеБрониЗаявка(ДокументДолгСсылка, СчетГУИД)
ОтборСтроки = Новый Структура("СчетГУИД", СчетГУИД);
Счета = ДокументДолгСсылка.Счета.НайтиСтроки(ОтборСтроки);
Если Счета.Количество() = 0 Тогда Возврат; КонецЕсли;
Счет = Счета[0];

Результат = ПечатьСервер.ДокументТелоСтроки(ДокументДолгСсылка, Счет, Ложь);	
ТЗСтроки = Результат.ТЗСтроки;

Для Каждого Строка Из ТЗСтроки Цикл
	Нов = ДанныеБрони.Добавить();

	Нов.Бронь = ДокументДолгСсылка;

	Нов.ЭтоУслуга = Строка.ЭтоУслуга;
	Нов.Клиент = Строка.Клиент;
	
	Нов.Категория = Строка.Категория;

	Нов.Наименование = Строка.НаименованиеТовара;
	
	Нов.РезервС = Формат(Строка.ДатаС, "ДФ=dd.MM.yy");
	Нов.РезервПо = Формат(Строка.ДатаПо + 86400, "ДФ=dd.MM.yy");

	Нов.КоличествоГостей = ДокументДолгСсылка.КолВоЧеловек;

	Нов.КолвоНочей = Строка.Количество;
	Нов.Количество = Строка.Количество; 

	Нов.Цена = Строка.Цена;	

	Нов.Сумма = Строка.СуммаСНДС;
КонецЦикла;
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьДанныеБрониГрупповойСчет(ГрупповойСчетОбъект, Свернуть)
Счетчик =0; СуммаДляПечатиОбщая = 0; СуммаДляПечатиОбщаяНДС = 0; ЕстьНДС0 = Ложь; ЕстьНДСНе0 = Ложь;
	
ДокументТелоСтроки = ПечатьСервер.ГрупповойСчетТелоСтроки(Счетчик, СуммаДляПечатиОбщая, СуммаДляПечатиОбщаяНДС
	, ЕстьНДС0, ЕстьНДСНе0, ГрупповойСчетОбъект);	

Для Каждого Строка Из ДокументТелоСтроки Цикл
	Нов = ДанныеБрони.Добавить();

	Нов.Бронь = ДокументДолгСсылка;

	Нов.ЭтоУслуга = Строка.ЭтоУслуга;
	Нов.Клиент = Строка.Клиент;
	Нов.Категория = Строка.Категория;

	Нов.Наименование = Строка.НаименованиеТовара;
	
	Нов.РезервС = Формат(Строка.ДатаС, "ДФ=dd.MM.yy");
	Нов.РезервПо = Формат(Строка.ДатаПо, "ДФ=dd.MM.yy");

	Нов.КоличествоГостей = Строка.КолВоЧеловек;

	Нов.КолвоНочей = Строка.Количество;
	Нов.Количество = Строка.Количество; 

	Нов.Цена = Строка.Цена;	

	Нов.Сумма = Строка.СуммаСНДС;
КонецЦикла;

КонецПроцедуры

&НаКлиенте
Процедура Запустить() Экспорт
Результат = ФормированиеПодтвержденияEXCEL(НаАнглийском);	

Если Результат.Ошибка Тогда
	Закрыть(Результат);
Иначе
	Закрыть();
КонецЕсли;	
Конецпроцедуры

&НаКлиенте
Функция ФормированиеПодтвержденияEXCEL(НаАнглийском)
Результат = Новый Структура("Ошибка, ТекстОшибки, ОписаниеОшибки", Ложь, "", "");

ФайлНаДиске = Новый Файл(ПолноеИмяФайла);
Если ФайлНаДиске.Существует() Тогда
	Попытка
		УдалитьФайлы(ПолноеИмяФайла);	
	Исключение
		Результат.Ошибка = Истина; 		
		Результат.ТекстОшибки = "Ошибка удаления 'старого' файла подтверждения";
		Результат.ОписаниеОшибки = ОписаниеОшибки();
		
		Возврат Результат; 
	КонецПопытки;		
КонецЕсли;	

Ответ = СкопироватьОбразецПодтверждение(ПолноеИмяФайла, НаАнглийском);
Если Ответ.Ошибка Тогда
	Результат.Ошибка = Истина;
	Результат.ТекстОшибки = "Ошибка копирования шаблона подтверждения";
	Результат.ОписаниеОшибки = Ответ.ОписаниеОшибки;
	
	Возврат Результат;
КонецЕсли;	
	
Индикатор = 15;
ОбновитьОтображениеДанных();

Попытка 	   
	MSExcel = Новый COMОбъект("Excel.Application");
Исключение
	Результат.Ошибка = Истина;
	Результат.ТекстОшибки = "Ошибка создания COMОбъекта Excel.Application";
	Результат.ОписаниеОшибки = ОписаниеОшибки();
	
	Возврат Результат;
КонецПопытки;
	
MSExcel.DisplayAlerts = Истина;

//MSExcel.Visible = Истина;
MSExcel.Visible = Ложь;

//MSExcel.ScreenUpdating = Истина;

Попытка 
	WorkBook = MSExcel.Workbooks.Open(ПолноеИмяФайла); 
Исключение
	Результат.Ошибка = Истина;
	Результат.ТекстОшибки = "Ошибка открытия подтверждения";
	Результат.ОписаниеОшибки = ОписаниеОшибки();
	
	MSExcel.Visible = Истина;
	Попытка
		MSExcel.Quit();
		MSExcel = Неопределено;
	Исключение
	КонецПопытки;
	
	Возврат Результат;
КонецПопытки;

//MSExcel.ScreenUpdating = False;

Индикатор = 20;
ОбновитьОтображениеДанных();

Попытка 
	MSExcel.DisplayAlerts = Ложь;
	MSExcel.Visible = Ложь;
	
	ПоискСтрока = MSExcel.Cells.Find("<Строка>");

	Если ПоискСтрока = Неопределено Тогда 
		Результат.Ошибка = Истина;
		Результат.ТекстОшибки = "Не найдено <Строка> в файле образца";
		Результат.ОписаниеОшибки = ОписаниеОшибки();
		Возврат Результат;
	Иначе
		ТекущаяСтрока = ПоискСтрока.Row;
		ТекущаяСтрокаОбразец = ТекущаяСтрока; 
	КонецЕсли;	
	
	Индикатор = 25;
	ОбновитьОтображениеДанных();

	Для Индекс = 1 По ДанныеБрони.Количество() Цикл
		СтрНом = ДанныеБрони[Индекс - 1];
		
		Область = Строка(ТекущаяСтрокаОбразец) + ":" +  Строка(ТекущаяСтрокаОбразец);
		MSExcel.Rows(Область).Select();
		
		//MSExcel.Rows(Область).AutoFit();
		
		//Если Индекс > 1 Тогда
			MSExcel.Selection.Copy();
			Область = Строка(ТекущаяСтрока + 1) + ":" +  Строка(ТекущаяСтрока + 1);
			MSExcel.Rows(Область).Select();
	
			xlShiftDown	= -4121;
			xlFormatFromLeftOrAbove = 0;
			//xlFormatFromLeftOrAbove = 1;
			//MSExcel.Selection.Insert(xlShiftDown, xlFormatFromLeftOrAbove);
			//MSExcel.CutCopyMode = False;
			MSExcel.Selection.Insert(xlShiftDown);

			ТекущаяСтрока = ТекущаяСтрока + 1;
		//КонецЕсли;
		
		ФормированиеСтрокиПодтвержденияExcel(СтрНом);                                   

		Индикатор = 25 + 0.7 * (Индекс * 100 / ДанныеБрони.Количество()) ;
		ОбновитьОтображениеДанных();
	КонецЦикла;
	
	Область = Строка(ТекущаяСтрокаОбразец) + ":" +  Строка(ТекущаяСтрокаОбразец);
	MSExcel.Rows(Область).Delete();

	ИтогоСумма = 0;
	Для Каждого Строка Из ДанныеБрони Цикл
		ИтогоСумма = ИтогоСумма + Строка.Сумма;
	КонецЦикла;
	
	//ТекущаяСтрока = ТекущаяСтрока + 1;
	Область = Строка(ТекущаяСтрока) + ":" +  Строка(ТекущаяСтрока);
	MSExcel.Rows(Область).Select();
	Текст = Строка(ИтогоСумма);
	
	Если НастройкиСервер.ЭтоЛайв() Тогда
		MSExcel.Selection.Cells(1, 9).FormulaR1C1 = Текст;
	ИначеЕсли НастройкиСервер.ЭтоЧехов() Тогда
		MSExcel.Selection.Cells(1, 14).FormulaR1C1 = Текст;
	ИначеЕсли НастройкиСервер.ЭтоДомСоветов() Тогда
		MSExcel.Selection.Cells(1, 14).FormulaR1C1 = Текст;
	Иначе
		MSExcel.Selection.Cells(1, 6).FormulaR1C1 = Текст;
	КонецЕсли;
Исключение
	MSExcel.DisplayAlerts = Истина;
	MSExcel.Visible = Истина;
	
	//MSExcel.ScreenUpdating = True;
	
	Результат.Ошибка = Истина;
	Результат.ТекстОшибки = "Ошибка заполнения подтверждения";
	Результат.ОписаниеОшибки = ОписаниеОшибки();

	Попытка
		MSExcel.Quit();
		MSExcel = Неопределено;
	Исключение
	КонецПопытки;

	Возврат Результат;
КонецПопытки;

MSExcel.DisplayAlerts = Истина;
Попытка
	WorkBook.Save();
Исключение
	MSExcel.Visible = Истина;
	
	Результат.Ошибка = Истина;
	Результат.ТекстОшибки = "Ошибка сохранения подтверждения";
	Результат.ОписаниеОшибки = ОписаниеОшибки();
	Возврат Результат;
КонецПопытки;

Индикатор = 100;
ОбновитьОтображениеДанных();

Попытка
	MSExcel.Quit();
	MSExcel = Неопределено;
Исключение
	MSExcel.Visible = Истина;
	
	Результат.Ошибка = Истина;
	Результат.ТекстОшибки = "Ошибка закрытия подтверждения";
	Результат.ОписаниеОшибки = ОписаниеОшибки();
	Возврат Результат;
КонецПопытки;

Возврат Результат;
КонецФункции

&НаКлиенте
Функция ФормированиеСтрокиПодтвержденияExcel(СтрНом) 
Если НастройкиСервер.ЭтоЛайв() Тогда	
	Если СтрНом.ЭтоУслуга Тогда	
		Текст = СтрНом.Наименование;
		MSExcel.Selection.Cells(1, 1).FormulaR1C1 = Текст;
		RowColHeightForContent(MSExcel.Selection.Cells(1, 1));
		
		//Текст = ПолучитьКатегорияНомера(СтрНом.Бронь);
		Текст = "";
		MSExcel.Selection.Cells(1, 4).FormulaR1C1 = Текст;
		
		Текст = Строка(СтрНом.РезервС);
		MSExcel.Selection.Cells(1, 5).FormulaR1C1 = Текст;
		
		Текст = Строка(СтрНом.Количество);
		MSExcel.Selection.Cells(1, 6).FormulaR1C1 = Текст;
		
		//Текст = Строка(СтрНом.РезервПо);
		Текст = "";
		MSExcel.Selection.Cells(1, 7).FormulaR1C1 = Текст;
		
		Текст = Строка(СтрНом.Цена);
		MSExcel.Selection.Cells(1, 8).FormulaR1C1 = Текст;

		Текст = Строка(СтрНом.Сумма);
		MSExcel.Selection.Cells(1, 9).FormulaR1C1 = Текст;
		
	Иначе	
			
		//Текст = ПолучитьФИО(СтрНом.Бронь);
		Текст = СтрНом.Клиент;
		MSExcel.Selection.Cells(1, 1).FormulaR1C1 = Текст;
		RowColHeightForContent(MSExcel.Selection.Cells(1, 1));

		Текст = СтрНом.Категория;
		MSExcel.Selection.Cells(1, 4).FormulaR1C1 = Текст;
		RowColHeightForContent(MSExcel.Selection.Cells(1, 4));
		
		Текст = Строка(СтрНом.РезервС);
		MSExcel.Selection.Cells(1, 5).FormulaR1C1 = Текст;
		
		Текст = Строка(СтрНом.КолвоНочей);
		MSExcel.Selection.Cells(1, 6).FormulaR1C1 = Текст;
		
		Текст = Строка(СтрНом.РезервПо);
		MSExcel.Selection.Cells(1, 7).FormulaR1C1 = Текст;
		
		Текст = Строка(СтрНом.Цена);
		MSExcel.Selection.Cells(1, 8).FormulaR1C1 = Текст;

		Текст = Строка(СтрНом.Сумма);
		MSExcel.Selection.Cells(1, 9).FormulaR1C1 = Текст;
	КонецЕсли;	
ИначеЕсли НастройкиСервер.ЭтоЧехов() Тогда	
	Если СтрНом.ЭтоУслуга Тогда	
		//Текст = ПолучитьФИО(СтрНом.Бронь);
		Текст = СтрНом.Наименование;
		MSExcel.Selection.Cells(1, 2).FormulaR1C1 = Текст;
		RowColHeightForContent(MSExcel.Selection.Cells(1, 2));

		//Текст = ПолучитьКатегорияНомера(СтрНом.Бронь);
		Текст = "";
		MSExcel.Selection.Cells(1, 8).FormulaR1C1 = Текст;
		
		//Текст = Строка(СтрНом.КоличествоГостей);
		Текст = "";
		MSExcel.Selection.Cells(1, 9).FormulaR1C1 = Текст;
		
		Текст = Строка(СтрНом.РезервС);
		//MSExcel.Selection.Range("B1").FormulaR1C1 = Текст;
		MSExcel.Selection.Cells(1, 10).FormulaR1C1 = Текст;
		
		//КоличествоНочей = (СтрНом.РезервПо_дата - СтрНом.РезервС_дата) / 24 * 60 * 60;
		//КоличествоНочей = (СтрНом.КолВо);
		//Текст = Строка(КоличествоНочей);
		Текст = СтрНом.Количество;
		MSExcel.Selection.Cells(1, 11).FormulaR1C1 = Текст;
		
		//Текст = Строка(СтрНом.РезервПо);
		Текст = "";
		MSExcel.Selection.Cells(1, 12).FormulaR1C1 = Текст;
		
		Текст = Строка(СтрНом.Цена);
		MSExcel.Selection.Cells(1, 13).FormulaR1C1 = Текст;

		//Текст = Строка(СтрНом.Колво * СтрНом.Цена);
		Текст = Строка(СтрНом.Сумма);
		MSExcel.Selection.Cells(1, 14).FormulaR1C1 = Текст;
	
	Иначе
		//Текст = ПолучитьФИО(СтрНом.Бронь);
		Текст = СтрНом.Клиент;
		//MSExcel.Selection.Range("A1").FormulaR1C1 = Текст;
		MSExcel.Selection.Cells(1, 2).FormulaR1C1 = Текст;
		RowColHeightForContent(MSExcel.Selection.Cells(1, 2));

		//Текст = ПолучитьКатегорияНомера(СтрНом.Бронь);
		Текст = СтрНом.Категория;
		MSExcel.Selection.Cells(1, 8).FormulaR1C1 = Текст;
		RowColHeightForContent(MSExcel.Selection.Cells(1, 8));
		
		Текст = Строка(СтрНом.КоличествоГостей);
		MSExcel.Selection.Cells(1, 9).FormulaR1C1 = Текст;
	
		Текст = Строка(СтрНом.РезервС);
		MSExcel.Selection.Cells(1, 10).FormulaR1C1 = Текст;
		
		//КоличествоНочей = (СтрНом.РезервПо_дата - СтрНом.РезервС_дата) / 24 * 60 * 60;
		КоличествоНочей = (СтрНом.КолВоНочей);
		Текст = Строка(КоличествоНочей);
		MSExcel.Selection.Cells(1, 11).FormulaR1C1 = Текст;
		
		Текст = Строка(СтрНом.РезервПо);
		MSExcel.Selection.Cells(1, 12).FormulaR1C1 = Текст;
		
		Текст = Строка(СтрНом.Цена);
		MSExcel.Selection.Cells(1, 13).FormulaR1C1 = Текст;

		//Текст = Строка(СтрНом.Колво * СтрНом.Цена);
		Текст = Строка(СтрНом.Сумма);
		MSExcel.Selection.Cells(1, 14).FormulaR1C1 = Текст;
	КонецЕсли;	
ИначеЕсли НастройкиСервер.ЭтоСтритАрт() Тогда
	
	Если СтрНом.ЭтоУслуга Тогда	
	
		//Текст = ПолучитьФИО_Категория(СтрНом.Бронь);
		Текст = СтрНом.Наименование;
		MSExcel.Selection.Cells(1, 1).FormulaR1C1 = Текст;
		RowColHeightForContent(MSExcel.Selection.Cells(1, 1));

		Текст = Строка(СтрНом.РезервС);
		MSExcel.Selection.Cells(1, 2).FormulaR1C1 = Текст;
		
		//Текст = Строка(СтрНом.Колво);
		Текст = Строка(СтрНом.Количество);
		MSExcel.Selection.Cells(1, 3).FormulaR1C1 = Текст;
		
		//Текст = Строка(СтрНом.РезервПо);
		Текст = "";
		MSExcel.Selection.Cells(1, 4).FormulaR1C1 = Текст;
		
		Текст = Строка(СтрНом.Цена);
		MSExcel.Selection.Cells(1, 5).FormulaR1C1 = Текст;

		Текст = Строка(СтрНом.Сумма);
		MSExcel.Selection.Cells(1, 6).FormulaR1C1 = Текст;
	Иначе
		//Текст = ПолучитьФИО_Категория(СтрНом.Бронь);
		Текст = СтрНом.Клиент;
		MSExcel.Selection.Cells(1, 1).FormulaR1C1 = Текст;
		RowColHeightForContent(MSExcel.Selection.Cells(1, 1));

		Текст = Строка(СтрНом.РезервС);
		MSExcel.Selection.Cells(1, 2).FormulaR1C1 = Текст;
		
		Текст = Строка(СтрНом.КолвоНочей);
		MSExcel.Selection.Cells(1, 3).FormulaR1C1 = Текст;
		
		Текст = Строка(СтрНом.РезервПо);
		MSExcel.Selection.Cells(1, 4).FormulaR1C1 = Текст;
		
		Текст = Строка(СтрНом.Цена);
		MSExcel.Selection.Cells(1, 5).FormulaR1C1 = Текст;

		Текст = Строка(СтрНом.Сумма);
		MSExcel.Selection.Cells(1, 6).FormulaR1C1 = Текст;		
		
	КонецЕсли;
ИначеЕсли НастройкиСервер.ЭтоДомСоветов() Тогда	
