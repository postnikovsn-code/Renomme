&НаКлиенте
Процедура ЗавершитьВводЗначенияВторойНомер(Результат, ДополнительныеПараметры) Экспорт
Если Результат = Неопределено Тогда Возврат; КонецЕсли;

	Док1=ДополнительныеПараметры.Док1;
	Док2=Результат;
	
	Если Док1 <> ПредопределенноеЗначение("Документ.ЗаявкаНаБронирование.ПустаяСсылка") 
	И Док2 <> ПредопределенноеЗначение("Документ.ЗаявкаНаБронирование.ПустаяСсылка") 
	И Док1<>Док2 тогда  
		ПерезаписатьДокументыБронирования(Док1, Док2);
		
		ВыводШахматки();
		ПоказатьПредупреждение(,"Номера заменены");
	иначе
		Сообщить("Ошибка выбора!");
	конецесли;

КонецПроцедуры


&НаСервере
Процедура ПерезаписатьДокументыБронирования(Док1, Док2)
	
		ОбДок1=Док1.ПолучитьОбъект();
		ОбДок2=Док2.ПолучитьОбъект();
		ОбДок1.Записать(РежимЗаписиДокумента.ОтменаПроведения);
		ОбДок2.Записать(РежимЗаписиДокумента.ОтменаПроведения);
		
		Темп=ОбДок1.НомерВРезерв;
		ОбДок1.НомерВРезерв=ОбДок2.НомерВРезерв;
		ОбДок2.НомерВРезерв=Темп;
		ОбДок1.Записать(РежимЗаписиДокумента.Проведение,РежимПроведенияДокумента.Неоперативный);
		ОбДок2.Записать(РежимЗаписиДокумента.Проведение,РежимПроведенияДокумента.Неоперативный);

КонецПроцедуры


