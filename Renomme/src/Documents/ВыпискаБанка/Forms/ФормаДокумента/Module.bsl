&НаСервере
Процедура УдалитьДокументВозврат()
ТС = Элементы.Возвраты.ТекущаяСтрока;
ТД = Возвраты.НайтиПоИдентификатору(ТС);

ДокументВозврат = ТД.ДокументВозврата;
ДокументВозвратОбъект = ДокументВозврат.ПолучитьОбъект();

ДокументВозвратОбъект.Удалить();

ЭтаФорма.Прочитать();
КонецПроцедуры
//

&НаКлиенте
Процедура ДолгиОплатаВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
Если Поле.Имя = "ДолгиОплатаСумма" 
//ИЛИ Поле.Имя = "ДолгиОплатаДокументДолг" 
Тогда Возврат; Конецесли;	

ТД = Объект.ДолгиОплата.НайтиПоИдентификатору(ВыбраннаяСтрока);
ДокументДолг = ТД.ДокументДолг; 

ТолькоПросмотр = НЕ ЭтоАдминистратор;
ОплатыОбщееКлиент.ОткрытьДокументДолг(ЭтаФорма, ДокументДолг, ТолькоПросмотр, РежимОткрытияОкнаФормы.Независимый); 
КонецПроцедуры

//
&НаКлиенте
Процедура ПередЗакрытием(Отказ, ЗавершениеРаботы, ТекстПредупреждения, СтандартнаяОбработка)
Если ЗакрытьФорму Тогда Возврат; КонецЕсли;	
	
ЗакрытьФорму = Истина;	
Отказ = Истина;

Закрыть(Объект.Ссылка);
КонецПроцедуры

//
&НаКлиенте
Процедура ОтКогоНаименованиеНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
Оповещение = Новый ОписаниеОповещения("ЗавершениеФормы_ОтКогоНаименованиеНачалоВыбора", ЭтаФорма);

ОткрытьФорму("Справочник.Клиенты.Форма.ФормаВыбора", , ЭтаФорма
	,,,, Оповещение, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца); 
КонецПроцедуры

&НаКлиенте
Процедура ЗавершениеФормы_ОтКогоНаименованиеНачалоВыбора(Результат, ДополнительныеПараметры) Экспорт
Если Результат = Неопределено Тогда Возврат; КонецЕсли;
	
Если ЕстьДолгиОплатаПредупреждение() Тогда 
	Возврат; 
КонецЕсли;

Объект.ОтКого = Результат;
ОтКогоНаименование = КлиентыСервер.КлиентПредставление(Результат);

ОтКого_OldValue = ОбщийФункционалСервер.ЗначениеРеквизитаНаСервере(Объект.Ссылка, "ОтКого"); 
Если Объект.ОтКого <> ОтКого_OldValue Тогда 
	Объект.ДокументДолг = Неопределено;
КонецЕсли;

Элементы.ОтКого.Видимость = КлиентыСервер.ЭтоЮрЛицо(Объект.ОтКого);
КонецПроцедуры

&НаКлиенте
Процедура ОтКогоНаименованиеОткрытие(Элемент, СтандартнаяОбработка)
СтандартнаяОбработка = Ложь;

ПараметрыФормы = Новый Структура("Ключ", Объект.ОтКого);

ОткрытьФорму("Справочник.Клиенты.Форма.ФормаЭлемента", ПараметрыФормы, ЭтаФорма
	,,,,, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
КонецПроцедуры

