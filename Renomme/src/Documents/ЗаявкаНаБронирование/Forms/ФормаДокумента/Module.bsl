&НаКлиенте
Процедура ВозвратОплаты(Команда)
Если ЭтотОбъектЗаписатьНаКлиенте() Тогда Возврат; КонецЕсли;	

Оповещение = Новый ОписаниеОповещения("ЗавершениеФормы_ЧекВозврат", ЭтаФорма);

ПараметрыФормы = Новый Структура(); 

СписокЗначенийКонтрагенты = Новый СписокЗначений;
СписокЗначенийКонтрагенты.Добавить(Объект.Клиент);
Если ЗначениеЗаполнено(Объект.Клиент2) Тогда СписокЗначенийКонтрагенты.Добавить(Объект.Клиент2); КонецЕсли;
	
Если ЗначениеЗаполнено(Объект.Оплачивает) Тогда
	Если Объект.Оплачивает <> Объект.Клиент И Объект.Оплачивает <> Объект.Клиент2 Тогда
		ТипКлиентаОплачивает = ОбщийФункционалСервер.ЗначениеРеквизитаНаСервере(Объект.Оплачивает, "ТипКлиента");
		Если ТипКлиентаОплачивает = ПредопределенноеЗначение("Перечисление.ТипыКлиентов.ФизЛицо") 
		Тогда СписокЗначенийКонтрагенты.Добавить(Объект.Оплачивает); КонецЕсли;	
	КонецЕсли;	
КонецЕсли;	

ПараметрыФормы.Вставить("КонтрагентыОтбор", СписокЗначенийКонтрагенты);

ПараметрыФормы.Вставить("ДокументДолг", Объект.Ссылка);

ОткрытьФорму("ОбщаяФорма.ЧекВозврат", ПараметрыФормы, ЭтаФорма
	,,,,Оповещение , РежимОткрытияОкнаФормы.БлокироватьВесьИнтерфейс);
КонецПроцедуры

