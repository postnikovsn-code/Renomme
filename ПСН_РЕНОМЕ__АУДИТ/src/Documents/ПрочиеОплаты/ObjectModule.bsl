Функция ТекстОшибки() Экспорт
ТекстПредупреждение = "";	
ТекстСообщение = "";	
//Если НЕ ЗначениеЗаполнено(ДатаОплаты) Тогда
Если НЕ ЗначениеЗаполнено(ДатаОплаты) Тогда
	Текст =  "Дата оплаты - пусто"; 
	ТекстПредупреждение = ТекстПредупреждение + Символы.ПС + Текст;	
	ТекстСообщение = ТекстСообщение +  Текст + ", ";	
КонецЕсли;	

