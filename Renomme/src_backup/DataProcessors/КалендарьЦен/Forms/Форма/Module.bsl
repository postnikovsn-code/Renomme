&НаСервере
Процедура СформироватьАналитикаОтчет(ТаблицаВывод, ДатаС, ДатаПо)
Макет = Обработки.КалендарьЦен.ПолучитьМакет("МакетОсновной");

ТабДок = Новый ТабличныйДокумент;

ТабДокЗаголовки = Новый ТабличныйДокумент;
ЗаголовкиОтступ = Макет.ПолучитьОбласть("ШапкаВерх|Отступ");
ТабДокЗаголовки.Вывести(ЗаголовкиОтступ);
		
ГруппаКатегории = Новый ТабличныйДокумент;

ГруппаКатегории.НачатьГруппуСтрок(, Ложь);
ЗаголовкиКатегории = Макет.ПолучитьОбласть("ШапкаВерх|Категории");

//Пока ВыборкаДва.Следующий() Цикл
Для Каждого Строка Из ТЗКатегорииНомеров Цикл
	ЗаголовкиКатегории.Параметры.Категория = Строка.Ссылка.Наименование;
	ГруппаКатегории.Вывести(ЗаголовкиКатегории);
КонецЦикла;
ГруппаКатегории.ЗакончитьГруппуСтрок();

ТабДокЗаголовки.Вывести(ГруппаКатегории);

ТабДок.Присоединить(ТабДокЗаголовки);

ДеньНедели = ДеньНедели(ДатаС);
День = ДеньНедели - 1;
Пока День > 0 Цикл
	ТабДокДата = Новый ТабличныйДокумент;
	
	ТабДок.Присоединить(ТабДокДата);
	
	День = День - 1;
КонецЦикла;

ОтборСтроки = Новый Структура("ДатаМесяц", ДатаС);
НайденныеСтрокиТЗАналитика = ТЗАналитика.НайтиСтроки(ОтборСтроки);
Для Каждого СтрокаТЗАналитика Из НайденныеСтрокиТЗАналитика Цикл
	
	ТабДокДата = Новый ТабличныйДокумент;
	ДатаШапка = Макет.ПолучитьОбласть("Дата|Отступ");
	
	ДатаШапка.Параметры.ИтогЗанято = ?(СтрокаТЗАналитика.ИтогЗанято = 0, "-", СтрокаТЗАналитика.ИтогЗанято);
	ТабДокДата.Вывести(ДатаШапка);
	
	ОтборСтроки = Новый Структура("Дата", СтрокаТЗАналитика.Дата);
	НайденныеСтрокиКатегории = ТЗАналитикаКатегории.НайтиСтроки(ОтборСтроки);	
	Для Каждого НайденнаяСтрокаКатегории Из НайденныеСтрокиКатегории Цикл 
		ДатаКатегории = Макет.ПолучитьОбласть("Дата|Категории");
		
		ДатаКатегории.Параметры.КатегорияЗабронировано = ?(НайденнаяСтрокаКатегории.КатегорияЗабронировано = 0, "-"
			, НайденнаяСтрокаКатегории.КатегорияЗабронировано);
		ТабДокДата.Вывести(ДатаКатегории);
	КонецЦикла;

	ТабДок.Присоединить(ТабДокДата);
КонецЦикла;

ТаблицаВывод.Вывести(ТабДок);

//// + ADR
ТабДок = Новый ТабличныйДокумент;

ТабДокЗаголовки = Новый ТабличныйДокумент;
