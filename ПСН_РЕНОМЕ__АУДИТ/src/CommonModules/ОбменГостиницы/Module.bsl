Функция ВыполнитьВыгрузкуУзла(Узел) Экспорт
Если НЕ ЗначениеЗаполнено(Узел) Тогда Возврат Неопределено; КонецЕсли;
	
УзелОбмена = Узел.ПолучитьОбъект();

Результат = УзелОбмена.ЗаписатьСообщениеСИзменениями();

Возврат Результат;
КонецФункции

Функция ВыполнитьЗагрузкуУзла(Узел) Экспорт
Если НЕ ЗначениеЗаполнено(Узел) Тогда Возврат Неопределено; КонецЕсли;

УзелОбмена = Узел.ПолучитьОбъект();

//УзелОбмена.ПрочитатьСообщениеПодтверждения();
Результат = УзелОбмена.ПрочитатьСообщениеСИзменениями(); 

Возврат Результат;
КонецФункции

Функция ВыполнитьОбменДанными() Экспорт  
Массив = Новый Массив;
	
Выборка = ПланыОбмена.ОбменГостиницы.Выбрать();

Пока Выборка.Следующий() Цикл
	Если Выборка.ЭтотУзел Тогда Продолжить; КонецЕсли;	
	
	Результат = Новый Структура("РезультатЧтения, РезультатЗаписи", Неопределено, Неопределено);
	
	УзелОбмена = Выборка.ПолучитьОбъект();

	РезультатЧтения = УзелОбмена.ПрочитатьСообщениеСИзменениями();
	Результат.РезультатЧтения = РезультатЧтения;
	
	Если РезультатЧтения.Ошибка Тогда 
		Если НЕ (РезультатЧтения.КодОшибки = 1 ИЛИ РезультатЧтения.КодОшибки = 30) Тогда 
			Массив.Добавить(Результат);
			
			Продолжить; 
		КонецЕсли;
	КонецЕсли;
	                                        
	РезультатЗаписи = УзелОбмена.ЗаписатьСообщениеСИзменениями();	
	Результат.РезультатЗаписи = РезультатЗаписи;
	
	Массив.Добавить(Результат);
КонецЦикла;

Возврат Массив;
КонецФункции

