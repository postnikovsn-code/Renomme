ТД = Объект.Счета.НайтиПоИдентификатору(ТС);
//Если ОплатыЧекКлиент.ЕстьОплатыСчета(ТекущиеДанные.СчетГУИД, Объект.РаспределениеОплатДолги);

Если ЗначениеЗаполнено(ТД.ГрупповойСчет) Тогда 
	ПоказатьПредупреждение(, "Групповой счет.
							|
							|ОБНОВЛЕНИЕ НЕ РАЗРЕШЕНО ...");
	Возврат; 
КонецЕсли;

Если ТД.ЭтоПредварительныйГрупповойСчет Тогда 
	ПоказатьПредупреждение(, "Предварительный групповой счет.
							|
							|ОБНОВЛЕНИЕ НЕ РАЗРЕШЕНО ...");
	Возврат; 
КонецЕсли;

Если ТД.Закрыт Тогда 
	ПоказатьПредупреждение(, "Счет закрыт.
							|
							|ОБНОВЛЕНИЕ НЕ РАЗРЕШЕНО ...");
	Возврат; 
КонецЕсли;

Если ЭтотОбъектЗаписатьНаКлиенте() Тогда Возврат; КонецЕсли;

Результат = ОбновитьСчетНаСервере(ТС); 
//Если Результат Тогда ПоказатьПредупреждение(, "Нечего добавить в счет"); КонецЕсли;	
КонецПроцедуры

&НаСервере
Функция ОбновитьСчетНаСервере(Идентификатор)
ТД = Объект.Счета.НайтиПоИдентификатору(Идентификатор);	
	
НачатьТранзакцию();

Результат = ОбновитьСчетЗаявка(ТД, Объект, Истина);

ЭтаФорма.Записать(Новый Структура("РежимЗаписи", РежимЗаписиДокумента.Проведение));
ЗафиксироватьТранзакцию();

Возврат Результат; 
КонецФункции
