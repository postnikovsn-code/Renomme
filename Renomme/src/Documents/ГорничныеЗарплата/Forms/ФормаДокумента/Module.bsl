ОбновитьСдельноСтрока(ТД);
КонецПроцедуры

&НаСервере
Процедура ОбновитьСдельноСтрока(ТД)
ТД.Выход = ТД.СуммаВыход <> 0;	

ТД.Итого = СдельноИтого(ТД);
КонецПроцедуры			

&НаСервере
Функция СдельноИтого(ТД)
Если НЕ (ЗначениеЗаполнено(ТД.Горничная) И ЗначениеЗаполнено(ТД.Дата)) Тогда
	Возврат 0;
КонецЕсли;

Итого = ТД.Г_Сумма + ТД.Т_Сумма + ТД.ТС_Сумма + ТД.МК_Сумма + ТД.МДМ_Сумма + ТД.СуммаВыход       
			+ ТД.ПоСтавке + ТД.ПоЧасамСумма + ТД.ВечерУтро + ТД.Корректировка;
			
Возврат Итого;			
КонецФункции	

&НаКлиенте		
Процедура ГорничнаяСдельноИтогоДействие(ТД)
Если ЗначениеЗаполнено(ТД.Горничная) Тогда
	ОтборСтроки = Новый Структура("Горничная", ТД.Горничная);	
	НайденныеСтроки = Объект.Сдельно.НайтиСтроки(ОтборСтроки);
	ГорничнаяСдельноИтого = 0;
	ВыплатыИтого = 0;
	Для Каждого Строка Из НайденныеСтроки Цикл
		ГорничнаяСдельноИтого = ГорничнаяСдельноИтого + Строка.Итого; 		
		ВыплатыИтого = ВыплатыИтого + Строка.ВыплатыСумма; 		
	КонецЦикла;

	НайденныеСтрокиЗарплата = Объект.Зарплата.НайтиСтроки(ОтборСтроки);
	Если НайденныеСтрокиЗарплата.Количество() > 0 Тогда 
		НайденнаяСтрокаЗарплата = НайденныеСтрокиЗарплата[0];
		НайденнаяСтрокаЗарплата.Сдельно = ГорничнаяСдельноИтого;
		НайденнаяСтрокаЗарплата.Сдельно_нал = ВыплатыИтого;
	КонецЕсли;
Иначе	
	ОтборСтроки = Новый Структура("Горничная", СдельноГорничная_OldValue);
	НайденныеСтрокиЗарплата = Объект.Зарплата.НайтиСтроки(ОтборСтроки);
	Если НайденныеСтрокиЗарплата.Количество() > 0 Тогда 
		НайденнаяСтрокаЗарплата = НайденныеСтрокиЗарплата[0];
		НайденнаяСтрокаЗарплата.Сдельно = НайденнаяСтрокаЗарплата.Сдельно - СдельноИтого_OldValue;
		НайденнаяСтрокаЗарплата.Сдельно_нал = НайденнаяСтрокаЗарплата.Сдельно_нал - СдельноВыплаты_OldValue;
	КонецЕсли;
КонецЕсли;

Если НайденныеСтрокиЗарплата.Количество() > 0 Тогда 
	Если НЕ НайденнаяСтрокаЗарплата.Сдельно_Есть Тогда
		НайденнаяСтрокаЗарплата.Сдельно_Э = НайденнаяСтрокаЗарплата.Сдельно;
	КонецЕсли;

	Если НЕ НайденнаяСтрокаЗарплата.Сдельно_нал_Есть Тогда
		НайденнаяСтрокаЗарплата.Сдельно_нал_Э = НайденнаяСтрокаЗарплата.Сдельно_нал;
	КонецЕсли;
	
	Идентификатор = НайденнаяСтрокаЗарплата.ПолучитьИдентификатор();
	ОбновитьЗарплатаИтогоИзКлиента(Идентификатор);
КонецЕсли;

КонецПроцедуры

&НаСервере
Процедура ОбновитьЗарплатаИтогоИзКлиента(Идентификатор)
ТД = Объект.Зарплата.НайтиПоИдентификатору(Идентификатор);	
ОбновитьЗарплатаИтого(ТД);
КонецПроцедуры	

&НаКлиенте
Процедура СдельноПередУдалением(Элемент, Отказ)
ТД = Элемент.ТекущиеДанные;

ОтборСтроки = Новый Структура("Горничная", ТД.Горничная);	
НайденныеСтроки = Объект.Зарплата.НайтиСтроки(ОтборСтроки);
Если НайденныеСтроки.Количество() > 0 Тогда 
	НайденнаяСтрока = НайденныеСтроки[0];
	
	Если НЕ НайденнаяСтрока.Сдельно_Есть Тогда
		НайденнаяСтрока.Сдельно = НайденнаяСтрока.Сдельно - ТД.Итого;
		НайденнаяСтрока.Сдельно_Э = НайденнаяСтрока.Сдельно;
	КонецЕсли;
	
	Если НЕ НайденнаяСтрока.Сдельно_нал_Есть Тогда
		НайденнаяСтрока.Сдельно_нал = НайденнаяСтрока.Сдельно_нал - ТД.ВыплатыСумма;
		НайденнаяСтрока.Сдельно_нал_Э = НайденнаяСтрока.Сдельно_нал;
	КонецЕсли;
	
	Идентификатор = НайденнаяСтрока.ПолучитьИдентификатор();
	ОбновитьЗарплатаИтогоИзКлиента(Идентификатор);
КонецЕсли;
КонецПроцедуры
