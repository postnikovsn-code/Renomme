Функция УдалитьСчет(СчетСсылка) Экспорт
СчетОбъект = СчетСсылка.ПолучитьОбъект();
СчетОбъект.Удалить();
КонецФункции

Функция ЕстьОплатыСчет(Счет) Экспорт
Запрос = Новый Запрос("ВЫБРАТЬ ПЕРВЫЕ 1
                      |	КоворкингСчетаДокументыОплаты.Ссылка КАК Ссылка
                      |ИЗ
                      |	Документ.КоворкингСчета.ДокументыОплаты КАК КоворкингСчетаДокументыОплаты
                      |ГДЕ
                      |	КоворкингСчетаДокументыОплаты.Ссылка = &Счет");
Запрос.УстановитьПараметр("Счет", Счет); 

РезультатЗапроса = Запрос.Выполнить();
Возврат НЕ РезультатЗапроса.Пустой(); 
КонецФункции
// - Удаление Счета

Функция УдалитьДокументОплаты(ДокументОплаты, Объект) Экспорт
	
ОтборСтроки = Новый Структура("ДокументОплаты", ДокументОплаты); 
РаспределениеОплатКУдалению = Объект.РаспределениеОплатКоворкинг.НайтиСтроки(ОтборСтроки);

Для Каждого Строка Из РаспределениеОплатКУдалению Цикл
	Если Строка.ЭтоУслуга Тогда
		ОтборСтроки = Новый Структура("ГУИД", Строка.ГУИДДолги);
		НайденныеСтроки = Объект.ДопУслугиКоворкинг.НайтиСтроки(ОтборСтроки);
		Если НайденныеСтроки.Количество() = 0 Тогда Продолжить; КонецЕсли;
		
		СтрокаУслуга = НайденныеСтроки[0];
		СтрокаУслуга.СуммаОплачено = СтрокаУслуга.СуммаОплачено - Строка.СуммаОплаты;
	Иначе
		Объект.СуммаОплачено = Объект.СуммаОплачено - Строка.СуммаОплаты;
	КонецЕсли;
КонецЦикла;

Для Каждого Строка Из РаспределениеОплатКУдалению Цикл
	Объект.РаспределениеОплатКоворкинг.Удалить(Строка);	
КонецЦикла;

ОтборСтроки = Новый Структура("ДокументОплаты", ДокументОплаты);	
СтрокиОплатыКУдалению = Объект.ДокументыОплаты.НайтиСтроки(ОтборСтроки);
Для Каждого Строка Из СтрокиОплатыКУдалению Цикл
	Объект.ДокументыОплаты.Удалить(Строка);
КонецЦикла;
	
КонецФункции


// + ВключатьВыходные Не используется
Процедура ЗаполнитьСрокиАрендыВключатьВыходные(СрокиАренды, ДатаС, ДатаПо, ВключатьВыходные) Экспорт
СрокиАренды.Очистить();
Дата_П = ДатаС;
Пока Дата_П <= ДатаПо Цикл
	Если НЕ ВключатьВыходные Тогда 
		Если ДеньНедели(Дата_П) > 5 Тогда Перейти ~Продолжение; КонецЕсли;
	КонецЕсли;	
	
	НоваяСтрока = СрокиАренды.Добавить(); 
	НоваяСтрока.СрокАренды = Дата_П;
	
~Продолжение:	
	Дата_П = Дата_П + 86400;
КонецЦикла;
КонецПроцедуры 

Функция РазницаВДняхВключатьВыходные(ДатаС, ДатаПо, ВключатьВыходные)
Если ВключатьВыходные Тогда
	РазницаВДнях = (НачалоДня(ДатаПо) - НачалоДня(ДатаС)) / (60 * 60 * 24) + 1;	
Иначе
	РазницаВДнях = 0;
	Дата_П = ДатаС;
	Пока Дата_П <= ДатаПо Цикл
		Если ЭтоРабочийДень(Дата_П) Тогда 
		   РазницаВДнях = РазницаВДнях + 1;
		КонецЕсли;	
		Дата_П = Дата_П + 86400;	
	КонецЦикла;
КонецЕсли;
	
Возврат РазницаВДнях;	
КонецФункции

Функция ЭтоРабочийДень(Дата)
ДеньНедели = ДеньНедели(Дата);

Остаток = ДеньНедели - 5;
ЭтоРабочийДень = (Остаток <= 0); 
Возврат ЭтоРабочийДень;
КонецФункции

Функция РабочийДень(Дата, ПредыдущийДень) 
ДеньНедели = ДеньНедели(Дата);

Остаток = ДеньНедели - 5;
Если Остаток <= 0 Тогда Возврат Дата; КонецЕсли;

Если ПредыдущийДень Тогда
	РабочийДень = Дата - Остаток*86400; 	
Иначе
	Если Остаток = 2 Тогда
		Остаток = 1;
	Иначе 
		Остаток = 2;
	КонецЕсли;	
	
	РабочийДень = Дата + Остаток*86400; 	
КонецЕсли;	
Возврат РабочийДень;	
КонецФункции
// - ВключатьВыходные Не используется
//// - Счета


//// + Оплаты

//
Процедура ДобавитьДокументОплатаКоворкингСчет(ДокументОплаты, ДокументДолгОбъектДанныеСсылка) Экспорт  
НачатьТранзакцию();

ДокументДолгОбъект = ДокументДолгОбъектДанныеСсылка.ПолучитьОбъект();

СуммаРаспределено = 0;
РаспределитьДокументОплатаКоворкингСчетОбъект(ДокументОплаты, ДокументДолгОбъект, СуммаРаспределено);

НоваяОплата = ДокументДолгОбъект.ДокументыОплаты.Добавить();
НоваяОплата.ДокументОплаты = ДокументОплаты;
НоваяОплата.СуммаРаспределено = СуммаРаспределено;

ДокументДолгОбъект.Записать(РежимЗаписиДокумента.Проведение);

Если СуммаРаспределено <> 0 Тогда
	ОплатыОбщееСервер.ЗаполнитьДокументОплатыДолгОплатаДляКоворкинг(ДокументОплаты
		, ДокументДолгОбъектДанныеСсылка, НоваяОплата.СуммаРаспределено);		
КонецЕсли;
	
ЗафиксироватьТранзакцию();	
Конецпроцедуры

Процедура РаспределитьДокументОплатаКоворкингСчетОбъект(ДокументОплаты, ДокументДолгОбъект, СуммаРаспределено) Экспорт  
Если ТипЗнч(ДокументОплаты) <> Тип("ДокументСсылка.КассовыйДокумент")
И ТипЗнч(ДокументОплаты) <> Тип("ДокументСсылка.ВыпискаБанка")
Тогда Возврат; КонецЕсли;
	
СуммаКоплате = СуммаКОплатеКоворкинг(ДокументДолгОбъект);
Если СуммаКоплате = 0 Тогда Возврат; КонецЕсли;

Если ТипЗнч(ДокументОплаты) = Тип("ДокументСсылка.КассовыйДокумент") Тогда
	Запрос = Новый Запрос("ВЫБРАТЬ
	                      |	КассовыйДокумент.Сумма КАК Сумма
	                      |ИЗ
	                      |	Документ.КассовыйДокумент КАК КассовыйДокумент
	                      |ГДЕ
	                      |	КассовыйДокумент.ВозвратДокумент = &ВозвратДокумент
	                      |	И КассовыйДокумент.ПометкаУдаления = ЛОЖЬ
	                      |
	                      |СГРУППИРОВАТЬ ПО
	                      |	КассовыйДокумент.ВозвратДокумент,
	                      |	КассовыйДокумент.Сумма");
Иначе 
 	Запрос = Новый Запрос("ВЫБРАТЬ
 	                      |	ВыпискаБанка.Сумма КАК Сумма
 	                      |ИЗ
 	                      |	Документ.ВыпискаБанка КАК ВыпискаБанка
 	                      |ГДЕ
 	                      |	ВыпискаБанка.ВозвратДокумент = &ВозвратДокумент
 	                      |	И ВыпискаБанка.ПометкаУдаления = ЛОЖЬ
 	                      |
 	                      |СГРУППИРОВАТЬ ПО
 	                      |	ВыпискаБанка.ВозвратДокумент,
 	                      |	ВыпискаБанка.Сумма");
КонецЕсли;

Запрос.УстановитьПараметр("ВозвратДокумент", ДокументОплаты);
Выборка = Запрос.Выполнить().Выбрать();
Если Выборка.Следующий() Тогда
	СуммаВозврата = Выборка.Сумма; 
Иначе
	СуммаВозврата = 0;
КонецЕсли;
ОстатокДокументОплаты = ДокументОплаты.Сумма - СуммаВозврата;

Если СуммаКоплате < ОстатокДокументОплаты Тогда
	СуммаКРаспределению = СуммаКоплате;
Иначе
	СуммаКРаспределению = ОстатокДокументОплаты;
КонецЕсли;

ОстатокКРаспределению = СуммаКРаспределению;
СуммаРаспределено = 0;

Если ДокументДолгОбъект.СуммаОплачено <> ДокументДолгОбъект.Сумма Тогда

	РаспределениеОплатКоворкинг = ДокументДолгОбъект.РаспределениеОплатКоворкинг;
	ОтборСтроки = Новый Структура("ДокументОплаты, ЭтоУслуга", ДокументОплаты, Ложь);
	НайденныеСтроки = РаспределениеОплатКоворкинг.НайтиСтроки(ОтборСтроки);
	Если НайденныеСтроки.Количество() = 0 Тогда
		СтрокаРаспределениеОплатКоворкинг = РаспределениеОплатКоворкинг.Добавить();
		СтрокаРаспределениеОплатКоворкинг.ДокументОплаты = ДокументОплаты;
		СтрокаРаспределениеОплатКоворкинг.ЭтоУслуга = Ложь;
	Иначе
		СтрокаРаспределениеОплатКоворкинг = НайденныеСтроки[0];
	КонецЕсли;

	Если ДокументДолгОбъект.СуммаОплачено < ДокументДолгОбъект.Сумма Тогда
		СуммаКЗакрытию = ДокументДолгОбъект.Сумма - ДокументДолгОбъект.СуммаОплачено; 
		Если ОстатокКРаспределению > СуммаКЗакрытию Тогда
			СтрокаРаспределениеОплатКоворкинг.СуммаОплаты = СуммаКЗакрытию;
			ДокументДолгОбъект.СуммаОплачено = ДокументДолгОбъект.Сумма;
			
			СуммаРаспределено = СуммаКЗакрытию;
			ОстатокКРаспределению = ОстатокКРаспределению - СуммаКЗакрытию;
		Иначе
			СтрокаРаспределениеОплатКоворкинг.СуммаОплаты = ОстатокКРаспределению;
			ДокументДолгОбъект.СуммаОплачено = ДокументДолгОбъект.СуммаОплачено + ОстатокКРаспределению;
			
			СуммаРаспределено = ОстатокКРаспределению;
			
			ОстатокКРаспределению = 0;
		КонецЕсли;
	КонецЕсли;
КонецЕсли;
	
Если ОстатокКРаспределению > 0 Тогда
	Для Каждого Строка Из ДокументДолгОбъект.ДопУслугиКоворкинг Цикл
		Если Строка.Сумма <> Строка.СуммаОплачено Тогда 
		
			РаспределениеОплатКоворкинг = ДокументДолгОбъект.РаспределениеОплатКоворкинг;
			ОтборСтроки = Новый Структура("ДокументОплаты, ГУИДДолги", ДокументОплаты, Строка.ГУИД);
			НайденныеСтроки = РаспределениеОплатКоворкинг.НайтиСтроки(ОтборСтроки);
			Если НайденныеСтроки.Количество() = 0 Тогда
				СтрокаРаспределениеОплатКоворкинг = РаспределениеОплатКоворкинг.Добавить();
				СтрокаРаспределениеОплатКоворкинг.ДокументОплаты = ДокументОплаты;
				СтрокаРаспределениеОплатКоворкинг.ЭтоУслуга = Истина;
				СтрокаРаспределениеОплатКоворкинг.ГУИДДолги = Строка.ГУИД;
			Иначе
				СтрокаРаспределениеОплатКоворкинг = НайденныеСтроки[0];
			КонецЕсли;
			
			Если Строка.СуммаОплачено < Строка.Сумма Тогда
				СуммаКЗакрытию = Строка.Сумма - Строка.СуммаОплачено; 
				Если ОстатокКРаспределению > СуммаКЗакрытию Тогда
					СтрокаРаспределениеОплатКоворкинг.СуммаОплаты = СуммаКЗакрытию;
					СуммаРаспределено = СуммаРаспределено + СуммаКЗакрытию;
					
					Строка.СуммаОплачено = Строка.Сумма;
					ОстатокКРаспределению = ОстатокКРаспределению - СуммаКЗакрытию;
				Иначе
					СтрокаРаспределениеОплатКоворкинг.СуммаОплаты = ОстатокКРаспределению;
					СуммаРаспределено = СуммаРаспределено + ОстатокКРаспределению;

					Строка.СуммаОплачено = Строка.СуммаОплачено + ОстатокКРаспределению;
					ОстатокКРаспределению = 0;
				КонецЕсли;
			КонецЕсли;
		КонецЕсли;
		
		Если ОстатокКРаспределению = 0 Тогда Прервать; КонецЕсли;
		
	КонецЦикла;
КонецЕсли;	
Конецпроцедуры

Функция СуммаКОплатеКоворкинг(ДокументДолгОбъект) Экспорт
СуммаКоплате = ДокументДолгОбъект.Сумма - ДокументДолгОбъект.СуммаОплачено
	+ ДокументДолгОбъект.ДопУслугиКоворкинг.Итог("Сумма") 
	- ДокументДолгОбъект.ДопУслугиКоворкинг.Итог("СуммаОплачено");
	
Возврат СуммаКоплате;
КонецФункции

