&НаКлиенте
Функция ПолучитьПутьДоСканаДокумента()
Если Объект.СканыДокументов.Количество() = 0 Тогда Возврат Неопределено; КонецЕсли;

ПутьДоФото = КаталогФото + Объект.СканыДокументов[ТекФото].ПутьДоФото;


Возврат ПутьДоФото;
КонецФункции	

&НаСервере
Функция ПоказатьКартинку(ПутьДоКартинки, РеквизитКартинки)
Если ПутьДоКартинки = "" Тогда 
	КартинкаЗначение = Новый Картинка();
Иначе	
	Попытка	
		КартинкаЗначение = Новый Картинка(ПутьДоКартинки, Истина);
	Исключение
		ОписаниеОшибки = ОписаниеОшибки();
		Если СтрНайти(ОписаниеОшибки, "Файл не обнаружен") = 0 Тогда
			Сообщить("Ошибка показа картинки: " + ПутьДоКартинки + ". Описание ошибки: " + ОписаниеОшибки);
		Иначе
			Сообщить("Фото не обнаружено");   
		КонецЕсли;
		
		ПоказатьКартинку("", РеквизитКартинки);

		Возврат Истина;
	КонецПопытки;
КонецЕсли;	
	
КартинкаАдрес = ПоместитьВоВременноеХранилище(КартинкаЗначение.ПолучитьДвоичныеДанные(), ЭтаФорма.УникальныйИдентификатор);
РеквизитКартинки = КартинкаАдрес;

Возврат Ложь;
КонецФункции

