&НаСервере
Процедура ЗаполнитьЦенаМинибарНаСервере()
ДатаНачала = '20230501';	
ДатаОкончания = НачалоДня(ТекущаяДата());

Запрос = Новый Запрос("ВЫБРАТЬ
                      |	ГорничныеОбслуживаниеНомера.Ссылка КАК Ссылка,
                      |	ГорничныеОбслуживаниеНомера.Минибар.(
                      |		Ссылка КАК Ссылка,
                      |		НомерСтроки КАК НомерСтроки,
                      |		НоменклатураМинибара КАК НоменклатураМинибара,
                      |		НоменклатураМинибараКодВыгрузка КАК НоменклатураМинибараКодВыгрузка,
                      |		НоменклатураМинибараНаименованиеВыгрузка КАК НоменклатураМинибараНаименованиеВыгрузка,
                      |		Количество КАК Количество,
                      |		Цена КАК Цена
                      |	) КАК Минибар
                      |ИЗ
                      |	Документ.ГорничныеОбслуживаниеНомера КАК ГорничныеОбслуживаниеНомера
                      |ГДЕ
                      |	ГорничныеОбслуживаниеНомера.ПометкаУдаления = ЛОЖЬ
                      |	И ГорничныеОбслуживаниеНомера.ДатаОбслуживания >= &ДатаНачала
                      |	И ГорничныеОбслуживаниеНомера.ДатаОбслуживания <= &ДатаОкончания");

Запрос.УстановитьПараметр("ДатаНачала", ДатаНачала);				 
Запрос.УстановитьПараметр("ДатаОкончания", ДатаОкончания);	

ТЗ = Запрос.Выполнить().Выгрузить();

Для Каждого Строка Из ТЗ Цикл
	Если Строка.Минибар.Количество() = 0 Тогда Продолжить; КонецЕсли;
	
	ГорничныеОбслуживаниеНомераОбъект = Строка.Ссылка.ПолучитьОбъект();
	Для Каждого СтрокаМинибар Из Строка.Минибар Цикл
		СтрокаМинибар.Цена = СтрокаМинибар.НоменклатураМинибара.Цена;		
	КонецЦикла;
	
	Попытка 
		 ГорничныеОбслуживаниеНомераОбъект.Записать(РежимЗаписиДокумента.Проведение);
	Исключение
		 Сообщить("Ошибка проведения: " + ГорничныеОбслуживаниеНомераОбъект.Ссылка 
		 	+ ". " + ОписаниеОшибки() + ".");
	КонецПопытки;
КонецЦикла;

КонецПроцедуры
