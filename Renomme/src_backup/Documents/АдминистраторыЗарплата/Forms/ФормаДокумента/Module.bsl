ОбновитьПрочееСтрока(ТД);
КонецПроцедуры

&НаСервере
Процедура ОбновитьПрочееСтрока(ТД)

//ТД.Итого = ПрочееИтого(ТД);
ТД.Сумма = ПрочееИтого(ТД);
КонецПроцедуры			

&НаСервере
Функция ПрочееИтого(ТД)
Если НЕ (ЗначениеЗаполнено(ТД.Администратор) И ЗначениеЗаполнено(ТД.Дата)) Тогда
	Возврат 0;
КонецЕсли;

Итого = ТД.Сумма;
			
Возврат Итого;			
КонецФункции	

&НаКлиенте		
Процедура АдминистраторПрочееИтогоДействие(ТД)
Если ЗначениеЗаполнено(ТД.Администратор) Тогда
	//ОтборСтроки = Новый Структура("Администратор", ТД.Администратор);	
	//НайденныеСтроки = Объект.Прочее.НайтиСтроки(ОтборСтроки);
	//АдминистраторПрочееИтого = 0;
	//Для Каждого Строка Из НайденныеСтроки Цикл
	//	Если Строка.Дата < Объект.ДН ИЛИ Строка.Дата > Объект.ДК Тогда Продолжить; КонецЕсли; 
	//	
	//	АдминистраторПрочееИтого = АдминистраторПрочееИтого + Строка.Сумма; 		
	//КонецЦикла;
	
	АдминистраторПрочееИтого = АдминистраторПрочееИтого(ТД.Администратор);
	ОтборСтроки = Новый Структура("Администратор", ТД.Администратор);	
	НайденныеСтрокиЗарплата = ЗарплатаСмены.НайтиСтроки(ОтборСтроки);
	Если НайденныеСтрокиЗарплата.Количество() > 0 Тогда 
		НайденнаяСтрокаЗарплата = НайденныеСтрокиЗарплата[0];
		НайденнаяСтрокаЗарплата.СуммаПрочее = АдминистраторПрочееИтого;
	КонецЕсли;
Иначе	
	ОтборСтроки = Новый Структура("Администратор", ПрочееАдминистратор_OldValue);
	НайденныеСтрокиЗарплата = ЗарплатаСмены.НайтиСтроки(ОтборСтроки);
	Если НайденныеСтрокиЗарплата.Количество() > 0 Тогда 
		НайденнаяСтрокаЗарплата = НайденныеСтрокиЗарплата[0];
		НайденнаяСтрокаЗарплата.СуммаПрочее = НайденнаяСтрокаЗарплата.СуммаПрочее - ПрочееСумма_OldValue;
	КонецЕсли;
КонецЕсли;

Если НайденныеСтрокиЗарплата.Количество() > 0 Тогда 
	Идентификатор = НайденнаяСтрокаЗарплата.ПолучитьИдентификатор();
	ОбновитьЗарплатаИтогоИзКлиента(Идентификатор);
КонецЕсли;
КонецПроцедуры         

&НаСервере
Функция АдминистраторПрочееИтого(Администратор)
ОтборСтроки = Новый Структура("Администратор", Администратор);	
НайденныеСтроки = Объект.Прочее.НайтиСтроки(ОтборСтроки);
АдминистраторПрочееИтого = 0;
Для Каждого Строка Из НайденныеСтроки Цикл
	Если Строка.Дата < Объект.ДН ИЛИ Строка.Дата > Объект.ДК Тогда Продолжить; КонецЕсли; 
	
	АдминистраторПрочееИтого = АдминистраторПрочееИтого + Строка.Сумма; 		
КонецЦикла;

Возврат АдминистраторПрочееИтого;
