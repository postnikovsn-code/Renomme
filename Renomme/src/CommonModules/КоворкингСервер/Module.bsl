Функция ПроверкаЗаполненияКоворкингЗаявкаТекстСообщения(ДанныеОбъект, Разделитель) Экспорт
ТекстСообщения = "";

Если ДанныеОбъект.Клиент.Пустая() тогда
	ТекстСообщения = ОбщийФункционалКлиентСервер.ДобавитьТекст(ТекстСообщения, "Незаполнен клиент.", Разделитель);
конецесли;

Если ДанныеОбъект.КоворкингНомер.Пустая() тогда
	ТекстСообщения = ОбщийФункционалКлиентСервер.ДобавитьТекст(ТекстСообщения, "Незаполнен номер.", Разделитель);
конецесли;

Если НЕ ЗначениеЗаполнено(ДанныеОбъект.ПериодАренды) Тогда
	ТекстСообщения = ОбщийФункционалКлиентСервер.ДобавитьТекст(ТекстСообщения, "Незаполнен период аренды.", Разделитель);
КонецЕсли;

Если НЕ ЗначениеЗаполнено(ДанныеОбъект.ДатаС) тогда
	ТекстСообщения = ОбщийФункционалКлиентСервер.ДобавитьТекст(ТекстСообщения, "Незаполнено Дата С.", Разделитель);
конецесли;

Если НЕ ЗначениеЗаполнено(ДанныеОбъект.ДатаПо) тогда
	ТекстСообщения = ОбщийФункционалКлиентСервер.ДобавитьТекст(ТекстСообщения, "Незаполнено Дата По.", Разделитель);
конецесли;

Если ДанныеОбъект.ДатаС > ДанныеОбъект.ДатаПо Тогда
	ТекстСообщения = ОбщийФункционалКлиентСервер.ДобавитьТекст(ТекстСообщения, "Дата С > Дата По.", Разделитель); 
конецесли;

Если ДанныеОбъект.ПочасоваяОплата Тогда 
	Если ДанныеОбъект.ЧасС = 0 Тогда
		ТекстСообщения = ОбщийФункционалКлиентСервер.ДобавитьТекст(ТекстСообщения, "Не заполнен Час С.", Разделитель); 
	КонецЕсли;
	
	Если ДанныеОбъект.ЧасПо = 0 Тогда
		ТекстСообщения = ОбщийФункционалКлиентСервер.ДобавитьТекст(ТекстСообщения, "Не заполнен Час По.", Разделитель); 
	КонецЕсли;
КонецЕсли;

//Если ДанныеОбъект.Цена = 0 Тогда
//	ТекстСообщения = ОбщийМодульОбщиеКлиентСервер.ДобавитьТекст(ТекстСообщения, "Не заполнена Цена.", Разделитель); 
//конецесли;

Возврат ТекстСообщения;
КонецФункции

