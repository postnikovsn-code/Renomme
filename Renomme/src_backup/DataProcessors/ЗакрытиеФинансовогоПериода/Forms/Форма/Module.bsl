&НаСервере
Функция ЗаполнитьОтчетДолгиНаСервере_Перенесено()  
ТабДок = Новый ТабличныйДокумент;

Запрос = Новый Запрос;

Запрос.Текст = ТекстЗапроса();

Запрос.Текст = Запрос.Текст + "
                      |	И ЕСТЬNULL(СчетаПроживание.СуммаКЗакрытию, 0) + ЕСТЬNULL(СчетаУслуги.СуммаКЗакрытию, 0) > 0
                      |
                      |УПОРЯДОЧИТЬ ПО
                      |	РезервС,
                      |	НомерВРезерв";

Запрос.УстановитьПараметр("ДатаС", ДатаС);	
Запрос.УстановитьПараметр("ДатаПо", ДатаПо);

ТЗ = Запрос.Выполнить().Выгрузить();

Обработка = РеквизитФормыВЗначение("Объект");
МакетОбработки = Обработка.ПолучитьМакет("МакетДолги");

Область = МакетОбработки.ПолучитьОбласть("Заголовок");
ОтельСсылка = НастройкиСервер.ПолучитьТекущуюОрганизацию();
Отель = ОтельСсылка.Наименование;
Область.Параметры.Отель = Отель;
Область.Параметры.ДатаС = Формат(ДатаС, "ДФ=dd.MM.yy");
Область.Параметры.ДатаПо = Формат(ДатаПо, "ДФ=dd.MM.yy");
ТабДок.Вывести(Область);

//
Запрос = Новый Запрос("ВЫБРАТЬ
                      |	КОЛИЧЕСТВО(РАЗЛИЧНЫЕ ЗаявкаНаБронирование.Ссылка) КАК КоличествоЗаявок,
                      |	СУММА(ДолгиКЗакрытию.СуммаДолг) КАК СуммаЗаявок
                      |ИЗ
                      |	Документ.ЗаявкаНаБронирование КАК ЗаявкаНаБронирование
                      |		ВНУТРЕННЕЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
                      |			ЗаявкаНаБронированиеСчетаДетальноДолги.Ссылка КАК Ссылка,
                      |			СУММА(ЗаявкаНаБронированиеСчетаДетальноДолги.СуммаКЗакрытию) КАК СуммаКЗакрытию,
                      |			СУММА(ЗаявкаНаБронированиеСчетаДетальноДолги.СуммаДолг) КАК СуммаДолг
                      |		ИЗ
                      |			Документ.ЗаявкаНаБронирование.СчетаДетальноДолги КАК ЗаявкаНаБронированиеСчетаДетальноДолги
                      |		
                      |		СГРУППИРОВАТЬ ПО
                      |			ЗаявкаНаБронированиеСчетаДетальноДолги.Ссылка) КАК ДолгиКЗакрытию
                      |		ПО ЗаявкаНаБронирование.Ссылка = ДолгиКЗакрытию.Ссылка
                      |ГДЕ
                      |	ЗаявкаНаБронирование.ПометкаУдаления = ЛОЖЬ
                      |	И (ЗаявкаНаБронирование.Статус = ЗНАЧЕНИЕ(Перечисление.СтатусБрони.Выехал)
                      |			ИЛИ ЗаявкаНаБронирование.Статус = ЗНАЧЕНИЕ(Перечисление.СтатусБрони.Неустойка))
                      |	И ЗаявкаНаБронирование.РезервПо <= &ДатаПо
                      |	И ЗаявкаНаБронирование.РезервПо >= &ДатаС
                      |	И ДолгиКЗакрытию.СуммаКЗакрытию = 0");

Запрос.УстановитьПараметр("ДатаС", ДатаС);	
Запрос.УстановитьПараметр("ДатаПо", ДатаПо);

ТЗ_ЗакрытоЗаявок = Запрос.Выполнить().Выгрузить();
Если ТЗ_ЗакрытоЗаявок.Количество() = 0 Тогда
	КоличествоЗаявок = 0; 	
	СуммаЗаявок = 0;
Иначе
	КоличествоЗаявок = ТЗ_ЗакрытоЗаявок[0].КоличествоЗаявок; 	
	СуммаЗаявок = ТЗ_ЗакрытоЗаявок[0].СуммаЗаявок;
КонецЕсли;
	
Область = МакетОбработки.ПолучитьОбласть("ЗакрытоЗаявок");
Область.Параметры.КоличествоЗаявок = Строка(КоличествоЗаявок);
Область.Параметры.СуммаЗаявок = Строка(СуммаЗаявок);
ТабДок.Вывести(Область);
//

//
Область = МакетОбработки.ПолучитьОбласть("Шапка");
ТабДок.Вывести(Область);

ДанныеДолги.Очистить();
НомерКомментарий_Долги = Область.ШиринаТаблицы;
НомерСтрокиШапкаДолги = ТабДок.ВысотаТаблицы;

НомерКолонкиСуммаПроживание = 10;
НомерКолонкиСуммаУслуги = 12;
Для Каждого Строка Из ТЗ Цикл
	Область = МакетОбработки.ПолучитьОбласть("Строка");
	
	Область.Параметры.Заполнить(Строка);
	Область.Параметры.РезервС = Формат(Строка.РезервС, "ДФ=dd.MM.yy");
	Область.Параметры.РезервПо = Формат(Строка.РезервПо, "ДФ=dd.MM.yy");
	
	Область.Параметры.Заявка = Строка.ЗаявкаНаБронирование.Номер + " от " + Формат(Строка.ЗаявкаНаБронирование.Дата, "ДФ=dd.MM.yy");
	Область.Параметры.ЗаявкаНаБронирование = Строка.ЗаявкаНаБронирование;
	
	Если Строка.СуммаПроживаниеСчета <> Строка.СуммаПроживание Тогда
		Область.Область(1, НомерКолонкиСуммаПроживание, 1, НомерКолонкиСуммаПроживание).ЦветТекста = WebЦвета.Красный;
	КонецЕсли;
	
	Если Строка.СуммаУслугиСчета <> Строка.СуммаУслуги Тогда
		Область.Область(1, НомерКолонкиСуммаУслуги, 1, НомерКолонкиСуммаУслуги).ЦветТекста = WebЦвета.Красный;
	КонецЕсли;
	
	ИмяОбласти = "R1C" + Строка(НомерКомментарий_Долги);
	Область.Область(ИмяОбласти).Значение = Строка.КомментарийОтветственного;
	ТабДок.Вывести(Область);
	
	НоваяСтрока = ДанныеДолги.Добавить();
	ЗаполнитьЗначенияСвойств(НоваяСтрока, Строка);
КонецЦикла;

Область = МакетОбработки.ПолучитьОбласть("Подножие");
//Область.Параметры.СуммаЗаявки = ТЗ.Итог("СуммаЗаявки");
//Область.Параметры.СуммаПроживаниеСчета = ТЗ.Итог("СуммаПроживаниеСчета");
//Область.Параметры.СуммаПроживание = ТЗ.Итог("СуммаПроживание");
//Область.Параметры.СуммаУслугиСчета = ТЗ.Итог("СуммаУслугиСчета");
//Область.Параметры.СуммаУслуги = ТЗ.Итог("СуммаУслуги");
Область.Параметры.СуммаДолга = ТЗ.Итог("СуммаДолга");
ТабДок.Вывести(Область) ;

//Область = МакетОбработки.ПолучитьОбласть("ПустаяОбласть");
//ТабДок.Вывести(Область) ;
//ТабДок.Вывести(Область) ;

//ТабДок.ФиксацияСверху = 1;
Возврат ТабДок;
КонецФункции

