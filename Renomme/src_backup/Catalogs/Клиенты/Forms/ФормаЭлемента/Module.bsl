&НаКлиенте
Процедура ПечатьУведомления(Команда)
Если НЕ ЭтаФорма.Записать() Тогда Возврат; КонецЕсли; 	
	
	Клиент=Объект;
	экс = Новый COMОбъект("Excel.Application");
	
//	ТабИсх=экс.Workbooks.Open("C:\BASE\uv_pr.xls");
	ИмяФайла = ОбщийФункционалСервер.ПолучитьЗначениеКонстанты("Папка_C_BASE");
	//ИмяФайла = ИмяФайла + "uv_pr.xls";
	ИмяФайла = ИмяФайла + "ОбразцыДокументов\" + "uv_pr.xls";
	ТабИсх=экс.Workbooks.Open(ИмяФайла);
	
	ЭксельИсх=ТабИсх.Worksheets(1).UsedRange;
	
	// 
	Для сч=1 По СтрДлина(Клиент.Фамилия) Цикл
		Если Сч > 34 Тогда Прервать; КонецЕсли;
			
		Симв=Сред(Клиент.Фамилия,Сч,1);
		ЭксельИсх.Cells(11,8+сч*2).Value=Симв;
		ЭксельИсх.Cells(55,8+сч*2).Value=Симв;
	КонецЦикла; 
	
	Для сч=1 По СтрДлина(Клиент.Имя) Цикл
		Если Сч > 34 Тогда Прервать; КонецЕсли;
		
		Симв=Сред(Клиент.Имя,Сч,1);
		ЭксельИсх.Cells(13,8+сч*2).Value=Симв;
		ЭксельИсх.Cells(57,8+сч*2).Value=Симв;
	КонецЦикла; 
	// 
	
	// гражданство
	КлиентСтранаНаименование = ОбщийФункционалСервер.ПолучитьЗначениеРеквизитаНаСервере(Клиент.ГражданствоФМС_NEW, "Наименование");
	Для сч=1 По СтрДлина(КлиентСтранаНаименование) Цикл
		Если Сч > 33 Тогда Прервать; КонецЕсли;

		Симв=Сред(КлиентСтранаНаименование,Сч,1);
		ЭксельИсх.Cells(15,10+сч*2).Value=Симв;
		ЭксельИсх.Cells(59,10+сч*2).Value=Симв;
	КонецЦикла; 
	//
	
	// Место рождения
	КлиентСтранаНаименование = ОбщийФункционалСервер.ПолучитьЗначениеРеквизитаНаСервере(Клиент.РождениеСтранаФМС_NEW, "Наименование");
	Для сч=1 По СтрДлина(КлиентСтранаНаименование) Цикл
		Если Сч > 30 Тогда Прервать; КонецЕсли;

		Симв=Сред(КлиентСтранаНаименование,Сч,1);
		ЭксельИсх.Cells(21,12+сч*2).Value=Симв;
	КонецЦикла; 
	
	КлиентМестоРождения = КлиентМестоРожденияУведомление(Клиент);
	Для сч=1 По СтрДлина(КлиентМестоРождения) Цикл
		Если Сч > 30 Тогда Прервать; КонецЕсли;

		Симв=Сред(КлиентМестоРождения,Сч,1);
		ЭксельИсх.Cells(23,12+сч*2).Value=Симв;   
	КонецЦикла; 
	//

	
	// Дата рождения и пол
	СтрДата=Формат(Клиент.ДатаРождения, "ДФ=dd");
	СтрМесяц=Формат(Клиент.ДатаРождения, "ДФ=MM");
	СтрГод=Формат(Клиент.ДатаРождения, "ДФ=yyyy");
	
	Для сч=1 По СтрДлина(СтрДата) Цикл
		Симв=Сред(СтрДата,Сч,1);
		ЭксельИсх.Cells(19,12+сч*2).Value=Симв;
		ЭксельИсх.Cells(63,12+сч*2).Value=Симв;
	КонецЦикла; 
	Для сч=1 По СтрДлина(СтрМесяц) Цикл
		Симв=Сред(СтрМесяц,Сч,1);
		ЭксельИсх.Cells(19,20+сч*2).Value=Симв;
		ЭксельИсх.Cells(63,20+сч*2).Value=Симв;		
	КонецЦикла; 
	Для сч=1 По СтрДлина(СтрГод) Цикл
		Симв=Сред(СтрГод,Сч,1);
		ЭксельИсх.Cells(19,28+сч*2).Value=Симв;
		ЭксельИсх.Cells(63,28+сч*2).Value=Симв;		
	КонецЦикла; 
	
	Если Клиент.Пол = ПредопределенноеЗначение("Перечисление.Пол.Женский") Тогда
		ЭксельИсх.Cells(19,66).Value="V";	
		ЭксельИсх.Cells(63,66).Value="V";	
	иначе
		ЭксельИсх.Cells(19,52).Value="V";
		ЭксельИсх.Cells(63,52).Value="V";
	конецесли;
	//

	//КлиентВидДокументаУдостоверяющегоЛичностьНаименование = ОбщийФункционалСервер.ПолучитьЗначениеРеквизитаНаСервере(
	//	Клиент.ВидДокументаУдостоверяющегоЛичность, "Наименование");
	КлиентВидДокументаУдостоверяющегоЛичностьНаименование = ОбщийФункционалСервер.ПолучитьЗначениеРеквизитаНаСервере(
		Клиент.ТипДокументаФМС_NEW, "ВидДокументаУдостоверяющегоЛичностьКлиентУведомление");
	Для сч=1 По СтрДлина(КлиентВидДокументаУдостоверяющегоЛичностьНаименование) Цикл
		Если Сч > 10 Тогда Прервать; КонецЕсли;
		
		Симв=Сред(КлиентВидДокументаУдостоверяющегоЛичностьНаименование,Сч,1);
		ЭксельИсх.Cells(25,26+сч*2).Value=Симв;
		ЭксельИсх.Cells(64,26+сч*2).Value=Симв;
	КонецЦикла; 
	
	Для сч=1 По СтрДлина(Клиент.Серия) Цикл
		Если Сч > 4 Тогда Прервать; КонецЕсли;
		
		Симв=Сред(Клиент.Серия,Сч,1);
		ЭксельИсх.Cells(25,50+сч*2).Value=Симв;
		ЭксельИсх.Cells(64,50+сч*2).Value=Симв;
	КонецЦикла; 
	
	Для сч=1 По СтрДлина(Клиент.Номер) Цикл
		Если Сч > 9 Тогда Прервать; КонецЕсли;
		
		Симв=Сред(Клиент.Номер,Сч,1);
		ЭксельИсх.Cells(25,58+сч*2).Value=Симв;
