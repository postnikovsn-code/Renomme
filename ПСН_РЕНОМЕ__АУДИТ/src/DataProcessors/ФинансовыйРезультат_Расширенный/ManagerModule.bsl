				Если СтрокаОплаты.СуммаДокументаОплаты <> 0 Тогда
					СуммаОплаты_кк = СуммаОплаты_кк + 
							Окр(СтрокаОплаты.СуммаОплаты * СтрокаОплаты.СуммаДокументаОплатыКарта / СтрокаОплаты.СуммаДокументаОплаты, 2);
					СуммаОплаты_нал = СуммаОплаты_нал + 
						Окр(СтрокаОплаты.СуммаОплаты * СтрокаОплаты.СуммаДокументаОплатыНаличные / СтрокаОплаты.СуммаДокументаОплаты, 2);
