&НаСервере
Функция ТелефонНормализованный()
Результат = Новый Структура("Ошибка, Текст", Ложь, "");	
Ответ = СлужебныеКлиентСервер.ПроверкаНомераТелефона(Объект.Телефон); 

Если Ответ.КодОшибки = -1 Тогда
	Результат.Ошибка = Истина;
	Результат.Текст = "ВНИМАНИЕ ! Некорректный номер телефона - " + Объект.Телефон;
Иначе	
	Результат.Текст = Ответ.ТелефонНомер;	
КонецЕсли;

Возврат Результат;
КонецФункции

