//КонецЕсли;	

Если ЗначениеЗаполнено(ТекстПредупреждение) Тогда
	ТекстСообщение = Лев(ТекстСообщение, СтрДлина(ТекстСообщение) - 2);
	Ответ = Новый Структура("ТекстПредупреждение, ТекстСообщение", ТекстПредупреждение, ТекстСообщение);  
Иначе	
	Ответ = Неопределено;
КонецЕсли;	

Возврат Ответ;
