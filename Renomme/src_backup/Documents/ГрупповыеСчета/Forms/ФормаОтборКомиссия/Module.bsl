
&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
Параметры.Свойство("ВызовИзДокумента", ВызовИзДокумента);

Параметры.Свойство("Бронирует", Бронирует);
Если ЗначениеЗаполнено(Бронирует) Тогда
	КонтрагентОтбор = Бронирует;
	Элементы.Бронирует.ТолькоПросмотр = Истина; 
КонецЕсли;

Параметры.Свойство("ДатаСОтбор", ДатаОтбораС);
Если ЗначениеЗаполнено(ДатаОтбораС) Тогда Элементы.ДатаОтбораС.ТолькоПросмотр = Истина; КонецЕсли;
	
Параметры.Свойство("ДатаПоОтбор", ДатаОтбораПо);
Если ЗначениеЗаполнено(ДатаОтбораПо) Тогда Элементы.ДатаОтбораПо.ТолькоПросмотр = Истина; КонецЕсли;

Неоплачено = Истина;

УсловноеОформлениеЗагрузить();
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
ЮрЛицо = КлиентыСервер.ЭтоЮрЛицо(КонтрагентОтбор);
Если ВызовИзДокумента Тогда 
	ОтобратьНаСервере();
КонецЕсли;		
КонецПроцедуры

