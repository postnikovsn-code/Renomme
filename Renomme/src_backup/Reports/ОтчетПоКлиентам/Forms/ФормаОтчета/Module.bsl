&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
Если Параметры.Свойство("ЗавершитьРаботу") Тогда	
	 ЗавершитьРаботу = Параметры.ЗавершитьРаботу;
Иначе
	 ЗавершитьРаботу = Ложь;
КонецЕсли;	 

Если Параметры.Свойство("Аудит") Тогда	
	 Отчет.Аудит = Параметры.Аудит;
Иначе
	 Отчет.Аудит = Ложь;
КонецЕсли;
 
КонецПроцедуры
	
&НаКлиенте
Процедура ПриОткрытии(Отказ)

Если Не Отчет.Аудит тогда
	//КнопкаСформироватьНажатие(ЭтаФорма);
	Сформировать(Неопределено);
	ОтчетЗаГод();
	Закрыть();
иначе
	ДТ=НачалоДня(ТекущаяДата()-86400);
	ОтчетАудит(ДТ);	
конецесли;

Если ЗавершитьРаботу Тогда
	Отказ = Истина;	
КонецЕсли;	
КонецПроцедуры

