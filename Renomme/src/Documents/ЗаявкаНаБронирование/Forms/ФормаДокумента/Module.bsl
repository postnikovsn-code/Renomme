&НаКлиенте
Процедура ОтправитьВPayKeeperДействие()
ТД = Элементы.Счета.ТекущиеДанные;
Если ТД = Неопределено Тогда Возврат; КонецЕсли;	

Если ТД.СуммаКЗакрытию <= 0 Тогда 
	ПоказатьПредупреждение(, "Нечего отправлять");
	
	Возврат;
КонецЕсли;

Если ЗначениеЗаполнено(ЭтаФорма.УникальныйИдентификатор) Тогда
	УникальныйИдентификатор_П = ЭтаФорма.УникальныйИдентификатор;		
Иначе
	УникальныйИдентификатор_П = Новый УникальныйИдентификатор();
КонецЕсли;

ДопПараметры = Новый Структура;
ОповещениеОЗавершении = Новый ОписаниеОповещения("ЗавершениеФормы_ОтправкаPayKeeper", ЭтотОбъект, ДопПараметры);

ОбъектДанные = Объект;
	
PayKeeperКлиент.ОтправитьВPayKeeperДолг(ОбъектДанные, ТД.СчетГУИД, УникальныйИдентификатор_П
	, ЭтаФорма, ОповещениеОЗавершении);
КонецПроцедуры

