Процедура РассылкаWhatsApp(ДатаРассылки) Экспорт 
Путь = ОбщийФункционалСервер.ПолучитьЗначениеКонстанты("Папка_C_BASE");
ИмяФайлОшибка = Путь + "ОшибкиВыгрузки_РассылкаWhatsApp.txt";	

ЕстьОшибки = Ложь;
Попытка
	РассылкаWhatsApp.РассылкаWhatsApp_Сайт(ДатаРассылки);  
Исключение
	ФайлОшибки = Новый ЗаписьТекста(ИмяФайлОшибка,,, Истина);
	ФайлОшибки.ЗаписатьСтроку("Ошибка рассылки WhatsApp_Сайт: " + ОписаниеОшибки()+ " " + ТекущаяДата());
	ФайлОшибки.Закрыть();
	
	ЕстьОшибки = Истина;
КонецПопытки;

Попытка
	//РассылкаWhatsApp.РассылкаWhatsApp_ДеньРождения(ДатаРассылки);
Исключение
	ФайлОшибки = Новый ЗаписьТекста(ИмяФайлОшибка,,, Истина);
	ФайлОшибки.ЗаписатьСтроку("Ошибка рассылки WhatsApp_ДеньРождения: " + ОписаниеОшибки()+ " " + ТекущаяДата());
	ФайлОшибки.Закрыть();
	
	ЕстьОшибки = Истина;
КонецПопытки;

Если ЕстьОшибки Тогда
	Тема = "Ошибки рассылки WhatsApp";
	
	МассивФайлов = Новый Массив;
	МассивФайлов.Добавить(ИмяФайлОшибка);
	
	МассивПолучатели = Новый Массив;
	МассивПолучатели.Добавить("postnikov_sn@invina.ru");
	
	ТекстСообщения = "Ошибки рассылки WhatsApp";
	
	СлужебныеСервер.ОтправитьEmail(Тема, МассивФайлов, МассивПолучатели, ТекстСообщения);
	
	Сообщить("Есть ошибки рассылки WhatsApp");
КонецЕсли;
КонецПроцедуры

//
Процедура РассылкаWhatsApp_Сайт(ДатаРассылки) Экспорт 
//Если НЕ НастройкиСервер.ЭтоЛайв() Тогда Возврат; КонецЕсли;	

Если НЕ МесенджерСервер.МесенджерВключен() Тогда 
	Сообщить("Сообщения через месенджер выключены");
	
	Возврат;
КонецЕсли;

ДатаВыезда = НачалоДня(ДатаРассылки) - 24 *60 * 60;	
	
Запрос = Новый Запрос("ВЫБРАТЬ
                      |	ЗаявкаНаБронирование.Ссылка КАК Ссылка,
                      |	ЗаявкаНаБронирование.Клиент.Телефон КАК КлиентТелефон,
                      |	ЗаявкаНаБронирование.Клиент КАК Клиент,
                      |	НЕ Рассылка_Сайт.Клиент ЕСТЬ NULL КАК ЕстьРассылка
                      |ИЗ
                      |	Документ.ЗаявкаНаБронирование КАК ЗаявкаНаБронирование
                      |		ЛЕВОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
                      |			РассылкаWhatsApp.ДатаРассылки КАК ДатаРассылки,
                      |			РассылкаWhatsApp.Клиент КАК Клиент
                      |		ИЗ
                      |			РегистрСведений.РассылкаWhatsApp КАК РассылкаWhatsApp
                      |		ГДЕ
                      |			РассылкаWhatsApp.ДатаРассылки = &ДатаРассылки
                      |			И РассылкаWhatsApp.ТипРассылки = ЗНАЧЕНИЕ(Перечисление.ТипРассылкиWhatsApp.Сайт)) КАК Рассылка_Сайт
                      |		ПО ЗаявкаНаБронирование.Клиент = Рассылка_Сайт.Клиент
                      |ГДЕ
                      |	ЗаявкаНаБронирование.ПометкаУдаления = ЛОЖЬ
					  |	И ЗаявкаНаБронирование.ТипБронирования = ЗНАЧЕНИЕ(Справочник.ТипБронирования.ЧастныйГость)
					  |	И ЗаявкаНаБронирование.КаналБронирования В(&КаналыБронирования)
					  |	И ЗаявкаНаБронирование.Статус = ЗНАЧЕНИЕ(Перечисление.СтатусБрони.Выехал)
					  |	И НАЧАЛОПЕРИОДА(ЗаявкаНаБронирование.ВремяВыездаТочное, ДЕНЬ) = &ВремяВыезда
					  |");

//Запрос.Текст =  Запрос.Текст + "
//	|И ЗаявкаНаБронирование.Клиент.Наименование = ""ПСН""";

КаналыБронирования = Новый Массив;
КаналыБронирования.Добавить(Справочники.КаналыБронирования.WhatsApp);
КаналыБронирования.Добавить(Справочники.КаналыБронирования.НашCайт);
КаналыБронирования.Добавить(Справочники.КаналыБронирования.ОтСтойки);
КаналыБронирования.Добавить(Справочники.КаналыБронирования.Телефон);

Запрос.УстановитьПараметр("КаналыБронирования",КаналыБронирования); 
Запрос.УстановитьПараметр("ВремяВыезда", НачалоДня(ДатаВыезда));
Запрос.УстановитьПараметр("ДатаРассылки", НачалоДня(ДатаРассылки));

ТЗ = Запрос.Выполнить().Выгрузить();

МассивКУдалению = Новый Массив;
Для Каждого Строка Из ТЗ Цикл
	Если Строка.ЕстьРассылка Тогда
	МассивКУдалению.Добавить(Строка); Продолжить; КонецЕсли;
 
	КлиентТелефон = СокрЛП(Строка.КлиентТелефон); 
	
	Если СокрЛП(КлиентТелефон) = "" Тогда 	
	МассивКУдалению.Добавить(Строка); Продолжить; КонецЕсли;
	
	//Результат = МесенджерСервер.ПроверитьWhatsAppGreen(КлиентТелефон);
	//Если Результат.Ошибка Тогда 
	//МассивКУдалению.Добавить(Строка); Продолжить; КонецЕсли;
КонецЦикла;

Для Каждого Строка Из МассивКУдалению Цикл
	ТЗ.Удалить(Строка);
КонецЦикла;

Текст = ТекстРассылки_Сайт();
Для Каждого Строка Из ТЗ Цикл 
	КлиентТелефон = СокрЛП(Строка.КлиентТелефон); 

	Результат = МесенджерСервер.ОтправитьДанные_Месенджер("ОтправитьТекст", КлиентТелефон, Текст, Неопределено, Неопределено);

	Если НЕ Результат.Ошибка Тогда 
		МенеджерЗаписей = РегистрыСведений.РассылкаWhatsApp.СоздатьМенеджерЗаписи();
		МенеджерЗаписей.ДатаРассылки = ДатаРассылки;
		МенеджерЗаписей.Клиент = Строка.Клиент;
		МенеджерЗаписей.ТипРассылки = Перечисления.ТипРассылкиWhatsApp.Сайт;

		МенеджерЗаписей.Записать();
	КонецЕсли;
КонецЦикла;
КонецПроцедуры

Функция ТекстРассылки_Сайт()
Если НастройкиСервер.ЭтоЛайв() Тогда 	
	Текст = "Дорогой Гость, мы безгранично ценим Ваше доверие и будем рады новым встречам в сity-отеле Live! 
			|Для Вашего удобства предлагаем бронировать со скидкой на сайте live-ekb.ru и WhatsApp! 
			|Нам приятно быть вашим уютным домом в г.Екатеринбурге!"; 
	Возврат Текст;
КонецЕсли;
КонецФункции
//

Процедура РассылкаWhatsApp_ДеньРождения(ДатаРассылки) Экспорт
//ш = 1/0;	
	
Если НЕ 
(НастройкиСервер.ЭтоРеноме()
//ИЛИ НастройкиСервер.ЭтоЧехов() 
//ИЛИ НастройкиСервер.ЭтоЛайв()
) 
Тогда Возврат; КонецЕсли;	

Если НЕ МесенджерСервер.МесенджерВключен() Тогда 
	Сообщить("Сообщения через месенджер выключены");
	
	Возврат;
КонецЕсли;

Запрос = Новый Запрос("ВЫБРАТЬ
                      |	ЗаявкаНаБронирование.Клиент КАК Клиент,
                      |	ЗаявкаНаБронирование.Клиент.Телефон КАК КлиентТелефон,
                      |	НЕ Рассылка.Клиент ЕСТЬ NULL КАК ЕстьРассылка
                      |ИЗ
                      |	Документ.ЗаявкаНаБронирование КАК ЗаявкаНаБронирование
                      |		ЛЕВОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
                      |			РассылкаWhatsApp.Клиент КАК Клиент
                      |		ИЗ
                      |			РегистрСведений.РассылкаWhatsApp КАК РассылкаWhatsApp
                      |		ГДЕ
                      |			РассылкаWhatsApp.ДатаРассылки = &ДатаРассылки
                      |			И РассылкаWhatsApp.ТипРассылки = ЗНАЧЕНИЕ(Перечисление.ТипРассылкиWhatsApp.ДеньРождения)) КАК Рассылка
                      |		ПО ЗаявкаНаБронирование.Клиент = Рассылка.Клиент
                      |		ВНУТРЕННЕЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
                      |			КОЛИЧЕСТВО(РАЗЛИЧНЫЕ ЗаявкаНаБронирование.Ссылка) КАК Количество,
                      |			ЗаявкаНаБронирование.Клиент КАК Клиент
                      |		ИЗ
                      |			Документ.ЗаявкаНаБронирование КАК ЗаявкаНаБронирование
                      |		ГДЕ
                      |			ЗаявкаНаБронирование.ПометкаУдаления = ЛОЖЬ
                      |		
                      |		СГРУППИРОВАТЬ ПО
                      |			ЗаявкаНаБронирование.Клиент) КАК КоличествоЗаявок
                      |		ПО ЗаявкаНаБронирование.Клиент = КоличествоЗаявок.Клиент
                      |ГДЕ
					  |	ЗаявкаНаБронирование.ПометкаУдаления = ЛОЖЬ
					  |	И ЗаявкаНаБронирование.РезервС МЕЖДУ &ДатаС И &ДатаПо
					  |	И ЗаявкаНаБронирование.Клиент.ДатаРождения <> ДАТАВРЕМЯ(1, 1, 1)
					  |	И ДЕНЬ(ЗаявкаНаБронирование.Клиент.ДатаРождения) = &ДеньРождения
					  |	И МЕСЯЦ(ЗаявкаНаБронирование.Клиент.ДатаРождения) = &МесяцРождения
					  //|	И КоличествоЗаявок.Количество >= 3
					  //| И ЗаявкаНаБронирование.Клиент.Наименование = ""ПСН"" 
					  |
                      |СГРУППИРОВАТЬ ПО
                      |	ЗаявкаНаБронирование.Клиент,
                      |	НЕ Рассылка.Клиент ЕСТЬ NULL,
                      |	ЗаявкаНаБронирование.Клиент.Телефон");

ДатаПо = НачалоДня(ДатаРассылки);
День = День(ДатаПо);
Месяц = Месяц(ДатаПо);
Год = Год(ДатаПо) - 5;
ДатаС = Дата(Год, Месяц, День); 

Запрос.УстановитьПараметр("ДатаС", ДатаС);
Запрос.УстановитьПараметр("ДатаПо", ДатаПо);

Запрос.УстановитьПараметр("ДеньРождения", День);
Запрос.УстановитьПараметр("МесяцРождения", Месяц);

Запрос.УстановитьПараметр("ДатаРассылки", ДатаРассылки);

ТЗ = Запрос.Выполнить().Выгрузить();

МассивКУдалению = Новый Массив;
Для Каждого Строка Из ТЗ Цикл
	Если Строка.ЕстьРассылка Тогда
	МассивКУдалению.Добавить(Строка); Продолжить; КонецЕсли;
 
	КлиентТелефон = СокрЛП(Строка.КлиентТелефон); 
	
	Если СокрЛП(КлиентТелефон) = "" Тогда 	
	МассивКУдалению.Добавить(Строка); Продолжить; КонецЕсли;
КонецЦикла;

Для Каждого Строка Из МассивКУдалению Цикл
	ТЗ.Удалить(Строка);
КонецЦикла;

Для Каждого Строка Из ТЗ Цикл 
	Текст = ТекстРассылки_ДеньРождения(Строка.Клиент);
	
	КлиентТелефон = СокрЛП(Строка.КлиентТелефон); 

	Папка = Константы.Папка_C_BASE.Получить();
	ИмяТекущаяОрганизация = НастройкиСервер.ПолучитьИмяТекущаяОрганизация();
	Папка = Папка + "ОбразцыДокументов\";
	ПутьКФайлу = Папка + ИмяТекущаяОрганизация + "_ДР.JPG";
	
	Файл = Новый Файл(ПутьКФайлу); 
	Если Файл.Существует() Тогда
		Результат = МесенджерСервер.ОтправитьДанные_Месенджер("ОтправитьФайлИТекст", КлиентТелефон, Текст , ПутьКФайлу, Неопределено);
	Иначе
		Результат = МесенджерСервер.ОтправитьДанные_Месенджер("ОтправитьТекст", КлиентТелефон, Текст, Неопределено, Неопределено);
	КонецЕсли;
	
	Если НЕ Результат.Ошибка Тогда 
		МенеджерЗаписей = РегистрыСведений.РассылкаWhatsApp.СоздатьМенеджерЗаписи();
		МенеджерЗаписей.ДатаРассылки = ДатаРассылки;
		МенеджерЗаписей.Клиент = Строка.Клиент;
		МенеджерЗаписей.ТипРассылки = Перечисления.ТипРассылкиWhatsApp.ДеньРождения;

		МенеджерЗаписей.Записать();
	КонецЕсли;
КонецЦикла;
КонецПроцедуры

