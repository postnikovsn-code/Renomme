		                                |	ДеньПроживания");

		ЗапросПроживание.УстановитьПараметр("ДокументОплаты", СтрокаОплаты.ДокументОплаты);
		ТЗ_Проживание = ЗапросПроживание.Выполнить().Выгрузить();
		
		Для Каждого СтрокаПроживание Из ТЗ_Проживание Цикл
			ОбластьСтрокаЗатраты = Макет.ПолучитьОбласть("СтрокаЗатраты|КолонкиЛево"); 
			//ОбластьСтрокаОплаты.Параметры.Дата = Формат(СтрокаОплаты.ДатаОплаты, "ДФ=dd.MM.yy");
			//ОбластьСтрокаЗатраты.Параметры.ЗаявкаНомер = СтрокаПроживание.Заявка.Номер;
			//ОбластьСтрокаЗатраты.Параметры.ЗаявкаДата = Формат(СтрокаПроживание.Заявка.Дата, "ДФ=dd.MM.yy");
			
			ОбластьСтрокаЗатраты.Параметры.ДокументЗатраты = СтрокаПроживание.Заявка;
			ОбластьСтрокаЗатраты.Параметры.ДокументЗатратыРасшифровка = СтрокаПроживание.Заявка;
			
			ОбластьСтрокаЗатраты.Параметры.ДатаЗатрат = Формат(СтрокаПроживание.ДеньПроживания, "ДФ=dd.MM.yy");
			ОбластьСтрокаЗатраты.Параметры.ТипЗатрат = "Проживание";
			ОбластьСтрокаЗатраты.Параметры.СуммаОплаты = СтрокаПроживание.СуммаОплаты;
			
			ОбластьСтрокаЗатраты.Параметры.СуммаЗатрат = СтрокаПроживание.Сумма;
		
			ПолеОтчета.Вывести(ОбластьСтрокаЗатраты, 2);
		КонецЦикла;
		
		СуммаИтогоДокументОплатыЗатрат = СуммаИтогоДокументОплатыЗатрат + ТЗ_Проживание.Итог("СуммаОплаты");
//

//
		ЗапросУслуги = Новый Запрос("ВЫБРАТЬ
		                            |	ЗаявкаНаБронированиеРаспределениеОплатДолги.Ссылка КАК Заявка,
		                            |	ЗаявкаНаБронированиеРаспределениеОплатДолги.СуммаОплаты КАК СуммаОплаты,
		                            |	ЗаявкаНаБронированиеДопУслуги.Услуга КАК Услуга,
		                            |	ЗаявкаНаБронированиеДопУслуги.Цена КАК Цена,
		                            |	ЗаявкаНаБронированиеДопУслуги.Количество КАК Количество,
		                            |	ЗаявкаНаБронированиеДопУслуги.ДатаУслуги КАК ДатаУслуги,
		                            |	ЗаявкаНаБронированиеДопУслуги.Цена * ЗаявкаНаБронированиеДопУслуги.Количество КАК Сумма
		                            |ИЗ
		                            |	Документ.ЗаявкаНаБронирование.РаспределениеОплатДолги КАК ЗаявкаНаБронированиеРаспределениеОплатДолги
		                            |		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.ЗаявкаНаБронирование.ДопУслуги КАК ЗаявкаНаБронированиеДопУслуги
		                            |		ПО ЗаявкаНаБронированиеРаспределениеОплатДолги.Ссылка = ЗаявкаНаБронированиеДопУслуги.Ссылка
		                            |			И ЗаявкаНаБронированиеРаспределениеОплатДолги.ДолгиГУИД = ЗаявкаНаБронированиеДопУслуги.ГУИД
		                            |ГДЕ
		                            |	ЗаявкаНаБронированиеРаспределениеОплатДолги.Ссылка.ПометкаУдаления = ЛОЖЬ
		                            |	И ЗаявкаНаБронированиеРаспределениеОплатДолги.ДокументОплаты = &ДокументОплаты
		                            |	И ЗаявкаНаБронированиеДопУслуги.ВСчет = ИСТИНА
		                            |
		                            |УПОРЯДОЧИТЬ ПО
		                            |	Заявка");

		ЗапросУслуги.УстановитьПараметр("ДокументОплаты", СтрокаОплаты.ДокументОплаты);
		ТЗ_Услуги = ЗапросУслуги.Выполнить().Выгрузить();
		
		Для Каждого СтрокаУслуги Из ТЗ_Услуги Цикл
