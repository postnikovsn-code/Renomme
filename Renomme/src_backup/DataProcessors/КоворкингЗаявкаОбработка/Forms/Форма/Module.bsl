&НаСервере
Процедура ЗаполнитьНомерКоворкингДерево()
Запрос = Новый Запрос("ВЫБРАТЬ
                      |	КоворкингНомера.Ссылка КАК НомерКоворкинг,
                      |	КоворкингНомера.Родитель КАК Родитель,
                      |	КоворкингНомера.ПочасоваяОплата КАК ПочасоваяОплата,
                      |	КоворкингНомера.Номер_пп КАК Номер_пп,
                      |	КоворкингНомера.ЭтоГруппа КАК ЭтоГруппа
                      |ИЗ
                      |	Справочник.КоворкингНомера КАК КоворкингНомера
                      |ГДЕ
                      |	КоворкингНомера.ПометкаУдаления = ЛОЖЬ
                      |	И ВЫБОР
                      |			КОГДА &ТолькоПочасоваяОплата
                      |				ТОГДА КоворкингНомера.ПочасоваяОплата = ИСТИНА
                      |			ИНАЧЕ ИСТИНА
                      |		КОНЕЦ
                      |
                      |УПОРЯДОЧИТЬ ПО
                      |	НомерКоворкинг ИЕРАРХИЯ");
                                    
Запрос.УстановитьПараметр("ТолькоПочасоваяОплата", ТолькоПочасоваяОплата);

ТЗ = Запрос.Выполнить().Выгрузить(ОбходРезультатаЗапроса.ПоГруппировкамСИерархией) ;
ЗначениеВРеквизитФормы(ТЗ, "НомерКоворкингДерево");

ДЗ = ДанныеФормыВЗначение(НомерКоворкингДерево,Тип("ДеревоЗначений"));
ДЗ.Строки.Сортировать("ПочасоваяОплата, Номер_пп");
ЗначениеВДанныеФормы(ДЗ, НомерКоворкингДерево);
КонецПроцедуры

