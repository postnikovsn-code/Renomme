&НаКлиенте
Процедура ПолеОтчетаПриИзменении_OLD(Элемент)
ИмяЭлемента = Элемент.Имя;
Имя = Элемент.ТекущаяОбласть.Имя;

Если ИмяЭлемента = "ПолеОтчетаДолги" Тогда 
	НомерСтрокиШапка = НомерСтрокиШапкаДолги; 
	НомерКомментарий = НомерКомментарий_Долги;
ИначеЕсли ИмяЭлемента = "ПолеОтчетаСписание" Тогда
	НомерСтрокиШапка = НомерСтрокиШапкаСписание;
	НомерКомментарий = НомерКомментарий_Списание;
Иначе
	Возврат;	
Конецесли;

Индекс = СтрНайти(Имя,":");
Если Индекс <> 0 Тогда Возврат; КонецЕсли;

ИндексC = СтрНайти(Имя,"C"); 

НомерСтрокиСтрока = Сред(Имя, 2, ИндексC - 2);
НомерСтроки = ОбщийФункционалКлиентСервер.ПолучитьЧисло(НомерСтрокиСтрока);
Если НомерСтроки <= НомерСтрокиШапка Тогда Возврат; КонецЕсли;
Если НомерСтроки > ЭтаФорма[ИмяЭлемента].ВысотаТаблицы - 1 Тогда Возврат; КонецЕсли;

НомерСтолбцаСтрока = Сред(Имя, ИндексC + 1);
НомерСтолбца = ОбщийФункционалКлиентСервер.ПолучитьЧисло(НомерСтолбцаСтрока);

Если НомерСтолбца <> НомерКомментарий Тогда Возврат; КонецЕсли;
//Если НомерСтолбца <> Элемент.ТекущаяОбласть.Лево Тогда Возврат; КонецЕсли;

ИмяКомментарий = "R" + НомерСтрокиСтрока + "C" + НомерСтолбцаСтрока;
//Попытка 
	ЗначениеЯчейки = Элемент.ТекущаяОбласть.Значение;
//Исключение
//	Возврат;
//КонецПопытки;

Если ИмяЭлемента = "ПолеОтчетаДолги" Тогда 
	СтрокаДанные = ДанныеДолги[НомерСтроки - НомерСтрокиШапка - 1];
ИначеЕсли ИмяЭлемента = "ПолеОтчетаСписание" Тогда
	СтрокаДанные = ДанныеСписание[НомерСтроки - НомерСтрокиШапка - 1];
Иначе
	Возврат;	
Конецесли;

Если ЗначениеЯчейки <> СтрокаДанные.КомментарийОтветственного Тогда
	СтрокаДанные.КомментарийОтветственного = ЗначениеЯчейки;
	СтрокаДанные.ЕстьИзменения = Истина;
	
	ЗаявкаНаБронирование = СтрокаДанные.ЗаявкаНаБронирование;
