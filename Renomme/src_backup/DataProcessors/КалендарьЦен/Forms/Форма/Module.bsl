&НаСервере
Процедура ИзменитьВыбранныеНаСервере(Результат)

Автор = ПараметрыСеанса.ТекущийПользователь;

Для каждого СтрДТЦ Из СписВыбранных Цикл
	ДатаЦены = СтрДТЦ.Значение;
	//Выходной = (ДеньНедели(ДатаЦены) > 4);
	
	КалендарьЦенБазовая = РегистрыСведений.КалендарьЦенБазовый.СоздатьНаборЗаписей();	
	КалендарьЦенБазовая.Отбор["ДатаЦены"].Значение = ДатаЦены;
	КалендарьЦенБазовая.Отбор["ДатаЦены"].Использование = Истина;
	КалендарьЦенБазовая.Отбор["ВидЦены"].Значение = ВидЦеныТекущая;
	КалендарьЦенБазовая.Отбор["ВидЦены"].Использование = Истина;
	
	КалендарьЦенБазовая.Прочитать();
	КалендарьЦенБазовая.Очистить();	
	
	Если Результат.БазоваяЦенаИсходная <> Результат.БазоваяЦенаТекущая Тогда
		НоваяСтрока = КалендарьЦенБазовая.Добавить();
		НоваяСтрока.ДатаЦены = ДатаЦены;
		НоваяСтрока.ТипЦены = Перечисления.КалендарьЦенТипЦены.БазоваяЦена;
		
		НоваяСтрока.ВидЦены = ВидЦеныТекущая;
		
		НоваяСтрока.ЦенаДоплата = Результат.БазоваяЦенаТекущая;
		
		НоваяСтрока.Автор = Автор;
		НоваяСтрока.ДатаИзменения = ТекущаяДата();
	КонецЕсли;
		
	Если Результат.ДоплатаЗаДвухместныйИсходная <> Результат.ДоплатаЗаДвухместныйТекущая Тогда
		НоваяСтрока = КалендарьЦенБазовая.Добавить();
		НоваяСтрока.ДатаЦены = ДатаЦены;
		НоваяСтрока.ТипЦены = Перечисления.КалендарьЦенТипЦены.ДоплатаЗаДвухместный;
		
		НоваяСтрока.ВидЦены = ВидЦеныТекущая;
	
		НоваяСтрока.ЦенаДоплата = Результат.ДоплатаЗаДвухместныйТекущая;
		
		НоваяСтрока.Автор = Автор;
		НоваяСтрока.ДатаИзменения = ТекущаяДата();
	КонецЕсли;
	
	Если Результат.ДоплатаЗаЗавтракИсходная <> Результат.ДоплатаЗаЗавтракТекущая Тогда
		НоваяСтрока = КалендарьЦенБазовая.Добавить();
		НоваяСтрока.ДатаЦены = ДатаЦены;
		НоваяСтрока.ТипЦены = Перечисления.КалендарьЦенТипЦены.ДоплатаЗаЗавтрак;
		
		НоваяСтрока.ВидЦены = ВидЦеныТекущая;
	
		НоваяСтрока.ЦенаДоплата = Результат.ДоплатаЗаЗавтракТекущая;
		
		НоваяСтрока.Автор = Автор;
		НоваяСтрока.ДатаИзменения = ТекущаяДата();
	КонецЕсли;
	КалендарьЦенБазовая.Записать();
	
	КалендарьЦенКатегории = РегистрыСведений.КалендарьЦенКатегории.СоздатьНаборЗаписей();	
	КалендарьЦенКатегории.Отбор["ДатаЦены"].Значение = ДатаЦены;
	КалендарьЦенКатегории.Отбор["ДатаЦены"].Использование = Истина;
	КалендарьЦенКатегории.Отбор["ВидЦены"].Значение = ВидЦеныТекущая;
	КалендарьЦенКатегории.Отбор["ВидЦены"].Использование = Истина;
	
	КалендарьЦенКатегории.Прочитать();
	КалендарьЦенКатегории.Очистить();		
	Для Каждого Строка Из Результат.ЦеныКатегорииНомеров Цикл	
		Если Строка.ДоплатаЗаКатегориюИсходная = Строка.ДоплатаЗаКатегориюТекущая Тогда Продолжить; КонецЕсли;
		
		ЗаписатьКалендарьЦенКатегорииИстория(ДатаЦены, Автор, Строка.КатегорияНомера, ВидЦеныТекущая
				, Строка.ДоплатаЗаКатегориюТекущая, Строка.ДоплатаЗаКатегориюИсходная); 

		НоваяСтрока = КалендарьЦенКатегории.Добавить();
		НоваяСтрока.ВидЦены = ВидЦеныТекущая;
		
		НоваяСтрока.ДатаЦены = ДатаЦены;
		НоваяСтрока.КатегорияНомера = Строка.КатегорияНомера;
		НоваяСтрока.ДоплатаЗаКатегорию = Строка.ДоплатаЗаКатегориюТекущая;
		
		НоваяСтрока.Автор = Автор;
		НоваяСтрока.ДатаИзменения = ТекущаяДата();
	КонецЦикла;	
	КалендарьЦенКатегории.Записать();
	
	// + КалендарьЦенБазовый История
	ЗаписатьКалендарьЦенБазовыйИстория(ДатаЦены, Автор, Перечисления.КалендарьЦенТипЦены.БазоваяЦена, ВидЦеныТекущая
		, Результат.БазоваяЦенаТекущая, Результат.БазоваяЦенаИсходная);
	ЗаписатьКалендарьЦенБазовыйИстория(ДатаЦены, Автор, Перечисления.КалендарьЦенТипЦены.ДоплатаЗаДвухместный, ВидЦеныТекущая
		, Результат.ДоплатаЗаДвухместныйТекущая, Результат.ДоплатаЗаДвухместныйИсходная);
	ЗаписатьКалендарьЦенБазовыйИстория(ДатаЦены, Автор, Перечисления.КалендарьЦенТипЦены.ДоплатаЗаЗавтрак, ВидЦеныТекущая
		, Результат.ДоплатаЗаЗавтракТекущая, Результат.ДоплатаЗаЗавтракИсходная);
	// - КалендарьЦенБазовый История
КонецЦикла;			

СписВыбранных=Новый СписокЗначений;
//ОбновитьТЗЦен();
ОбновитьГод(Объект.Год);
КонецПроцедуры                   

&НаСервере
Процедура ЗаписатьКалендарьЦенБазовыйИстория(ДатаЦены, Автор, ТипЦены, ВидЦены, ЦенаДоплатаТекущая, ЦенаДоплатаИсходная)
Если ЦенаДоплатаТекущая = ЦенаДоплатаИсходная Тогда Возврат; КонецЕсли;

КалендарьЦенБазовыйИстория = РегистрыСведений.КалендарьЦенБазовыйИстория.СоздатьМенеджерЗаписи();	
КалендарьЦенБазовыйИстория.ВидЦены = ВидЦены;

КалендарьЦенБазовыйИстория.ДатаЦены = ДатаЦены;
КалендарьЦенБазовыйИстория.ТипЦены = ТипЦены;
КалендарьЦенБазовыйИстория.ЦенаДоплата = ЦенаДоплатаТекущая;

КалендарьЦенБазовыйИстория.ДатаВремяИзменения = ТекущаяДата();
КалендарьЦенБазовыйИстория.Автор = Автор;

КалендарьЦенБазовыйИстория.Записать();
КонецПроцедуры                   

&НаСервере
Процедура ЗаписатьКалендарьЦенКатегорииИстория(ДатаЦены, Автор, КатегорияНомера, ВидЦены, ДоплатаЗаКатегориюТекущая, ДоплатаЗаКатегориюИсходная)  
Если ДоплатаЗаКатегориюТекущая = ДоплатаЗаКатегориюИсходная Тогда Возврат; КонецЕсли;

КалендарьЦенКатегорииИстория = РегистрыСведений.КалендарьЦенКатегорииИстория.СоздатьМенеджерЗаписи();	
КалендарьЦенКатегорииИстория.ВидЦены = ВидЦены;

КалендарьЦенКатегорииИстория.ДатаЦены = ДатаЦены;
КалендарьЦенКатегорииИстория.КатегорияНомера = КатегорияНомера;
КалендарьЦенКатегорииИстория.ДоплатаЗаКатегорию = ДоплатаЗаКатегориюТекущая;

КалендарьЦенКатегорииИстория.ДатаВремяИзменения = ТекущаяДата();
КалендарьЦенКатегорииИстория.Автор = Автор;

КалендарьЦенКатегорииИстория.Записать();
КонецПроцедуры                   

&НаСервере
Функция РазныеБазовыеЦеныВСписВыбранных()
Если СписВыбранных.Количество()= 0 тогда Возврат Ложь; КонецЕсли;

СписВыбранных.СортироватьПоЗначению(НаправлениеСортировки.Возр);
	
Дата = СписВыбранных[0].Значение; 	
Результат = ПолучитьБазовыеЦеныНаДень(Дата);

БазоваяЦена = Результат.БазоваяЦена;
ДоплатаЗаДвухместный = Результат.ДоплатаЗаДвухместный;
ДоплатаЗаЗавтрак = Результат.ДоплатаЗаЗавтрак;
ДоплатыЗаКатегории = Результат.ДоплатыЗаКатегории;

ЕстьОтклонения = Ложь;
Для Каждого Элемент Из СписВыбранных Цикл
	Дата = Элемент.Значение; 	

	Результат = ПолучитьБазовыеЦеныНаДень(Дата);
	Если НЕ Сравнить_Две_Таблицы_Значений(ДоплатыЗаКатегории, Результат.ДоплатыЗаКатегории) Тогда 
	
		ЕстьОтклонения = Истина;
		Прервать;
	КонецЕсли;
	
	Если БазоваяЦена = Результат.БазоваяЦена 
	И ДоплатаЗаДвухместный = Результат.ДоплатаЗаДвухместный
	И ДоплатаЗаЗавтрак = Результат.ДоплатаЗаЗавтрак
	Тогда Продолжить; КонецЕсли;

	ЕстьОтклонения = Истина;
	Прервать;
КонецЦикла;	

Возврат ЕстьОтклонения;
КонецФункции

&НаСервере
Функция Сравнить_Две_Таблицы_Значений(ТЗn1, ТЗn2) 

   // Данный метод программно сравнивает две таблицы значений по всем признакам
  Если ТипЗнч(ТЗn1) <> Тип("ТаблицаЗначений")  Тогда
       Сообщить("Параметр N1 не является Таблицой значений");
       Возврат Ложь;
   КонецЕсли;

   Если ТипЗнч(ТЗn2) <> Тип("ТаблицаЗначений") Тогда
       Сообщить("Параметр N2 не является Таблицой значений");
       Возврат Ложь;
   КонецЕсли;

   Если ТЗn1.Количество() <> ТЗn2.Количество() Тогда
       Сообщить("Количество строк у таблиц значений различное");
       Возврат Ложь;
   КонецЕсли;

   Если ТЗn1.Колонки.Количество() <> ТЗn2.Колонки.Количество() Тогда
       Сообщить("Количество колонок у таблиц значений различное");
       Возврат Ложь;
   КонецЕсли;

   // Предварительно сортируем обе таблицы по одному и тому же уникальному ключу
  ТЗn1.Сортировать("КатегорияНомера Возр");   // прим. УникКлюч - свой идентиф.
  ТЗn2.Сортировать("КатегорияНомера Возр");

   // Преобразуем
   СтрВнутрТЗn1 = ЗначениеВСтрокуВнутр(ТЗn1.Скопировать());
   СтрВнутрТЗn2 = ЗначениеВСтрокуВнутр(ТЗn2.Скопировать());

   Если СтрВнутрТЗn1 <> СтрВнутрТЗn2 Тогда
       Возврат Ложь;
   Иначе
       Возврат Истина;
   КонецЕсли;

КонецФункции

&НаСервере
Функция ПолучитьБазовыеЦеныНаДень(Дата) 
//МодульОбработки = Обработки.КалендарьЦен1;	
МодульОбработки = КалендарьЦен;	

ТЗ_БазовыеЦены = МодульОбработки.ПолучитьТЗБазовыеЦены(Дата); 

Если ТЗ_БазовыеЦены.Количество() = 0 Тогда
	БазоваяЦена = 0;	
	ДоплатаЗаЗавтрак = 0;	
	ДоплатаЗаДвухместный = 0;
	
	ДоплатыЗаКатегории = Новый ТаблицаЗначений;
Иначе
	Строка = ТЗ_БазовыеЦены[0];
	
	БазоваяЦена = Строка.БазоваяЦена;	
	ДоплатаЗаЗавтрак = Строка.ДоплатаЗаЗавтрак;	
	ДоплатаЗаДвухместный = Строка.ДоплатаЗаДвухместный;
	
	ДоплатыЗаКатегории = Строка.ДоплатыЗаКатегории;
КонецЕсли;

Результат = Новый Структура("БазоваяЦена, ДоплатаЗаДвухместный, ДоплатаЗаЗавтрак, ДоплатыЗаКатегории"
 ,БазоваяЦена ,ДоплатаЗаДвухместный, ДоплатаЗаЗавтрак, ДоплатыЗаКатегории); 
 
Возврат Результат;
КонецФункции
