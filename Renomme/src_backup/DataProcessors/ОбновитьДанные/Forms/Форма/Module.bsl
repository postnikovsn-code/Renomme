&НаСервере
Процедура ЗаполнитьПрограммныйКодУслугиНаСервере()
Запрос = Новый Запрос("ВЫБРАТЬ
                      |	ЗаявкаНаБронирование.Ссылка КАК Ссылка
                      |ИЗ
                      |	Документ.ЗаявкаНаБронирование КАК ЗаявкаНаБронирование
                      |ГДЕ
                      |	ЗаявкаНаБронирование.ПометкаУдаления = ЛОЖЬ
                      |	И ЗаявкаНаБронирование.РезервС >= &РезервС");

Запрос.УстановитьПараметр("РезервС", '20240101');
ТЗ = Запрос.Выполнить().Выгрузить();

Для Каждого Строка Из ТЗ Цикл
	Объект_П = Строка.Ссылка.ПолучитьОбъект();
	СчетаДетальноДолги = Объект_П.СчетаДетальноДолги;
	ДопУслуги = Объект_П.ДопУслуги;
	
	Для Каждого СтрокаДолги Из СчетаДетальноДолги Цикл
		Если НЕ СтрокаДолги.Услуга Тогда Продолжить; КонецЕсли;
		
		ОтборСтроки = Новый Структура("ГУИД", СтрокаДолги.ДолгиГУИД);
		НайденныеСтроки = ДопУслуги.НайтиСтроки(ОтборСтроки); 
		Если НайденныеСтроки.Количество() = 0 Тогда Продолжить; КонецЕсли;
		
		Услуга = НайденныеСтроки[0].Услуга;
		СтрокаДолги.ПрограммныйКодУслуги = Услуга.ПрограммныйКод; 
		
		СтрокаДолги.НазваниеДляЧека = Услуга.НазваниеДляЧека;
	КонецЦикла;
	
	Попытка
		Объект_П.Записать(РежимЗаписиДокумента.Проведение);
	Исключение
		Сообщить("Ошибка проведения " + Строка.Ссылка + " Описание ошибки: " + ОписаниеОшибки());
	КонецПопытки;
КонецЦикла;
КонецПроцедуры
