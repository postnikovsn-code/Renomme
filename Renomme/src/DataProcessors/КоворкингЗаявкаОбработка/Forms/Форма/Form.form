  <attributes>
    <name>Заявки</name>
    <title>
      <key>ru</key>
      <value>Заявки</value>
    </title>
    <id>1</id>
    <valueType>
      <types>DynamicList</types>
    </valueType>
    <view>
      <common>true</common>
    </view>
    <edit>
      <common>true</common>
    </edit>
    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>Заявки.ДатаПо</segments>
    </notDefaultUseAlwaysAttributes>
    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>Заявки.ДатаС</segments>
    </notDefaultUseAlwaysAttributes>
    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>Заявки.Ссылка</segments>
    </notDefaultUseAlwaysAttributes>
    <main>true</main>
    <extInfo xsi:type="form:DynamicListExtInfo">
      <queryText>ВЫБРАТЬ
	ДокументКоворкингЗаявка.Ссылка КАК Ссылка,
	ДокументКоворкингЗаявка.ПометкаУдаления КАК ПометкаУдаления,
	ДокументКоворкингЗаявка.Номер КАК Номер,
	ДокументКоворкингЗаявка.Дата КАК Дата,
	ДокументКоворкингЗаявка.Проведен КАК Проведен,
	ДокументКоворкингЗаявка.Клиент КАК Клиент,
	ДокументКоворкингЗаявка.Оплачивает КАК Оплачивает,
	ДокументКоворкингЗаявка.КоворкингНомер КАК КоворкингНомер,
	ДокументКоворкингЗаявка.ДатаС КАК ДатаС,
	ДокументКоворкингЗаявка.ДатаПо КАК ДатаПо,
	ДокументКоворкингЗаявка.Примечание КАК Примечание,
	ДокументКоворкингЗаявка.ЧасС КАК ЧасС,
	ДокументКоворкингЗаявка.ЧасПо КАК ЧасПо
ИЗ
	Документ.КоворкингЗаявка КАК ДокументКоворкингЗаявка
ГДЕ
	ДокументКоворкингЗаявка.ПометкаУдаления = ЛОЖЬ
	И ДокументКоворкингЗаявка.КоворкингНомер = &amp;КоворкингНомер</queryText>
      <mainTable>Document.КоворкингЗаявка</mainTable>
      <autoFillAvailableFields>true</autoFillAvailableFields>
      <customQuery>true</customQuery>
      <autoSaveUserSettings>true</autoSaveUserSettings>
      <getInvisibleFieldPresentations>true</getInvisibleFieldPresentations>
    </extInfo>
  </attributes>
