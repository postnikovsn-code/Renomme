
Функция ДокументПредставление(Документ) Экспорт
Если НЕ ЗначениеЗаполнено(Документ)	Тогда Возврат ""; КонецЕсли;

ТипЗнч_Документ = ТипЗнч(Документ);
Если ТипЗнч_Документ  = Тип("ДокументСсылка.ЗаявкаНаБронирование") Тогда
	ДокументПредставление = "ЗБ ";	
ИначеЕсли ТипЗнч_Документ  = Тип("ДокументСсылка.ГрупповыеСчета") Тогда
	ДокументПредставление = "ГС ";	
ИначеЕсли ТипЗнч_Документ  = Тип("ДокументСсылка.КоворкингСчета") Тогда
	ДокументПредставление = "СК ";	
ИначеЕсли ТипЗнч_Документ  = Тип("ДокументСсылка.ВыпискаБанка") Тогда
	ДокументПредставление = "ВБ ";	
ИначеЕсли ТипЗнч_Документ  = Тип("ДокументСсылка.КассовыйДокумент") Тогда
	ДокументПредставление = "КД ";	
ИначеЕсли ТипЗнч_Документ  = Тип("ДокументСсылка.ПрочиеОплаты") Тогда
	ДокументПредставление = "ПО ";	
Иначе
	ДокументПредставление = "" + ТипЗнч_Документ + " ";	
КонецЕсли;	
	
ДокументПредставление = ДокументПредставление + Документ.Номер + " от " + Формат(Документ.Дата, "ДФ=dd.MM.yy"); 	
Возврат ДокументПредставление;	
КонецФункции

Функция ЭтоНовыйРасчет(Ссылка) Экспорт
Возврат Ссылка.НовыйРассчет;
КонецФункции 	

