&НаКлиенте
Процедура ВопросыВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	СтандартнаяОбработка=ложь;
		
	ТекушиеДанные = Элементы.Вопросы.ТекущиеДанные;	
	Если Поле.Имя="ВопросыОтлично" тогда
		ТекушиеДанные.Отлично=Истина;	
		ТекушиеДанные.Хорошо=Ложь;
		ТекушиеДанные.Удовлетворительно=Ложь;
		ТекушиеДанные.Плохо=Ложь;
	ИначеЕсли Поле.Имя="ВопросыХорошо" тогда	
		ТекушиеДанные.Отлично=Ложь;	
		ТекушиеДанные.Хорошо=Истина;
		ТекушиеДанные.Удовлетворительно=Ложь;
		ТекушиеДанные.Плохо=Ложь;
	ИначеЕсли Поле.Имя="ВопросыУдовлетворительно" тогда
		ТекушиеДанные.Отлично=Ложь;	
		ТекушиеДанные.Хорошо=Ложь;
		ТекушиеДанные.Удовлетворительно=Истина;
		ТекушиеДанные.Плохо=Ложь;
	ИначеЕсли Поле.Имя="ВопросыПлохо" тогда
		ТекушиеДанные.Отлично=Ложь;	
		ТекушиеДанные.Хорошо=Ложь;
		ТекушиеДанные.Удовлетворительно=Ложь;
		ТекушиеДанные.Плохо=Истина;
	конецесли;	

КонецПроцедуры

