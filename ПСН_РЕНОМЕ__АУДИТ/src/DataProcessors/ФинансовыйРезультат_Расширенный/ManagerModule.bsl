Область.Параметры.СуммаВозвратаДокументаОплаты = ИтогиДень.СуммаВозвратаДокументаОплаты;
Область.Параметры.СуммаВозвратаДокументаОплаты_кк = ИтогиДень.СуммаВозвратаДокументаОплаты_кк;
Область.Параметры.СуммаВозвратаДокументаОплаты_Нал = ИтогиДень.СуммаВозвратаДокументаОплаты_Нал;

Область.Параметры.ОстатокДокументаОплаты = ИтогиДень.ОстатокДокументаОплаты;

Область.Параметры.СуммаЭквайринга = ИтогиДень.СуммаЭквайринга;

Область.Параметры.СуммаКомиссииКВыплате	 = ИтогиДень.СуммаКомиссииКВыплате;
Область.Параметры.СуммаКомиссииИнформационно	 = ИтогиДень.СуммаКомиссииИнформационно;
Область.Параметры.СуммаКомиссииОплата	 = ИтогиДень.СуммаКомиссииОплата;

//Область.Параметры.КоличествоСтатус	 = ИтогиДень.КоличествоСтатус;
Область.Параметры.КоличествоЗавтраки	 = ИтогиДень.КоличествоЗавтраки;

ПолеОтчета.Вывести(Область, 0);

Для Каждого СтрокаУслугиИтого Из ИтогиДень.УслугиДеньИтоги Цикл
	ОбластьУслуги = Макет.ПолучитьОбласть("ИтогиДеньДополнение|КолонкаУслуги");
	Если СтрокаУслугиИтого.СуммаУслуги <> 0 Тогда
		ОбластьУслуги.Параметры.СуммаУслуги = СтрокаУслугиИтого.СуммаУслуги;
	КонецЕсли;	
	ПолеОтчета.Присоединить(ОбластьУслуги, 0);
КонецЦикла;

//
Итоги.КоличествоНочей = Итоги.КоличествоНочей + ИтогиДень.КоличествоНочей;
Итоги.КоличествоСутокТариф = Итоги.КоличествоСутокТариф + ИтогиДень.КоличествоСутокТариф;

Итоги.СуммаЦенаПроживание = Итоги.СуммаЦенаПроживание + ИтогиДень.СуммаЦенаПроживание;
Итоги.СуммаПроживание = Итоги.СуммаПроживание + ИтогиДень.СуммаПроживание;

Итоги.СуммаНомера = Итоги.СуммаНомера + ИтогиДень.СуммаНомера;

Итоги.СуммаОплаты = Итоги.СуммаОплаты + ИтогиДень.СуммаОплаты;

Итоги.СуммаОплаты_кк = Итоги.СуммаОплаты_кк + ИтогиДень.СуммаОплаты_кк;
Итоги.СуммаОплаты_Нал = Итоги.СуммаОплаты_Нал + ИтогиДень.СуммаОплаты_Нал;

Итоги.СуммаДокументаОплаты = Итоги.СуммаДокументаОплаты + ИтогиДень.СуммаДокументаОплаты;
Итоги.СуммаДокументаОплаты_кк = Итоги.СуммаДокументаОплаты_кк + ИтогиДень.СуммаДокументаОплаты_кк;
Итоги.СуммаДокументаОплаты_Нал = Итоги.СуммаДокументаОплаты_Нал + ИтогиДень.СуммаДокументаОплаты_Нал;

Итоги.СуммаВозвратаДокументаОплаты = Итоги.СуммаВозвратаДокументаОплаты + ИтогиДень.СуммаВозвратаДокументаОплаты;
Итоги.СуммаВозвратаДокументаОплаты_кк = Итоги.СуммаВозвратаДокументаОплаты_кк + ИтогиДень.СуммаВозвратаДокументаОплаты_кк;
Итоги.СуммаВозвратаДокументаОплаты_Нал = Итоги.СуммаВозвратаДокументаОплаты_Нал + ИтогиДень.СуммаВозвратаДокументаОплаты_Нал;

Итоги.ОстатокДокументаОплаты = Итоги.ОстатокДокументаОплаты + ИтогиДень.ОстатокДокументаОплаты;

Итоги.СуммаЭквайринга = Итоги.СуммаЭквайринга + ИтогиДень.СуммаЭквайринга;  

Итоги.СуммаКомиссииИнформационно = Итоги.СуммаКомиссииИнформационно + ИтогиДень.СуммаКомиссииИнформационно;
Итоги.СуммаКомиссииКВыплате = Итоги.СуммаКомиссииКВыплате + ИтогиДень.СуммаКомиссииКВыплате;
Итоги.СуммаКомиссииОплата = Итоги.СуммаКомиссииОплата + ИтогиДень.СуммаКомиссииОплата;

Итоги.КоличествоСтатус = Итоги.КоличествоСтатус + ИтогиДень.КоличествоСтатус;
Итоги.КоличествоЗавтраки = Итоги.КоличествоЗавтраки + ИтогиДень.КоличествоЗавтраки;

Итоги.КоличествоЧеловек = Итоги.КоличествоЧеловек + ИтогиДень.КоличествоЧеловек;

Для Индекс = 0 По Итоги.УслугиИтоги.Количество() - 1 Цикл
	Итоги.УслугиИтоги[Индекс].СуммаУслуги = Итоги.УслугиИтоги[Индекс].СуммаУслуги 
		+ ИтогиДень.УслугиДеньИтоги[Индекс].СуммаУслуги;		
КонецЦикла;
//

ИтогиДень.КоличествоСтатус = 0;;
ИтогиДень.КоличествоНочей = 0;
ИтогиДень.КоличествоСутокТариф = 0;
ИтогиДень.СуммаЦенаПроживание = 0;
ИтогиДень.СуммаПроживание = 0;
ИтогиДень.СуммаНомера = 0;

ИтогиДень.СуммаОплаты = 0;
ИтогиДень.СуммаОплаты_кк = 0;
ИтогиДень.СуммаОплаты_Нал = 0;

ИтогиДень.СуммаДокументаОплаты = 0;
ИтогиДень.СуммаДокументаОплаты_кк = 0;
ИтогиДень.СуммаДокументаОплаты_Нал = 0;

ИтогиДень.СуммаДокументаОплаты = 0;
ИтогиДень.СуммаДокументаОплаты_кк = 0;
ИтогиДень.СуммаДокументаОплаты_Нал = 0;

ИтогиДень.СуммаВозвратаДокументаОплаты = 0;
ИтогиДень.СуммаВозвратаДокументаОплаты_кк = 0;
ИтогиДень.СуммаВозвратаДокументаОплаты_Нал = 0;

ИтогиДень.ОстатокДокументаОплаты = 0;

ИтогиДень.СуммаЭквайринга = 0;

ИтогиДень.СуммаКомиссииИнформационно = 0;
ИтогиДень.СуммаКомиссииКВыплате = 0;
ИтогиДень.СуммаКомиссииОплата = 0;

ИтогиДень.КоличествоСтатус = 0;;
ИтогиДень.КоличествоЗавтраки = 0;;

ИтогиДень.КоличествоЧеловек = 0;;

УслугиДеньИтоги = ИтогиДень.УслугиДеньИтоги;
Для Каждого Строка Из ИтогиДень.УслугиДеньИтоги Цикл
	Строка.СуммаУслуги = 0;	
КонецЦикла;

КонецПроцедуры	
//

////
Процедура ОплатаОбластьЗаполнить(СтрокаОплаты, Область, ИтогиДень)
Если ТипЗнч(СтрокаОплаты.ДокументОплаты) = Тип("УникальныйИдентификатор") Тогда	
	Область.Параметры.РасшифровкаДокументОплаты = "Нераспределенная выгрузка";
Иначе	
	Область.Параметры.РасшифровкаДокументОплаты = СтрокаОплаты.ДокументОплаты;
КонецЕсли;

Область.Параметры.ДатаОплаты = Формат(СтрокаОплаты.ДатаОплаты, "ДФ=dd.MM.yy");

Если ЗначениеЗаполнено(СтрокаОплаты.ДатаСменыККМ) Тогда
	Область.Параметры.ДатаОткрытияСмены = Формат(СтрокаОплаты.ДатаСменыККМ, "ДФ=dd.MM.yy");
КонецЕсли;	

Область.Параметры.ТипОплаты = ОтчетыСервер.ТипОплатыНаименование(СтрокаОплаты.ТипОплаты);

СуммаОплаты = СтрокаОплаты.СуммаОплаты;
Область.Параметры.СуммаОплаты = СуммаОплаты;

СуммаЭквайринга = ОтчетыСервер.СуммаЭквайринга(СтрокаОплаты);
Область.Параметры.СуммаЭквайринга = СуммаЭквайринга;

Если СтрокаОплаты.СуммаДокументаОплаты <> 0 Тогда
	Область.Параметры.СуммаОплаты_кк = Окр(СтрокаОплаты.СуммаОплаты 
		* СтрокаОплаты.СуммаДокументаОплатыКарта / СтрокаОплаты.СуммаДокументаОплаты, 2);
	Область.Параметры.СуммаОплаты_Нал = Окр(СтрокаОплаты.СуммаДокументаОплаты 
		* СтрокаОплаты.СуммаДокументаОплатыНаличные / СтрокаОплаты.СуммаДокументаОплаты, 2);
КонецЕсли;

Область.Параметры.ГрупповаяОплата = ?(СтрокаОплаты.ГрупповаяОплата, "V", "");

//
Если ИтогиДень <> Неопределено Тогда
	ИтогиДень.СуммаОплаты = ИтогиДень.СуммаОплаты + СуммаОплаты;

	ИтогиДень.СуммаОплаты_кк = ИтогиДень.СуммаОплаты_кк + СтрокаОплаты.СуммаОплаты_кк;
	ИтогиДень.СуммаОплаты_Нал = ИтогиДень.СуммаОплаты_Нал + СтрокаОплаты.СуммаОплаты_Нал;

	ИтогиДень.СуммаЭквайринга = ИтогиДень.СуммаЭквайринга + СуммаЭквайринга;  
КонецЕсли;	
//
КонецПроцедуры

Процедура ЗаявкаОбластьЗаполнить(ТЗ_ОплатыЗаявки, Заявка, Область, ИтогиДень)
Область.Параметры.Номер = Заявка.НомерВРезерв;
Область.Параметры.РасшифровкаНомер = Заявка;

Область.Параметры.ЗаявкаНомер = Заявка.Номер;
Область.Параметры.ЗаявкаДата = Заявка.Дата;

Область.Параметры.КатегорияНомера = Заявка.КатегорияНомера;
Область.Параметры.Статус = Заявка.Статус;

ЗаявкаЗакрыта = Заявка.Закрыто;
Если ЗаявкаЗакрыта Тогда
	Область.Параметры.ДатаЗакрытияЗаявки = Формат(Заявка.ДатаЗакрытия, "ДФ=dd.MM.yy");
КонецЕсли;

Область.Параметры.РасшифровкаЗаявка = Заявка;  

//
КоличествоЧеловек = Заявка.КолВоЧеловек;
Область.Параметры.КоличествоЧеловек = КоличествоЧеловек;

ПроживаниеЗаявка = ПроживаниеЗаявка(Заявка);
Если ПроживаниеЗаявка.Количество() > 0 Тогда 
	СтрокаПроживание = ПроживаниеЗаявка[0];
	
	СуммаПроживаниеБезСкидки_П = СтрокаПроживание.СуммаБезСкидки;
	СуммаПроживание_П = СтрокаПроживание.Сумма;
	ПроживаниеКоличество = СтрокаПроживание.Количество;
	
	ЦенаПроживание = СтрокаПроживание.Цена;
	КоличествоСутокТариф = СтрокаПроживание.Количество;
	
Иначе
	СуммаПроживаниеБезСкидки_П = 0;
	СуммаПроживание_П = 0;
	ПроживаниеКоличество = 0;
	
	ЦенаПроживание = 0;
	КоличествоСутокТариф = 0;
КонецЕсли;

КоличествоЗавтраки = 0;
Если НЕ (Заявка.Статус = Перечисления.СтатусБрони.ОтменаБронирования 
ИЛИ Заявка.Статус = Перечисления.СтатусБрони.ОтказОтБронирования) 
Тогда 
	Если (НЕ Заявка.БезЗавтрака) И (НЕ Заявка.БонШанс) Тогда
		КоличествоЗавтраки = Заявка.КолВоЧеловек * Заявка.Проживание.Количество();
	КонецЕсли;
КонецЕсли;	
Если КоличествоЗавтраки <> 0 Тогда Область.Параметры.КоличествоЗавтраки = КоличествоЗавтраки; КонецЕсли;

Если ЦенаПроживание <> 0 Тогда Область.Параметры.ЦенаПроживание = ЦенаПроживание; КонецЕсли;
Если КоличествоСутокТариф <> 0 Тогда Область.Параметры.КоличествоСутокТариф = КоличествоСутокТариф; КонецЕсли;

// + Комиссия
ПроцентКомиссии = ДокументыСервер.ПроцентКомиссииКлиента(Заявка.Бронирует, Заявка.РезервС); //, Заявка.В2В);

СуммаКомиссии = ДокументыСервер.СуммаКомиссии(Заявка, СуммаПроживаниеБезСкидки_П
	, Заявка.Счета, Заявка.СчетаДетальноДолги, Заявка.ДопУслуги, ПроцентКомиссии);

Если Заявка.Бронирует.Турагентство Тогда
	СуммаПроживание = СуммаПроживаниеБезСкидки_П;
	
	Если Заявка.Бронирует.ТипОплатыСчета = Перечисления.ТипОплатыСчета.Взаимозачет Тогда  
		Если Заявка.Бронирует = Заявка.Оплачивает Тогда  
			СуммаКомиссииИнформационно = СуммаКомиссии;
			СуммаКомиссииКВыплате = 0;
		Иначе	
			СуммаКомиссииИнформационно = 0;
			СуммаКомиссииКВыплате = СуммаКомиссии;
		КонецЕсли;	
	ИначеЕсли Заявка.Бронирует.ТипОплатыСчета = Перечисления.ТипОплатыСчета.ОплатаТурагентствомСоСкидкой Тогда 
		Если Заявка.Бронирует = Заявка.Оплачивает Тогда  
			СуммаКомиссииИнформационно = СуммаКомиссии;
			СуммаКомиссииКВыплате = 0;
		Иначе	
			СуммаКомиссииИнформационно = 0;
			СуммаКомиссииКВыплате = СуммаКомиссии;
		КонецЕсли;					
	ИначеЕсли Заявка.Бронирует.ТипОплатыСчета = Перечисления.ТипОплатыСчета.ПолнаяОплатаТурагентствомСВозвратомКомиссии Тогда 
		СуммаКомиссииИнформационно = 0;
		СуммаКомиссииКВыплате = СуммаКомиссии;
	Иначе	
		СуммаКомиссииИнформационно = 0;
		СуммаКомиссииКВыплате = СуммаКомиссии;
	КонецЕсли;	
	
Иначе	
	СуммаПроживание = СуммаПроживание_П;  
	
	СуммаКомиссии = 0;
	СуммаКомиссииИнформационно = 0; 
	СуммаКомиссииКВыплате = 0;
КонецЕсли;	
// - Комиссия

Если СуммаПроживание <> 0 Тогда Область.Параметры.СуммаПроживание = СуммаПроживание; КонецЕсли;

Если СуммаКомиссииИнформационно > 0 Тогда Область.Параметры.СуммаКомиссииИнформационно = СуммаКомиссииИнформационно; КонецЕсли;
Если СуммаКомиссииКВыплате <> 0 Тогда Область.Параметры.СуммаКомиссииКВыплате = СуммаКомиссииКВыплате; КонецЕсли;

//ТЗ_Оплаты = ОтчетыСервер.ТЗ_ОплатыЗаявка(Заявка);		    
ТЗ_Оплаты = ОтчетыСервер.ТЗ_ОплатыЗаявка(ТЗ_ОплатыЗаявки, Заявка);		    
ТЗ_Проживание = Заявка.Проживание;

СуммаЭквайрингаПроживание = ОтчетыСервер.СуммаЭквайрингаПроживание(ТЗ_Проживание, ТЗ_Оплаты);

СуммаНомера = СуммаПроживание - СуммаКомиссии - СуммаЭквайрингаПроживание;
Если СуммаНомера <> 0 Тогда Область.Параметры.СуммаНомера = СуммаНомера; КонецЕсли;

//
Если ИтогиДень <> Неопределено Тогда
	ИтогиДень.КоличествоНочей = ИтогиДень.КоличествоНочей + ПроживаниеКоличество;
	ИтогиДень.КоличествоСутокТариф = ИтогиДень.КоличествоСутокТариф + КоличествоСутокТариф;
		
	ИтогиДень.СуммаЦенаПроживание = ИтогиДень.СуммаЦенаПроживание + Заявка.Проживание.Итог("Цена");

	ИтогиДень.СуммаПроживание = ИтогиДень.СуммаПроживание + СуммаПроживание;
	ИтогиДень.СуммаНомера = ИтогиДень.СуммаНомера + СуммаНомера;
		
	ИтогиДень.СуммаКомиссииИнформационно = ИтогиДень.СуммаКомиссииИнформационно + СуммаКомиссииИнформационно;
	ИтогиДень.СуммаКомиссииКВыплате = ИтогиДень.СуммаКомиссииКВыплате + СуммаКомиссииКВыплате;
		
	Если НЕ (Заявка.Статус = Перечисления.СтатусБрони.ОтменаБронирования 
	ИЛИ Заявка.Статус = Перечисления.СтатусБрони.ОтказОтБронирования) 
	Тогда 
		ИтогиДень.КоличествоСтатус = ИтогиДень.КоличествоСтатус + 1;
	КонецЕсли;

	ИтогиДень.КоличествоЗавтраки = ИтогиДень.КоличествоЗавтраки + КоличествоЗавтраки;
		
	ИтогиДень.КоличествоЧеловек = ИтогиДень.КоличествоЧеловек + КоличествоЧеловек;
КонецЕсли;		
//
КонецПроцедуры

Функция УслугиОбластьВывести(Заявка, ТЗ_РодительУслуги, ИмяОбласти, Макет, ПолеОтчета, ИтогиДень) 
Запрос = Новый Запрос("ВЫБРАТЬ
                      |	ЗаявкаНаБронированиеДопУслуги.Ссылка КАК Ссылка,
                      |	ЗаявкаНаБронированиеДопУслуги.Услуга КАК Услуга,
                      |	СУММА(ЗаявкаНаБронированиеДопУслуги.Цена * ЗаявкаНаБронированиеДопУслуги.Количество) КАК Сумма
                      |ИЗ
                      |	Документ.ЗаявкаНаБронирование.ДопУслуги КАК ЗаявкаНаБронированиеДопУслуги
                      |ГДЕ
                      |	ЗаявкаНаБронированиеДопУслуги.ВСчет = ИСТИНА
                      |	И ЗаявкаНаБронированиеДопУслуги.Ссылка = &Заявка
                      |
                      |СГРУППИРОВАТЬ ПО
                      |	ЗаявкаНаБронированиеДопУслуги.Ссылка,
                      |	ЗаявкаНаБронированиеДопУслуги.Услуга");
Запрос.УстановитьПараметр("Заявка", Заявка); 

ТЗ_Услуги = Запрос.Выполнить().Выгрузить();

Если ТЗ_Услуги.Количество() > 0 Тогда
	ш =1;
КонецЕсли;	

ТЗ_УслугиИтого = ТЗ_Услуги.Скопировать();
ТЗ_УслугиИтого.Колонки.Добавить("УслугаРодитель");
Для Каждого Строка Из ТЗ_УслугиИтого Цикл 
	Результат = Справочники.ДопУслуги.ПустаяСсылка();
	Ссылка = Строка.Услуга; 
	ОбщийФункционалСервер.ВерхняяПапка(Ссылка, Результат);			
	
	Строка.УслугаРодитель = Результат;	
КонецЦикла;	
ТЗ_УслугиИтого.Свернуть("УслугаРодитель", "Сумма");

Для Каждого СтрокаРодительУслуги Из ТЗ_РодительУслуги Цикл
	ЕстьСтрока = Ложь;
	Для Каждого СтрокаУслугиИтого Из ТЗ_УслугиИтого Цикл
		Если СтрокаУслугиИтого.УслугаРодитель = СтрокаРодительУслуги.Папка Тогда ЕстьСтрока = Истина; Прервать; КонецЕсли;
	КонецЦикла;
	
	Область_П = Макет.ПолучитьОбласть(ИмяОбласти + "|КолонкаУслуги");
	//Область_П = Область;
	Если ЕстьСтрока Тогда
		Если СтрокаУслугиИтого.Сумма <> 0 Тогда
			Область_П.Параметры.СуммаУслуги = СтрокаУслугиИтого.Сумма;
		КонецЕсли;	
	КонецЕсли;
	
	ВыведеннаяОбласть = ПолеОтчета.Присоединить(Область_П, 1);
КонецЦикла;

Если ИтогиДень <> Неопределено Тогда
	Для Каждого СтрокаУслугиДеньИтого Из ИтогиДень.УслугиДеньИтоги Цикл 
		ЕстьСтрока = Ложь;
		Для Каждого СтрокаУслугиИтого Из ТЗ_УслугиИтого Цикл
			Если СтрокаУслугиИтого.УслугаРодитель = СтрокаУслугиДеньИтого.УслугаРодитель Тогда ЕстьСтрока = Истина; Прервать; КонецЕсли;
		КонецЦикла;
		
		Если ЕстьСтрока Тогда 
			Если СтрокаУслугиИтого.Сумма <> 0 Тогда
				СтрокаУслугиДеньИтого.СуммаУслуги = СтрокаУслугиДеньИтого.СуммаУслуги + СтрокаУслугиИтого.Сумма;
			КонецЕсли;	
		КонецЕсли;	
	КонецЦикла;
КонецЕсли;

Возврат ВыведеннаяОбласть;
КонецФункции

Процедура ДокументОплатыОбластьЗаполнить(СтрокаОплаты, Область, ИтогиДень)
Область.Параметры.ТипДокументаОплаты = СтрокаОплаты.ТипДокументаОплаты;
Область.Параметры.НомерДокументаОплаты = СтрокаОплаты.НомерДокументаОплаты;
//Область.Параметры.ДатаДокументаОплаты = Формат(СтрокаОплаты.ДатаДокументаОплаты, "ДФ=dd.MM.yy");
Область.Параметры.ДатаДокументаОплаты = СтрокаОплаты.ДатаДокументаОплаты;

Область.Параметры.СуммаДокументаОплаты = СтрокаОплаты.СуммаДокументаОплаты;
Область.Параметры.СуммаДокументаОплаты_кк = СтрокаОплаты.СуммаДокументаОплатыКарта;
Область.Параметры.СуммаДокументаОплаты_Нал = СтрокаОплаты.СуммаДокументаОплатыНаличные;

Область.Параметры.СуммаВозвратаДокументаОплаты = СтрокаОплаты.СуммаВозвратаДокументаОплаты;
Область.Параметры.СуммаВозвратаДокументаОплаты_кк = СтрокаОплаты.СуммаВозвратаДокументаОплатыКарта;
Область.Параметры.СуммаВозвратаДокументаОплаты_Нал = СтрокаОплаты.СуммаВозвратаДокументаОплатыНаличные;

Область.Параметры.ОстатокДокументаОплаты = СтрокаОплаты.ОстатокДокументаОплаты;

//Область.Параметры.Оплатил = ОплатилНаименование(СтрокаОплаты);
Область.Параметры.Оплатил = ОтчетыСервер.ОплатилНаименование(СтрокаОплаты);
Если ТипЗнч(СтрокаОплаты.ДокументОплаты) <> Тип("УникальныйИдентификатор") Тогда
	Оплатил = СтрокаОплаты.ДокументОплаты.ОтКого;
	Если КлиентыСервер.ЭтоЮрЛицо(Оплатил) Тогда
		Область.Параметры.ОплатилИНН = Оплатил.ИНН;
	КонецЕсли;
КонецЕсли;

Если ИтогиДень <> Неопределено Тогда
	ИтогиДень.СуммаДокументаОплаты = ИтогиДень.СуммаДокументаОплаты + СтрокаОплаты.СуммаДокументаОплаты;
	ИтогиДень.СуммаДокументаОплаты_кк = ИтогиДень.СуммаДокументаОплаты_кк + СтрокаОплаты.СуммаДокументаОплатыКарта;
	ИтогиДень.СуммаДокументаОплаты_Нал = ИтогиДень.СуммаДокументаОплаты_Нал + СтрокаОплаты.СуммаДокументаОплатыНаличные;

	ИтогиДень.СуммаВозвратаДокументаОплаты = ИтогиДень.СуммаВозвратаДокументаОплаты + СтрокаОплаты.СуммаВозвратаДокументаОплаты;
	ИтогиДень.СуммаВозвратаДокументаОплаты_кк = ИтогиДень.СуммаВозвратаДокументаОплаты_кк + СтрокаОплаты.СуммаВозвратаДокументаОплатыКарта;
	ИтогиДень.СуммаВозвратаДокументаОплаты_Нал = ИтогиДень.СуммаВозвратаДокументаОплаты_Нал + СтрокаОплаты.СуммаВозвратаДокументаОплатыНаличные;
	
	ИтогиДень.ОстатокДокументаОплаты = ИтогиДень.ОстатокДокументаОплаты + СтрокаОплаты.ОстатокДокументаОплаты;
КонецЕсли;
КонецПроцедуры
