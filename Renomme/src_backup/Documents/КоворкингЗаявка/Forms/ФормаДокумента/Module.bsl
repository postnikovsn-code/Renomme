&НаСервере
Процедура ОбновитьСчета() 
Счета.Параметры.УстановитьЗначениеПараметра("КоворкингЗаявка", Объект.Ссылка);
Элементы.Счета.Обновить();	

Если ЗначениеЗаполнено(ТекущийСчет) Тогда 
	Элементы.Счета.ТекущаяСтрока = ТекущийСчет;
КонецЕсли;	
КонецПроцедуры

&НаКлиенте
Процедура СчетаПередНачаломДобавления_НеНужно(Элемент, Отказ, Копирование, Родитель, Группа, Параметр)
Отказ = Истина;
КонецПроцедуры

&НаКлиенте
Процедура СчетаПриАктивизацииСтроки(Элемент)
ТД = Элементы.Счета.ТекущиеДанные;
Если ТД = Неопределено Тогда
	Оплаты.Параметры.УстановитьЗначениеПараметра("КоворкингСчет", Неопределено);
	
	Возврат;
КонецЕсли;
	
Оплаты.Параметры.УстановитьЗначениеПараметра("КоворкингСчет", ТД.Ссылка);  
КонецПроцедуры

// + Добавление Счета
&НаКлиенте
Асинх Процедура ДобавитьСчет(Команда)
Если НЕ ЭтаФорма.Записать(Новый Структура("РежимЗаписи", РежимЗаписиДокумента.Проведение)) Тогда Возврат; КонецЕсли;	

Если НЕ Объект.ПочасоваяОплата Тогда
	СледующийСчетДатаС = КоворкингСервер.СледующийСчетДатаС(Объект.Ссылка);

	Если СледующийСчетДатаС > Объект.ДатаПо Тогда
		Текст = "'Следующая 'Дата C' счета: " + Формат(СледующийСчетДатаС, "ДФ=dd.MM.yyyy")
			+ " БОЛЬШЕ 'Дата По' Заявки: " + Формат(Объект.ДатаПо, "ДФ=dd.MM.yyyy") + ".";
		ПоказатьПредупреждение(, Текст);
		
		Возврат;

		//Результат = Ждать ВопросАсинх("'Расчетная 'Дата C' счета: " + Формат(СледующийСчетДатаС, "ДФ=dd.MM.yyyy")
		//	+ " БОЛЬШЕ 'Дата По' Заявки: " + Формат(Объект.ДатаПо, "ДФ=dd.MM.yyyy") + "
		//	|
		//	|ПРОДОЛЖИТЬ ?"		
		//	, РежимДиалогаВопрос.ОКОтмена); 
		//Если Результат = КодВозвратаДиалога.Отмена Тогда Возврат; КонецЕсли;
	КонецЕсли;
КонецЕсли;

//ДобавитьСчетНаСервере();	
ОбъектДанные = Объект;
Оповещение = Новый ОписаниеОповещения("ЗакрытиеФормы_КоворкингСчета", ЭтаФорма);
КоворкингКлиент.ДобавитьСчет(ЭтаФорма, Оповещение, ОбъектДанные);

КонецПроцедуры

&НаКлиенте
Процедура ЗакрытиеФормы_КоворкингСчета(Результат, ДополнительныеПараметры) Экспорт
ОбновитьСчета();	
	
Конецпроцедуры
// - Добавление Счета


// + Удаление Счета
&НаКлиенте
Процедура СчетаПередУдалением(Элемент, Отказ)
ТС = Элементы.Счета.ТекущаяСтрока;	
ТД = Элементы.Счета.ДанныеСтроки(ТС);	
Счет = ТД.Ссылка;
	
Отказ = КоворкингКлиент.ПроверкаУдаленияСчета(Счет); 	
КонецПроцедуры
// - Удаление Счета

&НаКлиенте
Процедура СчетаВыбор_НеНужно(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
ТС = Элементы.Счета.ТекущаяСтрока;	
ТД = Элементы.Счета.ДанныеСтроки(ТС);	
Счет = ТД.Ссылка;

ПараметрыФормы = Новый Структура;
ПараметрыФормы.Вставить("Ключ", Счет);

ОткрытьФорму("Документ.КоворкингСчета.Форма.ФормаДокумента", ПараметрыФормы, ЭтаФорма
	,,,,, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
КонецПроцедуры

// Оплаты
&НаСервереБезКонтекста
Процедура ОплатыПриПолученииДанныхНаСервере(ИмяЭлемента, Настройки, Строки)
Для Каждого Строка Из Строки Цикл
	ДокументДолгОбъект = Строка.Значение.Данные.КоворкингСчет.ПолучитьОбъект();
	
	ОстатокКРаспределению = ОплатыОбщееСервер.ОплатаОстатокКРаспределению(Строка.Значение.Данные.ДокументОплаты
		, ДокументДолгОбъект);	
	Строка.Значение.Данные.СуммаОстатокДокументаОплаты = ОстатокКРаспределению;  
КонецЦикла;
КонецПроцедуры

&НаКлиенте
Процедура ОплатыВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
ТД = Элемент.ТекущиеДанные;

ОплатыОбщееКлиент.ОткрытьДокументОплаты(ЭтаФорма, ТД.ДокументОплаты, Истина, Неопределено);
КонецПроцедуры


