Функция ПроверкаСоседей(Номер,ДН,ДК) Экспорт
	ЗапросСоседей=Новый Запрос("ВЫБРАТЬ
	                           |	ЗанятостьНомеров.Регистратор
	                           |ИЗ
	                           |	РегистрСведений.ЗанятостьНомеров КАК ЗанятостьНомеров
	                           |ГДЕ
	                           |	ЗанятостьНомеров.ПериодРезерва МЕЖДУ &ДН И &ДК
	                           |	И ЗанятостьНомеров.Номер В(ВЫБРАТЬ
							   |	НомернойФондСоседи.СоседнийНомер
							   |ИЗ
							   |	Справочник.НомернойФонд.Соседи КАК НомернойФондСоседи
							   |ГДЕ
							   |	НомернойФондСоседи.Ссылка = &Ссылка)");	
	ЗапросСоседей.УстановитьПараметр("Ссылка",Номер);
	ЗапросСоседей.УстановитьПараметр("ДН",ДН);
	ЗапросСоседей.УстановитьПараметр("ДК",ДК);
	
	ТЗС=ЗапросСоседей.Выполнить().Выгрузить();
	
	Если ТЗС.Количество()>0 тогда
		Возврат Истина;
	иначе
		Возврат Ложь;
	конецесли;
	
							   
КонецФункции

// + Добавить СчетаДетальноДолги
Функция ДобавитьСчетаДетальноДолги(СчетаДетальноДолги, ИсходнаяСтрока, Услуга, СчетГУИД
			, РазделитьСчет, ЮрЛицо, ЕстьКлиент2, НеПервый) Экспорт
	
Если Услуга Тогда
	Если НЕ ИсходнаяСтрока.ВСчет Тогда Возврат Неопределено; КонецЕсли;  				
	
	Если РазделитьСчет И ЕстьКлиент2 Тогда 
		Если НЕ (ИсходнаяСтрока.НеПервый = НеПервый) Тогда Возврат Неопределено; КонецЕсли;
	КонецЕсли;
КонецЕсли;

НоваяСтрока = СчетаДетальноДолги.Добавить();
ЗаполнитьСтрокаДолги(НоваяСтрока, ИсходнаяСтрока, СчетГУИД, Услуга);

Если НЕ Услуга Тогда
	УстановитьЦенаСуммаСчетаДетальноДолгиДляРазделитьСчет(НоваяСтрока, РазделитьСчет, ЮрЛицо, ЕстьКлиент2, НеПервый);
КонецЕсли;

Возврат НоваяСтрока; 
КонецФункции

Процедура УстановитьЦенаСуммаСчетаДетальноДолгиДляРазделитьСчет(Строка, РазделитьСчет, ЮрЛицо, ЕстьКлиент2, НеПервый) Экспорт
Если РазделитьСчет Тогда
	//Если НЕ ЮрЛицо Тогда
		Если ЕстьКлиент2 Тогда
			Если НеПервый Тогда 
				Строка.Цена = (Строка.Цена - Строка.Цена / 2 - 0.001); 			
				Строка.СуммаДолг = (Строка.СуммаДолг - Строка.СуммаДолг / 2 - 0.001); 			
				Строка.СуммаКЗакрытию = (Строка.СуммаКЗакрытию - Строка.СуммаКЗакрытию / 2 - 0.001); 			
			Иначе
				Строка.Цена = Строка.Цена / 2 + 0.001;
				Строка.СуммаДолг = Строка.СуммаДолг / 2 + 0.001; 			
				Строка.СуммаКЗакрытию = Строка.СуммаКЗакрытию / 2 + 0.001; 			
			КонецЕсли;	
		КонецЕсли;	
	//КонецЕсли;	
КонецЕсли;
КонецПроцедуры

Процедура УстановитьЦенаСуммаСчетаДетальноДолгиДляРазделитьСчет_1(Строка, РазделитьСчет, ЮрЛицо, ЕстьКлиент2, НеПервый) Экспорт
