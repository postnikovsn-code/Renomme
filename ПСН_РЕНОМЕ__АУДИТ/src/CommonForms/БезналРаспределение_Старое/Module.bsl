&НаКлиенте
Процедура ВыпискаОплатыЗагрузить(Команда)
ВыпискаОплатыЗагрузитьНаСервере();
КонецПроцедуры

&НаСервере
Процедура ВыпискаОплатыЗагрузитьНаСервере()
ВыпискаКонтрагент_Предыдущий = Неопределено;
	
Запрос = Новый Запрос("ВЫБРАТЬ
                      |	ВыпискаБанка.Ссылка КАК ДокументОплаты,
                      |	ВыпискаБанка.ОтКого КАК Контрагент,
                      |	ВЫБОР
                      |		КОГДА ВыпискаБанка.ОтКого.ТипКлиента = ЗНАЧЕНИЕ(Перечисление.ТипыКлиентов.ЮрЛицо)
                      |			ТОГДА ВыпискаБанка.ОтКого.НаименованиеЮрЛица
                      |		ИНАЧЕ ВыпискаБанка.ОтКого.Наименование
                      |	КОНЕЦ КАК КонтрагентНаименование,
                      |	ВыпискаБанка.Сумма КАК СуммаОплаты,
                      |	ВыпискаБанка.ДатаОплаты КАК ДатаОплаты,
                      |	ВыпискаБанка.ТекстПлатежа КАК ТекстПлатежа,
                      |	ВыпискаБанка.Закрыт КАК Закрыт,
                      |	ВыпискаБанка.Сумма - ЕСТЬNULL(Возвраты.Сумма, 0) - ЕСТЬNULL(Долги.СуммаОплаты, 0) КАК ОстатокОплаты,
                      |	Возвраты.Сумма КАК СуммаВозврат,
                      |	ВыпискаБанка.ГУИДИсточникЗагрузка = """" КАК РучнойВвод
                      |ИЗ
                      |	Документ.ВыпискаБанка КАК ВыпискаБанка
                      |		ЛЕВОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
                      |			ВыпискаБанка.ВозвратДокумент КАК ВозвратДокумент,
                      |			СУММА(ВыпискаБанка.Сумма) КАК Сумма
                      |		ИЗ
                      |			Документ.ВыпискаБанка КАК ВыпискаБанка
                      |		ГДЕ
                      |			ВыпискаБанка.ПометкаУдаления = ЛОЖЬ
                      |		
                      |		СГРУППИРОВАТЬ ПО
                      |			ВыпискаБанка.ВозвратДокумент) КАК Возвраты
                      |		ПО ВыпискаБанка.Ссылка = Возвраты.ВозвратДокумент
                      |		ЛЕВОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
                      |			ВыпискаБанкаДолгиОплата.Ссылка КАК ДокументОплаты,
                      |			СУММА(ВыпискаБанкаДолгиОплата.Сумма) КАК СуммаОплаты
                      |		ИЗ
                      |			Документ.ВыпискаБанка.ДолгиОплата КАК ВыпискаБанкаДолгиОплата
                      |		ГДЕ
                      |			ВыпискаБанкаДолгиОплата.Ссылка.ПометкаУдаления = ЛОЖЬ
                      |		
                      |		СГРУППИРОВАТЬ ПО
                      |			ВыпискаБанкаДолгиОплата.Ссылка) КАК Долги
                      |		ПО ВыпискаБанка.Ссылка = Долги.ДокументОплаты
                      |ГДЕ
                      |	ВыпискаБанка.ПометкаУдаления = ЛОЖЬ
                      |	И ВыпискаБанка.Приход = ИСТИНА
                      |	И ВыпискаБанка.ДатаОплаты >= &ДатаНачалаУчета
                      |	И ВЫБОР
                      |			КОГДА &Контрагент = ЗНАЧЕНИЕ(Справочник.Клиенты.ПустаяСсылка)
                      |				ТОГДА ИСТИНА
                      |			ИНАЧЕ ВыпискаБанка.ОтКого = &Контрагент
                      |		КОНЕЦ
                      |	И ВЫБОР
                      |			КОГДА &ДатаОплатыС = ДАТАВРЕМЯ(1, 1, 1, 0, 0, 0)
                      |				ТОГДА ИСТИНА
                      |			ИНАЧЕ ВыпискаБанка.ДатаОплаты >= &ДатаОплатыС
                      |		КОНЕЦ
                      |	И ВЫБОР
                      |			КОГДА &ДатаОплатыПо = ДАТАВРЕМЯ(1, 1, 1, 0, 0, 0)
                      |				ТОГДА ИСТИНА
                      |			ИНАЧЕ ВыпискаБанка.ДатаОплаты <= &ДатаОплатыПо
                      |		КОНЕЦ
                      |	И ВЫБОР
                      |			КОГДА &ТолькоНеЗакрытые
                      |				ТОГДА ВыпискаБанка.Сумма - ЕСТЬNULL(Возвраты.Сумма, 0) - ЕСТЬNULL(Долги.СуммаОплаты, 0) > 0
                      |						И ВыпискаБанка.Закрыт = ЛОЖЬ
                      |			ИНАЧЕ ИСТИНА
                      |		КОНЕЦ
                      |
                      |УПОРЯДОЧИТЬ ПО
                      |	Контрагент,
                      |	ДатаОплаты,
                      |	ДокументОплаты");

Запрос.УстановитьПараметр("Контрагент", ВыпискаОплатыКонтрагентОтбор);
Запрос.УстановитьПараметр("ДатаОплатыС", ВыпискаДатаОплатыС);
Запрос.УстановитьПараметр("ДатаОплатыПо", ВыпискаДатаОплатыПо);
//Запрос.УстановитьПараметр("Все", ВыпискаОплатыВсе);
Запрос.УстановитьПараметр("ТолькоНеЗакрытые", ВыпискаОплатыТолькоНезакрытые);

Если НастройкиСервер.ЭтоЛайв() Тогда
	ДатаНачалаУчета = '20220401';
Иначе
	ДатаНачалаУчета = '00010101';
КонецЕсли;
Запрос.УстановитьПараметр("ДатаНачалаУчета", ДатаНачалаУчета);

ТЗ = Запрос.Выполнить().Выгрузить(); 
ВыпискаОплаты.Очистить();
Для Каждого Строка Из ТЗ Цикл
	НоваяСтрока = ВыпискаОплаты.Добавить();		
	ЗаполнитьЗначенияСвойств(НоваяСтрока, Строка);
	
	Если НЕ ЗначениеЗаполнено(Строка.КонтрагентНаименование) Тогда
		НоваяСтрока.КонтрагентНаименование = Строка.Контрагент.Наименование;	
	КонецЕсли;		
КонецЦикла;

ВыпискаОплаты.Сортировать("Контрагент, ДатаОплаты, ДокументОплаты");

Если ТЗ.Количество() = 0 Тогда 
	ВыпискаОплатыТекущаяСтрока = -1;
	ОбновитьСчетаСвязи();
КонецЕсли;

Если ВыпискаОплаты.Количество() = 0 Тогда
	ВыпискаОплатыДокументОплаты_Текущий = Неопределено;	
КонецЕсли;
КонецПроцедуры
