  <attributes>
    <name>Список</name>
    <id>1</id>
    <valueType>
      <types>DynamicList</types>
    </valueType>
    <view>
      <common>true</common>
    </view>
    <edit>
      <common>true</common>
    </edit>
    <main>true</main>
    <extInfo xsi:type="form:DynamicListExtInfo">
      <queryText>ВЫБРАТЬ
	ДокументГрупповыеСчета.Ссылка КАК Ссылка,
	ДокументГрупповыеСчета.ПометкаУдаления КАК ПометкаУдаления,
	ДокументГрупповыеСчета.Номер КАК Номер,
	ДокументГрупповыеСчета.Дата КАК Дата,
	ДокументГрупповыеСчета.ДатаОтчетаКомиссия КАК ДатаОтчетаКомиссия,
	ДокументГрупповыеСчета.Проведен КАК Проведен,
	ДокументГрупповыеСчета.СчетГУИД КАК СчетГУИД,
	ДокументГрупповыеСчета.НомерСчета КАК НомерСчета,
	ДокументГрупповыеСчета.ДатаСчета КАК ДатаСчета,
	ДокументГрупповыеСчета.ДатаДокумента КАК ДатаДокумента,
	ДокументГрупповыеСчета.Контрагент КАК Контрагент,
	ДокументГрупповыеСчета.СвернутьВСчете КАК СвернутьВСчете,
	ДокументГрупповыеСчета.Закрыто КАК Закрыто,
	ДокументГрупповыеСчета.ТипГрупповогоСчета КАК ТипГрупповогоСчета,
	ЗаявкаНаБронированиеСуммаДолг.СуммаДолг КАК СуммаДолг,
	ЗаявкаНаБронированиеСуммаРаспределено.СуммаОплаты КАК СуммаРаспределено
ИЗ
	Документ.ГрупповыеСчета КАК ДокументГрупповыеСчета
		ЛЕВОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
			ГрупповыеСчетаДокументыДолги.Ссылка КАК Ссылка,
			СУММА(ЗаявкаНаБронированиеСчетаДетальноДолги.СуммаДолг) КАК СуммаДолг
		ИЗ
			Документ.ГрупповыеСчета.ДокументыДолги КАК ГрупповыеСчетаДокументыДолги
				ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.ЗаявкаНаБронирование.СчетаДетальноДолги КАК ЗаявкаНаБронированиеСчетаДетальноДолги
				ПО ГрупповыеСчетаДокументыДолги.ДокументДолг = ЗаявкаНаБронированиеСчетаДетальноДолги.Ссылка
					И ГрупповыеСчетаДокументыДолги.СчетГУИД = ЗаявкаНаБронированиеСчетаДетальноДолги.СчетГУИД
		
		СГРУППИРОВАТЬ ПО
			ГрупповыеСчетаДокументыДолги.Ссылка) КАК ЗаявкаНаБронированиеСуммаДолг
		ПО ДокументГрупповыеСчета.Ссылка = ЗаявкаНаБронированиеСуммаДолг.Ссылка
		ЛЕВОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
			ГрупповыеСчетаДокументыДолги.Ссылка КАК Ссылка,
			СУММА(ЗаявкаНаБронированиеРаспределениеОплатДолги.СуммаОплаты) КАК СуммаОплаты
		ИЗ
			Документ.ГрупповыеСчета.ДокументыДолги КАК ГрупповыеСчетаДокументыДолги
				ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.ЗаявкаНаБронирование.РаспределениеОплатДолги КАК ЗаявкаНаБронированиеРаспределениеОплатДолги
				ПО ГрупповыеСчетаДокументыДолги.ДокументДолг = ЗаявкаНаБронированиеРаспределениеОплатДолги.Ссылка
					И ГрупповыеСчетаДокументыДолги.СчетГУИД = ЗаявкаНаБронированиеРаспределениеОплатДолги.СчетГУИД
		
		СГРУППИРОВАТЬ ПО
			ГрупповыеСчетаДокументыДолги.Ссылка) КАК ЗаявкаНаБронированиеСуммаРаспределено
		ПО ДокументГрупповыеСчета.Ссылка = ЗаявкаНаБронированиеСуммаРаспределено.Ссылка</queryText>
      <mainTable>Document.ГрупповыеСчета</mainTable>
      <dynamicDataRead>true</dynamicDataRead>
      <autoFillAvailableFields>true</autoFillAvailableFields>
      <customQuery>true</customQuery>
      <autoSaveUserSettings>true</autoSaveUserSettings>
      <getInvisibleFieldPresentations>true</getInvisibleFieldPresentations>
    </extInfo>
  </attributes>
