//
&НаКлиенте
Процедура ПередЗаписью(Отказ, ПараметрыЗаписи)
ТекстСообщения = ПроверкаЗаполненияТекстСообщенияПередЗаписьюНаСервере();
Если ТекстСообщения <> "" Тогда
	ТекстСообщения = ТекстСообщения + " ЗАПИСЬ ОТМЕНЯЕТСЯ.";
	Сообщить(ТекстСообщения); 
	
	Отказ = Истина;
	Возврат; 
КонецЕсли;

//Если ПараметрыЗаписи.РежимЗаписи <> РежимЗаписиДокумента.ОтменаПроведения Тогда
Если ПараметрыЗаписи.РежимЗаписи = РежимЗаписиДокумента.Проведение Тогда
	ДанныеОбъект = Объект;
	Результат = КоворкингСервер.ПроверкаЗанятостиКоворкинг(ДанныеОбъект);
	Если Результат.Ошибка Тогда
		ТекстПредупреждения = "";
		Первый = Истина;
		Для Каждого Строка Из Результат.Сообщение Цикл
			Если Первый Тогда Первый = Ложь; Продолжить; КонецЕсли; 
			ТекстПредупреждения = ТекстПредупреждения + Символы.ПС + Строка;
		КонецЦикла;
		ТекстПредупреждения = ТекстПредупреждения + Символы.ПС + Символы.ПС; 
		ТекстПредупреждения = ТекстПредупреждения + "ЗАПИСЬ ОТМЕНЯЕТСЯ." + Символы.ПС + Символы.ПС;
		Если УдалениеОплатыПроведенногДокумента Тогда
			ТекстПредупреждения = ТекстПредупреждения + "Попытка удаления оплаты блокированного счета
				|ДЛЯ УДАЛЕНИЯ ОПЛАТЫ ОТМЕНИТЕ ПРОВЕДЕНИЕ ДОКУМЕНТА";
		КонецЕсли;
		ПоказатьПредупреждение(,ТекстПредупреждения);
		
		ТекстСообщения = "";
		Для Каждого Строка Из Результат.Сообщение Цикл
			ТекстСообщения = ТекстСообщения + Строка + " ";
		КонецЦикла;	
		ТекстСообщения = ТекстСообщения + "ЗАПИСЬ ОТМЕНЯЕТСЯ.";
		Если УдалениеОплатыПроведенногДокумента Тогда
			ТекстСообщения = ТекстСообщения + "Попытка удаления оплаты блокированного счета. ДЛЯ УДАЛЕНИЯ ОПЛАТЫ ОТМЕНИТЕ ПРОВЕДЕНИЕ ДОКУМЕНТА.";
		КонецЕсли;		
		Сообщить(ТекстСообщения);
		
		УдалениеОплатыПроведенногДокумента = Ложь;
		Отказ = Истина; Возврат;	
	КонецЕсли;
КонецЕсли;

Если ОбновитьОплаты Тогда
	ОбновитьОплатыКоворкингНаСервере();
	
	ОбновитьОплаты = Ложь;
КонецЕсли;	
КонецПроцедуры

&НаКлиенте
Процедура ОбновитьОплатыКоворкинг(Команда)
ОбновитьОплатыКоворкингНаСервере();
КонецПроцедуры

&НаСервере
