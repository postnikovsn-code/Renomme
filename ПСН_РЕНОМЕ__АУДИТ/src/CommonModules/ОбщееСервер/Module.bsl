		//Ком = Новый COMОбъект("V83.COMConnector");	
		//База = Ком.Connect(СтрокаПодключения);
		
		База =СлужебныеСервер.ConnectБаза_BONUS();
		
		Рез=База.БаллыИПризыПоКлиенту(Клиент.Код);
