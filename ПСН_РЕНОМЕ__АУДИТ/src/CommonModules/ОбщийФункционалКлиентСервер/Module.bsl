Функция ПолучитьЧисло(Строка) Экспорт
Попытка 
	Число = Число(Строка);		
Исключение
	Число = 0;
КонецПопытки;

Возврат Число;
КонецФункции

Функция ПолучитьДату(Строка) Экспорт
Попытка
	Строка_П = СтрЗаменить(Строка, "-", "");
	Строка_П = СтрЗаменить(Строка_П, ":", "");
	Строка_П = СтрЗаменить(Строка_П, " ", "");
	
	Дата = Дата(Строка_П);		
Исключение
	Дата = '00010101';
КонецПопытки;

Возврат Дата;
КонецФункции

Функция УбратьНезначащиеНули(Значение) Экспорт
Строка = Значение;

Индекс = 1;
Пока Индекс < СтрДлина(Строка) Цикл
	Если Сред(Строка, Индекс, 1) <> "0" Тогда Прервать; КонецЕсли;
	
	Индекс = Индекс + 1;
КонецЦикла;

Результат = Сред(Строка, Индекс);
Возврат Результат;
КонецФункции	

Функция ДеньНеделиСтрока(НомерДняНедели) Экспорт
Результат = "";

Если НомерДняНедели = 1 Тогда
	Результат = НСтр("ru='Понедельник'");
ИначеЕсли НомерДняНедели = 2 Тогда
	Результат = НСтр("ru='Вторник'");
ИначеЕсли НомерДняНедели = 3 Тогда
	Результат = НСтр("ru='Среда'");
ИначеЕсли НомерДняНедели = 4 Тогда
	Результат = НСтр("ru='Четверг'");
ИначеЕсли НомерДняНедели = 5 Тогда
	Результат = НСтр("ru='Пятница'");
ИначеЕсли НомерДняНедели = 6 Тогда
	Результат = НСтр("ru='Суббота'");
ИначеЕсли НомерДняНедели = 7 Тогда
	Результат = НСтр("ru='Воскресенье'");
КонецЕсли;

Возврат Результат;

КонецФункции