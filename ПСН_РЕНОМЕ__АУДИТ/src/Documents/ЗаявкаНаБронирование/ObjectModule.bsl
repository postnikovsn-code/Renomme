//
Функция ПолучитьПроживаниеИтого(Контрагент, НеПервый) 
ЮрЛицо = КлиентыСервер.ЭтоЮрЛицо(Контрагент);
ЕстьКлиент2 = ЗначениеЗаполнено(Клиент2);

СуммаПроживание = 0;
Строка = ОбщийФункционалСервер.СтруктураИзТабличнаяЧастьДокумента("ЗаявкаНаБронирование", "Проживание");
Для Каждого СтрокаИсходный Из Проживание Цикл
	ЗаполнитьЗначенияСвойств(Строка, СтрокаИсходный); 
	ЗаявкаСервер.УстановитьЦенаСуммаДляРазделитьСчет(Строка, РазделитьСчет, ЮрЛицо, ЕстьКлиент2, НеПервый);     
	
	СуммаПроживание = СуммаПроживание + Строка.Сумма;	
КонецЦикла;	

Возврат СуммаПроживание;
КонецФункции	

Функция ПолучитьУслугиИтого(НеПервый)  
СуммаУслуги = 0;
Для Каждого Строка Из ДопУслуги Цикл
	Если НЕ Строка.ВСчет Тогда Продолжить; КонецЕсли;

	Если РазделитьСчет И ЗначениеЗаполнено(Клиент2) Тогда 
		Если НЕ (Строка.НеПервый = НеПервый) Тогда Продолжить; КонецЕсли;
	КонецЕсли;
	
	СуммаУслуги = СуммаУслуги + Строка.Количество * Строка.Цена;
КонецЦикла;	
Возврат СуммаУслуги;
КонецФункции	

Процедура ДобавитьДвиженияДолг(Контрагент, Сумма)
Если Сумма= 0 Тогда Возврат; КонецЕсли;
	
Движение = Движения.Долги.Добавить();

Движение.Период = Дата;

Движение.ВидДвижения = ВидДвиженияНакопления.Приход;

Движение.ДокументДолг = Ссылка;
Движение.Контрагент = Контрагент;

Движение.Сумма = Сумма;
КонецПроцедуры	
