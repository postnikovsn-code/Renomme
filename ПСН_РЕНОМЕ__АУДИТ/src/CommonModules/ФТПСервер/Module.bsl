Функция ЗаписатьФТПФайл(Источник, Получатель, АдресФТП, ИмяПользователя, Пароль) Экспорт
Результат = Новый Структура("Ошибка, КодОшибки, ОписаниеОшибки", Ложь, 0, "");	

Ответ = ПодключитьсяКFTPСерверу(АдресФТП, ИмяПользователя, Пароль);
Если Ответ.Ошибка Тогда 
	Результат.Ошибка = Истина;
	Результат.КодОшибки = Ответ.КодОшибки;
	Результат.ОписаниеОшибки = Ответ.ОписаниеОшибки;
	
	Возврат Результат; 
КонецЕсли;

Соединение = Ответ.Соединение;
Попытка	
	ТекущийКаталогФТП = ТекущийКаталогФТП();
	Соединение.УстановитьТекущийКаталог(ТекущийКаталогФТП);
Исключение
	Результат.Ошибка = Истина;
	Результат.КодОшибки = -2;
	Результат.ОписаниеОшибки = "Ошибка установки текущего каталога: " + ОписаниеОшибки();
	
	Возврат Результат; 
КонецПопытки;

Попытка	
	Соединение.Записать(
	        Источник, // что записываем
	        Получатель);  
Исключение
	Результат.Ошибка = Истина;
	Результат.КодОшибки = 10;
	Результат.ОписаниеОшибки = "Ошибка записи файла: " + ОписаниеОшибки();
	
	Возврат Результат; 
КонецПопытки;

Возврат Результат;
КонецФункции
