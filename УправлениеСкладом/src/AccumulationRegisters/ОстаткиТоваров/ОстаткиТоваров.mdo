<?xml version="1.0" encoding="UTF-8"?>
<mdclass:AccumulationRegister xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:core="http://g5.1c.ru/v8/dt/mcore" xmlns:mdclass="http://g5.1c.ru/v8/dt/metadata/mdclass" uuid="8e2c6b7d-3f9a-4d1b-e26f-0b3a8c2d7f56">
	<name>ОстаткиТоваров</name>
	<synonym>
		<key>ru</key>
		<value>Остатки товаров</value>
	</synonym>
	<useStandardCommands>true</useStandardCommands>
	<registerType>Balance</registerType>
	<dimensions>
		<name>Склад</name>
		<synonym>
			<key>ru</key>
			<value>Склад</value>
		</synonym>
		<type>
			<types>CatalogRef.Склады</types>
		</type>
		<minValue xsi:type="core:UndefinedValue"/>
		<maxValue xsi:type="core:UndefinedValue"/>
	</dimensions>
	<dimensions>
		<name>Номенклатура</name>
		<synonym>
			<key>ru</key>
			<value>Номенклатура</value>
		</synonym>
		<type>
			<types>CatalogRef.Номенклатура</types>
		</type>
		<minValue xsi:type="core:UndefinedValue"/>
		<maxValue xsi:type="core:UndefinedValue"/>
	</dimensions>
	<resources>
		<name>Количество</name>
		<synonym>
			<key>ru</key>
			<value>Количество</value>
		</synonym>
		<type>
			<types>Number</types>
			<numberQualifiers>
				<precision>15</precision>
				<scale>3</scale>
				<nonNegative>true</nonNegative>
			</numberQualifiers>
		</type>
		<minValue xsi:type="core:UndefinedValue"/>
		<maxValue xsi:type="core:UndefinedValue"/>
	</resources>
	<resources>
		<name>Сумма</name>
		<synonym>
			<key>ru</key>
			<value>Сумма</value>
		</synonym>
		<type>
			<types>Number</types>
			<numberQualifiers>
				<precision>15</precision>
				<scale>2</scale>
			</numberQualifiers>
		</type>
		<minValue xsi:type="core:UndefinedValue"/>
		<maxValue xsi:type="core:UndefinedValue"/>
	</resources>
</mdclass:AccumulationRegister>
