&НаКлиенте
Процедура ВыбратьДокументОплаты(Команда)
ПозицииЧекаККМ.Очистить();
		
ПараметрыФормы = Новый Структура(); 

ПараметрыФормы.Вставить("КонтрагентыОтбор", КонтрагентыОтбор); 
ПараметрыФормы.Вставить("ДокументДолг", ДокументДолг); 

Оповещение = Новый ОписаниеОповещения("ЗавершениеФормы_КассовыйДокументФормаВыбораВозврат", ЭтаФорма);
ОткрытьФорму("ОбщаяФорма.ЧекВозвратВыборДокументОплаты", ПараметрыФормы, ЭтаФорма
	,,,, Оповещение, РежимОткрытияОкнаФормы.БлокироватьВесьИнтерфейс);
КонецПроцедуры

&НаКлиенте
Процедура ЗавершениеФормы_КассовыйДокументФормаВыбораВозврат(Результат, ДополнительныеПараметры) Экспорт
Если Результат = Неопределено Тогда	Возврат; КонецЕсли;

ДокументОплаты = Результат.ДокументОплаты;

ЗаполнениеДанныхФормы(ДокументОплаты);
КонецПроцедуры

&НаКлиенте
Процедура ЗаполнениеДанныхФормы(ДокументОплаты) Экспорт
ЗаполнениеДанныхФормыСервер(ДокументОплаты);

Если СуммаОстатокКарта > 0  тогда
	
	Если СуммаОстатокНаличные > 0 Тогда 
		Текст = "ВНИМАНИЕ! Была смешанная оплата. Остаток по карте на сумму: " + СуммаОстатокКарта + " руб." 
	   		+ " Остаток наличными: " + СуммаОстатокНаличные + " руб.";
	Иначе
		Текст = "ВНИМАНИЕ! Была оплата по кредитной карте. Остаток по карте на сумму: " + СуммаОстатокКарта + " руб.";
	КонецЕсли;
	
	ПоказатьПредупреждение(, Текст);
	Сообщить(Текст);
КонецЕсли;
КонецПроцедуры

&НаСервере
Процедура ЗаполнениеДанныхФормыСервер(ДокументОплаты) Экспорт
ЗапросТекст = ОплатыОбщееСервер.ЗапросТекстВозврат();	
Запрос = Новый Запрос(ЗапросТекст);
Запрос.УстановитьПараметр("КонтрагентыОтбор", КонтрагентыОтбор);
Запрос.УстановитьПараметр("ДокументДолг", ДокументДолг);
Запрос.УстановитьПараметр("ДокументОплаты", ДокументОплаты);
//Запрос.УстановитьПараметр("Все", Истина);

ТЗ = Запрос.Выполнить().Выгрузить();
Если ТЗ.Количество() = 0 Тогда Возврат; КонецЕСли;

Результат = ТЗ[0];
//ДокументОплаты = Результат.ДокументОплаты;

СуммаДокументаОплаты = Результат.СуммаДокументаОплаты;
СуммаДокументаОплатыКарта = Результат.СуммаКарта;
СуммаДокументаОплатыНаличные = Результат.СуммаНаличные;

СуммаПредыдущихВозвратов = Результат.СуммаВозврат;
СуммаПредыдущихВозвратовКарта = Результат.СуммаВозвратКарта;
СуммаПредыдущихВозвратовНаличные = Результат.СуммаВозвратНаличные;

СуммаОстаток = Результат.ОстатокДокументаОплаты;
СуммаОстатокКарта = Результат.ОстатокКарта;
СуммаОстатокНаличные = Результат.ОстатокНаличные;

//СуммаОстатокОплаты = Результат.СуммаОстатокОплаты;
СуммаОплачено = Результат.СуммаОплачено;

КонецПроцедуры
//

////
&НаСервереБезКонтекста
Функция КлиентНаименование_НеИспользуется(ДокументДолг) 
Если ТипЗнч(ДокументДолг) = Тип("ДокументСсылка.ЗаявкаНаБронирование") Тогда
	КлиентНаименование = ДокументДолг.Клиент.Наименование;	
Иначе 
	КлиентНаименование = ДокументДолг.Контрагент.Наименование;	
КонецЕсли;		
Возврат КлиентНаименование	
КонецФункции 
//

//
&НаКлиенте
Процедура ВозвратПолныйЧастичныйПриИзменении(Элемент)
Если НЕ ЗначениеЗаполнено(ДокументОплаты)  
Тогда ВозвратПолныйЧастичный = ""; Возврат; КонецЕсли;	
	
Если ВозвратПолныйЧастичный = "Полный" Тогда	
	СуммаВозврата = СуммаОстаток; 	
	СуммаВозвратаКарта = СуммаОстатокКарта; 	
	СуммаВозвратаНаличные = СуммаОстатокНаличные; 
	
	Элементы.СуммаВозврата.ТолькоПросмотр = Истина; 	
	Элементы.СуммаВозвратаКарта.ТолькоПросмотр = Истина; 	
	Элементы.СуммаВозвратаНаличные.ТолькоПросмотр = Истина; 
Иначе
	СуммаВозврата = 0; 	
	СуммаВозвратаКарта = 0; 	
	СуммаВозвратаНаличные = 0; 
	
	Элементы.СуммаВозврата.ТолькоПросмотр = Ложь; 	
	Элементы.СуммаВозвратаКарта.ТолькоПросмотр = (СуммаОстатокКарта <= 0); 	
	Элементы.СуммаВозвратаНаличные.ТолькоПросмотр = (СуммаОстатокНаличные <=0);	
КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура СуммаВозвратаПриИзменении(Элемент)
Если СуммаВозврата > СуммаОстаток Тогда
	Показатьпредупреждение(,"Сумма возврата > суммы остатка по карте");
	
	СуммаВозврата = 0;
	СуммаВозвратаКарта = 0;
	СуммаВозвратаНаличные = 0;
	Возврат;	
КонецЕсли;

Если ЗначениеЗаполнено(ДокументДолг) Тогда
	Если СуммаВозврата > СуммаОплачено Тогда
		Показатьпредупреждение(,"Сумма возврата > суммы оплачено");
		
		СуммаВозвратаКарта = 0;
		Возврат;	
	КонецЕсли;
КонецЕсли;

Если СуммаОстатокКарта = 0 Тогда СуммаВозвратаНаличные = СуммаВозврата; КонецЕсли; 
Если СуммаОстатокНаличные = 0 Тогда СуммаВозвратаКарта = СуммаВозврата; КонецЕсли; 

КонецПроцедуры

&НаКлиенте
Процедура СуммаВозвратаКартаПриИзменении(Элемент)
Если СуммаОстатокКарта < СуммаВозвратаКарта Тогда
	Показатьпредупреждение(,"Сумма возврата по карте > остатка по карте");
	
	СуммаВозвратаКарта = 0;
	Возврат;	
КонецЕсли;
	
СуммаВозвратаНаличные = СуммаВозврата - СуммаВозвратаКарта; 
КонецПроцедуры

&НаКлиенте
Процедура СуммаВозвратаНаличныеПриИзменении(Элемент)
Если СуммаОстатокНаличные < СуммаВозвратаНаличные Тогда
	Показатьпредупреждение(,"Сумма возврата наличными > остатка наличными");
	
	СуммаВозвратаНаличные = 0;
	Возврат;	
КонецЕсли;	
СуммаВозвратаКарта = СуммаВозврата - СуммаВозвратаНаличные; 	
КонецПроцедуры
//

//// + Кассовый Чек
&НаКлиенте
Процедура КассовыйЧек(Команда)
Если ПроверкаДанных() Тогда Возврат; КонецЕсли;

Вопрос_БудетОтбитВозвратНаСумму();
КонецПроцедуры

&НаКлиенте
Функция ПроверкаДанных()
Если ВозвратПолныйЧастичный <> "Полный" И ВозвратПолныйЧастичный <> "Частичный"	Тогда
	ПоказатьПредупреждение(, "Выберите возврат полный / частичный ...");  
			
	Возврат Истина;	
КонецЕсли;	
	
ТекстПредупреждения_П = "";
	
Если СуммаВозврата <= 0 Тогда
	ТекстПредупреждения_П = "Сумма возврата меньше либо равна 0";
КонецЕсли;

Если СуммаВозвратаКарта + СуммаВозвратаНаличные <> СуммаВозврата Тогда
	ТекстПредупреждения_П = ТекстПредупреждения_П + "Сумма возврата <> Сумма возврата по карте + Сумма возврата наличные";
КонецЕсли;

Если ТекстПредупреждения_П <> "" Тогда
	ПоказатьПредупреждение(, ТекстПредупреждения_П);
	
	Возврат Истина;     
КонецЕсли;

Возврат Ложь;     
КонецФункции

&НаКлиенте
Процедура Вопрос_БудетОтбитВозвратНаСумму() 
Оповещение = Новый ОписаниеОповещения("ЗавершениеВопроса_БудетОтбитВозвратНаСумму", ЭтаФорма);
Текст = "Будет отбит возврат на сумму " + Строка(СуммаВозврата)
		+ Символы.ПС + "Карта; " + СуммаВозвратаКарта + ", наличные: " + СуммаВозвратаНаличные 
		+ Символы.ПС + Символы.ПС + "ПРОДОЛЖИТЬ ?";
ПоказатьВопрос(Оповещение, Текст, РежимДиалогаВопрос.ОКОтмена);  
КонецПроцедуры

&НаКлиенте
Процедура ЗавершениеВопроса_БудетОтбитВозвратНаСумму(Результат, ДополнительныеПараметры) Экспорт
Если Результат = КодВозвратаДиалога.ОК Тогда
	
	Если СуммаВозвратаКарта > 0 ИЛИ СуммаВозвратаНаличные > 0 Тогда
		ДопПараметры = Новый Структура;
		ДопПараметры.Вставить("ДокОсн", ДокументОплаты);
		
		ВыполнитьОперацию_ФУ(ДопПараметры);	
	иначе
		ПоказатьПредупреждение(, "Сумма возврата = 0." + Символы.ПС + Символы.ПС + "ЧЕК ОТМЕНЁН");
		
		Возврат;
	конецесли;
	
иначе
	Возврат;
конецесли;
Конецпроцедуры


&НаКлиенте
Процедура ВыполнитьОперацию_ФУ(ДопПараметры)
	ПоддерживаемыеТипыВО = Новый Массив();
	//ПоддерживаемыеТипыВО.Добавить("ФискальныйРегистратор");
	//ПоддерживаемыеТипыВО.Добавить("ПринтерЧеков");
	ПоддерживаемыеТипыВО.Добавить("ККТ");
	
	ДопПараметры.Вставить("ЭтоКоворкинг", ЭтоКоворкинг); 
	ОписаниеОповещения = Новый ОписаниеОповещения("ВыполнитьОперациюВыбораУстройства_ФУ", ЭтотОбъект, ДопПараметры); 
	МенеджерОборудованияКлиент.ВыбратьУстройство(ОписаниеОповещения, ПоддерживаемыеТипыВО,
		НСтр("ru='Выберите фискальное устройство'"), 
		НСтр("ru='Фискальное устройство не подключено.'"), 
		НСтр("ru='Фискальное устройство не выбрано.'"));
КонецПроцедуры

&НаКлиенте
Процедура ВыполнитьОперациюВыбораУстройства_ФУ(РезультатВыбора, ДополнительныеПараметры) Экспорт
	
Если НЕ РезультатВыбора.Результат Тогда
	ТекстПредупреждения = ТекстПредупреждения + "Ошибка выбора ККМ."; 
	ТекстСообщения = ТекстСообщения + "Ошибка выбора ККМ: " + РезультатВыбора.ОписаниеОшибки; 
	
	ОшибкаОперации = Истина;
	
	ЗавершитьОтбитиеВозвратЧека(Неопределено);
	
	Возврат;
КонецЕсли;   

ДополнительныеПараметры.Вставить("РезультатВыбора", РезультатВыбора); 

Если СуммаВозвратаНаличные > 0 Тогда
	ЭтоТекущаяСменаДокументОплаты = ЭтоТекущаяСменаДокументОплаты(РезультатВыбора.ИдентификаторУстройства);
	Если ЭтоТекущаяСменаДокументОплаты = -100 Тогда
		ТекстПредупреждения = ТекстПредупреждения + "При пробитии чек произошла ошибка. Кассовая смена не открыта или истекла. *"; 
		ТекстСообщения = ТекстСообщения + "При пробитии чек произошла ошибка. Кассовая смена не открыта или истекла. *" + РезультатВыбора.ОписаниеОшибки; 
		
		ОшибкаОперации = Истина;
		
		ЗавершитьОтбитиеВозвратЧека(Неопределено);
		
		Возврат;
	КонецЕсли;	
	
	Если НЕ ЭтоТекущаяСменаДокументОплаты Тогда
		 ИнкассацияНаФискальномУстройстве(ДополнительныеПараметры);

		 Возврат;
	КонецЕсли;	
КонецЕсли;	

ВыполнитьОперациюВыводЧека_ФУ(ДополнительныеПараметры);
КонецПроцедуры

&НаСервере
Функция ЭтоТекущаяСменаДокументОплаты(ИдентификаторУстройства)
	Запрос = Новый Запрос("ВЫБРАТЬ
	                      |	КассоваяСмена.Ссылка КАК Ссылка,
	                      |	КассоваяСмена.НомерСменыККТ КАК НомерСменыККТ
	                      |ИЗ
	                      |	Документ.КассоваяСмена КАК КассоваяСмена
	                      |ГДЕ
	                      |	КассоваяСмена.Статус = ЗНАЧЕНИЕ(Перечисление.СтатусыКассовойСмены.Открыта)
	                      |	И КассоваяСмена.ФискальноеУстройство = &ФискальноеУстройство
	                      |
	                      |УПОРЯДОЧИТЬ ПО
	                      |	КассоваяСмена.НачалоКассовойСмены УБЫВ");
	
	Запрос.УстановитьПараметр("ФискальноеУстройство", ИдентификаторУстройства);  
	ТЗ = Запрос.Выполнить().Выгрузить();
	Если ТЗ.Количество() = 0 Тогда Возврат -100; КонецЕсли;
	
	ПоследняяКассоваяСмена = ТЗ[0]; 
	
	Если НЕ КассовыеСменыВызовСервера.СменаАктивна(ПоследняяКассоваяСмена.Ссылка) 
	Тогда Возврат -100; КонецЕсли;
	
	НомерПоследнейОткрытойСмены = ПоследняяКассоваяСмена.НомерСменыККТ;
	
	ЭтоТекущаяСменаДокументОплаты = (ДокументОплаты.НомерСменыККМ = НомерПоследнейОткрытойСмены);
	
	Возврат ЭтоТекущаяСменаДокументОплаты;
КонецФункции

&НаКлиенте
Процедура ИнкассацияНаФискальномУстройстве(ДополнительныеПараметры)
    
    ЭтаФорма.Доступность = Ложь; // При необходимости можно заблокировать интерфейс пользователя.
    
    ПараметрыОперации = ОборудованиеЧекопечатающиеУстройстваКлиентСервер.ПараметрыИнкассации();
    ПараметрыОперации.ТипИнкассации = 1; //  Тип операции (0 - Выемка / 1 - Внесение)
    ПараметрыОперации.Сумма = СуммаВозвратаНаличные; // Сумма внесения/выемки
    
 	РезультатВыбора = ДополнительныеПараметры.РезультатВыбора;
	
	ОповещениеПриЗавершении = Новый ОписаниеОповещения("ИнкассацияНаФискальномУстройствеЗавершение", ЭтотОбъект, ДополнительныеПараметры);
    ОборудованиеЧекопечатающиеУстройстваКлиент.НачатьИнкассациюНаФискальномУстройстве(
        ОповещениеПриЗавершении, УникальныйИдентификатор, РезультатВыбора.ИдентификаторУстройства, ПараметрыОперации);
    
КонецПроцедуры

&НаКлиенте
Процедура ИнкассацияНаФискальномУстройствеЗавершение(РезультатВыполнения, ДополнительныеПараметры) Экспорт
    
