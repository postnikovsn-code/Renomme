Функция СчетДатаПо(ДатаС, ПериодАренды) Экспорт
Если ПериодАренды = "МЕСЯЦ" Тогда
	День = День(ДатаС);
	
	Месяц = Месяц(ДатаС);
	Год = Год(ДатаС);
	
	Если День > 1 Тогда
		Месяц = Месяц + 1;
	КонецЕсли;
	
	Если Месяц > 12 Тогда
		Месяц = 1;
		Год = Год + 1;
	КонецЕсли;
	
    // + Аудит
	//Дата_П = Дата(Год, Месяц, День);
	Попытка 	
		День_П = День;
		Дата_П = Дата(Год, Месяц, День_П);
	Исключение
		Попытка 	
			День_П = День - 1;
			Дата_П = Дата(Год, Месяц, День_П);
		Исключение
			Попытка 	
				День_П = День - 2;
				Дата_П = Дата(Год, Месяц, День_П);
			Исключение
				День_П = День - 3;
				Дата_П = Дата(Год, Месяц, День_П);
			КонецПопытки;
		КонецПопытки;
	КонецПопытки;
    // - Аудит

	Если День = 1 Тогда
		Дата_П = КонецМесяца(Дата_П);
	Иначе
		Дата_П = Дата_П - 86400; 
	КонецЕсли;
	
	ДатаПо = Дата_П;
	
	//ДатаПо = КонецМесяца(ДатаС);
	//Если НЕ КоворкингЗаявкаОбъект.ВключатьВыходные Тогда
	//	ДатаПо = РабочийДень(ДатаПо, Истина);
	//КонецЕсли;
ИначеЕсли ПериодАренды = "НЕДЕЛЯ" Тогда
	
	ДатаПо = ДатаС + 6*86400;
	
	//Если КоворкингЗаявкаОбъект.ВключатьВыходные Тогда
	//	ДатаПо = КонецНедели(ДатаС);
	//	ДатаПо = ДатаПо + 7*86400;
	//Иначе
	//	ДатаПо = КонецНедели(ДатаС);
	//	ДатаПо = ДатаПо - 2*86400;
	//КонецЕсли;

ИначеЕсли ПериодАренды = "ДЕНЬ" Тогда
	ДатаПо = НачалоДня(ДатаС);
ИначеЕсли ПериодАренды = "ЧАС" Тогда
	ДатаПо = НачалоДня(ДатаС);
Иначе	
	Возврат Неопределено;
КонецЕсли;	

Возврат ДатаПо; 
КонецФункции	

Процедура ЗаполнитьСрокиАренды(СрокиАренды, ДатаС, ДатаПо) Экспорт
СрокиАренды.Очистить();
Дата_П = ДатаС;
Пока Дата_П <= ДатаПо Цикл
	НоваяСтрока = СрокиАренды.Добавить(); 
	НоваяСтрока.СрокАренды = Дата_П;
	
	Дата_П = Дата_П + 86400;
КонецЦикла;
КонецПроцедуры 

// + ВключатьВыходные Не используется
Процедура ЗаполнитьСрокиАрендыВключатьВыходные(СрокиАренды, ДатаС, ДатаПо, ВключатьВыходные) Экспорт
СрокиАренды.Очистить();
Дата_П = ДатаС;
Пока Дата_П <= ДатаПо Цикл
	Если НЕ ВключатьВыходные Тогда 
		Если ДеньНедели(Дата_П) > 5 Тогда Перейти ~Продолжение; КонецЕсли;
	КонецЕсли;	
	
	НоваяСтрока = СрокиАренды.Добавить(); 
	НоваяСтрока.СрокАренды = Дата_П;
	
~Продолжение:	
	Дата_П = Дата_П + 86400;
КонецЦикла;
КонецПроцедуры 

Функция РазницаВДняхВключатьВыходные(ДатаС, ДатаПо, ВключатьВыходные)
Если ВключатьВыходные Тогда
	РазницаВДнях = (НачалоДня(ДатаПо) - НачалоДня(ДатаС)) / (60 * 60 * 24) + 1;	
Иначе
	РазницаВДнях = 0;
	Дата_П = ДатаС;
	Пока Дата_П <= ДатаПо Цикл
		Если ЭтоРабочийДень(Дата_П) Тогда 
		   РазницаВДнях = РазницаВДнях + 1;
		КонецЕсли;	
		Дата_П = Дата_П + 86400;	
	КонецЦикла;
КонецЕсли;
	
Возврат РазницаВДнях;	
КонецФункции

Функция ЭтоРабочийДень(Дата)
ДеньНедели = ДеньНедели(Дата);

Остаток = ДеньНедели - 5;
ЭтоРабочийДень = (Остаток <= 0); 
Возврат ЭтоРабочийДень;
КонецФункции

Функция РабочийДень(Дата, ПредыдущийДень) 
ДеньНедели = ДеньНедели(Дата);

Остаток = ДеньНедели - 5;
Если Остаток <= 0 Тогда Возврат Дата; КонецЕсли;

Если ПредыдущийДень Тогда
	РабочийДень = Дата - Остаток*86400; 	
Иначе
	Если Остаток = 2 Тогда
		Остаток = 1;
	Иначе 
		Остаток = 2;
	КонецЕсли;	
	
	РабочийДень = Дата + Остаток*86400; 	
КонецЕсли;	
Возврат РабочийДень;	
КонецФункции
