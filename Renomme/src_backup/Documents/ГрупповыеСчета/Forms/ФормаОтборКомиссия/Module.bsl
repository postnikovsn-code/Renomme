&НаКлиенте
Процедура Отобрать(Команда)
Если ПроверкаОтбораПредупреждение() Тогда Возврат; КонецЕсли;
	
ОтобратьНаСервере();
КонецПроцедуры

&НаСервере
Процедура ОтобратьНаСервере()
Запрос = Новый Запрос;
			   
Запрос.Текст = ГрупповойСчетСервер.ЗапросТекстОтборЗаявокКомиссияСчет();

Запрос.УстановитьПараметр("КонтрагентОтбор", КонтрагентОтбор);
Запрос.УстановитьПараметр("РезервС", ДатаОтбораС);

Если ЗначениеЗаполнено(ДатаОтбораПо) Тогда ДатаОтбораПо_П = ДатаОтбораПо; Иначе ДатаОтбораПо_П = '30010101'; КонецЕсли;
Запрос.УстановитьПараметр("РезервПо", ДатаОтбораПо_П);

Запрос.УстановитьПараметр("Все", Ложь);

ТЗРезультат = Запрос.Выполнить().Выгрузить();

ТаблицаОтбора.Очистить();
Для Каждого Строка Из ТЗРезультат Цикл
	//Если Неоплачено тогда
	//	Если НЕ Строка.СуммаОплаты = 0 Тогда Продолжить; КонецЕсли;
	////Иначе 
	////	Если Строка.СуммаОплаты > 0 Тогда Продолжить; КонецЕсли;
	//КонецЕсли;
	
	Если Строка.СуммаПроживание = 0 Тогда Продолжить; КонецЕсли;
	
	НоваяСтрока = ТаблицаОтбора.Добавить();
	НоваяСтрока.ЗаявкаНаБронирование = Строка.Ссылка;
	НоваяСтрока.Оплачивает = Строка.Оплачивает;
	НоваяСтрока.Проживает = Строка.Клиент;
	НоваяСтрока.Бронирует = Строка.Бронирует;
	НоваяСтрока.РезервС = Строка.РезервС;
	НоваяСтрока.РезервПо = Строка.РезервПо;
	НоваяСтрока.Номер = Строка.НомерВРезерв;
	НоваяСтрока.СуммаПроживание = Строка.СуммаПроживание;
	НоваяСтрока.СуммаОплачено = Строка.ОплатаПроживание;
	
	НоваяСтрока.ДатаЗаявки = Строка.Дата;
	НоваяСтрока.НомерЗаявки = Строка.Номер;
	
	//НоваяСтрока.ПроцентКомиссии = Строка.ПроцентКомиссии;
	НоваяСтрока.ПроцентКомиссии = ДокументыСервер.ПроцентКомиссииКлиента(НоваяСтрока.Бронирует, НоваяСтрока.ЗаявкаНаБронирование.РезервС); //, НоваяСтрока.ЗаявкаНаБронирование.В2В);
	НоваяСтрока.ПроцентВ2В = ДокументыСервер.ПроцентВ2В(НоваяСтрока.Бронирует, НоваяСтрока.ЗаявкаНаБронирование.РезервС); 
	
	//НоваяСтрока.СуммаКомиссии = Строка.СуммаКомиссии;
	НоваяСтрока.СуммаКомиссии = Окр(НоваяСтрока.СуммаПроживание * НоваяСтрока.ПроцентКомиссии / 100, 2) ;
КонецЦикла;	

ТаблицаОтбора.Сортировать("РезервС, ЗаявкаНаБронирование"); 
КонецПроцедуры
