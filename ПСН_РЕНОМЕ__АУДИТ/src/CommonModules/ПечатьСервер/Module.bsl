Если Контрагент.ТипКлиента = Перечисления.ТипыКлиентов.ЮрЛицо Тогда
	Макет = ПолучитьОбщийМакет("СчетЮрЛицо");	
	ТекстЗаголовка = ПечатьСчетаЮрЛицоШапка_Счет(ТабДок, Макет, НомерДокумента, ДатаДокумента, Контрагент);	
Иначе
	Макет = ПолучитьОбщийМакет("СчетФизЛицо");	
	ТекстЗаголовка = ПечатьСчетаФизЛицоШапка_Счет(ТабДок, Макет, НомерДокумента, ДатаДокумента, ГрупповойСчетОбъект.Ссылка, Неопределено);	
КонецЕсли;
	
СуммаДляПечатиОбщая = 0; СуммаДляПечатиОбщаяНДС = 0; Счетчик = 0;
ПечатьГрупповогоСчетаТело(ТабДок, Макет, Счетчик, СуммаДляПечатиОбщая, СуммаДляПечатиОбщаяНДС, ГрупповойСчетОбъект, Истина);

УчитыватьНДС = ДокументыСервер.УчитыватьНДС(ДатаДокумента);

Если Контрагент.ТипКлиента = Перечисления.ТипыКлиентов.ЮрЛицо Тогда
