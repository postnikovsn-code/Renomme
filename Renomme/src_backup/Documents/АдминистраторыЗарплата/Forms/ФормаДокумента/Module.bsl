&НаКлиенте
Процедура ДНПриИзменении(Элемент)
Если ПроверкаДКДН() Тогда Возврат; КонецЕсли; 

ПровестиНаСервере(ДН_OldValue, ДК_OldValue);

ТекстОшибки = ЗаполнитьСправочныеДанныеПоДНиДК();
ДНДК_ПриИзмененииНаСервере();

Если ТекстОшибки <> "" Тогда 
	Сообщить(ТекстОшибки);	
КонецЕсли;

ПровестиНаСервере(Объект.ДН, Объект.ДК);

ДН_OldValue = Объект.ДН;
КонецПроцедуры

&НаКлиенте
Процедура ДКПриИзменении(Элемент)
Если ПроверкаДКДН() Тогда Возврат; КонецЕсли; 

Если ЗначениеЗаполнено(ДН_OldValue) И ЗначениеЗаполнено(ДК_OldValue) Тогда
	ТекстСообщения = "Идет перерасчет Зарплаты";
Иначе	
	ТекстСообщения = "Идет расчет Зарплаты";
КонецЕсли;
ТекстСообщения = ТекстСообщения + "
			|
			|ПОДОЖДИТЕ ...";
ПараметрыФормы = Новый Структура("ТекстСообщения", ТекстСообщения);
ФормаСообщения = ОткрытьФорму("Документ.АдминистраторыЗарплата.Форма.СообщениеОперация", ПараметрыФормы, ЭтаФорма
	,,,,, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца); 
	
ПровестиНаСервере(ДН_OldValue, ДК_OldValue);

ТекстОшибки = ЗаполнитьСправочныеДанныеПоДНиДК();
ДНДК_ПриИзмененииНаСервере();

ПровестиНаСервере(Объект.ДН, Объект.ДК);
ФормаСообщения.Закрыть();

Если ТекстОшибки <> "" Тогда 
	Сообщить(ТекстОшибки);	
КонецЕсли;

ДК_OldValue = Объект.ДК;
КонецПроцедуры

&НаКлиенте
Функция ПроверкаДКДН()
Если НЕ (ЗначениеЗаполнено(Объект.ДН) И ЗначениеЗаполнено(Объект.ДК)) Тогда Возврат Истина; КонецЕсли; 

Если Объект.ДН > Объект.ДК Тогда 
	
	ПоказатьПредупреждение( ,"Дата начала > Даты окончания");
	//
	Объект.ДН = ДН_OldValue;
	Объект.ДК = ДК_OldValue;
	
	Возврат Истина; 
КонецЕсли; 

Если НачалоМесяца(Объект.ДН) <> НачалоМесяца(Объект.ДК) Тогда
	ПоказатьПредупреждение( ,"Месяц начала <> Месяц окончания");
	//
	Объект.ДН = ДН_OldValue;
	Объект.ДК = ДК_OldValue;
	
	Возврат Истина; 
КонецЕсли;	

Возврат Ложь; 
КонецФункции

&НаСервере
Процедура ДНДК_ПриИзмененииНаСервере()
	
ДН_П = НачалоМесяца(Объект.ДН);
ДК_П = КонецМесяца(Объект.ДК);
	
Если ЗарплатаСмены.Количество() > 0 Тогда
	
	РеквизитыЗарплатаСмены = РеквизитыЗарплатаСмены(ДН_П, ДК_П);  

	Если РеквизитыЗарплатаСмены.Количество() > 0 Тогда
		УдаляемыеРеквизиты = Новый Массив;
		Для каждого Строка Из РеквизитыЗарплатаСмены Цикл
			УдаляемыеРеквизиты.Добавить(Строка.Путь + "." + Строка.Имя);	
		КонецЦикла;

		Дата_П = ДН_П;
		Пока Дата_П <= ДК_П Цикл
			Дата_С = Формат(Дата_П, "ДФ=dd.MM.yy");
			Дата_И = СтрЗаменить(Дата_С, ".", "");
			
			//
			Имя = "Часы_" + Дата_И;
			УдаляемыеРеквизиты.Добавить("ЗарплатаСмены_OldValue." + Имя);
			
			Имя = "НомерСмены_" + Дата_И;
			УдаляемыеРеквизиты.Добавить("ЗарплатаСмены_OldValue." + Имя);
			
			Имя = "ДлинаСмены_" + Дата_И;
			УдаляемыеРеквизиты.Добавить("ЗарплатаСмены_OldValue." + Имя);
			
			Имя = "ПереработкаЧасы_" + Дата_И;
			УдаляемыеРеквизиты.Добавить("ЗарплатаСмены_OldValue." + Имя);
			//
			
			Дата_П = Дата_П + 24 * 60 * 60;	
		КонецЦикла;
		
		ИзменитьРеквизиты(,УдаляемыеРеквизиты);

		ЭлементТаблицаИмя = "ЗарплатаСмены";
		Дата_П = ДН_OldValue;
		Пока Дата_П <= ДК_OldValue Цикл
			Дата_С = Формат(Дата_П, "ДФ=dd.MM.yy");
			Дата_И = СтрЗаменить(Дата_С, ".", "");
			
			Имя = ЭлементТаблицаИмя + "Группа1_" + Дата_И; 
			Элемент = Элементы.Найти(Имя);
			Элементы.Удалить(Элемент);
			
			Дата_П = Дата_П + 24 * 60 * 60;
		КонецЦикла;
	КонецЕсли;
КонецЕсли;

ЗаполнитьЗарплатаСмены();

РасчитатьЗарплатуНаСервере();
ОбновитьЗарплатыСмена();
КонецПроцедуры
