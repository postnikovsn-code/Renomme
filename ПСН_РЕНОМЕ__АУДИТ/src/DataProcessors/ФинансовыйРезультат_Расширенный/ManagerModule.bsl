	КонецЕсли;
	
	Область.Параметры.СуммаОплаты = СтрокаНераспределенныеОплаты.СуммаОплаты;
	Область.Параметры.СуммаЭквайринга = ОтчетыСервер.СуммаЭквайринга(СтрокаНераспределенныеОплаты);
	
	Если СтрокаНераспределенныеОплаты.СуммаДокументаОплаты <> 0 Тогда
		Область.Параметры.СуммаОплаты_кк = Окр(СтрокаНераспределенныеОплаты.СуммаОплаты 
				* СтрокаНераспределенныеОплаты.СуммаДокументаОплатыКарта / СтрокаНераспределенныеОплаты.СуммаДокументаОплаты, 2);
		Область.Параметры.СуммаОплаты_Нал = Окр(СтрокаНераспределенныеОплаты.СуммаОплаты 
				* СтрокаНераспределенныеОплаты.СуммаДокументаОплатыНаличные / СтрокаНераспределенныеОплаты.СуммаДокументаОплаты, 2);
	КонецЕсли;
			
	Если ТипЗнч(СтрокаНераспределенныеОплаты.ДокументОплаты) = Тип("УникальныйИдентификатор") Тогда
		Область.Параметры.РасшифровкаДокументОплаты = "Нераспределенная выгрузка";
	Иначе	
		Область.Параметры.РасшифровкаДокументОплаты = СтрокаНераспределенныеОплаты.ДокументОплаты;
	КонецЕсли;
				
	Область.Параметры.ТипДокументаОплаты = СтрокаНераспределенныеОплаты.ТипДокументаОплаты;
	Область.Параметры.НомерДокументаОплаты = СтрокаНераспределенныеОплаты.НомерДокументаОплаты;
	//Область.Параметры.ДатаДокументаОплаты = Формат(СтрокаНераспределенныеОплаты.ДатаДокументаОплаты, "ДФ=dd.MM.yy");
	Область.Параметры.ДатаДокументаОплаты = СтрокаНераспределенныеОплаты.ДатаДокументаОплаты;
	Область.Параметры.СуммаДокументаОплаты = СтрокаНераспределенныеОплаты.СуммаДокументаОплаты;
	Область.Параметры.СуммаВозвратаДокументаОплаты = СтрокаНераспределенныеОплаты.СуммаВозвратаДокументаОплаты;
	Область.Параметры.ОстатокДокументаОплаты = СтрокаНераспределенныеОплаты.ОстатокДокументаОплаты;
	
	//Область.Параметры.Оплатил = ОплатилНаименование(СтрокаНераспределенныеОплаты);
	Область.Параметры.Оплатил = ОтчетыСервер.ОплатилНаименование(СтрокаНераспределенныеОплаты);
	Область.Параметры.ОплатилИНН = СтрокаНераспределенныеОплаты.КонтрагентИНН;
	
	Область.Параметры.СуммаДокументаОплаты_кк = СтрокаНераспределенныеОплаты.СуммаДокументаОплатыКарта;
	Область.Параметры.СуммаДокументаОплаты_Нал = СтрокаНераспределенныеОплаты.СуммаДокументаОплатыНаличные;
	
	Область.Параметры.СуммаВозвратаДокументаОплаты_кк = СтрокаНераспределенныеОплаты.СуммаВозвратаДокументаОплатыКарта;
	Область.Параметры.СуммаДокументаОплаты_Нал = СтрокаНераспределенныеОплаты.СуммаДокументаОплатыНаличные;
	
	ОбластьВывода = ПолеОтчета.Вывести(Область, 0);
	ВыведеннаяОбласть = ПолеОтчета.Область(ОбластьВывода.Верх, , ОбластьВывода.Низ);
КонецЦикла;

//Область = Макет.ПолучитьОбласть("ПодножиеНераспределенныеОплатыДополнение|КолонкиЛево");
Область = Макет.ПолучитьОбласть("ПодножиеНераспределенныеОплатыДополнение");
ПолеОтчета.Вывести(Область, 0);
// - Нераспределенные оплаты

Возврат ПолеОтчета;       
КонецФункции

Функция СформироватьОплатыБрони(Знач Макет, Знач ДатаОтчетаС, Знач ДатаОтчетаПо, ТипДатаС, ТипДатаПо, БронируетОтбор
	, НеПоказыватьЗакрытыеНераспределенныеОплаты, ЭтоОтчет) Экспорт

ПолеОтчета = Новый ТабличныйДокумент;

ТЗ_РодительУслуги = ТЗ_УслугиРодитель();

ПлатежиКонтрагенту = ПлатежиКонтрагенту(ДатаОтчетаС, ДатаОтчетаПо);

Запрос = Новый Запрос("ВЫБРАТЬ
                      |	КассовыйДокумент.Ссылка КАК ДокументОплаты,
                      |	ЗаявкиОплаты.Ссылка КАК Заявка,
                      |	ЗаявкиОплаты.Ссылка.РезервС КАК РезервС,
                      |	ЕСТЬNULL(ЗаявкиОплаты.СуммаРаспределено, 0) КАК СуммаОплаты,
                      |	ЕСТЬNULL(ЗаявкиОплаты.ГрупповаяОплата, ЛОЖЬ) КАК ГрупповаяОплата,
                      |	КассовыйДокумент.Номер КАК НомерДокументаОплаты,
                      |	КассовыйДокумент.Дата КАК ДатаДокументаОплаты,
                      |	КассовыйДокумент.ОтКого КАК ОтКого,
                      |	ВЫБОР
                      |		КОГДА КассовыйДокумент.ОтКого.ТипКлиента = ЗНАЧЕНИЕ(Перечисление.ТипыКлиентов.ЮрЛицо)
                      |			ТОГДА КассовыйДокумент.ОтКого.НаименованиеЮрЛица
                      |		ИНАЧЕ КассовыйДокумент.ОтКого.Наименование
                      |	КОНЕЦ КАК КонтрагентНаименование,
                      |	КассовыйДокумент.ДатаОплаты КАК ДатаОплаты,
                      |	КассовыйДокумент.Сумма КАК СуммаДокументаОплаты,
                      |	КассовыйДокумент.СуммаКарта КАК СуммаДокументаОплатыКарта,
                      |	КассовыйДокумент.СуммаНаличные КАК СуммаДокументаОплатыНаличные,
                      |	ЕСТЬNULL(Возвраты.Сумма, 0) КАК СуммаВозвратаДокументаОплаты,
                      |	ЕСТЬNULL(Возвраты.СуммаКарта, 0) КАК СуммаВозвратаДокументаОплатыКарта,
                      |	ЕСТЬNULL(Возвраты.СуммаНаличные, 0) КАК СуммаВозвратаДокументаОплатыНаличные,
                      |	ЕСТЬNULL(ДолгиОплаты.Сумма, 0) КАК ДолгиОплатыСумма,
                      |	КассовыйДокумент.Сумма - ЕСТЬNULL(Возвраты.Сумма, 0) - ЕСТЬNULL(ДолгиОплаты.Сумма, 0) КАК ОстатокДокументаОплаты,
                      |	ВЫБОР
                      |		КОГДА КассовыйДокумент.ВидОперации = ЗНАЧЕНИЕ(Справочник.ВидыОпераций.оverbooking)
                      |			ТОГДА 8
                      |		КОГДА КассовыйДокумент.СуммаНаличные = 0
                      |				И КассовыйДокумент.СуммаКарта > 0
                      |			ТОГДА 1
                      |		ИНАЧЕ ВЫБОР
                      |				КОГДА КассовыйДокумент.СуммаНаличные > 0
                      |						И КассовыйДокумент.СуммаКарта = 0
                      |					ТОГДА 2
                      |				ИНАЧЕ 0
                      |			КОНЕЦ
                      |	КОНЕЦ КАК ТипОплаты,
                      |	ЛОЖЬ КАК ЭтоЭквайринг,
                      |	""КД"" КАК ТипДокументаОплаты,
                      |	ЕСТЬNULL(КассоваяСмена.НачалоКассовойСмены, ДАТАВРЕМЯ(1, 1, 1)) КАК ДатаСменыККМ
                      |ИЗ
                      |	Документ.КассовыйДокумент КАК КассовыйДокумент
                      |		ЛЕВОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
                      |			КассовыйДокумент.ВозвратДокумент КАК ВозвратДокумент,
                      |			СУММА(КассовыйДокумент.Сумма) КАК Сумма,
                      |			СУММА(КассовыйДокумент.СуммаКарта) КАК СуммаКарта,
                      |			СУММА(КассовыйДокумент.СуммаНаличные) КАК СуммаНаличные
                      |		ИЗ
                      |			Документ.КассовыйДокумент КАК КассовыйДокумент
                      |		ГДЕ
                      |			КассовыйДокумент.ПометкаУдаления = ЛОЖЬ
                      |		
                      |		СГРУППИРОВАТЬ ПО
                      |			КассовыйДокумент.ВозвратДокумент) КАК Возвраты
                      |		ПО КассовыйДокумент.Ссылка = Возвраты.ВозвратДокумент
                      |		ВНУТРЕННЕЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
                      |			ЗаявкаНаБронированиеСчетаДетальноОплаты.Ссылка КАК Ссылка,
                      |			ЗаявкаНаБронированиеСчетаДетальноОплаты.ДокументОплаты КАК ДокументОплаты,
                      |			ЗаявкаНаБронированиеСчетаДетальноОплаты.ГрупповаяОплата КАК ГрупповаяОплата,
                      |			СУММА(ЗаявкаНаБронированиеСчетаДетальноОплаты.СуммаРаспределено) КАК СуммаРаспределено
                      |		ИЗ
                      |			Документ.ЗаявкаНаБронирование.СчетаДетальноОплаты КАК ЗаявкаНаБронированиеСчетаДетальноОплаты
                      |		ГДЕ
                      |			ЗаявкаНаБронированиеСчетаДетальноОплаты.Ссылка.ПометкаУдаления = ЛОЖЬ
                      |			И ЗаявкаНаБронированиеСчетаДетальноОплаты.Ссылка.Статус = ЗНАЧЕНИЕ(Перечисление.СтатусБрони.Бронь)
                      |		
                      |		СГРУППИРОВАТЬ ПО
                      |			ЗаявкаНаБронированиеСчетаДетальноОплаты.Ссылка,
                      |			ЗаявкаНаБронированиеСчетаДетальноОплаты.ГрупповаяОплата,
                      |			ЗаявкаНаБронированиеСчетаДетальноОплаты.ДокументОплаты) КАК ЗаявкиОплаты
                      |		ПО КассовыйДокумент.Ссылка = ЗаявкиОплаты.ДокументОплаты
                      |		ЛЕВОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
                      |			КассовыйДокументДолгиОплата.Ссылка КАК Ссылка,
                      |			СУММА(КассовыйДокументДолгиОплата.Сумма) КАК Сумма
                      |		ИЗ
                      |			Документ.КассовыйДокумент.ДолгиОплата КАК КассовыйДокументДолгиОплата
                      |		
                      |		СГРУППИРОВАТЬ ПО
                      |			КассовыйДокументДолгиОплата.Ссылка) КАК ДолгиОплаты
                      |		ПО КассовыйДокумент.Ссылка = ДолгиОплаты.Ссылка
                      |		ЛЕВОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
                      |			КассовыйДокумент.Ссылка КАК ДокументОплаты,
                      |			КассоваяСмена.НомерСменыККТ КАК НомерСменыККТ,
                      |			МАКСИМУМ(КассоваяСмена.НачалоКассовойСмены) КАК НачалоКассовойСмены
                      |		ИЗ
                      |			Документ.КассовыйДокумент КАК КассовыйДокумент
                      |				ЛЕВОЕ СОЕДИНЕНИЕ Документ.КассоваяСмена КАК КассоваяСмена
                      |				ПО КассовыйДокумент.НомерСменыККМ = КассоваяСмена.НомерСменыККТ
                      |					И (ВЫБОР
                      |						КОГДА КассоваяСмена.НачалоКассовойСмены ЕСТЬ NULL
                      |							ТОГДА ИСТИНА
                      |						ИНАЧЕ НАЧАЛОПЕРИОДА(КассоваяСмена.НачалоКассовойСмены, ГОД) = НАЧАЛОПЕРИОДА(КассовыйДокумент.ДатаОплаты, ГОД)
                      |					КОНЕЦ)
                      |		
                      |		СГРУППИРОВАТЬ ПО
                      |			КассовыйДокумент.Ссылка,
                      |			КассоваяСмена.НомерСменыККТ) КАК КассоваяСмена
                      |		ПО КассовыйДокумент.Ссылка = КассоваяСмена.ДокументОплаты
                      |ГДЕ
                      |	КассовыйДокумент.ПометкаУдаления = ЛОЖЬ
                      |	И КассовыйДокумент.ДатаОплаты >= &ДатаНачала
                      |	И КассовыйДокумент.ДатаОплаты <= &ДатаОкончания");
					  
					  
ДатаНачала = ДатаОтчетаС;
Запрос.УстановитьПараметр("ДатаНачала", ДатаНачала);
ДатаОкончания = ДатаОтчетаПо;
Запрос.УстановитьПараметр("ДатаОкончания", ДатаОкончания);	
ТЗ = Запрос.Выполнить().Выгрузить();	

ТЗ_ОплатыБронь = ТЗ.СкопироватьКолонки();
Колонка_ДокументОплаты = ТЗ_ОплатыБронь.Колонки.Найти("ДокументОплаты");
ТЗ_ОплатыБронь.Колонки.Удалить(Колонка_ДокументОплаты);
ТЗ_ОплатыБронь.Колонки.Добавить("ДокументОплаты");

Для Каждого Строка Из ТЗ Цикл
	НоваяСтрока = ТЗ_ОплатыБронь.Добавить();
	ЗаполнитьЗначенияСвойств(НоваяСтрока, Строка);
	
	Если НЕ ЗначениеЗаполнено(Строка.КонтрагентНаименование) Тогда
		Строка.КонтрагентНаименование = Строка.ОтКого.Наименование;	
	КонецЕсли;
КонецЦикла;

Запрос = Новый Запрос("ВЫБРАТЬ
                      |	ВыпискаБанка.Ссылка КАК ДокументОплаты,
                      |	ЗаявкиОплаты.Ссылка КАК Заявка,
                      |	ЗаявкиОплаты.Ссылка.РезервС КАК РезервС,
                      |	ЕСТЬNULL(ЗаявкиОплаты.СуммаРаспределено, 0) КАК СуммаОплаты,
