	//	ОбластьПараметры.ТипДокумента = "Гр. счет Турагентству";
	//КонецЕсли;

	//ГрупповойСчетФактурыСтроки = ПечатьСервер.ГрупповойСчетФактурыСтроки(Строка.Групповойсчет);	
