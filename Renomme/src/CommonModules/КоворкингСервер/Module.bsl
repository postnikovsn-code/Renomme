
Функция УменьшитьОплатыКоворкингСчетаСуммаВозврата(ДокументОплаты, ДокументДолг, СуммаВозврата) Экспорт
Если ТипЗнч(ДокументОплаты) <> Тип("ДокументСсылка.КассовыйДокумент") 
И ТипЗнч(ДокументОплаты) <> Тип("ДокументСсылка.ВыпискаБанка") Тогда Возврат Неопределено; КонецЕсли;

ДокументДолгОбъект = ДокументДолг.ПолучитьОбъект();

ДокументыОплаты = ДокументДолгОбъект.ДокументыОплаты;
РаспределениеОплатКоворкинг = ДокументДолгОбъект.РаспределениеОплатКоворкинг;

НачатьТранзакцию();

ОтборСтроки = Новый Структура("ДокументОплаты", ДокументОплаты); 
НайденныеСтрокиДокументыОплаты = ДокументыОплаты.НайтиСтроки(ОтборСтроки);
НайденныеСтрокРаспределениеОплатКоворкинг = РаспределениеОплатКоворкинг.НайтиСтроки(ОтборСтроки);

ОстатокСуммаВозврата = СуммаВозврата;
СтрокаДокументыОплаты = НайденныеСтрокиДокументыОплаты[0]; 

Если СтрокаДокументыОплаты.СуммаРаспределено <= ОстатокСуммаВозврата Тогда
	ОбщийФункционалСервер.УдалитьСтроки(ДокументыОплаты, НайденныеСтрокиДокументыОплаты);
	
	// + Аудит
	//ОбщийФункционалСервер.УдалитьСтроки(ДокументыОплаты, НайденныеСтрокРаспределениеОплатКоворкинг);
	ОбщийФункционалСервер.УдалитьСтроки(РаспределениеОплатКоворкинг, НайденныеСтрокРаспределениеОплатКоворкинг);
	// - Аудит
	
	ОплатыОбщееСервер.УдалитьДокументОплатыДокументДолгДолгОплата(ДокументОплаты, ДокументДолг, ДокументДолг.СчетГУИД);
	
	// + Аудит
	//ОстатокСуммаВозврата = СуммаВозврата - СтрокаДокументыОплаты.СуммаРаспределено;
	ОстатокСуммаВозврата = ОстатокСуммаВозврата - СтрокаДокументыОплаты.СуммаРаспределено;
	// - Аудит
Иначе
	Для Каждого СтрокаРаспределениеОплат Из НайденныеСтрокРаспределениеОплатКоворкинг Цикл
		Если СтрокаРаспределениеОплат.СуммаОплаты <= ОстатокСуммаВозврата Тогда
			РаспределениеОплатКоворкинг.Удалить(СтрокаРаспределениеОплат);
			
			ОстатокСуммаВозврата = СуммаВозврата - СтрокаРаспределениеОплат.СуммаОплаты;
		Иначе	
			СтрокаРаспределениеОплат.СуммаОплаты = СтрокаРаспределениеОплат.СуммаОплаты - ОстатокСуммаВозврата;   
			
			ОстатокСуммаВозврата = 0;
			Прервать;
		КонецЕсли;
	КонецЦикла;
	
	СтрокаДокументыОплаты.СуммаРаспределено = СтрокаДокументыОплаты.СуммаРаспределено - СуммаВозврата;
КонецЕсли;	
	
РаспределениеОплатКоворкингТЗ = РаспределениеОплатКоворкинг.Выгрузить(ОтборСтроки, "СуммаОплаты");
СуммаОплаты = РаспределениеОплатКоворкингТЗ.Итог("СуммаОплаты");
ОплатыОбщееСервер.ДобавитьЗаменитьДокументОплатыДолгОплата(ДокументОплаты, ДокументДолг, ДокументДолг.СчетГУИД
	, СуммаОплаты, Истина);

ДокументДолгОбъект.Записать(РежимЗаписиДокумента.Проведение);

ЗафиксироватьТранзакцию();
КонецФункции	

