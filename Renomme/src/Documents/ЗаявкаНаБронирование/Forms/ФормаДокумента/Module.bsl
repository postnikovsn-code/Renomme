&НаКлиенте
Процедура ДопПожеланияПриНачалеРедактирования(Элемент, НоваяСтрока, Копирование)
ТД = Элемент.ТекущиеДанные;

Если НЕ ЗначениеЗаполнено(ТД.ДатаРегистрации) Тогда
	ТД.ДатаРегистрации = ТекущаяДата();
КонецЕсли;
КонецПроцедуры

//// + Проживание

// + Заполнить Проживание
&НаКлиенте
Процедура ЗаполнитьПроживание(Команда)

Если НЕ ЗначениеЗаполнено(Объект.КатегорияНомера) Тогда 	
	ПоказатьПредупреждение(, "Не заполнена категория номера");
	Возврат;
КонецЕсли;	
	
Если Объект.Проживание.Количество()>0 Тогда 
	Если ОплатыОбщееКлиент.ЕстьСчета(Объект.Счета) Тогда
		ТекстПредупреждения = "Есть счета." 
				+ Символы.ПС + Символы.ПС + "Заполните проживание вручную,"
				+ Символы.ПС + "либо удалите счета.";
		ПоказатьПредупреждение( ,ТекстПредупреждения); 		
		
		Возврат;
	КонецЕсли;	
	
	Оповещение = Новый ОписаниеОповещения("ЗавершениеВопросаТаблицаБудетОчищенаПродолжить", ЭтаФорма);
	ПоказатьВопрос(Оповещение, "Данные проживания будут очищены
								|
								|ПРОДОЛЖИТЬ ?", РежимДиалогаВопрос.ДаНет);
Иначе
	ЗаполнитьТаблицуПроживанияНаКлиенте();		
КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ЗавершениеВопросаТаблицаБудетОчищенаПродолжить(Результат, Параметры) Экспорт
Если Результат = КодВозвратаДиалога.Да Тогда 
	ЗаполнитьТаблицуПроживанияНаКлиенте();	
КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьТаблицуПроживанияНаКлиенте()
Двухместный = ДвухМестныйПредупреждение();
Если Двухместный = Неопределено Тогда Возврат; КонецЕсли;
	
Объект.Проживание.Очистить();

ЗаполнитьПроживание = Истина;	
Если ЭтотОбъектЗаписатьНаКлиенте() Тогда Возврат; КонецЕсли;	

ЗаполнитьПроживание = Ложь;	
ЗаполнитьТаблицуПроживанияНаСервере(Двухместный);	

ЭтотОбъектЗаписатьНаКлиенте();
КонецПроцедуры

&НаСервере
Функция ЗаполнитьТаблицуПроживанияНаСервере(Двухместный)
Если НЕ ЗначениеЗаполнено(Объект.РезервС) Тогда Возврат Неопределено; КонецЕсли; 
Если НЕ ЗначениеЗаполнено(Объект.РезервПо) Тогда Возврат Неопределено; КонецЕсли; 

ТЗ = ДокументыСервер.ЗаполнитьТаблицуПроживания_Таблица(Объект, Двухместный);

Если Объект.В2В Тогда
	ПроцентВ2В = ДокументыСервер.ПроцентВ2В(Объект.Бронирует, Объект.РезервС);
	
	Для Каждого Строка Из ТЗ Цикл
		//Строка.Цена = ДокументыСервер.ОкруглитьЦену(Строка.Цена * ((100 - ПроцентВ2В) / 100));
		
		Цена_П = Строка.Цена * ((100 - ПроцентВ2В) / 100);
		Цена = Цел(Цена_П);
		Если Цена_П > Цена Тогда
			Цена = Цена + 1;
		КонецЕсли;
		
		Строка.Цена = Цена;
		Строка.СуммаБезСкидки = Строка.Цена * Строка.Количество;
		
		ДокументыСервер.ЗаполнитьСуммаСоСкидкойСтрокаПроживание(Строка);
	КонецЦикла;
КонецЕсли;
	
Объект.Проживание.Очистить();
Для Каждого Строка Из ТЗ Цикл 
	НоваяСтрока = Объект.Проживание.Добавить();
	ЗаполнитьЗначенияСвойств(НоваяСтрока, Строка);
	
	НоваяСтрока.ГУИД = Новый УникальныйИдентификатор;
КонецЦикла;

ДеньПроживанияМинимум = ЗаявкаОбщееКлиентСервер.ДеньПроживанияМинимум(Объект.Проживание);
Объект.РезервС = ДеньПроживанияМинимум; 

Если НЕ ЗначениеЗаполнено(Объект.РезервС) Тогда Возврат Неопределено; КонецЕсли;  

Если Объект.РезервС <> Объект.РезервПо Тогда 
	ДеньПроживанияМаксимум = ЗаявкаОбщееКлиентСервер.ДеньПроживанияМаксимум(Объект.Проживание);
	ДеньПроживанияМаксимум = ДеньПроживанияМаксимум + 86400;
	Объект.РезервПо = ДеньПроживанияМаксимум; 
КонецЕсли;

Объект.КолВоДней = Объект.Проживание.Итог("Количество");
Возврат Неопределено;
КонецФункции
// - Заполнить Проживание

