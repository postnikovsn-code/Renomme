&НаКлиенте
Процедура СформироватьКоманда(Команда)
	СформироватьКомандаНаСервере();
КонецПроцедуры

&НаСервере
Процедура СформироватьКомандаНаСервере()
	//Макет=ПолучитьМакет("Макет");
	Макет = Отчеты.ОтчетПоВремениЗаезда.ПолучитьМакет("Макет");
	
	//ЭлементыФормы.ПолеОтчета.Очистить();
	ПолеОтчета.Очистить();
	
	Обл=Макет.ПолучитьОбласть("Шапка");
	//ЭлементыФормы.ПолеОтчета.Вывести(Обл);
	ПолеОтчета.Вывести(Обл);
	
	ЗапросЗаездов=Новый Запрос("ВЫБРАТЬ
	                           |	ЗаявкаНаБронирование.ВремяЗаездаТочное,
	                           |	НАЧАЛОПЕРИОДА(ЗаявкаНаБронирование.ВремяЗаездаТочное, ДЕНЬ) КАК ДТ,
	                           |	1 КАК КолВо
	                           |ИЗ
	                           |	Документ.ЗаявкаНаБронирование КАК ЗаявкаНаБронирование
	                           |ГДЕ
	                           |	ЗаявкаНаБронирование.ВремяЗаездаТочное МЕЖДУ &ДН И &ДК");
	ЗапросЗаездов.УстановитьПараметр("ДН",НачалоДня(Отчет.ДатаНачала));	
	ЗапросЗаездов.УстановитьПараметр("ДК",КонецДня(Отчет.ДатаОкончания));
	ТЗЗаезд=ЗапросЗаездов.Выполнить().Выгрузить();
	ТЗЗаезд.Колонки.Добавить("Категория");
	ТЗЗаезд.Колонки.Добавить("ДеньНедели");
	
	Для Каждого СтрТЗ из ТЗЗаезд цикл
	//	Если Час(СтрТЗ.ВремяЗаездаТочное)<=5 тогда
	//		СтрТЗ.Категория=1;
	//	ИначеЕсли Час(СтрТЗ.ВремяЗаездаТочное)<=8 тогда
	//		СтрТЗ.Категория=2;
	//	ИначеЕсли Час(СтрТЗ.ВремяЗаездаТочное)<=12 тогда
	//		СтрТЗ.Категория=3;
	//	ИначеЕсли Час(СтрТЗ.ВремяЗаездаТочное)<=18 тогда
	//		СтрТЗ.Категория=4;
	//	ИначеЕсли Час(СтрТЗ.ВремяЗаездаТочное)<=21 тогда
	//		СтрТЗ.Категория=5;
	//
	//	Иначе
	//		СтрТЗ.Категория=6;
	//	КонецЕсли;
		СтрТЗ.Категория=Час(СтрТЗ.ВремяЗаездаТочное);
		СтрТЗ.ДеньНедели=СтрДеньН(ДеньНедели(СтрТЗ.ВремяЗаездаТочное));
	КонецЦикла;
	ТЗЗаезд.Свернуть("ДТ,ДеньНедели,Категория","КолВо");
	ТЗЗаезд.Сортировать("ДТ,Категория");
	Для каждого СтрТЗ из ТЗЗаезд цикл
		Обл=Макет.ПолучитьОбласть("Строка");
		//Дата	ДН	Категория	КолВо
		Обл.Параметры.Дата=Формат(СтрТЗ.ДТ, "ДФ=dd.MM.yy");
		Обл.Параметры.ДН=СтрТЗ.ДеньНедели;
		Обл.Параметры.Категория=СтрТЗ.Категория;
		Обл.Параметры.КолВо=СтрТЗ.КолВо;
		
		//ЭлементыФормы.ПолеОтчета.Вывести(Обл);
		ПолеОтчета.Вывести(Обл);
		
	КонецЦикла;
	ТЗЗаезд.Свернуть("ДеньНедели,Категория","КолВо");
    Обл=Макет.ПолучитьОбласть("Диаграмма");
	Диаграмма=Обл.Рисунки.D1.Объект;

