&НаСервере
Функция ЛистОжиданияКоличество()
Запрос=Новый Запрос("ВЫБРАТЬ
                    |	КОЛИЧЕСТВО(РАЗЛИЧНЫЕ ЗаявкаНаБронирование.Ссылка) КАК Количество
                    |ИЗ
                    |	Документ.ЗаявкаНаБронирование КАК ЗаявкаНаБронирование
                    |ГДЕ
                    |	ЗаявкаНаБронирование.ПометкаУдаления = ЛОЖЬ
                    |	И ЗаявкаНаБронирование.ЛистОжидания = ИСТИНА
                    |	И ЗаявкаНаБронирование.Статус = ЗНАЧЕНИЕ(Перечисление.СтатусБрони.Бронь)");

ТЗ=Запрос.Выполнить().Выгрузить();
Если ТЗ.Количество() = 0 Тогда 
	Количество = 0; 
Иначе
	Количество = ТЗ[0].Количество;
КонецЕсли;

Возврат Количество;
КонецФункции                                

&НаСервере
Процедура ЖурналЛистОжиданияКомандаКоличество()
Запрос=Новый Запрос("ВЫБРАТЬ
                    |	КОЛИЧЕСТВО(РАЗЛИЧНЫЕ ЗаявкаНаБронирование.Ссылка) КАК Количество
                    |ИЗ
                    |	Документ.ЗаявкаНаБронирование КАК ЗаявкаНаБронирование
                    |ГДЕ
                    |	ЗаявкаНаБронирование.ПометкаУдаления = ЛОЖЬ
                    |	И ЗаявкаНаБронирование.ЛистОжидания = ИСТИНА
                    |	И ЗаявкаНаБронирование.Статус = ЗНАЧЕНИЕ(Перечисление.СтатусБрони.Бронь)");

ТЗ=Запрос.Выполнить().Выгрузить();
Если ТЗ.Количество() = 0 Тогда 
	Количество = 0; 
Иначе
	Количество = ТЗ[0].Количество;
КонецЕсли;

Элементы.ЖурналЛистОжиданияКоманда.Заголовок = "Лист ожидания (" + Строка(Количество)+")";
Если Количество > 0 Тогда 
	Элементы.ЖурналЛистОжиданияКоманда.ЦветТекста = Новый Цвет(240, 255, 255);
	Элементы.ЖурналЛистОжиданияКоманда.ЦветФона = Новый Цвет(255, 0, 0);
Иначе
	Элементы.ЖурналЛистОжиданияКоманда.ЦветТекста = ЦветаСтиля.ЦветТекстаКнопки;
	Элементы.ЖурналЛистОжиданияКоманда.ЦветФона = ЦветаСтиля.ЦветФонаКнопки;
КонецЕсли;
КонецПроцедуры                                

