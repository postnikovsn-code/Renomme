&НаКлиенте
Функция ПереместитьФайлВПутьДоФото(Файл, КаталогПриемник, ГУИДКлиентаСтрока, КаталогАрхив)
ИмяФайла = Файл.Имя;
ИмяФайла = ГУИДКлиентаСтрока + "_" + ИмяФайла; 

НомерФайла = 0;
Пока Истина Цикл
	Если НомерФайла = 0 Тогда 
		ИмяФайла_П = ИмяФайла;
	Иначе
		ИмяФайла_П = ИмяФайла + "_" + Строка(НомерФайла);
	КонецЕсли;
	
	ПоискФайлов = НайтиФайлы(КаталогПриемник, ИмяФайла_П);
	Если ПоискФайлов.Количество() = 0 Тогда
		ИмяФайлаАрхив = КаталогАрхив + Файл.Имя;
		//КопироватьФайл(Файл.ПолноеИмя, ИмяФайлаАрхив);
Попытка
    КопироватьФайл(Файл.ПолноеИмя, ИмяФайлаАрхив);
Исключение                      
    Сообщить("Ошибка копирования в Архив: " + ОписаниеОшибки());    
    Возврат Неопределено;
КонецПопытки;
		
		ИмяФайлаПриемник = КаталогПриемник + ИмяФайла_П;
		//ПереместитьФайл(Файл.ПолноеИмя, ИмяФайлаПриемник); 
		
Попытка
    КопироватьФайл(Файл.ПолноеИмя, ИмяФайлаПриемник);
Исключение
    Сообщить("Ошибка копирования: " + ОписаниеОшибки());    
    Возврат Неопределено;
КонецПопытки;
Попытка
    УдалитьФайлы(Файл.ПолноеИмя);
Исключение
    Сообщить("Ошибка удаления: " + ОписаниеОшибки());
//    Возврат Неопределено;
КонецПопытки;
		               
		ПутьДоФото = ИмяФайла_П;
		
		Возврат ПутьДоФото; 
	КонецЕсли;

	НомерФайла = НомерФайла + 1;
КонецЦикла;

КонецФункции

&НаКлиенте
Функция ПереместитьФайлВПутьДоФото_1(Файл, КаталогПриемник, ГУИДКлиентаСтрока, КаталогАрхив)
ИмяФайла = Файл.Имя;
ИмяФайла = ГУИДКлиентаСтрока + "_" + ИмяФайла; 

НомерФайла = 0;
Пока Истина Цикл
	Если НомерФайла = 0 Тогда 
		ИмяФайла_П = ИмяФайла;
	Иначе
		ИмяФайла_П = ИмяФайла + "_" + Строка(НомерФайла);
	КонецЕсли;
	
	ПоискФайлов = НайтиФайлы(КаталогПриемник, ИмяФайла_П);
	Если ПоискФайлов.Количество() = 0 Тогда
		ИмяФайлаАрхив = КаталогАрхив + Файл.Имя;
		КопироватьФайл(Файл.ПолноеИмя, ИмяФайлаАрхив);
		
		ИмяФайлаПриемник = КаталогПриемник + ИмяФайла_П;
		ПереместитьФайл(Файл.ПолноеИмя, ИмяФайлаПриемник); 
		
		ПутьДоФото = ИмяФайла_П;
		
		Возврат ПутьДоФото; 
	КонецЕсли;

	НомерФайла = НомерФайла + 1;
КонецЦикла;

КонецФункции

&НаСервере
Функция ГУИДКлиентаСтрока(Клиент)
ГУИД = Клиент.УникальныйИдентификатор();

ГУИДКлиентаСтрока = Строка(ГУИД);
	
Возврат ГУИДКлиентаСтрока;	
КонецФункции


&НаКлиенте
Функция ЕстьФормаКлиента(Клиент)  
Окна = ПолучитьОкна();
Для Каждого ТекущееОкно Из Окна Цикл
	Если ТекущееОкно.Содержимое.Количество() > 0 Тогда
		ЭтоФормаКлиента = Ложь;
		Для каждого Форма Из ТекущееОкно.Содержимое Цикл
			Если Форма.Заголовок = "Клиент" Тогда ЭтоФормаКлиента = Истина; Прервать; КонецЕсли; 
		КонецЦикла;
		
		Если ЭтоФормаКлиента Тогда
			ФормаОбъект = Форма.Объект;
			ФормаКлиент = ОбщийФункционалСервер.ЗначениеРеквизитаНаСервере(ФормаОбъект, "Ссылка");			
			
			Если ФормаКлиент = Клиент Тогда
				Возврат Истина;
			КонецЕсли;	
			
		КонецЕсли;
	КонецЕсли;
КонецЦикла;	

Возврат Ложь;
КонецФункции

&НаСервере
Процедура ЗаписатьКлиентСканыДокументов(Счетчик, ПутьДоФото)
СтрФото = Объект.СканыДокументов[Счетчик]; 

Об = СтрФото.Клиент.ПолучитьОбъект();
НовФ=Об.СканыДокументов.Добавить();
НовФ.ПутьДоФото= ПутьДоФото;

НовФ.Комментарий=СтрФото.Комментарий;
Об.Записать();
КонецПроцедуры	


