				КонецЕсли;
			КонецЦикла;	

		КонецЕсли;	
	КонецЕсли;  
	
	СтрокаОтчетаПараметры.СуммаНДС = СуммаНДС;  

	СтрокаОтчетаПараметры.СуммаОплачено = Строка.СуммаОплачено;
	
