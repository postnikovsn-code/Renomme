&НаКлиенте
Процедура ПечатьСчетаКоворкинг(Форма, ДокументДолгСсылка) Экспорт
ДокументДолгОбъектПараметр = ДокументДолгСсылка;

Контрагент = КоворкингСервер.ОплачиваетСчет(ДокументДолгСсылка);	

ТабличныйДокумент = КоворкингПечатьСервер.ТабличныйДокументСчетКоворкинг(ДокументДолгСсылка);

ОткрытьФормуПечатьСчетаКоворкинг(Форма, ДокументДолгСсылка, Контрагент, ТабличныйДокумент);
КонецПроцедуры

&НаКлиенте
Процедура ОткрытьФормуПечатьСчетаКоворкинг(Форма, ДокументДолгСсылка, Контрагент, ТабличныйДокумент
	, НаАнглийском = Ложь) Экспорт
ПараметрыФормы = Новый Структура;
ПараметрыФормы.Вставить("ТабличныйДокумент", ТабличныйДокумент); 

ПараметрыФормы.Вставить("ДокументДолгСсылка", ДокументДолгСсылка);
ПараметрыФормы.Вставить("СчетГУИД", Неопределено);

ПараметрыФормы.Вставить("Контрагент", Контрагент);

ПараметрыФормы.Вставить("НаАнглийском", НаАнглийском);

ОткрытьФорму("ОбщаяФорма.ПечатьИОтправкаНаПочтуСчетаИПодтверждения", ПараметрыФормы, Форма
	, Истина,,,, РежимОткрытияОкнаФормы.Независимый); 
КонецПроцедуры

&НаКлиенте
Процедура ПечатьАкта(Команда)
Если НЕ ЭтаФорма.Записать(Новый Структура("РежимЗаписи", РежимЗаписиДокумента.Проведение)) Тогда Возврат; КонецЕсли;	

ДанныеОбъект = Объект;
ТабличныйДокумент = КоворкингПечатьСервер.ПечатьАктаДействие(ДанныеОбъект);
Если ТабличныйДокумент = Неопределено Тогда Возврат; КонецЕсли;	

ПараметрыФормы = Новый Структура("ПолеОтчета, ЗаголовокОтчета", ТабличныйДокумент, "Акт");
ОткрытьФорму("ОбщаяФорма.ВыводОтчета", ПараметрыФормы, ЭтаФорма, Истина); 
КонецПроцедуры

&НаКлиенте
Процедура Тест(Команда)

КонецПроцедуры


&НаКлиенте
Процедура ПечатьСчетаФактуры(Команда)
Если НЕ ЭтаФорма.Записать(Новый Структура("РежимЗаписи", РежимЗаписиДокумента.Проведение)) Тогда Возврат; КонецЕсли;	
	
ТабДок = Новый ТабличныйДокумент; 

Номер = ОбщийФункционалКлиентСервер.УбратьНезначащиеНули(Объект.Номер);
Дата = НачалоДня(Объект.ДатаПо);

ДокументОтгрузки = "Акт № " + Номер + " от " + Дата;

Если ЗначениеЗаполнено(Объект.ОплачиваетСчет) Тогда
	Контрагент = Объект.ОплачиваетСчет;
Иначе
	Контрагент = ?(ЗначениеЗаполнено(Объект.КоворкингЗаявка.Оплачивает), Объект.КоворкингЗаявка.Оплачивает
			, Объект.КоворкингЗаявка.Клиент);
КонецЕсли;	
	
КоворкингПечатьСервер.ПечатьСчетаФактуры(ТабДок, Номер, Дата, Контрагент, ДокументОтгрузки, Объект.Ссылка);
Если ТабДок = Неопределено Тогда Возврат; КонецЕсли;	

ТабДок.Показать("Счет-Фактура");
КонецПроцедуры








