Процедура КонтрольЧасы(ЧасИмяРеквизита, ЧасНаименованиеРеквизита)
//Если Объект.ЧасС = 0 ИЛИ Объект.ЧасПо = 0 Тогда 
//	
//	СчетСуммаКоличествоЧасы(Истина);
//	Возврат; 
//КонецЕсли;

НачальныйЧасКонечныйЧас = КоворкингСервер.НачальныйЧасКонечныйЧас();
Если Объект[ЧасИмяРеквизита] < НачальныйЧасКонечныйЧас.НачальныйЧас
ИЛИ Объект[ЧасИмяРеквизита] > НачальныйЧасКонечныйЧас.КонечныйЧас
Тогда  	
	Час_OldValue = ОбщийФункционалСервер.ЗначениеРеквизитаНаСервере(Объект.Ссылка, "ЧасС");
	Объект[ЧасИмяРеквизита] = Час_OldValue;
	
	//СчетСуммаКоличествоЧасы(Истина);
	Возврат;
КонецЕсли;

Если Объект.ДатаС = Объект.ДатаПо Тогда
	Если Объект.ЧасС > Объект.ЧасПо Тогда 
		ПоказатьПредупреждение(, "'Час С' БОЛЬШЕ 'Час По'.
			|
			|ИЗМЕНЕНИЕ НЕ РАЗРЕШЕНО ...");
		
		Дата_OldValue = ОбщийФункционалСервер.ЗначениеРеквизитаНаСервере(Объект.Ссылка, ЧасИмяРеквизита);
		Объект[ЧасИмяРеквизита] = Дата_OldValue;
		
		//СчетСуммаКоличествоЧасы(Истина);
		Возврат; 
	КонецЕсли;
КонецЕсли;

Если КоворкингСервер.ЕстьОплатыСчет(Объект.Ссылка) Тогда
	ПоказатьПредупреждение(, "Есть оплаты счета.
		|
		|ИЗМЕНЕНИЕ НЕ РАЗРЕШЕНО ...
		|
		|Для изменения " + ЧасНаименованиеРеквизита + " удалите оплаты.");
	
	Час_OldValue = ОбщийФункционалСервер.ЗначениеРеквизитаНаСервере(Объект.Ссылка, ЧасИмяРеквизита);
	Объект[ЧасИмяРеквизита] = Дата_OldValue;
	
	//СчетСуммаКоличествоЧасы(Истина);
	Возврат;
КонецЕсли;	

СчетСуммаКоличествоЧасы(Ложь);
КонецПроцедуры

