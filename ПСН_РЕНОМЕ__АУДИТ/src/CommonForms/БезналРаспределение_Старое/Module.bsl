ВыгрузкаПлатежиПолучательПлатежаВсе = Истина;
ВыгрузкаПлатежиТолькоНовые = Истина;
//

//
ВыпискаОплатыТолькоНезакрытые = Истина;
ВыпискаОплатыВсе = Ложь;
ВыпискаСчетаВсе = Ложь;
//

//
ЭквайрингВыгрузкаПлатежиТолькоНеотмененные = Истина;
ЭквайрингВыгрузкаПлатежиТолькоС2022 = Истина;

ЭквайрингВыгрузкаПлатежиПолучательПлатежаВсе = Истина;
ЭквайрингВыгрузкаПлатежиТолькоНезакрытые = Истина;
ЭквайрингВыпискаСчетаВсе = Ложь;
//

ПолучательПлатежа_Смешанный = "СМЕШАННЫЙ";
ЗагрузитьБезналНастройки();

ПолучательПлатежаБезнал = Константы.ПолучательПлатежаБезнал.Получить();
//КаталогОбменаFTP = Константы.КаталогОбменаFTP.Получить(); 

Если БезналНастройки.Количество() = 0 
ИЛИ ПолучательПлатежаБезнал = "" 
//ИЛИ КаталогОбменаFTP = "" 
Тогда
	Сообщить("ДЛЯ РАСПРЕДЕЛЕНИЯ БЕЗНАЛА НЕОБХОДИМО ВЫПОЛНИТЬ НАСТРОЙКУ БЕЗНАЛА ... ");
	
	Отказ = Истина;
	Возврат;	
КонецЕсли;

ОтборСтроки = Новый Структура("ПолучательПлатежаЗначениеСпискаВыбора", ПолучательПлатежаБезнал);
НайденныеСтроки = БезналНастройкиРаспределениеПлатежей.НайтиСтроки(ОтборСтроки);
Если НайденныеСтроки.Количество() = 0 Тогда
	Сообщить("НЕКОРЕКТНОЕ ЗНАЧЕНИЕ КОНСТАНТЫ 'Получатель платежа безнал': " + ПолучательПлатежаБезнал);

	Отказ = Истина;
	Возврат;	
КонецЕсли;

ЭлементТаблица = Элементы.ВыгрузкаПлатежи; ИмяПеред = ЭлементТаблица.Имя + "ДокументОплаты";
ДобавитьСуммыПолучателейПлатежа("ВыгрузкаПлатежи", ЭлементТаблица, ИмяПеред);

ЭлементТаблица = Элементы.ЭквайрингВыгрузкаПлатежи; ИмяПеред = ЭлементТаблица.Имя + "ГУИД";
ДобавитьСуммыПолучателейПлатежа("ЭквайрингВыгрузкаПлатежи", ЭлементТаблица, ИмяПеред);

Для Каждого Строка Из БезналНастройкиСписокВыбора Цикл
	Элемент = Строка.ПолучательПлатежаЗначениеСпискаВыбора;
	
	Элементы.ВыгрузкаПлатежиПолучательПлатежа.СписокВыбора.Добавить(Элемент);
	Элементы.ВыгрузкаПлатежиПолучательПлатежаОтбор.СписокВыбора.Добавить(Элемент);
	
	Элементы.ЭквайрингВыгрузкаПлатежиПолучательПлатежа.СписокВыбора.Добавить(Элемент);
	Элементы.ЭквайрингВыгрузкаПлатежиПолучательПлатежаОтбор.СписокВыбора.Добавить(Элемент);
КонецЦикла;

ОтчетДатаПо = ТекущаяДата();

ВыпискаКонтрагент_Предыдущий = Неопределено;	

ПолучательПлатежа_Константа = Константы.ПолучательПлатежаБезнал.Получить();	

УсловноеОформление.Элементы.Очистить();
УсловноеОформлениеЗагрузить_ЗащитаСуммыПолучателейПлатежа("ВыгрузкаПлатежи");  
УсловноеОформлениеЗагрузить_ЗащитаСуммыПолучателейПлатежа("ЭквайрингВыгрузкаПлатежи");

ВыгрузкаЗагрузитьПлатежиНаСервере();
КонецПроцедуры

&НаСервере
Процедура ЗагрузитьБезналНастройки()
Запрос = Новый Запрос("ВЫБРАТЬ
                      |	БезналНастройки.Идентификатор КАК Идентификатор,
                      |	БезналНастройки.ПолучательПлатежа КАК ПолучательПлатежа,
                      |	БезналНастройки.ИмяРеквизитаФормы КАК ИмяРеквизитаФормы,
                      |	БезналНастройки.ИмяРеквизитаДанные КАК ИмяРеквизитаДанные,
                      |	БезналНастройки.Заголовок КАК Заголовок,
                      |	БезналНастройки.ПолучательПлатежаЗначениеСпискаВыбора КАК ПолучательПлатежаЗначениеСпискаВыбора,
                      |	БезналНастройки.НомерПоПорядкуСписокВыбора КАК НомерПоПорядкуСписокВыбора
                      |ИЗ
                      |	РегистрСведений.БезналНастройки КАК БезналНастройки
                      |
                      |УПОРЯДОЧИТЬ ПО
                      |	БезналНастройки.НомерПоПорядкуСписокВыбора");

ТЗ = Запрос.Выполнить().Выгрузить();

Массив = Новый Массив;
Массив.Добавить(Тип("Число"));
ОписаниеТиповЧ = Новый ОписаниеТипов(Массив, , ,Новый КвалификаторыЧисла(10,2));

Для Каждого Строка Из ТЗ Цикл
	НоваяСтрока = БезналНастройки.Добавить();
	ЗаполнитьЗначенияСвойств(НоваяСтрока, Строка);
	
	НоваяСтрока = БезналНастройкиСписокВыбора.Добавить();
	ЗаполнитьЗначенияСвойств(НоваяСтрока, Строка);
	
	Если Строка.ПолучательПлатежа = "" Тогда Продолжить; КонецЕсли;
	
	НоваяСтрока = БезналНастройкиРаспределениеПлатежей.Добавить();
	ЗаполнитьЗначенияСвойств(НоваяСтрока, Строка);	
	
	НоваяСтрока.ТипЗначения = ОписаниеТиповЧ;
КонецЦикла;

НоваяСтрока = БезналНастройкиСписокВыбора.Добавить();
НоваяСтрока.ПолучательПлатежаЗначениеСпискаВыбора = ПолучательПлатежа_Смешанный;
КонецПроцедуры	

&НаСервере
Функция ДобавитьСуммыПолучателейПлатежа(ИмяТаблицы, ЭлементТаблица, ИмяПеред)
ДополнительныеКолонки = БезналНастройкиРаспределениеПлатежей;

Массив = Новый Массив;
Массив.Добавить(Тип("Булево"));
ОписаниеТиповБулево = Новый ОписаниеТипов(Массив);

ДобавляемыеРеквизиты = Новый Массив; 
Для Каждого Строка ИЗ ДополнительныеКолонки Цикл
	ДобавляемыеРеквизиты.Добавить(Новый РеквизитФормы(Строка.ИмяРеквизитаФормы, Строка.ТипЗначения, ИмяТаблицы));
	
	ДобавляемыеРеквизиты.Добавить(Новый РеквизитФормы(Строка.ИмяРеквизитаФормы + "_OldValue", Строка.ТипЗначения, ИмяТаблицы));
	ДобавляемыеРеквизиты.Добавить(Новый РеквизитФормы(Строка.ИмяРеквизитаФормы + "_ТолькоПросмотр", ОписаниеТиповБулево, ИмяТаблицы));
КонецЦикла;

ИзменитьРеквизиты(ДобавляемыеРеквизиты);

Для Каждого Строка ИЗ ДополнительныеКолонки Цикл
	ЭлементПеред = Элементы[ИмяПеред];
	Реквизит = Элементы.Вставить(ЭлементТаблица.Имя + Строка.ИмяРеквизитаФормы, Тип("ПолеФормы"), ЭлементТаблица, ЭлементПеред);
	Реквизит.Вид = ВидПоляФормы.ПолеВвода;
	Реквизит.ПутьКДанным = ИмяТаблицы + "." + Строка.ИмяРеквизитаФормы;
	Реквизит.Заголовок = Строка.Заголовок;
КонецЦикла;
КонецФункции
