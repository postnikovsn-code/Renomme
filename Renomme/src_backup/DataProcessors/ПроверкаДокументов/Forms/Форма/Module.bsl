&НаКлиенте
Процедура ПроверитьВыписки(Команда)
	ПроверитьВыпискиНаСервере();
	
	ЭтаФорма.ТекущийЭлемент = Элементы.ОшибкиВыпискаБанка;
КонецПроцедуры

&НаСервере
Процедура ПроверитьВыпискиНаСервере()
Запрос = Новый Запрос("ВЫБРАТЬ
                      |	ВыпискаБанка.Ссылка КАК Ссылка
                      |ИЗ
                      |	Документ.ВыпискаБанка КАК ВыпискаБанка
                      |ГДЕ
                      |	ВыпискаБанка.ПометкаУдаления = ЛОЖЬ
                      |	И ВыпискаБанка.ДатаОплаты >= &ДатаС
                      |	И ВыпискаБанка.ДатаОплаты <= &ДатаПо");	

Запрос.УстановитьПараметр("ДатаС", ДатаС);
Запрос.УстановитьПараметр("ДатаПо", ДатаПо);

ТЗ_ДокументыОплаты = Запрос.Выполнить().Выгрузить();

ПроверитьДокументыОплаты(ТЗ_ДокументыОплаты, ОшибкиВыпискаБанкаТаблица, "ВыпискаБанка");
КонецПроцедуры

&НаКлиенте
Процедура ОшибкиВыпискиТаблицаВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
ТД = Элемент.ТекущиеДанные;

ПараметрыФормы = Новый Структура("Ключ", ТД.ВыпискаБанка); 
ОткрытьФорму("Документ.ВыпискаБанка.Форма.ФормаДокумента", ПараметрыФормы);
КонецПроцедуры
