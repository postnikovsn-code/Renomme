Функция ЗаписатьПолученныеДанные(Данные, ПолучательПлатежаПриемник) Экспорт
БезналЗагрузка = Данные;

БезналЗагрузка.ОбменДанными.Загрузка = Истина;

Если БезналЗагрузка.Количество() > 0 Тогда
	БезналЗагрузкаДанные = БезналЗагрузка[0];
	Если БезналЗагрузкаДанные.ПолучательПлатежа = ПолучательПлатежаПриемник 
	ИЛИ БезналЗагрузкаДанные.ПолучательПлатежа = "СМЕШАННЫЙ" 	
	Тогда 
		БезналЗагрузкаДанные.ДатаИзменения = ТекущаяДата();
	
		БезналЗагрузкаДанные.ДатаЗагрузки = ТекущаяДата();
		//БезналЗагрузкаДанные.ИсточникПлатежа = ИсточникПлатежа;

		БезналЗагрузка.Записать(Истина);
		
		Возврат 1;
	Иначе
		
		БезналЗагрузка.Удалить(БезналЗагрузкаДанные);
		БезналЗагрузка.Записать(Истина);
		Возврат -1;
		
	Конецесли;
Иначе
	БезналЗагрузкаРегистр = РегистрыСведений.БезналЗагрузка.СоздатьНаборЗаписей();
	БезналЗагрузкаРегистр.Отбор.ГУИД.Установить(БезналЗагрузка.Отбор.ГУИД.Значение);
	БезналЗагрузкаРегистр.Прочитать();
	
	Для Каждого Строка Из БезналЗагрузкаРегистр Цикл
		БезналЗагрузкаРегистр.Удалить(Строка);
	КонецЦикла;
	
	БезналЗагрузкаРегистр.Записать(Истина);
	Возврат -1;
КонецЕсли;

КонецФункции

