Если Очистить Тогда 
	Объект.КоличествоЕдиниц = 0; 
	Объект.Количество = 0; 
	Объект.Сумма = 0;
	
	Возврат; 
КонецЕсли;	

РазницаЕдиницы = Объект.ЧасПо - Объект.ЧасС;
Если Объект.ДатаС <> Объект.ДатаПо Тогда 
