 
&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
Если Параметры.Свойство("ЗаявкаСайт", ЗаявкаСайт) Тогда
	ЗаявкаСайтФамилия = ЗаявкаСайт.Фамилия;		
	ЗаявкаСайтИмя = ЗаявкаСайт.Имя;		
	ЗаявкаСайтТелефон = ЗаявкаСайт.Телефон;		
	ЗаявкаСайтEMail = ЗаявкаСайт.EMail;		
КонецЕсли;
	
Если РаботаСИнтерфейсомСервер.УстановитьТолькоПросмотр(ЭтаФорма) Тогда Отказ = Истина; Возврат; КонецЕсли;
	
Параметры.Свойство("ВызовИзКлиенты", ВызовИзКлиенты);

ТипВизыФМС_OldValue = Объект.ТипВизыФМС_NEW;

Папка_BASE = Константы.Папка_C_BASE.Получить();

//КаталогФото = Папка_BASE + "SCAN\";
КаталогФото = СлужебныеСервер.КаталогСканов();   

Если НастройкиСервер.ЭтоРеноме() Тогда
    Видимость_П = Истина;
Иначе
	Видимость_П = Ложь;
КонецЕсли;

Элементы.ФормаСканироватьРазворотПаспорта.Видимость = Видимость_П;
Элементы.ФормаСканироватьРегистрациюПаспорта.Видимость = Видимость_П;

КонецПроцедуры

//
&НаКлиенте
Процедура ПриОткрытии(Отказ)
Если ВызовИзКлиенты Тогда	
	ЭтаФорма.Ширина = 170;
	ЭтаФорма.Высота = 60;

	ОбъектShell = Новый COMОбъект("Wscript.Shell");
	ОбъектShell.SendKeys("+%{R}");

Иначе
	
	Если НЕ ЗначениеЗаполнено(Объект.Ссылка) Тогда
		Если ЗначениеЗаполнено(ЗаявкаСайт) Тогда
			ЭтаФорма.Ширина = 170;
			ЭтаФорма.Высота = 60;

			ОбъектShell = Новый COMОбъект("Wscript.Shell");
			ОбъектShell.SendKeys("+%{R}");
			
			Объект.ТипКлиента = ПредопределенноеЗначение("Перечисление.ТипыКлиентов.ФизЛицо");
			
			Объект.Фамилия = ЗаявкаСайтФамилия; 
			Объект.Имя = ЗаявкаСайтИмя; 
			Наименование = ОбщийФункционалКлиентСервер.ДобавитьТекст(ЗаявкаСайтФамилия, ЗаявкаСайтИмя, " "); 
			Объект.Наименование = Наименование; 
			
			Объект.Телефон = ЗаявкаСайтТелефон; 
			
			Объект.ЭлПочта = ЗаявкаСайтEMail; 
			
		Иначе		
			Оповещение = Новый ОписаниеОповещения("ОповещениеПослеВводаЗначения", ЭтотОбъект);	
			  
			ТипЗначения = Тип("ПеречислениеСсылка.ТипыКлиентов");
		    ПоказатьВводЗначения(Оповещение,
		        , // пропускаем начальное значение
		        "Физ лицо или Юр лицо ?",
		        ТипЗначения
		    );
			
			Возврат;
		КонецЕсли;		
	КонецЕсли;	
КонецЕсли;

УстановитьПриОткрытии();

Объект_П = Объект;
ТекстОшибки = ДокументыСервер.ПроверитьКонтрагента(Объект_П);

Если ТекстОшибки <> "" Тогда
	ПоказатьПредупреждение(, ТекстОшибки + "
		|
		|ИСПРАВЬТЕ ОШИБКИ ...");
КонецЕсли;	
КонецПроцедуры

&НаКлиенте
Процедура ОповещениеПослеВводаЗначения(Результат, Параметры) Экспорт
Если Результат = Неопределено Тогда 
	ЭтаФорма.Закрыть(); 
	Возврат;	
КонецЕсли;

Объект.ТипКлиента = Результат;

УстановитьГруппаГости();

УстановитьПриОткрытии();
КонецПроцедуры

&НаКлиенте
Процедура УстановитьГруппаГости()
Если Объект.ТипКлиента = ПредопределенноеЗначение("Перечисление.ТипыКлиентов.ФизЛицо") Тогда
	Если НЕ ЗначениеЗаполнено(Объект.Родитель) Тогда
		ГруппаГости = ГруппаГости();
		Если ЗначениеЗаполнено(ГруппаГости) Тогда
			Объект.Родитель = ГруппаГости; 
		КонецЕсли;
	КонецЕсли;
КонецЕсли;
КонецПроцедуры

&НаСервереБезКонтекста
Функция ГруппаГости()
Запрос = Новый Запрос("ВЫБРАТЬ
                      |	Клиенты.Ссылка КАК Ссылка
                      |ИЗ
                      |	Справочник.Клиенты КАК Клиенты
                      |ГДЕ
                      |	Клиенты.ЭтоГруппа = Истина
                      |	И Клиенты.ПрограммныйКод = &ПрограммныйКод");

ПрограммныйКод = Константы.КлиентыГруппаГости.Получить();
Запрос.УстановитьПараметр("ПрограммныйКод", ПрограммныйКод); 
Выборка = Запрос.Выполнить().Выбрать();
Если Выборка.Следующий() Тогда 
	Возврат Выборка.Ссылка;
Иначе	
	Возврат Неопределено;
КонецЕсли;
КонецФункции

&НаКлиенте
Процедура УстановитьПриОткрытии()
УстановитьВидимостьЭлементов();
ТурагенствоПриИзменении(Неопределено);

// + Настройка Формы
ИностранныйГражданинПриИзменении(Неопределено);

УстановитьТипДокументаФМС();
УстановитьВидДокументаНаПребываниеФМС();
УстановитьПредставительТипДокументаФМС();
//

ИзЗагрузки = (Объект.ЗагрузкаГИУДСтрока <> "");
ОбновитьПолнаяПапкаРодитель();

ТекФото = 0;
Если Объект.СканыДокументов.Количество()>0 тогда
	ПутьДоФото = ПолучитьПутьДоСканаДокумента();
	
	Если НЕ ПоказатьКартинку(ПутьДоФото, Фото_1) Тогда ПоказатьКартинку(ПутьДоФото, Фото_2); КонецЕсли;
КонецЕсли;	
КонецПроцедуры

&НаСервере
Процедура УстановитьВидимостьЭлементов()

Если Объект.ТипКлиента=Перечисления.ТипыКлиентов.ФизЛицо тогда
	Элементы.СтраницаОсновнаяИнформация.Видимость = Истина;
	Элементы.СтраницаЮрЛицо.Видимость = Ложь;
	
	Элементы.СтраницаПаспортныеДанные.Видимость = Истина;
	Элементы.СтраницаИностранныйГражданин.Видимость = Объект.ИностранныйГражданин;
	Элементы.СтраницаЗаконныйПредставитель.Видимость = Истина;
Иначе
	Элементы.СтраницаОсновнаяИнформация.Видимость = Ложь;
	Элементы.СтраницаЮрЛицо.Видимость = Истина;
	
	Элементы.СтраницаПаспортныеДанные.Видимость = Ложь;
	Элементы.СтраницаИностранныйГражданин.Видимость = Ложь;
	Элементы.СтраницаЗаконныйПредставитель.Видимость = Ложь;
КонецЕсли;

Элементы.НаименованиеЮрЛица.Видимость=?(Объект.ТипКлиента=Перечисления.ТипыКлиентов.ЮрЛицо,Истина,Ложь);

Элементы.ФИО.Видимость=?(Объект.ТипКлиента=Перечисления.ТипыКлиентов.ЮрЛицо,Ложь,Истина);

ОбновитьШрифт();
Элементы.ЦветКлиента.ЦветФона = Новый Цвет(Объект.ЦветR, Объект.ЦветG, Объект.ЦветB);
Элементы.ЦветКлиента.ЦветТекста = ОбщийФункционалСервер.ПолучитьЦветТекстаПоЦветуФона(Элементы.ЦветКлиента.ЦветФона);

ОбновитьБонусы();
КонецПроцедуры

&НаКлиенте
Процедура ОбновитьПолнаяПапкаРодитель()
ТекущийРодитель = "";
ОбщийФункционалСервер.ПолнаяПапкаРодитель(Объект.Ссылка, ТекущийРодитель);
ПолнаяПапкаРодитель = ТекущийРодитель;
КонецПроцедуры

&НаСервере
Процедура ОбновитьШрифт()
Для каждого Эл Из Элементы Цикл
	Попытка
		Если ТипЗнч(Эл)=Тип("ПолеВводаФормы") тогда
			Если Эл.Значение<>"" тогда
				Эл.Шрифт=Новый Шрифт(Эл.Шрифт,,,Истина);	
			Конецесли;
		Конецесли;
	Исключение
	КонецПопытки;
КонецЦикла; 
КонецПроцедуры

&НаСервере
Процедура ОбновитьБонусы()
	
Возврат;	
	
Попытка
	База =СлужебныеСервер.ConnectБаза_BONUS();;
	
	Рез=База.ИсторияПоКлиенту(Объект.Код);
	ИсторияБаллов.Очистить();
	Если Рез<>"Клиент отсутствует в базе" Тогда
		
		БаллыИтого = 0;
		Для каждого Стр Из Рез Цикл
		    НовНач=ИсторияБаллов.Добавить();
			НовНач.Дата=Стр.Дата;
			НовНач.Отель=Стр.Отель;
			НовНач.Баллы=Стр.Баллы;
			НовНач.Основание=Стр.Основание;
			БаллыИтого=БаллыИтого+Стр.Баллы;
		КонецЦикла; 
		
		Элементы.НадписьБаллы.Заголовок="Текущие баллы - "+ Формат(БаллыИтого, "ЧГ=");
		Элементы.ЗарегистрироватьВБонуснойБазе.Доступность=Ложь;
	КонецЕсли;
Исключение	
	Сообщить("Нет связи с БД Бонусы"); 
КонецПопытки;
	
КонецПроцедуры     
//

&НаКлиенте
Процедура ЭлПочтаПриИзменении(Элемент)
ЭлПочтаПроверка();
КонецПроцедуры

&НаКлиенте
Процедура ЭлПочтаПроверка()
Объект.ЭлПочта = СокрЛП(Объект.ЭлПочта);
	
Если ЗначениеЗаполнено(Объект.ЭлПочта) Тогда	
	Попытка 
		PayKeeper.ПроверитьПараметр("PayKeeperСервер.ОтправитьВPayKeeperДолг", "EmailОтсылкиЧека", Объект.ЭлПочта
			, Тип("Строка"),, "^[a-zA-Z0-9.!#$%&’*+/=?^_`{|}~-]+@[a-zA-Z0-9-]+(?:\.[a-zA-Z0-9-]+)*$");

	Исключение
		Сообщить("Некорректный Email. "); // + ОписаниеОшибки(); 		
		
		Объект.ЭлПочта = "";
	КонецПопытки;	
КонецЕсли;	
КонецПроцедуры

&НаКлиенте
Процедура ЭлПочта_ЮрЛицоПриИзменении(Элемент)
ЭлПочтаПроверка();
КонецПроцедуры

////
&НаКлиенте
Процедура ПередЗаписью(Отказ, ПараметрыЗаписи) 
КлиентПоНаименованию = КлиентПоНаименованию();

Если НЕ КлиентПоНаименованию = Неопределено Тогда
	Если ТипЗнч(КлиентПоНаименованию) = Тип("Число") Тогда
		ПоказатьПредупреждение(, "Есть Клиенты с таким наименованием в количестве: " + КлиентПоНаименованию);
		
		Возврат;
	Иначе	
		ДопПараметры = КлиентПоНаименованию; 
		Оповещение = Новый ОписаниеОповещения("ОповещениеОткрытиеКарточкиКлиента", ЭтотОбъект, ДопПараметры); 
		ПоказатьПредупреждение(Оповещение, "Клиент с таким наименованием уже существует ! 
		|
		|Открывается его карточка.");
		
		Отказ = Истина;	
		Возврат;
	КонецЕсли;
КонецЕсли;

Если НЕ (СокрЛП(Объект.ИНН) = "" ИЛИ Объект.ИНН = "0") Тогда  
	КлиентПоИННСсылка = КлиентПоИННКППСсылка();

	Если НЕ КлиентПоИННСсылка = Неопределено Тогда
		ДопПараметры = КлиентПоИННСсылка; 
		Оповещение = Новый ОписаниеОповещения("ОповещениеОткрытиеКарточкиКлиента", ЭтотОбъект, ДопПараметры); 
		ПоказатьПредупреждение(Оповещение, "Есть клиент с таким ИНН: " + Объект.ИНН + " и КПП: " + Объект.КПП + "
		|
		|Открывается его карточка.");
		                                           
		Отказ = Истина;
		Возврат;
	КонецЕсли;
КонецЕсли;

Объект_П = Объект;
ТекстОшибки = ДокументыСервер.ПроверитьКонтрагента(Объект_П); 
Если ТекстОшибки <> "" Тогда 
	ПоказатьПредупреждение(, ТекстОшибки + "
		|
		|ЗАПИСЬ ОТМЕНЯЕТСЯ ...");
	
	Отказ = Истина;
	Возврат;
КонецЕсли;	
КонецПроцедуры

&НаКлиенте
Процедура ОповещениеОткрытиеКарточкиКлиента(ДополнительныеПараметры) Экспорт
Ссылка = ДополнительныеПараметры;	

ОткрытиеКарточкиКлиента(Ссылка);
КонецПроцедуры

&НаКлиенте
Процедура ОткрытиеКарточкиКлиента(Ссылка) Экспорт
Парам = Новый Структура("Ключ", Ссылка);
Парам.Вставить("ВызовИзКлиенты", Истина);	

Оповещение = Новый ОписаниеОповещения("ЗакрытиеКарточкиКлиента", ЭтаФорма);
ОткрытьФорму("Справочник.Клиенты.Форма.ФормаЭлемента", Парам, ЭтаФорма
	,,,, Оповещение,РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);  
КонецПроцедуры

&НаКлиенте
Процедура ЗакрытиеКарточкиКлиента(Результат, ДополнительныеПараметры) Экспорт
Если Результат = Неопределено Тогда Возврат; КонецЕсли;
	
Закрыть(Результат);	
КонецПроцедуры


&НаСервере
Функция КлиентПоНаименованию()
Если Объект.Наименование="" тогда
	Если Объект.ТипКлиента=Перечисления.ТипыКлиентов.ФизЛицо Тогда
		Объект.Наименование = Объект.Фамилия + " " + Объект.Имя + " " + Объект.Отчество;
	Иначе
		Объект.Наименование = Объект.НаименованиеЮрЛица;
	КонецЕсли;
КонецЕсли;

Если СокрЛП(Объект.Наименование) = "" Тогда Возврат Неопределено; КонецЕсли;

Если НЕ ЗначениеЗаполнено(Объект.Ссылка) Тогда
	ЗапросПоиска=Новый Запрос("ВЫБРАТЬ
	                          |	Клиенты.Ссылка КАК Ссылка
	                          |ИЗ
	                          |	Справочник.Клиенты КАК Клиенты
	                          |ГДЕ
	                          |	Клиенты.Ссылка <> &Ссылка
	                          |	И Клиенты.Наименование = &Наименование
	                          |	И Клиенты.ЭтоГруппа = ЛОЖЬ");
							  //|	И Клиенты.Наименование ПОДОБНО &Наименование
	ЗапросПоиска.УстановитьПараметр("Ссылка",Объект.Ссылка);							  
	//ЗапросПоиска.УстановитьПараметр("Наименование", "%" + Объект.Наименование + "%");
	ЗапросПоиска.УстановитьПараметр("Наименование", Объект.Наименование);
	ТЗПоиск=ЗапросПоиска.Выполнить().Выгрузить();
	
	//Если ТЗПоиск.Количество() > 0 Тогда Возврат ТЗПоиск[0].Ссылка; КонецЕсли;
	Если ТЗПоиск.Количество() = 0 Тогда 
		Возврат Неопределено;
	ИначеЕсли ТЗПоиск.Количество() = 1 Тогда 
		Возврат ТЗПоиск[0].Ссылка; 
	Иначе
		Возврат ТЗПоиск.Количество(); 
	КонецЕсли;
	
ИначеЕсли Объект.ВидКлиента.Наименование <> "Исключить из отчетов" Тогда 
	ЗапросПоиска=Новый Запрос("ВЫБРАТЬ
	                          |	Клиенты.Ссылка КАК Ссылка
	                          |ИЗ
	                          |	Справочник.Клиенты КАК Клиенты
	                          |ГДЕ
	                          |	Клиенты.Ссылка <> &Ссылка
	                          |	И Клиенты.Наименование = &Наименование
	                          |	И Клиенты.ЭтоГруппа = ЛОЖЬ");
	ЗапросПоиска.УстановитьПараметр("Ссылка",Объект.Ссылка);							  
	//ЗапросПоиска.УстановитьПараметр("Наименование", "%" + Объект.Наименование + "%");
	ЗапросПоиска.УстановитьПараметр("Наименование", Объект.Наименование);
	ТЗПоиск=ЗапросПоиска.Выполнить().Выгрузить();
	
	//Если ТЗПоиск.Количество() > 0 Тогда	Возврат ТЗПоиск[0].Ссылка; КонецЕсли;
	Если ТЗПоиск.Количество() = 0 Тогда 
		Возврат Неопределено;
	ИначеЕсли ТЗПоиск.Количество() = 1 Тогда 
		Возврат ТЗПоиск[0].Ссылка; 
	Иначе
		Возврат ТЗПоиск.Количество(); 
	КонецЕсли;
КонецЕсли;

Возврат Неопределено;
КонецФункции
//

//
&НаКлиенте
Процедура ИННПриИзменении(Элемент)
ИНН_П = СокрЛП(Объект.ИНН);	
Если ИНН_П = "" Тогда Возврат; КонецЕсли; 	

ИННПриИзмененииОбработка(ИНН_П);
КонецПроцедуры

&НаКлиенте
Асинх Процедура ИННПриИзмененииОбработка(ИНН_П)

Если СтрДлина(ИНН_П) < 10 Тогда 
	ТекстВопроса = "ВНИМАНИЕ: Некорректный ИНН: " + Объект.ИНН;
	
	ТекстВопроса = ТекстВопроса + "
				|
				|ПОДТВЕРДИТЕ ...";

	Результат = Ждать ВопросАсинх(ТекстВопроса, РежимДиалогаВопрос.ОКОтмена);
	Если Результат = КодВозвратаДиалога.Отмена Тогда 
		ИНН_OldValue = ОбщийФункционалСервер.ЗначениеРеквизитаНаСервере(Объект.Ссылка, "ИНН");
		Объект.ИНН = ИНН_OldValue; 		
		
		Возврат; 
	КонецЕсли;
КонецЕсли;

КлиентПоИННСсылка = КлиентПоИННКППСсылка();
Если КлиентПоИННСсылка <> Неопределено Тогда
	ДопПараметры = КлиентПоИННСсылка; 
