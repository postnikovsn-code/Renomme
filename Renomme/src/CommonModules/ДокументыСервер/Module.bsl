Функция ЗанятостьНомераПериодРезерва(РезервС, РезервПо, ВремяЗаезда, ВремяВыезда)  Экспорт
Заезд=0;
Если ВремяЗаезда=Перечисления.ВремяЗаезда.Вр0 тогда
	Заезд=0;
иначеесли ВремяЗаезда=Перечисления.ВремяЗаезда.Вр6 тогда
	Заезд=6;
иначеесли ВремяЗаезда=Перечисления.ВремяЗаезда.Вр14 тогда
	//Заезд=12;
	Заезд=14;
иначеесли ВремяЗаезда=Перечисления.ВремяЗаезда.Вр18 тогда
	Заезд=18;
конецесли;

Выезд=0;
Если ВремяВыезда=Перечисления.ВремяВыезда.Вр0 тогда
	//Выезд=0;
	Выезд=24;
иначеесли ВремяВыезда=Перечисления.ВремяВыезда.Вр6 тогда
	Выезд=6;
иначеесли ВремяВыезда=Перечисления.ВремяВыезда.Вр12 тогда
	//Выезд=14;
	Выезд=12;
иначеесли ВремяВыезда=Перечисления.ВремяВыезда.Вр18 тогда
	Выезд=18;
конецесли;

НачалоПериодаРезерва = НачалоЧаса(НачалоДня(РезервС)+Заезд*3600);
КонецПериодаРезерва = НачалоЧаса(НачалоДня(РезервПо)+Выезд*3600);

ПериодРезерва = Новый Структура("НачалоПериодаРезерва, КонецПериодаРезерва", НачалоПериодаРезерва, КонецПериодаРезерва);
Возврат ПериодРезерва; 
КонецФункции	

Функция ЗанятостьНомераПроверить(РезервС, РезервПо, ВремяЗаезда, ВремяВыезда, НомерКуда, БонШанс, ТекущийРегистратор)  Экспорт
Ответ = ЗанятостьНомераПериодРезерва(РезервС, РезервПо, ВремяЗаезда, ВремяВыезда);

НачалоПериодаРезерва = Ответ.НачалоПериодаРезерва;
КонецПериодаРезерва = Ответ.КонецПериодаРезерва;

ЗапросСвободных=Новый Запрос("ВЫБРАТЬ
                             |	ЗанятостьНомеров.Номер КАК Номер,
                             |	ЗанятостьНомеров.Регистратор КАК Регистратор,
                             |	МАКСИМУМ(ЗанятостьНомеров.ПериодРезерва) КАК ПериодРезерваМаксимум,
                             |	МИНИМУМ(ЗанятостьНомеров.ПериодРезерва) КАК ПериодРезерваМинимум
                             |ИЗ
                             |	РегистрСведений.ЗанятостьНомеров КАК ЗанятостьНомеров
                             |ГДЕ
                             |	ЗанятостьНомеров.ПериодРезерва МЕЖДУ &ПериодН И &ПериодК
                             |	И ЗанятостьНомеров.Номер = &Номер
							 |  И ЗанятостьНомеров.Регистратор <> &Регистратор");

Если БонШанс Тогда
	ЗапросСвободных.Текст = ЗапросСвободных.Текст + " И ЗанятостьНомеров.БонШанс = ЛОЖЬ"; 
КонецЕсли;

ЗапросСвободных.Текст = ЗапросСвободных.Текст + "
							|
                             |СГРУППИРОВАТЬ ПО
                             |	ЗанятостьНомеров.Номер,
							 |  ЗанятостьНомеров.Регистратор"; 

ЗапросСвободных.УстановитьПараметр("ПериодН",НачалоПериодаРезерва);
ЗапросСвободных.УстановитьПараметр("ПериодК",КонецПериодаРезерва - 1);
ЗапросСвободных.УстановитьПараметр("Номер", НомерКуда);
ЗапросСвободных.УстановитьПараметр("Регистратор", ТекущийРегистратор);
ТЗсвободных=ЗапросСвободных.Выполнить().Выгрузить();
//Если ТЗсвободных.Количество()<> 0 тогда
//	Возврат Истина;
//конецесли;

Результат = ТЗсвободных.Количество() <>  0;
Если Результат Тогда
	Регистратор = ТЗсвободных[0].Регистратор;
Иначе
	Регистратор = Неопределено;
КонецЕсли;

Ответ = Новый Структура("Результат, НачалоПериодаРезерва, КонецПериодаРезерва, Регистратор"
	, Результат, НачалоПериодаРезерва, КонецПериодаРезерва, Регистратор);
Возврат Ответ;
КонецФункции	
//

Функция СуммаКомиссии(Заявка, ПроживаниеСуммаБезСкидки, Счета, СчетаДетальноДолги, СтрокиУслуги, ПроцентКомиссии) Экспорт
	
Если Заявка.Бронирует.Турагентство Тогда
	СуммаКомиссииПроживание = Окр(ПроживаниеСуммаБезСкидки * ПроцентКомиссии/100, 2); 

	СуммаКомиссииУслуги = 0;
	
	ОтборСтрокиСчета = Новый Структура("Контрагент", Заявка.Бронирует);  
	НайденныеСчета = Счета.НайтиСтроки(ОтборСтрокиСчета);
	Для Каждого Счет Из НайденныеСчета Цикл
		ОтборСтрокиУслугиСчетГУИД = Новый Структура("Услуга, СчетГУИД", Истина, Счет.СчетГУИД);	
		СтрокиДетальноДолги = СчетаДетальноДолги.НайтиСтроки(ОтборСтрокиУслугиСчетГУИД);
		
		Для Каждого СтрокаДетальноДолги Из СтрокиДетальноДолги Цикл 
            // + Аудит
			//ОтборСтрокиУслуги = Новый Структура("ГУИД", Истина, СтрокаДетальноДолги.ДолгиГУИД);	
			ОтборСтрокиУслуги = Новый Структура("ГУИД", СтрокаДетальноДолги.ДолгиГУИД);	
            // - Аудит
			НайденныеСтрокиУслуги = СтрокиУслуги.НайтиСтроки(ОтборСтрокиУслуги);
	
			Для Каждого СтрокаУслуга Из НайденныеСтрокиУслуги Цикл
				Результат = Справочники.ДопУслуги.ПустаяСсылка();
				Ссылка = СтрокаУслуга.Услуга; 
				ОбщийФункционалСервер.ВерхняяПапка(Ссылка, Результат);
				
				Если СтрокаУслуга.Услуга.ПрограммныйКод = Перечисления.ПрограммныйКодУслуги.ПРОЖИВАНИЕ_УСЛУГИ 
				ИЛИ Результат.ПрограммныйКод = Перечисления.ПрограммныйКодУслуги.ПРОЖИВАНИЕ_УСЛУГИ 
				Тогда
					СуммаУслуга = СтрокаУслуга.Цена * СтрокаУслуга.Количество; 
					//СуммаУслуга = СтрокаУслуга.Сумма; 
					СуммаКомиссииУслуги = СуммаКомиссииУслуги + Окр(СуммаУслуга * ПроцентКомиссии/100, 2);;						
				КонецЕсли;
			КонецЦикла;
		КонецЦикла;	
	КонецЦикла;

	СуммаКомиссии = СуммаКомиссииПроживание + СуммаКомиссииУслуги;
Иначе	
	СуммаКомиссии = 0;
КонецЕсли;	

Возврат СуммаКомиссии;
КонецФункции
