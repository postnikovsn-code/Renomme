Процедура ОбработкаПроведения(Отказ, Режим)
Ответ = ТекстОшибки();
Если ЗначениеЗаполнено(Ответ) Тогда
	ТекстСообщение = Ответ.ТекстСообщение; 
	
	ТекстСообщение = "ОШИБОЧНЫЕ ДАННЫЕ: " + ТекстСообщение;	
	ТекстСообщение = ТекстСообщение + ". Документ НЕ сохранен.";	
	
	Сообщить(ТекстСообщение);
	
	Отказ = Истина;
	Возврат;
КонецЕсли;	

Движение = Движения.Взаиморасчеты.Добавить();
Движение.ВидДвижения=?(Приход, ВидДвиженияНакопления.Приход, ВидДвиженияНакопления.Расход);

Движение.Период = ДатаОплаты;

Движение.Контрагент = ОтКого;
Движение.Сумма = Сумма;
