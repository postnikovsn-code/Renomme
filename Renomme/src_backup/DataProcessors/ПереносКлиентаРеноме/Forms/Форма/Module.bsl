&НаСервере
Процедура ЗагрузитьФотоКлиентовНаСервере()
Соединение = ПолучитьПодключениеКФайловойБД();

Запрос = Соединение.NewObject("Запрос");
	
Запрос.Текст = "ВЫБРАТЬ
|	Клиенты.Ссылка Как Ссылка,
|	Клиенты.СканыДокументов.(
|		Ссылка,
|		НомерСтроки,
|		ПутьДоФото,
|		Комментарий
|	) КАК СканыДокументов
|ИЗ
|	Справочник.Клиенты КАК Клиенты
              |ГДЕ
              |	Клиенты.ПометкаУдаления = ЛОЖЬ
              |	И Клиенты.ЭтоГруппа = ЛОЖЬ";
			  //|	И НЕ Клиенты.Ссылка В ИЕРАРХИИ (&СписокЗначений)";

ТЗ_КлиентыСоединение = Запрос.Выполнить().Выгрузить(); 
Если ТЗ_КлиентыСоединение.Количество() = 0 Тогда 
	Сообщить("Нет клиентов");
	Возврат; 
КонецЕсли;

Для Каждого Строка Из ТЗ_КлиентыСоединение Цикл
	ЗагрузитьСканыКлиента(Строка, Соединение);
КонецЦикла;
КонецПроцедуры

&НаСервере
Процедура ЗагрузитьСканыКлиента(Строка, Соединение)
Если Строка.СканыДокументов.Количество() = 0 Тогда Возврат; КонецЕсли; 	
	
ЗагрузкаГИУДСтрока = Соединение.XMLСтрока(Строка.Ссылка);
КлиентПоЗагрузкаГИУДСтрока = Справочники.Клиенты.НайтиПоРеквизиту("ЗагрузкаГИУДСтрока", ЗагрузкаГИУДСтрока);
Если НЕ ЗначениеЗаполнено(КлиентПоЗагрузкаГИУДСтрока) Тогда Возврат; КонецЕсли;

КлиентОбъект = КлиентПоЗагрузкаГИУДСтрока.ПолучитьОбъект();
	
ИмяПапкиПриемник = Константы.Папка_C_BASE.Получить();
ИмяПапкиПриемник = ИмяПапкиПриемник + "SCAN\"; 

Префикс = ЗагрузкаГИУДСтрока;

ИмяФайлаПрефикс = ИмяПапкиПриемник + Префикс; 

Для Каждого СтрокаСканыДокументов Из Строка.СканыДокументов Цикл
	
	ПутьДоФото = СтрокаСканыДокументов.ПутьДоФото;
	//ПутьДоФото = "C" + Сред(ПутьДоФото, 2, СтрДлина(ПутьДоФото) - 1);
	Индекс = СтрНайти(ПутьДоФото, "\", НаправлениеПоиска.СКонца);
	Если Индекс = 0 тогда Продолжить; КонецЕсли;
	
	ИмяФайла = Прав(ПутьДоФото, СтрДлина(ПутьДоФото) - Индекс);
	Если СтрДлина(ИмяФайла) = 0 тогда Продолжить; КонецЕсли;
	
	ПолноеИмяФайлаИсточник = ИмяПапкиИсточник + ИмяФайла;
	
	Файл = Новый Файл(ПолноеИмяФайлаИсточник);
	Если НЕ Файл.Существует() Тогда Продолжить; КонецЕсли;
	
	ИмяФайлаПриемник = ИмяФайлаПрефикс + "_" + ИмяФайла;
	
	ОтборСтроки = Новый Структура("ПутьДоФото", ИмяФайлаПриемник);
	НайденныеСтроки = КлиентОбъект.СканыДокументов.НайтиСтроки(ОтборСтроки);
	Для Каждого НайденнаяСтрока Из НайденныеСтроки Цикл
		КлиентОбъект.СканыДокументов.Удалить(НайденнаяСтрока);
	КонецЦикла;
	
	Попытка
		КопироватьФайл(ПолноеИмяФайлаИсточник, ИмяФайлаПриемник);
		НетОшибкаКопирования = Истина;
	Исключение
		Сообщить(ОписаниеОшибки());
		НетОшибкаКопирования = Ложь;
	КонецПопытки;
	
	Если НетОшибкаКопирования Тогда
		НовыйВидСканыДокументов = КлиентОбъект.СканыДокументов.Добавить();
		НовыйВидСканыДокументов.ПутьДоФото = ИмяФайлаПриемник; 
		НовыйВидСканыДокументов.Комментарий = СтрокаСканыДокументов.Комментарий; 
	КонецЕсли;
КонецЦикла;	

Попытка
	КлиентОбъект.Записать();
Исключение
	Сообщить(ОписаниеОшибки());		
КонецПопытки;

	
	
КонецПроцедуры
