&НаКлиенте
Процедура СчетаПередНачаломДобавления(Элемент, Отказ, Копирование, Родитель, Группа, Параметр)
Отказ = Истина;
КонецПроцедуры

//// + Добавление Счетов
&НаКлиенте
Процедура ДобавитьСчета(Команда)
Ответ = ДобавитьСчетаНаСервере(Ложь, Ложь);	

ОбработатьДобавитьСчета(Ответ);
КонецПроцедуры

&НаКлиенте
Процедура ДобавитьСчетаЗаПроживание(Команда)
Ответ = ДобавитьСчетаНаСервере(Истина, Ложь);

ОбработатьДобавитьСчета(Ответ);
КонецПроцедуры

&НаКлиенте
Процедура ДобавитьСчетаЗаУслуги(Команда)
Ответ = ДобавитьСчетаНаСервере(Ложь, Истина);

ОбработатьДобавитьСчета(Ответ);
КонецПроцедуры

&НаКлиенте
Процедура ОбработатьДобавитьСчета(Ответ)
Если Ответ = Неопределено Тогда Возврат; КонецЕсли;
	
Если Ответ.НетСчетов Тогда 
	ПоказатьПредупреждение(, "Нечего добавлять");
	Возврат; 
КонецЕсли;

//ЭтотОбъектЗаписатьНаКлиенте();

СчетПервый = Ответ.СчетПервый;
СчетГУИД = СчетПервый.СчетГУИД;
УстановитьТекущаяСтрокаСчета(СчетГУИД); 

Элементы.СчетаДетальноСтроки.ОтборСтрок = Новый ФиксированнаяСтруктура("СчетГУИД", СчетГУИД);		
КонецПроцедуры

&НаСервере
Функция УстановитьТекущаяСтрокаСчета(СчетГУИД)
ОтборСтроки = Новый Структура("СчетГУИД", СчетГУИД);
НайденныеСтроки = Объект.Счета.НайтиСтроки(ОтборСтроки);
Если НайденныеСтроки.Количество() = 0 Тогда 
	Сообщить("Счет не найден: " + СчетГУИД + ". УстановитьТекущаяСтрокаСчета()"); 
	Возврат Истина; 
КонецЕсли;

НайденнаяСтрока = НайденныеСтроки[0];
Идентификатор = НайденнаяСтрока.ПолучитьИдентификатор();
Элементы.Счета.ТекущаяСтрока = Идентификатор;	
Возврат Ложь;
КонецФункции

//
&НаСервере
Функция ДобавитьСчетаНаСервере(ТолькоПроживаниеПараметр, ТолькоУслугиПараметр)
Если НЕ ЭтаФорма.Записать(Новый Структура("РежимЗаписи", РежимЗаписиДокумента.Проведение))	Тогда Возврат Неопределено; КонецЕсли;
	
НачатьТранзакцию();	
	
Ответ = Новый Структура("НетСчетов, СчетПервый", Истина, Неопределено);	
	
ПустойМассив= Новый Массив;	
ДобавляемыеСтрокиДолгиОплачивает = Объект.СчетаДетальноДолги.Выгрузить(ПустойМассив);	

ДобавляемыеСтрокиДолгиОплачивает_Клиент = Объект.СчетаДетальноДолги.Выгрузить(ПустойМассив);	
ДобавляемыеСтрокиДолгиОплачивает_Клиент2 = Объект.СчетаДетальноДолги.Выгрузить(ПустойМассив);

ДобавляемыеСтрокиДолгиКлиент = Объект.СчетаДетальноДолги.Выгрузить(ПустойМассив);	
ДобавляемыеСтрокиДолгиКлиент2 = Объект.СчетаДетальноДолги.Выгрузить(ПустойМассив);	

СчетГУИД_Пустой = ОбщийФункционалСервер.УникальныйИдентификаторПустой();

//ОплачиваетЮрЛицо = КлиентыСервер.ЭтоЮрЛицо(Объект.Оплачивает);
ОплачиваетЮрЛицо = (Объект.Оплачивает.ТипКлиента = Перечисления.ТипыКлиентов.ЮрЛицо);

ОплачиваетТурагентство = Объект.Оплачивает.Турагентство;

Если НЕ ТолькоУслугиПараметр Тогда
	Для Каждого СтрокаИсходная Из Объект.Проживание Цикл 
		Если СтрокаИсходная.Сумма = 0 Тогда	Продолжить; КонецЕсли; 
		
		ОтборСтроки = Новый Структура("ДолгиГУИД", СтрокаИсходная.ГУИД);          
		СчетаДетальноДолги = Объект.СчетаДетальноДолги.НайтиСтроки(ОтборСтроки);
		
		Если НЕ (Объект.РазделитьСчет И ЗначениеЗаполнено(Объект.Клиент2)) Тогда
			Если СчетаДетальноДолги.Количество() > 0 Тогда Продолжить; КонецЕсли;
			
			Если ЗначениеЗаполнено(Объект.Оплачивает) Тогда	
				ДобавляемыеСтрокиДолгиКонтрагент = ДобавляемыеСтрокиДолгиОплачивает;
			Иначе
				ДобавляемыеСтрокиДолгиКонтрагент = ДобавляемыеСтрокиДолгиКлиент;
			КонецЕсли;
			
			НоваяСтрока = ДобавляемыеСтрокиДолгиКонтрагент.Добавить();
			ЗаявкаСервер.ЗаполнитьСтрокаДолги(НоваяСтрока, СтрокаИсходная, СчетГУИД_Пустой, Ложь);
			
			Продолжить;
		КонецЕсли;	
			
		Если Объект.РазделитьСчет И ЗначениеЗаполнено(Объект.Клиент2) Тогда
			
			Если ЗначениеЗаполнено(Объект.Оплачивает) Тогда
				ДобавляемыеСтрокиДолг_Контрагент = ДобавляемыеСтрокиДолгиОплачивает_Клиент;					
				ДобавляемыеСтрокиДолг_Контрагент2 = ДобавляемыеСтрокиДолгиОплачивает_Клиент2;
				
				Контрагент = Объект.Оплачивает;
				Контрагент2 = Объект.Оплачивает;
				
			Иначе
				
				ДобавляемыеСтрокиДолг_Контрагент = ДобавляемыеСтрокиДолгиКлиент;				
				ДобавляемыеСтрокиДолг_Контрагент2 = ДобавляемыеСтрокиДолгиКлиент2;	
				
				Контрагент = Объект.Клиент;
				Контрагент2 = Объект.Клиент2;
			КонецЕсли;	
			
			ДобавитьСтроку = ДобавитьСтрокуВСчет(СчетаДетальноДолги, Контрагент, Объект.Клиент);
			Если ДобавитьСтроку Тогда
				НеПервый = Ложь;
				НоваяСтрока = ДобавляемыеСтрокиДолг_Контрагент.Добавить();
				ЗаявкаСервер.ЗаполнитьСтрокаДолги(НоваяСтрока, СтрокаИсходная, СчетГУИД_Пустой, Ложь);
				ЗаявкаСервер.УстановитьЦенаСуммаСчетаДетальноДолгиДляРазделитьСчет(НоваяСтрока
						, Истина, Ложь, Истина, НеПервый);
			КонецЕсли;	
			
			ДобавитьСтроку = ДобавитьСтрокуВСчет(СчетаДетальноДолги, Контрагент2, Объект.Клиент2);
			Если ДобавитьСтроку Тогда
				НеПервый = Истина;
				НоваяСтрока = ДобавляемыеСтрокиДолг_Контрагент2.Добавить();
				ЗаявкаСервер.ЗаполнитьСтрокаДолги(НоваяСтрока, СтрокаИсходная, СчетГУИД_Пустой, Ложь);
				ЗаявкаСервер.УстановитьЦенаСуммаСчетаДетальноДолгиДляРазделитьСчет(НоваяСтрока
						, Истина, Ложь, Истина, НеПервый);
			КонецЕсли;	
			
		КонецЕсли;		
	КонецЦикла;	
КонецЕсли;

Если НЕ ТолькоПроживаниеПараметр Тогда
	Для Каждого СтрокаИсходная Из Объект.ДопУслуги Цикл 
		Если НЕ СтрокаИсходная.ВСчет Тогда Продолжить; КонецЕсли; 
		Если СтрокаИсходная.Цена * СтрокаИсходная.Количество = 0 Тогда	Продолжить; КонецЕсли;
		
		ОтборСтроки = Новый Структура("ДолгиГУИД", СтрокаИсходная.ГУИД);
		НайденныеСтроки = Объект.СчетаДетальноДолги.НайтиСтроки(ОтборСтроки);
		Если НайденныеСтроки.Количество() > 0 Тогда Продолжить; КонецЕсли; 
		
		Если Объект.РазделитьСчет И ЗначениеЗаполнено(Объект.Клиент2) Тогда 		
			Если ЗначениеЗаполнено(Объект.Оплачивает) Тогда	
				Если СтрокаИсходная.НеПервый Тогда
					ДобавляемыеСтрокиДолгиКонтрагент = ДобавляемыеСтрокиДолгиОплачивает_Клиент2;
				Иначе
					ДобавляемыеСтрокиДолгиКонтрагент = ДобавляемыеСтрокиДолгиОплачивает_Клиент;
					
				КонецЕсли;
			Иначе
				Если СтрокаИсходная.НеПервый Тогда
					ДобавляемыеСтрокиДолгиКонтрагент = ДобавляемыеСтрокиДолгиКлиент2;
				Иначе
					ДобавляемыеСтрокиДолгиКонтрагент = ДобавляемыеСтрокиДолгиКлиент;
					
				КонецЕсли;
			КонецЕсли;	
		Иначе
			Если ЗначениеЗаполнено(Объект.Оплачивает) Тогда	
				Если НЕ ТолькоУслугиПараметр Тогда  
					ДобавляемыеСтрокиДолгиКонтрагент = ДобавляемыеСтрокиДолгиОплачивает;
				Иначе
					Если Объект.Оплачивает.Турагентство Тогда
						ДобавляемыеСтрокиДолгиКонтрагент = ДобавляемыеСтрокиДолгиКлиент;
					Иначе	
						ДобавляемыеСтрокиДолгиКонтрагент = ДобавляемыеСтрокиДолгиОплачивает;
					КонецЕсли;
				КонецЕсли;
			Иначе
				ДобавляемыеСтрокиДолгиКонтрагент = ДобавляемыеСтрокиДолгиКлиент;
			КонецЕсли;
		КонецЕсли;	
		
		НоваяСтрока = ДобавляемыеСтрокиДолгиКонтрагент.Добавить();
		ЗаявкаСервер.ЗаполнитьСтрокаДолги(НоваяСтрока, СтрокаИсходная, СчетГУИД_Пустой, Истина);
	КонецЦикла;	
КонецЕсли;

// Создание счетов

НетСчетов = Истина;
СчетПервый = Неопределено;

Если ДобавляемыеСтрокиДолгиОплачивает.Количество() > 0 Тогда
	НетСчетов = Ложь;
	
	ТолькоПроживание = ТолькоПроживаниеПараметр;
	ТолькоУслуги = ТолькоУслугиПараметр;
		
	Контрагент = Объект.Оплачивает;
	Клиент = Объект.Клиент;
	
	Если НЕ ЗначениеЗаполнено(Контрагент) Тогда
		Контрагент = Объект.Клиент;
	КонецЕсли;

	Счет = ДобавитьСчетЗаявка(ДобавляемыеСтрокиДолгиОплачивает, Контрагент, Клиент, ТолькоПроживание, ТолькоУслуги);
	Если СчетПервый = Неопределено Тогда СчетПервый = Счет; КонецЕсли;
КонецЕсли;

Если ДобавляемыеСтрокиДолгиОплачивает_Клиент.Количество() > 0 Тогда
	НетСчетов = Ложь;
	
	ТолькоПроживание = ТолькоПроживаниеПараметр;
	ТолькоУслуги = ТолькоУслугиПараметр;
		
	Контрагент = Объект.Оплачивает;
	Клиент = Объект.Клиент;
	
	Если НЕ ЗначениеЗаполнено(Контрагент) Тогда
		Контрагент = Объект.Клиент;
	КонецЕсли;
	
	Счет = ДобавитьСчетЗаявка(ДобавляемыеСтрокиДолгиОплачивает_Клиент, Контрагент, Клиент, ТолькоПроживание, ТолькоУслуги);
	Если СчетПервый = Неопределено Тогда СчетПервый = Счет; КонецЕсли;
КонецЕсли;

Если ДобавляемыеСтрокиДолгиОплачивает_Клиент2.Количество() > 0 Тогда
	НетСчетов = Ложь;
	
	ТолькоПроживание = ТолькоПроживаниеПараметр;
	ТолькоУслуги = ТолькоУслугиПараметр;
		
	Контрагент = Объект.Оплачивает;
	Клиент = Объект.Клиент2;
	
	Если НЕ ЗначениеЗаполнено(Контрагент) Тогда
		Контрагент = Объект.Клиент2;
	КонецЕсли;

	Счет = ДобавитьСчетЗаявка(ДобавляемыеСтрокиДолгиОплачивает_Клиент2, Контрагент, Клиент, ТолькоПроживание, ТолькоУслуги);
	Если СчетПервый = Неопределено Тогда СчетПервый = Счет; КонецЕсли;
КонецЕсли;

Если ДобавляемыеСтрокиДолгиКлиент.Количество() > 0 Тогда
	НетСчетов = Ложь;
	
	ТолькоПроживание = ТолькоПроживаниеПараметр;
	ТолькоУслуги = ТолькоУслугиПараметр;
	
	Если Объект.Оплачивает = Объект.Клиент Тогда
		Контрагент = Объект.Клиент;
	ИначеЕсли ЗначениеЗаполнено(Объект.Оплачивает) И Объект.Оплачивает = Объект.Клиент2 Тогда
	    Контрагент = Объект.Клиент2;
	Иначе
		Контрагент = Объект.Клиент;
	КонецЕсли;
		
	Клиент = Объект.Клиент;
	
	Счет = ДобавитьСчетЗаявка(ДобавляемыеСтрокиДолгиКлиент, Контрагент, Клиент, ТолькоПроживание, ТолькоУслуги);
	Если СчетПервый = Неопределено Тогда СчетПервый = Счет; КонецЕсли;
КонецЕсли;	

Если ДобавляемыеСтрокиДолгиКлиент2.Количество() > 0 Тогда
	НетСчетов = Ложь;
	
	ТолькоПроживание = ТолькоПроживаниеПараметр;
	ТолькоУслуги = ТолькоУслугиПараметр;

	Если Объект.Оплачивает = Объект.Клиент Тогда
		Контрагент = Объект.Клиент;
	ИначеЕсли ЗначениеЗаполнено(Объект.Оплачивает) И Объект.Оплачивает = Объект.Клиент2 Тогда
	    Контрагент = Объект.Клиент2;
	Иначе
		Контрагент = Объект.Клиент2;
	КонецЕсли;
	
	Клиент = Объект.Клиент2;
	
	Счет = ДобавитьСчетЗаявка(ДобавляемыеСтрокиДолгиКлиент2, Контрагент, Клиент, ТолькоПроживание, ТолькоУслуги);
	Если СчетПервый = Неопределено Тогда СчетПервый = Счет; КонецЕсли;
КонецЕсли;	

Ответ.НетСчетов = НетСчетов;
Ответ.СчетПервый = СчетПервый;

ЭтаФорма.Записать(Новый Структура("РежимЗаписи", РежимЗаписиДокумента.Проведение)); 
ЗафиксироватьТранзакцию();	

Возврат Ответ;
КонецФункции

&НаСервере
Функция ДобавитьСтрокуВСчет(СчетаДетальноДолги, Контрагент, Клиент)
ДобавитьСтрокуВСчет = Истина;
Если СчетаДетальноДолги.Количество() = 0 Тогда Возврат ДобавитьСтрокуВСчет; КонецЕсли;

Для Каждого Строка Из СчетаДетальноДолги Цикл
	ОтборСтроки = Новый Структура("СчетГУИД, Контрагент, Клиент", Строка.СчетГУИД, Контрагент, Клиент);
	НайденныеСчета = Объект.Счета.НайтиСтроки(ОтборСтроки);
	Если НайденныеСчета.Количество() > 0 Тогда
		ДобавитьСтрокуВСчет = Ложь;
		
		Прервать;
	КонецЕсли;
КонецЦикла;

Возврат ДобавитьСтрокуВСчет;
КонецФункции

&НаСервере
Функция ДобавитьСчетЗаявка(ДополнительныеСтрокиДолги, Контрагент, Клиент, ТолькоПроживание, ТолькоУслуги)
НачатьТранзакцию();	
	
ПустойМассив = Новый Массив;	
СчетГУИД_Пустой = ОбщийФункционалСервер.УникальныйИдентификаторПустой();

СчетаДетальноДолги = Объект.СчетаДетальноДолги;
ОбщийФункционалСервер.ДобавитьСтроки(СчетаДетальноДолги, ДополнительныеСтрокиДолги);

РаспределениеОплатДолги = Объект.РаспределениеОплатДолги;

ДатаС = Объект.РезервС; ДатаПо = Объект.РезервПо;
ЗаявкаСервер.ДатаСДатаПо(ДатаС, ДатаПо, ДополнительныеСтрокиДолги); 
	
Счет = ЗаявкаСервер.СчетСтруктура(СчетГУИД_Пустой, Контрагент, Клиент, ТолькоПроживание, ТолькоУслуги
	, Объект.РазделитьСчет, Объект.СвернутьВСчете, Ложь, ДатаС, ДатаПо, 0, ТекущаяДата(), Неопределено, Ложь); 
	
Счет.ЭтоПредварительныйГрупповойСчет = ЭтоПредварительныйГрупповойСчет(Счет.Контрагент);
	
Счет = ЗаявкаСервер.ЗаполнитьНовыйСчетДанные(Счет, Объект.Счета, СчетаДетальноДолги, РаспределениеОплатДолги);  

СчетОбъект = Объект.Счета.Добавить();
ЗаполнитьЗначенияСвойств(СчетОбъект, Счет); 

МассивОплатКонтрагента = ЗаявкаСервер.МассивОплатКонтрагента(Контрагент, Объект.СчетаДетальноОплаты);
ОбновитьСчетаОплаты(МассивОплатКонтрагента, Объект);

ЗафиксироватьТранзакцию();	
Возврат Счет;
КонецФункции

&НаСервере
Функция ОбновитьСчетаОплаты(СчетаДетальноОплаты, ТекущийОбъект)
Для Каждого СтрокаОплаты Из СчетаДетальноОплаты Цикл
	Если СтрокаОплаты.ГрупповаяОплата Тогда Продолжить; КонецЕсли;
	
	ОбновитьСчетаСтрокаОплаты(СтрокаОплаты, ТекущийОбъект);
КонецЦикла;
КонецФункции

