&НаКлиенте
Процедура ВыполнитьОперациюЗавершение(РезультатВыполнения, Параметры) Экспорт
	
	Доступность = Истина;
	
	Если РезультатВыполнения.Результат Тогда
		ТекстСообщения = НСтр("ru = 'Операция выполнена успешно.'");
		
//РезультатВыполнения.ТекстСлипЧека	

		//Если Параметры <> Неопределено Тогда
		//	Если Параметры.Свойство("ТипТранзакции") Тогда
		//		ТипТранзакции = Параметры.ТипТранзакции;
		//		
		//		Если ТипТранзакции = "СверкаИтогов" Тогда
		//			ЭТСервер.СверкаИтоговЗаписать(РезультатВыполнения, Параметры);
		//			
		//			Перейти ~ЗАВЕРШЕНИЕ;
		//		КонецЕсли;	
		//	КонецЕсли;	
		//КонецЕсли;	
		
		Если ЭТКлиент.ЗаписатьСверкуИтогов(РезультатВыполнения, Параметры) Тогда Перейти ~ЗАВЕРШЕНИЕ; КонецЕсли;
		
		ЭТСервер.ЗаписатьОперацию(РезультатВыполнения, Параметры);
	
		ТипТранзакции = "";
		Если ЗначениеЗаполнено(Параметры) Тогда 
			Если Параметры.Свойство("ТипТранзакции") Тогда ТипТранзакции = Параметры.ТипТранзакции; КонецЕсли;
		КонецЕсли;	
		
		Если ТипТранзакции = "AuthorizeSales" 
		ИЛИ  ТипТранзакции = "AuthorizeRefund" 
		ИЛИ  ТипТранзакции = "AuthorizeVoid" 
		Тогда
			ФорматированнаяСтрока = Новый ФорматированнаяСтрока("ПРИ НЕОБХОДИМОСТИ ОФОРМИТЕ КАССОВЫЙ ЧЕК !!!"
				, Новый Шрифт(, 12, Истина), WebЦвета.Красный);
			ПоказатьПредупреждение(, ФорматированнаяСтрока); 
		КонецЕсли;
	Иначе
		ТекстСообщения = РезультатВыполнения.ОписаниеОшибки;
	КонецЕсли;
	
~ЗАВЕРШЕНИЕ:
	ОбщегоНазначенияБПОКлиент.СообщитьПользователю(ТекстСообщения);
КонецПроцедуры


