&НаКлиенте
Процедура ПередЗаписью(Отказ, ПараметрыЗаписи)
Если ПроверкаЗаполнения_ПередЗаписью() Тогда Отказ = Истина; Возврат; КонецЕсли;

Если НЕ (ПараметрыЗаписи.РежимЗаписи = РежимЗаписиДокумента.ОтменаПроведения 
ИЛИ Объект.Статус = ПредопределенноеЗначение("Перечисление.СтатусБрони.ОтказОтБронирования")  	
ИЛИ Объект.Статус = ПредопределенноеЗначение("Перечисление.СтатусБрони.ОтменаБронирования"))  	
Тогда
	Ответ = ДокументыСервер.ЗанятостьНомераПроверить(Объект.РезервС, Объект.РезервПо, Объект.ВремяЗаезда, Объект.ВремяВыезда
		, Объект.НомерВРезерв, Объект.БонШанс, Объект.Ссылка);
	Если Ответ.Результат Тогда
		ТекстСообщения = "Номер занят. " + Ответ.Регистратор;
		ПоказатьПредупреждение(, ТекстСообщения);
		Сообщить("Номер занят. " + Ответ.Регистратор);
		
		Отказ = Истина; Возврат;	
	КонецЕсли;
КонецЕсли;

//Если ПроверкаЗаполненияРеквизитов() Тогда Отказ = Истина; Возврат; КонецЕсли;

ПередЗаписью_Продолжение();	
