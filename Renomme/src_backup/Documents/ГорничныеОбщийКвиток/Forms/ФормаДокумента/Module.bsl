&НаСервере
Процедура ЗаполнитьКвиткиНаСервере()
//	
Запрос = Новый Запрос("ВЫБРАТЬ ПЕРВЫЕ 1
                      |	ГорничныеЗарплата.Г_Цена КАК Г_Цена,
                      |	ГорничныеЗарплата.Т_Цена КАК Т_Цена,
                      |	ГорничныеЗарплата.ТС_Цена КАК ТС_Цена,
                      |	ГорничныеЗарплата.РК_Цена КАК РК_Цена,
                      |	ГорничныеЗарплата.МК_Цена КАК МК_Цена,
                      |	ГорничныеЗарплата.МДМ_Цена КАК МДМ_Цена,
                      |	ГорничныеЗарплата.Зарплата.(
                      |		НомерСтроки КАК НомерСтроки,
                      |		Горничная КАК Горничная,
                      |		Оклад КАК Оклад,
                      |		Оклад_Р КАК Оклад_Р,
                      |		Оклад_Есть КАК Оклад_Есть,
                      |		ВЫБОР
                      |			КОГДА ГорничныеЗарплата.Зарплата.Оклад_Есть
                      |				ТОГДА ГорничныеЗарплата.Зарплата.Оклад_Р
                      |			ИНАЧЕ ГорничныеЗарплата.Зарплата.Оклад
                      |		КОНЕЦ КАК Оклад_Э,
                      |		Отпуск КАК Отпуск,
                      |		Отпуск_Р КАК Отпуск_Р,
                      |		Отпуск_Есть КАК Отпуск_Есть,
                      |		ВЫБОР
                      |			КОГДА ГорничныеЗарплата.Зарплата.Отпуск_Есть
                      |				ТОГДА ГорничныеЗарплата.Зарплата.Отпуск_Р
                      |			ИНАЧЕ ГорничныеЗарплата.Зарплата.Отпуск
                      |		КОНЕЦ КАК Отпуск_Э,
                      |		НадбавкаЗаСтаж КАК НадбавкаЗаСтаж,
                      |		НадбавкаЗаСтаж_Р КАК НадбавкаЗаСтаж_Р,
                      |		НадбавкаЗаСтаж_Есть КАК НадбавкаЗаСтаж_Есть,
                      |		ВЫБОР
                      |			КОГДА ГорничныеЗарплата.Зарплата.НадбавкаЗаСтаж_Есть
                      |				ТОГДА ГорничныеЗарплата.Зарплата.НадбавкаЗаСтаж_Р
                      |			ИНАЧЕ ГорничныеЗарплата.Зарплата.НадбавкаЗаСтаж
                      |		КОНЕЦ КАК НадбавкаЗаСтаж_Э,
                      |		НадбавкаЗаСтандарты КАК НадбавкаЗаСтандарты,
                      |		НадбавкаЗаСтандарты_Р КАК НадбавкаЗаСтандарты_Р,
                      |		НадбавкаЗаСтандарты_Есть КАК НадбавкаЗаСтандарты_Есть,
                      |		ВЫБОР
                      |			КОГДА ГорничныеЗарплата.Зарплата.НадбавкаЗаСтандарты_Есть
                      |				ТОГДА ГорничныеЗарплата.Зарплата.НадбавкаЗаСтандарты_Р
                      |			ИНАЧЕ ГорничныеЗарплата.Зарплата.НадбавкаЗаСтандарты
                      |		КОНЕЦ КАК НадбавкаЗаСтандарты_Э,
                      |		Больничный КАК Больничный,
                      |		Премия КАК Премия,
                      |		ДопРаботы КАК ДопРаботы,
                      |		Сдельно КАК Сдельно,
                      |		Г_Количество КАК Г_Количество,
                      |		Г_Количество_Р КАК Г_Количество_Р,
                      |		ГорничныеЗарплата.Зарплата.Г_Количество + ГорничныеЗарплата.Зарплата.Г_Количество_Р КАК Г_Количество_Э,
                      |		Г_Сумма КАК Г_Сумма,
                      |		Т_Количество КАК Т_Количество,
                      |		Т_Количество_Р КАК Т_Количество_Р,
                      |		ГорничныеЗарплата.Зарплата.Т_Количество + ГорничныеЗарплата.Зарплата.Т_Количество_Р КАК Т_Количество_Э,
                      |		Т_Сумма КАК Т_Сумма,
                      |		ТС_Количество КАК ТС_Количество,
                      |		ТС_Количество_Р КАК ТС_Количество_Р,
                      |		ГорничныеЗарплата.Зарплата.ТС_Количество + ГорничныеЗарплата.Зарплата.ТС_Количество_Р КАК ТС_Количество_Э,
                      |		ТС_Сумма КАК ТС_Сумма,
                      |		РК_Количество КАК РК_Количество,
                      |		РК_Количество_Р КАК РК_Количество_Р,
                      |		РК_Сумма КАК РК_Сумма,
                      |		МК_Количество КАК МК_Количество,
                      |		МК_Количество_Р КАК МК_Количество_Р,
                      |		ГорничныеЗарплата.Зарплата.МК_Количество + ГорничныеЗарплата.Зарплата.МК_Количество_Р КАК МК_Количество_Э,
                      |		МК_Сумма КАК МК_Сумма,
                      |		МДМ_Количество КАК МДМ_Количество,
                      |		МДМ_Количество_Р КАК МДМ_Количество_Р,
                      |		ГорничныеЗарплата.Зарплата.МДМ_Количество + ГорничныеЗарплата.Зарплата.МДМ_Количество_Р КАК МДМ_Количество_Э,
                      |		МДМ_Сумма КАК МДМ_Сумма,
                      |		СуммаПрачечная КАК СуммаПрачечная,
                      |		СуммаПрачечная_Р КАК СуммаПрачечная_Р,
                      |		СуммаПрачечная_Есть КАК СуммаПрачечная_Есть,
                      |		ВЫБОР
                      |			КОГДА ГорничныеЗарплата.Зарплата.СуммаПрачечная_Есть
                      |				ТОГДА ГорничныеЗарплата.Зарплата.СуммаПрачечная_Р
                      |			ИНАЧЕ ГорничныеЗарплата.Зарплата.СуммаПрачечная
                      |		КОНЕЦ КАК СуммаПрачечная_Э,
                      |		КоличествоСмен КАК КоличествоСмен,
                      |		КоличествоСмен_Р КАК КоличествоСмен_Р,
                      |		КоличествоСмен_Есть КАК КоличествоСмен_Есть,
                      |		ВЫБОР
                      |			КОГДА ГорничныеЗарплата.Зарплата.КоличествоСмен_Есть
                      |				ТОГДА ГорничныеЗарплата.Зарплата.КоличествоСмен_Р
                      |			ИНАЧЕ ГорничныеЗарплата.Зарплата.КоличествоСмен
                      |		КОНЕЦ КАК КоличествоСмен_Э,
                      |		КорректировкаДопНачислено КАК КорректировкаДопНачислено,
                      |		Аванс_кк КАК Аванс_кк,
                      |		Аванс_нал КАК Аванс_нал,
                      |		Зарплата_кк КАК Зарплата_кк,
                      |		Отпуск_кк КАК Отпуск_кк,
                      |		Отпуск_нал КАК Отпуск_нал,
                      |		Сдельно_нал КАК Сдельно_нал,
                      |		ИныеВыплаты_нал КАК ИныеВыплаты_нал
                      |	) КАК Зарплата,
                      |	ГорничныеЗарплата.ЗарплатаПомещения.(
                      |		Ссылка КАК Ссылка,
                      |		НомерСтроки КАК НомерСтроки,
                      |		Горничная КАК Горничная,
                      |		Помещение КАК Помещение,
                      |		Количество КАК Количество,
                      |		Количество_Р КАК Количество_Р,
                      |		ГорничныеЗарплата.ЗарплатаПомещения.Количество + ГорничныеЗарплата.ЗарплатаПомещения.Количество_Р КАК Количество_Э
                      |	) КАК ЗарплатаПомещения,
                      |	ГорничныеЗарплата.ПомещенияЦены.(
                      |		Ссылка КАК Ссылка,
                      |		НомерСтроки КАК НомерСтроки,
                      |		Помещение КАК Помещение,
                      |		Цена КАК Цена
                      |	) КАК ПомещенияЦены
                      |ИЗ
                      |	Документ.ГорничныеЗарплата КАК ГорничныеЗарплата
                      |ГДЕ
                      |	ГорничныеЗарплата.ПометкаУдаления = ЛОЖЬ
                      |	И ГорничныеЗарплата.МесяцРасчета = &МесяцРасчета
                      |
                      |УПОРЯДОЧИТЬ ПО
                      |	ГорничныеЗарплата.Ссылка УБЫВ");

//// + Аудит
//					  //|ГДЕ
//					  //|	ГорничныеЗарплата.МесяцРасчета = &МесяцРасчета
//                      |ГДЕ
//                      |	ГорничныеЗарплата.ПометкаУдаления = ЛОЖЬ
//                      |	И ГорничныеЗарплата.МесяцРасчета = &МесяцРасчета
//// - Аудит
Запрос.УстановитьПараметр("МесяцРасчета", Объект.МесяцРасчета);

ТЗ =  Запрос.Выполнить().Выгрузить();

Если ТЗ.Количество() = 0 Тогда
	Сообщить("Расчет зарплаты за " + Формат(Объект.МесяцРасчета, "MM.yyyy") + " отстуствует");
	
	Возврат;
КонецЕсли;

СтрокаДанные = ТЗ[0];

Г_Цена = СтрокаДанные.Г_Цена;
Т_Цена = СтрокаДанные.Т_Цена;
ТС_Цена = СтрокаДанные.ТС_Цена;
МК_Цена = СтрокаДанные.МК_Цена;
МДМ_Цена = СтрокаДанные.МДМ_Цена;

Горничные.Очистить();
Для Каждого Строка_П Из СтрокаДанные.Зарплата Цикл
	НоваяСтрока = Горничные.Добавить();
	
	НоваяСтрока.Горничная = Строка_П.Горничная;
КонецЦикла;

Для Каждого Строка_П Из СтрокаДанные.ПомещенияЦены Цикл
	НоваяСтрока = ПомещенияЦены.Добавить();
	
	ЗаполнитьЗначенияСвойств(НоваяСтрока, Строка_П);	
КонецЦикла;
//

//
Запрос = Новый Запрос("ВЫБРАТЬ
                      |	ГорничныеОбщийКвитокКвитокСтроки.Ссылка КАК Ссылка,
                      |	ГорничныеОбщийКвитокКвитокСтроки.НомерСтроки КАК НомерСтроки,
                      |	ГорничныеОбщийКвитокКвитокСтроки.Горничная КАК Горничная,
                      |	ГорничныеОбщийКвитокКвитокСтроки.ТипСтроки КАК ТипСтроки,
                      |	ГорничныеОбщийКвитокКвитокСтроки.КодЗаполнения КАК КодЗаполнения,
                      |	ГорничныеОбщийКвитокКвитокСтроки.Наименование КАК Наименование,
                      |	ГорничныеОбщийКвитокКвитокСтроки.Количество КАК Количество,
                      |	ГорничныеОбщийКвитокКвитокСтроки.Количество_Р КАК Количество_Р,
                      |	ГорничныеОбщийКвитокКвитокСтроки.Количество_Есть КАК Количество_Есть,
                      |	ГорничныеОбщийКвитокКвитокСтроки.Сумма КАК Сумма,
                      |	ГорничныеОбщийКвитокКвитокСтроки.Сумма_Р КАК Сумма_Р,
                      |	ГорничныеОбщийКвитокКвитокСтроки.Сумма_Есть КАК Сумма_Есть
                      |ИЗ
                      |	Документ.ГорничныеОбщийКвиток.КвитокСтроки КАК ГорничныеОбщийКвитокКвитокСтроки
                      |ГДЕ
                      |	ГорничныеОбщийКвитокКвитокСтроки.Ссылка.ПометкаУдаления = ЛОЖЬ
                      |	И ГорничныеОбщийКвитокКвитокСтроки.Ссылка = &Ссылка");

Запрос.УстановитьПараметр("Ссылка", Объект.Ссылка);

ТЗ_КвиткиДокумент = Запрос.Выполнить().Выгрузить();

Если ЗначениеЗаполнено(Объект.Ссылка) Тогда
	Для Каждого Строка Из ТЗ_КвиткиДокумент Цикл
		НоваяСтрока = ТЗ_Квитки.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, Строка);
	КонецЦикла;
Иначе
	Для Каждого Строка Из Горничные Цикл
		ОтборСтроки = Новый Структура("ТипСтроки", 1);
		НайденныеСтрокиНастройка = Настройки.НайтиСтроки(ОтборСтроки);
		
		Для Каждого СтрокаНастройка Из НайденныеСтрокиНастройка Цикл
			НоваяСтрока = ТЗ_Квитки.Добавить();
			НоваяСтрока.Горничная = Строка.Горничная;
			НоваяСтрока.КодЗаполнения = СтрокаНастройка.КодЗаполнения;
			НоваяСтрока.Наименование = СтрокаНастройка.Наименование;
			НоваяСтрока.ТипСтроки = СтрокаНастройка.ТипСтроки;
			
			Если ЗначениеЗаполнено(СтрокаНастройка.ИмяЗаполненияКоличество) Тогда
				ЗаполнитьСтрокаТЗ_Квитки(НоваяСтрока, СтрокаДанные.Зарплата, ТЗ_КвиткиДокумент, СтрокаНастройка.ИмяЗаполненияКоличество
					, Истина, НоваяСтрока.Горничная, НоваяСтрока.КодЗаполнения);
			КонецЕсли;	
			Если ЗначениеЗаполнено(СтрокаНастройка.ИмяЗаполненияСумма) Тогда
				ЗаполнитьСтрокаТЗ_Квитки(НоваяСтрока, СтрокаДанные.Зарплата, ТЗ_КвиткиДокумент, СтрокаНастройка.ИмяЗаполненияСумма
					, Ложь, НоваяСтрока.Горничная, НоваяСтрока.КодЗаполнения);
			КонецЕсли;	
		КонецЦикла;
		
		ОтборСтроки = Новый Структура("Горничная", Строка.Горничная);
		ГорничнаяПомещенияСтроки = СтрокаДанные.ЗарплатаПомещения.Скопировать(ОтборСтроки);
		Для Каждого СтрокаПомещения Из ГорничнаяПомещенияСтроки Цикл
			НоваяСтрока = ТЗ_Квитки.Добавить();
			НоваяСтрока.Горничная = Строка.Горничная;
			НоваяСтрока.КодЗаполнения = "Помещение_" + СтрокаПомещения.Помещение.Наименование + "_" + Строка(СтрокаПомещения.НомерСтроки);;
			НоваяСтрока.Наименование = СтрокаПомещения.Помещение.Наименование;
			НоваяСтрока.ТипСтроки = 1;
			ЗаполнитьСтрокаТЗ_Квитки(НоваяСтрока, ГорничнаяПомещенияСтроки, ТЗ_КвиткиДокумент, "Количество", Истина, НоваяСтрока.Горничная, НоваяСтрока.КодЗаполнения);
			
			ОтборСтроки = Новый Структура("Помещение", СтрокаПомещения.Помещение);
			НайденныеСтроки = ПомещенияЦены.НайтиСтроки(ОтборСтроки);
			Если НайденныеСтроки.Количество() > 0 Тогда
				НоваяСтрока.Цена = НайденныеСтроки[0].Цена;						
			КонецЕсли;
		КонецЦикла;
		
	//
		НоваяСтрока = ТЗ_Квитки.Добавить();
		НоваяСтрока.Горничная = Строка.Горничная;
		НоваяСтрока.КодЗаполнения = "ИтогоНачисления";
		НоваяСтрока.Наименование = "Итого начисления";
		НоваяСтрока.ТипСтроки = 0;
		
	//	
		ОтборСтроки = Новый Структура("ТипСтроки", -1);
		НайденныеСтрокиНастройка = Настройки.НайтиСтроки(ОтборСтроки);
		
		Для Каждого СтрокаНастройка Из НайденныеСтрокиНастройка Цикл
			НоваяСтрока = ТЗ_Квитки.Добавить();
			НоваяСтрока.Горничная = Строка.Горничная;
			НоваяСтрока.КодЗаполнения = СтрокаНастройка.КодЗаполнения;
			НоваяСтрока.Наименование = СтрокаНастройка.Наименование;
			НоваяСтрока.ТипСтроки = СтрокаНастройка.ТипСтроки;
			
			Если ЗначениеЗаполнено(СтрокаНастройка.ИмяЗаполненияКоличество) Тогда
				ЗаполнитьСтрокаТЗ_Квитки(НоваяСтрока, СтрокаДанные.Зарплата, ТЗ_КвиткиДокумент, СтрокаНастройка.ИмяЗаполненияКоличество
					, Истина, НоваяСтрока.Горничная, НоваяСтрока.КодЗаполнения);
			КонецЕсли;	
			Если ЗначениеЗаполнено(СтрокаНастройка.ИмяЗаполненияСумма) Тогда
				ЗаполнитьСтрокаТЗ_Квитки(НоваяСтрока, СтрокаДанные.Зарплата, ТЗ_КвиткиДокумент, СтрокаНастройка.ИмяЗаполненияСумма
					, Ложь, НоваяСтрока.Горничная, НоваяСтрока.КодЗаполнения);
			КонецЕсли;	
		КонецЦикла;

	//
		НоваяСтрока = ТЗ_Квитки.Добавить();
		НоваяСтрока.Горничная = Строка.Горничная;
		НоваяСтрока.КодЗаполнения = "ОстатокКВыплате";
		НоваяСтрока.Наименование = "Остаток к выплате";
		НоваяСтрока.ТипСтроки = 0;
		
		КонецЦикла;
КонецЕсли;
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьСтрокаТЗ_Квитки(СтрокаКЗаполнению, ТЗ_Зарплата, ТЗ_КвиткиДокумент, Имя, ЭтоКоличество, Горничная, КодЗаполнения)
ОтборСтроки = Новый Структура("Горничная", Горничная);
НайденныеСтроки = ТЗ_Зарплата.НайтиСтроки(ОтборСтроки);
СтрокаЗарплата = НайденныеСтроки[0];	
	
ОтборСтроки = Новый Структура("Горничная, КодЗаполнения", Горничная, КодЗаполнения);
НайденныеСтроки = ТЗ_КвиткиДокумент.НайтиСтроки(ОтборСтроки);
Если НайденныеСтроки.Количество() > 0 Тогда
	СтрокаКвитокСтроки = НайденныеСтроки[0];
	
	Если ЭтоКоличество Тогда 
		Если СтрокаКвитокСтроки.Количество_Есть Тогда
			СтрокаКЗаполнению.Количество_Р = СтрокаКвитокСтроки.Количество_Р;
			СтрокаКЗаполнению.Количество_Есть = СтрокаКвитокСтроки.Количество_Есть;
		Иначе
			СтрокаКЗаполнению.Количество_Р = 0;
			СтрокаКЗаполнению.Количество_Есть = Ложь;
		КонецЕсли;
		СтрокаКЗаполнению.Количество = СтрокаЗарплата[Имя];
	Иначе			
		Если СтрокаКвитокСтроки.Сумма_Есть Тогда
			СтрокаКЗаполнению.Сумма_Р = СтрокаКвитокСтроки.Сумма_Р;
			СтрокаКЗаполнению.Сумма_Есть = СтрокаКвитокСтроки.Сумма_Есть;
		Иначе
			СтрокаКЗаполнению.Сумма_Р = 0;
			СтрокаКЗаполнению.Сумма_Есть = Ложь;
		КонецЕсли;
		
		Если Имя <> "НЕТ" Тогда
			СтрокаКЗаполнению.Сумма = СтрокаЗарплата[Имя];
		КонецЕсли;
	КонецЕсли;	
Иначе
	Если ЭтоКоличество Тогда 
		СтрокаКЗаполнению.Количество_Р = 0;
		СтрокаКЗаполнению.Количество_Есть = Ложь;
		СтрокаКЗаполнению.Количество = СтрокаЗарплата[Имя];
	Иначе			
		СтрокаКЗаполнению.Сумма_Р = 0;
		СтрокаКЗаполнению.Сумма_Есть = Ложь;
		Если Имя <> "НЕТ" Тогда
			СтрокаКЗаполнению.Сумма = СтрокаЗарплата[Имя];
		КонецЕсли;
	КонецЕсли;
КонецЕсли;
КонецПроцедуры
