Функция ОтправитьСМС(Телефон, ТекстСМС, ТекстWhatsApp, МесенджерВключен)
Результат = Новый Структура("КодВозврата, ОписаниеОшибки", 0, "");	

Если МесенджерВключен Тогда
	//Ответ = СлужебныеСервер.ОтправитьWhatsApp(Телефон, ТекстWhatsApp);
	Ответ = МесенджерСервер.ОтправитьДанные_Месенджер("ОтправитьТекст", Телефон, ТекстWhatsApp, Неопределено, Неопределено);
	Если Ответ.Ошибка Тогда
		Если СтрНайти(Ответ.Описание, "не зарегистрирован") > 0 Тогда
			ТекстПредупреждения = Ответ.Описание;
			ТекстСообщения = Ответ.Описание;
		ИначеЕсли СтрНайти(Ответ.Описание, "Некорректный номер телефона") > 0 Тогда
			ТекстПредупреждения = Ответ.Описание;
			ТекстСообщения = Ответ.Описание;
		Иначе
			ТекстОшибки = "Ошибка отправки сообщения через Месенджер. ";
			ТекстПредупреждения = ТекстОшибки + Символы.ПС + Ответ.Описание;
				
			ТекстСообщения = ТекстОшибки + Ответ.Описание;
			ТекстСообщения = ТекстСообщения + " ОБРАТИТЕСЬ К АДМИНИСТРАТОРУ ПРОГРАММЫ";
		КонецЕсли;
		
		ТекстПредупреждения = ТекстПредупреждения + Символы.ПС + Символы.ПС 
			+ "БУДЕТ ОТПРАВЛЕНО СМС СООБЩЕНИЕ ...";
		ПоказатьПредупреждение(,ТекстПредупреждения);
		
		ТекстСообщения = ТекстСообщения + Символы.ПС 
			+ "БУДЕТ ОТПРАВЛЕНО СМС СООБЩЕНИЕ ...";
		Сообщить(ТекстСообщения);
		
		Результат.КодВозврата = 1;
		Результат.ОписаниеОшибки = Ответ.Описание;
		
		Перейти ~ОТПРАВКА_СМС;
	КонецЕсли;
	
	Возврат Результат;
КонецЕсли; 	
	
~ОТПРАВКА_СМС:	
Ответ = СлужебныеСервер.ОтправитьBytehand(Телефон, ТекстСМС);
Если Ответ Тогда
	
	ТекстСообщения = "Ошибка отправки СМС. ";
	Сообщить(ТекстСообщения);	
	
	Результат.КодВозврата = 2;
	Результат.ОписаниеОшибки = Результат.ОписаниеОшибки + ". " + ТекстСообщения;
КонецЕсли;

Возврат Результат;
КонецФункции
