&НаКлиенте
Процедура ДокументыДолгиВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
ТекущиеДанные = Элемент.ТекущиеДанные;	
Если ТекущиеДанные = Неопределено Тогда Возврат; КонецЕсли;

ПараметрыФормы = Новый Структура;
ПараметрыФормы.Вставить("ТолькоПросмотр", Истина); 
ПараметрыФормы.Вставить("Ключ", ТекущиеДанные.ДокументДолг); 

ОткрытьФорму("Документ.ЗаявкаНаБронирование.Форма.ФормаДокумента", ПараметрыФормы, ЭтаФорма
	,,,,, РежимОткрытияОкнаФормы.Независимый);
КонецПроцедуры
//

// + Удаление ДокументыДолги
&НаКлиенте
Процедура ДокументыДолгиПередУдалением(Элемент, Отказ)
ТД = Объект.ДокументыДолги.НайтиПоИдентификатору(Элементы.ДокументыДолги.ТекущаяСтрока);

Если ЕстьГрупповыеОплатыЗаявкаСчет(ТД.ДокументДолг, ТД.СчетГУИД) Тогда
	ПоказатьПредупреждение(, "Есть групповая оплата Заявки.
	| 
	|УДАЛЕНИЕ НЕ РАЗРЕШЕНО ..."); 
	
	Отказ = Истина;
	Возврат;
КонецЕсли;

Оповещение = Новый ОписаниеОповещения("ЗавершениеВопросаПодтвердитеУдалениеДокументДолги", ЭтаФорма);
ПоказатьВопрос(Оповещение, "ПОДТВЕРДИТЕ УДАЛЕНИЕ ...", РежимДиалогаВопрос.ОКОтмена);
Отказ = Истина;
КонецПроцедуры

&НаСервере
Функция ЕстьГрупповыеОплатыЗаявкаСчет(ДокументДолг, СчетГУИД)
Запрос = Новый Запрос("ВЫБРАТЬ ПЕРВЫЕ 1
                      |	ЗаявкаНаБронированиеРаспределениеОплатДолги.СчетГУИД КАК СчетГУИД
                      |ИЗ
                      |	Документ.ЗаявкаНаБронирование.РаспределениеОплатДолги КАК ЗаявкаНаБронированиеРаспределениеОплатДолги
                      |		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.ЗаявкаНаБронирование.СчетаДетальноОплаты КАК ЗаявкаНаБронированиеСчетаДетальноОплаты
                      |		ПО ЗаявкаНаБронированиеРаспределениеОплатДолги.Ссылка = ЗаявкаНаБронированиеСчетаДетальноОплаты.Ссылка
                      |			И ЗаявкаНаБронированиеРаспределениеОплатДолги.ДокументОплаты = ЗаявкаНаБронированиеСчетаДетальноОплаты.ДокументОплаты
                      |ГДЕ
                      |	ЗаявкаНаБронированиеСчетаДетальноОплаты.ГрупповаяОплата = ИСТИНА
                      |	И ЗаявкаНаБронированиеРаспределениеОплатДолги.Ссылка = &ДокументДолг
                      |	И ЗаявкаНаБронированиеРаспределениеОплатДолги.СчетГУИД = &СчетГУИД");
Запрос.УстановитьПараметр("ДокументДолг", ДокументДолг); 
Запрос.УстановитьПараметр("СчетГУИД", СчетГУИД); 
Запрос.УстановитьПараметр("ГрупповойСчет", Объект.Ссылка); 

РезультатЗапроса = Запрос.Выполнить();
Возврат НЕ РезультатЗапроса.Пустой(); 
КонецФункции

&НаКлиенте
Процедура ЗавершениеВопросаПодтвердитеУдалениеДокументДолги(Результат, ДополнительныеПараметры) Экспорт
Если Результат = КодВозвратаДиалога.Отмена Тогда Возврат; КонецЕсли;

ТекущиеДанные = Объект.ДокументыДолги.НайтиПоИдентификатору(Элементы.ДокументыДолги.ТекущаяСтрока);
ДокументДолг = ТекущиеДанные.ДокументДолг;
СчетГУИД = ТекущиеДанные.СчетГУИД;

УдалениеДокументДолгиНаСервере(ДокументДолг, СчетГУИД);
