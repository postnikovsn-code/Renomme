&НаСервере
Процедура ПриЧтенииНаСервере(ТекущийОбъект)
ОбновитьКолонкиДокументыКСписанию(ТекущийОбъект);
ОбновитьКолонкиУслуги(ТекущийОбъект);
ОбновитьШапка();
КонецПроцедуры

&НаСервере
Процедура ПослеЗаписиНаСервере(ТекущийОбъект, ПараметрыЗаписи)
ОбновитьКолонкиДокументыКСписанию(ТекущийОбъект);
ОбновитьКолонкиУслуги(ТекущийОбъект);
ОбновитьШапка();
КонецПроцедуры

&НаСервере
Процедура ОбновитьКолонкиДокументыКСписанию(ТекущийОбъект)
Имя = ТекущийОбъект.Метаданные().Имя;

ДатаРезервС = Объект.РезервСОтбор;
ДатаРезервПо = Объект.РезервПоОтбор;
ДатаРезервПо_П = ?(ЗначениеЗаполнено(ДатаРезервПо), ДатаРезервПо, '30010101');
ТЗ = Документы[Имя].ПолучитьДокументыКСписанию(ДатаРезервС, ДатаРезервПо_П, Ложь, Неопределено);

Для Каждого Строка Из Объект.ДокументыКСписанию Цикл
	ОтборСтроки = Новый Структура("ДокументДолг", Строка.ДокументДолг);
	НайденныеСтроки = ТЗ.НайтиСтроки(ОтборСтроки);
	Если НайденныеСтроки.Количество() = 0 Тогда Продолжить; КонецЕсли;
	
	НайденнаяСтрока = НайденныеСтроки[0];
	ЗаполнитьЗначенияСвойств(Строка, НайденнаяСтрока,,"ДокументДолг"); 
	
	Строка.ДолгРавенСчетДолг = (Строка.СуммаДолг = Строка.СуммаСчетДолг);
КонецЦикла;
КонецПроцедуры

&НаСервере
Процедура ОбновитьКолонкиУслуги(ТекущийОбъект)
Если УслугиРодительСправочник.Количество() = 0 Тогда Возврат; КонецЕсли;	
	
СписокЗаявок = Новый Массив;
Для Каждого Строка Из Объект.ДокументыКСписанию Цикл
	СписокЗаявок.Добавить(Строка.ДокументДолг);
КонецЦикла;

Запрос = Новый Запрос("ВЫБРАТЬ
                      |	ЗаявкаНаБронированиеДопУслуги.Ссылка КАК ДокументДолг,
                      |	ЗаявкаНаБронированиеДопУслуги.Услуга КАК Услуга,
                      |	ЗаявкаНаБронированиеДопУслуги.Цена * ЗаявкаНаБронированиеДопУслуги.Количество КАК Сумма
                      |ИЗ
                      |	Документ.ЗаявкаНаБронирование.ДопУслуги КАК ЗаявкаНаБронированиеДопУслуги
                      |ГДЕ
                      |	ЗаявкаНаБронированиеДопУслуги.ВСчет = ИСТИНА
                      |	И ЗаявкаНаБронированиеДопУслуги.Ссылка В(&СписокЗаявок)");

Запрос.УстановитьПараметр("СписокЗаявок", СписокЗаявок); 
ТЗ_Услуги = Запрос.Выполнить().Выгрузить();

ТЗ_УслугиРодитель = ТЗ_Услуги.Скопировать();
ТЗ_УслугиРодитель.Колонки.Добавить("УслугаРодитель");
Для Каждого Строка Из ТЗ_УслугиРодитель Цикл 
	Результат = Справочники.ДопУслуги.ПустаяСсылка();
	Ссылка = Строка.Услуга; 
	ОбщийФункционалСервер.ВерхняяПапка(Ссылка, Результат);			
	
	Строка.УслугаРодитель = Результат;	
КонецЦикла;	
ТЗ_УслугиРодитель.Свернуть("ДокументДолг, УслугаРодитель", "Сумма");

Для Каждого СтрокаСписание Из Объект.ДокументыКСписанию Цикл 
	ОтборСтроки = Новый Структура("ДокументДолг", СтрокаСписание.ДокументДолг);
	НайденныеСтроки = ТЗ_УслугиРодитель.НайтиСтроки(ОтборСтроки);
	
	Для Каждого СтрокаУслугиРодитель Из НайденныеСтроки Цикл
		ОтборСтроки = Новый Структура("УслугаРодитель", СтрокаУслугиРодитель.УслугаРодитель);
		НайденныеСтроки = УслугиРодительСправочник.НайтиСтроки(ОтборСтроки);
		
		Номер = НайденныеСтроки[0].Номер;
		
		Имя = "Услуга_" + Строка(Номер);
		СтрокаСписание[Имя] = СтрокаУслугиРодитель.Сумма;	
	КонецЦикла;
КонецЦикла;

КонецПроцедуры

&НаСервере
Процедура ОбновитьШапка()
Элементы.РезервПоОтбор.ТолькоПросмотр = (Объект.ДокументыКСписанию.Количество() <> 0);
Элементы.РезервСОтбор.ТолькоПросмотр = (Объект.ДокументыКСписанию.Количество() <> 0);
КонецПроцедуры
