	ГорничнаяНаименование = Строка.ГорничнаяНаименование;
	Если СокрЛП(ГорничнаяНаименование) = "" Тогда
		Горничная = Неопределено;
	Иначе	
		Горничная = Справочники.Горничные.НайтиПоНаименованию(Строка.ГорничнаяНаименование);
		Если Горничная.Пустая() Тогда
			НовГ=Справочники.Горничные.СоздатьЭлемент();
			НовГ.Наименование=Строка.ГорничнаяНаименование;
			НовГ.Записать();
			Горничная = НовГ.Ссылка;
		КонецЕсли;
	КонецЕсли;
	//Запрос.УстановитьПараметр("Горничная", Горничная);
	//ТЗ = Запрос.Выполнить().Выгрузить();
	
	ОтборСтроки = Новый Структура("ДатаОбслуживания, НомерОбслуживания_пп, Горничная"
		 , Строка.ДатаОбслуживания, Строка.НомерОбслуживания_пп, Горничная);  
	ТЗ = ТЗ_ГорничныеОбслуживаниеПомещения.НайтиСтроки(ОтборСтроки);
	
	//ГорничныеПомещение = Справочники.ГорничныеПомещения.НайтиПоРеквизиту("ПомещениеГорничные", Строка.ПомещениеГорничные);

	Если ТЗ.Количество() = 0 Тогда
		ГорничныеОбслуживаниеПомещенияОбъект = Документы.ГорничныеОбслуживаниеПомещения.СоздатьДокумент();
		//ГорничныеОбслуживаниеПомещенияОбъект.Дата = ТекущаяДата();
