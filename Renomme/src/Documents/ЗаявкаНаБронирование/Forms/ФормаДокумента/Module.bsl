	//Тогда
		ТекстПредупреждения = "Есть счета c Контрагентом (" + ИмяРеквизитаКонтрагент + ")" + Контрагент_OldValue 
			+ Символы.ПС  + ", включенные в Групповой счет " + ГрупповойСчет
			+ Символы.ПС  + Символы.ПС + "ИЗМЕНЕНИЕ " + ИмяРеквизитаКонтрагент + " НЕ РАЗРЕШЕНО ..."
			+ Символы.ПС  + Символы.ПС + "Для изменения "  + ИмяРеквизитаКонтрагент + " удалите счета c Контрагентом " 
				+ Контрагент_OldValue + " из Группового счета " + ГрупповойСчет;
				
		ПоказатьПредупреждение(, ТекстПредупреждения); 
		
		Возврат Истина; 
	//КонецЕсли;
КонецЕсли;

Возврат Ложь; 
КонецФункции


&НаКлиенте
Асинх Функция ПроверкаИзмененияСкидки(Контрагент, Контрагент_OldValue, ИмяРеквизитаКонтрагент)
Ответ = Новый Структура("Запрещено, ЗаменитьСкидку", Ложь, Ложь); 	

Если ЕстьИзмениеПроцентСкидки() Тогда
	Если ЕстьСчетаКонтрагента(Контрагент_OldValue) Тогда
		Результат = Ждать ВопросАсинх("Есть изменение скидки для " + ИмяРеквизитаКонтрагент + " " + Контрагент + "
							|
							|Есть счета c Контрагентом " + Контрагент_OldValue + "
							|
							|НОВАЯ СКИДКА ПРИМЕНЕНА НЕ БУДЕТ ...
							|
							|ПРОДОЛЖИТЬ ?"
			, РежимДиалогаВопрос.ОКОтмена); 
			
		Если Результат = КодВозвратаДиалога.Отмена Тогда
			Контрагент = Контрагент_OldValue;
			
			Ответ.Запрещено = Истина;
			Возврат Ответ; 
		КонецЕсли;		
		
	Иначе									
		Результат = Ждать ВопросАсинх("Есть изменение скидки для " + Контрагент + "
							|
							|Заменить скидку в Проживание ?"
			, РежимДиалогаВопрос.ДаНет); 	

		ЗаменитьСкидку = (Результат = КодВозвратаДиалога.Да);
		Ответ.ЗаменитьСкидку = ЗаменитьСкидку;
		Возврат Ответ; 
	КонецЕсли; 
КонецЕсли; 

Возврат Ответ;
КонецФункции

&НаКлиенте
Асинх Функция ПодтвердитеЗаменуКонтрагента(Контрагент, Контрагент_OldValue, ИмяРеквизитаКонтрагент, МассивКасса, ЗаменитьСкидку)
Если (Объект.Счета.Количество() > 0 
	ИЛИ Объект.СчетаДетальноОплаты.Количество() > 0) Тогда
	
	ТекстВопроса = "Будет заменен " + ИмяРеквизитаКонтрагент + " " + Контрагент_OldValue + " на " + Контрагент; 
	
	Если ИмяРеквизитаКонтрагент = "'Проживает'" Тогда 
		Если ЗначениеЗаполнено(Объект.Оплачивает) И Объект.Оплачивает = Контрагент_OldValue Тогда 
			ТекстВопроса = ТекстВопроса + "
						|
						|Будет заменен 'Оплачивает': " + Контрагент_OldValue + " на " + Контрагент; 
		КонецЕсли;
	КонецЕсли;		
	
	Если ИмяРеквизитаКонтрагент = "'Оплачивает'" Тогда 
		ЗаменаОплачивает = ПроверкаЗаменыКонтрагентОплачивает(Контрагент, Контрагент_OldValue);
	ИначеЕсли ИмяРеквизитаКонтрагент = "'Бронирует'" Тогда 
		ЗаменаОплачивает = Ложь;
	Иначе 	
		ЗаменаОплачивает = Истина;
	КонецЕсли;
	
	Если ЗаменаОплачивает Тогда 
		Если МассивКасса.Количество() > 0 Тогда 
			ТекстВопроса = ТекстВопроса + "
						|
						|Будет заменен контрагент " + Контрагент_OldValue + " на " + Контрагент + " в кассовых документах Заявки.";
		КонецЕсли;
	КонецЕсли;
	
	Если ЗаменитьСкидку Тогда 
		ТекстВопроса = ТекстВопроса + "
					|
					|Будет заменена скидка в расчете проживания"; 
	КонецЕсли;
	
	ТекстВопроса = ТекстВопроса + "
					|
					|ПОДТВЕРДИТЕ ЗАМЕНУ ...";
	
	Результат = Ждать ВопросАсинх(ТекстВопроса, РежимДиалогаВопрос.ОКОтмена);
	Если Результат = КодВозвратаДиалога.Отмена Тогда 
		Объект.Клиент = Контрагент_OldValue;
		
		Возврат Истина; 
	КонецЕсли;
КонецЕсли;

Возврат Ложь; 

КонецФункции
