
//
&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
Параметры.Свойство("ЭтоКоворкинг", ЭтоКоворкинг);
Если ЭтоКоворкинг Тогда 
	ЭтаФорма.Заголовок = "КОВОРКИНГ";
КонецЕсли;	
	
Параметры.Свойство("КонтрагентыОтбор", КонтрагентыОтбор);
Если КонтрагентыОтбор.Количество() = 0 Тогда
	Элементы.КонтрагентДолг.ТолькоПросмотр = Ложь;
ИначеЕсли КонтрагентыОтбор.Количество() = 1 Тогда
	Элементы.КонтрагентДолг.ТолькоПросмотр = Истина;
	КонтрагентДолг = КонтрагентыОтбор[0].Значение;
Иначе
	//Отказ = Истина; Возврат;
	Элементы.КонтрагентДолг.Видимость = Ложь;
КонецЕсли;	

Параметры.Свойство("ДокументДолг", ДокументДолг);
Если ЗначениеЗаполнено(ДокументДолг) Тогда
	Элементы.ДокументДолг.ТолькоПросмотр = Истина;
КонецЕсли;

Параметры.Свойство("ДокументОплаты", ДокументОплаты);
Если ЗначениеЗаполнено(ДокументОплаты) Тогда
	Элементы.КонтрагентДолг.ТолькоПросмотр = Истина;
	Элементы.ДокументДолг.ТолькоПросмотр = Истина;
	Элементы.ДокументОплаты.ТолькоПросмотр = Истина;
КонецЕсли;

Элементы.ВозвратПолныйЧастичный.СписокВыбора.Добавить("Полный");
Элементы.ВозвратПолныйЧастичный.СписокВыбора.Добавить("Частичный");
ВозвратПолныйЧастичный = "";
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
Если ЗначениеЗаполнено(ДокументОплаты) Тогда
	ЗаполнениеДанныхФормы(ДокументОплаты);	
КонецЕсли;
КонецПроцедуры
//

&НаКлиенте
Процедура Отмена(Команда)
Закрыть();
КонецПроцедуры

