&НаСервереБезКонтекста
Функция СтрДеньН(ДН)
	Если ДН=1 тогда
		Возврат "пн";
	ИначеЕсли ДН=2 тогда
		Возврат "вт";
	ИначеЕсли ДН=3 тогда
		Возврат "ср";
	ИначеЕсли ДН=4 тогда
		Возврат "чт";
	ИначеЕсли ДН=5 тогда
		Возврат "пт";
	ИначеЕсли ДН=6 тогда
		Возврат "сб";
	ИначеЕсли ДН=7 тогда
		Возврат "вс";
	КонецЕсли;
КонецФункции

