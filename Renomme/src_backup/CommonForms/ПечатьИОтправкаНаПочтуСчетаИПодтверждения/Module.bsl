&НаКлиенте
Процедура ОтправитьНаПочту(Команда)
Получатели = Новый СписокЗначений;
Получатели.Добавить(Почта);

Файлы = Новый Массив;

КаталогВременныхФайлов = КаталогВременныхФайлов();

Если ВключитьСчетВПочту Тогда
	Если СокрЛП(ПолноеИмяФайлаСчет) = "" Тогда
		ВременныйФайлСчет = КаталогВременныхФайлов + ИмяФайлаСчет + ".PDF";
		ТабличныйДокумент.Записать(ВременныйФайлСчет, "PDF");
	Иначе
		Индекс = СтрНайти(ПолноеИмяФайлаСчет, "\", НаправлениеПоиска.СКонца);
		ИмяФайла = Сред(ПолноеИмяФайлаСчет, Индекс + 1);
		ВременныйФайлСчет = КаталогВременныхФайлов + ИмяФайла + ".PDF";
		
		Если СохранитьСчетPDF(ВременныйФайлСчет) Тогда Возврат; КонецЕсли;
	КонецЕсли;
	Файлы.Добавить(ВременныйФайлСчет);
КонецЕсли;
	
Если ВключитьПодтверждениеВПочту 
И  СокрЛП(ПолноеИмяФайлаПодтверждение) <> ""  
Тогда
	ВременныйФайлПодтверждение = КаталогВременныхФайлов + ИмяФайлаПодтверждение + ".PDF";
	СохранитьПодтверждениеPDF(ВременныйФайлПодтверждение);
	Файлы.Добавить(ВременныйФайлПодтверждение);
КонецЕсли;

Если ЭтаФорма.КлючУникальности = Неопределено Тогда
	УникальныйИдентификаторФормы = Новый УникальныйИдентификатор();
Иначе
	УникальныйИдентификаторФормы = Новый УникальныйИдентификатор(ЭтаФорма.КлючУникальности);
КонецЕсли;	
ФайлыКУдалению = Файлы;
СлужебныеКлиент.ОтправитьEmail(ПочтаТема, Файлы, Получатели, ПочтаТекстСообщения, ФайлыКУдалению, УникальныйИдентификаторФормы);
КонецПроцедуры

&НаКлиенте
Процедура СохранитьПодтверждениеPDF(ПолноеИмяФайла)
ФайлНаДиске = Новый Файл(ПолноеИмяФайлаПодтверждение);
Если НЕ ФайлНаДиске.Существует() Тогда Возврат; КонецЕсли;	

Если ПодтверждениеWORD Тогда
	MSWord = Новый COMОбъект("Word.Application");
	Документ = MSWord.Documents.Open(ПолноеИмяФайлаПодтверждение);

	wdFormatPDF = 17;
	Документ.SaveAs2(ПолноеИмяФайла, wdFormatPDF); 

	Попытка
		wdDoNotSaveChanges = 0;
		MSWord.Quit(wdDoNotSaveChanges);
		MSWord = Неопределено;
	Исключение
		Сообщить(ОписаниеОшибки());	
	КонецПопытки;
Иначе	
	MSExcel = Новый COMОбъект("Excel.Application");
	WorkBook = MSExcel.Workbooks.Open(ПолноеИмяФайлаПодтверждение); 

	xlTypePDF = 0;
	Попытка 
		WorkBook.ExportAsFixedFormat (xlTypePDF , ПолноеИмяФайла);
	Исключение
		Сообщить(ОписаниеОшибки());	
	КонецПопытки;
	
	Попытка
		MSExcel.Quit();
		MSExcel = Неопределено;
	Исключение
		Сообщить(ОписаниеОшибки());	
	КонецПопытки;
КонецЕсли;
КонецПроцедуры

&НаКлиенте
Функция СохранитьСчетPDF(ВременныйФайлСчет)
MSExcel = Новый COMОбъект("Excel.Application");	   
Книга = MSExcel.WorkBooks.Open(ПолноеИмяФайлаСчет);

Попытка
	MSExcel.Application.DisplayAlerts = False; 
	
	xlTypePDF =	0; //	"PDF" — файл в формате PDF (PDF)
	//Книга.ExportAsFixedFormat(xlTypePDF , ВременныйФайлСчет);
	Попытка 
		Книга.ExportAsFixedFormat (xlTypePDF , ВременныйФайлСчет);
	Исключение
		Сообщить(ОписаниеОшибки());	
	КонецПопытки;
	
	Попытка
		MSExcel.Quit();
		MSExcel = Неопределено;
	Исключение
		Сообщить(ОписаниеОшибки());	
	КонецПопытки;
	//SaveChanges = False;
	//Книга.Close(SaveChanges);
	//Excel.Quit();	
Исключение
	Сообщить(ОписаниеОшибки());

	Возврат Истина; 
КонецПопытки;

Возврат Ложь; 
КонецФункции
