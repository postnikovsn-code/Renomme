&НаСервере
Функция КоличествоЧасовОтчет(Администратор)
Если Администратор.Постоянный Тогда
	//КоличествоЧасовОтчет = 0;
	
	ОтборСтроки = Новый Структура("Администратор", Администратор);
	ТЗ = Объект.ЗарплатаСмены.Выгрузить(ОтборСтроки);
	
	//КоличествоЧасовОтчет = ТЗ.Итог("ДлинаСмены");
	КоличествоЧасовДлинаСмены = ТЗ.Итог("ДлинаСмены");
	КоличествоЧасовПереработкаЧасы = ТЗ.Итог("ПереработкаЧасы"); 
	КоличествоЧасовОтчет = КоличествоЧасовДлинаСмены + КоличествоЧасовПереработкаЧасы;

Иначе
	ОтборСтроки = Новый Структура("Администратор", Администратор);
	ТЗ = Объект.ЗарплатаСмены.Выгрузить(ОтборСтроки);
	
	//КоличествоЧасовОтчет = ТЗ.Итог("ДлинаСмены");     
	КоличествоЧасовДлинаСмены = ТЗ.Итог("ДлинаСмены");
	КоличествоЧасовПереработкаЧасы = ТЗ.Итог("ПереработкаЧасы"); 
	КоличествоЧасовОтчет = КоличествоЧасовДлинаСмены + КоличествоЧасовПереработкаЧасы;
КонецЕсли;
	
Возврат КоличествоЧасовОтчет;	
КонецФункции

&НаКлиенте
Процедура ОтчетЗарплатаРасширенный(Команда)
Если НЕ (ЗначениеЗаполнено(Объект.ДН) И ЗначениеЗаполнено(Объект.ДК)) Тогда Возврат; КонецЕсли; 
	
ТабДок = ОтчетЗарплатаРасширенныйНаСервере();

ПараметрыФормы = Новый Структура("ПолеОтчета, ЗаголовокОтчета", ТабДок, "Зарплаты администраторов Расширенный"); 
ОткрытьФорму("ОбщаяФорма.ВыводОтчета", ПараметрыФормы, , Истина);
	
КонецПроцедуры

&НаСервере
Функция ОтчетЗарплатаРасширенныйНаСервере()
ТабДок = Новый ТабличныйДокумент;

Макет = Документы.АдминистраторыЗарплата.ПолучитьМакет("МакетРасширенный");	

//Область = Макет.ПолучитьОбласть("Заголовок");
//ТабДок.Вывести(Область);

Область = Макет.ПолучитьОбласть("Шапка|Лево");
ТабДок.Вывести(Область);

Дата_П = Объект.ДН;
Пока Дата_П <= Объект.ДК Цикл
	Дата_С = Формат(Дата_П, "ДФ=dd.MM.yy");
	Дата_И = СтрЗаменить(Дата_С, ".", "");
	
	Имя_Право = Дата_И;
	
	ОбластьПраво = Макет.ПолучитьОбласть("Шапка|Право");
	ОбластьПраво.Параметры.Дата = Дата_С;
	
	ТабДок.Присоединить(ОбластьПраво);
	
	Дата_П = Дата_П + 24 * 60 * 60;
КонецЦикла;

Для Каждого Строка Из ЗарплатаСмены Цикл
	Область = Макет.ПолучитьОбласть("Строка|Лево");
	
	Область.Параметры.Администратор = Строка.Администратор;
	Область.Параметры.КоличествоСмен = Строка.КоличествоСмен;
	Область.Параметры.Оклад = Строка.Оклад_Э;
	Область.Параметры.Переработка = Строка.СуммаПереработка_Э;
	Область.Параметры.Отпуск = Строка.Отпуск_Э;
	Область.Параметры.НадбавкаЗаСтаж = Строка.НадбавкаЗаСтаж_Э;
	Область.Параметры.НадбавкаЗаСтандарты = Строка.НадбавкаЗаСтандарты_Э;
	Область.Параметры.НадбавкаЗаИнЯзыки = Строка.НадбавкаЗаИнЯзыки_Э;
	
	Область.Параметры.ДопУслуги = Строка.ДопУслуги;
	Область.Параметры.Больничный = Строка.Больничный;
	Область.Параметры.Премия = Строка.Премия;
	
	Область.Параметры.СуммаЗаПроживающих = Строка.СуммаЗаПроживающих_Э;
	
	Область.Параметры.СуммаЗаселенийЛайв = Строка.СуммаЗаселенийЛайв_Э;
	Область.Параметры.ЗарплатаИтого = Строка.Итого;
	
	ТабДок.Вывести(Область);
	
	Дата_П = Объект.ДН;
	Пока Дата_П <= Объект.ДК Цикл
		Дата_С = Формат(Дата_П, "ДФ=dd.MM.yy");
		Дата_И = СтрЗаменить(Дата_С, ".", "");
		
		Имя_Право = Дата_И;
		
		ОбластьПраво = Макет.ПолучитьОбласть("Строка|Право");
		
		НомерСмены = Строка["НомерСмены_" + Имя_Право];
		Если НомерСмены <> 0 Тогда
			НомерДлинаСмены = "" + Строка["НомерСмены_" + Имя_Право] + " / " + Строка["ДлинаСмены_" + Имя_Право];
			ОбластьПраво.Параметры.НомерДлинаСмены = НомерДлинаСмены;
		КонецЕсли;
		
		ОбластьПраво.Параметры.Итого = Строка["Итого_" + Имя_Право];
		ОбластьПраво.Параметры.Оклад = Строка["Оклад_" + Имя_Право];
		ОбластьПраво.Параметры.Переработка = Строка["СуммаПереработка_" + Имя_Право];
		ОбластьПраво.Параметры.СуммаЗаПроживающих = Строка["СуммаЗаПроживающих_" + Имя_Право];
		ОбластьПраво.Параметры.СуммаЗаселенийЛайв = Строка["СуммаЗаселенийЛайв_" + Имя_Право];
		
		ТабДок.Присоединить(ОбластьПраво);
		
		Дата_П = Дата_П + 24 * 60 * 60;
	КонецЦикла;	


КонецЦикла;

Возврат ТабДок;
КонецФункции

