	Если НЕ ЮрЛицо Тогда
		Если ЕстьКлиент2 Тогда
			Если НеПервый Тогда 
				Строка.Цена = (Строка.Цена - Строка.Цена / 2 - 0.001); 			
				Строка.СуммаДолг = (Строка.СуммаДолг - Строка.СуммаДолг / 2 - 0.001); 			
				Строка.СуммаКЗакрытию = (Строка.СуммаКЗакрытию - Строка.СуммаКЗакрытию / 2 - 0.001); 			
			Иначе
				Строка.Цена = Строка.Цена / 2 + 0.001;
				Строка.СуммаДолг = Строка.СуммаДолг / 2 + 0.001; 			
				Строка.СуммаКЗакрытию = Строка.СуммаКЗакрытию / 2 + 0.001; 			
			КонецЕсли;	
		КонецЕсли;	
	КонецЕсли;	
КонецЕсли;
КонецПроцедуры

