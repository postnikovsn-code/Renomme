Процедура УдалитьДанныеДокумента()
Запрос = Новый Запрос("ВЫБРАТЬ
                      |	КассовыйДокумент.Ссылка КАК Ссылка
                      |ИЗ
                      |	Документ.КассовыйДокумент КАК КассовыйДокумент
                      |ГДЕ
                      |	КассовыйДокумент.ДокументДолг = &ДокументДолг");
Запрос.УстановитьПараметр("ДокументДолг", Ссылка);
ТЗ = Запрос.Выполнить().Выгрузить();
Для Каждого Строка Из ТЗ Цикл
	КассовыйДокументОбъект = Строка.Ссылка.ПолучитьОбъект();
	КассовыйДокументОбъект.ДокументДолг = Неопределено;
	КассовыйДокументОбъект.Записать(РежимЗаписиДокумента.Проведение);
КонецЦикла;

Запрос = Новый Запрос("ВЫБРАТЬ
                      |	ВыпискаБанкаДолгиОплата.Ссылка КАК Ссылка
                      |ИЗ
                      |	Документ.ВыпискаБанка.ДолгиОплата КАК ВыпискаБанкаДолгиОплата
                      |ГДЕ
                      |	ВыпискаБанкаДолгиОплата.ДокументДолг = &ДокументДолг
                      |
                      |УПОРЯДОЧИТЬ ПО
                      |	Ссылка,
                      |	ДокументДолг");

Запрос.УстановитьПараметр("ДокументДолг", Ссылка);
ТЗ = Запрос.Выполнить().Выгрузить();
ТЗ.Свернуть("Ссылка");

ОтборСтроки = Новый Структура("ДокументДолг", Ссылка);
Для Каждого Строка Из ТЗ Цикл
	ВыпискаБанкаОбъект = Строка.Ссылка.ПолучитьОбъект();
	
	ОбщийФункционалСервер.УдалитьСтрокиОтборСтроки(ОтборСтроки, ВыпискаБанкаОбъект.ДолгиОплата); 
КонецЦикла;

ЗаявкаСервер.УдалитьИсториюКлиента(ЭтотОбъект);  
КонецПроцедуры

