&НаКлиенте
Процедура ВопросВыбратьДокументДолг() 

Оповещение = Новый ОписаниеОповещения("ЗавершениеВопросаВыбратьДокументДолг", ЭтаФорма);
СписокЗначений = Новый СписокЗначений;
СписокЗначений.Добавить(1, "Заявка на бронирование"); 
СписокЗначений.Добавить(2, "Групповой Счет"); 
СписокЗначений.Добавить(3, "Счет Коворкинг"); 
СписокЗначений.Добавить(0, "Отмена"); 

ПоказатьВопрос(Оповещение
	, "Выбрать документ бронирования ..."
	, СписокЗначений, ,1);
КонецПроцедуры

&НаКлиенте
Процедура ЗавершениеВопросаВыбратьДокументДолг(Результат, Параметры) Экспорт
Если Результат = 0 Тогда Возврат; КонецЕсли;

ВыбратьДокументБронирования(Результат, Параметры);
КонецПроцедуры

&НаКлиенте
Процедура ВыбратьДокументБронирования(Результат, Параметры) Экспорт
	
Если Результат = 1 Тогда
	Парам = Новый Структура("КлиентОтбор", Объект.ОтКого);
	Оповещение = Новый ОписаниеОповещения("ЗакрытиеФормыВыбораДокумента", ЭтаФорма);

	ОткрытьФорму("Документ.ЗаявкаНаБронирование.Форма.ФормаВыбораДляКассовыйДокумент", Парам, ЭтаФорма
		,,,,Оповещение, РежимОткрытияОкнаФормы.БлокироватьВесьИнтерфейс);
ИначеЕсли Результат = 2 Тогда
	ОтборПараметры = Новый Структура("Контрагент", Объект.ОтКого);
	Парам = Новый Структура("Отбор", ОтборПараметры);
	Парам.Вставить("ТолькоПросмотр", Истина);
	Оповещение = Новый ОписаниеОповещения("ЗакрытиеФормыВыбораДокумента", ЭтаФорма);

	ОткрытьФорму("Документ.ГрупповыеСчета.ФормаВыбора", Парам , ЭтаФорма
		,,,,Оповещение, РежимОткрытияОкнаФормы.БлокироватьВесьИнтерфейс);
ИначеЕсли Результат = 3 Тогда
	Парам = Новый Структура("КлиентОтбор", Объект.ОтКого);
	Оповещение = Новый ОписаниеОповещения("ЗакрытиеФормыВыбораДокумента", ЭтаФорма);

	ОткрытьФорму("Документ.КоворкингСчета.Форма.ФормаВыбораДляКассовыйДокумент", Парам , ЭтаФорма
		,,,,Оповещение, РежимОткрытияОкнаФормы.БлокироватьВесьИнтерфейс);
КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ЗакрытиеФормыВыбораДокумента(Результат, Параметры) Экспорт
Если Результат = Неопределено Тогда Возврат; КонецЕсли;
	
Объект.ДокументДолг = Результат;

ПересчетДолга();
КонецПроцедуры
