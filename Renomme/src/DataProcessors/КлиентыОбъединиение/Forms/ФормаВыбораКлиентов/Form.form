  <attributes>
    <name>Список</name>
    <title>
      <key>ru</key>
      <value>Список</value>
    </title>
    <id>2</id>
    <valueType>
      <types>DynamicList</types>
    </valueType>
    <view>
      <common>true</common>
    </view>
    <edit>
      <common>true</common>
    </edit>
    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>Список.ЭтоГруппа</segments>
    </notDefaultUseAlwaysAttributes>
    <main>true</main>
    <extInfo xsi:type="form:DynamicListExtInfo">
      <queryText>ВЫБРАТЬ
	Клиенты.Ссылка КАК Клиент,
	Клиенты.ИНН КАК ИНН,
	Клиенты.КПП КАК КПП,
	Клиенты.Родитель КАК Родитель,
	ВЫРАЗИТЬ(NULL КАК СТРОКА(500)) КАК ПолныйПутьРодитель,
	Клиенты.ЭтоГруппа КАК ЭтоГруппа,
	Клиенты.ПометкаУдаления КАК ПометкаУдаления,
	Выписка.ВыпискиКоличество КАК ВыпискиКоличество,
	ГрупповыеСчета.ГрупповыеСчетаКоличество КАК ГрупповыеСчетаКоличество,
	Заявки.ЗаявкиКоличество КАК ЗаявкиКоличество
ИЗ
	Справочник.Клиенты КАК Клиенты
		ЛЕВОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
			ЗаявкаНаБронирование.Оплачивает КАК Оплачивает,
			КОЛИЧЕСТВО(РАЗЛИЧНЫЕ ЗаявкаНаБронирование.Ссылка) КАК ЗаявкиКоличество
		ИЗ
			Документ.ЗаявкаНаБронирование КАК ЗаявкаНаБронирование
		
		СГРУППИРОВАТЬ ПО
			ЗаявкаНаБронирование.Оплачивает) КАК Заявки
		ПО Клиенты.Ссылка = Заявки.Оплачивает
		ЛЕВОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
			ГрупповыеСчета.Контрагент КАК Контрагент,
			КОЛИЧЕСТВО(РАЗЛИЧНЫЕ ГрупповыеСчета.Ссылка) КАК ГрупповыеСчетаКоличество
		ИЗ
			Документ.ГрупповыеСчета КАК ГрупповыеСчета
		
		СГРУППИРОВАТЬ ПО
			ГрупповыеСчета.Контрагент) КАК ГрупповыеСчета
		ПО Клиенты.Ссылка = ГрупповыеСчета.Контрагент
		ЛЕВОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
			ВыпискаБанка.ОтКого КАК ОтКого,
			КОЛИЧЕСТВО(РАЗЛИЧНЫЕ ВыпискаБанка.Ссылка) КАК ВыпискиКоличество
		ИЗ
			Документ.ВыпискаБанка КАК ВыпискаБанка
		
		СГРУППИРОВАТЬ ПО
