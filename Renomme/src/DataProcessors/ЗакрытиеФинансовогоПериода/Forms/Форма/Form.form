  <attributes>
    <name>Список</name>
    <title>
      <key>ru</key>
      <value>Список</value>
    </title>
    <id>2</id>
    <valueType>
      <types>DynamicList</types>
    </valueType>
    <view>
      <common>true</common>
    </view>
    <edit>
      <common>true</common>
    </edit>
    <extInfo xsi:type="form:DynamicListExtInfo">
      <queryText>ВЫБРАТЬ
	ЗаявкаНаБронирование.Ссылка КАК ЗаявкаНаБронирование,
	ПроживаниеСумма.Сумма КАК СуммаПроживание,
	УслугиСумма.Сумма КАК СуммаУслуги,
	СчетаПроживание.СуммаДолг КАК СуммаПроживаниеСчета,
	СчетаУслуги.СуммаДолг КАК СуммаУслугиСчета,
	СчетаПроживание.СуммаКЗакрытию КАК СуммаДолгаПроживание,
	СчетаУслуги.СуммаКЗакрытию КАК СуммаДолгаУслуги,
	СписаниеПроживания.СуммаОплаты КАК СуммаСписанияПроживание,
	СписаниеУслуги.СуммаОплаты КАК СуммаСписанияУслуги,
	Списание.СуммаОплаты КАК СуммаСписания,
	ЕСТЬNULL(СчетаПроживание.СуммаКЗакрытию, 0) + ЕСТЬNULL(СчетаУслуги.СуммаКЗакрытию, 0) КАК СуммаДолга,
	ЗаявкаНаБронирование.КомментарийОтветственного КАК КомментарийОтветственного
ИЗ
	Документ.ЗаявкаНаБронирование КАК ЗаявкаНаБронирование
		ЛЕВОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
			ЗаявкаНаБронированиеПроживание.Ссылка КАК Ссылка,
			СУММА(ЗаявкаНаБронированиеПроживание.Сумма) КАК Сумма
		ИЗ
			Документ.ЗаявкаНаБронирование.Проживание КАК ЗаявкаНаБронированиеПроживание
		
		СГРУППИРОВАТЬ ПО
			ЗаявкаНаБронированиеПроживание.Ссылка) КАК ПроживаниеСумма
		ПО ЗаявкаНаБронирование.Ссылка = ПроживаниеСумма.Ссылка
		ЛЕВОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
			ЗаявкаНаБронированиеДопУслуги.Ссылка КАК Ссылка,
			СУММА(ЗаявкаНаБронированиеДопУслуги.Количество * ЗаявкаНаБронированиеДопУслуги.Цена) КАК Сумма
		ИЗ
			Документ.ЗаявкаНаБронирование.ДопУслуги КАК ЗаявкаНаБронированиеДопУслуги
		ГДЕ
			ЗаявкаНаБронированиеДопУслуги.ВСчет = ИСТИНА
		
		СГРУППИРОВАТЬ ПО
			ЗаявкаНаБронированиеДопУслуги.Ссылка) КАК УслугиСумма
		ПО ЗаявкаНаБронирование.Ссылка = УслугиСумма.Ссылка
		ЛЕВОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
			ЗаявкаНаБронированиеСчетаДетальноДолги.Ссылка КАК Ссылка,
			СУММА(ЗаявкаНаБронированиеСчетаДетальноДолги.СуммаДолг) КАК СуммаДолг,
			СУММА(ЗаявкаНаБронированиеСчетаДетальноДолги.СуммаКЗакрытию) КАК СуммаКЗакрытию
		ИЗ
			Документ.ЗаявкаНаБронирование.СчетаДетальноДолги КАК ЗаявкаНаБронированиеСчетаДетальноДолги
		ГДЕ
			ЗаявкаНаБронированиеСчетаДетальноДолги.Услуга = ЛОЖЬ
		
		СГРУППИРОВАТЬ ПО
			ЗаявкаНаБронированиеСчетаДетальноДолги.Ссылка) КАК СчетаПроживание
		ПО ЗаявкаНаБронирование.Ссылка = СчетаПроживание.Ссылка
		ЛЕВОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
			ЗаявкаНаБронированиеСчетаДетальноДолги.Ссылка КАК Ссылка,
			СУММА(ЗаявкаНаБронированиеСчетаДетальноДолги.СуммаДолг) КАК СуммаДолг,
			СУММА(ЗаявкаНаБронированиеСчетаДетальноДолги.СуммаКЗакрытию) КАК СуммаКЗакрытию
		ИЗ
			Документ.ЗаявкаНаБронирование.СчетаДетальноДолги КАК ЗаявкаНаБронированиеСчетаДетальноДолги
		ГДЕ
			ЗаявкаНаБронированиеСчетаДетальноДолги.Услуга = ИСТИНА
		
		СГРУППИРОВАТЬ ПО
			ЗаявкаНаБронированиеСчетаДетальноДолги.Ссылка) КАК СчетаУслуги
		ПО ЗаявкаНаБронирование.Ссылка = СчетаУслуги.Ссылка
		ЛЕВОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
			ЗаявкаНаБронированиеРаспределениеОплатДолги.Ссылка КАК Ссылка,
			СУММА(ЗаявкаНаБронированиеРаспределениеОплатДолги.СуммаОплаты) КАК СуммаОплаты
		ИЗ
			Документ.ЗаявкаНаБронирование.РаспределениеОплатДолги КАК ЗаявкаНаБронированиеРаспределениеОплатДолги
		ГДЕ
			ТИПЗНАЧЕНИЯ(ЗаявкаНаБронированиеРаспределениеОплатДолги.ДокументОплаты) = ТИП(Документ.ПрочиеОплаты)
			И ЗаявкаНаБронированиеРаспределениеОплатДолги.ДокументОплаты.ВидОперации = ЗНАЧЕНИЕ(Справочник.ВидыОпераций.СписаниеПроживание)
		
		СГРУППИРОВАТЬ ПО
			ЗаявкаНаБронированиеРаспределениеОплатДолги.Ссылка) КАК СписаниеПроживания
		ПО ЗаявкаНаБронирование.Ссылка = СписаниеПроживания.Ссылка
		ЛЕВОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
			ЗаявкаНаБронированиеРаспределениеОплатДолги.Ссылка КАК Ссылка,
			СУММА(ЗаявкаНаБронированиеРаспределениеОплатДолги.СуммаОплаты) КАК СуммаОплаты
		ИЗ
			Документ.ЗаявкаНаБронирование.РаспределениеОплатДолги КАК ЗаявкаНаБронированиеРаспределениеОплатДолги
		ГДЕ
			ТИПЗНАЧЕНИЯ(ЗаявкаНаБронированиеРаспределениеОплатДолги.ДокументОплаты) = ТИП(Документ.ПрочиеОплаты)
			И ЗаявкаНаБронированиеРаспределениеОплатДолги.ДокументОплаты.ВидОперации = ЗНАЧЕНИЕ(Справочник.ВидыОпераций.СписаниеДопУслуг)
		
		СГРУППИРОВАТЬ ПО
			ЗаявкаНаБронированиеРаспределениеОплатДолги.Ссылка) КАК СписаниеУслуги
		ПО ЗаявкаНаБронирование.Ссылка = СписаниеУслуги.Ссылка
		ЛЕВОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
			ЗаявкаНаБронированиеРаспределениеОплатДолги.Ссылка КАК Ссылка,
			СУММА(ЗаявкаНаБронированиеРаспределениеОплатДолги.СуммаОплаты) КАК СуммаОплаты
		ИЗ
			Документ.ЗаявкаНаБронирование.РаспределениеОплатДолги КАК ЗаявкаНаБронированиеРаспределениеОплатДолги
		ГДЕ
			ТИПЗНАЧЕНИЯ(ЗаявкаНаБронированиеРаспределениеОплатДолги.ДокументОплаты) = ТИП(Документ.ПрочиеОплаты)
			И ЗаявкаНаБронированиеРаспределениеОплатДолги.ДокументОплаты.ВидОперации = ЗНАЧЕНИЕ(Справочник.ВидыОпераций.Списание)
		
		СГРУППИРОВАТЬ ПО
			ЗаявкаНаБронированиеРаспределениеОплатДолги.Ссылка) КАК Списание
		ПО ЗаявкаНаБронирование.Ссылка = Списание.Ссылка
ГДЕ
	ЗаявкаНаБронирование.ПометкаУдаления = ЛОЖЬ
	И (ЗаявкаНаБронирование.Статус = ЗНАЧЕНИЕ(Перечисление.СтатусБрони.Выехал)
			ИЛИ ЗаявкаНаБронирование.Статус = ЗНАЧЕНИЕ(Перечисление.СтатусБрони.Неустойка))
	И ЗаявкаНаБронирование.РезервПо &lt;= &amp;ДатаПо
	И ЗаявкаНаБронирование.РезервПо >= &amp;ДатаС</queryText>
      <autoFillAvailableFields>true</autoFillAvailableFields>
      <customQuery>true</customQuery>
      <autoSaveUserSettings>true</autoSaveUserSettings>
      <getInvisibleFieldPresentations>true</getInvisibleFieldPresentations>
    </extInfo>
  </attributes>
