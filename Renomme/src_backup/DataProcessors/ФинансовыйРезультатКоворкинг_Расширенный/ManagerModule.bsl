			Область_ОплатыСчет.Параметры.Дата = Формат(СтрокаОплатыСчет.ДатаС, "ДФ=dd.MM.yy");
			СчетОбластьЗаполнить(СтрокаОплатыСчет.Счет, Область_ОплатыСчет, ИтогиДень);	
			
			ОплатаОбластьЗаполнить(СтрокаОплатыСчет, Область_ОплатыСчет, ИтогиДень);
			
			ПолеОтчета.Вывести(Область_ОплатыСчет, 1);

			ИмяОбластьУслуги = "СтрокаОплатыСчетДополнение";
	        ОбластьВывода = УслугиОбластьВывести(СтрокаОплатыСчет.Счет, ТЗ_РодительУслуги, ИмяОбластьУслуги, Макет, ПолеОтчета, ИтогиДень); 
			
			ВыведеннаяОбласть = ПолеОтчета.Область(ОбластьВывода.Верх, , ОбластьВывода.Низ);
			
			Если СтрокаОплатыСчет.ОстатокДокументаОплаты > 0 Тогда
				ВыведеннаяОбласть.ЦветТекста = Новый Цвет(0, 128, 0);		
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	
	Продолжить;
	
