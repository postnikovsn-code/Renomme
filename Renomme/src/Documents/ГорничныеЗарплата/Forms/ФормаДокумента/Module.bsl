	+ Сдельно_нал + ИныеВыплаты_нал; 
	
ОстатокКВыдаче = ЗарплатаИтого - Выдано;     

СуммаМинимум = Зарплата.Итог("СуммаМинимум");
КоличествоСмен = Зарплата.Итог("КоличествоСмен_Э");
КоличествоЧасов = Зарплата.Итог("КоличествоЧасов_Э");

Область.Параметры.Оклад = Оклад;
Область.Параметры.НадбавкаЗаСтаж = НадбавкаЗаСтаж;
Область.Параметры.НадбавкаЗаСтандарты = НадбавкаЗаСтандарты;

Область.Параметры.Отпуск = Отпуск;
Область.Параметры.Больничный = Больничный;
Область.Параметры.Премия = Премия;

Область.Параметры.ДопРаботы = ДопРаботы;
Область.Параметры.Сдельно = Сдельно;

Область.Параметры.КорректировкаДопНачислено = КорректировкаДопНачислено;      

Область.Параметры.СуммаПрачечная = СуммаПрачечная;

Область.Параметры.СуммаУборки = СуммаУборки;
Область.Параметры.СуммаПомещения = СуммаПомещения;

Область.Параметры.Итого = Итого;      
Область.Параметры.ЗарплатаИтого = ЗарплатаИтого;      

Область.Параметры.Аванс_кк = Аванс_кк;      
Область.Параметры.Аванс_нал = Аванс_нал;      
Область.Параметры.Зарплата_кк = Зарплата_кк;      
Область.Параметры.Отпуск_кк = Отпуск_кк;      
Область.Параметры.Отпуск_нал = Отпуск_нал;      
Область.Параметры.Сдельно_нал = Сдельно_нал;      
Область.Параметры.ИныеВыплаты_нал = ИныеВыплаты_нал;      

Область.Параметры.ОстатокКВыдаче = ОстатокКВыдаче;      

Область.Параметры.СуммаМинимум = СуммаМинимум;  
Область.Параметры.КоличествоСмен = КоличествоСмен;  
Область.Параметры.КоличествоЧасов = КоличествоЧасов;  

ТабДок.Вывести(Область);

ТабДок.ОриентацияСтраницы = ОриентацияСтраницы.Ландшафт;

Возврат ТабДок;
КонецФункции
