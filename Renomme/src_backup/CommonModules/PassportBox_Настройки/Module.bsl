
////////////////////////////////////////////////////////////////////////////////
// Настройки сканера паспортов PassportBoxВызовСервера.
// См. константы PassportBoxIP / PassportBoxПорт / PassportBoxТаймаут / PassportBoxАктивность
// и обработку DataProcessor.НастройкиPassportBoxВызовСервера.
////////////////////////////////////////////////////////////////////////////////

// Возвращает Структуру с настройками сканера PassportBox для текущей базы.
// Поля: IP (Строка), Порт (Число), Таймаут (Число), Активность (Булево).
// Если соответствующие константы не заполнены — подставляются разумные дефолты.
Функция PassportBoxНастройки() Экспорт
	IP         = Константы.PassportBoxIP.Получить();
	Порт       = Константы.PassportBoxПорт.Получить();
	Таймаут    = Константы.PassportBoxТаймаут.Получить();
	Активность = Константы.PassportBoxАктивность.Получить();
	Если Порт = 0 Тогда Порт = 80; КонецЕсли;
	Если Таймаут = 0 Тогда Таймаут = 30; КонецЕсли;
	Возврат Новый Структура("IP,Порт,Таймаут,Активность", СокрЛП(IP), Порт, Таймаут, Активность);
КонецФункции

// Проверяет связь со сканером по текущим настройкам (Snapshot-запрос).
// Возвращает Структуру: {Успех (Булево), Описание (Строка)}.
Функция PassportBoxПроверитьСвязь() Экспорт
	Настройки = PassportBoxНастройки();
	Если НЕ ЗначениеЗаполнено(Настройки.IP) Тогда
		Возврат Новый Структура("Успех,Описание", Ложь, "Не задан IP сканера PassportBoxВызовСервера.");
	КонецЕсли;
	Соединение = PassportBoxВызовСервера.СоздатьСоединение(Настройки.IP, Настройки.Порт);
	Если Соединение.Ошибка Тогда
		Возврат Новый Структура("Успех,Описание", Ложь, Соединение.Описание);
	КонецЕсли;
	Снимок = PassportBoxВызовСервера.ПолучитьКартинку(Соединение, "Snapshot");
	Если Снимок.Ошибка Тогда
		Возврат Новый Структура("Успех,Описание", Ложь, Снимок.Описание);
	КонецЕсли;
	Возврат Новый Структура("Успех,Описание", Истина, "Snapshot получен (" + Формат(Снимок.ДанныеКартинки.Размер(), "ЧГ=0") + " байт).");
КонецФункции
