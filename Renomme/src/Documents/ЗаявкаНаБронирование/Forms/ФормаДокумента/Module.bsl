Процедура ПриЗаписиНаСервере(Отказ, ТекущийОбъект, ПараметрыЗаписи)
ТЗ = ПрошлыйПериодДопУслуги.Выгрузить();
//ТЗ.Свернуть("ПрочиеОплатыДокументОплаты, ПрочиеОплатыДокументДолг, Добавлено", "Сумма");
ТЗ.Свернуть("ПрочиеОплатыДокументОплаты, ПрочиеОплатыДокументДолг", "Сумма");

Для Каждого Строка Из ПрошлыйПериодДопУслуги Цикл
	//Если Строка.Услуга <> Справочники.ДопУслуги.ДолгиЗаУслугиПрошлыйПериод Тогда Продолжить; КонецЕсли;
	
	ПрочиеОплатыОбъект = Строка.ПрочиеОплатыДокументОплаты.ПолучитьОбъект();
	Если ПрочиеОплатыОбъект = Неопределено Тогда Продолжить; КонецЕсли;
	
	ОтборСтроки = Новый Структура("ДокументДолг, ДокументЗакрытия", Строка.ПрочиеОплатыДокументДолг, Объект.Ссылка);	
	НайденныеСтроки = ПрочиеОплатыОбъект.ДолгиЗакрыто.НайтиСтроки(ОтборСтроки);
	
	Если НайденныеСтроки.Количество() = 0 Тогда 
		СтрокаЗакрытия = ПрочиеОплатыОбъект.ДолгиЗакрыто.Добавить();
		СтрокаЗакрытия.ДокументДолг = Строка.ПрочиеОплатыДокументДолг; 
		СтрокаЗакрытия.ДокументЗакрытия = Объект.Ссылка; 
	Иначе
		СтрокаЗакрытия = НайденныеСтроки[0];
	КонецЕсли;
	
	СуммаЗакрыто = СтрокаЗакрытия.СуммаЗакрыто + Строка.Сумма;
	
	//ОтборСтроки = Новый Структура("ДокументДолг", Строка.ПрочиеОплатыДокументДолг);	
	//ТЗ = ПрочиеОплатыОбъект.ДолгиОплата.Выгрузить(ОтборСтроки);
	//ТЗ.Свернуть("ДокументДолг", "Сумма");
	//СуммаДолг = ТЗ[0].Сумма;
	//
	//Если СуммаЗакрыто > СуммаДолг Тогда
	//	 СтрокаЗакрытия.СуммаЗакрыто = СуммаДолг;
	//Иначе
	//	СтрокаЗакрытия.СуммаЗакрыто = СуммаЗакрыто; 
	//КонецЕсли;	
	
	СтрокаЗакрытия.СуммаЗакрыто = СуммаЗакрыто; 
		
	Если СуммаЗакрыто <= 0 Тогда 
		Если НайденныеСтроки.Количество() = 0 Тогда 
			Продолжить;
		Иначе
			ПрочиеОплатыОбъект.ДолгиЗакрыто.Удалить(СтрокаЗакрытия);
	    КонецЕсли;
	КонецЕсли;
		
	ПрочиеОплатыОбъект.Записать(РежимЗаписиДокумента.Проведение);
КонецЦикла;	

ПрошлыйПериодДопУслуги.Очистить();
КонецПроцедуры
