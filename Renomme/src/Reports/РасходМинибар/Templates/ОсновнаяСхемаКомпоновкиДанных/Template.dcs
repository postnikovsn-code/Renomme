<?xml version="1.0" encoding="UTF-8"?>
<DataCompositionSchema xmlns="http://v8.1c.ru/8.1/data-composition-system/schema" xmlns:dcscom="http://v8.1c.ru/8.1/data-composition-system/common" xmlns:dcscor="http://v8.1c.ru/8.1/data-composition-system/core" xmlns:dcsset="http://v8.1c.ru/8.1/data-composition-system/settings" xmlns:v8="http://v8.1c.ru/8.1/data/core" xmlns:v8ui="http://v8.1c.ru/8.1/data/ui" xmlns:xs="http://www.w3.org/2001/XMLSchema" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
	<dataSource>
		<name>ИсточникДанных1</name>
		<dataSourceType>Local</dataSourceType>
	</dataSource>
	<dataSet xsi:type="DataSetQuery">
		<name>НаборДанных1</name>
		<field xsi:type="DataSetFieldField">
			<dataPath>НоменклатураМинибараНаименованиеВыгрузка</dataPath>
			<field>НоменклатураМинибараНаименованиеВыгрузка</field>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>НомерВРезерв</dataPath>
			<field>НомерВРезерв</field>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>НоменклатураМинибара</dataPath>
			<field>НоменклатураМинибара</field>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>Количество</dataPath>
			<field>Количество</field>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>Цена</dataPath>
			<field>Цена</field>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>ЗаявкаНаБронирование</dataPath>
			<field>ЗаявкаНаБронирование</field>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>Сумма</dataPath>
			<field>Сумма</field>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>ДатаОбслуживания</dataPath>
			<field>ДатаОбслуживания</field>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>НомерОбслуживания_пп</dataPath>
			<field>НомерОбслуживания_пп</field>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>Наименование</dataPath>
			<field>Наименование</field>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>ОбслуживаниеНомера</dataPath>
			<field>ОбслуживаниеНомера</field>
			<title xsi:type="v8:LocalStringType">
				<v8:item>
					<v8:lang>ru</v8:lang>
					<v8:content>Обслуживание номера</v8:content>
				</v8:item>
			</title>
		</field>
		<dataSource>ИсточникДанных1</dataSource>
		<query>ВЫБРАТЬ
	ГорничныеОбслуживаниеНомераМинибар.Ссылка КАК ОбслуживаниеНомера,
	ГорничныеОбслуживаниеНомераМинибар.НоменклатураМинибара КАК НоменклатураМинибара,
	ГорничныеОбслуживаниеНомераМинибар.НоменклатураМинибараНаименованиеВыгрузка КАК НоменклатураМинибараНаименованиеВыгрузка,
	ГорничныеОбслуживаниеНомераМинибар.Количество КАК Количество,
	ГорничныеОбслуживаниеНомераМинибар.Цена КАК Цена,
	ГорничныеОбслуживаниеНомераМинибар.Ссылка.ЗаявкаНаБронирование КАК ЗаявкаНаБронирование,
	ГорничныеОбслуживаниеНомераМинибар.Ссылка.НомерВРезерв КАК НомерВРезерв,
	ГорничныеОбслуживаниеНомераМинибар.Количество * ГорничныеОбслуживаниеНомераМинибар.Цена КАК Сумма,
	ГорничныеОбслуживаниеНомераМинибар.Ссылка.ДатаОбслуживания КАК ДатаОбслуживания,
	ГорничныеОбслуживаниеНомераМинибар.Ссылка.НомерОбслуживания_пп КАК НомерОбслуживания_пп,
	ВЫБОР
		КОГДА ГорничныеОбслуживаниеНомераМинибар.НоменклатураМинибара = ЗНАЧЕНИЕ(Справочник.НоменклатураМинибара.ПустаяСсылка)
			ТОГДА "*" + ГорничныеОбслуживаниеНомераМинибар.НоменклатураМинибараНаименованиеВыгрузка
		ИНАЧЕ ГорничныеОбслуживаниеНомераМинибар.НоменклатураМинибара.Наименование
	КОНЕЦ КАК Наименование
ИЗ
	Документ.ГорничныеОбслуживаниеНомера.Минибар КАК ГорничныеОбслуживаниеНомераМинибар
ГДЕ
	ГорничныеОбслуживаниеНомераМинибар.Ссылка.ПометкаУдаления = ЛОЖЬ
	И ГорничныеОбслуживаниеНомераМинибар.Ссылка.ДатаОбслуживания &gt;= &amp;ДатаС
	И ГорничныеОбслуживаниеНомераМинибар.Ссылка.ДатаОбслуживания &lt;= &amp;ДатаПо</query>
	</dataSet>
	<totalField>
		<dataPath>Количество</dataPath>
		<expression>Сумма(Количество)</expression>
		<group>Наименование</group>
	</totalField>
	<totalField>
		<dataPath>Сумма</dataPath>
		<expression>Сумма(Сумма)</expression>
	</totalField>
