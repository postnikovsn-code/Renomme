&НаСервере
Функция ОтчетЗарплатаНаСервере()
ТабДок = Новый ТабличныйДокумент;

Макет = Документы.АдминистраторыЗарплата.ПолучитьМакет("Макет");	

//Область = Макет.ПолучитьОбласть("Заголовок");
//ТабДок.Вывести(Область);

Область = Макет.ПолучитьОбласть("Шапка");
ТабДок.Вывести(Область);

Для Каждого Строка Из ЗарплатаСмены Цикл
	Область = Макет.ПолучитьОбласть("Строка");
	
	Область.Параметры.Администратор = Строка.Администратор;
	
	Область.Параметры.КоличествоСмен = Строка.КоличествоСмен;
	Область.Параметры.Оклад = Строка.Оклад_Э;
	Область.Параметры.Переработка = Строка.СуммаПереработка_Э;
	Область.Параметры.Отпуск = Строка.Отпуск_Э;
	Область.Параметры.НадбавкаЗаСтаж = Строка.НадбавкаЗаСтаж_Э;
	Область.Параметры.НадбавкаЗаСтандарты = Строка.НадбавкаЗаСтандарты_Э;
	Область.Параметры.НадбавкаЗаИнЯзыки = Строка.НадбавкаЗаИнЯзыки_Э;
	
	Область.Параметры.ДопУслуги = Строка.ДопУслуги;
	Область.Параметры.Больничный = Строка.Больничный;
	Область.Параметры.Премия = Строка.Премия;
	
	Область.Параметры.СуммаЗаПроживающих = Строка.СуммаЗаПроживающих_Э;
	
	Область.Параметры.СуммаЗаселенийЛайв = Строка.СуммаЗаселенийЛайв_Э;
	Область.Параметры.СуммаЗаселенийДомСоветов = Строка.СуммаЗаселенийДомСоветов_Э;
	Область.Параметры.СуммаЗаселенийСтритАрт = Строка.СуммаЗаселенийСтритАрт_Э;
	
	Область.Параметры.СуммаЗавтракиЧехов = Строка.СуммаЗавтракиЧехов_Э;
	Область.Параметры.СуммаЗавтракиДомСоветов = Строка.СуммаЗавтракиДомСоветов_Э;
	Область.Параметры.СуммаЗавтракиЛайв = Строка.СуммаЗавтракиЛайв_Э;
	
	Область.Параметры.СуммаПрочее = Строка.СуммаПрочее;
	
	Область.Параметры.ЗарплатаИтого = Строка.Итого;
	
	Область.Параметры.АвансНал = Строка.АвансНал;
	Область.Параметры.АвансКарта = Строка.АвансКарта;
	
	Область.Параметры.ОтпускныеКарта = Строка.ОтпускныеКарта;
	Область.Параметры.ЗПКарта = Строка.ЗПКарта;
	Область.Параметры.ИныеВыплатыНал = Строка.ИныеВыплатыНал;
	Область.Параметры.ИныеВыплатыКарта = Строка.ИныеВыплатыКарта;
	
	Область.Параметры.КВыплате = Строка.КВыплате;
	
	Область.Параметры.СуммаМинимум = Строка.СуммаМинимум;
	
	ТабДок.Вывести(Область);
КонецЦикла;

Если ОтельИмя = "Реноме" Тогда 
	ТабДок.УдалитьОбласть(ТабДок.Область(,14, ,18), ТипСмещенияТабличногоДокумента.ПоГоризонтали);
ИначеЕсли ОтельИмя = "Чехов" Тогда 
	ТабДок.УдалитьОбласть(ТабДок.Область(,13, ,13), ТипСмещенияТабличногоДокумента.ПоГоризонтали);
	ТабДок.УдалитьОбласть(ТабДок.Область(,18, ,18), ТипСмещенияТабличногоДокумента.ПоГоризонтали);
ИначеЕсли ОтельИмя = "Лайв" Тогда 
	ТабДок.УдалитьОбласть(ТабДок.Область(,13, ,17), ТипСмещенияТабличногоДокумента.ПоГоризонтали);
КонецЕсли;

	//ОтельИмя = "Чехов";
	//ОтельИмя = "Лайв";
	
Возврат ТабДок;
