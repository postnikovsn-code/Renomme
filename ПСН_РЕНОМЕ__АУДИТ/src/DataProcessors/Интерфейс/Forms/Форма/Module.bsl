Если ТЗКлиентов.Найти(НовЦвет,"Цвет")<>Неопределено тогда   
	//Случай=Новый ГенераторСлучайныхЧисел();
	Случай=Новый ГенераторСлучайныхЧисел(Случай.СлучайноеЧисло(0, 100));
	СлучайР=Новый ГенераторСлучайныхЧисел(100+Случай.СлучайноеЧисло(0,1000));
	СлучайГ=Новый ГенераторСлучайныхЧисел(200+Случай.СлучайноеЧисло(0,1000));
	СлучайБ=Новый ГенераторСлучайныхЧисел(300+Случай.СлучайноеЧисло(0,1000));
	НовЦвет=Новый Цвет(СлучайР.СлучайноеЧисло(10,200),СлучайГ.СлучайноеЧисло(10,200),СлучайБ.СлучайноеЧисло(10,200));
КонецЕсли;

Возврат НовЦвет;
