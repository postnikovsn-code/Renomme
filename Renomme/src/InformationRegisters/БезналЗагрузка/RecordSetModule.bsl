ИначеЕсли НастройкиСервер.ЭтоЧехов() Тогда
	Если Данные.СуммаЛайв > 0 Тогда
		Узел = ПланыОбмена.ОбменГостиницы.НайтиПоКоду("ЛАЙВ");	
		ПланыОбмена.ЗарегистрироватьИзменения(Узел, ЭтотОбъект);
	КонецЕсли;
	
