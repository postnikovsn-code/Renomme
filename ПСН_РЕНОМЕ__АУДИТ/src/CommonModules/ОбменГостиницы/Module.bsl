Функция ЗаписатьСообщениеСИзменениями(УзелИсточник, УзелПриемник) Экспорт
Результат = Новый Структура("Ошибка, КодОшибки, ОписаниеОшибки", Ложь, 0, "");	
	
Сообщение = Новый СообщениеПользователю;
Сообщение.Текст = "-------- Выгрузка в узел " + Строка(УзелПриемник) + " ------------";
Сообщение.Сообщить();

// + ПСН 
// Получить имя файла обмена.
//ИмяФайла = ОбменГостиницы.ПолучитьИмяФайлаОбмена(ПланыОбмена.Выписка.ЭтотУзел(), Ссылка);
ИмяФайла = ПолучитьИмяВременногоФайла("xml"); 
// - ПСН 

// Создать объект записи XML.
// *** ЗаписьXML-документов.
ЗаписьXML = Новый ЗаписьXML;
ЗаписьXML.ОткрытьФайл(ИмяФайла);
ЗаписьXML.ЗаписатьОбъявлениеXML();

// *** Инфраструктура сообщений.
ЗаписьСообщения = ПланыОбмена.СоздатьЗаписьСообщения();
ЗаписьСообщения.НачатьЗапись(ЗаписьXML, УзелПриемник.Ссылка);

// Записать соответствие пространств имен для сокращения размера файла сообщения
ЗаписьXML.ЗаписатьСоответствиеПространстваИмен("xsd", "http://www.w3.org/2001/XMLSchema");
ЗаписьXML.ЗаписатьСоответствиеПространстваИмен("xsi", "http://www.w3.org/2001/XMLSchema-instance");
ЗаписьXML.ЗаписатьСоответствиеПространстваИмен("v8", "http://v8.1c.ru/data");

Сообщение = Новый СообщениеПользователю;
Сообщение.Текст = " Номер сообщения: " + ЗаписьСообщения.НомерСообщения;
Сообщение.Сообщить();

ВыборкаИзменений = ПланыОбмена.ВыбратьИзменения(ЗаписьСообщения.Получатель, ЗаписьСообщения.НомерСообщения);
Пока ВыборкаИзменений.Следующий() Цикл
	Данные = ВыборкаИзменений.Получить();
	
	//Если НЕ (ТипЗнч(Данные) = Тип("УдалениеОбъекта")) Тогда  
	//	Если ВГ_ОбменВыписка.ПроверитьДанные(Данные, ДанныеУзлаОбмена) Тогда Продолжить; КонецЕсли;
	//КонецЕсли;		
	
	// Проверить, нужен ли перенос данных. Если нет, то записать удаление этих данных.
	//Если Не ВГ_ОбменВыписка.НуженПереносДанных(ЗаписьСообщения.Получатель, Данные) Тогда
	//	ВГ_ОбменВыписка.УдалениеДанных(Данные);
	//КонецЕсли;  
	
	// Записать данные в сообщение *** XML-сериализация.
	ОбменГостиницы.ЗаписатьДанныеXML(ЗаписьXML, Данные);	 
КонецЦикла;

ЗаписьСообщения.ЗакончитьЗапись();
ЗаписьXML.Закрыть();

// Получить имя файла обмена.
ДанныеУзлаОбмена = ФТПСервер.ПолучитьДанныеУзлаОбмена(УзелПриемник.Ссылка.Код);

ИмяФайлаФТП = ФТПСервер.ПолучитьИмяФайлаОбменаФТП(УзелИсточник, УзелПриемник, ДанныеУзлаОбмена.КаталогОбменаFTP);

Ответ = ФТПСервер.ЗаписатьФТПФайл(ИмяФайла, ИмяФайлаФТП
	, ДанныеУзлаОбмена.АдресФТП, ДанныеУзлаОбмена.ИмяПользователя, ДанныеУзлаОбмена.Пароль); 
//Результат = ОбщийМодульФТП.ЗаписатьФТПФайл_TECT(ИмяФайла, "C:\_Base1C\Обмен.xml"); 

Если Ответ.Ошибка Тогда 
	Сообщить("Ошибка записи файла обмена по FTP. " + Ответ.ОписаниеОшибки + 
	". ОБРАТИТЕСЬ К АДМИНИСТРАТОРУ ПРОГРАММЫ.");
	
	Результат = Ответ;	
КонецЕсли;

 ~ВЫХОД:
УдалитьФайлы(ИмяФайла);
// - ПСН 

Сообщение = Новый СообщениеПользователю;
Сообщение.Текст = "-------- Конец выгрузки ------------";
Сообщение.Сообщить();

Возврат Результат;
КонецФункции

Функция ПрочитатьСообщениеСИзменениями(УзелИсточник, УзелПриемник) Экспорт
Результат = Новый Структура("Ошибка, КодОшибки, ОписаниеОшибки, Удалено, Добавлено, Заменено", Ложь, 0, "", 0, 0, 0);	

ИмяФайла = ПолучитьИмяВременногоФайла("xml");

ДанныеУзлаОбмена = ФТПСервер.ПолучитьДанныеУзлаОбмена(УзелИсточник.Ссылка.Код);

ИмяФайлаФТП = ФТПСервер.ПолучитьИмяФайлаОбменаФТП(УзелИсточник, УзелПриемник, ДанныеУзлаОбмена.КаталогОбменаFTP);

Сообщение = Новый СообщениеПользователю;
Сообщение.Текст = "-------- Загрузка из " + Строка(УзелИсточник) + " ------------";
Сообщение.Сообщить();
Сообщение.Текст = " – Считывается файл " + ИмяФайлаФТП;
Сообщение.Сообщить();

Ответ = ФТПСервер.ПолучитьФТПФайл(ИмяФайлаФТП, ИмяФайла, ДанныеУзлаОбмена.АдресФТП, ДанныеУзлаОбмена.ИмяПользователя, ДанныеУзлаОбмена.Пароль); 
//Результат = ОбщийМодульФТП.ПолучитьФТПФайл_TECT("C:\_Base1C\Обмен 1.xml", ИмяФайла); 

//Если Результат.КодОшибки < 0 Тогда 
//	Сообщить("Ошибка записи файла обмена по FTP: " + Результат.ОписаниеОшибки + 
//	". ОБРАТИТЕСЬ К АДМИНИСТРАТОРУ ПРОГРАММЫ.");
//ИначеЕсли Результат.КодОшибки > 0 Тогда 
//	Возврат Неопределено;
//КонецЕсли;

Если Ответ.Ошибка Тогда
	Если Ответ.КодОшибки = 1 Тогда 
		 Сообщить(Ответ.ОписаниеОшибки); // Отсутсвует файд обмена
	Иначе	
		Сообщить("Ошибка записи файла обмена по FTP: " + Ответ.ОписаниеОшибки + 
		". ОБРАТИТЕСЬ К АДМИНИСТРАТОРУ ПРОГРАММЫ.");
	КонецЕсли;
	
	Результат.Ошибка = Истина;
	Результат.КодОшибки  = Ответ.КодОшибки;
	Результат.ОписаниеОшибки  = Ответ.ОписаниеОшибки;
	
	Возврат Результат;	
КонецЕсли;

Файл = Новый Файл(ИмяФайла);

Если Не Файл.Существует() Тогда Возврат Неопределено; КонецЕсли;

// Попытаться открыть файл.
// *** Чтение документов XML.
ЧтениеXML = Новый ЧтениеXML;
Попытка
	ЧтениеXML.ОткрытьФайл(ИмяФайла);
Исключение
	Сообщение = Новый СообщениеПользователю;
	Сообщение.Текст = "Невозможно открыть файл обмена данными.";
	Сообщение.Сообщить();
	
	Результат.Ошибка = Истина;
	Результат.КодОшибки = -10;
	Результат.ОписаниеОшибки = "Невозможно открыть файл обмена данными. " + ОписаниеОшибки();

	Возврат Результат;
КонецПопытки;

// Загрузить данные из найденного файла.
// *** Инфраструктура сообщений.
ЧтениеСообщения = ПланыОбмена.СоздатьЧтениеСообщения();

// Прочитать заголовок сообщения обмена данными – файла XML.
Попытка
	ЧтениеСообщения.НачатьЧтение(ЧтениеXML);
Исключение
	Сообщение = Новый СообщениеПользователю;
	Сообщение.Текст = "Номер сообщения меньше или равен номеру ранее принятого сообщения";
	Сообщение.Сообщить();
	
	Результат.Ошибка = Истина;
	Результат.КодОшибки = -20;
	Результат.ОписаниеОшибки = "Номер сообщения меньше или равен номеру ранее принятого сообщения. " + ОписаниеОшибки();

	Возврат Результат
КонецПопытки;

// Проверить, что сообщение предназначено для этого узла.
Если ЧтениеСообщения.Отправитель <> УзелИсточник.Ссылка Тогда
	//ВызватьИсключение "Неверный узел";
	
	Результат.Ошибка = Истина;
	Результат.КодОшибки = -20;
	Результат.ОписаниеОшибки = "Неверный узел.";
	
	Возврат Результат;
КонецЕсли;

// Удалить регистрацию изменений для узла-отправителя сообщения.
// *** Служба регистрации изменений.
ПланыОбмена.УдалитьРегистрациюИзменений(ЧтениеСообщения.Отправитель, ЧтениеСообщения.НомерПринятого);

// Прочитать данные из сообщения в цикле. *** XML-сериализация.
ПолучательПлатежаПриемник = ПолучательПлатежаПриемник(УзелПриемник.Код);

УдаленоКоличество = 0;
ЗамененоКоличество = 0;
ДобавленоКоличество = 0;
Пока ОбменГостиницы.ВозможностьЧтенияДанныхXML(ЧтениеXML) Цикл
	// Прочитать очередное значение.
	Данные = ОбменГостиницы.ПрочитатьДанныеXML(ЧтениеXML);

	//// Проверить, нужно ли принимать сообщение от узла-отправителя. Если нет, отклонить изменения.
	//Если Не ОбменВыписка.ПринятьИзменения(ЧтениеСообщения.Отправитель, Данные) Тогда
	//	Сообщение = Новый СообщениеПользователю;
	//	Сообщение.Текст = Строка(Данные.Метаданные()) + ": " + Строка(Данные) + " – Изменения отклонены";

	//	Сообщение.Сообщить();
	//	Продолжить;
	//КонецЕсли;

	// Записать полученные данные.
	Ответ = ОбменГостиницы.ЗаписатьПолученныеДанные(Данные, ПолучательПлатежаПриемник);	 
	
	Если Ответ = -1 Тогда
		УдаленоКоличество = УдаленоКоличество + 1; 		
	ИначеЕсли Ответ = 0 Тогда
		ДобавленоКоличество = ДобавленоКоличество + 1; 		
	ИначеЕсли Ответ = 1 Тогда
		ЗамененоКоличество = ЗамененоКоличество + 1; 		
	КонецЕсли;	
	// - ПСН
КонецЦикла;

ЧтениеСообщения.ЗакончитьЧтение();
ЧтениеXML.Закрыть();

УдалитьФайлы(ИмяФайла);

Ответ = ФТПСервер.УдалитьФТПФайл(ИмяФайлаФТП, ДанныеУзлаОбмена.АдресФТП, ДанныеУзлаОбмена.ИмяПользователя, ДанныеУзлаОбмена.Пароль);
Если Ответ.Ошибка Тогда
	Сообщить("Ошибка удаления файла FTP. " + Ответ.ОписаниеОшибки);
	
	Результат.Ошибка = Истина;
	Результат.КодОшибки = Ответ.КодОшибки;  // Код 30
	Результат.ОписаниеОшибки = Ответ.ОписаниеОшибки;
КонецЕсли;

Сообщение = Новый СообщениеПользователю;
Сообщение.Текст = "-------- Конец загрузки ------------";
Сообщение.Сообщить();

//Результат = Новый Структура("Удалено, Добавлено, Заменено"
//	, УдаленоКоличество, ДобавленоКоличество, ЗамененоКоличество);

Результат.Удалено = УдаленоКоличество; 
Результат.Добавлено = ДобавленоКоличество; 
Результат.Заменено = ЗамененоКоличество; 

Возврат Результат;
КонецФункции

Функция ПолучательПлатежаПриемник(УзелПриемникКод)
Запрос = Новый Запрос("ВЫБРАТЬ
                      |	ГостиницыНастройкиОбмена.ПолучательПлатежа КАК ПолучательПлатежа
                      |ИЗ
                      |	РегистрСведений.ГостиницыНастройкиОбмена КАК ГостиницыНастройкиОбмена
                      |ГДЕ
                      |	ГостиницыНастройкиОбмена.КодУзлаОбмена = &КодУзлаОбмена");

Запрос.УстановитьПараметр("КодУзлаОбмена", УзелПриемникКод);
Выборка = Запрос.Выполнить().Выбрать();

Выборка.Следующий();
Возврат Выборка.ПолучательПлатежа;
КонецФункции
