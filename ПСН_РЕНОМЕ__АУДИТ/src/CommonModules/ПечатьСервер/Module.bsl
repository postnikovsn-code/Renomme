Для каждого Пок Из Клиент.ПрочаяИнформация Цикл
	Если Пок.Информация="" тогда
		Продолжить;
	КонецЕсли;
	
	Обл.Параметры.Показатель=Пок.ВидИнформации.Наименование;
	Обл.Параметры.Значение=Пок.Информация;
	ТабДок.Вывести(Обл);	
