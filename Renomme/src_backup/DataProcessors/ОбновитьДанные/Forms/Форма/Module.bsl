&НаСервере
Процедура УстановитьДатаУслугиНаСервере()
Запрос = Новый Запрос("ВЫБРАТЬ
                      |	ЗаявкаНаБронирование.Ссылка КАК Ссылка
                      |ИЗ
                      |	Документ.ЗаявкаНаБронирование КАК ЗаявкаНаБронирование
                      |ГДЕ
                      |	ЗаявкаНаБронирование.ПометкаУдаления = ЛОЖЬ
                      |	И ЗаявкаНаБронирование.Статус <> ЗНАЧЕНИЕ(Перечисление.СтатусБрони.ОтменаБронирования)
                      |	И ЗаявкаНаБронирование.Статус <> ЗНАЧЕНИЕ(Перечисление.СтатусБрони.ОтказОтБронирования)");

ТЗ = Запрос.Выполнить().Выгрузить();

Для Каждого Строка Из ТЗ Цикл
	ЗаявкаОбъект = Строка.Ссылка.ПолучитьОбъект();
	
	Если ЗаявкаОбъект.ДопУслуги.Количество() = 0 Тогда Продолжить; КонецЕсли;
	
	ПровестиЗаявку = Ложь;
	Для Каждого СтрокаУслуги Из ЗаявкаОбъект.ДопУслуги Цикл
		Если ЗначениеЗаполнено(СтрокаУслуги.ДатаУслуги) Тогда
			Если СтрокаУслуги.ДатаУслуги >= ЗаявкаОбъект.РезервС И СтрокаУслуги.ДатаУслуги < ЗаявкаОбъект.РезервС
			Тогда Продолжить; КонецЕсли;
			
			Если СтрокаУслуги.ДатаУслуги >= ЗаявкаОбъект.РезервПо Тогда
				Если ЗаявкаОбъект.РезервС = ЗаявкаОбъект.РезервПо Тогда
					Если СтрокаУслуги.ДатаУслуги = ЗаявкаОбъект.РезервС Тогда Продолжить; КонецЕсли;
					
					СтрокаУслуги.ДатаУслуги = ЗаявкаОбъект.РезервС;
				Иначе
					СтрокаУслуги.ДатаУслуги = ЗаявкаОбъект.РезервПо - 24*60*60;
				КонецЕсли;
				
				ПровестиЗаявку = Истина;
				
				Сообщить("ДатаУслуги >= РезервПо. Заявка: " + ЗаявкаОбъект.Ссылка);
				
			ИначеЕсли СтрокаУслуги.ДатаУслуги < ЗаявкаОбъект.РезервС Тогда
				СтрокаУслуги.ДатаУслуги = ЗаявкаОбъект.РезервС;
				
				ПровестиЗаявку = Истина;
				Сообщить("ДатаУслуги < РезервС. Заявка: " + ЗаявкаОбъект.Ссылка);
			КонецЕсли;				
		Иначе	
			СтрокаУслуги.ДатаУслуги = ЗаявкаОбъект.РезервС;
			
			ПровестиЗаявку = Истина;

			Сообщить("ДатаУслуги пусто. Заявка: " + ЗаявкаОбъект.Ссылка);
		КонецЕсли;
	КонецЦикла;
	
	Если ПровестиЗаявку Тогда
		Попытка
			ЗаявкаОбъект.Записать(РежимЗаписиДокумента.Проведение);
		Исключение
			Сообщить("Ошибка записи заявки: " + ЗаявкаОбъект.Ссылка + ". Описание ошибки: " + ОписаниеОшибки());
		КонецПопытки;
		
	КонецЕсли;
КонецЦикла;
	
	
КонецПроцедуры
