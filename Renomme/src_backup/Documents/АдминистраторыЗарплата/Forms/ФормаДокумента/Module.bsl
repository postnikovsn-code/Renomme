	Реквизиты.Добавить(НовыйРеквизит);
	
	Имя = "СуммаЗаселенийЛайв_" + Дата_И;
	НовыйРеквизит = Новый РеквизитФормы(Имя, Новый ОписаниеТипов("Число")
