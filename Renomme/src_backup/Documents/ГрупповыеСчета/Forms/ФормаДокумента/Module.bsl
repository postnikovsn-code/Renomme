ДатаСчета = ГрупповойСчетОбъект.ДатаСчета;

СчетГУИД = ГрупповойСчетОбъект.СчетГУИД;
//

сч = 0;
СуммаДляПечатиОбщая = 0;
Для Каждого СтрокаТаблицы Из Заявки Цикл
	ДокументДолг = СтрокаТаблицы.ДокументДолг;
	СчетГУИД = СтрокаТаблицы.СчетГУИД;
	
	ОтборСтроки = Новый Структура("СчетГУИД", СчетГУИД); 
	НайденныеСтроки = ДокументДолг.Счета.НайтиСтроки(ОтборСтроки); 
	Если НайденныеСтроки.Количество() = 0 Тогда Продолжить; КонецЕсли; 
	Счет = НайденныеСтроки[0]; 
	
	СчетаДетальноДолги_М = ДокументДолг.СчетаДетальноДолги.НайтиСтроки(ОтборСтроки); 
	
	Если ДокументДолг.Оплачивает.Турагентство Тогда
		Клиент = ДокументДолг.Клиент;	
		Клиент2 = ДокументДолг.Клиент2;
	Иначе
		Если Счет.РазделитьСчет Тогда
			Клиент = Счет.Клиент;	
			Клиент2 = Неопределено;
		Иначе
			Клиент = Счет.Клиент;	
			Клиент2 = ДокументДолг.Клиент2;
		КонецЕсли;
	КонецЕсли;

	ТоварКлиент = "" + Клиент;
	Если ЗначениеЗаполнено(Клиент2) Тогда 
		Если Клиент <> Клиент2 Тогда 
			ТоварКлиент = ТоварКлиент + ", " + Клиент2;
		КонецЕсли;
	КонецЕсли;
	ТоварКлиент = ТоварКлиент + ". ";
	
	Если НЕ ТолькоУслуги Тогда 
		Для каждого Строка Из СчетаДетальноДолги_М Цикл
			Если Строка.Услуга Тогда Продолжить; КонецЕсли;
		
			СтрокаСчетаДетальноДолги = ОбщийФункционалСервер.СтруктураИзТабличнаяЧастьДокумента(
							"ЗаявкаНаБронирование", "СчетаДетальноДолги");;
			ЗаполнитьЗначенияСвойств(СтрокаСчетаДетальноДолги, Строка);
			
			СтрокаСчетаДетальноДолги.НаименованиеДолг = ТоварКлиент + " " 
				+ СтрокаСчетаДетальноДолги.НаименованиеДолг;
			
			МассивСчетаДетальноДолги.Добавить(СтрокаСчетаДетальноДолги);
		КонецЦикла;
	КонецЕсли;
	
	Если НЕ ТолькоПроживание Тогда 
		Для каждого Строка Из СчетаДетальноДолги_М Цикл
			Если НЕ Строка.Услуга Тогда Продолжить; КонецЕсли;
			
			СтрокаСчетаДетальноДолги = ОбщийФункционалСервер.СтруктураИзТабличнаяЧастьДокумента(
							"ЗаявкаНаБронирование", "СчетаДетальноДолги");;
			ЗаполнитьЗначенияСвойств(СтрокаСчетаДетальноДолги, Строка);
			
			НаименованиеТовара = ?(ЗначениеЗаполнено(Строка.НазваниеДляЧека)
				, Строка.НазваниеДляЧека, Строка.НаименованиеДолг);
			СтрокаСчетаДетальноДолги.НаименованиеДолг = ТоварКлиент + " " + НаименованиеТовара;
				
			МассивСчетаДетальноДолги.Добавить(СтрокаСчетаДетальноДолги);
		КонецЦикла; 
	КонецЕсли;
КонецЦикла;	

Возврат  МассивСчетаДетальноДолги;
КонецФункции

