	ЗаполнитьПроживающие();
	ПроживающиеЗагружены = Истина;
КонецЕсли;
	
ТекстОшибки = "";
ТекстСообщения = "Идет загрука заселений. 
	|
	|ПОДОЖДИТЕ ...";	
ПараметрыФормы = Новый Структура("ТекстСообщения", ТекстСообщения);

Если ОтельИмя = "Реноме" Тогда	
