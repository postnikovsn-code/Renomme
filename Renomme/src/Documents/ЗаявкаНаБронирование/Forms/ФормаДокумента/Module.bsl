Процедура ЧекАгента(Команда)
ПараметрыФормы = Новый Структура;
ПараметрыФормы.Вставить("СуммаКОплате", Объект.ЦенаПродажиАгентом);
ПараметрыФормы.Вставить("СуммаОплаты", 0);
ПараметрыФормы.Вставить("СуммаПредыдущихОплат", Объект.ЦенаПродажиАгентом);
ПараметрыФормы.Вставить("ЭтоАванс", Ложь);                     

//
ПозицииЧекаККМ = Новый Массив;

ТекущаяОрганизация = НастройкиСервер.ПолучитьТекущуюОрганизацию();
СтавкаНДС = ОбщийФункционалСервер.ЗначениеРеквизитаНаСервере(ТекущаяОрганизация, "СтавкаНДС");
ДатаУчетаНДС = Объект.РезервПо; 
СтавкаНДС = ДокументыСервер.СтавкаНДСТекущая(СтавкаНДС, ДатаУчетаНДС);  

ВсеСНДС = ОбщийФункционалСервер.ЗначениеРеквизитаНаСервере(ТекущаяОрганизация, "ВсеСНДС"); 

//ДатаУчета = ОбщийФункционалСервер.ЗначениеРеквизитаНаСервере(ДокументДолгОбъект.Ссылка, "РезервПо");
ДатаУчета = Объект.РезервПо;
УчитыватьНДС = ДокументыСервер.УчитыватьНДС_Чек(ДатаУчета);

ПозицииЧекаККМШаблон = ОбщийФункционалСервер.СтруктураИзТабличнаяЧастьДокумента("КассовыйДокумент", "ЧекККМДетально");

НоваяЗапись = ОбщийФункционалСервер.СкопироватьСтруктуру(ПозицииЧекаККМШаблон);   

Если Объект.РезервПо = Объект.РезервС Тогда
	КоличествоСуток = 1;	
Иначе
	КоличествоСуток = Цел((Объект.РезервПо - Объект.РезервС) / (24 * 60 * 60));
КонецЕсли;
НоваяЗапись.Наименование="Услуги гостиницы " + Формат(КоличествоСуток, "ЧГ=") + " сут.";

НоваяЗапись.Количество=1;  

СуммаПроживание = Объект.ЦенаПродажиАгентом;

НоваяЗапись.Цена = СуммаПроживание;
НоваяЗапись.Сумма = СуммаПроживание;

НоваяЗапись.Скидка=0;

Если УчитыватьНДС Тогда
	Если ВсеСНДС Тогда
		НоваяЗапись.СтавкаНДС = СтавкаНДС;
		НоваяЗапись.СуммаНДС = ДокументыСервер.СуммаНДС(СтавкаНДС, СуммаПроживание);
	Иначе
		Если СтавкаНДС = ПредопределенноеЗначение("Перечисление.СтавкиНДС.БезНДС")
		ИЛИ СтавкаНДС = ПредопределенноеЗначение("Перечисление.СтавкиНДС.ПустаяСсылка")
		Тогда
			СтавкаНДС_П = СтавкаНДС;
		Иначе
			СтавкаНДС_П = ПредопределенноеЗначение("Перечисление.СтавкиНДС.НДС0");
		КонецЕсли;
		
		НоваяЗапись.СтавкаНДС = СтавкаНДС_П;
		НоваяЗапись.СуммаНДС = 0;
	КонецЕсли;
КонецЕсли;

ПозицииЧекаККМ.Добавить(НоваяЗапись);
//
ПараметрыФормы.Вставить("ПозицииЧекаККМ", ПозицииЧекаККМ); 

ПараметрыФормы.Вставить("ДокументДолг", Объект.Ссылка); 

ПараметрыФормы.Вставить("ОплатаКартойВключена", Ложь);   

ДопПараметры = Новый Структура;

Оповещение = Новый ОписаниеОповещения("ЗакрытиеФормы_ЧекАгента", ЭтотОбъект, ДопПараметры);
ОткрытьФорму("ОбщаяФорма.Чек", ПараметрыФормы, ЭтаФорма
	,,,, Оповещение, РежимОткрытияОкнаФормы.БлокироватьВесьИнтерфейс);
КонецПроцедуры

