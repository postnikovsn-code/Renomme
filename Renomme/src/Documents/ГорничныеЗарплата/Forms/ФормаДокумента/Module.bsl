//
&НаСервере
Процедура ОбновитьСтрокаСуммы(ТД)

Если ТД.Оклад_Есть Тогда 
	ТД.Оклад_Э = ТД.Оклад_Р;
Иначе
	ТД.Оклад_Э = ТД.Оклад;
КонецЕсли;

Если ТД.Отпуск_Есть Тогда 
	ТД.Отпуск_Э = ТД.Отпуск_Р;
Иначе
	ТД.Отпуск_Э = ТД.Отпуск;
КонецЕсли;

Если ТД.НадбавкаЗаСтаж_Есть Тогда 
	ТД.НадбавкаЗаСтаж_Э = ТД.НадбавкаЗаСтаж_Р;
Иначе
	ТД.НадбавкаЗаСтаж_Э = ТД.НадбавкаЗаСтаж;
КонецЕсли;

Если ТД.НадбавкаЗаСтандарты_Есть Тогда 
	ТД.НадбавкаЗаСтандарты_Э = ТД.НадбавкаЗаСтандарты_Р;
Иначе
	ТД.НадбавкаЗаСтандарты_Э = ТД.НадбавкаЗаСтандарты;
КонецЕсли;

Если ТД.СуммаПрачечная_Есть Тогда 
	ТД.СуммаПрачечная_Э = ТД.СуммаПрачечная_Р;
Иначе
	ТД.СуммаПрачечная_Э = ТД.СуммаПрачечная;
КонецЕсли;

Если ТД.КоличествоСмен_Есть Тогда 
	ТД.КоличествоСмен_Э = ТД.КоличествоСмен_Р;
Иначе
	ТД.КоличествоСмен_Э = ТД.КоличествоСмен;
КонецЕсли;

Если ТД.Сдельно_Есть Тогда 
	ТД.Сдельно_Э = ТД.Сдельно_Р;
Иначе
	ТД.Сдельно_Э = ТД.Сдельно;
КонецЕсли;

Если ТД.Сдельно_нал_Есть Тогда 
	ТД.Сдельно_нал_Э = ТД.Сдельно_нал_Р;
Иначе
	ТД.Сдельно_нал_Э = ТД.Сдельно_нал;
КонецЕсли;

Если ТД.КоличествоЧасов_Есть Тогда 
	ТД.КоличествоЧасов_Э = ТД.КоличествоЧасов_Р;
Иначе
	ТД.КоличествоЧасов_Э = ТД.КоличествоЧасов;
КонецЕсли;

ТД.Г_Количество_Э = ТД.Г_Количество + ТД.Г_Количество_Р;
ТД.Г_Сумма = ТД.Г_Количество_Э * Объект.Г_Цена;

ТД.Т_Количество_Э = ТД.Т_Количество + ТД.Т_Количество_Р;
ТД.Т_Сумма = ТД.Т_Количество_Э * Объект.Т_Цена;

ТД.ТС_Количество_Э = ТД.ТС_Количество + ТД.ТС_Количество_Р;
ТД.ТС_Сумма = ТД.ТС_Количество_Э * Объект.ТС_Цена; 

ТД.РК_Количество_Э = ТД.РК_Количество + ТД.РК_Количество_Р;
ТД.РК_Сумма = ТД.РК_Количество_Э * Объект.РК_Цена; 

ТД.МК_Количество_Э = ТД.МК_Количество + ТД.МК_Количество_Р;
ТД.МК_Сумма = ТД.МК_Количество_Э * Объект.МК_Цена; 

ТД.МДМ_Количество_Э = ТД.МДМ_Количество + ТД.МДМ_Количество_Р;
ТД.МДМ_Сумма = ТД.МДМ_Количество_Э * Объект.МДМ_Цена; 
КонецПроцедуры

&НаСервере
Процедура ОбновитьСуммаУборки(ТД)
ТД.СуммаУборки = СуммаУборки(ТД);
КонецПроцедуры

&НаСервере
Процедура ОбновитьЗарплатаПомещения()
ПомещенияУборки.Очистить();

Для Каждого Строка Из ГорничныеСправочник Цикл
	НоваяСтрока = ПомещенияУборки.Добавить();
	НоваяСтрока.Горничная = Строка.Горничная;
КонецЦикла;

Для Каждого Строка Из ПомещенияУборки Цикл
	ОтборСтроки = Новый Структура("Горничная", Строка.Горничная);
	СтрокиЗарплатаПомещения = Объект.ЗарплатаПомещения.НайтиСтроки(ОтборСтроки);
	
	СуммаИтого = 0;
	Для Каждого СтрокаЗарплатаПомещения Из СтрокиЗарплатаПомещения Цикл
		Количество = СтрокаЗарплатаПомещения.Количество;
		Количество_Р = СтрокаЗарплатаПомещения.Количество_Р;
		Количество_Э = Количество + Количество_Р;
		
		ОтборСтроки = Новый Структура("Помещение", СтрокаЗарплатаПомещения.Помещение);
		НайденныеСтроки = ПомещенияСправочник.НайтиСтроки(ОтборСтроки);
		Если НайденныеСтроки.Количество() = 0 Тогда Продолжить; КонецЕсли; 
	
		СтрокаПомещенияСправочник = НайденныеСтроки[0];
		Номер = СтрокаПомещенияСправочник.Номер;
		
		Имя = "Количество_" + Строка(Номер);
		Строка[Имя] = Количество;                     
		Имя = "Количество_" + Строка(Номер) + "_Р";
		Строка[Имя] = Количество_Р;
		Имя = "Количество_" + Строка(Номер) + "_Э";
		Строка[Имя] = Количество_Э;
		
		Имя = "ПомещениеЦена_" + Строка(Номер);
		Цена =  ЭтаФорма[Имя];
		
		Имя = "Сумма_" + Строка(Номер);
		Строка[Имя] = Количество_Э * Цена;
		
		СуммаИтого = СуммаИтого + Строка[Имя];
	КонецЦикла;
	Строка.СуммаИтого = СуммаИтого;
КонецЦикла;
КонецПроцедуры

&НаСервере
Процедура ОбновитьСуммаПомещения(ТД)
ТД.СуммаПомещения = СуммаПомещения(ТД);
КонецПроцедуры

&НаСервере
Функция СуммаУборки(ТД)
СуммаУборки = ТД.Г_Сумма + ТД.Т_Сумма + ТД.ТС_Сумма + ТД.РК_Сумма + ТД.МК_Сумма + ТД.МДМ_Сумма; 	

Возврат СуммаУборки;
КонецФункции

&НаСервере
Функция СуммаПомещения(ТД)
СуммаПомещения = 0;	
	
ОтборСтроки = Новый Структура("Горничная", ТД.Горничная);
НайденныеСтроки = ПомещенияУборки.НайтиСтроки(ОтборСтроки);
Если НайденныеСтроки.Количество() > 0 Тогда
	СуммаПомещения = НайденныеСтроки[0].СуммаИтого;
КонецЕсли;

Возврат СуммаПомещения;
КонецФункции

&НаСервере
Процедура ОбновитьЗарплатаИтого(ТД)
ЗарплатаИтого = ТД.Оклад_Э + ТД.Отпуск_Э + ТД.НадбавкаЗаСтаж_Э + ТД.НадбавкаЗаСтандарты_Э 
	+ ТД.Больничный + ТД.Премия 
	+ ТД.Г_Сумма + ТД.Т_Сумма + ТД.ТС_Сумма + ТД.РК_Сумма + ТД.МК_Сумма + ТД.МДМ_Сумма
	+ ТД.ДопРаботы 
	+ ТД.Сдельно_Э
	+ ТД.КорректировкаДопНачислено
	;
	
ЗарплатаИтого = ЗарплатаИтого + ТД.СуммаПомещения;

ТД.Итого = ЗарплатаИтого;

ТД.ЗарплатаИтого = ЗарплатаИтого + ТД.СуммаПрачечная_Э;

Выдано = ТД.Аванс_кк + ТД.Аванс_нал +  ТД.Зарплата_кк 
	+  ТД.Отпуск_кк +  ТД.Отпуск_нал
	+  ТД.Сдельно_нал_Э +  ТД.ИныеВыплаты_нал; 
	
ТД.ОстатокКВыдаче = ТД.ЗарплатаИтого - Выдано;
КонецПроцедуры
