Функция ФункциональностьДоступностьОрганизация() Экспорт
Ответ = Новый Структура();	
ИмяОрганизации = ПолучитьИмяТекущаяОрганизация();

Если ИмяОрганизации = "Реноме" Тогда 
	Ответ.БонШанс = Истина;
ИначеЕсли ИмяОрганизации = "СтритАрт" Тогда 
	Ответ.БонШанс = Истина;
ИначеЕсли ИмяОрганизации = "Лайв" Тогда 
	Ответ.БонШанс = Истина;
ИначеЕсли ИмяОрганизации = "ДомСоветов" Тогда 
	Ответ.БонШанс = Ложь;
ИначеЕсли ИмяОрганизации = "Чехов" Тогда 
	Ответ.БонШанс = Истина;
КонецЕсли;
Возврат Ответ;
КонецФункции

