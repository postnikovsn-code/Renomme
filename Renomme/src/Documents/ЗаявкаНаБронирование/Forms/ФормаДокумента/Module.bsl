СписокВыбора.Добавить("6");
СписокВыбора.Добавить("7");
СписокВыбора.Добавить("8");
СписокВыбора.Добавить("9");
СписокВыбора.Добавить("10");
СписокВыбора.Добавить("11");
СписокВыбора.Добавить("12");
СписокВыбора.Добавить("13");
СписокВыбора.Добавить("14");
СписокВыбора.Добавить("15");
СписокВыбора.Добавить("15+");
КонецПроцедуры

&НаСервере
Процедура ДопМестоТипДопМестаСписокВыбораУстановить(СписокВыбора)
СписокВыбора.Очистить();

СписокВыбора.Добавить(0, "Нет");
СписокВыбора.Добавить(1, "Доп. кровать");
СписокВыбора.Добавить(2, "Дет. кровать");
КонецПроцедуры

&НаСервере
Процедура ГорничныеВремяЗаездаСписокВыбораУстановить(СписокВыбора)
СписокВыбора.Очистить();

Для Индекс = 0 По 23 Цикл
	СписокВыбора.Добавить(Индекс);
КонецЦикла;
КонецПроцедуры

