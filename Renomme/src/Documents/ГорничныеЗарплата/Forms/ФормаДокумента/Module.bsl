&НаКлиенте
Процедура ПомещенияУборкиЭлемент_ПриИзменении(Элемент)
ТС = Элемент.Родитель.ТекущаяСтрока;		
ТД = ПомещенияУборки.НайтиПоИдентификатору(ТС);

ИмяЭлемента = Элемент.Имя;
Индекс = СтрНайти(ИмяЭлемента, "_Э", НаправлениеПоиска.СКонца);
ИмяРеквизита = Сред(ИмяЭлемента, 1, Индекс - 1);

ТД[ИмяРеквизита + "_Р"] = ТД[ИмяРеквизита + "_Э"] - ТД[ИмяРеквизита];

Индекс = СтрНайти(ИмяРеквизита, "_");
НомерРеквизита = Сред(ИмяРеквизита, Индекс);

ИмяСумма = "Сумма" + НомерРеквизита;

ИмяЦена = "ПомещениеЦена" + НомерРеквизита; 
Цена =  ЭтаФорма[ИмяЦена];

ТД[ИмяСумма] = ТД[ИмяРеквизита + "_Э"] * Цена;
КонецПроцедуры

&НаКлиенте
Процедура ПомещенияУборкиЭлемент_Очистка(Элемент)
ТС = Элемент.Родитель.ТекущаяСтрока;		
ТД = ПомещенияУборки.НайтиПоИдентификатору(ТС);

ИмяЭлемента = Элемент.Имя;
Индекс = СтрНайти(ИмяЭлемента, "_Э", НаправлениеПоиска.СКонца);
ИмяРеквизита = Сред(ИмяЭлемента, 1, Индекс - 1);
	
Имя = ИмяРеквизита + "_Р";
ТД[Имя] = 0;

Имя = ИмяРеквизита + "_Э";
ТД[Имя] = ТД[ИмяРеквизита];

Индекс = СтрНайти(ИмяРеквизита, "_");
НомерРеквизита = Сред(ИмяРеквизита, Индекс);

ИмяСумма = "Сумма" + НомерРеквизита;

ИмяЦена = "ПомещениеЦена" + НомерРеквизита; 
Цена =  ЭтаФорма[ИмяЦена];

ТД[ИмяСумма] = ТД[ИмяРеквизита + "_Э"] * Цена;

Элементы.ПомещенияУборки.ЗакончитьРедактированиеСтроки(Ложь);
КонецПроцедуры
