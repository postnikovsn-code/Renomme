ТД = Элементы.ВыпискаОплаты.ТекущиеДанные;
Если ТД.ОстатокОплаты = 0 Тогда 
	ПоказатьПредупреждение(, "Остаток выписки = 0
		|
		|Для создания возврата удалите связь выписки и счета ...");
	
	Возврат; 
КонецЕсли;

ВыпискаОплатыДокументОплатыТекущий = ТД.ДокументОплаты;

ПараметрыФормы = Новый Структура();
ПараметрыФормы.Вставить("ЭтоВозврат", Истина);
ПараметрыФормы.Вставить("ОтКого", ТД.Контрагент);
