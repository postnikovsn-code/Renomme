

////// + Чек оплаты

//
Процедура ЧекОплаты(ДопПараметры, Форма) Экспорт
Счет = ДопПараметры.Счет;
ДопПараметры.Вставить("Форма", Форма); 

Если ДопПараметры.Свойство("ЭтоСчетКоворкинг") Тогда 
	Если ДопПараметры.ЭтоСчетКоворкинг Тогда
		ЧекОплатыДействие(ДопПараметры);		
		
		Возврат;
	КонецЕсли;
КонецЕсли;

Оповещение = Новый ОписаниеОповещения("ЗавершениеВопросаСвернутьВСчете", ЭтотОбъект, ДопПараметры);
ТекстВопроса = "Свернуть в счете: " + ?(Счет.СвернутьВСчете, "Установлен", "НЕ установлен")
	+ Символы.ПС + Символы.ПС + "ПРОДОЛЖИТЬ ..."; 
ПоказатьВопрос(Оповещение, ТекстВопроса, РежимДиалогаВопрос.ДаНет);  	
КонецПроцедуры

Процедура ЗавершениеВопросаСвернутьВСчете(Результат, ДополнительныеПараметры) Экспорт
Если Результат = КодВозвратаДиалога.Да Тогда
	ЧекОплатыДействие(ДополнительныеПараметры);		
КонецЕсли;	
КонецПроцедуры	

Процедура ЧекОплатыДействие(ДопПараметры) Экспорт    
Если НЕ ДопПараметры.Свойство("ЭтоЧекНаАванс") Тогда 
	ДопПараметры.Вставить("ЭтоЧекНаАванс", Ложь);
КонецЕсли;

Если НЕ ДопПараметры.Свойство("ЭтоГрупповойСчет") Тогда 
	ДопПараметры.Вставить("ЭтоГрупповойСчет", Ложь);
КонецЕсли;

Если НЕ ДопПараметры.Свойство("ЭтоСчетКоворкинг") Тогда 
	ДопПараметры.Вставить("ЭтоСчетКоворкинг", Ложь);
КонецЕсли;

Если НЕ ДопПараметры.Свойство("ЭтоСчетНаОплату") Тогда 
	ДопПараметры.Вставить("ЭтоСчетНаОплату", Ложь);
КонецЕсли;

Счет = ДопПараметры.Счет;

ДокументДолгОбъектДанные = ДопПараметры.ДокументДолгОбъектДанные; 


//
Если ДопПараметры.ЭтоСчетКоворкинг Тогда
	Если ЗначениеЗаполнено(ДокументДолгОбъектДанные.ОплачиваетСчет) Тогда 
		Контрагент = ДокументДолгОбъектДанные.ОплачиваетСчет;
	Иначе
		Контрагент = ОбщийФункционалСервер.ЗначениеРеквизитаНаСервере(ДокументДолгОбъектДанные.КоворкингЗаявка, "Клиент"); 
	КонецЕсли;
ИначеЕсли ДопПараметры.ЭтоЧекНаАванс Тогда 
	Контрагент = ДопПараметры.Контрагент;
Иначе	
	Контрагент = Счет.Контрагент;
КонецЕсли;	

Если НЕ ЗначениеЗаполнено(Контрагент) Тогда
	Сообщить("Контрагент (Оплачивает) - пусто. Оплата отменяется. ОБРАТИТЕСЬ К АДМИНИСТРАТОРУ ПРОГРАММЫ.");
	
	Возврат;
КонецЕсли;	
//

Если ДопПараметры.ЭтоСчетКоворкинг Тогда
	
	СуммаКОплате = КоворкингСервер.СуммаКОплатеКоворкинг(ДокументДолгОбъектДанные);
		
ИначеЕсли ДопПараметры.ЭтоГрупповойСчет Тогда
	СуммаКОплате = ГрупповойСчетСервер.СуммаКОплатеГрупповойСчет(ДокументДолгОбъектДанные);
	
ИначеЕсли ДопПараметры.ЭтоСчетНаОплату Тогда
	СчетаДетальноДолги = ДопПараметры.СчетаДетальноДолги;
	
	СуммаКОплате = 0;
	Для Каждого Элемент Из СчетаДетальноДолги Цикл
		СуммаКОплате = СуммаКОплате + Элемент.СуммаКЗакрытию;
	КонецЦикла;
	
Иначе
	ОтборСтроки = Новый Структура("СчетГУИД", Счет.СчетГУИД); 
	СчетаДетальноДолги = ДокументДолгОбъектДанные.СчетаДетальноДолги.НайтиСтроки(ОтборСтроки);
	
	СуммаКОплате = 0;
	Для Каждого Элемент Из СчетаДетальноДолги Цикл
		СуммаКОплате = СуммаКОплате + Элемент.СуммаКЗакрытию;
	КонецЦикла;
КонецЕсли;

//Если СуммаКОплате = 0 Тогда
//	ПоказатьПредупреждение(, "Счет уже оплачен");
//	Возврат;
//КонецЕсли;

ДопПараметры.Вставить("СуммаКОплате", СуммаКОплате);

Оповещение = Новый ОписаниеОповещения("ЗавершитьВводЗначения_СуммаОплаты", ЭтотОбъект, ДопПараметры);	
Сумма = СуммаКОплате;
ПоказатьВводЗначения(Оповещение, Сумма, "Сумма оплаты");
КонецПроцедуры

Процедура ЗавершитьВводЗначения_СуммаОплаты(Результат, ДополнительныеПараметры) Экспорт
Если Результат = Неопределено Тогда Возврат; КонецЕсли;

СуммаОплаты = Результат;
СуммаКОплате = ДополнительныеПараметры.СуммаКОплате; 
ТекстПредупреждения = "";
Если Результат < 0 Тогда  
	ТекстПредупреждения = "Введенная сумма меньще 0."; 
КонецЕсли;

Если ЗначениеЗаполнено(ТекстПредупреждения) Тогда 
	ПоказатьПредупреждение(, ТекстПредупреждения 
		+ Символы.ПС + Символы.ПС + "ОПЛАТА ОТМЕНЯЕТСЯ ...");
		
	Возврат;	
КонецЕсли;

ЭтоАванс = (СуммаОплаты < СуммаКОплате);
Если ЭтоАванс Тогда 
	РазрешениеОплаты = НастройкиСервер.ЭтоАдмин() ИЛИ НастройкиСервер.ЭтоАдминистратор();
	Если НЕ РазрешениеОплаты Тогда
		ТекстПредупреждения = "Введенная сумма меньше суммы к оплате.
		|Это аванс.
		| 
		|Вам запрещено оплачивать авансы.
		|Обратитесь к старшему администратору.
		|
		|ОПЛАТА ОТМЕНЯЕТСЯ ..."; 
		ПоказатьПредупреждение(, ТекстПредупреждения);
		
		Возврат;
	КонецЕсли;
КонецЕсли;

ДополнительныеПараметры.Вставить("СуммаОплаты", СуммаОплаты);

Если (СуммаОплаты > СуммаКОплате) Тогда 
	ЭтоАванс = Истина;
	ДополнительныеПараметры.Вставить("ЭтоАванс", ЭтоАванс);
	
	ДопПараметры = ДополнительныеПараметры;
	
	ОписаниеОповещения = Новый ОписаниеОповещения("ЗавершениеВопроса_СуммаЧекаБольшеСуммыКОплате", ЭтотОбъект, ДопПараметры);
	
	Если СуммаКОплате = 0 Тогда 
		ТекстВопроса = "ВНИМАНИЕ ! Сумма к оплате = 0
		|
		|Будет отбит чек на АВАНС."; 
	Иначе
		ТекстВопроса = "ВНИМАНИЕ ! Сумма чека: " + СуммаОплаты + " > суммы к оплате: " + СуммаКОплате + ".
		            |
					|Будет отбит чек на АВАНС.";
	КонецЕсли;
	
	ТекстВопроса = ТекстВопроса + Символы.ПС + Символы.ПС + "ПРОДОЛЖИТЬ ?";
	ПоказатьВопрос(ОписаниеОповещения, ТекстВопроса, РежимДиалогаВопрос.ОКОтмена);
	
	Возврат;
КонецЕсли;

ДополнительныеПараметры.Вставить("ЭтоАванс", ЭтоАванс);
ОткрытьФормуЧек(ДополнительныеПараметры);
КонецПроцедуры

Процедура ЗавершениеВопроса_СуммаЧекаБольшеСуммыКОплате(Результат, ДополнительныеПараметры) Экспорт
Если Результат = КодВозвратаДиалога.Отмена Тогда Возврат; КонецЕсли;
	
ОткрытьФормуЧек(ДополнительныеПараметры);	
КонецПроцедуры
//

//
Процедура ОткрытьФормуЧек(ДопПараметры) Экспорт
ПозицииЧекаККМ = Новый Массив;

ДокументДолгОбъектДанные = ДопПараметры.ДокументДолгОбъектДанные;

ЭтоАванс = ДопПараметры.ЭтоАванс;
Если ДопПараметры.СуммаОплаты = 0 И ЭтоАванс Тогда
	ПоказатьПредупреждение(, "Сумма аванса = 0.
							|
							|ПЕЧАТЬ ЧЕКА ОТМЕНЯЕТСЯ ...");
	Возврат;
КонецЕсли;	

Если ЭтоАванс Тогда
	СуммаАванса = ДопПараметры.СуммаОплаты;
	ЗаполнитьПозицииЧекаККМАванс(ПозицииЧекаККМ, СуммаАванса);	
	
	СуммаПредыдущихОплат = 0;
Иначе
	
	Счет = ДопПараметры.Счет;
	Если ДопПараметры.ЭтоСчетКоворкинг Тогда
		СуммаКОплате = ДопПараметры.СуммаКОплате;
		
		ЗаполнитьПозицииЧекаККМОплатаКоворкинг(ПозицииЧекаККМ, ДокументДолгОбъектДанные);
		СуммаПредыдущихОплат = СуммаПредыдущихОплатКоворкинг(ДокументДолгОбъектДанные);		
	ИначеЕсли ДопПараметры.ЭтоГрупповойСчет Тогда
		ЗаполнитьПозицииЧекаККМОплатаГрупповойСчет(ПозицииЧекаККМ, ДокументДолгОбъектДанные);
			
		СуммаПредыдущихОплат = СуммаПредыдущихОплатГрупповойСчет(ДокументДолгОбъектДанные);	
	ИначеЕсли ДопПараметры.ЭтоСчетНаОплату Тогда
		СчетаДетальноДолги = ДопПараметры.СчетаДетальноДолги;
		
		ЗаполнитьПозицииЧекаККМОплата(ПозицииЧекаККМ, СчетаДетальноДолги, ДокументДолгОбъектДанные, Счет.СвернутьВСчете);
		
		РаспределениеОплатДолги = ДопПараметры.РаспределениеОплатДолги;
		СуммаПредыдущихОплат = СуммаПредыдущихОплат(Счет.СчетГУИД, РаспределениеОплатДолги);	
	Иначе
		ОтборСтроки = Новый Структура("СчетГУИД", Счет.СчетГУИД); 
		СчетаДетальноДолги = ДокументДолгОбъектДанные.СчетаДетальноДолги.НайтиСтроки(ОтборСтроки);
		
		ЗаполнитьПозицииЧекаККМОплата(ПозицииЧекаККМ, СчетаДетальноДолги, ДокументДолгОбъектДанные, Счет.СвернутьВСчете);
		СуммаПредыдущихОплат = СуммаПредыдущихОплат(Счет.СчетГУИД, ДокументДолгОбъектДанные.РаспределениеОплатДолги);
	КонецЕсли;		
КонецЕсли;	
ДопПараметры.Вставить("ПозицииЧекаККМ", ПозицииЧекаККМ); 

ПараметрыФормы = Новый Структура;
ПараметрыФормы.Вставить("СуммаКОплате", ДопПараметры.СуммаКОплате);
ПараметрыФормы.Вставить("СуммаОплаты", ДопПараметры.СуммаОплаты);
ПараметрыФормы.Вставить("СуммаПредыдущихОплат", СуммаПредыдущихОплат);
ПараметрыФормы.Вставить("ЭтоАванс", ДопПараметры.ЭтоАванс);
ПараметрыФормы.Вставить("ПозицииЧекаККМ", ПозицииЧекаККМ);   

ПараметрыФормы.Вставить("ДокументДолг", ДокументДолгОбъектДанные.Ссылка);   

Если ДопПараметры.Свойство("ЭтоКоворкинг") Тогда
	ПараметрыФормы.Вставить("ЭтоКоворкинг", ДопПараметры.ЭтоКоворкинг); 
КонецЕсли;

Форма = ДопПараметры.Форма;
ДопПараметры.Удалить("Форма");

Оповещение = Новый ОписаниеОповещения("ЗакрытиеФормыЧек", ЭтотОбъект, ДопПараметры);
ОткрытьФорму("ОбщаяФорма.Чек", ПараметрыФормы, Форма
	,,,, Оповещение, РежимОткрытияОкнаФормы.БлокироватьВесьИнтерфейс);
КонецПроцедуры

Процедура ЗакрытиеФормыЧек(Результат, ДополнительныеПараметры) Экспорт
Если Результат = Неопределено Тогда Возврат; КонецЕсли;	

ОчиститьСообщения();

ФУ_Клиент.ПоказатьПодтверждениеСообщение(Результат);

Если  Результат.ОшибкаОперации Тогда Возврат; КонецЕсли;

СуммаНалЧекККМ = Результат.СуммаНаличные;
СуммаБезналЧекККМ = Результат.СуммаКарта;
СуммаДокументОплаты =  СуммаНалЧекККМ + СуммаБезналЧекККМ;   

ГУИД_ЭТ =  Результат.ГУИД_ЭТ;   

Если СуммаДокументОплаты = 0 Тогда Перейти ~ВЫХОД; КонецЕсли; 
// + КассовыйДокументСоздатьДокументПриход

ДопПараметры = Новый Структура;

ДокументДолгОбъектДанные = ДополнительныеПараметры.ДокументДолгОбъектДанные;
ДопПараметры.Вставить("ДокументДолгОбъектДанные", ДокументДолгОбъектДанные);

ЭтоЧекНаАванс = ДополнительныеПараметры.ЭтоЧекНаАванс;

ЭтоСчетКоворкинг = ДополнительныеПараметры.ЭтоСчетКоворкинг;
Если ЭтоСчетКоворкинг Тогда
	Если ЗначениеЗаполнено(ДокументДолгОбъектДанные.ОплачиваетСчет) Тогда 
		Контрагент = ДокументДолгОбъектДанные.ОплачиваетСчет;
	Иначе
		Клиент = ОбщийФункционалСервер.ЗначениеРеквизитаНаСервере(ДокументДолгОбъектДанные.КоворкингЗаявка, "Клиент"); 
		Контрагент = Клиент;
	КонецЕсли;
ИначеЕсли ЭтоЧекНаАванс Тогда 
	Счет = Неопределено;
	СчетГУИД = Неопределено;
	
	Контрагент = ДополнительныеПараметры.Контрагент;
Иначе	
	Счет = ДополнительныеПараметры.Счет;
	СчетГУИД = Счет.СчетГУИД;

	Контрагент = Счет.Контрагент;
КонецЕсли;	
ДопПараметры.Вставить("Оплачивает", Контрагент);

//ДопПараметры.Вставить("ЭтоАванс", ДополнительныеПараметры.ЭтоАванс);
ЭтоАванс = Результат.ЭтоАванс; 
ДопПараметры.Вставить("ЭтоАванс", ЭтоАванс);

ДопПараметры.Вставить("НомерСменыККМ", Результат.НомерСменыККМ);
ДопПараметры.Вставить("НомерЧекаККМ", Результат.НомерЧекаККМ);

ДопПараметры.Вставить("ПозицииЧекаККМ", ДополнительныеПараметры.ПозицииЧекаККМ);

ДопПараметры.Вставить("ГУИД_ЭТ", ГУИД_ЭТ);

ДокументОплаты = ОплатыОбщееСервер.КассовыйДокументСоздатьДокументПриход(СуммаНалЧекККМ, СуммаБезналЧекККМ, ДопПараметры);

// + Распределение
Если ЭтоСчетКоворкинг Тогда
	КоворкингСервер.ДобавитьДокументОплатаКоворкингСчет(ДокументОплаты, ДокументДолгОбъектДанные.Ссылка);
		
ИначеЕсли ДополнительныеПараметры.ЭтоГрупповойСчет Тогда
	ГрупповойСчетСервер.ДобавитьИЗаписатьДокументОплатыВГрупповойСчетОбъектТранзакция(ДокументОплаты
			, ДокументДолгОбъектДанные, СуммаДокументОплаты);	
			
ИначеЕсли ДополнительныеПараметры.ЭтоЧекНаАванс Тогда
	ЗаявкаСервер.ДобавитьДокументОплатаЗаявкаНаБронирование(ДокументОплаты, ДокументДолгОбъектДанные.Ссылка
		, Неопределено, ЭтоЧекНаАванс, ЭтоАванс);
		
ИначеЕсли ДополнительныеПараметры.ЭтоСчетНаОплату Тогда
	СчетаДетальноОплаты = ДополнительныеПараметры.СчетаДетальноОплаты;
	
	НоваяОплата = СчетаДетальноОплаты.Добавить();
	НоваяОплата.ДокументОплаты = ДокументОплаты;
	
	ДатаДокумента = ОбщийФункционалСервер.ЗначениеРеквизитаНаСервере(ДокументОплаты, "Дата");
	НоваяОплата.ДатаДокумента = ДатаДокумента;
	
	НоваяОплата.ДатаОплаты = ТекущаяДата();

	НоваяОплата.Аванс = ЭтоАванс;
	
	РаспределениеОплатДолги = ДополнительныеПараметры.РаспределениеОплатДолги;	
	
	ОтборСтроки = Новый Структура("СчетГУИД", СчетГУИД);
	СчетаДетальноДолги = ДополнительныеПараметры.СчетаДетальноДолги.НайтиСтроки(ОтборСтроки);	
	
	ЗаявкаОбщееКлиентСервер.РаспределитьОплатаНаСчетаДетальноДолги(НоваяОплата
		, СуммаДокументОплаты, СчетаДетальноДолги, РаспределениеОплатДолги);
		
	//Счет.Закрыт = ОбщийМодульОплатыСервер.СчетЗакрытСчетаДетальноДолги(СчетаДетальноДолги);	
	
Иначе	
	СчетСтруктура = ОбщийФункционалСервер.СтруктураИзТабличнаяЧастьДокумента("ЗаявкаНаБронирование", "Счета");
	ЗаполнитьЗначенияСвойств(СчетСтруктура, Счет);
	
	ЗаявкаСервер.ДобавитьДокументОплатаЗаявкаНаБронирование(ДокументОплаты, ДокументДолгОбъектДанные.Ссылка
		, СчетСтруктура, ЭтоЧекНаАванс, ЭтоАванс);
КонецЕсли;
// - Распределение

//// Выход
~ВЫХОД:
ОповещениеЗавершениеЧек = ДополнительныеПараметры.ОповещениеЗавершениеЧек;
ДополнительныеПараметры.Удалить("ОповещениеЗавершениеЧек");

ДопПараметры = ОповещениеЗавершениеЧек.ДополнительныеПараметры;
ДопПараметры.Вставить("ДокументОплаты", ДокументОплаты);
