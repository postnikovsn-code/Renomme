	МенеджерЗаписи.Прочитать();
	
	МенеджерЗаписи.Дата = Строка.Дата;
	МенеджерЗаписи.Отель = Строка.Отель;
	МенеджерЗаписи.Месяц = НачалоМесяца(Строка.Дата);
	
	МенеджерЗаписи.КоличествоНомеров = Строка.КоличествоНомеров;
	МенеджерЗаписи.КоличествоДвухместныеРазмещения = Строка.КоличествоДвухместныеРазмещения;
	МенеджерЗаписи.СуммаДвухместныеРазмещения = Строка.СуммаДвухместныеРазмещения;
	МенеджерЗаписи.КоличествоОдноместныеРазмещения = Строка.КоличествоОдноместныеРазмещения;
	МенеджерЗаписи.СуммаОдноместныеРазмещения = Строка.СуммаОдноместныеРазмещения;
	МенеджерЗаписи.СуммаАгентскогоВознаграждения = Строка.СуммаАгентскогоВознаграждения;
	
	МенеджерЗаписи.СуммаВ2В = Строка.СуммаВ2В;
	МенеджерЗаписи.СуммаКомиссии = Строка.СуммаКомиссии;
	
	МенеджерЗаписи.Мероприятия = Строка.Мероприятия;
	
	МенеджерЗаписи.Записать();
КонецЦикла;	
	
КонецПроцедуры

Функция РегистрЕжедневныйОтчетФактВыгрузить(ДатаС, ДатаПо) Экспорт
