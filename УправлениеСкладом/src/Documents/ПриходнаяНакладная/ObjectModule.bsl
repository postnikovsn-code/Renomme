// Модуль объекта документа «Приходная накладная».
//
// Документ регистрирует поступление товара на склад:
// при проведении в регистр «ОстаткиТоваров» записываются движения «Приход».

#Область ОбработчикиСобытий

Процедура ОбработкаЗаполнения(ДанныеЗаполнения, СтандартнаяОбработка)

	// По умолчанию подставляем первый склад справочника,
	// чтобы пользователь не оставил реквизит пустым.
	Если Не ЗначениеЗаполнено(Склад) Тогда
		Склад = СкладПовтИсп.ОсновнойСклад();
	КонецЕсли;

КонецПроцедуры

Процедура ПередЗаписью(Отказ, ПараметрыЗаписи)

	// Перед записью синхронизируем суммы строк с количеством и ценой,
	// чтобы в базу не попали «рассогласованные» данные.
	Если ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;

	РассчитатьСуммыСтрок();

КонецПроцедуры

Процедура ОбработкаПроведения(Отказ, РежимПроведения)

	// Основная логика вынесена в общий модуль — так ее можно
	// переиспользовать и протестировать отдельно от документа.
	СкладСервер.ОприходоватьТовары(ЭтотОбъект, Отказ);

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Процедура РассчитатьСуммыСтрок()

	Для Каждого СтрокаТЧ Из Товары Цикл
		СтрокаТЧ.Сумма = Окр(СтрокаТЧ.Количество * СтрокаТЧ.Цена, 2);
	КонецЦикла;

КонецПроцедуры

#КонецОбласти
