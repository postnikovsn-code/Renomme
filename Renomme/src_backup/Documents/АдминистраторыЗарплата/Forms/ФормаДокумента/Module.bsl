&НаСервере
Процедура РасчитатьЗарплатуНаСервере()
ДН = Объект.ДН; 
ДК = КонецДня(Объект.ДК);

Для Каждого Строка Из ЗарплатаСмены Цикл
	
	Дата_П = Объект.ДН;
	Пока Дата_П <= Объект.ДК Цикл
		Дата_С = Формат(Дата_П, "ДФ=dd.MM.yy");
		Дата_И = СтрЗаменить(Дата_С, ".", "");
		
		Имя_Право = Дата_И;
		
		РасчитатьСтрокаЗарплатаСменыСмена(Строка, Имя_Право);
		
		Дата_П = Дата_П + 24 * 60 * 60;
	КонецЦикла;	
	
	ОбновитьСтрокаЗарплатаСменыДаты_Э(Строка);
	ОбновитьСтрокаЗарплатыСменаИзДат(Строка);	
	
	РасчитатьНадбавки(Строка);
	Если Строка.Администратор.Постоянный Тогда
		 РасчитатьПостоянный(Строка);
	КонецЕсли;
	РасчитатьПрочее(Строка);
	
	ОбновитьСтрокаЗарплатаСменыОсновные_Э(Строка);
	ОбновитьЗарплатаСменыИтоги(Строка);
КонецЦикла;	
КонецПроцедуры

&НаСервере
Процедура РасчитатьНадбавки(Строка);

Строка.НадбавкаЗаСтаж = СуммаНадбавкаЗаСтаж(Строка);	
Строка.НадбавкаЗаСтандарты = СуммаНадбавкаЗаСтандарты(Строка);	
Строка.НадбавкаЗаИнЯзыки = СуммаНадбавкаЗаИнЯзыки(Строка);	
	
КонецПроцедуры

&НаСервере
Процедура РасчитатьПостоянный(Строка);
КоличествоРасчетныхДней = КоличествоРасчетныхДней(Строка); 

МесяцРасчета = Объект.ДН;
КоличествоДнейМесяц = День(КонецМесяца(МесяцРасчета));

АдминистраторСправочник = АдминистраторСправочник(Строка.Администратор);
ОкладДляПостоянных = Окр(АдминистраторСправочник.СуммаОклад * КоличествоРасчетныхДней / КоличествоДнейМесяц);
Строка.Оклад = ОкладДляПостоянных;

НадбавкаЗаПроживающихДляПостоянных = Окр(АдминистраторСправочник.НадбавкаЗаПроживающих * КоличествоРасчетныхДней / КоличествоДнейМесяц);
Строка.СуммаЗаПроживающих = НадбавкаЗаПроживающихДляПостоянных;
КонецПроцедуры

&НаСервере
Функция КоличествоРасчетныхДней(ТД) 
//Если Горничная.Наименование = "Сонникова Людмила" Тогда
//	ш= 1;
//КонецЕсли;

РазницаВДняхОбщая = ((НачалоДня(Объект.ДК) - НачалоДня(Объект.ДН)) / (60 * 60 * 24)) + 1;
	
ДнейОтпуска = 0;

Дата_П = Объект.ДН;
Пока Дата_П <= Объект.ДК Цикл
	Дата_С = Формат(Дата_П, "ДФ=dd.MM.yy");
	Дата_И = СтрЗаменить(Дата_С, ".", "");
	
	Если ТД["НомерСмены_" + Дата_И] = 3 Тогда
		ДнейОтпуска = ДнейОтпуска + 1;
	КонецЕсли;
	
	Дата_П = Дата_П + 24 * 60 * 60;
КонецЦикла;

КоличествоРасчетныхДней = РазницаВДняхОбщая - ДнейОтпуска; 

Возврат КоличествоРасчетныхДней;
КонецФункции

