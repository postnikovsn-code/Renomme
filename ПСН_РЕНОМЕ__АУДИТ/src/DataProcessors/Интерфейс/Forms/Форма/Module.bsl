&НаКлиенте
Функция НайтиЧислаВСтроке(Строка) 

МассивЧисел = Новый Массив; // сюда поместим все найденные числа. В данном примере в массив должно попасть 3 числа: 234224, 555 и 1

СтрокаЧисел = "";
Для Индекс = 1 По СтрДлина(Строка) Цикл
	Символ = Сред(Строка, Индекс, 1); // Перебираем все сиволы из нашей строки

	Если КодСимвола(Символ) >= 48 И КодСимвола(Символ) <= 57 Тогда // Код нуля - 48, код 9-ки - 57
		СтрокаЧисел = СтрокаЧисел + Символ;
	ИначеЕсли СтрДлина(СтрокаЧисел) > 0 Тогда
		МассивЧисел.Добавить(Число(СтрокаЧисел));
	  	СтрокаЧисел = "";
	КонецЕсли;
КонецЦикла;

Если СтрДлина(СтрокаЧисел) > 0 Тогда
	МассивЧисел.Добавить(Число(СтрокаЧисел));
КонецЕсли;

Возврат МассивЧисел;

КонецФункции

&НаСервере
Функция ПолеОтчетаКонтекстНаСервере(НомерСтроки, НачалоНомерСтолбца, КонецНомерСтолбца)
// + НомерВРезерв	
НомерИмяЯчейки = "R" + Строка(НомерСтроки) + "C1";
НомерИмяЯчейки = НомерИмяЯчейки + ":" + НомерИмяЯчейки;
ОбластьНомера = ПолеОтчета.ПолучитьОбласть(НомерИмяЯчейки);
	
Если ТипЗнч(ОбластьНомера.ТекущаяОбласть.Расшифровка) = Тип("СправочникСсылка.НомернойФонд") Тогда	
	НомерВРезерв = ОбластьНомера.ТекущаяОбласть.Расшифровка;
Иначе
	Возврат Неопределено;
КонецЕсли;
// - НомерВРезерв	

// + Начало	
НомерИмяЯчейки = "R3"  + "C" + Строка(НачалоНомерСтолбца);
НомерИмяЯчейки = НомерИмяЯчейки + ":" + НомерИмяЯчейки;
ОбластьВремя = ПолеОтчета.ПолучитьОбласть(НомерИмяЯчейки);
Если ОбластьВремя.ТекущаяОбласть.Текст = "00:00" Тогда 
	ВремяЗаезда = Перечисления.ВремяЗаезда.Вр0;
	
	НачалоНомерСтолбцаДата = НачалоНомерСтолбца;	
ИначеЕсли ОбластьВремя.ТекущаяОбласть.Текст = "06:00" Тогда 
	ВремяЗаезда = Перечисления.ВремяЗаезда.Вр6;
	
	НачалоНомерСтолбцаДата = НачалоНомерСтолбца - 1;	
ИначеЕсли ОбластьВремя.ТекущаяОбласть.Текст = "14:00" Тогда 
	ВремяЗаезда = Перечисления.ВремяЗаезда.Вр14;
	
	НачалоНомерСтолбцаДата = НачалоНомерСтолбца - 2;	
ИначеЕсли ОбластьВремя.ТекущаяОбласть.Текст = "18:00" Тогда 
	ВремяЗаезда = Перечисления.ВремяЗаезда.Вр18;
	
	НачалоНомерСтолбцаДата = НачалоНомерСтолбца - 3;	
Иначе
	Возврат Неопределено;
КонецЕсли;	

НомерИмяЯчейки = "R2"  + "C" + Строка(НачалоНомерСтолбцаДата);
//НомерИмяЯчейки = НомерИмяЯчейки + ":" + НомерИмяЯчейки;
НомерИмяЯчейки = НомерИмяЯчейки + ":" + "R2"  + "C" + Строка(НачалоНомерСтолбцаДата + 3);;
ОбластьНомера = ПолеОтчета.ПолучитьОбласть(НомерИмяЯчейки);

//Год = Год(ТекущаяДата());
Год = Год(ТекДатаШахматки);

Текст = ОбластьНомера.ТекущаяОбласть.Текст;
Индекс = СтрНайти(Текст, ".");

День = Число(Лев(Текст, Индекс - 1)); 
Месяц = Число(Сред(Текст, Индекс + 1)); 

РезервС = Дата(Год, Месяц, День); 
// - Начало	

// + Конец	
НомерИмяЯчейки = "R3"  + "C" + Строка(КонецНомерСтолбца);
НомерИмяЯчейки = НомерИмяЯчейки + ":" + НомерИмяЯчейки;
