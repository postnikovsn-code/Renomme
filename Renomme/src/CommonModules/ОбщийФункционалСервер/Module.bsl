Если ИмяРеквизита = "Наименование" Тогда
	Результат = Документы[ИмяДокумента].НайтиПоНаименованию(ЗначениеРеквизита);
ИначеЕсли ИмяРеквизита = "Код" Тогда
	Результат = Документы[ИмяДокумента].НайтиПоКоду(ЗначениеРеквизита);
Иначе
	Результат = Документы[ИмяДокумента].НайтиПоРеквизиту(ИмяРеквизита, ЗначениеРеквизита);
КонецЕсли;

Возврат Результат;
КонецФункции

Функция ПолучитьАбсолютныйЦвет(ИсходныйЦвет) Экспорт

    Если ИсходныйЦвет.Вид = ВидЦвета.Абсолютный Тогда
        Возврат ИсходныйЦвет;
    КонецЕсли;

    ТабДок = Новый ТабличныйДокумент;
    ТабДок.Область("R1C1").ЦветФона = ИсходныйЦвет;
    ВФ = ПолучитьИмяВременногоФайла("mxl");
    ТабДок.Записать(ВФ, ТипФайлаТабличногоДокумента.MXL7);
    ТабДок.Прочитать(ВФ);

    АЦвет = ТабДок.Область("R1C1").ЦветФона;
    ТабДок = Неопределено;
    УдалитьФайлы(ВФ);

    Возврат АЦвет;

КонецФункции

