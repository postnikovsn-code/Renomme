&НаКлиенте
Функция ОпределитьПоКоординатам(х,у)
Отбор=Новый Структура("Х,У",Х,У);
Стр=ТЗШахм.НайтиСтроки(Отбор);

ВозврСтр=Новый Структура("Клиент,Номер,Период,Документ"
	,ПредопределенноеЗначение("Справочник.Клиенты.ПустаяСсылка")
	,ПредопределенноеЗначение("Справочник.НомернойФонд.ПустаяСсылка")
	,ТекущаяДата()
	,Неопределено);
	//,ПредопределенноеЗначение("Документ.ЗаявкаНаБронирование.ПустаяСсылка"));
	
Если Стр.Количество()=0 тогда
	Возврат ВозврСтр;
иначе
	ВозврСтр.Клиент=Стр[0].Клиент;
	ВозврСтр.Номер=Стр[0].Номер;
	ВозврСтр.Период=Стр[0].Период;
	ВозврСтр.Документ=Стр[0].Документ;
	Возврат ВозврСтр;
КонецЕсли;
