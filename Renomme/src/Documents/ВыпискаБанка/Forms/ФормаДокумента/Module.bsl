&НаСервере
Функция ТекстОшибки()
ДокументОбъект = РеквизитФормыВЗначение("Объект");
ТекстОшибки = ДокументОбъект.ТекстОшибки();

Если НЕ Объект.Возврат Тогда Перейти ~ВЫХОД; КонецЕсли;

Запрос = Новый Запрос ("ВЫБРАТЬ
                       |	ВыпискаБанка.Ссылка КАК ДокументОплаты,
                       |	ВыпискаБанка.Сумма - ЕСТЬNULL(Возвраты.Сумма, 0)  - ЕСТЬNULL(Долги.Сумма, 0) КАК ОстатокОплаты  
                       |ИЗ
                       |	Документ.ВыпискаБанка КАК ВыпискаБанка
                       |		ЛЕВОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
                       |			ВыпискаБанка.ВозвратДокумент КАК ВозвратДокумент,
                       |			СУММА(ВыпискаБанка.Сумма) КАК Сумма
                       |		ИЗ
                       |			Документ.ВыпискаБанка КАК ВыпискаБанка
                       |		ГДЕ
                       |			ВыпискаБанка.ПометкаУдаления = ЛОЖЬ
                       |		
                       |		СГРУППИРОВАТЬ ПО
                       |			ВыпискаБанка.ВозвратДокумент) КАК Возвраты
                       |		ПО ВыпискаБанка.Ссылка = Возвраты.ВозвратДокумент
                       |		ЛЕВОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
                       |			ВыпискаБанкаДолгиОплата.Ссылка КАК Ссылка,
                       |			СУММА(ВыпискаБанкаДолгиОплата.Сумма) КАК Сумма
                       |		ИЗ
                       |			Документ.ВыпискаБанка.ДолгиОплата КАК ВыпискаБанкаДолгиОплата
                       |		
                       |		СГРУППИРОВАТЬ ПО
                       |			ВыпискаБанкаДолгиОплата.Ссылка) КАК Долги
                       |		ПО ВыпискаБанка.Ссылка = Долги.Ссылка
                       |ГДЕ
                       |	ИСТИНА
                       |	И ВыпискаБанка.Ссылка = &ВозвратДокумент");

Запрос.УстановитьПараметр("ВозвратДокумент", Объект.ВозвратДокумент);

Выборка = Запрос.Выполнить().Выбрать();
Если Выборка.Следующий() Тогда
	ОстатокОплаты = Выборка.ОстатокОплаты;
Иначе
	Перейти ~ВЫХОД;
КонецЕсли;

Если ОстатокОплаты < Объект.Сумма Тогда
	ТекстОшибки_П = "Остаток оплаты < Сумма возврата";
	
	Если ТекстОшибки = Неопределено Тогда 
		ТекстОшибки = Новый Структура("ТекстПредупреждение, ТекстСообщение", ТекстОшибки_П, ТекстОшибки_П);
	Иначе
		ТекстПредупреждение = ОбщийФункционалКлиентСервер.ДобавитьТекст(ТекстОшибки.ТекстПредупреждение, ТекстОшибки_П, Символы.ПС); 
		ТекстСообщение = ОбщийФункционалКлиентСервер.ДобавитьТекст(ТекстОшибки.ТекстСообщение, ТекстОшибки_П, " "); 
		
		ТекстОшибки.ТекстПредупреждение = ТекстПредупреждение;
		ТекстОшибки.ТекстСообщение = ТекстСообщение;
	КонецЕсли;
КонецЕсли;

 ~ВЫХОД:
Возврат ТекстОшибки;	
КонецФункции	

