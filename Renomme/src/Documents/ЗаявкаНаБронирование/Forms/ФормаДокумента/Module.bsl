&НаКлиенте
Процедура СправкаОПроживании(Команда)
Если НастройкиСервер.ЭтоРеноме() 
ИЛИ НастройкиСервер.ЭтоДомСоветов()
ИЛИ НастройкиСервер.ЭтоЧехов()
ИЛИ НастройкиСервер.ЭтоЛайв() 
Тогда
	ПараметрыФормы = Новый Структура;
	ПараметрыФормы.Вставить("Клиент", Объект.Клиент);
	ПараметрыФормы.Вставить("Дата_С", Объект.РезервС);
	ПараметрыФормы.Вставить("Дата_По", Объект.РезервПо);
	ПараметрыФормы.Вставить("КатегорияНомера", Объект.КатегорияНомера);
	
	ПараметрыФормы.Вставить("ИсходящийНомер", Объект.Номер);
	ПараметрыФормы.Вставить("ИсходящаяДата", Объект.ВремяВыездаТочное);

	ОрганизацияИмя = НастройкиСервер.ПолучитьИмяТекущаяОрганизация();
	ПараметрыФормы.Вставить("Отель", ОрганизацияИмя);
	
	ОткрытьФорму("Документ.ЗаявкаНаБронирование.Форма.ФормаСправкаОПроживании", ПараметрыФормы , ЭтаФорма
		,,,,, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
КонецЕсли;
КонецПроцедуры
