<?xml version="1.0" encoding="UTF-8"?>
<DataCompositionSchema xmlns="http://v8.1c.ru/8.1/data-composition-system/schema" xmlns:dcscom="http://v8.1c.ru/8.1/data-composition-system/common" xmlns:dcscor="http://v8.1c.ru/8.1/data-composition-system/core" xmlns:dcsset="http://v8.1c.ru/8.1/data-composition-system/settings" xmlns:v8="http://v8.1c.ru/8.1/data/core" xmlns:v8ui="http://v8.1c.ru/8.1/data/ui" xmlns:xs="http://www.w3.org/2001/XMLSchema" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
	<dataSource>
		<name>ИсточникДанных1</name>
		<dataSourceType>Local</dataSourceType>
	</dataSource>
	<dataSet xsi:type="DataSetQuery">
		<name>НаборДанных1</name>
		<field xsi:type="DataSetFieldField">
			<dataPath>Клиент</dataPath>
			<field>Клиент</field>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>КлиентМенеджер</dataPath>
			<field>КлиентМенеджер</field>
			<title xsi:type="v8:LocalStringType">
				<v8:item>
					<v8:lang>ru</v8:lang>
					<v8:content>Персональный менеджер</v8:content>
				</v8:item>
			</title>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>РезервПо</dataPath>
			<field>РезервПо</field>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>РезервС</dataPath>
			<field>РезервС</field>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>СуммаОплат</dataPath>
			<field>СуммаОплат</field>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>Ссылка</dataPath>
			<field>Ссылка</field>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>Проживает</dataPath>
			<field>Проживает</field>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>НомерВРезерв</dataPath>
			<field>НомерВРезерв</field>
		</field>
		<dataSource>ИсточникДанных1</dataSource>
		<query>ВЫБРАТЬ
	ВыпискаБанка.Сумма,
	ВыпискаБанка.ДокументОплаты
ПОМЕСТИТЬ Оплаты
ИЗ
	Документ.ВыпискаБанка КАК ВыпискаБанка

ОБЪЕДИНИТЬ ВСЕ

ВЫБРАТЬ
	СУММА(КассовыйДокумент.Сумма),
	КассовыйДокумент.ДокументОплаты
ИЗ
	Документ.КассовыйДокумент КАК КассовыйДокумент

СГРУППИРОВАТЬ ПО
	КассовыйДокумент.ДокументОплаты
;

////////////////////////////////////////////////////////////////////////////////
ВЫБРАТЬ
	ЗаявкаНаБронирование.Бронирует КАК Клиент,
	ЗаявкаНаБронирование.РезервС,
	ЗаявкаНаБронирование.РезервПо,
	ЗаявкаНаБронирование.Бронирует.Менеджер КАК КлиентМенеджер,
	ЕСТЬNULL(Оплаты.Сумма, 0) КАК СуммаОплат,
	ЗаявкаНаБронирование.Ссылка,
	ЗаявкаНаБронирование.Клиент КАК Проживает,
	ЗаявкаНаБронирование.НомерВРезерв
ИЗ
	Документ.ЗаявкаНаБронирование КАК ЗаявкаНаБронирование
		ЛЕВОЕ СОЕДИНЕНИЕ Оплаты КАК Оплаты
		ПО (Оплаты.ДокументОплаты = ЗаявкаНаБронирование.Ссылка)
ГДЕ
	ЗаявкаНаБронирование.Бронирует.Менеджер В
			(ВЫБРАТЬ
				Пользователи.Ссылка
			ИЗ
				Справочник.Пользователи КАК Пользователи)</query>
	</dataSet>
	<totalField>
		<dataPath>СуммаОплат</dataPath>
		<expression>Сумма(СуммаОплат)</expression>
		<group>Клиент</group>
