&НаКлиенте
Функция ПроверкаОтбораПредупреждение()
	
ТекстПредупреждения = "";
Если НЕ ЗначениеЗаполнено(Бронирует) Тогда 
		ТекстПредупреждения = ОбщийФункционалКлиентСервер.ДобавитьТекст(ТекстПредупреждения
			, "Заполните реквизит 'Бронирует'", Символы.ПС);
КонецЕсли;

Если НЕ ЗначениеЗаполнено(ДатаОтбораС) Тогда 
		ТекстПредупреждения = ОбщийФункционалКлиентСервер.ДобавитьТекст(ТекстПредупреждения
			, "Заполните реквизит 'Дата отбора Резерв С'", Символы.ПС);
КонецЕсли;

Если НЕ ЗначениеЗаполнено(ДатаОтбораПо) Тогда 
		ТекстПредупреждения = ОбщийФункционалКлиентСервер.ДобавитьТекст(ТекстПредупреждения
			, "Заполните реквизит 'Дата отбора Резерв По'", Символы.ПС);
КонецЕсли;

Если НЕ ТекстПредупреждения = "" Тогда 
		ПоказатьПредупреждение(, ТекстПредупреждения);
	Возврат Истина;
КонецЕсли;

Возврат Ложь;
КонецФункции
//

&НаКлиенте
Процедура ОтменаКоманда(Команда)
Закрыть();
КонецПроцедуры

&НаКлиенте
Процедура ДобавитьЗаявки(Команда)
МассивЗаявок = МассивЗаявок();
Если МассивЗаявок.Количество() = 0 Тогда 
		ПоказатьПредупреждение(, "Ничего не отмечено.");
	Возврат;
КонецЕсли;

ТекстПредупреждения = "";
Если НЕ ЗначениеЗаполнено(Бронирует) Тогда 
		ТекстПредупреждения = ОбщийФункционалКлиентСервер.ДобавитьТекст(ТекстПредупреждения
			, "Заполните реквизит 'Бронирует'", Символы.ПС);
			
		ПоказатьПредупреждение(, ТекстПредупреждения); 	
		Возврат;			
КонецЕсли;

ПараметрыЗакрытия = Новый Структура("Бронирует, ДатаС, ДатаПо, МассивЗаявок"
	, Бронирует, ДатаОтбораС, ДатаОтбораПо, МассивЗаявок); 
	
Закрыть(ПараметрыЗакрытия);   
КонецПроцедуры

&НаСервере
Функция МассивЗаявок()
ТаблицаОтбораПараметр = ТаблицаОтбора;	
МассивЗаявок = Новый Массив;
	
ОтборСтроки = Новый Структура("Отметка", Истина);
МассивОтборЗаявок = ТаблицаОтбора.НайтиСтроки(ОтборСтроки);
Если МассивОтборЗаявок.Количество() = 0 Тогда 
	Возврат МассивЗаявок; 
КонецЕсли; 

ТаблицаЗаявок = ТаблицаОтбора.Выгрузить(МассивОтборЗаявок);
ТаблицаЗаявок.Сортировать("РезервС, ЗаявкаНаБронирование");

Для Каждого Строка Из ТаблицаЗаявок Цикл
	Данные = Новый Структура();
	Данные.Вставить("ЗаявкаСсылка", Строка.ЗаявкаНаБронирование);
	
	МассивЗаявок.Добавить(Данные);
КонецЦикла;

Возврат МассивЗаявок;
КонецФункции












