&НаСервере
Процедура ВыпискаСвязьУдалитьНаСервере()
НачатьТранзакцию();

МассивКУдалению = Новый Массив;
Для Каждого ТекущиеДанныеВыпискаСвязиОплатыСчета Из ВыпискаСвязиОплатыСчета Цикл
	Если НЕ ТекущиеДанныеВыпискаСвязиОплатыСчета.Отметка Тогда Продолжить; КонецЕсли;
	
	//ТекущиеДанныеВыпискаСвязиОплатыСчета = Элементы.ВыпискаСвязиОплатыСчета.ТекущиеДанные; 	
	ДокументОплаты = ТекущиеДанныеВыпискаСвязиОплатыСчета.ДокументОплаты;
	ДокументДолг = ТекущиеДанныеВыпискаСвязиОплатыСчета.ДокументДолг;
	СчетГУИД = ТекущиеДанныеВыпискаСвязиОплатыСчета.СчетГУИД;

	ОтборСтроки = Новый Структура("ДокументОплаты", ДокументОплаты);	
	НайденныеСтроки = ВыпискаОплаты.НайтиСтроки(ОтборСтроки);	
	Если НайденныеСтроки.Количество() > 0 Тогда
		ТекущиеДанныеОплаты = НайденныеСтроки[0];
		ТекущиеДанныеОплаты.ОстатокОплаты = ТекущиеДанныеОплаты.ОстатокОплаты + ТекущиеДанныеВыпискаСвязиОплатыСчета.СуммаРаспределено; 
	КонецЕсли;

	ОтборСтроки = Новый Структура("СчетГУИД", СчетГУИД);	
	НайденныеСтроки = ВыпискаСчета.НайтиСтроки(ОтборСтроки);
	Если НайденныеСтроки.Количество() > 0 Тогда
		ТекущиеДанныеСчета = НайденныеСтроки[0];
		ТекущиеДанныеСчета.ОстатокКЗакрытию = ТекущиеДанныеСчета.ОстатокКЗакрытию + ТекущиеДанныеВыпискаСвязиОплатыСчета.СуммаРаспределено; 
	КонецЕсли;

	ВыпискаУдалитьДокументОплатыВДокументДолг(ДокументОплаты, ДокументДолг, СчетГУИД);

	МассивКУдалению.Добавить(ТекущиеДанныеВыпискаСвязиОплатыСчета);
КонецЦикла;	

Для Каждого Элемент Из МассивКУдалению Цикл
	ВыпискаСвязиОплатыСчета.Удалить(Элемент);
КонецЦикла;

ЗафиксироватьТранзакцию();
КонецПроцедуры

&НаСервере
Функция ВыпискаУдалитьДокументОплатыВДокументДолг(ДокументОплаты, ДокументДолг, СчетГУИД)
УдалитьДокументОплатыВДокументДолг(ДокументОплаты, ДокументДолг, СчетГУИД);

ОплатыОбщееСервер.УдалитьДокументОплатыДолгОплатыИДокументОплаты(ДокументОплаты, ДокументДолг, СчетГУИД);
КонецФункции

&НаСервере
Функция УдалитьДокументОплатыВДокументДолг(ДокументОплаты, ДокументДолг, СчетГУИД)
ДокументДолгОбъект = ДокументДолг.ПолучитьОбъект(); 
Если ТипЗнч(ДокументДолг) = Тип("ДокументСсылка.ЗаявкаНаБронирование") Тогда

	ЗаявкаСервер.УдалитьДокументОплаты(ДокументОплаты, ДокументДолгОбъект);
	
	ДокументДолгОбъект.Записать(РежимЗаписиДокумента.Проведение);
	
ИначеЕсли ТипЗнч(ДокументДолг) = Тип("ДокументСсылка.ГрупповыеСчета") Тогда
	
	Для Каждого СтрокаЗаявка Из ДокументДолгОбъект.ДокументыДолги Цикл
		ЗаявкаОбъект = СтрокаЗаявка.ДокументДолг.ПолучитьОбъект();

		ЗаявкаСервер.УдалитьДокументОплаты(ДокументОплаты, ЗаявкаОбъект);

		ЗаявкаОбъект.Записать(РежимЗаписиДокумента.Проведение);
			
		ОтборСтроки = Новый Структура("ДокументОплаты, ДокументДолг", ДокументОплаты, ЗаявкаОбъект.Ссылка);
		ОбщийФункционалСервер.УдалитьСтрокиОтборСтроки(ОтборСтроки, ДокументДолгОбъект.РаспределениеОплат);
	КонецЦикла;
	
	ОтборСтроки = Новый Структура("ДокументОплаты", ДокументОплаты);
	ОбщийФункционалСервер.УдалитьСтрокиОтборСтроки(ОтборСтроки, ДокументДолгОбъект.ДокументыОплаты);
	
	ДокументДолгОбъект.Записать(РежимЗаписиДокумента.Проведение);
	
ИначеЕсли ТипЗнч(ДокументДолг) = Тип("ДокументСсылка.КоворкингСчета") Тогда

	КоворкингСервер.УдалитьДокументОплаты(ДокументОплаты, ДокументДолгОбъект);
	
	ДокументДолгОбъект.Записать(РежимЗаписиДокумента.Проведение);
КонецЕсли;
КонецФункции
