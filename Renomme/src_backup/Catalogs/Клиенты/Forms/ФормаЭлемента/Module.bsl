&НаСервере
Функция КлиентМестоРожденияУведомление(Клиент)
КлиентМестоРожденияУведомление = "";

Если СокрЛП(Клиент.РождениеРегион_NEW) <> "" Тогда	
	КлиентМестоРожденияУведомление = ОбщийФункционалКлиентСервер.ДобавитьТекст(КлиентМестоРожденияУведомление
		, СокрЛП(Клиент.РождениеРегион_NEW), ", ");
КонецЕсли;	 

Если СокрЛП(Клиент.РождениеГород) <> "" Тогда	
	КлиентМестоРожденияУведомление = ОбщийФункционалКлиентСервер.ДобавитьТекст(КлиентМестоРожденияУведомление
		, СокрЛП(Клиент.РождениеГород), " ");
Иначе
	Если СокрЛП(Клиент.РождениеРайон) <> "" Тогда 
		КлиентМестоРожденияУведомление = ОбщийФункционалКлиентСервер.ДобавитьТекст(КлиентМестоРожденияУведомление
			, СокрЛП(Клиент.РождениеРайон), " ");
	КонецЕсли;
	
	Если СокрЛП(Клиент.РождениеНасПункт) <> "" Тогда 
		КлиентМестоРожденияУведомление = ОбщийФункционалКлиентСервер.ДобавитьТекст(КлиентМестоРожденияУведомление
			, СокрЛП(Клиент.РождениеНасПункт), " ");
	КонецЕсли;
КонецЕсли;

Возврат КлиентМестоРожденияУведомление;
КонецФункции

