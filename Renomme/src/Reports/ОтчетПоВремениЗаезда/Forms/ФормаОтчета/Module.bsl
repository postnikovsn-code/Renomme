&НаСервереБезКонтекста
ФункциЯ СтрКатегория(кат)
	Если Кат=1 тогда
		Возврат "00:00-01:00";
	ИначеЕсли Кат>=24 тогда
		Возврат "23:00-24:00";
	иначе
		Начало=?(Кат-1<10,"0"+Строка(Кат-1),Строка(Кат-1));
		Окончание=?(Кат<10,"0"+Строка(Кат),Строка(Кат));
		Возврат Начало+":00-"+Окончание+":00";
	КонецЕсли;
	
