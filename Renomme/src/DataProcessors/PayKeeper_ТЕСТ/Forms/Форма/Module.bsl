&НаСервере
Процедура СвязатьОплатыДолгиНаСервере()
Запрос = Новый Запрос("ВЫБРАТЬ
                      |	PayKeeperПлатежи.ИД_Платежа КАК ИД_Платежа,
                      |	PayKeeperПлатежи.ГУИД КАК ГУИД,
                      |	PayKeeperПлатежи.Плательщик КАК Плательщик,
                      |	PayKeeperПлатежи.НомерСчета КАК НомерСчета,
                      |	PayKeeperПлатежи.Сумма КАК Сумма,
                      |	PayKeeperПлатежи.Статус КАК Статус,
                      |	PayKeeperПлатежи.ДатаСоздания КАК ДатаСоздания,
                      |	PayKeeperПлатежи.ДатаОплаты КАК ДатаОплаты,
                      |	PayKeeperПлатежи.Отменено КАК Отменено,
                      |	PayKeeperПлатежи.Организация КАК Организация,
                      |	PayKeeperПлатежи.ПолучательПлатежа КАК ПолучательПлатежа,
                      |	PayKeeperПлатежи.СуммаЧехов КАК СуммаЧехов,
                      |	PayKeeperПлатежи.СуммаЛайв КАК СуммаЛайв,
                      |	PayKeeperПлатежи.СуммаДомСоветов КАК СуммаДомСоветов,
                      |	PayKeeperПлатежи.СуммаРеноме КАК СуммаРеноме,
                      |	PayKeeperПлатежи.СуммаСтритАрт КАК СуммаСтритАрт
                      |ИЗ
                      |	РегистрСведений.PayKeeperПлатежи КАК PayKeeperПлатежи");

ТЗ = Запрос.Выполнить().Выгрузить();

Для Каждого Строка Из ТЗ Цикл
	Если Строка.Статус <> "success" Тогда Продолжить; КонецЕсли;
	
	PayKeeperСервер.СвязатьPayKeeperПлатежи(Строка.ИД_Платежа);	
КонецЦикла;

КонецПроцедуры

