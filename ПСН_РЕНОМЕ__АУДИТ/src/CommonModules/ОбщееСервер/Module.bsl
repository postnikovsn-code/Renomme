// Из ЗаявкаНаБронирование ФормаДокумента и ФормаСписка
Функция ПолучитьПредставлениеКлиента(Клиент) Экспорт 
	
	Если Клиент.ТипКлиента=Перечисления.ТипыКлиентов.ЮрЛицо тогда
		НаименованиеЮрЛица = ?(ЗначениеЗаполнено(Клиент.НаименованиеЮрЛица), Клиент.НаименованиеЮрЛица, Клиент.Наименование);  
		Возврат НаименованиеЮрЛица + ". ИНН " + Формат(Клиент.ИНН, "ЧГ=") + ?(ЗначениеЗаполнено(Клиент.КПП), ", КПП " + Клиент.КПП, "")
			+ ?(ЗначениеЗаполнено(Клиент.Адрес), ", " + Клиент.Адрес, "");
	иначе
		Возврат Клиент.Наименование;
	КонецЕсли;
	
КонецФункции

