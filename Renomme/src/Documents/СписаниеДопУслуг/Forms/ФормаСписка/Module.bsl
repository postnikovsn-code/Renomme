
&НаСервереБезКонтекста
Процедура СписокПриПолученииДанныхНаСервере(ИмяЭлемента, Настройки, Строки)
Ключи = Строки.ПолучитьКлючи();
Для Каждого Ключ Из Ключи Цикл
	ТЗ = Документы.СписаниеДопУслуг.ПолучитьДокументыКСписанию(Ключ.РезервСОтбор, Ключ.РезервПоОтбор, Ложь, Неопределено);
	СтрокаСписка = Строки[Ключ];
	СтрокаСписка.Данные["СуммаКСписанию"] = ТЗ.Итог("ОстатокДолг");
	СтрокаСписка.Данные["СуммаСписано"] = ТЗ.Итог("СуммаСписано");
КонецЦикла;
КонецПроцедуры
