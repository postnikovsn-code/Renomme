&НаКлиенте
Процедура ОткрытьФормаВыбораОстаткиОплаты(ОтмененныйДокументДолг, ОплатаОтВсехКонтрагентов, СчетаТекущаяСтрока)
Если ЭтотОбъектЗаписатьНаКлиенте() Тогда Возврат; КонецЕсли;	
	
ПараметрыФормы = Новый Структура;
ПараметрыФормы.Вставить("ТолькоПросмотр", Истина);

Результат = ПолучитьДанныеКОплате_Выбор(СчетаТекущаяСтрока);

Если ОплатаОтВсехКонтрагентов Тогда
	СписокКонтрагентов = Новый СписокЗначений;
Иначе
	СписокКонтрагентов = Результат.СписокКонтрагентов;
	Если СписокКонтрагентов.Количество() = 0 Тогда ЭтаФорма.Модифицированность = Ложь; Возврат; КонецЕсли; 
КонецЕсли;
ПараметрыФормы.Вставить("СписокКонтрагентов", СписокКонтрагентов);

ПараметрыФормы.Вставить("ОтмененныйДокументДолг", ОтмененныйДокументДолг);

СуммаКОплате = Результат.СуммаКЗакрытию; 
Если СуммаКОплате = 0 Тогда ЭтаФорма.Модифицированность = Ложь; Возврат; КонецЕсли; 
ПараметрыФормы.Вставить("СуммаКОплате", СуммаКОплате);

ДопПараметры = Новый Структура;

Если СчетаТекущаяСтрока = Неопределено Тогда
	СчетГУИД = Неопределено;
Иначе
	ТД = Объект.Счета.НайтиПоИдентификатору(СчетаТекущаяСтрока);
	СчетГУИД = ТД.СчетГУИД;
КонецЕсли;
ДопПараметры.Вставить("СчетГУИД", СчетГУИД);

ОписаниеОповещения = Новый ОписаниеОповещения("ЗакрытиеФормы_ФормаВыбораОплатыОстатки", ЭтаФорма, ДопПараметры);
	
ОткрытьФорму("Документ.КассовыйДокумент.Форма.ФормаВыбораОстаткиОплаты", ПараметрыФормы, ЭтаФорма 
	,,,,ОписаниеОповещения, РежимОткрытияОкнаФормы.БлокироватьВесьИнтерфейс);
КонецПроцедуры

&НаСервере
Функция ПолучитьДанныеКОплате_Выбор(СчетаТекущаяСтрока)
ТЗ = Новый ТаблицаЗначений;	
ТЗ.Колонки.Добавить("Контрагент");

Если СчетаТекущаяСтрока = Неопределено Тогда 
	Счета = Объект.Счета;
Иначе
	Счета = Новый Массив;
	Счет = Объект.Счета.НайтиПоИдентификатору(СчетаТекущаяСтрока);
	Счета.Добавить(Счет);
КонецЕсли;

СуммаКЗакрытию = 0;
//Для Каждого Счет Из Объект.Счета Цикл
Для Каждого Счет Из Счета Цикл
	Если ЗначениеЗаполнено(Счет.ГрупповойСчет) Тогда Продолжить; КонецЕсли;
	Если Счет.ЭтоПредварительныйГрупповойСчет Тогда Продолжить; КонецЕсли;
	
	НоваяСтрока = ТЗ.Добавить();
	НоваяСтрока.Контрагент = Счет.Контрагент;
	
	ОтборСтроки = Новый Структура("СчетГУИД", Счет.СчетГУИД);
	НайденныеСтроки = Объект.СчетаДетальноДолги.НайтиСтроки(ОтборСтроки);

	Для Каждого НайденнаяСтрока	Из НайденныеСтроки Цикл 
		СуммаКЗакрытию = СуммаКЗакрытию + НайденнаяСтрока.СуммаКЗакрытию;	
	КонецЦикла;	
КонецЦикла;	

ТЗ.Свернуть("Контрагент");

СписокКонтрагентов = Новый СписокЗначений;
Для Каждого Строка Из ТЗ Цикл
	СписокКонтрагентов.Добавить(Строка.Контрагент);	
КонецЦикла;

Результат = Новый Структура("СписокКонтрагентов, СуммаКЗакрытию", СписокКонтрагентов, СуммаКЗакрытию); 
Возврат Результат;
КонецФункции	

&НаКлиенте
Процедура ЗакрытиеФормы_ФормаВыбораОплатыОстатки(Результат, ДополнительныеПараметры) Экспорт
Если НЕ ЗначениеЗаполнено(Результат) Тогда Возврат; КонецЕсли;

ДобавитьОплатаКассаНаСервере(Результат, ДополнительныеПараметры);

//ОбновитьИсториюОплат();
//ОбновитьСумму();
КонецПроцедуры

&НаСервере
Процедура ДобавитьОплатаКассаНаСервере(ДокументОплаты, ДополнительныеПараметры)
НачатьТранзакцию();

ОстатокКРаспределению = ОплатыОбщееСервер.ОплатаОстатокКРаспределениюКасса(ДокументОплаты, Объект);

СтрокаОплаты = ЗаявкаСервер.ДобавитьОплатаСчетаДетальноОплаты(Объект.СчетаДетальноОплаты, ДокументОплаты, Ложь); 

Если ДополнительныеПараметры.СчетГУИД = Неопределено Тогда
	Контрагент = СтрокаОплаты.ДокументОплаты.ОтКого;	
	ОтборСтроки = Новый Структура("Контрагент", Контрагент);
	СчетаКоплате = Объект.Счета.НайтиСтроки(ОтборСтроки);
Иначе	
	СчетаКоплате = Новый Массив;
	ОтборСтроки = Новый Структура("СчетГУИД", ДополнительныеПараметры.СчетГУИД);
	НайденныеСтроки = Объект.Счета.НайтиСтроки(ОтборСтроки);
	СчетаКоплате.Добавить(НайденныеСтроки[0]);
КонецЕсли;

Для Каждого Счет Из СчетаКоплате Цикл
	Если ЗначениеЗаполнено(Счет.ГрупповойСчет) Тогда Продолжить; КонецЕсли;
	Если Счет.ЭтоПредварительныйГрупповойСчет Тогда Продолжить; КонецЕсли;
	
	РаспределитьСтрокаОплатыНаСчет(СтрокаОплаты, ОстатокКРаспределению, Счет.СчетГУИД); 
	
	//Строка.Закрыт = ОбщийМодульОплатыСервер.СчетЗакрыт(СчетаДетальноДолги, Строка.СчетГУИД);
	
	Если ОстатокКРаспределению = 0 Тогда Прервать; КонецЕсли;	
КонецЦикла;	

ЭтаФорма.Записать(Новый Структура("РежимЗаписи", РежимЗаписиДокумента.Проведение));
ЗафиксироватьТранзакцию();
КонецПроцедуры
// - Добавить отменененные
//// - Добавить Касса 


////// - Наличные


//// + Безнал

// + Безнал Оплата добавить
&НаКлиенте
Процедура ДобавитьОплатаБезнал(Команда)
Если НЕ ЭтаФорма.Записать(Новый Структура("РежимЗаписи", РежимЗаписиДокумента.Проведение)) Тогда Возврат; КонецЕсли;
	
ПараметрыФормы = Новый Структура();

Если НЕ ЗначениеЗаполнено(Объект.Оплачивает) Тогда 
	ПоказатьПредупреждение(, "Оплачивает - пусто ...");
	
	Возврат; 
КонецЕсли;
	
СписокКонтрагентыЗаявка = Новый СписокЗначений;
СписокКонтрагентыЗаявка.Добавить(Объект.Оплачивает);

ПараметрыФормы.Вставить("ОтКого", СписокКонтрагентыЗаявка);
ПараметрыФормы.Вставить("КонтрагентТолькоПросмотр", Истина);

СуммаКЗакрытию = 0;
Для Каждого Счет Из Объект.Счета Цикл
	Если ЗначениеЗаполнено(Счет.ГрупповойСчет) Тогда Продолжить; КонецЕсли;
	Если Счет.ЭтоПредварительныйГрупповойСчет Тогда Продолжить; КонецЕсли;
	
	Если Счет.Контрагент <> Объект.Оплачивает Тогда Продолжить; КонецЕсли;
	
	ОтборСтроки = Новый Структура("СчетГУИД", Счет.СчетГУИД);
	СчетаДетальноДолги = Объект.СчетаДетальноДолги.НайтиСтроки(ОтборСтроки);	
	Для Каждого СтрокаДолг Из СчетаДетальноДолги Цикл
		СуммаКЗакрытию = СуммаКЗакрытию + СтрокаДолг.СуммаКЗакрытию;	
	КонецЦикла;
КонецЦикла;
СуммаКОплатеЗаявка = СуммаКЗакрытию;

Если СуммаКОплатеЗаявка <= 0 Тогда ЭтаФорма.Модифицированность = Ложь; Возврат; КонецЕсли;
ПараметрыФормы.Вставить("СуммаКОплате", СуммаКОплатеЗаявка);

ДопПараметры = Новый Структура();
ДопПараметры.Вставить("СуммаКОплатеЗаявка", СуммаКОплатеЗаявка);

Оповещение = Новый ОписаниеОповещения("ЗавершениеФормаВыбораОплата_ОплатаБезнал", ЭтаФорма, ДопПараметры);
ОткрытьФорму("Документ.ВыпискаБанка.Форма.ФормаВыбораОплата", ПараметрыФормы , ЭтаФорма
	,,,, Оповещение, РежимОткрытияОкнаФормы .БлокироватьОкноВладельца);
КонецПроцедуры

&НаКлиенте
Процедура ЗавершениеФормаВыбораОплата_ОплатаБезнал(Результат, ДополнительныеПараметры) Экспорт
Если Результат = Неопределено Тогда Возврат; КонецЕсли;

ДокументОплаты = Результат;
СуммаКОплатеЗаявка = ДополнительныеПараметры.СуммаКОплатеЗаявка;

ДобавитьОплатаБезналНаСервере_ОплатаБезнал(ДокументОплаты, СуммаКОплатеЗаявка);

ЭтаФорма.Прочитать();
//ОбновитьИсториюОплат();
//ОбновитьСумму();
Конецпроцедуры

&НаСервере
Процедура ДобавитьОплатаБезналНаСервере_ОплатаБезнал(ДокументОплаты, СуммаКОплатеЗаявка) Экспорт
НачатьТранзакцию();	
	
СуммаКРаспределению = ДокументОплаты.Сумма - ДокументОплаты.ДолгиОплата.Итог("Сумма");

Если СуммаКРаспределению > СуммаКОплатеЗаявка Тогда
	СуммаОплаты = СуммаКОплатеЗаявка;
Иначе
	СуммаОплаты = СуммаКРаспределению;
КонецЕсли;

СтрокаОплата = ЗаявкаСервер.ДобавитьОплатаСчетаДетальноОплаты(Объект.СчетаДетальноОплаты, ДокументОплаты, Ложь);  

ОтборСтроки = Новый Структура("Контрагент", ДокументОплаты.ОтКого);
НайденныеСчета = Объект.Счета.НайтиСтроки(ОтборСтроки);

Для Каждого Счет Из НайденныеСчета Цикл
	Если ЗначениеЗаполнено(Счет.ГрупповойСчет) Тогда Продолжить; КонецЕсли;
	Если Счет.ЭтоПредварительныйГрупповойСчет Тогда Продолжить; КонецЕсли;
	
	РаспределитьСтрокаОплатыНаСчет(СтрокаОплата, СуммаОплаты, Счет.СчетГУИД);
	
	Если СуммаОплаты = 0 Тогда Прервать; КонецЕсли;
КонецЦикла;

ЭтаФорма.Записать(Новый Структура("РежимЗаписи", РежимЗаписиДокумента.Проведение));
ЗафиксироватьТранзакцию();	
КонецПроцедуры
// - Безнал Оплата добавить


// + Безнал Счет добавить
&НаКлиенте
Процедура БезналСчет(Команда)
Если НЕ ЭтаФорма.Записать(Новый Структура("РежимЗаписи", РежимЗаписиДокумента.Проведение)) Тогда Возврат; КонецЕсли;
	
ТС = Элементы.Счета.ТекущаяСтрока;
Если ТС = Неопределено Тогда Возврат; КонецЕсли;	

ТД = Объект.Счета.НайтиПоИдентификатору(ТС);

//Если НЕ КлиентыСервер.ЭтоЮрЛицо(ТД.Контрагент) Тогда 	
//	ПоказатьПредупреждение(,"Счет выписан на Физ. лицо"	
//		+ Символы.ПС + Символы.ПС + "ОПЛАТА БЕЗНАЛОМ НЕ РАЗРЕШЕНА ...");		
//		
//	ЭтаФорма.Модифицированность = Ложь;    
//	Возврат;
//КонецЕсли;

Если ЗначениеЗаполнено(ТД.ГрупповойСчет) Тогда 
	ПоказатьПредупреждение(, "Групповой Счет
							|
							|ПРЯМАЯ ОПЛАТА НЕ РАЗРЕШЕНА ...");
	
	ЭтаФорма.Модифицированность = Ложь;
	Возврат;
КонецЕсли;

Если ТД.ЭтоПредварительныйГрупповойСчет Тогда 
	ПоказатьПредупреждение(, "Предварительный Групповой Счет
							|
							|ПРЯМАЯ ОПЛАТА НЕ РАЗРЕШЕНА ...");
	
	ЭтаФорма.Модифицированность = Ложь;
	Возврат;
КонецЕсли;

Контрагент = ТД.Контрагент;

ПараметрыФормы = Новый Структура();

СписокКонтрагентыЗаявка = Новый СписокЗначений; 
СписокКонтрагентыЗаявка.Добавить(Контрагент);
ПараметрыФормы.Вставить("ОтКого", СписокКонтрагентыЗаявка);

ПараметрыФормы.Вставить("КонтрагентТолькоПросмотр", Ложь);

СуммаКЗакрытию = 0;
ОтборСтроки = Новый Структура("СчетГУИД", ТД.СчетГУИД);
СчетаДетальноДолги = Объект.СчетаДетальноДолги.НайтиСтроки(ОтборСтроки);	
Для Каждого СтрокаДолг Из СчетаДетальноДолги Цикл
	СуммаКЗакрытию = СуммаКЗакрытию + СтрокаДолг.СуммаКЗакрытию;	
КонецЦикла;
СуммаКОплатеСчет = СуммаКЗакрытию;

Если СуммаКОплатеСчет <= 0 Тогда ЭтаФорма.Модифицированность = Ложь; Возврат; КонецЕсли;

ПараметрыФормы.Вставить("СуммаКОплате", СуммаКОплатеСчет);

ДопПараметры = Новый Структура();
ДопПараметры.Вставить("СуммаКОплатеСчет", СуммаКОплатеСчет);
ДопПараметры.Вставить("СчетГУИД", ТД.СчетГУИД);

Оповещение = Новый ОписаниеОповещения("ЗавершениеФормаВыбораОплата_БезналСчет", ЭтаФорма, ДопПараметры);
ОткрытьФорму("Документ.ВыпискаБанка.Форма.ФормаВыбораОплата", ПараметрыФормы , ЭтаФорма
	,,,, Оповещение, РежимОткрытияОкнаФормы .БлокироватьОкноВладельца);
КонецПроцедуры

&НаКлиенте
Процедура ЗавершениеФормаВыбораОплата_БезналСчет(Результат, ДополнительныеПараметры) Экспорт
Если Результат = Неопределено Тогда Возврат; КонецЕсли;

ДокументОплаты = Результат;
СуммаКОплатеСчет = ДополнительныеПараметры.СуммаКОплатеСчет; 
СчетГУИД = ДополнительныеПараметры.СчетГУИД; 

ДобавитьОплатаБезналНаСервере_БезналСчет(ДокументОплаты, СчетГУИД, СуммаКОплатеСчет);

ЭтаФорма.Прочитать();
//ОбновитьИсториюОплат();
//ОбновитьСумму();
Конецпроцедуры

&НаСервере
Процедура ДобавитьОплатаБезналНаСервере_БезналСчет(ДокументОплаты, СчетГУИД, СуммаКОплате) Экспорт
НачатьТранзакцию();	

ОстатокКРаспределению = ОплатыОбщееСервер.ОплатаОстатокКРаспределениюВыписка(ДокументОплаты, Объект);

Если СуммаКОплате > ОстатокКРаспределению Тогда
	СуммаОплаты = ОстатокКРаспределению;
Иначе
	СуммаОплаты = СуммаКОплате;
КонецЕсли;  

СтрокаОплаты = ЗаявкаСервер.ДобавитьОплатаСчетаДетальноОплаты(Объект.СчетаДетальноОплаты, ДокументОплаты, Ложь);

РаспределитьСтрокаОплатыНаСчет(СтрокаОплаты, СуммаОплаты, СчетГУИД);

ЭтаФорма.Записать(Новый Структура("РежимЗаписи", РежимЗаписиДокумента.Проведение));
ЗафиксироватьТранзакцию();	
КонецПроцедуры
// - Безнал Счет добавить

