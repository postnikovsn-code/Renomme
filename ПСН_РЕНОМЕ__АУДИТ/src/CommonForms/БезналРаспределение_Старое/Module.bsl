                      |			КОГДА &ДатаСчетаС = ДАТАВРЕМЯ(1, 1, 1, 0, 0, 0)
                      |				ТОГДА ИСТИНА
                      |			ИНАЧЕ КоворкингСчета.Дата >= &ДатаСчетаС
                      |		КОНЕЦ
                      |	И ВЫБОР
                      |			КОГДА &ДатаСчетаПо = ДАТАВРЕМЯ(1, 1, 1, 0, 0, 0)
                      |				ТОГДА ИСТИНА
                      |			ИНАЧЕ КоворкингСчета.Дата <= &ДатаСчетаПо
                      |		КОНЕЦ
                      |	И ВЫБОР
                      |			КОГДА КоворкингСчета.ОплачиваетСчет = ЗНАЧЕНИЕ(Справочник.Клиенты.ПустаяСсылка)
                      |				ТОГДА ВЫБОР
                      |						КОГДА КоворкингСчета.КоворкингЗаявка.Оплачивает = ЗНАЧЕНИЕ(Справочник.Клиенты.ПустаяСсылка)
                      |							ТОГДА КоворкингСчета.КоворкингЗаявка.Клиент
                      |						ИНАЧЕ КоворкингСчета.КоворкингЗаявка.Оплачивает
                      |					КОНЕЦ
                      |			ИНАЧЕ КоворкингСчета.ОплачиваетСчет
                      |		КОНЕЦ = &Контрагент");

					  //|	ВЫБОР
					  //|		КОГДА КоворкингСчета.КоворкингЗаявка.Оплачивает = ЗНАЧЕНИЕ(Справочник.Клиенты.ПустаяСсылка)
					  //|			ТОГДА КоворкингСчета.КоворкингЗаявка.Клиент
					  //|		ИНАЧЕ КоворкингСчета.КоворкингЗаявка.Оплачивает
					  //|	КОНЕЦ КАК Контрагент,


Запрос.УстановитьПараметр("ДатаСчетаС", ВыпискаДатаСчетаС);
Запрос.УстановитьПараметр("ДатаСчетаПо", ВыпискаДатаСчетаПо);
