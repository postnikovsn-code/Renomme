	//КонецЕсли;		
	
	// Проверить, нужен ли перенос данных. Если нет, то записать удаление этих данных.
	//Если Не ВГ_ОбменВыписка.НуженПереносДанных(ЗаписьСообщения.Получатель, Данные) Тогда
	//	ВГ_ОбменВыписка.УдалениеДанных(Данные);
	//КонецЕсли;  
	
	// Записать данные в сообщение *** XML-сериализация.
	//ОбменГостиницы.ЗаписатьДанные(ЗаписьXML, Данные);	 
	
	ЗаписатьXML(ЗаписьXML, Данные);
КонецЦикла;

ЗаписьСообщения.ЗакончитьЗапись();
ЗаписьXML.Закрыть();

// Получить имя файла обмена.
//ИмяФайлаФТП = ОбменГостиницы.ПолучитьИмяФайлаОбменаФТП(ПланыОбмена.ВГ_ВыпискаГостиницы.ЭтотУзел(), Ссылка, ДанныеУзлаОбмена.КаталогОбменаFTP);

//Результат = ОбщийМодульФТП.ЗаписатьФТПФайл(ИмяФайла, ИмяФайлаФТП
//	, ДанныеУзлаОбмена.АдресФТП, ДанныеУзлаОбмена.ИмяПользователя, ДанныеУзлаОбмена.Пароль); 
Результат = ФТПСервер.ЗаписатьФТПФайл_TECT(ИмяФайла, "C:\_Base1C\ОбменТест.xml"); 

Если Результат.ЕстьОшибки Тогда 
