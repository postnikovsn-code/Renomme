&НаКлиенте
Процедура СканироватьРазворотПаспорта_Команда(Команда)
	СканироватьРазворотПаспортаНаСервере();
КонецПроцедуры

&НаСервере
Процедура СканироватьРазворотПаспортаНаСервере()
	Объект.ТипДокументаФМС_NEW = Справочники.ТипДокументаФМС_NEW.НайтиПоРеквизиту("ID", 103008);

	Результат = PassportBoxВызовСервера.ПолучитьРазворот23();
	Если Результат.Ошибка Тогда
		Сообщить(Результат.Описание);
		Возврат;
	КонецЕсли;

	Реквизиты = Результат.Реквизиты;
	Объект.Фамилия          = Реквизиты.Фамилия;
	Объект.Имя              = Реквизиты.Имя;
	Объект.Отчество         = Реквизиты.Отчество;
	Объект.Серия            = Реквизиты.Серия;
	Объект.Номер            = Реквизиты.Номер;
	Объект.КодОргана        = Реквизиты.КодПодразделения;
	Объект.КемВыдан         = Реквизиты.НазваниеПодразделения;
	Объект.ДатаВыдачи       = PassportBoxВызовСервера.СтрокаВДату(Реквизиты.ДатаВыдачи);
	Объект.ДатаРождения     = PassportBoxВызовСервера.СтрокаВДату(Реквизиты.ДатаРождения);
	Объект.РождениеНасПункт = Реквизиты.МестоРождения;
	Объект.Пол              = PassportBoxВызовСервера_Переопределяемый.Пол_СтрокуВПеречисление(Реквизиты.Пол);
	// Привязка к справочникам ФМС.
	// "CODE_0" — имя реквизита справочника ПунктыВыдачиФМС_NEW (синоним «Код ФМС»).
	Объект.ГражданствоФМС_NEW  = Справочники.СтраныФМС_NEW.НайтиПоКоду("000000046");
	Объект.ПунктыВыдачиФМС_NEW = Справочники.ПунктыВыдачиФМС_NEW.НайтиПоРеквизиту(
		"CODE_0", Реквизиты.КодПодразделения);
	// Реквизиты.МашинноЧитаемаяЗона — нет соответствия в справочнике Клиенты, пропущено.

	// Обновляем ФИО и Наименование.
	ФИО = СокрЛП(СокрЛП(Объект.Фамилия) + " " + СокрЛП(Объект.Имя) + " " + СокрЛП(Объект.Отчество));
	Объект.ФИО          = ФИО;
	Объект.Наименование = ФИО;

	// Сохраняем 2 и 3 страницы как сканы.
	//СохранитьСканКакФайл(Результат.Фотографии.Страница2, "passport_main_p2");
	СохранитьСканКакФайл(Результат.Фотографии.Страница3, "passport_main_p3", "Третья страница");
	ОбновитьОтображениеТекущегоСкана();
КонецПроцедуры

&НаКлиенте
Процедура СканироватьРегистрациюПаспорта_Команда(Команда)
	СканироватьРегистрациюПаспортаНаСервере();
КонецПроцедуры

&НаСервере
Процедура СканироватьРегистрациюПаспортаНаСервере()
	Результат = PassportBoxВызовСервера.ПолучитьРегистрацию();
	Если Результат.Ошибка Тогда
		Сообщить(Результат.Описание);
		Возврат;
	КонецЕсли;

	Реквизиты = Результат.Реквизиты;
	Объект.ПроживаниеРегион_NEW = Реквизиты.Регион;
	Объект.ПроживаниеГород      = Реквизиты.Город;
	Объект.ПроживаниеУлица      = Реквизиты.Улица;
	Объект.ПроживаниеДом        = Реквизиты.Дом;
	Объект.ПроживаниеКорпус     = Реквизиты.Корпус;
	Объект.ПроживаниеКвартира   = Реквизиты.Квартира;
	Объект.ДатаПропискиС        = PassportBoxВызовСервера.СтрокаВДату(Реквизиты.ДатаРегистрации);
	// Реквизиты.КодПодразделения, Реквизиты.НазваниеПодразделения — нет соответствия (отдельных полей
	//   «кем выдан штамп регистрации» в справочнике Клиенты не предусмотрено), пропущено.

	СохранитьСканКакФайл(Результат.Фотографии.Регистрация, "passport_registration", "Штамп регистрации");
	ОбновитьОтображениеТекущегоСкана();
КонецПроцедуры

&НаСервере
Процедура СохранитьСканКакФайл(ДанныеКартинки, Префикс, Комментарий)
	// Сохраняет ДвоичныеДанные картинки в КаталогФото и добавляет запись в Объект.СканыДокументов.
	// Имя файла формируется как <Префикс>_<ггггММддЧЧммсс>.jpg.
	Если ДанныеКартинки = Неопределено Тогда Возврат; КонецЕсли;
	Если НЕ ЗначениеЗаполнено(КаталогФото) Тогда
		Сообщить("Не задан каталог сканов; запись пропущена.");
		Возврат;
	КонецЕсли;
	Метка = Формат(ТекущаяДатаСеанса(), "ДФ=ггггММддЧЧммсс");
	ОтносительноеИмя = Префикс + "_" + Метка + ".jpg";
	ПолноеИмя = КаталогФото + ОтносительноеИмя;
	Попытка
		ДанныеКартинки.Записать(ПолноеИмя);
	Исключение
		Сообщить("Не удалось сохранить скан " + ПолноеИмя + ": " + ОписаниеОшибки());
		Возврат;
	КонецПопытки;
	НоваяСтрока = Объект.СканыДокументов.Добавить();
	НоваяСтрока.ПутьДоФото  = ОтносительноеИмя;
	НоваяСтрока.Комментарий = Комментарий;
КонецПроцедуры

&НаСервере
Процедура ОбновитьОтображениеТекущегоСкана()
	// После добавления новых сканов показываем последний из них в Фото_1.
	Если Объект.СканыДокументов.Количество() = 0 Тогда Возврат; КонецЕсли;
	ТекФото = Объект.СканыДокументов.Количество() - 1;
	ПутьДоФото = КаталогФото + Объект.СканыДокументов[ТекФото].ПутьДоФото;
	Если НЕ ПоказатьКартинку(ПутьДоФото, Фото_1) Тогда
		ПоказатьКартинку(ПутьДоФото, Фото_2);
	КонецЕсли;
КонецПроцедуры





