
//
&НаКлиенте
Процедура ОбновитьИНН(Команда)
	ОбновитьИНННаСервере();
КонецПроцедуры

&НаСервере
Процедура ОбновитьИНННаСервере()
Выборка = Справочники.Клиенты.Выбрать();
Пока Выборка.Следующий() Цикл
	Если Выборка.ЭтоГруппа Тогда Продолжить; КонецЕсли;	
		
	Если Выборка.ИНН = "" Тогда Продолжить; КонецЕсли;	
	
	КлиентОбъект = Выборка.Ссылка.ПолучитьОбъект();
	Если Выборка.ИНН = "0" Тогда 
		КлиентОбъект.ИНН = "";
	Иначе
		КлиентОбъект.ИНН = Выборка.ИНН;
		КлиентОбъект.ИНН = СтрЗаменить(КлиентОбъект.ИНН, Символы.НПП, "");
	КонецЕсли;
	
	Если Выборка.КПП = "0" Тогда 
		КлиентОбъект.КПП = "";
	Иначе
		КлиентОбъект.КПП = Выборка.КПП;
		КлиентОбъект.КПП = СтрЗаменить(КлиентОбъект.КПП, Символы.НПП, "");
	КонецЕсли;

	
	КлиентОбъект.Записать();
КонецЦикла;
КонецПроцедуры
