    <extInfo xsi:type="form:DynamicListExtInfo">
      <queryText>ВЫБРАТЬ
	РассылкаWhatsApp.ДатаРассылки КАК ДатаРассылки,
	РассылкаWhatsApp.Клиент КАК Клиент
ИЗ
	РегистрСведений.РассылкаWhatsApp КАК РассылкаWhatsApp
ГДЕ
	РассылкаWhatsApp.ДатаРассылки = &amp;ДатаРассылки
	И РассылкаWhatsApp.ТипРассылки = ЗНАЧЕНИЕ(Перечисление.ТипРассылкиWhatsApp.Сайт)</queryText>
      <autoFillAvailableFields>true</autoFillAvailableFields>
      <customQuery>true</customQuery>
      <autoSaveUserSettings>true</autoSaveUserSettings>
      <getInvisibleFieldPresentations>true</getInvisibleFieldPresentations>
    </extInfo>
