&НаКлиенте
Процедура ОтКогоПриИзменении(Элемент)
ОтКого_OldValue = ОбщийФункционалСервер.ЗначениеРеквизитаНаСервере(Объект.Ссылка, "ОтКого"); 
Если ЕстьДолгиОплатаПредупреждение() Тогда 
	Объект.ОтКого = ОтКого_OldValue;

	Возврат;
КонецЕсли;

Если Объект.ОтКого <> ОтКого_OldValue Тогда 
	Объект.ДокументДолг = Неопределено;
КонецЕсли;
КонецПроцедуры

&НаКлиенте
Функция ЕстьДолгиОплатаПредупреждение()
Если Объект.ДолгиОплата.Количество() > 0 Тогда
	ТекстПредупреждения = "Есть документы долги, связанные с оплатой
						|
						|ИЗМЕНЕНИЕ НЕ РАЗРЕШЕНО ...";
	ПоказатьПредупреждение(, ТекстПредупреждения);
	
	Возврат Истина;
КонецЕсли;	

Возврат Ложь;
КонецФункции
