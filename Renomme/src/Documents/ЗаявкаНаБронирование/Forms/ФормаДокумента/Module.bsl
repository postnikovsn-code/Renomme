&НаКлиенте
Процедура ЧекСчет_1(Команда)
ТекущиеДанные = Элементы.Счета.ТекущиеДанные;
Если ТекущиеДанные = Неопределено Тогда Возврат; КонецЕсли;

Контрагент = ТекущиеДанные.Контрагент; 

Если КлиентыСервер.ЭтоЮрЛицо(Контрагент) Тогда 	
	ПоказатьПредупреждение(,"Счет выписан на юр. лицо"	
		+ Символы.ПС + Символы.ПС + "ОПЛАТА НАЛИЧНЫМИ НЕ РАЗРЕШЕНА ...");		
		
	Возврат;
КонецЕсли;

Если ЗначениеЗаполнено(ТекущиеДанные.ГрупповойСчет) Тогда 
	ПоказатьПредупреждение(, "Групповой Счет
							|
							|ПРЯМАЯ ОПЛАТА НЕ РАЗРЕШЕНА ...");
	
	ЭтаФорма.Модифицированность = Ложь;
	Возврат;
КонецЕсли;       

Если ТекущиеДанные.ЭтоПредварительныйГрупповойСчет Тогда 	
	ПоказатьПредупреждение(,"Предварительный счет для группового счета"	
		+ Символы.ПС + Символы.ПС + "ПРЯМАЯ ОПЛАТА НЕ РАЗРЕШЕНА ...");		
		
	Возврат;
КонецЕсли;

Счет = Объект.Счета.НайтиПоИдентификатору(Элементы.Счета.ТекущаяСтрока);

Если ОплатыОбщееСервер.ЕстьОстаткиОплатКассаКонтрагент(Контрагент) Тогда
	ДопПараметры = Новый Структура;
	ДопПараметры.Вставить("Счет", Счет);
	ОписаниеОповещения = Новый ОписаниеОповещения("ЗавершитьВопрос_ЕстьКассовыеОстаткиОплат", ЭтаФорма, ДопПараметры);
	
	ПоказатьВопрос(ОписаниеОповещения, "Есть кассовые остатки оплат для контрагента
										|
										|ПРОДОЛЖИТЬ ФОРМИРОВАНИЕ ЧЕКА ?"
					, РежимДиалогаВопрос.ОКОтмена);
						
	Возврат;				
КонецЕсли;

ЧекСчетДействие(Счет);
КонецПроцедуры


&НаКлиенте
Процедура ЧекСчет(Команда)
ТекущиеДанные = Элементы.Счета.ТекущиеДанные;
Если ТекущиеДанные = Неопределено Тогда Возврат; КонецЕсли;

Контрагент = ТекущиеДанные.Контрагент; 

Если КлиентыСервер.ЭтоЮрЛицо(Контрагент) Тогда 
	Оповещение = Новый ОписаниеОповещения("ЗавершитьВопрос_ОплатуНаличнымиРазрешить", ЭтаФорма);
	ПоказатьВопрос(Оповещение,"ВНИМАНИЕ ! Счет выписан на юр. лицо"	
		+ Символы.ПС + Символы.ПС + "РАЗРЕШИТЬ ОПЛАТУ ...", РежимДиалогаВопрос.ОКОтмена);		
		
	Возврат;
КонецЕсли;

ЧекСчетПродолжить();
КонецПроцедуры

&НаКлиенте
Процедура ЗавершитьВопрос_ОплатуНаличнымиРазрешить(Результат, ДополнительныеПараметры) Экспорт
Если Результат = КодВозвратаДиалога.Отмена Тогда Возврат; КонецЕсли;
	
ЧекСчетПродолжить();
КонецПроцедуры


&НаКлиенте
Процедура ЧекСчетПродолжить()
ТекущиеДанные = Элементы.Счета.ТекущиеДанные;
Если ТекущиеДанные = Неопределено Тогда Возврат; КонецЕсли;

Контрагент = ТекущиеДанные.Контрагент; 

//Если КлиентыСервер.ЭтоЮрЛицо(Контрагент) Тогда 	
//	ПоказатьПредупреждение(,"Счет выписан на юр. лицо"	
//		+ Символы.ПС + Символы.ПС + "ОПЛАТА НАЛИЧНЫМИ НЕ РАЗРЕШЕНА ...");		
//		
//	Возврат;
//КонецЕсли;

Если ЗначениеЗаполнено(ТекущиеДанные.ГрупповойСчет) Тогда 
	ПоказатьПредупреждение(, "Групповой Счет
							|
							|ПРЯМАЯ ОПЛАТА НЕ РАЗРЕШЕНА ...");
	
	ЭтаФорма.Модифицированность = Ложь;
	Возврат;
КонецЕсли;       

Если ТекущиеДанные.ЭтоПредварительныйГрупповойСчет Тогда 	
	ПоказатьПредупреждение(,"Предварительный счет для группового счета"	
		+ Символы.ПС + Символы.ПС + "ПРЯМАЯ ОПЛАТА НЕ РАЗРЕШЕНА ...");		
		
	Возврат;
КонецЕсли;

Счет = Объект.Счета.НайтиПоИдентификатору(Элементы.Счета.ТекущаяСтрока);

Если ОплатыОбщееСервер.ЕстьОстаткиОплатКассаКонтрагент(Контрагент) Тогда
	ДопПараметры = Новый Структура;
	ДопПараметры.Вставить("Счет", Счет);
	ОписаниеОповещения = Новый ОписаниеОповещения("ЗавершитьВопрос_ЕстьКассовыеОстаткиОплат", ЭтаФорма, ДопПараметры);
	
	ПоказатьВопрос(ОписаниеОповещения, "Есть кассовые остатки оплат для контрагента
										|
										|ПРОДОЛЖИТЬ ФОРМИРОВАНИЕ ЧЕКА ?"
					, РежимДиалогаВопрос.ОКОтмена);
						
	Возврат;				
КонецЕсли;

ЧекСчетДействие(Счет);
КонецПроцедуры


&НаКлиенте
Процедура ЗавершитьВопрос_ЕстьКассовыеОстаткиОплат(Результат, ДополнительныеПараметры) Экспорт
Если Результат = КодВозвратаДиалога.Отмена Тогда Возврат; КонецЕсли;
	
ЧекСчетДействие(ДополнительныеПараметры.Счет);
КонецПроцедуры

&НаКлиенте
Процедура ЧекСчетДействие(Счет)
Если ЭтотОбъектЗаписатьНаКлиенте() Тогда Возврат; КонецЕсли;

ДопПараметры = Новый Структура;
ДопПараметры.Вставить("Счет", Счет);

ДопПараметры.Вставить("ДокументДолгОбъектДанные", Объект);  

ДопПараметрыОповещения = Новый Структура;
ОповещениеЗавершениеЧекОплаты = Новый ОписаниеОповещения("ОповещениеЗавершениеЧекОплаты", ЭтаФорма, ДопПараметрыОповещения);
ДопПараметры.Вставить("ОповещениеЗавершениеЧек", ОповещениеЗавершениеЧекОплаты);

ОплатыЧекКлиент.ЧекОплаты(ДопПараметры, ЭтаФорма);
КонецПроцедуры

&НаКлиенте
Процедура ОповещениеЗавершениеЧекОплаты(Результат, ДополнительныеПараметры) Экспорт
//////Если Результат = Неопределено Тогда Возврат; КонецЕсли;
	
//ЭтотОбъектЗаписатьНаКлиенте();

ЭтаФорма.Прочитать();
КонецПроцедуры	
// - Чек Счет

// + Чек Оплата
&НаКлиенте
Процедура ЧекОплаты(Команда)
Если ЭтотОбъектЗаписатьНаКлиенте() Тогда Возврат; КонецЕсли;	

СчетаКоличество	= Объект.Счета.Количество();	
Если СчетаКоличество = 0 Тогда 
	ПоказатьПредупреждение(,"Не выписано ни одного счета." 
		+ Символы.ПС + Символы.ПС + "Операция НЕ возможна");		
		
	Возврат;
ИначеЕсли СчетаКоличество > 1 Тогда 
	ПоказатьПредупреждение(,"Количество счетов > 1"	
		+ Символы.ПС + Символы.ПС + "Отбитие чека осуществляется из формы счета,
									|либо на закладке 'Счета'");		
		
	Возврат;
ИначеЕсли КлиентыСервер.ЭтоЮрЛицо(Объект.Счета[0].Контрагент) Тогда 	
	ПоказатьПредупреждение(,"Счет выписан на юр. лицо"	
		+ Символы.ПС + Символы.ПС + "Операция НЕ возможна");		
		
	Возврат;
КонецЕсли;  

Счет = Объект.Счета[0];
ЧекСчетДействие(Счет);
КонецПроцедуры
// - Чек Оплата

//// + Чек Аванс
&НаКлиенте
Процедура ЧекАванс(Команда)
Если ЭтотОбъектЗаписатьНаКлиенте() Тогда Возврат; КонецЕсли;	

КонтрагентыСписокЗначений = Новый СписокЗначений;

Если НЕ ЗначениеЗаполнено(Объект.Оплачивает) Тогда
	КонтрагентыСписокЗначений.Добавить(Объект.Клиент);
	Если Объект.РазделитьСчет И ЗначениеЗаполнено(Объект.Клиент2) Тогда 
		КонтрагентыСписокЗначений.Добавить(Объект.Клиент2);
	КонецЕсли;
Иначе	
	ЭтоЮрЛицо = КлиентыСервер.ЭтоЮрЛицо(Объект.Оплачивает);
	Если НЕ ЭтоЮрЛицо Тогда 
		КонтрагентыСписокЗначений.Добавить(Объект.Оплачивает);
	КонецЕсли;
	Если Объект.РазделитьСчет И ЗначениеЗаполнено(Объект.Клиент2) Тогда 
		Если КонтрагентыСписокЗначений.НайтиПоЗначению(Объект.Клиент) = Неопределено Тогда 
			КонтрагентыСписокЗначений.Добавить(Объект.Клиент);
		КонецЕсли;
		Если КонтрагентыСписокЗначений.НайтиПоЗначению(Объект.Клиент2) = Неопределено Тогда 
			КонтрагентыСписокЗначений.Добавить(Объект.Клиент2);
		КонецЕсли;
	Иначе
		Если КонтрагентыСписокЗначений.НайтиПоЗначению(Объект.Клиент) = Неопределено Тогда 
			КонтрагентыСписокЗначений.Добавить(Объект.Клиент);
		КонецЕсли;
	КонецЕсли;
КонецЕсли;

ДопПараметры = Новый Структура;
ДопПараметры.Вставить("КонтрагентыСписокЗначений", КонтрагентыСписокЗначений);

Оповещение = Новый ОписаниеОповещения("ЗавершениеФормаЧекАвансПараметры", ЭтаФорма);

ОткрытьФорму("ОбщаяФорма.ЧекАвансПараметры", ДопПараметры, ЭтаФорма
	,,,, Оповещение, РежимОткрытияОкнаФормы.БлокироватьВесьИнтерфейс);
КонецПроцедуры

