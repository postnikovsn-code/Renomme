&НаКлиенте
Функция ДатыПроверка()
Если НЕ ЗначениеЗаполнено(ДатаС) ИЛИ НЕ ЗначениеЗаполнено(ДатаПо) Тогда
	
	Возврат Истина;
КонецЕсли;	
	
Если НачалоМесяца(ДатаС) <> НачалоМесяца(ДатаПо) Тогда
	ПоказатьПредупреждение(, "Месяц Дата С <> Месяц Дата По");
	
	Возврат Истина;
КонецЕсли;	
	
Возврат Ложь;	
КонецФункции

