&НаКлиенте
Процедура ЗарплатаЭлемент_ПриИзменении(Элемент, ЭтоЗамена, ЭтоКоличество)
ТС = Элемент.Родитель.ТекущаяСтрока;		
ТД = Объект.Зарплата.НайтиПоИдентификатору(ТС);
//Зарплата
//123456789
ИмяЭлемента = Сред(Элемент.Имя, 9);
Индекс = СтрНайти(ИмяЭлемента, "_Э");
ИмяРеквизита = Сред(ИмяЭлемента, 1, Индекс - 1);  

Если ЭтоЗамена Тогда
	ТД[ИмяРеквизита + "_Р"] = ТД[ИмяРеквизита + "_Э"];
	ТД[ИмяРеквизита + "_Есть"] = Истина;
Иначе
	ТД[ИмяРеквизита + "_Р"] = ТД[ИмяРеквизита + "_Э"] - ТД[ИмяРеквизита];
КонецЕсли;

Если ЭтоКоличество Тогда
	Индекс = СтрНайти(ИмяЭлемента, "_");
	ИмяПоля = Сред(ИмяЭлемента, 1, Индекс);
	ИмяСумма = ИмяПоля + "Сумма";  
	ИмяЦена = ИмяПоля + "Цена";  
	
	//ТД[ИмяСумма] = ТД[ИмяРеквизита + "_Э"] * ЭтаФорма[ИмяЦена];
	ТД[ИмяСумма] = ТД[ИмяРеквизита + "_Э"] * Объект[ИмяЦена];
КонецЕсли;
КонецПроцедуры

