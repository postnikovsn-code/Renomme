ТабДок = Новый ТабличныйДокумент;	

ДатаС = Данные.ДатаС;
ДатаПо = Данные.ДатаПо;

МассивЛайв = Данные.МассивЛайв;
МассивРеноме = Данные.МассивРеноме;
МассивЧехов = Данные.МассивЧехов;
