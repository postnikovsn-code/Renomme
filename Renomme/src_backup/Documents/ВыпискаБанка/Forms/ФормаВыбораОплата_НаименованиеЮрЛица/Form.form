  <attributes>
    <name>Список</name>
    <id>1</id>
    <valueType>
      <types>DynamicList</types>
    </valueType>
    <view>
      <common>true</common>
    </view>
    <edit>
      <common>true</common>
    </edit>
    <main>true</main>
    <extInfo xsi:type="form:DynamicListExtInfo">
      <queryText>ВЫБРАТЬ
	ДокументВыпискаБанка.Ссылка КАК Ссылка,
	ДокументВыпискаБанка.Номер КАК Номер,
	ДокументВыпискаБанка.Дата КАК Дата,
	ДокументВыпискаБанка.Проведен КАК Проведен,
	ДокументВыпискаБанка.ОтКого КАК ОтКого,
	ВЫБОР
		КОГДА ДокументВыпискаБанка.ОтКого.ТипКлиента = ЗНАЧЕНИЕ(Перечисление.ТипыКлиентов.ЮрЛицо)
			ТОГДА ДокументВыпискаБанка.ОтКого.НаименованиеЮрЛица
		ИНАЧЕ ДокументВыпискаБанка.ОтКого.Наименование
	КОНЕЦ КАК ОтКогоНаименование,
	ДокументВыпискаБанка.ДатаОплаты КАК ДатаОплаты,
	ДокументВыпискаБанка.ТекстПлатежа КАК ТекстПлатежа,
	ДокументВыпискаБанка.Примечание КАК Примечание,
	ДокументВыпискаБанка.Сумма КАК СуммаДокумента,
	Возвраты.Сумма КАК СуммаВозврата,
	ЕСТЬNULL(СчетаКоворкинг.СуммаОплаты, 0) + ЕСТЬNULL(ЗаявкиРаспределение.СуммаОплаты, 0) КАК СуммаДолгиОплаты,
	ДокументВыпискаБанка.Сумма - ЕСТЬNULL(Возвраты.Сумма, 0) - ЕСТЬNULL(ЗаявкиРаспределение.СуммаОплаты, 0) - ЕСТЬNULL(СчетаКоворкинг.СуммаОплаты, 0) КАК ОстатокОплаты,
	СчетаКоворкинг.СуммаОплаты КАК СуммаОплаты
ИЗ
	Документ.ВыпискаБанка КАК ДокументВыпискаБанка
		ЛЕВОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
			ВыпискаБанка.ВозвратДокумент КАК ВозвратДокумент,
			СУММА(ВыпискаБанка.Сумма) КАК Сумма
		ИЗ
			Документ.ВыпискаБанка КАК ВыпискаБанка
		ГДЕ
			ВыпискаБанка.ПометкаУдаления = ЛОЖЬ
		
		СГРУППИРОВАТЬ ПО
			ВыпискаБанка.ВозвратДокумент) КАК Возвраты
		ПО ДокументВыпискаБанка.Ссылка = Возвраты.ВозвратДокумент
		ЛЕВОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
			ЗаявкаНаБронированиеРаспределениеОплатДолги.ДокументОплаты КАК ДокументОплаты,
			СУММА(ЗаявкаНаБронированиеРаспределениеОплатДолги.СуммаОплаты) КАК СуммаОплаты
		ИЗ
			Документ.ЗаявкаНаБронирование.РаспределениеОплатДолги КАК ЗаявкаНаБронированиеРаспределениеОплатДолги
		
		СГРУППИРОВАТЬ ПО
			ЗаявкаНаБронированиеРаспределениеОплатДолги.ДокументОплаты) КАК ЗаявкиРаспределение
		ПО ДокументВыпискаБанка.Ссылка = ЗаявкиРаспределение.ДокументОплаты
		ЛЕВОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
			КоворкингСчетаДокументыОплаты.ДокументОплаты КАК ДокументОплаты,
			СУММА(КоворкингСчетаДокументыОплаты.СуммаРаспределено) КАК СуммаОплаты
		ИЗ
			Документ.КоворкингСчета.ДокументыОплаты КАК КоворкингСчетаДокументыОплаты
		
		СГРУППИРОВАТЬ ПО
			КоворкингСчетаДокументыОплаты.ДокументОплаты) КАК СчетаКоворкинг
		ПО ДокументВыпискаБанка.Ссылка = СчетаКоворкинг.ДокументОплаты
ГДЕ
	ДокументВыпискаБанка.ПометкаУдаления = ЛОЖЬ
	И ДокументВыпискаБанка.Приход = ИСТИНА
	И ДокументВыпискаБанка.Сумма - ЕСТЬNULL(Возвраты.Сумма, 0) - ЕСТЬNULL(ЗаявкиРаспределение.СуммаОплаты, 0) - ЕСТЬNULL(СчетаКоворкинг.СуммаОплаты, 0) > 0
	И ВЫБОР
			КОГДА &amp;Все
				ТОГДА ИСТИНА
			ИНАЧЕ ДокументВыпискаБанка.ОтКого В (&amp;ОтКого)
		КОНЕЦ</queryText>
      <mainTable>Document.ВыпискаБанка</mainTable>
      <autoFillAvailableFields>true</autoFillAvailableFields>
      <customQuery>true</customQuery>
      <autoSaveUserSettings>true</autoSaveUserSettings>
      <getInvisibleFieldPresentations>true</getInvisibleFieldPresentations>
    </extInfo>
  </attributes>
