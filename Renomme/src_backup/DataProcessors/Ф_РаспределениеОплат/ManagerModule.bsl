Функция ВСписке(Значение, Имя, Список) 	
ВСписке = Ложь;	
Для Каждого Строка Из Список Цикл
	Если Строка[Имя] = Значение Тогда 
		ВСписке = Истина;	
		Прервать;
	КонецЕсли;
КонецЦикла;

Возврат ВСписке;
КонецФункции

Функция СуммаЭквайринга(СтрокаОплаты)
Если СтрокаОплаты.СуммаКарта > 0	Тогда
	СуммаЭквайринга = Окр(СтрокаОплаты.СуммаКарта * СтрокаОплаты.ПроцентЭквайринга / 100, 2); 	
Иначе
	СуммаЭквайринга = 0; 
КонецЕсли;

Возврат СуммаЭквайринга; 
КонецФункции	

Функция СуммаЭквайринга_1(Строка)
ТипОплаты = Строка.ТипОплаты;

Если ТипОплаты = 1	Тогда 
	Сумма = Строка.СуммаОплаты;
ИначеЕсли ТипОплаты = 0	Тогда 
	Сумма = Окр(Строка.СуммаОплаты * (Строка.СуммаКарта / Строка.СуммаДокументаОплаты), 2);
ИначеЕсли ТипОплаты = 3	Тогда 
	Если Строка.ЭтоЭквайринг Тогда
		Сумма = Строка.СуммаОплаты;
	Иначе
		Сумма = 0; 
	КонецЕсли;
Иначе
	Сумма = 0; 
КонецЕсли;

СуммаЭквайринга = Окр(Сумма * Строка.ПроцентЭквайринга / 100, 2);     

Возврат СуммаЭквайринга; 
КонецФункции	

Функция ТипОплатыНаименование(ТипОплаты)
Если ТипОплаты = 0 Тогда	
	Возврат "смеш.";
ИначеЕсли ТипОплаты = 1 Тогда	
	Возврат "к/к";
ИначеЕсли ТипОплаты = 2 Тогда	
	Возврат "нал";
ИначеЕсли ТипОплаты = 3 Тогда	
	Возврат "б/н";
ИначеЕсли ТипОплаты = 4 Тогда	
	Возврат "п/о";
КонецЕсли;

Возврат "";	
КонецФункции

Процедура ВерхняяПапка(Ссылка, Результат)
Если НЕ ЗначениеЗаполнено(Ссылка) Тогда Возврат; КонецЕсли;

Результат = Ссылка;
Ссылка = Ссылка.Родитель;
ВерхняяПапка(Ссылка, Результат);
КонецПроцедуры


