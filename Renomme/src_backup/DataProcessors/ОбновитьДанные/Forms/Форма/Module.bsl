&НаКлиенте
Процедура ОбновитьЗаявкиСРавноПо(Команда)
	ОбновитьЗаявкиСРавноПоНаСервере();
КонецПроцедуры

&НаСервере
Процедура ОбновитьЗаявкиСРавноПоНаСервере()
Запрос = Новый Запрос("ВЫБРАТЬ
                      |	ЗаявкаНаБронирование.Ссылка КАК Ссылка
                      |ИЗ
                      |	Документ.ЗаявкаНаБронирование КАК ЗаявкаНаБронирование
                      |ГДЕ
                      |	ЗаявкаНаБронирование.РезервС = ЗаявкаНаБронирование.РезервПо
                      |	И ЗаявкаНаБронирование.ПометкаУдаления = ЛОЖЬ
                      |
                      |УПОРЯДОЧИТЬ ПО
                      |	Ссылка");

ТЗ = Запрос.Выполнить().Выгрузить();

Для Каждого Строка Из ТЗ Цикл
	ЗаявкаОбъект = Строка.Ссылка.ПолучитьОбъект();
	
	Попытка 
		ЗаявкаОбъект.Записать(РежимЗаписиДокумента.Проведение);
	Исключение
		Сообщить("Ошибка записи. Номер: " + ЗаявкаОбъект.Номер + ", дата: " + ЗаявкаОбъект.Дата); 		
	КонецПопытки
	
КонецЦикла;
	
КонецПроцедуры
