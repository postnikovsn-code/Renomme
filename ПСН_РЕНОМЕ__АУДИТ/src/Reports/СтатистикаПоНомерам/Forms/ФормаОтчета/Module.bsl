		ВозрастИтого = ВозрастИтого + Строка.Возраст;
	    КоличествоВозрастИтого = КоличествоВозрастИтого + 1;
	КонецЕсли;	
	Если Строка.Возраст2 <> 0 Тогда
		ВозрастИтого = ВозрастИтого + Строка.Возраст2;
	    КоличествоВозрастИтого = КоличествоВозрастИтого + 1;
