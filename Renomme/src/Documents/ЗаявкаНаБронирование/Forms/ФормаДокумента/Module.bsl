Процедура ЗавершениеФормаЧекАвансПараметры(Результат, ДополнительныеПараметры) Экспорт
Если Результат = Неопределено Тогда Возврат; КонецЕсли;

СуммаАванса = Результат.СуммаАванса; 
Если СуммаАванса <= 0 Тогда Возврат; КонецЕсли;

ДопПараметры = Новый Структура;
ДопПараметры.Вставить("ЭтоГрупповойСчет", Ложь);
ДопПараметры.Вставить("ЭтоСчетКоворкинг", Ложь);
ДопПараметры.Вставить("ЭтоСчетНаОплату", Ложь);

ДопПараметры.Вставить("ЭтоЧекНаАванс", Истина);
ДопПараметры.Вставить("ЭтоАванс", Истина);

ДопПараметры.Вставить("Контрагент", Результат.Контрагент);
ДопПараметры.Вставить("ДокументДолгОбъектДанные", Объект);  

ДопПараметры.Вставить("СчетаДетальноОплаты", Объект.СчетаДетальноОплаты);  
ДопПараметры.Вставить("СчетаДетальноДолги", Объект.СчетаДетальноДолги);  
ДопПараметры.Вставить("РаспределениеОплатДолги", Объект.РаспределениеОплатДолги);  
ДопПараметры.Вставить("Счета", Объект.Счета);  

ДопПараметры.Вставить("СуммаОплаты", СуммаАванса);
ДопПараметры.Вставить("СуммаКОплате", СуммаАванса);

ОповещениеДопПараметры = Новый Структура;
ОповещениеЗавершениеЧекАванс = Новый ОписаниеОповещения("ОповещениеЗавершениеЧекАванс", ЭтаФорма, ОповещениеДопПараметры);
ДопПараметры.Вставить("ОповещениеЗавершениеЧек", ОповещениеЗавершениеЧекАванс);

ДопПараметры.Вставить("Форма", ЭтаФорма);

ОплатыЧекКлиент.ОткрытьФормуЧек(ДопПараметры);	
КонецПроцедуры

