//
&НаКлиенте
Процедура УдалениеНесвязанныхСтрокСчета(Команда)
	УдалениеНесвязанныхСтрокСчетаНаСервере();
КонецПроцедуры

&НаСервере
Процедура УдалениеНесвязанныхСтрокСчетаНаСервере()
Запрос = Новый Запрос("ВЫБРАТЬ
                      |	ЗаявкаНаБронирование.Ссылка КАК Ссылка
                      |ИЗ
                      |	Документ.ЗаявкаНаБронирование КАК ЗаявкаНаБронирование
                      |ГДЕ
                      |	ЗаявкаНаБронирование.ПометкаУдаления = ЛОЖЬ");

ТЗ = Запрос.Выполнить().Выгрузить();

Для Каждого СтрокаТЗ Из ТЗ Цикл
	ЗаявкаОбъект = СтрокаТЗ.Ссылка.ПолучитьОбъект();
	
	МассивКУдаление = Новый Массив;
	Для Каждого Строка Из ЗаявкаОбъект.СчетаДетальноСтроки Цикл
		ОтборСтроки = Новый Структура("СчетГУИД", Строка.СчетГУИД);
		НайденныеСтроки = ЗаявкаОбъект.Счета.НайтиСтроки(ОтборСтроки);
		
		Если НайденныеСтроки.Количество() > 0 Тогда Продолжить; КонецЕсли;
			
		МассивКУдаление.Добавить(Строка);	
	КонецЦикла;		
	
	Если МассивКУдаление.Количество() = 0 Тогда Продолжить; КонецЕсли;
	
	Для Каждого Строка Из МассивКУдаление Цикл
		ЗаявкаОбъект.СчетаДетальноСтроки.Удалить(Строка);		
	КонецЦикла;
	
	ЗаявкаОбъект.Записать(РежимЗаписиДокумента.Проведение);
КонецЦикла;
	
КонецПроцедуры
