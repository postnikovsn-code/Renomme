// + ЗаполнитьСтрокаДолги
Процедура ЗаполнитьСтрокаДолги(Строка, ИсходнаяСтрока, СчетГУИД, Услуга) Экспорт
Строка.СчетГУИД = СчетГУИД;

Строка.Услуга = Услуга;
Строка.ДолгиГУИД = ИсходнаяСтрока.ГУИД;
Строка.Количество = ИсходнаяСтрока.Количество;
Строка.Цена = ИсходнаяСтрока.Цена;

Строка.НаименованиеДолг = НаименованиеДолг(ИсходнаяСтрока, Услуга);
Строка.ДатаДолг = ДатаДолг(ИсходнаяСтрока, Услуга);
Строка.СуммаДолг = СуммаДолг(ИсходнаяСтрока, Услуга);

Строка.СуммаОплачено = 0;
Строка.СуммаКЗакрытию = Строка.СуммаДолг;

Если Услуга Тогда
	Строка.ЕстьНДС = ИсходнаяСтрока.Услуга.ЕстьНДС;
	Строка.НазваниеДляЧека = НазваниеДляЧека(ИсходнаяСтрока, Услуга);
	Строка.ПрограммныйКодУслуги = ИсходнаяСтрока.Услуга.ПрограммныйКод;
КонецЕсли;
КонецПроцедуры

Функция НаименованиеДолг(Строка, Услуга) Экспорт 
Если Услуга Тогда
	НаименованиеДолг = Строка.Услуга.Наименование;   			
Иначе
	НаименованиеДолг = "Проживание";   			
КонецЕсли;

Возврат НаименованиеДолг;
КонецФункции	

Функция НазваниеДляЧека(Строка, Услуга) Экспорт 
Если Услуга Тогда
	НазваниеДляЧека = ?(ЗначениеЗаполнено(Строка.Услуга.НазваниеДляЧека)
			, Строка.Услуга.НазваниеДляЧека, Строка.Услуга.Наименование);   			
Иначе
	НазваниеДляЧека = "";   			
КонецЕсли;

Возврат НазваниеДляЧека;
КонецФункции	

Функция ДатаДолг(Строка, Услуга)
Если Услуга Тогда
	ДатаДолг = Строка.ДатаУслуги;   			
Иначе
	ДатаДолг =Строка.ДеньПроживания;   			
КонецЕсли;

Возврат ДатаДолг;
КонецФункции	

Функция СуммаДолг(Строка, Услуга) Экспорт
Если Услуга Тогда
	СуммаДолг = Строка.Количество * Строка.Цена ;   			
Иначе
	СуммаДолг =Строка.Сумма;   			
КонецЕсли;

Возврат СуммаДолг;
КонецФункции	
