//Если Объект.Статус = ПредопределенноеЗначение("Перечисление.СтатусБрони.ОтменаБронирования")	
//ИЛИ Объект.Статус = ПредопределенноеЗначение("Перечисление.СтатусБрони.ОтказОтБронирования")	
//Тогда Возврат Ложь; КонецЕсли;

ТекстСообщения = "";

ТекущийЭлемент_П = Неопределено;
Если НЕ ЗначениеЗаполнено(Объект.ТипБронирования) Тогда
	ТекстСообщения = "Не заполнен Тип бронирования.";
	ТекущийЭлемент_П = Элементы.ТипБронирования;
КонецЕсли;

Если Объект.ТипБронирования <> ПредопределенноеЗначение("Справочник.ТипБронирования.Ремонт") Тогда
	Если НЕ ЗначениеЗаполнено(Объект.КаналБронирования) Тогда
		ТекстСообщения = ОбщийФункционалКлиентСервер.ДобавитьТекст(ТекстСообщения, "Не заполнен Канал бронирования.", " ");
		
		Если ТекущийЭлемент_П = Неопределено Тогда ТекущийЭлемент_П = Элементы.КаналБронирования; КонецЕсли;
	КонецЕсли;
КонецЕсли;
	
Если ТекстСообщения <> "" Тогда
	ТекстСообщения = ТекстСообщения + " ЗАПИСЬ ОТМЕНЯЕТСЯ ...";
	Сообщить(ТекстСообщения);
	
	ЭтаФорма.ТекущийЭлемент = ТекущийЭлемент_П;
	
	Возврат Истина;
КонецЕсли;

Возврат Ложь;
КонецФункции

//
&НаСервере
Функция ПроверкаЗаполнения_ПередЗаписью()
ТекстСообщения = ПроверкаЗаполненияТекстСообщенияПередЗаписьюНаСервере(Объект);
Если ТекстСообщения <> "" Тогда
	ТекстСообщения = ТекстСообщения + " ЗАПИСЬ ОТМЕНЕНА.";
	Сообщить(ТекстСообщения); 
	
	Возврат Истина; 
КонецЕсли;

//
Результат = ПроверкаСуммПередЗаписьюНаСервере(Объект);

ТекстСообщения = "";
Если Результат.ЕстьПроживание0 Тогда 
	ТекстСообщения = "В проживании есть строки с суммой = 0."; 
КонецЕсли;

Если Результат.ЕстьДопУслуги0 Тогда 
	ТекстСообщения = ОбщийФункционалКлиентСервер.ДобавитьТекст(ТекстСообщения, "В услугах есть строки с суммой = 0.", " "); 
КонецЕсли;

Если ТекстСообщения <> "" Тогда 
	ТекстСообщения = "ВНИМАНИЕ !!! " + ТекстСообщения;
	//ТекстСообщения = ТекстСообщения  + "ЗАПИСЬ ОТМЕНЕНА";
	Сообщить(ТекстСообщения); 
	
	Возврат Истина; 
КонецЕсли;
//

Возврат Ложь; 
КонецФункции

&НаСервере
Функция ПроверкаЗаполненияТекстСообщенияПередЗаписьюНаСервере(ТекущийОбъект)
Возврат ДокументыСервер.ПроверкаЗаполненияЗаявкаНабронированиеТекстСообщения(ТекущийОбъект, " ");
КонецФункции

&НаСервере
Функция ПроверкаСуммПередЗаписьюНаСервере(ТекущийОбъект)
ЕстьПроживание0 = Ложь;
ЕстьДопУслуги0 = Ложь;

Для Каждого Строка Из ТекущийОбъект.Проживание Цикл
	Если Строка.Сумма = 0 Тогда ЕстьПроживание0 = Истина; Прервать; КонецЕсли;
КонецЦикла;	

Для Каждого Строка Из ТекущийОбъект.ДопУслуги Цикл
	Если НЕ Строка.ВСчет Тогда Продолжить; КонецЕсли; 	
	Если (Строка.Цена * Строка.Количество)  = 0 Тогда ЕстьДопУслуги0 = Истина; Прервать; КонецЕсли;
КонецЦикла;

Результат = Новый Структура("ЕстьПроживание0, ЕстьДопУслуги0", ЕстьПроживание0, ЕстьДопУслуги0);
Возврат Результат;
КонецФункции
//
////

////
&НаСервере
Процедура ПередЗаписью_Продолжение()
// Обновление РезервС, РезервПо 
Результат = ОбновитьРезервСРезервПоПередЗаписьюНаСервере(Объект);

ТекстПредупрежденияПослеЗаписи = "";
Если Результат <> Неопределено Тогда

	ТекстПредупреждения = "";
	Если Результат.ЕстьНесколькоДеньПроживания Тогда
		ТекстПредупреждения = "В проживании есть строки с одинаковыми днями проживания."; 
	КонецЕсли;

	Если Результат.ЕстьУдаленныеПустыеСтроки Тогда
		ТекстПредупреждения = ОбщийФункционалКлиентСервер.ДобавитьТекст(ТекстПредупреждения, "Удалены пустые строки из проживания."
			, Символы.ПС + Символы.ПС); 
 
	КонецЕсли;
	
	Если Результат.ЕстьРасхожденияРезервС Тогда
		ТекстПредупреждения = ОбщийФункционалКлиентСервер.ДобавитьТекст(ТекстПредупреждения
			, "Есть расхождения 'Резерв С' и Расчета проживания."
			, Символы.ПС + Символы.ПС); 
 
	КонецЕсли;

	Если Результат.ЕстьРасхожденияРезервПо Тогда
		ТекстПредупреждения = ОбщийФункционалКлиентСервер.ДобавитьТекст(ТекстПредупреждения
			, "Есть расхождения 'Резерв По' и Расчета проживания."
			, Символы.ПС + Символы.ПС); 
 
	КонецЕсли;

	Если ТекстПредупреждения <> "" Тогда
		ТекстПредупрежденияПослеЗаписи = "ВНИМАНИЕ !" + Символы.ПС + Символы.ПС + ТекстПредупреждения;
	КонецЕсли;
КонецЕсли;	

Для каждого Услуга Из Объект.ДопУслуги Цикл
	Если Услуга.ДатаУслуги=Дата(1,1,1) тогда
		Услуга.ДатаУслуги=ТекущаяДата();
	КонецЕсли;
КонецЦикла;

УстановитьГорничныеЕстьИзмененияПередЗаписью();

Если СчетаКОбновлению.Количество() > 0  Тогда
	ОбновитьСчетаКОбновлениюПередЗаписьюНаСервере(Объект);
КонецЕсли;

СсылкаСтатус_OldValue = Объект.Ссылка.Статус;

Если НЕ Объект.БонШанс Тогда
	РезультатСкидкаКлиента = ДокументыСервер.СкидкаКлиента(Объект);
	Объект.СкидкаКлиента = РезультатСкидкаКлиента.Скидка;
	Объект.УровеньСкидкиКлиента = РезультатСкидкаКлиента.Уровень;
КонецЕсли;
КонецПроцедуры

&НаСервере
Функция ОбновитьРезервСРезервПоПередЗаписьюНаСервере(ТекущийОбъект)
Если ЗаполнитьПроживание Тогда Возврат Неопределено; КонецЕсли;	
//Если УдалитьРаспределениеОплатНаСчет Тогда Возврат Неопределено; КонецЕсли;	
Если ТекущийОбъект.Проживание.Количество() = 0 Тогда Возврат Неопределено; КонецЕсли;	

РезервС_OldValue = ТекущийОбъект.Ссылка.РезервС;
РезервПо_OldValue = ТекущийОбъект.Ссылка.РезервПо;

ТекущийОбъект.Проживание.Сортировать("ДеньПроживания");

// Удаление пустых строк (ДеньПроживания) Проживание
ЕстьУдаленныеПустыеСтроки = Ложь;
ЕстьНесколькоДеньПроживания = Ложь;

МассивКУдалению = Новый Массив;
Для Каждого Строка Из ТекущийОбъект.Проживание Цикл
	Если НЕ ЗначениеЗаполнено(Строка.ДеньПроживания) Тогда
		ОтборСтроки = Новый Структура("ДолгиГУИД", Строка.ГУИД);
		НайденныеСтроки = ТекущийОбъект.СчетаДетальноДолги.НайтиСтроки(ОтборСтроки); 
		Для Каждого НайденнаяСтрока Из НайденныеСтроки Цикл
			ЗаявкаСервер.ОчиститьСчетаДетальноОплатыОтборСтроки(ОтборСтроки, ТекущийОбъект.РаспределениеОплатДолги, ТекущийОбъект.СчетаДетальноОплаты);
			ТекущийОбъект.СчетаДетальноДолги.Удалить(НайденнаяСтрока);
		КонецЦикла;	
		
		ЕстьУдаленныеПустыеСтроки = Истина;
		МассивКУдалению.Добавить(Строка); 	
	КонецЕсли;	
	
	ОтборСтроки = Новый Структура("ДеньПроживания", Строка.ДеньПроживания); 
	НайденныеСтроки = ТекущийОбъект.Проживание.НайтиСтроки(ОтборСтроки);
	Если НайденныеСтроки.Количество() > 1 Тогда 
		ЕстьНесколькоДеньПроживания = Истина;
	КонецЕсли;	
КонецЦикла;	
ОбщийФункционалСервер.УдалитьСтроки(ТекущийОбъект.Проживание, МассивКУдалению); 
//

Если ТекущийОбъект.Проживание.Количество() = 1 Тогда 
	Если ТекущийОбъект.РезервС = ТекущийОбъект.РезервПо Тогда 
		ПерваяСтрока = ТекущийОбъект.Проживание[0];
	Иначе	
		ПерваяСтрока = ТекущийОбъект.Проживание[0];
		Если НЕ (ТекущийОбъект.РезервС = РезервС_OldValue И ТекущийОбъект.РезервПо = РезервПо_OldValue) Тогда
			Если ТекущийОбъект.ВремяЗаезда = Перечисления.ВремяЗаезда.Вр0 Тогда
				ПерваяСтрокаКоличество = 2;
			ИначеЕсли ТекущийОбъект.ВремяЗаезда = Перечисления.ВремяЗаезда.Вр6 Тогда
				ПерваяСтрокаКоличество = 1.5;
			Иначе	
				ПерваяСтрокаКоличество = 1;
			КонецЕсли;
			
			Если ТекущийОбъект.ВремяВыезда = Перечисления.ВремяВыезда.Вр18 Тогда
				ПерваяСтрокаКоличество = ПерваяСтрокаКоличество + 0.5;
			ИначеЕсли ТекущийОбъект.ВремяВыезда = Перечисления.ВремяВыезда.Вр0 Тогда
				ПерваяСтрокаКоличество = ПерваяСтрокаКоличество + 1.0;
			КонецЕсли;

			Если ПерваяСтрока.Количество <> ПерваяСтрокаКоличество Тогда
				ПерваяСтрока.Количество = ПерваяСтрокаКоличество;

				ПерваяСтрока.СуммаБезСкидки = ПерваяСтрока.Цена * ПерваяСтрока.Количество;
				ДокументыСервер.ЗаполнитьСуммаСоСкидкойСтрокаПроживание(ПерваяСтрока);
				ОбновитьСтрокаСчетаДетальноДолги(ПерваяСтрока, Ложь, ТекущийОбъект);
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
	
	ПоследняяСтрока = ТекущийОбъект.Проживание[0];
	
	Перейти ~ВЫХОД;
КонецЕсли;

// + Обновление строк
ПерваяСтрока = ТекущийОбъект.Проживание[0];
Если НЕ (ТекущийОбъект.РезервС = РезервС_OldValue И ТекущийОбъект.РезервПо = РезервПо_OldValue) Тогда
	Если ТекущийОбъект.ВремяЗаезда = Перечисления.ВремяЗаезда.Вр0 Тогда
		ПерваяСтрокаКоличество = 2;
	ИначеЕсли ТекущийОбъект.ВремяЗаезда = Перечисления.ВремяЗаезда.Вр6 Тогда
		ПерваяСтрокаКоличество = 1.5;
	Иначе	
		ПерваяСтрокаКоличество = 1;
	КонецЕсли;

	Если ПерваяСтрока.Количество <> ПерваяСтрокаКоличество Тогда
		ПерваяСтрока.Количество = ПерваяСтрокаКоличество;

		ПерваяСтрока.СуммаБезСкидки = ПерваяСтрока.Цена * ПерваяСтрока.Количество;
		ДокументыСервер.ЗаполнитьСуммаСоСкидкойСтрокаПроживание(ПерваяСтрока);
		ОбновитьСтрокаСчетаДетальноДолги(ПерваяСтрока, Ложь, ТекущийОбъект);
	КонецЕсли;
КонецЕсли;

ПоследнийИндекс = ТекущийОбъект.Проживание.Количество() - 1;

Если ПоследнийИндекс > 1 Тогда 
	Для Индекс = 1 По ТекущийОбъект.Проживание.Количество() - 2 Цикл
		Строка = ТекущийОбъект.Проживание[Индекс]; 
		Если Строка.Количество = 1 Тогда Продолжить; КонецЕсли;
			
		Строка.Количество = 1;
		Строка.СуммаБезСкидки = Строка.Цена * Строка.Количество;
		ДокументыСервер.ЗаполнитьСуммаСоСкидкойСтрокаПроживание(Строка);
		ОбновитьСтрокаСчетаДетальноДолги(Строка, Ложь, ТекущийОбъект);
	КонецЦикла;
КонецЕсли;

ПоследняяСтрока = ТекущийОбъект.Проживание[ПоследнийИндекс];
Если НЕ (ТекущийОбъект.РезервС = РезервС_OldValue И ТекущийОбъект.РезервПо = РезервПо_OldValue) Тогда
	Если ТекущийОбъект.ВремяВыезда = Перечисления.ВремяВыезда.Вр18 Тогда
		ПоследняяСтрокаКоличество = 1.5;
	ИначеЕсли ТекущийОбъект.ВремяВыезда = Перечисления.ВремяВыезда.Вр0 Тогда
		ПоследняяСтрокаКоличество = 2;
	Иначе		
		ПоследняяСтрокаКоличество = 1;
	КонецЕсли;

	Если ПоследняяСтрока.Количество <> ПоследняяСтрокаКоличество Тогда  
		ПоследняяСтрока.Количество = ПоследняяСтрокаКоличество; 
		
		ПоследняяСтрока.СуммаБезСкидки = ПоследняяСтрока.Цена * ПоследняяСтрока.Количество;
		ДокументыСервер.ЗаполнитьСуммаСоСкидкойСтрокаПроживание(ПоследняяСтрока);
		ОбновитьСтрокаСчетаДетальноДолги(ПоследняяСтрока, Ложь, ТекущийОбъект);
	КонецЕсли;
КонецЕсли;
// - Обновление строк

~ВЫХОД:
ДеньПроживанияМинимум = ПерваяСтрока.ДеньПроживания;
ЕстьРасхожденияРезервС = (ТекущийОбъект.Проживание.Количество() <> 0)  И (ТекущийОбъект.РезервС <> ДеньПроживанияМинимум); 

Если ТекущийОбъект.БонШанс Тогда
	ДеньПроживанияМаксимум = ПоследняяСтрока.ДеньПроживания; 	
Иначе	
	ДеньПроживанияМаксимум = ПоследняяСтрока.ДеньПроживания + 86400; 
КонецЕсли;

ЕстьРасхожденияРезервПо = (ТекущийОбъект.Проживание.Количество() <> 0) И (ТекущийОбъект.РезервПо <> ДеньПроживанияМаксимум);
// - Резерв По

ТекущийОбъект.КолВоДней = ТекущийОбъект.Проживание.Итог("Количество");

Результат = Новый Структура;
Результат.Вставить("ЕстьНесколькоДеньПроживания", ЕстьНесколькоДеньПроживания);
Результат.Вставить("ЕстьУдаленныеПустыеСтроки", ЕстьУдаленныеПустыеСтроки);
Результат.Вставить("ЕстьРасхожденияРезервС", ЕстьРасхожденияРезервС);
Результат.Вставить("ЕстьРасхожденияРезервПо", ЕстьРасхожденияРезервПо);

Возврат Результат;
КонецФункции	

&НаСервере
Процедура УстановитьГорничныеЕстьИзмененияПередЗаписью()
Если ЗначениеЗаполнено(Объект.Ссылка) Тогда
	ГорничныеЕстьИзменения = (Объект.РезервС <> Объект.Ссылка.РезервС) 
							ИЛИ (Объект.РезервПо <> Объект.Ссылка.РезервПо)
							ИЛИ (Объект.НомерВРезерв <> Объект.Ссылка.НомерВРезерв)
							ИЛИ (Объект.РаздельныеКровати <> Объект.Ссылка.РаздельныеКровати)
							ИЛИ (Объект.КолВоЧеловек <> Объект.Ссылка.КолВоЧеловек)
							ИЛИ (Объект.ДопМесто_1_Возраст <> Объект.Ссылка.ДопМесто_1_Возраст)
							ИЛИ (Объект.ДопМесто_1_ТипДопМеста <> Объект.Ссылка.ДопМесто_1_ТипДопМеста)
							ИЛИ (Объект.ДопМесто_2_Возраст <> Объект.Ссылка.ДопМесто_2_Возраст)
							ИЛИ (Объект.ДопМесто_2_ТипДопМеста <> Объект.Ссылка.ДопМесто_2_ТипДопМеста)
							ИЛИ (Объект.ГорничныеВремяЗаезда <> Объект.Ссылка.ГорничныеВремяЗаезда)							
							ИЛИ (Объект.ВремяЗаездаТочное <> Объект.Ссылка.ВремяЗаездаТочное)							
							ИЛИ (Объект.ВремяВыездаТочное <> Объект.Ссылка.ВремяВыездаТочное)							
							ИЛИ (Объект.ГорничныеКоментарий <> Объект.Ссылка.ГорничныеКоментарий)							;		
Иначе
	ГорничныеЕстьИзменения = Ложь;
КонецЕсли;		
КонецПроцедуры	

&НаСервере
Процедура ОбновитьСчетаКОбновлениюПередЗаписьюНаСервере(ТекущийОбъект)
СчетаКОбновлению_П = СчетаКОбновлению.Выгрузить(, "СчетГУИД");
СчетаКОбновлению_П.Свернуть("СчетГУИД");

Для Каждого Строка Из СчетаКОбновлению_П Цикл
	ОтборСтроки = Новый Структура("СчетГУИД", Строка.СчетГУИД);
	НайденныеСчета = ТекущийОбъект.Счета.НайтиСтроки(ОтборСтроки);
	Если НайденныеСчета.Количество() = 0 Тогда Продолжить; КонецЕсли;
	
	Счет = НайденныеСчета[0]; 
	
	ОбновитьСчетЗаявка(Счет, ТекущийОбъект, Ложь);
КонецЦикла;

СчетаКОбновлению.Очистить();		
КонецПроцедуры	

&НаСервере
Функция СкидкаКлиента_1()
Если НЕ ЗначениеЗаполнено(Объект.Клиент) Тогда Возврат 0; КонецЕсли;

Если НЕ ЗначениеЗаполнено(Объект.РезервС) Тогда Возврат 0; КонецЕсли;

Если Объект.Клиент.ТипКлиента = Перечисления.ТипыКлиентов.ЮрЛицо Тогда Возврат 0; КонецЕсли;

Если Объект.Бронирует.Турагентство 
ИЛИ Объект.Бронирует.ТипКлиента = Перечисления.ТипыКлиентов.ЮрЛицо 
Тогда Возврат 0; КонецЕсли;

Запрос = Новый Запрос("ВЫБРАТЬ
                      |	ЗаявкаНаБронированиеСчета.Ссылка КАК Ссылка,
                      |	ЗаявкаНаБронированиеСчета.СчетГУИД КАК СчетГУИД,
                      |	СчетаДолги.КоличествоНочей КАК КоличествоНочей,
                      |	ЗаявкаНаБронированиеСчета.ГрупповойСчет КАК ГрупповойСчет,
                      |	ЗаявкаНаБронированиеСчета.ЭтоПредварительныйГрупповойСчет КАК ЭтоПредварительныйГрупповойСчет,
                      |	ЗаявкаНаБронированиеСчета.Контрагент КАК Контрагент,
                      |	ЗаявкаНаБронированиеСчета.Клиент КАК Клиент,
                      |	ЗаявкаНаБронированиеСчета.Ссылка.Бронирует КАК Бронирует
                      |ИЗ
                      |	Документ.ЗаявкаНаБронирование.Счета КАК ЗаявкаНаБронированиеСчета
                      |		ВНУТРЕННЕЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
                      |			ЗаявкаНаБронированиеСчетаДетальноДолги.Ссылка КАК Ссылка,
                      |			ЗаявкаНаБронированиеСчетаДетальноДолги.СчетГУИД КАК СчетГУИД,
                      |			КОЛИЧЕСТВО(РАЗЛИЧНЫЕ ЗаявкаНаБронированиеСчетаДетальноДолги.ДолгиГУИД) КАК КоличествоНочей
                      |		ИЗ
                      |			Документ.ЗаявкаНаБронирование.СчетаДетальноДолги КАК ЗаявкаНаБронированиеСчетаДетальноДолги
                      |		ГДЕ
                      |			ЗаявкаНаБронированиеСчетаДетальноДолги.Услуга = ЛОЖЬ
                      |		
                      |		СГРУППИРОВАТЬ ПО
                      |			ЗаявкаНаБронированиеСчетаДетальноДолги.Ссылка,
                      |			ЗаявкаНаБронированиеСчетаДетальноДолги.СчетГУИД) КАК СчетаДолги
                      |		ПО ЗаявкаНаБронированиеСчета.Ссылка = СчетаДолги.Ссылка
                      |			И ЗаявкаНаБронированиеСчета.СчетГУИД = СчетаДолги.СчетГУИД
                      |ГДЕ
                      |	ЗаявкаНаБронированиеСчета.Ссылка.ПометкаУдаления = ЛОЖЬ
                      |	И ЗаявкаНаБронированиеСчета.Ссылка.Статус = ЗНАЧЕНИЕ(Перечисление.СтатусБрони.Выехал)
                      |	И ЗаявкаНаБронированиеСчета.Клиент = &Клиент
                      |	И ЗаявкаНаБронированиеСчета.Ссылка.РезервС < &РезервС");

Запрос.УстановитьПараметр("РезервС", Объект.РезервС);
Запрос.УстановитьПараметр("Клиент", Объект.Клиент);

ТЗ = Запрос.Выполнить().Выгрузить();

КоличествоНочей = 0;
Для Каждого Строка Из ТЗ Цикл 
	Если Строка.Бронирует.Турагентство 
	ИЛИ Строка.Бронирует.ТипКлиента = Перечисления.ТипыКлиентов.ЮрЛицо 
	Тогда Продолжить; КонецЕсли;
	
	Если Строка.ЭтоПредварительныйГрупповойСчет 
	ИЛИ ЗначениеЗаполнено(Строка.ГрупповойСчет) 
	Тогда
		Если Строка.Клиент <> Строка.Бронирует Тогда Продолжить; КонецЕсли;
	КонецЕсли;
	
	КоличествоНочей = КоличествоНочей + Строка.КоличествоНочей; 	
КонецЦикла;

Если КоличествоНочей = 0 Тогда Возврат 0; КонецЕсли;

Запрос = Новый Запрос("ВЫБРАТЬ
                      |	СкидкиКлиента.КоличествоНочей КАК КоличествоНочей,
                      |	СкидкиКлиента.Скидка КАК Скидка
                      |ИЗ
                      |	РегистрСведений.СкидкиКлиента КАК СкидкиКлиента
                      |
                      |УПОРЯДОЧИТЬ ПО
                      |	КоличествоНочей");

ТЗ = Запрос.Выполнить().Выгрузить();

СкидкаКлиента = 0;
Для Каждого Строка Из ТЗ Цикл
	Если Строка.КоличествоНочей >= КоличествоНочей Тогда Прервать; КонецЕсли;
 	
	СкидкаКлиента = Строка.Скидка;		
КонецЦикла;

Возврат СкидкаКлиента;	
КонецФункции

