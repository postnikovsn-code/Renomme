  <attributes>
    <name>Список</name>
    <id>1</id>
    <valueType>
      <types>DynamicList</types>
    </valueType>
    <view>
      <common>true</common>
    </view>
    <edit>
      <common>true</common>
    </edit>
    <main>true</main>
    <extInfo xsi:type="form:DynamicListExtInfo">
      <queryText>ВЫБРАТЬ
	ДокументКассовыйДокумент.Ссылка КАК Ссылка,
	ДокументКассовыйДокумент.ПометкаУдаления КАК ПометкаУдаления,
	ДокументКассовыйДокумент.Номер КАК Номер,
	ДокументКассовыйДокумент.Дата КАК Дата,
	ДокументКассовыйДокумент.Проведен КАК Проведен,
	ДокументКассовыйДокумент.ОтКого КАК ОтКого,
	ВЫБОР
		КОГДА ДокументКассовыйДокумент.ОтКого.ТипКлиента = ЗНАЧЕНИЕ(Перечисление.ТипыКлиентов.ЮрЛицо)
			ТОГДА ВЫБОР
					КОГДА ДокументКассовыйДокумент.ОтКого.НаименованиеЮрЛица = &quot;&quot;
						ТОГДА ДокументКассовыйДокумент.ОтКого.Наименование
					ИНАЧЕ ДокументКассовыйДокумент.ОтКого.НаименованиеЮрЛица
				КОНЕЦ
		ИНАЧЕ ДокументКассовыйДокумент.ОтКого.Наименование
	КОНЕЦ КАК ОтКогоНаименование,
	ДокументКассовыйДокумент.Приход КАК Приход,
	ДокументКассовыйДокумент.Сумма КАК Сумма,
	Оплаты.Сумма КАК ОплатыСумма,
	ДокументКассовыйДокумент.ДокументДолг КАК ДокументДолг,
	ДокументКассовыйДокумент.ВидОперации КАК ВидОперации,
	ДокументКассовыйДокумент.Примечание КАК Примечание,
	ДокументКассовыйДокумент.КредитнаяКарта КАК КредитнаяКарта,
	ВЫБОР
		КОГДА ТИПЗНАЧЕНИЯ(ДокументКассовыйДокумент.ДокументДолг) = ТИП(Документ.ЗаявкаНаБронирование)
			ТОГДА ДокументКассовыйДокумент.ДокументДолг.НомерВРезерв.Наименование
		КОГДА ТИПЗНАЧЕНИЯ(ДокументКассовыйДокумент.ДокументДолг) = ТИП(Документ.КоворкингСчета)
			ТОГДА ДокументКассовыйДокумент.ДокументДолг.КоворкингЗаявка.КоворкингНомер.Наименование
		ИНАЧЕ &quot;&quot;
	КОНЕЦ КАК НомерВРезервНаименование,
	ДокументКассовыйДокумент.НомерСменыККМ КАК НомерСменыККМ,
	ДокументКассовыйДокумент.НомерЧекаККМ КАК НомерЧекаККМ,
	ДокументКассовыйДокумент.ВозвратДокумент КАК ВозвратДокумент,
	ДокументКассовыйДокумент.Аванс КАК Аванс,
	ДокументКассовыйДокумент.Возврат КАК Возврат,
	ДокументКассовыйДокумент.Отмена КАК Отмена,
	ДокументКассовыйДокумент.ОтмененныйДокументДолг КАК ОтмененныйДокументДолг,
	ДокументКассовыйДокумент.РучнойВвод КАК РучнойВвод,
	ДокументКассовыйДокумент.ЭтоПроизвольныйЧек КАК ЭтоПроизвольныйЧек
ИЗ
	Документ.КассовыйДокумент КАК ДокументКассовыйДокумент
		ЛЕВОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
			КассовыйДокументДолгиОплата.Ссылка КАК Ссылка,
			СУММА(КассовыйДокументДолгиОплата.Сумма) КАК Сумма
		ИЗ
			Документ.КассовыйДокумент.ДолгиОплата КАК КассовыйДокументДолгиОплата
		
		СГРУППИРОВАТЬ ПО
			КассовыйДокументДолгиОплата.Ссылка) КАК Оплаты
		ПО ДокументКассовыйДокумент.Ссылка = Оплаты.Ссылка</queryText>
