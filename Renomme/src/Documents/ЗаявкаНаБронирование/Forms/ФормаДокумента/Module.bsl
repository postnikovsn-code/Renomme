Возврат ТекстСообщения <> ""; 
КонецФункции

&НаСервере
Функция ПроверкаОплатКонтрагента(Контрагент)
МассивКасса = Новый Массив;
МассивВыписка  = Новый Массив;
МассивПрочиеОплаты = Новый Массив;

Результат = Новый Структура("ЕстьКассаОплатыКонтрагентаВДругихЗаявках, МассивКасса, МассивВыписка, МассивПрочиеОплаты"
	, Ложь, МассивКасса, МассивВыписка, МассивПрочиеОплаты); 	
	
Если ЕстьКассаОплатыКонтрагентаВДругихЗаявках(Контрагент) Тогда 
	Результат.ЕстьКассаОплатыКонтрагентаВДругихЗаявках = Истина;
	
	Возврат Результат;
КонецЕсли;
	
Для Каждого Строка Из Объект.СчетаДетальноОплаты Цикл	
	Если Строка.ДокументОплаты.ОтКого <> Контрагент Тогда Продолжить; КонецЕсли; 
	
	Если ТипЗнч(Строка.ДокументОплаты) = Тип("ДокументСсылка.КассовыйДокумент") Тогда
		МассивКасса.Добавить(Строка.ДокументОплаты);
	ИначеЕсли ТипЗнч(Строка.ДокументОплаты) = Тип("ДокументСсылка.ВыпискаБанка") Тогда
		МассивВыписка.Добавить(Строка.ДокументОплаты);
	ИначеЕсли ТипЗнч(Строка.ДокументОплаты) = Тип("ДокументСсылка.ПрочиеОплаты") Тогда
		МассивПрочиеОплаты.Добавить(Строка.ДокументОплаты);
	КонецЕсли;
КонецЦикла;

Результат.МассивКасса = МассивКасса;
Результат.МассивВыписка = МассивВыписка;
Результат.МассивПрочиеОплаты = МассивПрочиеОплаты;
Возврат Результат;	
КонецФункции

&НаСервере
Функция ЕстьКассаОплатыКонтрагентаВДругихЗаявках(Контрагент)
ЕстьКассаОплатыКонтрагентаВДругихЗаявках = Ложь;

МассивДокументыОплаты = Новый Массив;
Для Каждого Строка Из Объект.СчетаДетальноОплаты Цикл
	ДокументОплаты = Строка.ДокументОплаты;
	Если ДокументОплаты.ОтКого <> Контрагент Тогда Продолжить; КонецЕсли;
	
	МассивДокументыОплаты.Добавить(Строка.ДокументОплаты);
КонецЦикла;

Если МассивДокументыОплаты.Количество() = 0 Тогда Возврат Ложь; КонецЕсли;

Запрос = Новый Запрос("ВЫБРАТЬ
                      |	КОЛИЧЕСТВО(РАЗЛИЧНЫЕ ЗаявкаНаБронированиеСчетаДетальноОплаты.Ссылка) КАК КоличествоРазличные
                      |ИЗ
                      |	Документ.ЗаявкаНаБронирование.СчетаДетальноОплаты КАК ЗаявкаНаБронированиеСчетаДетальноОплаты
                      |ГДЕ
                      |	ЗаявкаНаБронированиеСчетаДетальноОплаты.Ссылка.ПометкаУдаления = ЛОЖЬ
                      |	И ТИПЗНАЧЕНИЯ(ЗаявкаНаБронированиеСчетаДетальноОплаты.ДокументОплаты) = ТИП(Документ.КассовыйДокумент)
                      |	И ЗаявкаНаБронированиеСчетаДетальноОплаты.ДокументОплаты В(&ДокументыОплаты)");

Запрос.УстановитьПараметр("ДокументыОплаты", МассивДокументыОплаты);
Выборка = Запрос.Выполнить().Выбрать();
Выборка.Следующий();

ЕстьКассаОплатыКонтрагентаВДругихЗаявках = Выборка.КоличествоРазличные > 1;

Возврат ЕстьКассаОплатыКонтрагентаВДругихЗаявках; 
КонецФункции
