  <attributes>
    <name>Список</name>
    <id>1</id>
    <valueType>
      <types>DynamicList</types>
    </valueType>
    <view>
      <common>true</common>
    </view>
    <edit>
      <common>true</common>
    </edit>
    <main>true</main>
    <extInfo xsi:type="form:DynamicListExtInfo">
      <queryText>ВЫБРАТЬ
	РегистрСведенийОперацииЭТ.ГУИД КАК ГУИД,
	РегистрСведенийОперацииЭТ.КодАвторизации КАК КодАвторизации,
	РегистрСведенийОперацииЭТ.НомерКарты КАК НомерКарты,
	РегистрСведенийОперацииЭТ.НомерМерчанта КАК НомерМерчанта,
	РегистрСведенийОперацииЭТ.НомерЧекаЭТ КАК НомерЧекаЭТ,
	РегистрСведенийОперацииЭТ.СсылочныйНомер КАК СсылочныйНомер,
	РегистрСведенийОперацииЭТ.СуммаОперации КАК СуммаОперации,
	РегистрСведенийОперацииЭТ.ДокументДолг КАК ДокументДолг,
	ВЫБОР
		КОГДА РегистрСведенийОперацииЭТ.ТипТранзакции = &quot;AuthorizeSales&quot;
			ТОГДА &quot;Продажа&quot;
		КОГДА РегистрСведенийОперацииЭТ.ТипТранзакции = &quot;AuthorizeRefund&quot;
			ТОГДА &quot;Возврат&quot;
		КОГДА РегистрСведенийОперацииЭТ.ТипТранзакции = &quot;AuthorizeVoid&quot;
			ТОГДА &quot;Отмена&quot;
		ИНАЧЕ РегистрСведенийОперацииЭТ.ТипТранзакции
	КОНЕЦ КАК ТипТранзакции,
	РегистрСведенийОперацииЭТ.ДанныеКарты КАК ДанныеКарты,
	РегистрСведенийОперацииЭТ.ТипКарты КАК ТипКарты,
	РегистрСведенийОперацииЭТ.НомерЧека КАК НомерЧека,
	РегистрСведенийОперацииЭТ.ДатаРегистрации КАК ДатаРегистрации,
	РегистрСведенийОперацииЭТ.СсылочныйНомерВозврат КАК СсылочныйНомерВозврат,
	Возвраты.СуммаВозврата КАК СуммаВозврата,
	РегистрСведенийОперацииЭТ.ИдентификаторУстройстваНаименование КАК ИдентификаторУстройстваНаименование,
	РегистрСведенийОперацииЭТ.КассовыйЧек КАК КассовыйЧек
ИЗ
	РегистрСведений.ОперацииЭТ КАК РегистрСведенийОперацииЭТ
		ЛЕВОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
			СУММА(ОперацииЭТ.СуммаОперации) КАК СуммаВозврата,
			ОперацииЭТ.СсылочныйНомерВозврат КАК СсылочныйНомерВозврат
		ИЗ
			РегистрСведений.ОперацииЭТ КАК ОперацииЭТ
		ГДЕ
			ЕСТЬNULL(ОперацииЭТ.СсылочныйНомерВозврат, &quot;&quot;) &lt;> &quot;&quot;
		
		СГРУППИРОВАТЬ ПО
			ОперацииЭТ.СсылочныйНомерВозврат) КАК Возвраты
		ПО РегистрСведенийОперацииЭТ.СсылочныйНомер = Возвраты.СсылочныйНомерВозврат</queryText>
      <mainTable>InformationRegister.ОперацииЭТ</mainTable>
      <autoFillAvailableFields>true</autoFillAvailableFields>
      <customQuery>true</customQuery>
      <autoSaveUserSettings>true</autoSaveUserSettings>
      <getInvisibleFieldPresentations>true</getInvisibleFieldPresentations>
    </extInfo>
  </attributes>
  <commandInterface>
    <navigationPanel/>
    <commandBar/>
  </commandInterface>
  <extInfo xsi:type="form:DynamicListFormExtInfo"/>
</form:Form>
