&НаКлиенте
Функция СохранитьДокументPDF(ТабДок, ПолноеИмяФайла)
Ответ = Новый Структура("Ошибка, ОписаниеОшибки", Ложь, Истина);

ПолноеИмяФайлаPDF = ПолноеИмяФайла + ".PDF";
Попытка 
	ТабДок.Записать(ПолноеИмяФайлаPDF, ТипФайлаТабличногоДокумента.PDF);
Исключение
	Ответ.Ошибка = Истина;
	//Ответ.ОписаниеОшибки = ОписаниеОшибки();
	Ответ.ОписаниеОшибки = "Закройте файл " + ПолноеИмяФайлаPDF;
	
	Возврат Ответ;
КонецПопытки;

Возврат Ответ; 
КонецФункции

&НаКлиенте
Функция СохранитьДокументPDF_1(ТабДок, ПолноеИмяФайла)
Ответ = Новый Структура("Ошибка, ОписаниеОшибки", Ложь, Истина);

ПолноеИмяФайлаXLS = ПолноеИмяФайла + ".XLS";

//ТабДок = Новый ТабличныйДокумент;
Попытка 
	ТабДок.Записать(ПолноеИмяФайлаXLS, ТипФайлаТабличногоДокумента.XLS);
Исключение
	
	Ответ.Ошибка = Истина;
	Ответ.ОписаниеОшибки = ОписаниеОшибки();
	
	Возврат Ответ;
КонецПопытки;	
	
MSExcel = Новый COMОбъект("Excel.Application");	   
Книга = MSExcel.WorkBooks.Open(ПолноеИмяФайлаXLS);

MSExcel.Application.DisplayAlerts = False; 

xlTypePDF =	0; //	"PDF" — файл в формате PDF (PDF)

ПолноеИмяФайлаPDF = ПолноеИмяФайла + ".PDF";
Попытка 
	Книга.ExportAsFixedFormat (xlTypePDF , ПолноеИмяФайлаPDF);
Исключение
	Ответ.Ошибка = Истина;
	Ответ.ОписаниеОшибки = ОписаниеОшибки();
	
	Возврат Ответ;
КонецПопытки;

Попытка
	MSExcel.Quit();
	MSExcel = Неопределено;
Исключение
	Ответ.Ошибка = Истина;
	Ответ.ОписаниеОшибки = ОписаниеОшибки();
	
	Возврат Ответ;
КонецПопытки;

Возврат Ответ; 
КонецФункции

