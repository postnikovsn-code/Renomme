&НаСервере
Функция ДатаПГПоДеньНедели(Дата)
ДеньНедели = ДеньНедели(Дата);

Год = Год(Дата) - 1;
Месяц = Месяц(Дата);
День = День(Дата);

Попытка 
	ДатаПрошлыйГод = Дата(Год, Месяц, День); 
Исключение
	Месяц_П = Месяц + 1;
	ДатаПрошлыйГод = Дата(Год, Месяц_П, 1);
КонецПопытки;

//Если ДатаПрошлыйГод = Неопределено Тогда Возврат Неопределено; КонецЕсли;

ДеньНедели_ПГ = ДеньНедели(ДатаПрошлыйГод);

Если ДеньНедели_ПГ > ДеньНедели Тогда
	Разница = ДеньНедели_ПГ - ДеньНедели;
ИначеЕсли ДеньНедели_ПГ < ДеньНедели Тогда
	Разница = ДеньНедели + ДеньНедели_ПГ - 1;
Иначе
	Разница = 0;
КонецЕсли;

ДатаПГПоДеньНедели = ДатаПрошлыйГод + 86400 * (-Разница);

Возврат ДатаПГПоДеньНедели;
КонецФункции

&НаСервере
Процедура ЗаполнитьТЗАналитика(Знач Год)

ГодОбновления = Год;
Начало=?(Объект.ПоказатьПрошлыеДаты, 1 ,Месяц(ТекущаяДата()));
Конец =  12 + Начало - 1;

Если Конец > 12 Тогда
	ГодОбновления_П = ГодОбновления + 1;
	Месяц_П = Конец - 11;
Иначе
	ГодОбновления_П = ГодОбновления;
	Месяц_П = Конец;
КонецЕсли;
ДатаС = Дата(ГодОбновления, Начало, 1); 
ДатаПо = НачалоДня(КонецМесяца(Дата(ГодОбновления_П, Месяц_П, 1)));

ТЗ = Новый ТаблицаЗначений;                      
м= Новый Массив;
м.Добавить(Тип("Дата"));
ТЗ = Новый ТаблицаЗначений;
ТЗ.Колонки.Добавить("День", Новый ОписаниеТипов(м,, Новый КвалификаторыДаты(ЧастиДаты.Дата)));
//Переберем все даты за период 
ТекДат = НачалоДня(ДатаС);
Пока ТекДат <= НачалоДня(ДатаПо) Цикл 
	//Добавим текущую дату в таблицу периодов
	НовСтр = ТЗ.Добавить();
	НовСтр.День = ТекДат;
	
	ТекДат = ТекДат + 86400; //Добавим 1 День
КонецЦикла;

ТЗАналитикаЗапросТекст = КалендарьЦен.ТЗАналитикаЗапросТекст();
Запрос = Новый Запрос(ТЗАналитикаЗапросТекст);
					  
Запрос.УстановитьПараметр("ТабДата", ТЗ);
Запрос.УстановитьПараметр("ПериодНачало",ДатаС);
Запрос.УстановитьПараметр("ПериодКонец",КонецДня(ДатаПо));
Запрос.УстановитьПараметр("Номер", Справочники.НомернойФонд.НайтиПоНаименованию("Переговорная", Истина));
Запрос.УстановитьПараметр("ТипБронирования",Справочники.ТипБронирования.Ремонт);

Выборка = Запрос.Выполнить().Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);

ТЗАналитика.Очистить();
ТЗАналитикаКатегории.Очистить();
Пока Выборка.Следующий() Цикл
	//ВыборкаДва = Выборка.Выбрать();
	
	Если Выборка.ПериодДень = '20240604' Тогда
		  ш= 1;
	КонецЕсли;
		
	НоваяТЗАналитика = ТЗАналитика.Добавить();
	НоваяТЗАналитика.Дата = Выборка.ПериодДень;
	НоваяТЗАналитика.ДатаМесяц = НачалоМесяца(Выборка.ПериодДень);
	
	НоваяТЗАналитика.ДеньНедели = ДеньНедели(Выборка.ПериодДень);
	
	НоваяТЗАналитика.ОбщееКоличество = Выборка.ОбщееКоличество;
	
	ИтогЗанятo = Окр(100 * Выборка.ЗанятыеНомера / Выборка.ОбщееКоличество, 1);
	НоваяТЗАналитика.ИтогЗанято = ИтогЗанятo;
	
	//НоваяТЗАналитика.ГлубинаБронирования = Выборка.ГлубинаБрони;
	Если Выборка.КоличествоГлубинаБрони > 0 Тогда
		НоваяТЗАналитика.ГлубинаБронирования = Окр(Выборка.СуммаГлубинаБрони / Выборка.КоличествоГлубинаБрони, 1) ;
	КонецЕсли;
	
	//НоваяТЗАналитика.СреднийADR = Окр(Выборка.ADR);
	Если Выборка.ЗанятыеНомера > 0 Тогда
		НоваяТЗАналитика.СреднийADR = Окр(Выборка.СуммаADR / Выборка.ЗанятыеНомера);
	КонецЕсли;
		
	//ВыборкаДва.Сбросить();
	ВыборкаДва = Выборка.Выбрать();
	
	Пока ВыборкаДва.Следующий() Цикл
		НоваяТЗАналитикаКатегории = ТЗАналитикаКатегории.Добавить();
		НоваяТЗАналитикаКатегории.Дата = Выборка.ПериодДень;
		НоваяТЗАналитикаКатегории.Категория = ВыборкаДва.КатегорияНомера;
		
		КатегорияЗабронировано = Окр(100 * ВыборкаДва.ЗанятыеНомера /ВыборкаДва.ОбщееКоличество, 1);
		НоваяТЗАналитикаКатегории.КатегорияЗабронировано = КатегорияЗабронировано;
		
		//НоваяТЗАналитикаКатегории.КатегорияADR = Окр(ВыборкаДва.ADR);
		Если ВыборкаДва.ЗанятыеНомера > 0 Тогда
			НоваяТЗАналитикаКатегории.КатегорияADR = Окр(ВыборкаДва.СуммаADR / ВыборкаДва.ЗанятыеНомера);
		КонецЕсли;

	КонецЦикла;
КонецЦикла;

// + Предыдущий год

ДатаС_П = ДатаПГПоДеньНедели(ДатаС);
//ДатаПо_П = КонецМесяца(ДатаПГПоДеньНедели(ДатаПо));
ДатаПо_П = ДатаПГПоДеньНедели(ДатаПо);

Тз.Очистить();
ТекДат = НачалоДня(ДатаС_П);
Пока ТекДат <= НачалоДня(ДатаПо_П) Цикл 
	//Добавим текущую дату в таблицу периодов
	НовСтр = Тз.Добавить();
	НовСтр.День = ТекДат;
	
	ТекДат = ТекДат + 86400; //Добавим 1 День
КонецЦикла;

Запрос.УстановитьПараметр("ТабДата", ТЗ);
Запрос.УстановитьПараметр("ПериодНачало",ДатаС_П);
Запрос.УстановитьПараметр("ПериодКонец",КонецДня(ДатаПо_П));
Запрос.УстановитьПараметр("Номер", Справочники.НомернойФонд.НайтиПоНаименованию("Переговорная", Истина));
Запрос.УстановитьПараметр("ТипБронирования",Справочники.ТипБронирования.Ремонт);

Выборка = Запрос.Выполнить().Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);

ЗапросКатегория = Новый Запрос("ВЫБРАТЬ
                               |	КатегорииНомеров.Ссылка КАК Ссылка
                               |ИЗ
                               |	Справочник.КатегорииНомеров КАК КатегорииНомеров
                               |ГДЕ
                               |	КатегорииНомеров.ПометкаУдаления = ЛОЖЬ
                               |	И КатегорииНомеров.Базовый = ИСТИНА");

ВыборкаКатегория = ЗапросКатегория.Выполнить().Выбрать(); 
Если ВыборкаКатегория.Следующий() Тогда
	КатегорияНомераСтандартный = ВыборкаКатегория.Ссылка;
Иначе	
	КатегорияНомераСтандартный = Неопределено;
КонецЕсли;

Индекс = 0;
Пока Выборка.Следующий() Цикл
	Если Индекс > ТЗАналитика.Количество() - 1 Тогда Прервать; КонецЕсли;
	
	//Если Выборка.ПериодДень = '20240301' Тогда
	//	ш = 1;
	//КонецЕсли;
	
	Если КатегорияНомераСтандартный <> Неопределено Тогда 
		БазоваяЦена = ДокументыСервер.ПолучитьЦенуПоЦеновойПолитике(Выборка.ПериодДень, КатегорияНомераСтандартный, Ложь, Ложь);  
		ТЗАналитика[Индекс].БазоваяЦена_ПГ = БазоваяЦена;	
	КонецЕсли;
	
	Загрузка = ?(Выборка.ЗанятыеНомера = 0, "-"
		, Окр(100 * (Выборка.ЗанятыеНомера / Выборка.ОбщееКоличество), 1));	
	ТЗАналитика[Индекс].Загрузка_ПГ = Загрузка;	
	
	Дата_ПГ = Выборка.ПериодДень;
	ТЗАналитика[Индекс].Дата_ПГ = Дата_ПГ;	
	
	ДеньНедели_ПГ = ДеньНедели(Выборка.ПериодДень);
	ТЗАналитика[Индекс].ДеньНедели_ПГ = ДеньНедели_ПГ;	
	
	Индекс = Индекс + 1;
КонецЦикла;


// - Предыдущий год

//// + Конкуренты

Запрос = Новый Запрос("ВЫБРАТЬ
                      |	ЦеныКонкурентов.Дата КАК Дата,
                      |	СРЕДНЕЕ(ЦеныКонкурентов.Цена) КАК Цена
                      |ИЗ
                      |	РегистрСведений.ЦеныКонкурентов КАК ЦеныКонкурентов
                      |ГДЕ
                      |	ЦеныКонкурентов.Дата >= &ДатаС
                      |	И ЦеныКонкурентов.Дата <= &ДатаПо
                      |
                      |СГРУППИРОВАТЬ ПО
                      |	ЦеныКонкурентов.Дата
                      |
                      |УПОРЯДОЧИТЬ ПО
                      |	Дата");

Запрос.УстановитьПараметр("ДатаС", ДатаС);					  
Запрос.УстановитьПараметр("ДатаПо", ДатаПо);					  
//Запрос.УстановитьПараметр("НаименованиеОтеля", НаименованиеОтеляАналитика);					  

ТЗ = Запрос.Выполнить().Выгрузить();

Для Каждого Строка Из ТЗ Цикл
	ОтборСтроки = Новый Структура("Дата", Строка.Дата);
	НайденныеСтроки = ТЗАналитика.НайтиСтроки(ОтборСтроки);
	НайденнаяСтрока = НайденныеСтроки[0]; 
	НайденнаяСтрока.ЦенаКонкурентов = Строка.Цена;
КонецЦикла;
// - Цена

//// + Цена Средние цены
//Запрос = Новый Запрос("ВЫБРАТЬ
//                      |	ЦеныКонкурентовАналитика.ДатаЗадания КАК ДатаЗадания,
//                      |	ЦеныКонкурентовАналитика.Дата КАК Дата,
//                      |	ЦеныКонкурентовАналитика.Цена КАК Цена,
//                      |	ЦеныКонкурентовАналитика.СреднийADR КАК СреднийADR,
//                      |	ЦеныКонкурентовАналитика.ЗанятоПроцент КАК ЗанятоПроцент
//                      |ИЗ
//                      |	РегистрСведений.ЦеныКонкурентовАналитика КАК ЦеныКонкурентовАналитика
//                      |		ЛЕВОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
//                      |			МАКСИМУМ(ЦеныКонкурентовАналитика.ДатаЗадания) КАК ДатаЗадания,
//                      |			ЦеныКонкурентовАналитика.Дата КАК Дата
//                      |		ИЗ
//                      |			РегистрСведений.ЦеныКонкурентовАналитика КАК ЦеныКонкурентовАналитика
//                      |		
//                      |		СГРУППИРОВАТЬ ПО
