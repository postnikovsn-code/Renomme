    </notDefaultUseAlwaysAttributes>
    <main>true</main>
    <extInfo xsi:type="form:DynamicListExtInfo">
      <queryText>ВЫБРАТЬ
	ДокументЗаявкаНаБронирование.Ссылка КАК Ссылка,
	ДокументЗаявкаНаБронирование.ПометкаУдаления КАК ПометкаУдаления,
	ДокументЗаявкаНаБронирование.Номер КАК Номер,
	ДокументЗаявкаНаБронирование.Дата КАК Дата,
	ДокументЗаявкаНаБронирование.Проведен КАК Проведен,
	ДокументЗаявкаНаБронирование.АвторЗаявки КАК АвторЗаявки,
	ДокументЗаявкаНаБронирование.БезЗавтрака КАК БезЗавтрака,
	ДокументЗаявкаНаБронирование.Бронирует КАК Бронирует,
	ДокументЗаявкаНаБронирование.ВремяВыезда КАК ВремяВыезда,
	ДокументЗаявкаНаБронирование.ВремяВыездаТочное КАК ВремяВыездаТочное,
	ДокументЗаявкаНаБронирование.ВремяЗаезда КАК ВремяЗаезда,
	ДокументЗаявкаНаБронирование.ВремяЗаездаТочное КАК ВремяЗаездаТочное,
	ДокументЗаявкаНаБронирование.ВСчет КАК ВСчет,
	ДокументЗаявкаНаБронирование.ДатаАннуляции КАК ДатаАннуляции,
	ДокументЗаявкаНаБронирование.ЗаявкаПереселениеНовая КАК ЗаявкаПереселениеНовая,
	ДокументЗаявкаНаБронирование.ЗаявкаПереселениеСтарая КАК ЗаявкаПереселениеСтарая,
	ДокументЗаявкаНаБронирование.КаналБронирования КАК КаналБронирования,
	ДокументЗаявкаНаБронирование.КатегорияНомера КАК КатегорияНомера,
	ДокументЗаявкаНаБронирование.Клиент КАК Клиент,
	ДокументЗаявкаНаБронирование.Клиент2 КАК Клиент2,
	ДокументЗаявкаНаБронирование.КолВоДней КАК КолВоДней,
	ДокументЗаявкаНаБронирование.КолВоЧеловек КАК КолВоЧеловек,
	ДокументЗаявкаНаБронирование.Курящий КАК Курящий,
	ДокументЗаявкаНаБронирование.НовыйРассчет КАК НовыйРассчет,
	ДокументЗаявкаНаБронирование.НомерВРезерв КАК НомерВРезерв,
	ДокументЗаявкаНаБронирование.НомерЧека КАК НомерЧека,
	ДокументЗаявкаНаБронирование.Оплачено КАК Оплачено,
	ДокументЗаявкаНаБронирование.Оплачивает КАК Оплачивает,
	ДокументЗаявкаНаБронирование.ПеременныйТариф КАК ПеременныйТариф,
	ДокументЗаявкаНаБронирование.Примечание КАК Примечание,
	ДокументЗаявкаНаБронирование.РазделитьСчет КАК РазделитьСчет,
	ДокументЗаявкаНаБронирование.РаздельныеКровати КАК РаздельныеКровати,
	ДокументЗаявкаНаБронирование.РезервПо КАК РезервПо,
	ДокументЗаявкаНаБронирование.РезервС КАК РезервС,
	ДокументЗаявкаНаБронирование.СвернутьВСчете КАК СвернутьВСчете,
	ДокументЗаявкаНаБронирование.Статус КАК Статус,
	ДокументЗаявкаНаБронирование.Сумма КАК Сумма,
	ДокументЗаявкаНаБронирование.Тариф_НеИспользуется КАК Тариф_НеИспользуется,
	ДокументЗаявкаНаБронирование.Турагентство КАК Турагентство,
	ДокументЗаявкаНаБронирование.ЦветB КАК ЦветB,
	ДокументЗаявкаНаБронирование.ЦветG КАК ЦветG,
	ДокументЗаявкаНаБронирование.ЦветR КАК ЦветR,
	ДолгСумма.СуммаДолг КАК СуммаДолг,
	ОплатыСумма.СуммаОплаты КАК СуммаОплаты,
	ДолгСумма.СуммаДолг - ЕСТЬNULL(ОплатыСумма.СуммаОплаты, 0) КАК Остаток,
	ДокументЗаявкаНаБронирование.ЛистОжидания КАК ЛистОжидания,
	ДокументЗаявкаНаБронирование.Закрыто КАК Закрыто,
	ДолгСуммаПроживание.Сумма КАК ДолгСуммаПроживание,
	ОплатыСуммаПроживание.СуммаОплаты КАК СуммаОплатыПроживание,
	ЕСТЬNULL(ДолгСуммаПроживание.Сумма, 0) - ЕСТЬNULL(ОплатыСуммаПроживание.СуммаОплаты, 0) КАК ОстатокПроживание
ИЗ
	Документ.ЗаявкаНаБронирование КАК ДокументЗаявкаНаБронирование
		ЛЕВОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
			ЗаявкаНаБронированиеСчетаДетальноДолги.Ссылка КАК Ссылка,
			СУММА(ЗаявкаНаБронированиеСчетаДетальноДолги.СуммаДолг) КАК СуммаДолг
		ИЗ
			Документ.ЗаявкаНаБронирование.СчетаДетальноДолги КАК ЗаявкаНаБронированиеСчетаДетальноДолги
		
		СГРУППИРОВАТЬ ПО
			ЗаявкаНаБронированиеСчетаДетальноДолги.Ссылка) КАК ДолгСумма
		ПО ДокументЗаявкаНаБронирование.Ссылка = ДолгСумма.Ссылка
		ЛЕВОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
			ЗаявкаНаБронированиеСчетаДетальноОплаты.Ссылка КАК Ссылка,
			СУММА(ЗаявкаНаБронированиеСчетаДетальноОплаты.СуммаРаспределено) КАК СуммаОплаты
		ИЗ
			Документ.ЗаявкаНаБронирование.СчетаДетальноОплаты КАК ЗаявкаНаБронированиеСчетаДетальноОплаты
		
		СГРУППИРОВАТЬ ПО
			ЗаявкаНаБронированиеСчетаДетальноОплаты.Ссылка) КАК ОплатыСумма
		ПО ДокументЗаявкаНаБронирование.Ссылка = ОплатыСумма.Ссылка
		ЛЕВОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
			ЗаявкаНаБронированиеСчетаДетальноДолги.Ссылка КАК Ссылка,
			СУММА(ЗаявкаНаБронированиеСчетаДетальноДолги.СуммаДолг) КАК Сумма
		ИЗ
			Документ.ЗаявкаНаБронирование.СчетаДетальноДолги КАК ЗаявкаНаБронированиеСчетаДетальноДолги
		ГДЕ
			ЗаявкаНаБронированиеСчетаДетальноДолги.Услуга = ЛОЖЬ
		
		СГРУППИРОВАТЬ ПО
			ЗаявкаНаБронированиеСчетаДетальноДолги.Ссылка) КАК ДолгСуммаПроживание
		ПО ДокументЗаявкаНаБронирование.Ссылка = ДолгСуммаПроживание.Ссылка
		ЛЕВОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
			ЗаявкаНаБронированиеРаспределениеОплатДолги.Ссылка КАК Ссылка,
			СУММА(ЗаявкаНаБронированиеРаспределениеОплатДолги.СуммаОплаты) КАК СуммаОплаты
		ИЗ
			Документ.ЗаявкаНаБронирование.РаспределениеОплатДолги КАК ЗаявкаНаБронированиеРаспределениеОплатДолги
		ГДЕ
			ЗаявкаНаБронированиеРаспределениеОплатДолги.Услуга = ЛОЖЬ
		
		СГРУППИРОВАТЬ ПО
			ЗаявкаНаБронированиеРаспределениеОплатДолги.Ссылка) КАК ОплатыСуммаПроживание
		ПО ДокументЗаявкаНаБронирование.Ссылка = ОплатыСуммаПроживание.Ссылка</queryText>
      <mainTable>Document.ЗаявкаНаБронирование</mainTable>
      <autoFillAvailableFields>true</autoFillAvailableFields>
      <customQuery>true</customQuery>
      <autoSaveUserSettings>true</autoSaveUserSettings>
      <getInvisibleFieldPresentations>true</getInvisibleFieldPresentations>
    </extInfo>
