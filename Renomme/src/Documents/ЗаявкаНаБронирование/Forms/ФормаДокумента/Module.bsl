                         |		ЛЕВОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
                         |			ЗаявкаНаБронированиеСчетаДетальноОплаты.ДокументОплаты КАК ДокументОплаты,
                         |			ЗаявкаНаБронированиеСчетаДетальноОплаты.Ссылка КАК ДокументДолг
                         |		ИЗ
                         |			Документ.ЗаявкаНаБронирование.СчетаДетальноОплаты КАК ЗаявкаНаБронированиеСчетаДетальноОплаты
                         |		ГДЕ
                         |			НЕ ЗаявкаНаБронированиеСчетаДетальноОплаты.Ссылка.ПометкаУдаления
                         |			И ЗаявкаНаБронированиеСчетаДетальноОплаты.Ссылка = &ДокументДолг) КАК ЗаявкаНаБронированиеСчетаДетальноОплаты
                         |		ПО КассовыйДокумент.Ссылка = ЗаявкаНаБронированиеСчетаДетальноОплаты.ДокументОплаты
                         |		ЛЕВОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
                         |			КассовыйДокумент.ВозвратДокумент КАК ВозвратДокумент,
                         |			СУММА(КассовыйДокумент.Сумма) КАК Сумма
                         |		ИЗ
                         |			Документ.КассовыйДокумент КАК КассовыйДокумент
                         |		ГДЕ
                         |			КассовыйДокумент.ПометкаУдаления = ЛОЖЬ
                         |		
                         |		СГРУППИРОВАТЬ ПО
                         |			КассовыйДокумент.ВозвратДокумент) КАК КассовыйДокументВозврат
                         |		ПО КассовыйДокумент.Ссылка = КассовыйДокументВозврат.ВозвратДокумент
                         |ГДЕ
                         |	КассовыйДокумент.ПометкаУдаления = ЛОЖЬ
                         |	И КассовыйДокумент.Приход = ИСТИНА
                         |	И ЗаявкаНаБронированиеСчетаДетальноОплаты.ДокументОплаты ЕСТЬ NULL
                         |	И КассовыйДокумент.ДокументДолг = &ДокументДолг
                         |
                         |ОБЪЕДИНИТЬ ВСЕ
                         |
                         |ВЫБРАТЬ
                         |	""Касса Возврат"",
                         |	КассовыйДокументВозврат.Ссылка,
                         |	КассовыйДокументВозврат.Дата,
                         |	КассовыйДокументВозврат.ДатаОплаты,
                         |	КассовыйДокументВозврат.ОтКого,
                         |	&ДокументДолг,
                         |	-КассовыйДокументВозврат.Сумма,
                         |	NULL,
                         |	NULL
                         |ИЗ
                         |	Документ.КассовыйДокумент КАК КассовыйДокументВозврат
                         |		ЛЕВОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
                         |			КассовыйДокументДолгиОплаты.Ссылка КАК Ссылка,
                         |			КассовыйДокументДолгиОплаты.ДокументДолг КАК ДокументДолг
                         |		ИЗ
                         |			Документ.КассовыйДокумент.ДолгиОплата КАК КассовыйДокументДолгиОплаты
                         |		ГДЕ
                         |			КассовыйДокументДолгиОплаты.Ссылка.ПометкаУдаления = ЛОЖЬ
                         |			И КассовыйДокументДолгиОплаты.ДокументДолг = &ДокументДолг
                         |		
                         |		СГРУППИРОВАТЬ ПО
                         |			КассовыйДокументДолгиОплаты.Ссылка,
                         |			КассовыйДокументДолгиОплаты.ДокументДолг) КАК КассовыйДокументДолгиОплаты
                         |		ПО КассовыйДокументВозврат.Ссылка = КассовыйДокументДолгиОплаты.Ссылка
                         |		ЛЕВОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
                         |			КассовыйДокумент.Ссылка КАК Ссылка,
                         |			КассовыйДокумент.ДокументДолг КАК ДокументДолг
                         |		ИЗ
                         |			Документ.КассовыйДокумент КАК КассовыйДокумент
                         |		ГДЕ
                         |			КассовыйДокумент.Ссылка.ПометкаУдаления = ЛОЖЬ
                         |			И КассовыйДокумент.ДокументДолг = &ДокументДолг) КАК КассовыйДокумент
                         |		ПО КассовыйДокументВозврат.Ссылка = КассовыйДокумент.Ссылка
                         |ГДЕ
                         |	КассовыйДокументВозврат.ПометкаУдаления = ЛОЖЬ
                         |	И КассовыйДокументВозврат.Возврат = ИСТИНА
                         |	И НЕ(КассовыйДокументДолгиОплаты.Ссылка ЕСТЬ NULL
                         |				И КассовыйДокумент.Ссылка ЕСТЬ NULL)
                         |
                         |ОБЪЕДИНИТЬ ВСЕ
                         |
                         |ВЫБРАТЬ
                         |	""ПрочиеОплаты"",
                         |	ПрочиеОплаты.Ссылка,
                         |	ПрочиеОплаты.Дата,
                         |	ПрочиеОплаты.ДатаОплаты,
                         |	ПрочиеОплаты.ОтКого,
                         |	ПрочиеОплаты.Сумма,
                         |	NULL,
                         |	ЗаявкаНаБронированиеСчетаДетальноОплаты.ДокументДолг,
                         |	ЗаявкаНаБронированиеСчетаДетальноОплаты.Сумма
                         |ИЗ
                         |	Документ.ПрочиеОплаты КАК ПрочиеОплаты
                         |		ВНУТРЕННЕЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
                         |			ЗаявкаНаБронированиеСчетаДетальноОплаты.ДокументОплаты КАК ДокументОплаты,
                         |			ЗаявкаНаБронированиеСчетаДетальноОплаты.Ссылка КАК ДокументДолг,
                         |			СУММА(ЗаявкаНаБронированиеСчетаДетальноОплаты.СуммаРаспределено) КАК Сумма
                         |		ИЗ
                         |			Документ.ЗаявкаНаБронирование.СчетаДетальноОплаты КАК ЗаявкаНаБронированиеСчетаДетальноОплаты
                         |		ГДЕ
                         |			НЕ ЗаявкаНаБронированиеСчетаДетальноОплаты.Ссылка.ПометкаУдаления
                         |			И ЗаявкаНаБронированиеСчетаДетальноОплаты.Ссылка = &ДокументДолг
                         |		
                         |		СГРУППИРОВАТЬ ПО
                         |			ЗаявкаНаБронированиеСчетаДетальноОплаты.ДокументОплаты,
                         |			ЗаявкаНаБронированиеСчетаДетальноОплаты.Ссылка) КАК ЗаявкаНаБронированиеСчетаДетальноОплаты
                         |		ПО ПрочиеОплаты.Ссылка = ЗаявкаНаБронированиеСчетаДетальноОплаты.ДокументОплаты
                         |ГДЕ
                         |	ПрочиеОплаты.ПометкаУдаления = ЛОЖЬ
                         |	И ПрочиеОплаты.Приход = ИСТИНА");

ЗапросОплат.УстановитьПараметр("ДокументДолг",Объект.Ссылка);
ТЗОпл=ЗапросОплат.Выполнить().Выгрузить();

Для Каждого СтрОпл из ТЗОпл цикл
	НовОпл=ИсторияОплат.Добавить();
	
	ЗаполнитьЗначенияСвойств(НовОпл, СтрОпл); 
	//НовОпл.Дата =СтрОпл.Дата;
	//НовОпл.ДатаОплаты=СтрОпл.ДатаОплаты;
	//НовОпл.СуммаОплаты=СтрОпл.Сумма;
	//НовОпл.ВидОплаты=СтрОпл.Вид;
	//НовОпл.Оплатил=СтрОпл.ОтКого;
	//НовОпл.Аванс=СтрОпл.Аванс;
	//
	//НовОпл.Возврат=СтрОпл.Возврат;
	//НовОпл.Отмена=СтрОпл.Отмена;
КонецЦикла;

ИсторияОплат.Сортировать("ДатаОплаты, ДатаДокумента");
КонецПроцедуры
