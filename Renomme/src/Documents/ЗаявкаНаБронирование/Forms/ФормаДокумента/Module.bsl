&НаКлиенте
Процедура БронируетПриИзменении(Элемент)
ПроверкаКонтрагента(Объект.Бронирует);
	
Если ПереместитьКонтрагентаИзАрхива(Объект.Бронирует, Элемент) Тогда Возврат; КонецЕсли; 

БронируетПриИзмененииОбработка(Элемент);
КонецПроцедуры

&НаКлиенте
Асинх Процедура БронируетПриИзмененииОбработка(Элемент)
Бронирует_OldValue = Бронирует_OldValue();	
Если Объект.Бронирует = Бронирует_OldValue Тогда Возврат; КонецЕсли;

ИмяРеквизитаКонтрагент = "'Бронирует'";

Если ЗначениеЗаполнено(Объект.Бронирует) Тогда
	БронируетЧС = ОбщийФункционалСервер.ПолучитьЗначениеРеквизитаНаСервере(Объект.Бронирует, "ЧС");
	Если БронируетЧС тогда
		ПоказатьПредупреждение(, "Внимание! " + ИмяРеквизитаКонтрагент + " в черном списке!");
	КонецЕсли;	
КонецЕсли;

Если ПроверкаИзмененияКонтрагентаГрупповойСчет(Объект.Бронирует, Бронирует_OldValue, ИмяРеквизитаКонтрагент) Тогда
	Объект.Бронирует = Бронирует_OldValue;
	Возврат; 
КонецЕсли;	

Ответ = Ждать ПроверкаИзмененияСкидки(Объект.Бронирует, Бронирует_OldValue, ИмяРеквизитаКонтрагент);
Если Ответ.Запрещено Тогда 
	Объект.Бронирует = Бронирует_OldValue;
	Возврат; 
КонецЕсли;
                                                                               
ЗаменитьСкидку = Ответ.ЗаменитьСкидку;

МассивКасса = Новый Массив;

Ответ = Ждать ПодтвердитеЗаменуКонтрагента(Объект.Бронирует, Бронирует_OldValue, ИмяРеквизитаКонтрагент, МассивКасса, ЗаменитьСкидку);
Если Ответ Тогда 
	Объект.Бронирует = Бронирует_OldValue;
	Возврат; 
КонецЕсли;

УстановитьПроцентыВ2В();

Если ЗаменитьСкидку Тогда
	ЗаменаПроцентСкидки();
КонецЕсли;

БронируетТурагентство = ОбщийФункционалСервер.ЗначениеРеквизитаНаСервере(Объект.Бронирует, "Турагентство");
Элементы.ГруппаЧекАгенту.Доступность = БронируетТурагентство; 

КонецПроцедуры

