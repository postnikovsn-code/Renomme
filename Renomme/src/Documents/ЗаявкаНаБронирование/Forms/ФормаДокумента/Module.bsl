		ТекстВопроса = "Отправить СМС на номер " + КлиентТелефон + "?"; 
		ПоказатьВопрос(Оповещение, ТекстВопроса, РежимДиалогаВопрос.ДаНет); 
		
	Иначе
		ПоказатьПредупреждение(, "Необходимо заполнить поле ""Проживает""");
		
	КонецЕсли;	
иначе
