&НаКлиенте
Процедура ПредупреждениеЕстьТакиеПлатежи()
Ответ = ПолучитьПараметрыЧекаЗапрос(ДокументДолг, СуммаКарта); 	

ЕстьТакиеПлатежи = Ложь;
Если ТипЗнч(Ответ) = Тип("Структура") Тогда
	ЕстьТакиеПлатежи = Истина;
Иначе
	ЕстьТакиеПлатежи = (Ответ = "+"); 
КонецЕсли;

Если ЕстьТакиеПлатежи Тогда
	Оповещение = Новый ОписаниеОповещения("ЗавершениеВопроса_ЕстьПлатежиПоЗаявке", ЭтаФорма);
	ПоказатьВопрос(Оповещение, "ВНИМАНИЕ: Есть платежи по заявке на сумму: " + СуммаКарта + "
		|
		|ПРОДОЛЖИТЬ ?"
		, РежимДиалогаВопрос.ОКОтмена);
	Возврат;
КонецЕсли;

ОплатитьКартаВыполнить();
КонецПроцедуры

