&НаСервере
Функция КвитокПечатьНаСервере(ТС)
ТабДок = Новый ТабличныйДокумент;
	
ТД = Объект.Зарплата.НайтиПоИдентификатору(ТС);

Макет = Документы.ГорничныеЗарплата.ПолучитьМакет("МакетКвиток");

Область = Макет.ПолучитьОбласть("Шапка");
Область.Параметры.Горничная = ТД.Горничная;

ТабДок.Вывести(Область);
Область.Параметры.Горничная = ТД.Горничная;

Область = Макет.ПолучитьОбласть("Строка");
Область.Параметры.Наименование = "Количество смен";
Область.Параметры.Количество  = ТД.КоличествоСмен_Э;
//Область.Параметры.Сумма  = ТД.
ТабДок.Вывести(Область);

Область = Макет.ПолучитьОбласть("Строка");
ТабДок.Вывести(Область);

Область = Макет.ПолучитьОбласть("Строка");
Область.Параметры.Наименование = "Генеральные";
Область.Параметры.Количество  = ТД.Г_Количество_Э;
Область.Параметры.Сумма  = ТД.Г_Сумма;
ТабДок.Вывести(Область);

Область = Макет.ПолучитьОбласть("Строка");
Область.Параметры.Наименование = "Текущие";
Область.Параметры.Количество  = ТД.Т_Количество_Э;
Область.Параметры.Сумма  = ТД.Т_Сумма;
ТабДок.Вывести(Область);

Область = Макет.ПолучитьОбласть("Строка");
Область.Параметры.Наименование = "Текущие со сменой";
Область.Параметры.Количество  = ТД.ТС_Количество_Э;
Область.Параметры.Сумма  = ТД.ТС_Сумма;
ТабДок.Вывести(Область);

Область = Макет.ПолучитьОбласть("Строка");
Область.Параметры.Наименование = "МК";
Область.Параметры.Количество  = ТД.МК_Количество_Э;
Область.Параметры.Сумма  = ТД.МК_Сумма;
ТабДок.Вывести(Область);

Область = Макет.ПолучитьОбласть("Строка");
Область.Параметры.Наименование = "МДМ";
Область.Параметры.Количество  = ТД.МДМ_Количество_Э;
Область.Параметры.Сумма  = ТД.МДМ_Сумма;
ТабДок.Вывести(Область);

Область = Макет.ПолучитьОбласть("Строка");
ТабДок.Вывести(Область);

Область = Макет.ПолучитьОбласть("Строка");
Область.Параметры.Наименование = "Оклад";
//Область.Параметры.Количество  = ТД.;
Область.Параметры.Сумма  = ТД.Оклад_Э;
ТабДок.Вывести(Область);

Область = Макет.ПолучитьОбласть("Строка");
Область.Параметры.Наименование = "Отпуск";
//Область.Параметры.Количество  = ТД.;
Область.Параметры.Сумма  = ТД.Отпуск_Э;
ТабДок.Вывести(Область);

Область = Макет.ПолучитьОбласть("Строка");
Область.Параметры.Наименование = "Стаж";
//Область.Параметры.Количество  = ТД.;
Область.Параметры.Сумма  = ТД.НадбавкаЗаСтаж_Э;
ТабДок.Вывести(Область);

Область = Макет.ПолучитьОбласть("Строка");
Область.Параметры.Наименование = "Стандарты";
//Область.Параметры.Количество  = ТД.;
Область.Параметры.Сумма  = ТД.НадбавкаЗаСтандарты_Э;
ТабДок.Вывести(Область);

Область = Макет.ПолучитьОбласть("Строка");
Область.Параметры.Наименование = "Больничный";
//Область.Параметры.Количество  = ТД.;
Область.Параметры.Сумма  = ТД.Больничный;
ТабДок.Вывести(Область);

Область = Макет.ПолучитьОбласть("Строка");
Область.Параметры.Наименование = "Премия";
//Область.Параметры.Количество  = ТД.;
Область.Параметры.Сумма  = ТД.Премия;
ТабДок.Вывести(Область);

Область = Макет.ПолучитьОбласть("Строка");
Область.Параметры.Наименование = "Доп. работы";
//Область.Параметры.Количество  = ТД.;
Область.Параметры.Сумма  = ТД.ДопРаботы;
ТабДок.Вывести(Область);

Область = Макет.ПолучитьОбласть("Строка");
ТабДок.Вывести(Область);

ОтборСтроки = Новый Структура("Горничная", ТД.Горничная); 
НайденныеСтроки = Объект.ЗарплатаПомещения.НайтиСтроки(ОтборСтроки);

Для Каждого НайденнаяСтрока Из НайденныеСтроки Цикл 
	Область = Макет.ПолучитьОбласть("Строка");
	Область.Параметры.Наименование = НайденнаяСтрока.Помещение;
	
	Количество_П = НайденнаяСтрока.Количество + НайденнаяСтрока.Количество_Р;
	Область.Параметры.Количество  = Количество_П;
	
	ОтборСтрокиПомещенияЦена = Новый Структура("Помещение", НайденнаяСтрока.Помещение); 
	НайденныеСтрокиПомещенияЦена = ПомещенияЦена.НайтиСтроки(ОтборСтрокиПомещенияЦена);
	Если НайденныеСтрокиПомещенияЦена.Количество() > 0 Тогда
		Сумма = Количество_П * НайденныеСтрокиПомещенияЦена[0].Цена; 
		Область.Параметры.Сумма  = Сумма;
	КонецЕсли;
	ТабДок.Вывести(Область);
КонецЦикла;

Область = Макет.ПолучитьОбласть("Строка");
ТабДок.Вывести(Область);

Область = Макет.ПолучитьОбласть("Строка");
Область.Параметры.Наименование = "Сдельно";
//Область.Параметры.Количество  = ТД.;
Область.Параметры.Сумма  = ТД.Сдельно;
ТабДок.Вывести(Область);

Область = Макет.ПолучитьОбласть("Строка");
Область.Параметры.Наименование = "Прачечная";
//Область.Параметры.Количество  = ТД.;
Область.Параметры.Сумма  = ТД.СуммаПрачечная_Э;
ТабДок.Вывести(Область);

Область = Макет.ПолучитьОбласть("Строка");
ТабДок.Вывести(Область);

Область = Макет.ПолучитьОбласть("Строка");
Область.Параметры.Наименование = "Корректировка доп. начисл.";
//Область.Параметры.Количество  = ТД.;
Область.Параметры.Сумма  = ТД.КорректировкаДопНачислено;
ТабДок.Вывести(Область);

Область = Макет.ПолучитьОбласть("Строка");
Область.Параметры.Наименование = "СУММА ИТОГО";
//Область.Параметры.Количество  = ТД.;
Область.Параметры.Сумма  = ТД.ЗарплатаИтого;
Область.Область(1,1,1,3).Шрифт = Новый Шрифт(, 12, Истина);
ТабДок.Вывести(Область);

Область = Макет.ПолучитьОбласть("Строка");
ТабДок.Вывести(Область);

Область = Макет.ПолучитьОбласть("Строка");
Область.Параметры.Наименование = "Аванс кк";
//Область.Параметры.Количество  = ТД.;
Область.Параметры.Сумма  = ТД.Аванс_кк;
ТабДок.Вывести(Область);

Область = Макет.ПолучитьОбласть("Строка");
Область.Параметры.Наименование = "Аванс нал";
//Область.Параметры.Количество  = ТД.;
Область.Параметры.Сумма  = ТД.Аванс_нал;
ТабДок.Вывести(Область);

Область = Макет.ПолучитьОбласть("Строка");
Область.Параметры.Наименование = "Зарплата кк";
//Область.Параметры.Количество  = ТД.;
Область.Параметры.Сумма  = ТД.Зарплата_кк;
ТабДок.Вывести(Область);

Область = Макет.ПолучитьОбласть("Строка");
Область.Параметры.Наименование = "Отпуск кк";
//Область.Параметры.Количество  = ТД.;
Область.Параметры.Сумма  = ТД.Отпуск_кк;
ТабДок.Вывести(Область);

Область = Макет.ПолучитьОбласть("Строка");
Область.Параметры.Наименование = "Отпуск нал";
//Область.Параметры.Количество  = ТД.;
Область.Параметры.Сумма  = ТД.Отпуск_нал;
ТабДок.Вывести(Область);

Область = Макет.ПолучитьОбласть("Строка");
Область.Параметры.Наименование = "Сдельно нал";
//Область.Параметры.Количество  = ТД.;
Область.Параметры.Сумма  = ТД.Сдельно_нал;
ТабДок.Вывести(Область);

Область = Макет.ПолучитьОбласть("Строка");
Область.Параметры.Наименование = "Иные выплаты нал";
//Область.Параметры.Количество  = ТД.;
Область.Параметры.Сумма  = ТД.ИныеВыплаты_нал;
ТабДок.Вывести(Область);

Область = Макет.ПолучитьОбласть("Строка");
Область.Параметры.Наименование = "ОСТАТОК К ВЫДАЧЕ";
//Область.Параметры.Количество  = ТД.;
Область.Параметры.Сумма  = ТД.ОстатокКВыдаче;
Область.Область(1,1,1,3).Шрифт = Новый Шрифт(, 12, Истина);
ТабДок.Вывести(Область);

Возврат ТабДок;
КонецФункции
