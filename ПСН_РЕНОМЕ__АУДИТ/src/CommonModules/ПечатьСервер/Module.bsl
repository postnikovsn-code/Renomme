Функция ТабличныйДокументСчет(ДокументДолгСсылка, Счет) Экспорт
ТабличныйДокумент = Новый ТабличныйДокумент;
 
Результат = ПечатьСервер.ПечатьСчета_Счет(ТабличныйДокумент, ДокументДолгСсылка, Счет);

ТабличныйДокумент.ОтображатьСетку = Ложь;
ТабличныйДокумент.Защита = Ложь;
ТабличныйДокумент.ТолькоПросмотр = Истина;
ТабличныйДокумент.ОтображатьЗаголовки = Ложь;

Возврат ТабличныйДокумент;	
КонецФункции	

Функция ПечатьСчета_Счет(ТабДок, ДокументДолгСсылка, Счет) Экспорт
//ИменаМакетовСчетов = ИменаМакетовСчетов();	
//МакСчет = ИменаМакетовСчетов.МакСчет;
//МакСчетФЛ = ИменаМакетовСчетов.МакСчетФЛ;
	
Оплачивает = Счет.Контрагент;	
Если Оплачивает.ТипКлиента = Перечисления.ТипыКлиентов.ПустаяСсылка() Тогда
	Сообщить("У клиента: " + Оплачивает + " не заполнен 'Тип клиента'. ПЕЧАТЬ СЧЕТА ОТМЕНЯЕТСЯ ...");
	
	Возврат Истина;
КонецЕсли;

ОплачиваетЮрЛицо = КлиентыСервер.ЭтоЮрЛицо(Оплачивает);
Если ОплачиваетЮрЛицо Тогда
	//МакетЮрЛицо = ПолучитьМакетДокументаЗаявкаНаБронирование(МакСчет);
	МакетЮрЛицо = ПолучитьОбщийМакет("СчетЮрЛицо");
	
	ПечатьСчетаЮрЛицо_Счет(ТабДок, МакетЮрЛицо, ДокументДолгСсылка, Счет); 
Иначе	
	//МакетФизЛицо = ПолучитьМакетДокументаЗаявкаНаБронирование(МакСчетФЛ);
	МакетФизЛицо = ПолучитьОбщийМакет("СчетФизЛицо");

	ПечатьСчетаФизЛицо_Счет(ТабДок, МакетФизЛицо, ДокументДолгСсылка, Счет);
КонецЕсли;

Возврат ТабДок;
КонецФункции	

//
Процедура ПечатьСчетаЮрЛицо_Счет(ТабДок, Макет, ДокументДолгСсылка, Счет) Экспорт
НомерДокумента = НомерСчетаДляПечати(ДокументДолгСсылка.Номер, Счет.НомерСчета);
ДатаДокумента = Счет.ДатаСчета;

УчитыватьНДС = ДокументыСервер.УчитыватьНДС(Счет.ДатаПо);

Контрагент = Счет.Контрагент;

ТекстЗаголовка = ПечатьСчетаЮрЛицоШапка_Счет(ТабДок, Макет, НомерДокумента, ДатаДокумента, Контрагент);

СчетчикСтрок = 0; СуммаДляПечатиОбщая = 0; 
ПечатьДокументаТело(ТабДок, Макет, СчетчикСтрок, СуммаДляПечатиОбщая, ДокументДолгСсылка, Счет, УчитыватьНДС, Истина);

ПечатьСчетаЮрЛицоПодвал_Счет(ТабДок, Макет); 
КонецПроцедуры

Функция ПечатьСчетаЮрЛицоШапка_Счет(ТабДок, Макет, НомерДокумента, ДатаДокумента, Контрагент)  Экспорт  

ТекущаяОрганизация = НастройкиСервер.ПолучитьТекущуюОрганизацию();

Область = Макет.ПолучитьОбласть("ЗаголовокСчета");
Область.Параметры.БанкПолучателя = ТекущаяОрганизация.СчетЮрЛицоБанкПолучателя;
Область.Параметры.БИКБанкаПолучателя = ТекущаяОрганизация.СчетЮрЛицоБИКБанкаПолучателя;
Область.Параметры.КорСчетБанкаПолучателя = ТекущаяОрганизация.СчетЮрЛицоКорСчетБанкаПолучателя;
Область.Параметры.СчетБанкаПолучателя = ТекущаяОрганизация.СчетЮрЛицоСчетБанкаПолучателя;
Область.Параметры.ЗаголовокИНН = ТекущаяОрганизация.ИНН;
Область.Параметры.ЗаголовокКПП = ТекущаяОрганизация.КПП;

//Область.Параметры.Получатель = ТекущаяОрганизация.ОрганизацияДляДокументов;
Область.Параметры.Получатель = "Гостиница " + ТекущаяОрганизация.НаименованииеОтеляДляДокументов 
	+ " ИНН " + ТекущаяОрганизация.ИНН + " КПП " + ТекущаяОрганизация.КПП
	+ " " + ТекущаяОрганизация.ОрганизацияДляДокументов;

ТабДок.Вывести(Область);

Область = Макет.ПолучитьОбласть("Заголовок");
ТекстЗаголовка="Счет № " + НомерДокумента + " от " + Формат(ДатаДокумента, "ДФ=dd.MM.yy");	
Область.Параметры.ТекстЗаголовка = ТекстЗаголовка;

Область.Параметры.Поставщик = "Гостиница " + ТекущаяОрганизация.НаименованииеОтеляДляДокументов 
	+ " ИНН " + ТекущаяОрганизация.ИНН + " КПП " + ТекущаяОрганизация.КПП
	+ " " + ТекущаяОрганизация.ОрганизацияДляДокументов
	+ " " + ТекущаяОрганизация.ОрганизацияАдресДляДокументов;	
ТабДок.Вывести(Область);

Область = Макет.ПолучитьОбласть("Поставщик");
ПредставлениеПолучателя = ОбщееСервер.ПолучитьПредставлениеКлиента(Контрагент);
Область.Параметры.ПредставлениеПолучателя = ПредставлениеПолучателя;
ТабДок.Вывести(Область);

Возврат ТекстЗаголовка;  
КонецФункции

Процедура ПечатьСчетаЮрЛицоПодвал_Счет(ТабДок, Макет) 
ТекущаяОрганизация = НастройкиСервер.ПолучитьТекущуюОрганизацию();

ИтогоСтр=Макет.ПолучитьОбласть("ПодвалСчета");
ИтогоСтр.Параметры.Руководитель = ТекущаяОрганизация.ОрганизацияФИОРуководительДляДокументов; 
ИтогоСтр.Параметры.Бухгалтер = ТекущаяОрганизация.ОрганизацияФИОБухгалтерДляДокументов; 
ТабДок.Вывести(ИтогоСтр);

Папка_C_BASE = ОбщееСервер.КаталогИБ();
Печать = Неопределено;
//Если НастройкиСервер.ЭтоРеноме() Тогда
//	Печать = Новый Картинка(Папка_C_BASE + "ОбразцыДокументов\Печать ГУК.png"); 
//ИначеЕсли НастройкиСервер.ЭтоСтритАрт() Тогда
//	Печать = Новый Картинка(Папка_C_BASE + "ОбразцыДокументов\Печать Новые отели.bmp"); 
//ИначеЕсли НастройкиСервер.ЭтоДомСоветов() 
//ИЛИ НастройкиСервер.ЭтоЧехов() 
//ИЛИ НастройкиСервер.ЭтоЛайв() 
//Тогда
//	Печать = Новый Картинка(Папка_C_BASE + "ОбразцыДокументов\Печать АГ.png"); 
//КонецЕсли;	
Если НастройкиСервер.ЭтоРеноме() Тогда
	Печать = Новый Картинка(Папка_C_BASE + "ОбразцыДокументов\Печать ГУК.png"); 
ИначеЕсли НастройкиСервер.ЭтоСтритАрт() 
ИЛИ НастройкиСервер.ЭтоДомСоветов()
Тогда
	Печать = Новый Картинка(Папка_C_BASE + "ОбразцыДокументов\Печать Новые отели.bmp"); 
ИначеЕсли НастройкиСервер.ЭтоЧехов() 
ИЛИ НастройкиСервер.ЭтоЛайв() 
Тогда
	Печать = Новый Картинка(Папка_C_BASE + "ОбразцыДокументов\Печать АГ.png"); 
КонецЕсли;	
Если Печать <> Неопределено Тогда
	ОбластьКартинка=Макет.ПолучитьОбласть("ОбластьКартинка");  
	ОбластьКартинка.Рисунки.Печать.Картинка  = Печать; 
	ТабДок.Вывести(ОбластьКартинка); 
КонецЕсли;	
КонецПроцедуры
//

//
Процедура ПечатьСчетаФизЛицо_Счет(ТабДок, Макет, ДокументДолгСсылка, Счет) Экспорт
УчитыватьНДС = ДокументыСервер.УчитыватьНДС(Счет.ДатаПо);

НомерДокумента = НомерСчетаДляПечати(ДокументДолгСсылка.Номер, Счет.НомерСчета);
ДатаДокумента = Счет.ДатаСчета;

ТекстЗагловка = ПечатьСчетаФизЛицоШапка_Счет(ТабДок, Макет, НомерДокумента, ДатаДокумента, ДокументДолгСсылка, Счет);	

СчетчикСтрок = 0; СуммаПечатиОбщая = 0; 
ПечатьДокументаТело(ТабДок, Макет, СчетчикСтрок, СуммаПечатиОбщая, ДокументДолгСсылка, Счет, УчитыватьНДС, Истина);

ПечатьСчетаФизЛицоПодвал(ТабДок, Макет);	
КонецПроцедуры

Функция ПечатьСчетаФизЛицоШапка_Счет(ТабДок, Макет, НомерДокумента, ДатаДокумента, ДокументДолгСсылка, Счет) Экспорт
ЭтоГрупповойСчет = (ТипЗнч(ДокументДолгСсылка) = Тип("ДокументСсылка.ГрупповыеСчета"));

Если ЭтоГрупповойСчет Тогда
	Контрагент = ДокументДолгСсылка.Контрагент;
	
Иначе	
	Контрагент = Счет.Контрагент;
	НомерВРезерв = ДокументДолгСсылка.НомерВРезерв;	

	ДатаЗаезда = Счет.ДатаС;
	ДатаВыезда = Счет.ДатаПо;
КонецЕсли;

ТекущаяОрганизация = НастройкиСервер.ПолучитьТекущуюОрганизацию();

Область = Макет.ПолучитьОбласть("ЗаголовокСчета");
СчетФизЛицоЗаголовокСчета = "Гостиница " + ТекущаяОрганизация.НаименованииеОтеляДляДокументов 
	+ " ИНН " + ТекущаяОрганизация.ИНН + " КПП " + ТекущаяОрганизация.КПП
	+ " " + ТекущаяОрганизация.ОрганизацияДляДокументов
	+ Символы.ПС + ТекущаяОрганизация.ОрганизацияАдресДляДокументов;

Область.Параметры.ЗаголовокСчета = СчетФизЛицоЗаголовокСчета;

ТабДок.Вывести(Область);

Область = Макет.ПолучитьОбласть("Заголовок");
Область.Параметры.Поставщик = "Гостиница " + ТекущаяОрганизация.НаименованииеОтеляДляДокументов 
	+ " ИНН " + ТекущаяОрганизация.ИНН + " КПП " + ТекущаяОрганизация.КПП
	+ " " + ТекущаяОрганизация.ОрганизацияДляДокументов
	+ " " + ТекущаяОрганизация.ОрганизацияАдресДляДокументов;	

ТекстЗаголовка="Счет № " + НомерДокумента + " от "+ Формат(ДатаДокумента, "ДФ=dd.MM.yy");
Область.Параметры.ТекстЗаголовка = ТекстЗаголовка;
ТабДок.Вывести(Область);

Если ЗначениеЗаполнено(Контрагент) Тогда 
	Область = Макет.ПолучитьОбласть("Поставщик");
	Область.Параметры.ПредставлениеПолучателя = ОбщееСервер.ПолучитьПредставлениеКлиента(Контрагент);			
	ТабДок.Вывести(Область);
КонецЕсли;

Если НЕ ЭтоГрупповойСчет Тогда
	Область = Макет.ПолучитьОбласть("ЗаездВыезд");
	Область.Параметры.ПредставлениеЗаездВыезд = "Заезд: " + Формат(ДатаЗаезда, "ДФ=dd.MM.yyyy") 
											+ ". Выезд: " + Формат(ДатаВыезда, "ДФ=dd.MM.yyyy"); 
