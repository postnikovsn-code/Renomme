&НаКлиенте
Функция ПоЦентру(ИСтр,ИКолВо)
	КолВо2=ИКолВо;
	Стр=СокрЛП(ИСтр);
	ИзначДлинна=СтрДлина(Стр);
	КолВо2=КолВо2-ИзначДлинна;
	Пока СтрДлина(Стр)<ИзначДлинна+Окр(КолВо2/2) цикл
		Стр="_"+Стр;
	конеццикла;
	
	Пока СтрДлина(Стр)<ИзначДлинна+КолВо2 цикл
		Стр=Стр+"_";
	конеццикла;
	
	Возврат Стр;
	
КонецФункции
