
&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
Если НастройкиСервер.ЭтоРеноме() Тогда	
	ПодтверждениеWORD = Истина;	
КонецЕсли;
	
НаАнглийском = Параметры.НаАнглийском;

ТабличныйДокументПараметр = Параметры.ТабличныйДокумент;
Если ТабличныйДокументПараметр <> Неопределено Тогда ТабличныйДокумент = ТабличныйДокументПараметр; КонецЕсли;  

ДокументДолгСсылка = Параметры.ДокументДолгСсылка;  
СчетГУИД = Параметры.СчетГУИД;  
Контрагент = Параметры.Контрагент;

Если ТабличныйДокументПараметр = Неопределено Тогда 
	Элементы.ФормаОткрытьСчетВEXCEL.Видимость = Ложь; 
	Элементы.ФормаСохранитьСчетВEXCEL.Видимость = Ложь; 
	Элементы.ВключитьСчетВПочту.Видимость = Ложь; 
	ВключитьСчетВПочту = Ложь;
	
	Элементы.ТабличныйДокумент.Видимость = Ложь;
Иначе
	Элементы.ФормаОткрытьСчетВEXCEL.Видимость = Истина; 
	Элементы.ФормаСохранитьСчетВEXCEL.Видимость = Истина; 
	Элементы.ВключитьСчетВПочту.Видимость = Истина; 
	ВключитьСчетВПочту = Истина;
	
	Элементы.ТабличныйДокумент.Видимость = Истина;
КонецЕсли;

ВыводПодтверждения = Неопределено;
Параметры.Свойство("ВыводПодтверждения", ВыводПодтверждения);
Если ВыводПодтверждения = Неопределено Тогда ВыводПодтверждения = Ложь; КонецЕсли;
Элементы.ФормаОткрытьПодтверждение.Видимость = ВыводПодтверждения; 
Элементы.ФормаСоздатьПодтверждение.Видимость = ВыводПодтверждения; 
Элементы.ВключитьПодтверждениеВПочту.Видимость = ВыводПодтверждения; 

////
ЭтаФорма.АвтоЗаголовок = Ложь;
Заголовок = ""; 

Если ВключитьСчетВПочту Тогда Заголовок = Заголовок + "С";  КонецЕсли; 
Если ВключитьСчетВПочту И ВыводПодтверждения Тогда Заголовок = Заголовок + "и"; КонецЕсли;	
Если ВыводПодтверждения Тогда Заголовок = Заголовок + "П"; КонецЕсли;	
Заголовок = Заголовок + ": ";	
ЭтаФорма.Заголовок = Заголовок + Контрагент;

Почта = Контрагент.ЭлПочта;

ПочтаТема = ПочтаТема();
ПочтаТекстСообщения = ПочтаТекстСообщения();

ИмяФайлаСчет = "Счет на оплату " + ПечатьСервер.ДополнениеТекст(ДокументДолгСсылка);
ИмяФайлаПодтверждение = "Подтверждение бронирования " + ПечатьСервер.ДополнениеТекст(ДокументДолгСсылка);
ПолноеИмяФайлаПодтверждение = ПечатьКлиентСервер.ПолноеИмяФайлаПодтверждение(ИмяФайлаПодтверждение, ПодтверждениеWORD);   
КонецПроцедуры

&НаСервере
Функция ПочтаТема()
//ПочтаТема = ПечатьСервер.ОрганизацияНаименование() + ". ";

ПочтаТема = "";

Если ВключитьСчетВПочту Тогда ПочтаТема = ПочтаТема + "Счет на оплату"; КонецЕсли; 
Если ВключитьСчетВПочту И ВключитьПодтверждениеВПочту Тогда ПочтаТема = ПочтаТема + " и "; КонецЕсли; 
Если ВключитьПодтверждениеВПочту Тогда ПочтаТема = ПочтаТема + "Подтверждение бронирования"; КонецЕсли; 

Если ВключитьСчетВПочту ИЛИ ВключитьПодтверждениеВПочту Тогда
	ПочтаТема = ПочтаТема + " " + ПечатьСервер.ДополнениеТекст(ДокументДолгСсылка);
КонецЕсли;

Возврат ПочтаТема;
КонецФункции

&НаСервере
Функция ПочтаТекстСообщения() 
Если НЕ ВключитьСчетВПочту И НЕ ВключитьПодтверждениеВПочту Тогда 
	ПочтаТекстСообщения = " "; 
	
	Возврат ПочтаТекстСообщения;
КонецЕсли; 
	
ПочтаТекстСообщения = "Уважаемые коллеги!!!";
ПочтаТекстСообщения = ПочтаТекстСообщения + Символы.ПС  + Символы.ПС;

//Организация = Константы.Организация.Получить();
//Если Организация.ОрганизацияИмя = "Лайв" Тогда 
//	ОтельТекст = "city-отеле Live";
//ИначеЕсли Организация.ОрганизацияИмя = "ДомСоветов" Тогда 
//	ОтельТекст = "отеле Дом Советов";
//ИначеЕсли Организация.ОрганизацияИмя = "СтритАрт" Тогда 
//	ОтельТекст = "отеле Street Art";
//Иначе   
//	ОтельТекст = "нашем отеле";
//КонецЕсли;	

Если НастройкиСервер.ЭтоЛайв() Тогда 
	ОтельТекст = "city-отеле Live";
ИначеЕсли НастройкиСервер.ЭтоДомСоветов() Тогда 
	ОтельТекст = "отеле Дом Советов";
ИначеЕсли НастройкиСервер.ЭтоСтритАрт() Тогда 
	ОтельТекст = "отеле Street Art";
ИначеЕсли НастройкиСервер.ЭтоРеноме() Тогда 
	ОтельТекст = "отеле Renomme";
ИначеЕсли НастройкиСервер.ЭтоЧехов() Тогда 
	ОтельТекст = "отеле Чехов";
	
Иначе   
	ОтельТекст = "нашем отеле";
КонецЕсли;

ПочтаТекстСообщения = ПочтаТекстСообщения + 
	"Благодарим за бронирование в " + ОтельТекст +"!!!
	|Направляем ";
Если ВключитьСчетВПочту Тогда ПочтаТекстСообщения = ПочтаТекстСообщения + "счет"; КонецЕсли; 
Если ВключитьСчетВПочту И ВключитьПодтверждениеВПочту Тогда ПочтаТекстСообщения = ПочтаТекстСообщения + " и "; КонецЕсли; 
Если ВключитьПодтверждениеВПочту Тогда ПочтаТекстСообщения = ПочтаТекстСообщения + "подтверждение бронирования"; КонецЕсли; 
ПочтаТекстСообщения = ПочтаТекстСообщения + "!"; 

ПочтаТекстСообщения = ПочтаТекстСообщения + Символы.ПС  + Символы.ПС;

ПочтаТекстСообщения = ПочтаТекстСообщения + "Будем рады новым заявкам!";

Возврат ПочтаТекстСообщения;
КонецФункции 


