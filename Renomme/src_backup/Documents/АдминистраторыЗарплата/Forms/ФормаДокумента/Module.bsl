&НаКлиенте
Процедура ЗарплатаСменыВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
ТД = Элемент.ТекущиеДанные;
Если ТД = Неопределено Тогда Возврат; КонецЕсли;
	
Если Поле.Имя = "ЗарплатаСменыДопУслуги" Тогда 
	Массив = Новый Массив;		
	Дата_П = Объект.ДН;
	Пока Дата_П <= Объект.ДК Цикл
		Дата_С = Формат(Дата_П, "ДФ=dd.MM.yy");
		Дата_И = СтрЗаменить(Дата_С, ".", "");
		
		СуммаДопУслуги = ТД["СуммаДопУслуги_" + Дата_И];
		Если СуммаДопУслуги <> 0 Тогда 
			Данные = Новый Структура("Дата, Сумма", Дата_П, СуммаДопУслуги);
			Массив.Добавить(Данные);
		КонецЕсли;
		
		Дата_П = Дата_П + 24 * 60 * 60;
	КонецЦикла;
	ПараметрыФормы = Новый Структура("ДопУслуги", Массив);
	
	ОткрытьФорму("Документ.АдминистраторыЗарплата.Форма.ДопУслугиРасшифровка", ПараметрыФормы, ЭтаФорма
		,,,,, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
		
ИначеЕсли Поле.Имя = "ЗарплатаСменыСуммаПрочее" Тогда 
	Массив = Новый Массив;
	Для Каждого Строка Из Объект.Прочее Цикл
		Если Строка.Администратор <> ТД.Администратор Тогда Продолжить; КонецЕсли;
		
		Данные = Новый Структура("Дата, Наименование,Сумма", Строка.Дата, Строка.Наименование, Строка.Сумма);
		Массив.Добавить(Данные);
	КонецЦикла;

	ПараметрыФормы = Новый Структура("Прочее", Массив);
	
	ОткрытьФорму("Документ.АдминистраторыЗарплата.Форма.ПрочееРасшифровка", ПараметрыФормы, ЭтаФорма
		,,,,, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
КонецЕсли;
 	
КонецПроцедуры



//
&НаКлиенте
Процедура ЗарплатаСменыЭлемент_ПриИзменении(Элемент, ЭтоЗамена)
ТС = Элемент.Родитель.ТекущаяСтрока;		
ТД = ЗарплатаСмены.НайтиПоИдентификатору(ТС);
//ЗарплатаСмены
//1234567890123
ИмяЭлемента = Сред(Элемент.Имя, 14);
Индекс = СтрНайти(ИмяЭлемента, "_Э");
ИмяРеквизита = Сред(ИмяЭлемента, 1, Индекс - 1);  

Если ЭтоЗамена Тогда
	ТД[ИмяРеквизита + "_Р"] = ТД[ИмяРеквизита + "_Э"];
	ТД[ИмяРеквизита + "_Есть"] = Истина;
Иначе
	ТД[ИмяРеквизита + "_Р"] = ТД[ИмяРеквизита + "_Э"] - ТД[ИмяРеквизита];
КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ЗарплатаСменыЭлемент_Очистка(Элемент, ЭтоЗамена)
ТС = Элемент.Родитель.ТекущаяСтрока;		
ТД = ЗарплатаСмены.НайтиПоИдентификатору(ТС);

ИмяРеквизита = Элемент.Имя;
ИмяРеквизита = Сред(ИмяРеквизита, 14);
ИмяРеквизита = Лев(ИмяРеквизита, СтрДлина(ИмяРеквизита) - 2);
	
Если ЭтоЗамена Тогда
	Имя = ИмяРеквизита + "_Р";
	ТД[Имя] = 0;
	Имя = ИмяРеквизита + "_Есть";
	ТД[Имя] = Ложь;
Иначе
	Имя = ИмяРеквизита + "_Р";
	ТД[Имя] = 0;
КонецЕсли;	
Имя = ИмяРеквизита + "_Э";
ТД[Имя] = ТД[ИмяРеквизита];

Элементы.ЗарплатаСмены.ЗакончитьРедактированиеСтроки(Ложь);
КонецПроцедуры

