СписокКонтрагентыИИН_Эквайринг = БезналРаспределениеСервер.СписокИННЭквайринг();
ПолучательПлатежа = Константы.ПолучательПлатежаБезнал.Получить();

Запрос = Новый Запрос("ВЫБРАТЬ
                      |	NULL КАК Счет,
                      |	БезналЗагрузка.ГУИД КАК ДокументОплаты,
                      |	БезналЗагрузка.ДатаОплаты КАК ДатаОплаты,
                      |	0 КАК СуммаОплаты,
                      |	NULL КАК НомерДокументаОплаты,
                      |	NULL КАК ДатаДокументаОплаты,
                      |	БезналЗагрузка.КонтрагентНаименование КАК КонтрагентНаименование,
                      |	БезналЗагрузка.Сумма КАК СуммаДокументаОплаты,
                      |	0 КАК СуммаВозвратаДокументаОплаты,
                      |	БезналЗагрузка.Сумма КАК ОстатокДокументаОплаты,
                      |	0 КАК СуммаДокументаОплатыКасса,
                      |	0 КАК СуммаДокументаОплатыНаличные,
                      |	0 КАК СуммаДокументаОплатыКарта,
                      |	NULL КАК ТипОплаты,
                      |	NULL КАК ЭтоЭквайринг,
                      |	""НО"" КАК ТипДокументаОплаты,
                      |	БезналЗагрузка.КонтрагентИНН КАК КонтрагентИНН,
                      |	БезналЗагрузка.ТекстПлатежа КАК ТекстПлатежа
                      |ИЗ
                      |	РегистрСведений.БезналЗагрузка КАК БезналЗагрузка
                      |		ЛЕВОЕ СОЕДИНЕНИЕ Документ.ВыпискаБанка КАК ВыпискаБанка
                      |		ПО БезналЗагрузка.ГУИД = ВыпискаБанка.ГУИДЗагрузка
                      |ГДЕ
                      |	ВыпискаБанка.Ссылка ЕСТЬ NULL
                      |	И БезналЗагрузка.Отменено = ЛОЖЬ
                      |	И (БезналЗагрузка.ПолучательПлатежа = """"
                      |			ИЛИ БезналЗагрузка.ПолучательПлатежа = &ПолучательПлатежа)
                      |	И БезналЗагрузка.ДатаОплаты >= &ДатаНачала
                      |	И БезналЗагрузка.ДатаОплаты <= &ДатаОкончания");		

//ДатаНачала = '20200101';

Запрос.УстановитьПараметр("ДатаНачала", ДатаНачала);
ДатаОкончания = ТекущаяДата();
Запрос.УстановитьПараметр("ДатаОкончания", ДатаОкончания);							  

//                      |	ВЫБОР
//                      |		КОГДА ВыпискаБанка.ЭтоЭквайринг
//                      |			ТОГДА ВЫБОР
//                      |					КОГДА ВыпискаБанка.ТекстПлатежа ПОДОБНО ""%СБП%""
//                      |						ТОГДА 5
//                      |					ИНАЧЕ 4
//                      |				КОНЕЦ
//                      |		ИНАЧЕ 3
//                      |	КОНЕЦ КАК ТипОплаты,

Запрос.УстановитьПараметр("ПолучательПлатежа", ПолучательПлатежа);		
ТЗ = Запрос.Выполнить().Выгрузить();

Для Каждого Строка Из ТЗ Цикл
	НоваяСтрока = ТЗ_НераспределенныеОплаты.Добавить();
	ЗаполнитьЗначенияСвойств(НоваяСтрока, Строка);
	
	ЗначениеИНН = СписокКонтрагентыИИН_Эквайринг.НайтиПоЗначению(Строка.КонтрагентИНН);
	ЕстьВСписке = (ЗначениеИНН <> Неопределено);
	Если ЕстьВСписке Тогда
		Если СтрНайти(Строка.ТекстПлатежа,"СБП") > 0 Тогда
			НоваяСтрока.ТипОплаты = 5;
		Иначе	
			НоваяСтрока.ТипОплаты = 4;
		КонецЕсли;
		
		НоваяСтрока.ЭтоЭквайринг = Истина;
	Иначе
		НоваяСтрока.ТипОплаты = 3;
		
		НоваяСтрока.ЭтоЭквайринг = Ложь;
	КонецЕсли;
КонецЦикла;

ТЗ_НераспределенныеОплаты.Колонки.Добавить("ПроцентЭквайринга");
ТЗ_НераспределенныеОплаты.Колонки.Добавить("ПроцентЭквайрингаСБП");
Для Каждого Строка Из ТЗ_НераспределенныеОплаты Цикл
	Запрос = Новый Запрос("ВЫБРАТЬ ПЕРВЫЕ 1
	                      |	ПроцентыЭквайринга.ПроцентЭквайринга КАК ПроцентЭквайринга,
	                      |	ПроцентыЭквайринга.ПроцентЭквайрингаСБП КАК ПроцентЭквайрингаСБП
	                      |ИЗ
	                      |	РегистрСведений.ПроцентыЭквайринга КАК ПроцентыЭквайринга
	                      |ГДЕ
	                      |	ПроцентыЭквайринга.ДатаУстановкиПроцентаЭквайринга <= &ДатаУстановкиПроцентаЭквайринга
	                      |
	                      |УПОРЯДОЧИТЬ ПО
	                      |	ПроцентыЭквайринга.ДатаУстановкиПроцентаЭквайринга УБЫВ");

	//Запрос.УстановитьПараметр("ДатаУстановкиПроцентаЭквайринга", Строка.ДокументОплаты.ДатаОплаты);
	Запрос.УстановитьПараметр("ДатаУстановкиПроцентаЭквайринга", Строка.ДатаОплаты);

	ТЗ = Запрос.Выполнить().Выгрузить();
	ПроцентЭквайринга = ?(ТЗ.Количество() = 0, 0, ТЗ[0].ПроцентЭквайринга); 			
	ПроцентЭквайрингаСБП = ?(ТЗ.Количество() = 0, 0, ТЗ[0].ПроцентЭквайрингаСБП); 			
	
	Строка.ПроцентЭквайринга = ПроцентЭквайринга;
	Строка.ПроцентЭквайрингаСБП = ПроцентЭквайрингаСБП;
КонецЦикла;
// - Нераспределенные оплаты

ТЗ_НераспределенныеОплаты.Сортировать("ДатаОплаты");

// + Нераспределенные оплаты
//Область = Макет.ПолучитьОбласть("ШапкаНераспределенныеОплатыДополнение|КолонкиЛево");
Область = Макет.ПолучитьОбласть("ШапкаНераспределенныеОплатыДополнение");
ПолеОтчета.Вывести(Область, 0);

Для Каждого СтрокаНераспределенныеОплаты Из ТЗ_НераспределенныеОплаты Цикл
	Область = Макет.ПолучитьОбласть("СтрокаНераспределенныеОплатыДополнение|КолонкиЛево");
	
	Область.Параметры.Дата = ".";
	
	Область.Параметры.ТипОплаты = ОтчетыСервер.ТипОплатыНаименование(СтрокаНераспределенныеОплаты.ТипОплаты);
	Область.Параметры.ДатаОплаты = Формат(СтрокаНераспределенныеОплаты.ДатаОплаты, "ДФ=dd.MM.yy");
	Область.Параметры.СуммаОплаты = СтрокаНераспределенныеОплаты.СуммаОплаты;
	Область.Параметры.СуммаЭквайринга = ОтчетыСервер.СуммаЭквайринга(СтрокаНераспределенныеОплаты);
	
	Если СтрокаНераспределенныеОплаты.СуммаДокументаОплаты <> 0 Тогда
		Область.Параметры.СуммаОплаты_кк = Окр(СтрокаНераспределенныеОплаты.СуммаОплаты 
				* СтрокаНераспределенныеОплаты.СуммаДокументаОплатыКарта / СтрокаНераспределенныеОплаты.СуммаДокументаОплаты, 2);
		Область.Параметры.СуммаОплаты_Нал = Окр(СтрокаНераспределенныеОплаты.СуммаОплаты 
				* СтрокаНераспределенныеОплаты.СуммаДокументаОплатыНаличные / СтрокаНераспределенныеОплаты.СуммаДокументаОплаты, 2);
	КонецЕсли;
				
	Область.Параметры.ТипДокументаОплаты = СтрокаНераспределенныеОплаты.ТипДокументаОплаты;
	Область.Параметры.НомерДокументаОплаты = СтрокаНераспределенныеОплаты.НомерДокументаОплаты;
	//Область.Параметры.ДатаДокументаОплаты = Формат(СтрокаНераспределенныеОплаты.ДатаДокументаОплаты, "ДФ=dd.MM.yy");
	Область.Параметры.ДатаДокументаОплаты = СтрокаНераспределенныеОплаты.ДатаДокументаОплаты;
	Область.Параметры.СуммаДокументаОплаты = СтрокаНераспределенныеОплаты.СуммаДокументаОплаты;
	Область.Параметры.СуммаВозвратаДокументаОплаты = СтрокаНераспределенныеОплаты.СуммаВозвратаДокументаОплаты;
	Область.Параметры.ОстатокДокументаОплаты = СтрокаНераспределенныеОплаты.ОстатокДокументаОплаты;
	
	//Область.Параметры.Оплатил = ОплатилНаименование(СтрокаНераспределенныеОплаты);
	Область.Параметры.Оплатил = ОтчетыСервер.ОплатилНаименование(СтрокаНераспределенныеОплаты);
	
	Область.Параметры.СуммаДокументаОплаты_кк = СтрокаНераспределенныеОплаты.СуммаДокументаОплатыКарта;
	Область.Параметры.СуммаДокументаОплаты_Нал = СтрокаНераспределенныеОплаты.СуммаДокументаОплатыНаличные;
	
	Область.Параметры.СуммаВозвратаДокументаОплаты_кк = СтрокаНераспределенныеОплаты.СуммаВозвратаДокументаОплатыКарта;
	Область.Параметры.СуммаДокументаОплаты_Нал = СтрокаНераспределенныеОплаты.СуммаДокументаОплатыНаличные;
	
	Если ТипЗнч(СтрокаНераспределенныеОплаты.ДокументОплаты) = Тип("УникальныйИдентификатор") Тогда
		Область.Параметры.РасшифровкаДокументОплаты = "Нераспределенная выгрузка";
	Иначе	
		Область.Параметры.РасшифровкаДокументОплаты = СтрокаНераспределенныеОплаты.ДокументОплаты;
	КонецЕсли;
	
	ОбластьВывода = ПолеОтчета.Вывести(Область, 0);
	ВыведеннаяОбласть = ПолеОтчета.Область(ОбластьВывода.Верх, , ОбластьВывода.Низ);
	
	//Если СтрокаНераспределенныеОплаты.ОстатокДокументаОплаты > 0 Тогда
	//	ВыведеннаяОбласть.ЦветФона = Новый Цвет(235, 235, 235);		
	//КонецЕсли;
КонецЦикла;

Область = Макет.ПолучитьОбласть("ПодножиеНераспределенныеОплатыДополнение");
ПолеОтчета.Вывести(Область, 0);
// - Нераспределенные оплаты

Возврат ПолеОтчета;       
КонецФункции

Функция СформироватьВозвраты(Знач Макет, Знач ДатаОтчетаС, Знач ДатаОтчетаПо, ЭтоОтчет) Экспорт
////

ПолеОтчета = Новый ТабличныйДокумент;

//
Запрос = Новый Запрос("ВЫБРАТЬ
                      |	КассовыйДокумент.Ссылка КАК ДокументОплаты,
                      |	КассовыйДокумент.ДатаОплаты КАК ДатаОплаты,
                      |	КассовыйДокумент.Номер КАК НомерДокументаОплаты,
                      |	КассовыйДокумент.Дата КАК ДатаДокументаОплаты,
                      |	КассовыйДокумент.ОтКого.Наименование КАК КонтрагентНаименование,
                      |	КассовыйДокумент.Сумма КАК СуммаДокументаОплаты,
                      |	КассовыйДокумент.СуммаНаличные КАК СуммаДокументаОплатыНаличные,
                      |	КассовыйДокумент.СуммаКарта КАК СуммаДокументаОплатыКарта,
                      |	ВЫБОР
                      |		КОГДА КассовыйДокумент.СуммаНаличные = 0
                      |				И КассовыйДокумент.СуммаКарта > 0
                      |			ТОГДА 1
                      |		ИНАЧЕ ВЫБОР
                      |				КОГДА КассовыйДокумент.СуммаНаличные > 0
                      |						И КассовыйДокумент.СуммаКарта = 0
                      |					ТОГДА 2
                      |				ИНАЧЕ 0
                      |			КОНЕЦ
                      |	КОНЕЦ КАК ТипОплаты,
                      |	""КД"" КАК ТипДокументаОплаты
                      |ИЗ
                      |	Документ.КассовыйДокумент КАК КассовыйДокумент
                      |ГДЕ
                      |	КассовыйДокумент.ПометкаУдаления = ЛОЖЬ
                      |	И КассовыйДокумент.Возврат = ИСТИНА
                      |	И КассовыйДокумент.ДатаОплаты >= &ДатаНачала
                      |	И КассовыйДокумент.ДатаОплаты <= &ДатаОкончания");		

ДатаНачала = ДатаОтчетаС;
Запрос.УстановитьПараметр("ДатаНачала", ДатаНачала);
ДатаОкончания = ДатаОтчетаПо;
Запрос.УстановитьПараметр("ДатаОкончания", ДатаОкончания);		

ТЗ = Запрос.Выполнить().Выгрузить();	

ТЗ_Возвраты = ТЗ.СкопироватьКолонки();
Колонка_ДокументОплаты = ТЗ_Возвраты.Колонки.Найти("ДокументОплаты");
ТЗ_Возвраты.Колонки.Удалить(Колонка_ДокументОплаты);
ТЗ_Возвраты.Колонки.Добавить("ДокументОплаты");

Для Каждого Строка Из ТЗ Цикл
	НоваяСтрока = ТЗ_Возвраты.Добавить();
	ЗаполнитьЗначенияСвойств(НоваяСтрока, Строка);
КонецЦикла;

Запрос = Новый Запрос("ВЫБРАТЬ
                      |	ВыпискаБанка.Ссылка КАК ДокументОплаты,
                      |	ВыпискаБанка.ДатаОплаты КАК ДатаОплаты,
                      |	ВыпискаБанка.Номер КАК НомерДокументаОплаты,
                      |	ВыпискаБанка.Дата КАК ДатаДокументаОплаты,
                      |	ВыпискаБанка.ОтКого.Наименование КАК КонтрагентНаименование,
                      |	ВыпискаБанка.Сумма КАК СуммаДокументаОплаты,
                      |	0 КАК СуммаДокументаОплатыНаличные,
                      |	0 КАК СуммаДокументаОплатыКарта,
                      |	ВЫБОР
                      |		КОГДА ВыпискаБанка.ЭтоЭквайринг
                      |			ТОГДА ВЫБОР
                      |					КОГДА ВыпискаБанка.ТекстПлатежа ПОДОБНО ""%СБП%""
                      |						ТОГДА 5
                      |					ИНАЧЕ 4
                      |				КОНЕЦ
                      |		ИНАЧЕ 3
                      |	КОНЕЦ КАК ТипОплаты,
                      |	""ВБ"" КАК ТипДокументаОплаты
                      |ИЗ
                      |	Документ.ВыпискаБанка КАК ВыпискаБанка
                      |ГДЕ
                      |	ВыпискаБанка.ПометкаУдаления = ЛОЖЬ
                      |	И ВыпискаБанка.Возврат = ИСТИНА
                      |	И ВыпискаБанка.ДатаОплаты >= &ДатаНачала
                      |	И ВыпискаБанка.ДатаОплаты <= &ДатаОкончания");		

ДатаНачала = ДатаОтчетаС;
Запрос.УстановитьПараметр("ДатаНачала", ДатаНачала);
ДатаОкончания = ДатаОтчетаПо;
Запрос.УстановитьПараметр("ДатаОкончания", ДатаОкончания);		

ТЗ = Запрос.Выполнить().Выгрузить();

Для Каждого Строка Из ТЗ Цикл
	НоваяСтрока = ТЗ_Возвраты.Добавить();
	ЗаполнитьЗначенияСвойств(НоваяСтрока, Строка);
КонецЦикла;
//

ТЗ_Возвраты.Сортировать("ДатаОплаты");

//
//Область = Макет.ПолучитьОбласть("ШапкаВозвратыДополнение|КолонкиЛево");
Область = Макет.ПолучитьОбласть("ШапкаВозвратыДополнение");
ПолеОтчета.Вывести(Область, 0);

Для Каждого СтрокаВозвраты Из ТЗ_Возвраты Цикл
	Область = Макет.ПолучитьОбласть("СтрокаВозвратыДополнение|КолонкиЛево");
	
	Область.Параметры.Дата = ".";
				
	Область.Параметры.ТипДокументаОплаты = СтрокаВозвраты.ТипДокументаОплаты;
	Область.Параметры.НомерДокументаОплаты = СтрокаВозвраты.НомерДокументаОплаты;
	//Область.Параметры.ДатаДокументаОплаты = Формат(СтрокаВозвраты.ДатаДокументаОплаты, "ДФ=dd.MM.yy");
	Область.Параметры.ДатаДокументаОплаты = СтрокаВозвраты.ДатаДокументаОплаты;
	Область.Параметры.СуммаДокументаОплаты = СтрокаВозвраты.СуммаДокументаОплаты;
	
	//Область.Параметры.Оплатил = ОплатилНаименование(СтрокаВозвраты);
	Область.Параметры.Оплатил = ОтчетыСервер.ОплатилНаименование(СтрокаВозвраты);
	
	Область.Параметры.СуммаДокументаОплаты_кк = СтрокаВозвраты.СуммаДокументаОплатыКарта;
	Область.Параметры.СуммаДокументаОплаты_Нал = СтрокаВозвраты.СуммаДокументаОплатыНаличные;
	
	Область.Параметры.РасшифровкаДокументОплаты = СтрокаВозвраты.ДокументОплаты;
	
	ВыведеннаяОбласть = ПолеОтчета.Вывести(Область, 0);
КонецЦикла;          

//Область = Макет.ПолучитьОбласть("ПодножиеВозвратыДополнение|КолонкиЛево");
Область = Макет.ПолучитьОбласть("ПодножиеВозвратыДополнение");
ПолеОтчета.Вывести(Область, 0);
// 

Возврат ПолеОтчета;       
КонецФункции
//

//
Функция СформироватьОплатыСчета(Знач Макет, Знач ДатаОтчетаС, Знач ДатаОтчетаПо, ЭтоОтчет) Экспорт
ПолеОтчета = Новый ТабличныйДокумент;

