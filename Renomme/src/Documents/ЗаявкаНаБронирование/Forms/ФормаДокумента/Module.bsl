&НаКлиенте
Процедура ИсторияКлиентаКоманда(Команда)
ТабДок = Новый ТабличныйДокумент;	

ПечатьСервер.ВывестиИсториюКлиента(ТабДок, Объект.Клиент, Объект.Дата);

//ТабДок = ИсторияКлиентаКомандаНаСервере();

КлиентНаименование = ОбщийФункционалСервер.ПолучитьЗначениеРеквизитаНаСервере(Объект.Клиент, "Наименование");
ТабДок.Показать("История клиента " + КлиентНаименование);
КонецПроцедуры

&НаСервере
Функция ИсторияКлиентаКомандаНаСервере()
	ТабДок=Новый ТабличныйДокумент;
	
//	Макет=ПолучитьМакет("МакетИсторииКлиента");
	//Макет = ПолучитьМакетНаСервере("Объект", "МакетИсторииКлиента");	
	Макет = Справочники.Клиенты.ПолучитьМакет("МакетИсторииКлиента");
	
	Обл=Макет.ПолучитьОбласть("Строка");
	Для каждого Пок Из Объект.Клиент.ПрочаяИнформация Цикл
		Если Пок.Информация="" тогда
			Продолжить;
		КонецЕсли;
		
		Обл.Параметры.Показатель=Пок.ВидИнформации.Наименование;
		Обл.Параметры.Значение=Пок.Информация;
		ТабДок.Вывести(Обл);	
	КонецЦикла; 
	
	
	Запрос=Новый Запрос("ВЫБРАТЬ
	|	ЗаявкаНаБронирование.Ссылка
	|ИЗ
	|	Документ.ЗаявкаНаБронирование КАК ЗаявкаНаБронирование
	|ГДЕ
	|	ЗаявкаНаБронирование.Клиент = &Клиент
	|	И ЗаявкаНаБронирование.Дата < &Дата");
	Запрос.УстановитьПараметр("Клиент", Объект.Клиент);						
	Запрос.УстановитьПараметр("Дата",Объект.Дата);
	ТЗ=Запрос.Выполнить().Выгрузить();
	Для каждого СтрПос Из ТЗ Цикл
		Обл=Макет.ПолучитьОбласть("Шапка");
		Обл.Параметры.СтрокаПос="Проживание с " + Формат(СтрПос.Ссылка.РезервС, "ДФ=dd.MM.yy") + " по " + Формат(СтрПос.Ссылка.РезервПо, "ДФ=dd.MM.yy") + " " + СтрПос.Ссылка.НомерВРезерв.Наименование;
		ТабДок.Вывести(Обл);
		Если СтрПос.Ссылка.ДопПожелания.Количество()=0 тогда
			Обл.Параметры.СтрокаПос="Пожелания отсутствуют";
		иначе
			Обл.Параметры.СтрокаПос="Пожелания:";
		конецесли;
		ТабДок.Вывести(Обл);
		Обл=Макет.ПолучитьОбласть("Строка");
		Для каждого Доп Из СтрПос.Ссылка.ДопПожелания Цикл
			Если Доп.Информация="" тогда
				Продолжить;
			КонецЕсли;
			Обл.Параметры.Показатель=Доп.ВидИнформации.Наименование;
			Обл.Параметры.Значение=Доп.Информация;
			ТабДок.Вывести(Обл);	
			
		КонецЦикла; 
		
	КонецЦикла;
	
	Возврат ТабДок; 
//	ТабДок.Показать();
КонецФункции
