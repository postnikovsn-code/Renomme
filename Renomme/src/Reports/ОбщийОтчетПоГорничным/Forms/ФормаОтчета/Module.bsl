&НаСервере
Процедура СформироватьТемператураСтраница()
Запрос=Новый Запрос("ВЫБРАТЬ
|	УборкиНомеров.Комната КАК Ном,
|	НАЧАЛОПЕРИОДА(УборкиНомеров.ВремяУброки, ДЕНЬ) КАК Дата,
|	УборкиНомеров.Горничная КАК Горничная,
|	УборкиНомеров.ТипУборки КАК тип,
|	УборкиНомеров.Температура КАК темп,
|	УборкиНомеров.КолВоГостей как КолВо,
|	УборкиНомеров.Неисправности КАК Тех,
|	УборкиНомеров.Ущерб, 
|	УборкиНомеров.Оборудование,
|	УборкиНомеров.Минибар
|ИЗ
|	РегистрСведений.УборкиНомеров КАК УборкиНомеров
|ГДЕ
|	УборкиНомеров.ВремяУброки МЕЖДУ &ДН И &Дк
|
|УПОРЯДОЧИТЬ ПО
|	ВремяУброки,
|	Комната");

Запрос.УстановитьПараметр("ДН",Отчет.ДатаС);
Запрос.УстановитьПараметр("Дк",КонецДня(Отчет.ДатаПо));
ТЗ=Запрос.Выполнить().Выгрузить();

//Макет=ПолучитьМакет("МакетТемп");
//Макет = Отчеты.ОбщийОтчетПоГорничным.ПолучитьМакет("МакетТемп");
ОтчетОбъект = РеквизитФормыВЗначение("Отчет");
Макет = ОтчетОбъект.ПолучитьМакет("МакетТемп");

Шапка=Макет.ПолучитьОбласть("Шапка");

ПолеОтчета.Очистить();
ПолеОтчета.Вывести(Шапка);

Для каждого Стр Из ТЗ Цикл
	Если ТипЗнч(Стр.Темп) = Тип("Число") Тогда
		Температура = Стр.Темп;
	ИначеЕсли ТипЗнч(Стр.Темп) = Тип("Строка") Тогда
		Попытка 
			Температура = Число(Стр.Темп);
		Исключение
			Продолжить;
		КонецПопытки;
	Иначе
		Продолжить;
	КонецЕсли;
		
	Если Температура < 22 или Температура > 24 тогда
		Обл=Макет.ПолучитьОбласть("Строка1");
	иначе
		Обл=Макет.ПолучитьОбласть("Строка");
		
	конецесли;
	
	Обл.Параметры.Заполнить(Стр);
	
	ПолеОтчета.Вывести(Обл);
КонецЦикла; 
КонецПроцедуры

&НаСервере
Процедура СформироватьНеисправностиСтраница()
УстановитьСписокВыбораТехническаяНеисправность();
	
Запрос = Новый Запрос;

ЗапросТекст = "ВЫБРАТЬ
              |	УборкиНомеров.Комната КАК Ном,
              |	НАЧАЛОПЕРИОДА(УборкиНомеров.ВремяУброки, ДЕНЬ) КАК Дата,
              |	УборкиНомеров.Горничная КАК Горничная,
              |	УборкиНомеров.ТипУборки КАК тип,
              |	УборкиНомеров.Температура КАК темп,
              |	УборкиНомеров.КолВоГостей КАК КолВо,
              |	УборкиНомеров.Неисправности КАК Тех,
              |	УборкиНомеров.Ущерб КАК Ущерб,
              |	УборкиНомеров.Оборудование КАК Оборудование,
              |	УборкиНомеров.Минибар КАК Минибар,
              |	УборкиНомеров.Регистратор КАК Регистратор
              |ИЗ
              |	РегистрСведений.УборкиНомеров КАК УборкиНомеров
              |ГДЕ
              |	УборкиНомеров.ВремяУброки МЕЖДУ &ДН И &Дк
              |	И УборкиНомеров.Неисправности <> &Неисправности";

ЗапросТекстОкончание = "
                    |УПОРЯДОЧИТЬ ПО
                    |	УборкиНомеров.ВремяУброки,
                    |	Ном";
	
Если Отчет.Номер.Пустая() и (НЕ ЗначениеЗаполнено(Отчет.Этаж)) тогда
	
	//Запрос.Текст = ЗапросТекст + ЗапросТекстОкончание;
	
ИначеЕсли не  Отчет.Номер.Пустая() тогда
	
	Запрос.Текст = ЗапросТекст + "
		                    |	И УборкиНомеров.Комната = &Комната";
			
	Запрос.УстановитьПараметр("Комната",Отчет.Номер);
	
Иначе
	Запрос.Текст = ЗапросТекст + "
	                    |	И УборкиНомеров.Комната.Этаж = &Этаж";
	
	Запрос.УстановитьПараметр("Этаж",Отчет.Этаж);
КонецЕсли;

Если ЗначениеЗаполнено(ТехническаяНеисправность) Тогда 
	ЗапросТекст = ЗапросТекст + " И УборкиНомеров.Неисправности ПОДОБНО &НеисправностьОтбор";
	
	Запрос.УстановитьПараметр("НеисправностьОтбор", "%" + ТехническаяНеисправность + "%");
КонецЕсли;

Запрос.Текст = ЗапросТекст + ЗапросТекстОкончание;

Запрос.УстановитьПараметр("ДН",Отчет.ДатаС);
Запрос.УстановитьПараметр("Дк",КонецДня(Отчет.ДатаПо));
Запрос.УстановитьПараметр("Неисправности","");
ТЗ=Запрос.Выполнить().Выгрузить();

//Макет=ПолучитьМакет("МакетНеисправность");
//Макет = Отчеты.ОбщийОтчетПоГорничным.ПолучитьМакет("МакетНеисправность");
ОтчетОбъект = РеквизитФормыВЗначение("Отчет");
Макет = ОтчетОбъект.ПолучитьМакет("МакетНеисправность");

Шапка=Макет.ПолучитьОбласть("Шапка");

ПолеОтчета.Очистить();

ПолеОтчета.Вывести(Шапка);

Для каждого Стр Из ТЗ Цикл
	Обл=Макет.ПолучитьОбласть("Строка");
	
	Обл.Параметры.Заполнить(Стр);
	
	Обл.Параметры.РасшифровкаДокумент = Стр.Регистратор;
	Обл.Параметры.РасшифровкаНеисправности = "РасшифровкаНеисправности";
	
	ПолеОтчета.Вывести(Обл);
КонецЦикла; 
КонецПроцедуры

