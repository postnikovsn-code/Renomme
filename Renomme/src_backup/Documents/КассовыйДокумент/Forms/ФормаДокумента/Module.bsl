
&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
ЭтаФорма.ТолькоПросмотр = НастройкиСервер.ФормаТолькоПросмотр(Ложь);

ЭтоАдминистратор = НастройкиСервер.ЭтоАдминистратор();  
Элементы.ЭтоПроизвольныйЧек.Видимость = ЭтоАдминистратор;

Если НЕ ЗначениеЗаполнено(Объект.Ссылка) Тогда
	
	Объект.РучнойВвод = Истина;
	Если Параметры.Свойство("ЭтоВозврат") Тогда 	
		Объект.Приход = Ложь;
		
		Объект.Возврат = Истина;
		Элементы.Возврат.ТолькоПросмотр = Истина; 
	
		Параметры.Свойство("ОтКого", Объект.ОтКого);
		Если ЗначениеЗаполнено(Объект.ОтКого) Тогда Элементы.ОтКого.ТолькоПросмотр = Истина; КонецЕсли;  

		Параметры.Свойство("ВозвратДокумент", Объект.ВозвратДокумент);
		Если ЗначениеЗаполнено(Объект.ВозвратДокумент) Тогда Элементы.ВозвратДокумент.ТолькоПросмотр = Истина; КонецЕсли;  
		
		Параметры.Свойство("ВозвратСумма", Объект.Сумма);
		Параметры.Свойство("ВозвратСуммаКарта", Объект.СуммаКарта);
		Параметры.Свойство("ВозвратСуммаНаличные", Объект.СуммаНаличные);
	Иначе	
		Объект.Приход = Истина;
	КонецЕсли;	
	
Иначе
	
	Если Объект.РучнойВвод Тогда
		Элементы.Возврат.Видимость = Истина; // ИЛИ ЭтоАдминистратор;
		Элементы.Возврат.ТолькоПросмотр = Истина; 
		
		Элементы.ОтКого.ТолькоПросмотр = Ложь;
	Иначе
		Элементы.Возврат.Видимость = Объект.Возврат; // ИЛИ ЭтоАдминистратор;
		Элементы.Возврат.ТолькоПросмотр = Истина; 
		
		Элементы.ОтКого.ТолькоПросмотр = Истина;
	КонецЕсли;
	
КонецЕсли;

ОтКогоНаименование = КлиентыСервер.КлиентПредставление(Объект.ОтКого);
Элементы.ОтКого.Видимость = КлиентыСервер.ЭтоЮрЛицо(Объект.ОтКого);

ФормаНастройка();

ОбновитьДанные(Объект);
КонецПроцедуры

&НаСервере
Процедура ФормаНастройка()
Элементы.ФормаСоздатьВозврат.Доступность = НЕ Объект.Возврат; 

Элементы.Приход.ТолькоПросмотр = Объект.Возврат; 

Элементы.ВозвратДокумент.Видимость = Объект.Возврат; // ИЛИ ЭтоАдминистратор; 
Элементы.ВозвратДокумент.ТолькоПросмотр = (НЕ Объект.Возврат); // ИЛИ ЭтоАдминистратор;; 

Элементы.ДокументДолг.Видимость = (НЕ Объект.Возврат); // ИЛИ ЭтоАдминистратор;; 

//Элементы.СуммаВозвратДокумент.Видимость = Объект.Возврат; // ИЛИ ЭтоАдминистратор;; 
//Элементы.СуммаВозвратОстаток.Видимость = Объект.Возврат; // ИЛИ ЭтоАдминистратор;; 
Элементы.ГруппаВозвратДокумент.Видимость = Объект.Возврат; // ИЛИ ЭтоАдминистратор;;

Элементы.СуммаВозврат.Видимость = (НЕ Объект.Возврат); // ИЛИ ЭтоАдминистратор; 
Элементы.СуммаОстаток.Видимость = (НЕ Объект.Возврат); // ИЛИ ЭтоАдминистратор; 

Элементы.Аванс.Видимость = (НЕ Объект.Возврат); // ИЛИ ЭтоАдминистратор; 

Если Объект.Возврат Тогда
	Элементы.ДекорацияТипДокумента.Заголовок = "Возврат";
	Элементы.ДекорацияТипДокумента.ЦветТекста = WebЦвета.Красный;
ИначеЕсли Объект.Приход Тогда	
	Элементы.ДекорацияТипДокумента.Заголовок = "Приход";
	Элементы.ДекорацияТипДокумента.ЦветТекста = WebЦвета.Зеленый;
Иначе 
	Элементы.ДекорацияТипДокумента.Заголовок = "Расход";
	Элементы.ДекорацияТипДокумента.ЦветТекста = WebЦвета.Коричневый;
КонецЕсли
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)

Если ОбщееСервер.ПроверитьДату(Объект.Дата) тогда
	ОбщийФункционалСервер.ЗащититьФорму(ЭтаФорма, Истина);		
	
	ПоказатьПредупреждение( ,"Документ закрыт для редактирования!");
иначе
	Если ЗначениеЗаполнено(Объект.Ссылка) Тогда
		ПересчетДолга();
	КонецЕсли;
КонецЕсли;
КонецПроцедуры

&НаСервере
функция ПересчетДолга()
Возврат Неопределено;
КонецФункции

&НаСервере
Процедура ПриЧтенииНаСервере(ТекущийОбъект)
ОбновитьДанные(ТекущийОбъект);
КонецПроцедуры

&НаСервере
Процедура ПослеЗаписиНаСервере(ТекущийОбъект, ПараметрыЗаписи)
ОбновитьДанные(ТекущийОбъект);
КонецПроцедуры

&НаСервере
Процедура ОбновитьДанные(ТекущийОбъект)
Если Объект.Возврат Тогда	
	Ответ = СуммыВозвраты();

	СуммаВозвратДокумент = Ответ.Сумма;
	СуммаВозвратДокументВозвраты = Ответ.СуммаВозвраты;
	СуммаВозвратОстаток = Ответ.СуммаОстаток;
Иначе	
	Запрос = Новый Запрос("ВЫБРАТЬ
	                      |	КассовыйДокумент.Ссылка КАК ДокументВозврата,
	                      |	КассовыйДокумент.Дата КАК ДатаВозврата,
	                      |	КассовыйДокумент.Сумма КАК СуммаВозврата
	                      |ИЗ
	                      |	Документ.КассовыйДокумент КАК КассовыйДокумент
	                      |ГДЕ
	                      |	КассовыйДокумент.ПометкаУдаления = ЛОЖЬ
	                      |	И КассовыйДокумент.ВозвратДокумент = &ВозвратДокумент
	                      |	И КассовыйДокумент.Возврат = &Возврат");

	Запрос.УстановитьПараметр("ВозвратДокумент", Объект.Ссылка);
	Запрос.УстановитьПараметр("Возврат", Истина);
	ТЗ = Запрос.Выполнить().Выгрузить();
	Возвраты.Очистить();
	Для Каждого Строка Из ТЗ Цикл
		НовыйВозврат = Возвраты.Добавить();	
		ЗаполнитьЗначенияСвойств(НовыйВозврат, Строка); 
	КонецЦикла;

	СуммаВозврат = Возвраты.Итог("СуммаВозврата");
	СуммаОстаток = Объект.Сумма - СуммаВозврат - Объект.ДолгиОплата.Итог("Сумма");
КонецЕсли;

СуммаДоЗаписи = Объект.Сумма;
КонецПроцедуры

&НаСервере
Функция СуммыВозвраты()
Запрос = Новый Запрос("ВЫБРАТЬ
                      |	КассовыйДокумент.Сумма КАК Сумма,
                      |	ЕСТЬNULL(Возвраты.Сумма, 0) КАК СуммаВозвраты,
                      |	КассовыйДокумент.Сумма - ЕСТЬNULL(Возвраты.Сумма, 0) - ЕСТЬNULL(КассовыйДокументДолгиОплата.Сумма, 0) КАК СуммаОстаток
                      |ИЗ
                      |	Документ.КассовыйДокумент КАК КассовыйДокумент
                      |		ЛЕВОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
                      |			КассовыйДокумент.ВозвратДокумент КАК ВозвратДокумент,
                      |			СУММА(КассовыйДокумент.Сумма) КАК Сумма
                      |		ИЗ
                      |			Документ.КассовыйДокумент КАК КассовыйДокумент
                      |		ГДЕ
                      |			КассовыйДокумент.ПометкаУдаления = ЛОЖЬ
                      |		
                      |		СГРУППИРОВАТЬ ПО
                      |			КассовыйДокумент.ВозвратДокумент) КАК Возвраты
                      |		ПО КассовыйДокумент.Ссылка = Возвраты.ВозвратДокумент
                      |		ЛЕВОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
                      |			КассовыйДокументДолгиОплата.Ссылка КАК Ссылка,
                      |			СУММА(КассовыйДокументДолгиОплата.Сумма) КАК Сумма
                      |		ИЗ
                      |			Документ.КассовыйДокумент.ДолгиОплата КАК КассовыйДокументДолгиОплата
                      |		
                      |		СГРУППИРОВАТЬ ПО
                      |			КассовыйДокументДолгиОплата.Ссылка) КАК КассовыйДокументДолгиОплата
                      |		ПО КассовыйДокумент.Ссылка = КассовыйДокументДолгиОплата.Ссылка
                      |ГДЕ
                      |	КассовыйДокумент.Ссылка = &ВозвратДокумент");

Запрос.УстановитьПараметр("ВозвратДокумент", Объект.ВозвратДокумент); 
Запрос.УстановитьПараметр("Ссылка", Объект.Ссылка); 
					  
Выписка = Запрос.Выполнить().Выбрать();
Выписка.Следующий();

Ответ = Новый Структура("Сумма, СуммаВозвраты, СуммаОстаток", Выписка.Сумма, Выписка.СуммаВозвраты, Выписка.СуммаОстаток);
Возврат Ответ;
КонецФункции

