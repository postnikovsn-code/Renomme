
Функция ТаблицаЗначенийВМассивСтруктур(Знач ТаблицаЗначений) Экспорт
Массив = Новый Массив;
Если ТаблицаЗначений.Количество() = 0 Тогда
	Возврат Массив;	
КонецЕсли;	

//Структура = Новый Структура;
//Для каждого Колонка из ТаблицаЗначений.Колонки Цикл
//	Имя = Колонка.Имя;
//	Структура.Вставить(Имя); 
//КонецЦикла;

Для Каждого Строка Из ТаблицаЗначений Цикл
	Структура = Новый Структура;
	Для каждого Колонка из ТаблицаЗначений.Колонки Цикл
		Имя = Колонка.Имя;
		Структура.Вставить(Имя); 
		Структура[Имя] = Строка[Имя];	
	КонецЦикла;
	Массив.Добавить(Структура);
КонецЦикла;

Возврат Массив; 	
КонецФункции

Функция ТабличнаяЧастьДокументаВМассивСтруктур(ДокументСсылка, ИмяТабличнойЧасти) Экспорт
ДанныеТабличнойЧасти = ОбщийФункционалСервер.ЗначениеРеквизитаНаСервере(ДокументСсылка, ИмяТабличнойЧасти);
ИмяДокумента = ДокументСсылка.Метаданные().Имя;
Массив = ОбщийФункционалСервер.МассивСтруктурТабличнаяЧастьДокумента(ДанныеТабличнойЧасти, ИмяДокумента, ИмяТабличнойЧасти);   
Возврат Массив; 	
КонецФункции

Функция МассивСтруктурТабличнаяЧастьДокумента(ИсходныеДанные, ИмяДокумента, ИмяТабличнойЧасти) Экспорт
Массив = Новый Массив;
Если ИсходныеДанные.Количество() = 0 Тогда
	Возврат Массив;	
КонецЕсли;	

СтруктураШаблон = СтруктураИзТабличнаяЧастьДокумента(ИмяДокумента, ИмяТабличнойЧасти); 
Для Каждого Строка Из ИсходныеДанные Цикл
	НоваяСтруктура = СкопироватьСтруктуру(СтруктураШаблон);
	ЗаполнитьЗначенияСвойств(НоваяСтруктура, Строка);	
	Массив.Добавить(НоваяСтруктура);
КонецЦикла;

Возврат Массив; 	
КонецФункции

