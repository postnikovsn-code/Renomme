
Функция ТоварЕдиницаИзмеренияКоворкинг(ДокументДолгСсылка)
ИмяКоврокинга = "";

ЭтоРеноме = НастройкиСервер.ЭтоРеноме();
Если ЭтоРеноме Тогда
	ИмяКоврокинга = "Renomme ";
ИначеЕсли НастройкиСервер.ЭтоЛайв() Тогда
	ИмяКоврокинга = "Live ";
ИначеЕсли НастройкиСервер.ЭтоСтритАрт() Тогда
	ИмяКоврокинга = "Street Art ";
КонецЕсли;

Если ЭтоРеноме И ДокументДолгСсылка.ПочасоваяОплата Тогда
	Товар = "Аренда переговорной комнаты";	
Иначе
	Товар = "Аренда офиса " + ?(ЗначениеЗаполнено(ДокументДолгСсылка.КоворкингЗаявка.КоворкингНомер.НаименованиеДляСчета)
								, ДокументДолгСсылка.КоворкингЗаявка.КоворкингНомер.НаименованиеДляСчета
								,ДокументДолгСсылка.КоворкингЗаявка.КоворкингНомер.Наименование)
		+ " в коворкинге " + ИмяКоврокинга; 
КонецЕсли;

Если ДокументДолгСсылка.ПочасоваяОплата Тогда
	Товар = Товар + " " + Формат(ДокументДолгСсылка.ДатаС, "ДФ=dd.MM.yy")
		+ " c " + Строка(ДокументДолгСсылка.ЧасС) 
		+ " по " + Строка(ДокументДолгСсылка.ЧасПо) + " ч.";
		
	ЕдиницаИЗмерения = "час";
Иначе	
	Товар = Товар + "c " + Формат(ДокументДолгСсылка.ДатаС, "ДФ=dd.MM.yy") 
			+ "  по " + Формат(ДокументДолгСсылка.ДатаПо, "ДФ=dd.MM.yy");
	ЕдиницаИЗмерения = "услуга";
КонецЕсли;
		
Возврат Новый Структура("Товар, ЕдиницаИЗмерения", Товар, ЕдиницаИЗмерения) ;		
КонецФункции

Процедура ПечатьКоворкингТело(ТабДок, Макет, ДокументДолгСсылка, ПечататьВсегоКОплате)

ДатаУчетаНДС = ДокументДолгСсылка.ДатаПо;	
СтавкаНДС = ДокументыСервер.СтавкаНДС(Истина); СтавкаНДС = ДокументыСервер.СтавкаНДСТекущая(СтавкаНДС, ДатаУчетаНДС);
УчитыватьНДС = ДокументыСервер.УчитыватьНДС(ДокументДолгСсылка.ДатаПо);

Область = Макет.ПолучитьОбласть("ШапкаТаблицы");
ОбластьПовтора = ТабДок.Вывести(Область);
ТабДок.ПовторятьПриПечатиСтроки = ОбластьПовтора;

СуммаИтого = 0;
СуммаИтогоНДС = 0;
НомерСтроки = 0;

Если ДокументДолгСсылка.Сумма <> 0 Тогда
	СтрокаТабл = Макет.ПолучитьОбласть("Строка");

	НомерСтроки = НомерСтроки + 1;
	СтрокаТабл.Параметры.НомерСтроки = НомерСтроки;

	ТоварЕдиницаИзмерения = ТоварЕдиницаИзмеренияКоворкинг(ДокументДолгСсылка);
	СтрокаТабл.Параметры.Товар = ТоварЕдиницаИзмерения.Товар;
	СтрокаТабл.Параметры.ЕдиницаИзмерения = ТоварЕдиницаИзмерения.ЕдиницаИзмерения;

	СтрокаТабл.Параметры.Количество = ДокументДолгСсылка.Количество;

	СтрокаТабл.Параметры.Цена = ДокументДолгСсылка.Цена;
	СтрокаТабл.Параметры.Сумма = ДокументДолгСсылка.Сумма;

	Если УчитыватьНДС Тогда
		СуммаНДС = ДокументыСервер.СуммаНДС(СтавкаНДС, ДокументДолгСсылка.Сумма); 
	Иначе 	
		СуммаНДС = 0;	
	КонецЕсли;

	ТабДок.Вывести(СтрокаТабл);

	СуммаИтого = СуммаИтого + ДокументДолгСсылка.Сумма; 
	СуммаИтогоНДС = СуммаИтогоНДС + СуммаНДС; 
КонецЕсли;

Для Каждого Строка Из ДокументДолгСсылка.ДопУслугиКоворкинг Цикл
	СтрокаТабл = Макет.ПолучитьОбласть("Строка");
	
	НомерСтроки = НомерСтроки + 1;
	СтрокаТабл.Параметры.НомерСтроки = НомерСтроки;
	
	СтрокаТабл.Параметры.Товар = Строка.Услуга;
	СтрокаТабл.Параметры.ЕдиницаИзмерения = "услуга";

	СтрокаТабл.Параметры.Количество = Строка.Количество;

	СтрокаТабл.Параметры.Цена = Строка.Цена;
	СтрокаТабл.Параметры.Сумма = Строка.Сумма;
	
	Если УчитыватьНДС Тогда
		СуммаНДС = ДокументыСервер.СуммаНДС(СтавкаНДС, Строка.Сумма); 
	Иначе
		СуммаНДС = 0;
	КонецЕсли;	
	ТабДок.Вывести(СтрокаТабл);
	
	СуммаИтого = СуммаИтого + Строка.Сумма;	
	
	СуммаИтогоНДС = СуммаИтогоНДС + СуммаНДС; 
КонецЦикла;

СчетчикСтрок = НомерСтроки;

ИтогоСтр=Макет.ПолучитьОбласть("Итого");
ИтогоСтр.Параметры.Всего = СуммаИтого;

Если УчитыватьНДС Тогда
	Если СтавкаНДС = Перечисления.СтавкиНДС.БезНДС 
	ИЛИ  СтавкаНДС = Перечисления.СтавкиНДС.ПустаяСсылка()
	Тогда 
		ИтогоСтр.Параметры.ВсегоНДСТекст = "Без налога (НДС):";
		ИтогоСтр.Параметры.ВсегоНДССумма = "-";
	Иначе
		Если СтавкаНДС = Перечисления.СтавкиНДС.НДС22 Тогда
			ВсегоНДСТекст = "В том числе НДС 22%:";	
		ИначеЕсли СтавкаНДС = Перечисления.СтавкиНДС.НДС20 Тогда
			ВсегоНДСТекст = "В том числе НДС 20%:";	
		ИначеЕсли СтавкаНДС = Перечисления.СтавкиНДС.НДС5 Тогда
			ВсегоНДСТекст = "В том числе НДС 5%:";		
		КонецЕсли;	
		ИтогоСтр.Параметры.ВсегоНДСТекст = ВсегоНДСТекст;
		ИтогоСтр.Параметры.ВсегоНДССумма =СуммаИтогоНДС;
	КонецЕсли;
Иначе
	ИтогоСтр.Параметры.ВсегоНДСТекст = "Без налога (НДС):";
	ИтогоСтр.Параметры.ВсегоНДССумма = "-";
КонецЕсли;
Если ПечататьВсегоКОплате Тогда 
	ИтогоСтр.Параметры.ВсегоКОплате =СуммаИтого;
КонецЕсли;
ТабДок.Вывести(ИтогоСтр);

ИтогоСтр=Макет.ПолучитьОбласть("СуммаПрописью");  
ИтогоСтр.Параметры.ИтоговаяСтрока="Всего "+Строка(СчетчикСтрок) + " наименований на сумму:";
ИтогоСтр.Параметры.СуммаПрописью=ЧислоПрописью(СуммаИтого,,"рубль, рубля, рублей, м, копейка, копейки, копеек, ж, 2");
ТабДок.Вывести(ИтогоСтр);
КонецПроцедуры

