&НаКлиенте
Процедура ЭквайрингВыгрузкаПлатежиВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
Если Поле.Имя = "ЭквайрингВыгрузкаПлатежиСуммаВыписки" Тогда
	ТД = Элемент.ТекущиеДанные;
	
	ПараметрыФормы = Новый Структура;
	ПараметрыФормы.Вставить("ТолькоПросмотр", Истина);
	
	ПараметрыОтбора = Новый Структура;
	ПараметрыОтбора.Вставить("ГУИДЗагрузка", ТД.ГУИД);
	ПараметрыФормы.Вставить("Отбор", ПараметрыОтбора); ///Добавляем отбор в параметры формы

	ОткрытьФорму("Документ.ВыпискаБанка.Форма.ФормаСписка", ПараметрыФормы, ЭтаФорма
		,,,,, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
КонецЕсли;	
КонецПроцедуры

