	Конецесли;
	
	Если НайденныеСтроки.Количество() = 0 Тогда Возврат; КонецЕсли;
	НайденнаяСтрока = НайденныеСтроки[0];
	
	НайденнаяСтрока.КомментарийОтветственного = ЗначениеЯчейки;
	НайденнаяСтрока.ЕстьИзменения = Истина;                           
	
	ЗаявкаТекст = ЗаявкаТекст(ЗаявкаНаБронирование);
	Если ИмяЭлемента = "ПолеОтчетаДолги" Тогда
		ЗаполнитьКомментарийПолеОтчета(ЗначениеЯчейки, ЗаявкаТекст, ПолеОтчетаСписание,  НомерКомментарий_Списание);
	ИначеЕсли ИмяЭлемента = "ПолеОтчетаСписание" Тогда
		ЗаполнитьКомментарийПолеОтчета(ЗначениеЯчейки, ЗаявкаТекст, ПолеОтчетаДолги, НомерКомментарий_Долги);
	Иначе
		Возврат;	
	Конецесли;
КонецЕсли;
КонецПроцедуры

