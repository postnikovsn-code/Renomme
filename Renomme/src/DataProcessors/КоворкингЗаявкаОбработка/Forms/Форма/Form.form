  <attributes>
    <name>Счета</name>
    <title>
      <key>ru</key>
      <value>Счета</value>
    </title>
    <id>3</id>
    <valueType>
      <types>DynamicList</types>
    </valueType>
    <view>
      <common>true</common>
    </view>
    <edit>
      <common>true</common>
    </edit>
    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>Счета.Ссылка</segments>
    </notDefaultUseAlwaysAttributes>
    <extInfo xsi:type="form:DynamicListExtInfo">
      <queryText>ВЫБРАТЬ
	ДокументКоворкингСчета.Ссылка КАК Ссылка,
	ДокументКоворкингСчета.ПометкаУдаления КАК ПометкаУдаления,
	ДокументКоворкингСчета.Номер КАК Номер,
	ДокументКоворкингСчета.Дата КАК Дата,
	ДокументКоворкингСчета.Проведен КАК Проведен,
	ДокументКоворкингСчета.КоворкингЗаявка КАК КоворкингЗаявка,
	ДокументКоворкингСчета.ДатаС КАК ДатаС,
	ДокументКоворкингСчета.ДатаПо КАК ДатаПо,
	ДокументКоворкингСчета.Цена КАК Цена,
	ДокументКоворкингСчета.КоличествоЕдиниц КАК КоличествоЕдиниц,
	ДокументКоворкингСчета.Сумма КАК Сумма,
	ДокументКоворкингСчета.Примечание КАК Примечание,
	ДокументКоворкингСчета.Количество КАК Количество,
	СчетаОплаты.СуммаРаспределено КАК СуммаРаспределено
ИЗ
	Документ.КоворкингСчета КАК ДокументКоворкингСчета
		ЛЕВОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
			КоворкингСчетаДокументыОплаты.Ссылка КАК Ссылка,
			СУММА(КоворкингСчетаДокументыОплаты.СуммаРаспределено) КАК СуммаРаспределено
		ИЗ
			Документ.КоворкингСчета.ДокументыОплаты КАК КоворкингСчетаДокументыОплаты
		
		СГРУППИРОВАТЬ ПО
			КоворкингСчетаДокументыОплаты.Ссылка) КАК СчетаОплаты
		ПО ДокументКоворкингСчета.Ссылка = СчетаОплаты.Ссылка
ГДЕ
	ДокументКоворкингСчета.ПометкаУдаления = ЛОЖЬ
	И ДокументКоворкингСчета.КоворкингЗаявка = &amp;КоворкингЗаявка</queryText>
      <mainTable>Document.КоворкингСчета</mainTable>
      <autoFillAvailableFields>true</autoFillAvailableFields>
      <customQuery>true</customQuery>
      <autoSaveUserSettings>true</autoSaveUserSettings>
      <getInvisibleFieldPresentations>true</getInvisibleFieldPresentations>
    </extInfo>
  </attributes>
  <attributes>
    <name>Оплаты</name>
    <title>
      <key>ru</key>
      <value>Оплаты</value>
    </title>
    <id>4</id>
    <valueType>
      <types>DynamicList</types>
    </valueType>
    <view>
      <common>true</common>
    </view>
    <edit>
      <common>true</common>
    </edit>
    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>Оплаты.КоворкингСчет</segments>
    </notDefaultUseAlwaysAttributes>
    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>Оплаты.СуммаОстатокДокументаОплаты</segments>
    </notDefaultUseAlwaysAttributes>
    <extInfo xsi:type="form:DynamicListExtInfo">
      <queryText>ВЫБРАТЬ
	&amp;КоворкингСчет КАК КоворкингСчет,
	КоворкингСчетаДокументыОплаты.Ссылка КАК Ссылка,
	КоворкингСчетаДокументыОплаты.НомерСтроки КАК НомерСтроки,
	КоворкингСчетаДокументыОплаты.ДокументОплаты КАК ДокументОплаты,
	КоворкингСчетаДокументыОплаты.СуммаРаспределено КАК СуммаРаспределено,
	ЕСТЬNULL(Выписка.ВыпискаВозвратСумма, 0) + ЕСТЬNULL(Касса.КассаВозвратСумма, 0) КАК СуммаВозвратаДокументОплаты,
	ВЫРАЗИТЬ(0 КАК ЧИСЛО(10, 2)) КАК СуммаОстатокДокументаОплаты,
	Выписка.Ссылка КАК ВыпискаСсылка,
	Выписка.ВыпискаВозвратСумма КАК ВыпискаВозвратСумма,
	Выписка.ВыпискаСумма КАК ВыпискаСумма,
	Касса.Ссылка КАК КассаСсылка,
	Касса.КассаСумма КАК КассаСумма,
	Касса.СуммаКарта КАК СуммаКарта,
	Касса.СуммаНаличные КАК СуммаНаличные,
	Касса.КассаВозвратСумма КАК КассаВозвратСумма,
	ВЫБОР
		КОГДА Касса.Ссылка ЕСТЬ NULL
			ТОГДА &quot;Банк&quot;
		ИНАЧЕ ВЫБОР
				КОГДА Выписка.Ссылка ЕСТЬ NULL
					ТОГДА &quot;&quot;
				ИНАЧЕ ВЫБОР
						КОГДА Касса.СуммаКарта &lt;> 0
								И Касса.СуммаНаличные &lt;> 0
							ТОГДА &quot;Смеш.&quot;
						ИНАЧЕ ВЫБОР
								КОГДА Касса.СуммаКарта > 0
									ТОГДА &quot;Карта&quot;
								ИНАЧЕ ВЫБОР
										КОГДА Касса.СуммаНаличные > 0
											ТОГДА &quot;Нал.&quot;
										ИНАЧЕ &quot;&quot;
									КОНЕЦ
							КОНЕЦ
					КОНЕЦ
			КОНЕЦ
	КОНЕЦ КАК ТипДокументаОплаты,
	ВЫБОР
		КОГДА Касса.Ссылка ЕСТЬ NULL
			ТОГДА Выписка.ВыпискаСумма
		ИНАЧЕ Касса.КассаСумма
	КОНЕЦ КАК СуммаДокументаОплаты,
	ВЫБОР
		КОГДА Касса.Ссылка ЕСТЬ NULL
			ТОГДА Выписка.ВыпискаВозвратСумма
		ИНАЧЕ Касса.КассаВозвратСумма
	КОНЕЦ КАК СуммаВозврата
ИЗ
	Документ.КоворкингСчета.ДокументыОплаты КАК КоворкингСчетаДокументыОплаты
		ЛЕВОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
			ВыпискаБанка.Ссылка КАК Ссылка,
			Возвраты.ВозвратСумма КАК ВыпискаВозвратСумма,
			ВыпискаБанка.Сумма КАК ВыпискаСумма
		ИЗ
			Документ.ВыпискаБанка КАК ВыпискаБанка
				ЛЕВОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
					СУММА(ВыпискаБанка.Сумма) КАК ВозвратСумма,
					ВыпискаБанка.ВозвратДокумент КАК ВозвратДокумент
				ИЗ
					Документ.ВыпискаБанка КАК ВыпискаБанка
				
				СГРУППИРОВАТЬ ПО
					ВыпискаБанка.ВозвратДокумент) КАК Возвраты
				ПО ВыпискаБанка.Ссылка = Возвраты.ВозвратДокумент) КАК Выписка
		ПО КоворкингСчетаДокументыОплаты.ДокументОплаты = Выписка.Ссылка
		ЛЕВОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
			КассовыйДокумент.Ссылка КАК Ссылка,
			КассовыйДокумент.Сумма КАК КассаСумма,
			КассовыйДокумент.СуммаКарта КАК СуммаКарта,
			КассовыйДокумент.СуммаНаличные КАК СуммаНаличные,
			Возвраты.КассаВозвратСумма КАК КассаВозвратСумма
		ИЗ
			Документ.КассовыйДокумент КАК КассовыйДокумент
				ЛЕВОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
					КассовыйДокумент.ВозвратДокумент КАК ВозвратДокумент,
					КассовыйДокумент.Сумма КАК КассаВозвратСумма
				ИЗ
					Документ.КассовыйДокумент КАК КассовыйДокумент) КАК Возвраты
				ПО КассовыйДокумент.Ссылка = Возвраты.ВозвратДокумент) КАК Касса
		ПО КоворкингСчетаДокументыОплаты.ДокументОплаты = Касса.Ссылка
ГДЕ
	КоворкингСчетаДокументыОплаты.Ссылка = &amp;КоворкингСчет</queryText>
      <autoFillAvailableFields>true</autoFillAvailableFields>
      <customQuery>true</customQuery>
      <autoSaveUserSettings>true</autoSaveUserSettings>
      <getInvisibleFieldPresentations>true</getInvisibleFieldPresentations>
    </extInfo>
  </attributes>
