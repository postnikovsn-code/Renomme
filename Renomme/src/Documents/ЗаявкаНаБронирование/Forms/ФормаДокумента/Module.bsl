&НаКлиенте
Процедура СчетаКонтрагентНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
СтандартнаяОбработка = Ложь;

ТД = Элементы.Счета.ТекущиеДанные;
Если ЗначениеЗаполнено(ТД.ГрупповойСчет) Тогда 
	ПоказатьПредупреждение(, "Групповой счет.
	|
	|ИЗМЕНЕНИЕ НЕ РАЗРЕШЕНО");
	
	Возврат;
КонецЕсли;
	
СчетаКонтрагент_OldValue = ТД.Контрагент;

КонтрагентыОтбор = Новый СписокЗначений;

КонтрагентыОтбор.Добавить(Объект.Клиент);
Если ЗначениеЗаполнено(Объект.Оплачивает) Тогда КонтрагентыОтбор.Добавить(Объект.Оплачивает); КонецЕсли;
Если ЗначениеЗаполнено(Объект.Клиент2) Тогда КонтрагентыОтбор.Добавить(Объект.Клиент2); КонецЕсли;

ПараметрыФормы = Новый Структура;
ПараметрыФормы.Вставить("КонтрагентыОтбор", КонтрагентыОтбор);

ОткрытьФорму("Справочник.Клиенты.Форма.ФормаВыбораОтборКонтрагенты", ПараметрыФормы, Элементы.СчетаКонтрагент
	,,,,, РежимОткрытияОкнаФормы.БлокироватьВесьИнтерфейс);
КонецПроцедуры

&НаКлиенте
Процедура СчетаКонтрагентОбработкаВыбора(Элемент, ВыбранноеЗначение, СтандартнаяОбработка)
СтандартнаяОбработка = Ложь;

ТД = Элементы.Счета.ТекущиеДанные;
ТД.Контрагент = ВыбранноеЗначение;	

Элементы.Счета.ЗакончитьРедактированиеСтроки(Ложь);   

ТД.ЭтоПредварительныйГрупповойСчет = ЭтоПредварительныйГрупповойСчет(ТД.Контрагент);
КонецПроцедуры

&НаКлиенте
Процедура СчетаКонтрагентПриИзменении(Элемент)
ТД = Объект.Счета.НайтиПоИдентификатору(Элементы.Счета.ТекущаяСтрока);	

Если ЗначениеЗаполнено(ТД.ГрупповойСчет) > 0 Тогда
	ПоказатьПредупреждение(, "Групповой Счет
							|
							|ИЗМЕНЕНИЕ НЕ РАЗРЕШЕНО ...");
	
	ТД.Контрагент = СчетаКонтрагент_OldValue;
	Возврат; 
КонецЕсли;

ОтборСтроки = Новый Структура("СчетГУИД", ТД.СчетГУИД);
НайденныеСтроки = Объект.РаспределениеОплатДолги.НайтиСтроки(ОтборСтроки);
Если НайденныеСтроки.Количество() > 0 Тогда
	ПоказатьПредупреждение(, "Счет оплачен
							|
							|ИЗМЕНЕНИЕ НЕ РАЗРЕШЕНО.
							|
							|Для изменения контрагента удалите оплаты счета ...");
	
	ТД.Контрагент = СчетаКонтрагент_OldValue;
	Возврат; 
КонецЕсли;

ТД.ЭтоПредварительныйГрупповойСчет = ЭтоПредварительныйГрупповойСчет(ТД.Контрагент);
КонецПроцедуры
