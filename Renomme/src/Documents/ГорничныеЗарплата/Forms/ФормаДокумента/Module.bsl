&НаКлиенте
Процедура УстановитьСдельноОтбор()
ОтборСтрок = Новый Структура;
Если ЗначениеЗаполнено(СдельноГорничнаяОтбор) Тогда
	ОтборСтрок.Вставить("Горничная", СдельноГорничнаяОтбор);
КонецЕсли;

Если ЗначениеЗаполнено(СдельноДатаОтбор) Тогда
	ОтборСтрок.Вставить("Дата", СдельноДатаОтбор);
КонецЕсли;

Если ОтборСтрок.Количество() = 0 Тогда
	Элементы.Сдельно.ОтборСтрок = Неопределено;
Иначе
	Элементы.Сдельно.ОтборСтрок = Новый ФиксированнаяСтруктура(ОтборСтрок);
КонецЕсли;	
КонецПроцедуры
