Функция ПроверкаЗанятостиКоворкинг(ДанныеОбъекта) Экспорт
Результат = Новый Структура("Ошибка, Сообщение", Ложь, Неопределено);	
	
ДокументРегистратор = ДанныеОбъекта.Ссылка;
ДатаС = ДанныеОбъекта.ДатаС; ДатаПо = ДанныеОбъекта.ДатаПо;
ЧасС = ДанныеОбъекта.ЧасС; ЧасПо = ДанныеОбъекта.ЧасПо;
Ответ = КоворкингСервер.ЗанятостьНомераКоворкингПроверить(ДатаС, ДатаПо, ЧасС, ЧасПо, ДокументРегистратор); 
//Ответ = Новый Структура("Результат, НачалоПериодаРезерва, КонецПериодаРезерва, Регистратор"
Если Ответ.Результат Тогда 
	Сообщение = Новый Массив;
	ТекстСообщения = "" + ДанныеОбъекта.Ссылка + ".";
	
	Сообщение.Добавить(ТекстСообщения);
	ТекстСообщения = "В период с " + Формат(Ответ.НачалоПериодаРезерва, "ДФ=дд.ММ.гг"); 
	Если ЧасС <> 0 Тогда 
		ТекстСообщения = ТекстСообщения + " " + Формат(Ответ.НачалоПериодаРезерва, "ДФ=ЧЧ") + ":00";
	КонецЕсли;
	ТекстСообщения = ТекстСообщения + " по " + Формат(Ответ.КонецПериодаРезерва, "ДФ=дд.ММ.гг"); 
	Если ЧасПо <> 0 Тогда 
		ТекстСообщения = ТекстСообщения + " " + Формат(Ответ.КонецПериодаРезерва, "ДФ=ЧЧ") + ":00";
	КонецЕсли;

	Если ТипЗнч(ДокументРегистратор) = Тип("ДокументСсылка.КоворкингЗаявка") Тогда 
		КоворкингНомер = ДокументРегистратор.КоворкингНомер; 
	ИначеЕсли ТипЗнч(ДокументРегистратор) = Тип("ДокументСсылка.КоворкингСчета") Тогда 
		КоворкингНомер = ДокументРегистратор.КоворкингЗаявка.КоворкингНомер; 
	Иначе
		КоворкингНомер = "";
	КонецЕсли;
	ТекстСообщения = ТекстСообщения + " номер " + КоворкингНомер + " занят: ";
	Сообщение.Добавить(ТекстСообщения);
	
	//Если ТипЗнч(Ответ.Регистратор) = Тип("ДокументСсылка.КоворкингЗаявка") Тогда 
	//	Регистратор = Ответ.Регистратор;
	//	ТекстСообщения = Регистратор;
	//	Сообщение.Добавить(ТекстСообщения);
	//	
	//ИначеЕсли ТипЗнч(Ответ.Регистратор) = Тип("ДокументСсылка.КоворкингСчета") Тогда 
	//	ТекстСообщения = "Счет: " + Ответ.Регистратор;
	//	Сообщение.Добавить(ТекстСообщения);
	//	
	//	ТекстСообщения = "Заявка: " + Ответ.Регистратор.КоворкингЗаявка ;
	//	Сообщение.Добавить(ТекстСообщения);	
	//КонецЕсли;
	Регистратор = Ответ.Регистратор;
	ТекстСообщения = Регистратор;
	Сообщение.Добавить(ТекстСообщения);
	
	Результат.Ошибка = Истина;
	Результат.Сообщение = Сообщение;
КонецЕсли;

Возврат Результат;
КонецФункции

Функция ЗанятостьНомераКоворкингПроверить(ДатаС, ДатаПо, ЧасС, ЧасПо, ДокументРегистратор)  Экспорт
НачалоПериодаРезерва = ДатаС + ЧасС * 60 * 60;
КонецПериодаРезерва = ДатаПо + ?(ЧасПо = 0, 0, ЧасПо * 60 * 60 - 1);

Запрос = Новый Запрос("ВЫБРАТЬ
                      |	ЗанятостьНомеровКоворкинг.КоворкингНомер КАК КоворкингНомер,
                      |	МИНИМУМ(ЗанятостьНомеровКоворкинг.ПериодРезерва) КАК ПериодРезерваМинимум,
                      |	МАКСИМУМ(ЗанятостьНомеровКоворкинг.ПериодРезерва) КАК ПериодРезерваМаксимум,
                      |	ЗанятостьНомеровКоворкинг.Регистратор КАК Регистратор
                      |ИЗ
                      |	РегистрСведений.ЗанятостьНомеровКоворкинг КАК ЗанятостьНомеровКоворкинг
                      |ГДЕ
                      |	ЗанятостьНомеровКоворкинг.ПериодРезерва МЕЖДУ &ПериодН И &ПериодК
                      |	И ЗанятостьНомеровКоворкинг.КоворкингНомер = &Номер
                      |
                      |СГРУППИРОВАТЬ ПО
                      |	ЗанятостьНомеровКоворкинг.КоворкингНомер,
                      |	ЗанятостьНомеровКоворкинг.Регистратор");

Запрос.УстановитьПараметр("ПериодН",НачалоПериодаРезерва);
Запрос.УстановитьПараметр("ПериодК",КонецПериодаРезерва);

ЭтоЗаявка = ТипЗнч(ДокументРегистратор) = Тип("ДокументСсылка.КоворкингЗаявка");
Если ЭтоЗаявка Тогда 
	НомерКуда = ДокументРегистратор.КоворкингНомер;
Иначе 
	НомерКуда = ДокументРегистратор.КоворкингЗаявка.КоворкингНомер;
КонецЕсли; 
Запрос.УстановитьПараметр("Номер", НомерКуда);

ТЗ_Занято = Запрос.Выполнить().Выгрузить(); 

Регистратор = Неопределено;
Для Каждого Строка Из ТЗ_Занято Цикл
	Если ТипЗнч(Строка.Регистратор) = Тип("ДокументСсылка.КоворкингЗаявка") Тогда Продолжить; КонецЕсли;

	Если ЭтоЗаявка Тогда 
		Если Строка.Регистратор.КоворкингЗаявка = ДокументРегистратор Тогда Продолжить; КонецЕсли;
	Иначе
		Если Строка.Регистратор = ДокументРегистратор Тогда Продолжить; КонецЕсли;
	КонецЕсли;
	
	Регистратор = Строка.Регистратор;
	Прервать;
КонецЦикла;		

Если Регистратор = Неопределено Тогда 
	Для Каждого Строка Из ТЗ_Занято Цикл
		Если ТипЗнч(Строка.Регистратор) = Тип("ДокументСсылка.КоворкингСчета") Тогда Продолжить; КонецЕсли;

		Если ЭтоЗаявка Тогда 
			Если Строка.Регистратор = ДокументРегистратор Тогда Продолжить; КонецЕсли;
		Иначе
			Если Строка.Регистратор = ДокументРегистратор.КоворкингЗаявка Тогда Продолжить; КонецЕсли;
		КонецЕсли;
		
		Регистратор = Строка.Регистратор;
		Прервать;
	КонецЦикла;			
КонецЕсли;

Если ЧасПо <> 0 Тогда КонецПериодаРезерва = КонецПериодаРезерва + 1; КонецЕсли;

Результат = (Регистратор <> Неопределено); 
Ответ = Новый Структура("Результат, НачалоПериодаРезерва, КонецПериодаРезерва, Регистратор"
	, Результат, НачалоПериодаРезерва, КонецПериодаРезерва, Регистратор);
Возврат Ответ;
КонецФункции	
