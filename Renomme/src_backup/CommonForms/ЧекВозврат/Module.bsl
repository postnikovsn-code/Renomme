КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьПозицииЧека() Экспорт
ПозицииЧекаККМ.Очистить();

СуммаДляПечати=СуммаВозврата;

НовЗапч = ПозицииЧекаККМ.Добавить();

НовЗапч.Наименование="Возврат оплаты";
	
НовЗапч.Количество=1;

Если ТипЗнч(ДокументДолг) = Тип("ДокументСсылка.ЗаявкаНаБронирование") Тогда
	КолВоДней = ОбщийФункционалСервер.ПолучитьЗначениеРеквизитаНаСервере(ДокументДолг, "КолВоДней");
Иначе
	КолВоДней = 0;
КонецЕсли;	
НовЗапч.Цена=?(КолВоДней=0, 0, Окр(СуммаДляПечати, 2));

НовЗапч.Скидка=0;
НовЗапч.Сумма=СуммаДляПечати;

НовЗапч.СтавкаНДС = Неопределено;
КонецПроцедуры

&НаКлиенте
Процедура ПечатьЧекаЗавершение_ФУ(РезультатВыполнения, ДополнительныеПараметры) Экспорт
	
ЭтаФорма.Доступность = Истина; // При необходимости разблокируем интерфейс пользователя.

Если НЕ РезультатВыполнения.Результат Тогда
	ТекстПредупреждения = ТекстПредупреждения + "При пробитии кассового чека произошла ошибка";
	
	Если СтрНайти(РезультатВыполнения.ОписаниеОшибки, "смена") > 0 Тогда
		ТекстПредупреждения = ТекстПредупреждения + ": "
		 	+ Символы.ПС + РезультатВыполнения.ОписаниеОшибки;
	Иначе		
		ТекстПредупреждения = ТекстПредупреждения + ". ";
	КонецЕсли;
	
	ТекстСообщения = ТекстСообщения + "При пробитии кассового чека произошла ошибка: " + РезультатВыполнения.ОписаниеОшибки;
	
	ОшибкаОперации = Истина;
	
	ФУ_Сервер.ЗаписатьОшибкуКММ(ТекстСообщения);
Иначе
	//Получить номер чека и номер смены.
	//НомерСменыККМ = РезультатВыполнения.ВыходныеПараметры[0];
	//НомерЧекаККМ  = РезультатВыполнения.ВыходныеПараметры[1];
    НомерСменыККМ = РезультатВыполнения.НомерСменыККТ;
    НомерЧекаККМ  = РезультатВыполнения.НомерЧекаККТ;

	ДополнительныеПараметры.Вставить("НомерСменыККМ", НомерСменыККМ);
	ДополнительныеПараметры.Вставить("НомерЧекаККМ", НомерЧекаККМ);
	
	ТекстПредупреждения = ТекстПредупреждения + "Пробитие кассового чека выполнено успешно.";
	ТекстСообщения = ТекстСообщения + "Пробитие кассового чека выполнено успешно.";

	ОшибкаОперации = Ложь;	
КонецЕсли;

ЗавершитьОтбитиеВозвратЧека(ДополнительныеПараметры);
КонецПроцедуры

&НаСервере
Функция КассовыйДокументСоздатьДокументВозврат(СуммаНалЧекККМ, СуммаБезналЧекККМ, ДополнительныеПараметры)
ДокКасс=Документы.КассовыйДокумент.СоздатьДокумент();
ДокКасс.Дата=ТекущаяДата();
ДокКасс.ДатаОплаты=ТекущаяДата();

ДокКасс.Возврат = Истина;

Оплачивает = ДополнительныеПараметры.ДокОсн.ОтКого;
ДокКасс.ОтКого = Оплачивает;

ВозвратДокумент = ДополнительныеПараметры.ДокОсн; 
ДокКасс.ВозвратДокумент = ВозвратДокумент;

ДокКасс.Приход=Ложь;

//ДокКасс.КредитнаяКарта=КредитнаяКарта;
//
//ДокКасс.Сумма = СуммаНалЧекККМ + СуммаБезналЧекККМ;
//Если КредитнаяКарта Тогда 
//	ДокКасс.СуммаКарта = ДокКасс.Сумма;			
//Иначе
//	ДокКасс.СуммаНаличные = ДокКасс.Сумма;			
//КонецЕсли;	

ДокКасс.КредитнаяКарта = (СуммаБезналЧекККМ > 0);
ДокКасс.Наличные = (СуммаНалЧекККМ > 0);

ДокКасс.Сумма = СуммаНалЧекККМ + СуммаБезналЧекККМ;
ДокКасс.СуммаКарта = СуммаБезналЧекККМ;			
ДокКасс.СуммаНаличные = СуммаНалЧекККМ;			

ДокКасс.НомерСменыККМ 	= ДополнительныеПараметры.НомерСменыККМ;
ДокКасс.НомерЧекаККМ 	= ДополнительныеПараметры.НомерЧекаККМ;

ДокКасс.ГУИД_ЭТ 	= ДополнительныеПараметры.ГУИД_ЭТ;

ДокКасс.ДокументДолг=ДокументДолг;
//ДокКасс.ВидОперации=Справочники.ВидыОпераций.Проживание;
ДокКасс.ВидОперации=Справочники.ВидыОпераций.Возврат;

ДокКасс.Примечание="Возврат по чеку";

ДокКасс.Записать(РежимЗаписиДокумента.Проведение);
Возврат ДокКасс.Ссылка; 
КонецФункции

&НаКлиенте
Процедура ЗавершитьОтбитиеВозвратЧека(ДополнительныеПараметры)
Если НЕ ОшибкаОперации Тогда 
	Если ЗначениеЗаполнено(ГУИД_ЭТ) Тогда
		ЭТСервер.ЗаписатьВЭТКассовыйЧекКММ(ГУИД_ЭТ);
	КонецЕсли;
	
	СуммаБезналЧекККМ = СуммаВозвратаКарта;
	СуммаНалЧекККМ = СуммаВозвратаНаличные;
	
	ДополнительныеПараметры.Вставить("ГУИД_ЭТ", ГУИД_ЭТ);
	
	ДокументВозврат = КассовыйДокументСоздатьДокументВозврат(СуммаНалЧекККМ, СуммаБезналЧекККМ, ДополнительныеПараметры);  
	
	Если ЗначениеЗаполнено(ДокументДолг) Тогда
		Если ТипЗнч(ДокументДолг) = Тип("ДокументСсылка.ЗаявкаНаБронирование") Тогда
			ЗаявкаСервер.УменьшитьОплатыЗаявкаСуммаВозврата(ДокументОплаты, ДокументДолг, СуммаВозврата, ДокументВозврат);
		ИначеЕсли ТипЗнч(ДокументДолг) = Тип("ДокументСсылка.ГрупповыеСчета") Тогда
			ГрупповойСчетСервер.УменьшитьОплатыГрупповойСчетСуммаВозврата(ДокументОплаты, ДокументДолг);
		ИначеЕсли ТипЗнч(ДокументДолг) = Тип("ДокументСсылка.КоворкингСчета") Тогда
			КоворкингСервер.УменьшитьОплатыКоворкингСчетаСуммаВозврата(ДокументОплаты, ДокументДолг, СуммаВозврата);
		КонецЕсли;	
	КонецЕсли;	
КонецЕсли;	

ДопПараметры = Новый Структура;
ДопПараметры.Вставить("ОшибкаОперации", ОшибкаОперации);
ДопПараметры.Вставить("ОшибкаЭТ", ОшибкаЭТ);

ДопПараметры.Вставить("ТекстПредупреждения", ТекстПредупреждения);
ДопПараметры.Вставить("ТекстСообщения", ТекстСообщения);

Закрыть(ДопПараметры);
КонецПроцедуры	
//// - Кассовый Чек

//// + ЭТ Отмена Возврат 
&НаКлиенте
Процедура ОтменаПлатежаПоКарте(Команда)
Если СуммаВозвратаКарта = 0 тогда Возврат; КонецЕсли;
Если ПроверкаДанных() Тогда Возврат; КонецЕсли;

ТипТранзакции = "AuthorizeVoid";
Если ЗначениеЗаполнено(ДокументДолг) Тогда
	ПредупреждениеЕстьТакиеПлатежи(ТипТранзакции);
	
	Возврат;
КонецЕсли;

ВозвратОтменаОплатаКартаВыполнить(ТипТранзакции);
КонецПроцедуры

&НаКлиенте
Процедура ВозвратПлатежаПоКарте(Команда)
Если СуммаВозвратаКарта = 0 тогда Возврат; КонецЕсли;
Если ПроверкаДанных() Тогда Возврат; КонецЕсли;

ТипТранзакции = "AuthorizeRefund";
Если ЗначениеЗаполнено(ДокументДолг) Тогда
	ПредупреждениеЕстьТакиеПлатежи(ТипТранзакции);
	
	Возврат;
КонецЕсли;

ВозвратОтменаОплатаКартаВыполнить(ТипТранзакции);
КонецПроцедуры

&НаКлиенте
Процедура ПредупреждениеЕстьТакиеПлатежи(ТипТранзакции)
Ответ = ПолучитьПараметрыЧекаВозвратЗапрос(ДокументДолг, СуммаВозвратаКарта); 	

ЕстьТакиеПлатежи = Ложь;
Если ТипЗнч(Ответ) = Тип("Структура") Тогда
	ЕстьТакиеПлатежи = Истина;
Иначе
	ЕстьТакиеПлатежи = (Ответ = "+"); 
КонецЕсли;

Если ЕстьТакиеПлатежи Тогда
	ДопПараметры = Новый Структура;
	ДопПараметры.Вставить("ТипТранзакции", ТипТранзакции);
	Оповещение = Новый ОписаниеОповещения("ЗавершениеВопроса_ЕстьПлатежиПоЗаявке", ЭтаФорма, ДопПараметры);
	
	ПоказатьВопрос(Оповещение, "ВНИМАНИЕ: Есть возвраты по заявке на сумму: " + СуммаВозвратаКарта + "
		|
		|ПРОДОЛЖИТЬ ?"
		, РежимДиалогаВопрос.ОКОтмена);
	Возврат;
КонецЕсли;

ВозвратОтменаОплатаКартаВыполнить(ТипТранзакции);
КонецПроцедуры

&НаСервере
Функция ПолучитьПараметрыЧекаВозвратЗапрос(ДокументДолг, СуммаОперации) 

Запрос = Новый Запрос("ВЫБРАТЬ
                      |	ОперацииЭТ.СсылочныйНомер КАК СсылочныйНомер,
                      |	ОперацииЭТ.СуммаОперации КАК СуммаОперации,
                      |	ЕСТЬNULL(Возвраты.СуммаВозврата, 0) КАК СуммаВозврата
                      |ИЗ
                      |	РегистрСведений.ОперацииЭТ КАК ОперацииЭТ
                      |		ЛЕВОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
                      |			ОперацииЭТ.СсылочныйНомерВозврат КАК СсылочныйНомерВозврат,
                      |			СУММА(ОперацииЭТ.СуммаОперации) КАК СуммаВозврата
                      |		ИЗ
                      |			РегистрСведений.ОперацииЭТ КАК ОперацииЭТ
                      |		
                      |		СГРУППИРОВАТЬ ПО
                      |			ОперацииЭТ.СсылочныйНомерВозврат) КАК Возвраты
                      |		ПО ОперацииЭТ.СсылочныйНомер = Возвраты.СсылочныйНомерВозврат
                      |ГДЕ
                      |	(ОперацииЭТ.ТипТранзакции = ""AuthorizeRefund""
                      |			ИЛИ ОперацииЭТ.ТипТранзакции = ""AuthorizeVoid"")
                      |	И ОперацииЭТ.ДокументДолг = &ДокументДолг
                      |	И ОперацииЭТ.СуммаОперации = &СуммаОперации");

Запрос.УстановитьПараметр("ДокументДолг", ДокументДолг);
Запрос.УстановитьПараметр("СуммаОперации", СуммаОперации);

ТЗ = Запрос.Выполнить().Выгрузить();
Если ТЗ.Количество() = 0 Тогда
	Возврат "-";
ИначеЕсли ТЗ.Количество() > 1 Тогда
	Возврат "+";
Иначе
	СсылочныйНомер = ТЗ[0].СсылочныйНомер;
	Остаток = ТЗ[0].СуммаОперации - ТЗ[0].СуммаВозврата; 
	Результат = Новый Структура("СсылочныйНомер, Остаток", СсылочныйНомер, Остаток); 
	
	Возврат Результат; 
КонецЕсли;
КонецФункции

&НаКлиенте
Процедура ЗавершениеВопроса_ЕстьПлатежиПоЗаявке(Результат, ДополнительныеПараметры) Экспорт
Если Результат = КодВозвратаДиалога.Отмена Тогда Возврат; КонецЕсли;

ТипТранзакции = ДополнительныеПараметры.ТипТранзакции;
ВозвратОтменаОплатаКартаВыполнить(ТипТранзакции);
КонецПроцедуры

&НаКлиенте
Процедура ВозвратОтменаОплатаКартаВыполнить(ТипТранзакции)
ГУИД_ЭТ_Оплата = ОбщийФункционалСервер.ЗначениеРеквизитаНаСервере(ДокументОплаты, "ГУИД_ЭТ");
Если ЗначениеЗаполнено(ГУИД_ЭТ_Оплата) Тогда	
	//Результат = ПолучитьПараметрыЧекаПоСсылочныйНомер(ГУИД_ЭТ_Оплата);
	Результат = ПолучитьПараметрыЭквайринговойОплаты(ГУИД_ЭТ_Оплата, 0);

ИначеЕсли ЗначениеЗаполнено(ДокументДолг) Тогда	
	//Результат = ПолучитьПараметрыЧекаЗапрос(ДокументДолг, СуммаДокументаОплатыКарта);
	Результат = ПолучитьПараметрыЭквайринговойОплаты(ДокументДолг, СуммаДокументаОплатыКарта);
КонецЕсли;

Если ТипЗнч(Результат) = Тип("Структура") Тогда 
	Если ПроверитьОстатокЭквайринговойОплатыПредупреждение(Результат.Остаток) Тогда
		
		Возврат;
	Иначе
		ПоказатьВопросБудетПроизведенаОтменаВозвратОплаты(ТипТранзакции, Результат.СсылочныйНомер, Результат.НомерЧекаЭТ);		
		
		Возврат;
	КонецЕсли;	
КонецЕсли;	

ДопПараметры = Новый Структура;
ДопПараметры.Вставить("ТипТранзакции", ТипТранзакции);

ПараметрыФормы = Новый Структура;
ПараметрыФормы.Вставить("ЕстьДокументДолг", Истина); 
ПараметрыФормы.Вставить("ДокументДолг", ДокументДолг); 
ПараметрыФормы.Вставить("СуммаОперации", СуммаДокументаОплатыКарта); 

Если ТипТранзакции = "AuthorizeRefund" Тогда
	ТолькоБезКассовогоЧека = Ложь;
Иначе
	ТолькоБезКассовогоЧека = Истина;
КонецЕсли;
ПараметрыФормы.Вставить("ТолькоБезКассовогоЧека", ТолькоБезКассовогоЧека); 

Оповещение = Новый ОписаниеОповещения("Завершение_ФормаВыбораЭТ", ЭтаФорма, ДопПараметры);
ОткрытьФорму("РегистрСведений.ОперацииЭТ.Форма.ФормаВыбораЭТ", ПараметрыФормы, ЭтаФорма
	,,,, Оповещение, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);  
КонецПроцедуры

&НаСервере
Функция ПолучитьПараметрыЭквайринговойОплаты(ЗначениеОтбора, СуммаОперации) 
Запрос = Новый Запрос;
ТекстЗапроса ="ВЫБРАТЬ
              |	ОперацииЭТ.СсылочныйНомер КАК СсылочныйНомер,
              |	ОперацииЭТ.НомерЧекаЭТ КАК НомерЧекаЭТ,
              |	ОперацииЭТ.СуммаОперации КАК СуммаОперации,
              |	ЕСТЬNULL(Возвраты.СуммаВозврата, 0) КАК СуммаВозврата
              |ИЗ
              |	РегистрСведений.ОперацииЭТ КАК ОперацииЭТ
              |		ЛЕВОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
              |			ОперацииЭТ.СсылочныйНомерВозврат КАК СсылочныйНомерВозврат,
              |			СУММА(ОперацииЭТ.СуммаОперации) КАК СуммаВозврата
              |		ИЗ
              |			РегистрСведений.ОперацииЭТ КАК ОперацииЭТ
              |		ГДЕ
              |			ЕСТЬNULL(ОперацииЭТ.СсылочныйНомерВозврат, """") <> """"
              |		
              |		СГРУППИРОВАТЬ ПО
              |			ОперацииЭТ.СсылочныйНомерВозврат) КАК Возвраты
              |		ПО ОперацииЭТ.СсылочныйНомер = Возвраты.СсылочныйНомерВозврат
              |ГДЕ
              |	ОперацииЭТ.ТипТранзакции = ""AuthorizeSales""";

Если ТипЗнч(ЗначениеОтбора) = Тип("УникальныйИдентификатор") Тогда
	ТекстЗапроса = ТекстЗапроса + "
					| И ОперацииЭТ.ГУИД = &ГУИД";
	Запрос.УстановитьПараметр("ГУИД", ЗначениеОтбора);
Иначе
	ТекстЗапроса = ТекстЗапроса + "
                      |	И ОперацииЭТ.ДокументДолг = &ДокументДолг
                      |	И ОперацииЭТ.СуммаОперации = &СуммаОперации";
	Запрос.УстановитьПараметр("ДокументДолг", ЗначениеОтбора);
	Запрос.УстановитьПараметр("СуммаОперации", СуммаОперации);
КонецЕсли;
	
Запрос.Текст = ТекстЗапроса; 	

ТЗ = Запрос.Выполнить().Выгрузить();
Если ТЗ.Количество() = 0 Тогда
	Возврат "-";
ИначеЕсли ТЗ.Количество() > 1 Тогда
	Возврат "+";
Иначе
	СсылочныйНомер = ТЗ[0].СсылочныйНомер;
	НомерЧекаЭТ = ТЗ[0].НомерЧекаЭТ;
	Остаток = ТЗ[0].СуммаОперации - ТЗ[0].СуммаВозврата; 
	Результат = Новый Структура("СсылочныйНомер, НомерЧекаЭТ, Остаток", СсылочныйНомер, НомерЧекаЭТ, Остаток); 
	
	Возврат Результат; 
КонецЕсли;
КонецФункции

&НаКлиенте
Функция ПроверитьОстатокЭквайринговойОплатыПредупреждение(ОстатокОплаты)
Если ОстатокОплаты < СуммаВозвратаКарта Тогда
	ТекстПредупреждения = "Остаток эквайринговой оплаты: " + ОстатокОплаты + " МЕНЬШЕ суммы отмены: " + СуммаВозвратаКарта + "
		|
		|ОТМЕНА/ВОЗВРАТ ОПЛАТЫ ЧЕРЕЗ ЭКВАЙРИНГОВЫЙ ТЕРМИНАЛ ОТМЕНЯЕТСЯ ...";
	ПоказатьПредупреждение(, ТекстПредупреждения);   
	
	Возврат Истина;
КонецЕсли;

Возврат Ложь;
КонецФункции
	
&НаКлиенте
Процедура ПоказатьВопросБудетПроизведенаОтменаВозвратОплаты(ТипТранзакции, СсылочныйНомер, НомерЧекаЭТ)
ДопПараметры = Новый Структура;
ДопПараметры.Вставить("ТипТранзакции", ТипТранзакции );
ДопПараметры.Вставить("СсылочныйНомер", СсылочныйНомер);
ДопПараметры.Вставить("НомерЧекаЭТ", НомерЧекаЭТ);

Оповещение = Новый ОписаниеОповещения("ЗавершениеВопроса_БудетПроизведенаОтменаВозвратОплаты", ЭтаФорма, ДопПараметры);

Если ТипТранзакции = "AuthorizeVoid" Тогда
	Текст = "произведена ОТМЕНА оплаты"
ИначеЕсли ТипТранзакции = "AuthorizeRefund" Тогда
	Текст = "произведен ВОЗВРАТ оплаты"
Иначе 
	Возврат;
КонецЕсли;
ТекстВопроса = "Будет " + Текст + " через эквайринговый терминал на сумму: " + СуммаВозвратаКарта + "
	|
	|ПРОДОЛЖИТЬ ?";

ПоказатьВопрос(Оповещение, ТекстВопроса, РежимДиалогаВопрос.ОКОтмена);
КонецПроцедуры

&НаКлиенте
Процедура Завершение_ФормаВыбораЭТ(Результат, ДополнительныеПараметры) Экспорт
Если Результат = Неопределено Тогда Возврат; КонецЕсли;	

Ответ = ПолучитьПараметрыЭквайринговойОплатыПоКлючуЗаписи(Результат);
Если ПроверитьОстатокЭквайринговойОплатыПредупреждение(Ответ.Остаток) Тогда Возврат; КонецЕсли;

ТипТранзакции = ДополнительныеПараметры.ТипТранзакции;
ПоказатьВопросБудетПроизведенаОтменаВозвратОплаты(ТипТранзакции, Ответ.СсылочныйНомер, Ответ.НомерЧекаЭТ)
КонецПроцедуры

&НаСервере
Функция ПолучитьПараметрыЭквайринговойОплатыПоКлючуЗаписи(КлючЗаписи) 
Запись = регистрыСведений.ОперацииЭТ.СоздатьМенеджерЗаписи();
ЗаполнитьЗначенияСвойств(Запись, КлючЗаписи);     
Запись.Прочитать(); 

НомерКарты = Запись.НомерКарты; 

СсылочныйНомер = Запись.СсылочныйНомер; 
НомерЧекаЭТ = Запись.НомерЧекаЭТ; 

Запрос = Новый Запрос("ВЫБРАТЬ
                      |	СУММА(ОперацииЭТ.СуммаОперации) КАК СуммаОперации
                      |ИЗ
                      |	РегистрСведений.ОперацииЭТ КАК ОперацииЭТ
                      |ГДЕ
                      |	ОперацииЭТ.НомерКарты = &НомерКарты
                      |	И ОперацииЭТ.СсылочныйНомерВозврат = &СсылочныйНомерВозврат
                      |	И ОперацииЭТ.ТипТранзакции В(&ТипТранзакции)");

Запрос.УстановитьПараметр("НомерКарты", НомерКарты);
Запрос.УстановитьПараметр("СсылочныйНомерВозврат", СсылочныйНомер);
ТипТранзакции_СЗ = Новый СписокЗначений;
ТипТранзакции_СЗ.Добавить("AuthorizeVoid");
ТипТранзакции_СЗ.Добавить("AuthorizeRefund");
Запрос.УстановитьПараметр("ТипТранзакции", ТипТранзакции_СЗ);

ТЗ = Запрос.Выполнить().Выгрузить();
Если ТЗ.Количество() = 0 Тогда
	СуммаВозврата = 0;
Иначе
	СуммаВозврата = ТЗ[0].СуммаОперации
КонецЕсли;

СуммаОперации = Запись.СуммаОперации;
Остаток = СуммаОперации - СуммаВозврата; 

Результат = Новый Структура("СсылочныйНомер, НомерЧекаЭТ, Остаток", СсылочныйНомер, НомерЧекаЭТ, Остаток); 
Возврат Результат; 
КонецФункции

&НаКлиенте
Процедура ЗавершениеВопроса_БудетПроизведенаОтменаВозвратОплаты(Результат, ДополнительныеПараметры) Экспорт
