Функция СтавкаНДС(ЭтоКоворкинг) Экспорт
ТекущаяОрганизация = НастройкиСервер.ПолучитьТекущуюОрганизацию();

Если ЭтоКоворкинг И (ТекущаяОрганизация.КоворкингОрганизацияЕсть) Тогда
	СтавкаНДС = ТекущаяОрганизация.КоворкингСтавкаНДС;	
Иначе	
	СтавкаНДС = ТекущаяОрганизация.СтавкаНДС;	
КонецЕсли;

Возврат СтавкаНДС;
КонецФункции

Функция СтавкаНДСТекущая(СтавкаНДС, ДатаУчета) Экспорт
Если ДатаУчета < '20260101'                  
И СтавкаНДС = Перечисления.СтавкиНДС.НДС22 Тогда		
	Возврат Перечисления.СтавкиНДС.НДС20;
Иначе
	Возврат СтавкаНДС;
КонецЕсли;
КонецФункции

Функция СтавкаНДСЧисло(СтавкаНДС) Экспорт
Если СтавкаНДС = Перечисления.СтавкиНДС.НДС22 Тогда
	Возврат 22;
ИначеЕсли СтавкаНДС = Перечисления.СтавкиНДС.НДС20 Тогда
	Возврат 20;
ИначеЕсли СтавкаНДС = Перечисления.СтавкиНДС.НДС5 Тогда
	Возврат 5;
КонецЕсли;
Возврат 0;
КонецФункции

Функция СуммаНДС(СтавкаНДС, Сумма) Экспорт
Если СтавкаНДС = Перечисления.СтавкиНДС.НДС22 Тогда
	Возврат Окр(Сумма * (0.22 / 1.22), 2);
ИначеЕсли СтавкаНДС = Перечисления.СтавкиНДС.НДС20 Тогда
	Возврат Окр(Сумма * (0.2 / 1.2), 2);
ИначеЕсли СтавкаНДС = Перечисления.СтавкиНДС.НДС5 Тогда
	Возврат Окр(Сумма * (0.05 / 1.05), 2);
КонецЕсли;
Возврат 0;
КонецФункции

Функция СуммаБезНДС(СтавкаНДС, Сумма) Экспорт
Если СтавкаНДС = Перечисления.СтавкиНДС.НДС22 Тогда
	Возврат Окр(Сумма / 1.22, 2);
ИначеЕсли СтавкаНДС = Перечисления.СтавкиНДС.НДС20 Тогда
	Возврат Окр(Сумма / 1.2, 2);
ИначеЕсли СтавкаНДС = Перечисления.СтавкиНДС.НДС5 Тогда
	Возврат Окр(Сумма  / 1.05, 2);
КонецЕсли;
Возврат Сумма;
КонецФункции
