	Объект.Клиент2 = Клиент2_OldValue;
	Возврат; 
КонецЕсли;

МассивКасса= Новый Массив;

Если ЗначениеЗаполнено(Клиент2_OldValue) Тогда
	ГрупповойСчет = ОплатыОбщееКлиент.ЕстьГрупповыеСчетаКонтрагент(Объект.Счета, Клиент2_OldValue);
