&НаКлиенте
Процедура ОтправитьНаПочту(Команда)
Получатели = Новый СписокЗначений;
Получатели.Добавить(Почта);

Файлы = Новый Массив;

ПолноеИмяФайла = ПолноеИмяФайлаАкт();
Ответ = СохранитьДокументPDF(ТабДокАкт, ПолноеИмяФайла);
Если Ответ.Ошибка Тогда 
	Текст = "Ошибка сохранения Акта "; 
	
	ПоказатьПредупреждение(, Текст + Символы.ПС + Ответ.ОписаниеОшибки);
	
	//Сообщить(Текст + Ответ.ОписаниеОшибки + ". ОБРАТИТЕСЬ К АДМИНИСТРАТОРУ ПРОГРАММЫ");
	Возврат;
КонецЕсли;
ПолноеИмяФайлаPDF = ПолноеИмяФайла + ".PDF"; 
Файлы.Добавить(ПолноеИмяФайлаPDF);

ПолноеИмяФайла = ПолноеИмяФайлаСчетФактура();
Ответ = СохранитьДокументPDF(ТабДокСчетФактура, ПолноеИмяФайла);
Если Ответ.Ошибка Тогда 
	Текст = "Ошибка сохранения Счета-фактуры "; 
	
	ПоказатьПредупреждение(, Текст  + Символы.ПС + Ответ.ОписаниеОшибки);
	
	//Сообщить(Текст + Ответ.ОписаниеОшибки + ". ОБРАТИТЕСЬ К АДМИНИСТРАТОРУ ПРОГРАММЫ");
	Возврат;
КонецЕсли;
ПолноеИмяФайлаPDF = ПолноеИмяФайла + ".PDF"; 
Файлы.Добавить(ПолноеИмяФайлаPDF);

Если ЭтаФорма.КлючУникальности = Неопределено Тогда
	УникальныйИдентификаторФормы = Новый УникальныйИдентификатор();
Иначе
	УникальныйИдентификаторФормы = Новый УникальныйИдентификатор(ЭтаФорма.КлючУникальности);
КонецЕсли;	
ФайлыКУдалению = Файлы;
СлужебныеКлиент.ОтправитьEmail(ПочтаТема, Файлы, Получатели, ПочтаТекстСообщения, ФайлыКУдалению, УникальныйИдентификаторФормы);
КонецПроцедуры

