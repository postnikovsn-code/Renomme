	,,,, ОповещениеПриЗакрытии, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	
ДатаС = КоворкингСервер.СледующийСчетДатаС(КоворкингЗаявкаОбъект); 

ДатаПо = СчетДатаПо(ДатаС, КоворкингЗаявкаОбъект.ПериодАренды);
Если ДатаПо = Неопределено Тогда Возврат Неопределено; КонецЕсли; 
//

СчетОбъект = ФормаСчет.Объект; 
	
//СчетОбъект = Документы.КоворкингСчета.СоздатьДокумент();
//СчетОбъект = Неопределено;
//СчетОбъект.СчетГУИД = Новый УникальныйИдентификатор();

СчетОбъект.Дата = ТекущаяДата();
СчетОбъект.КоворкингЗаявка = КоворкингЗаявкаОбъект.Ссылка;      

Если ЗначениеЗаполнено(КоворкингЗаявкаОбъект.Оплачивает) Тогда
	СчетОбъект.ОплачиваетСчет = КоворкингЗаявкаОбъект.Оплачивает; 
Иначе
	СчетОбъект.ОплачиваетСчет = КоворкингЗаявкаОбъект.Клиент; 
КонецЕсли;

СчетОбъект.ПочасоваяОплата = Истина;

СледующийСчетДатаС = КоворкингСервер.СледующийСчетДатаС(КоворкингЗаявкаОбъект.Ссылка);
СчетОбъект.ДатаС = СледующийСчетДатаС;
СчетОбъект.ДатаПо = СчетОбъект.ДатаС;

СчетОбъект.ЧасС = КоворкингЗаявкаОбъект.ЧасС;
СчетОбъект.ЧасПо = КоворкингЗаявкаОбъект.ЧасПо;

//СрокиАренды = СчетОбъект.СрокиАренды;
//ЗаполнитьСрокиАренды(СрокиАренды, ДатаС, ДатаПо, КоворкингЗаявкаОбъект.ВключатьВыходные);

//СчетОбъект.Количество = СрокиАренды.Количество();
СчетОбъект.КоличествоЕдиниц = КоворкингЗаявкаОбъект.ЧасПо - КоворкингЗаявкаОбъект.ЧасС;
СчетОбъект.Количество = СчетОбъект.КоличествоЕдиниц;

СчетОбъект.Цена = КоворкингЗаявкаОбъект.Цена;
СчетОбъект.Сумма = СчетОбъект.Цена * СчетОбъект.Количество;

//СчетОбъект.ВключатьВыходные = КоворкингЗаявкаОбъект.ВключатьВыходные;

//СчетОбъект.Записать(РежимЗаписиДокумента.Проведение); 

//Возврат СчетОбъект.Ссылка;
КонецФункции

