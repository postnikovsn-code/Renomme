&НаСервере
Функция ЗаполнитьТаб()
	Объект.ПроданныеНомера.Очистить();
	Объект.Незаезды.Очистить();
	Объект.Аннуляции.Очистить();
	
	//ЗапросПроживающих=Новый запрос("ВЫБРАТЬ РАЗЛИЧНЫЕ
	//|	ЗанятостьНомеров.Регистратор,
	//|	ЗанятостьНомеров.Регистратор.Клиент КАК Клиент,
	//|	ЗанятостьНомеров.Регистратор.Тариф КАК Тариф,
	//|	ЗанятостьНомеров.Регистратор.ВремяЗаездаТочное КАК Заезд,
	//|	ЗанятостьНомеров.Регистратор.ВремяВыездаТочное КАК Выезд,
	//|	ЗанятостьНомеров.Регистратор.Бронирует  КАК Бронирует
	//|ИЗ
	//|	РегистрСведений.ЗанятостьНомеров КАК ЗанятостьНомеров
	//|ГДЕ
	//|	(ЗанятостьНомеров.Регистратор.Статус = &Статус
	//|			ИЛИ ЗанятостьНомеров.Регистратор.Статус = &Статус2)
	//|	И (ЗанятостьНомеров.ПериодРезерва МЕЖДУ &ДН И &ДК
	//|			ИЛИ ЗанятостьНомеров.Регистратор.ВремяЗаездаТочное МЕЖДУ &ДН2 И &ДК2)
	//|
	//|УПОРЯДОЧИТЬ ПО
	//|	ЗанятостьНомеров.Номер.Наименование");
	
	ЗапросПроживающих=Новый запрос("ВЫБРАТЬ РАЗЛИЧНЫЕ
       |	ЗанятостьНомеров.Регистратор КАК Регистратор,
       |	ЗанятостьНомеров.Регистратор.Клиент КАК Клиент,
       |	ЗанятостьНомеров.Регистратор.Тариф_НеИспользуется КАК Тариф_НеИспользуется,
       |	ЗанятостьНомеров.Регистратор.ВремяЗаездаТочное КАК Заезд,
       |	ЗанятостьНомеров.Регистратор.ВремяВыездаТочное КАК Выезд,
       |	ЗанятостьНомеров.Регистратор.Бронирует КАК Бронирует,
       |	ЗанятостьНомеров.Номер.Наименование КАК НомерНаименование
       |ИЗ
       |	РегистрСведений.ЗанятостьНомеров КАК ЗанятостьНомеров
       |ГДЕ
       |	(ЗанятостьНомеров.Регистратор.Статус = &Статус
       |			ИЛИ ЗанятостьНомеров.Регистратор.Статус = &Статус2)
       |	И (ЗанятостьНомеров.ПериодРезерва МЕЖДУ &ДН И &ДК
       |			ИЛИ ЗанятостьНомеров.Регистратор.ВремяЗаездаТочное МЕЖДУ &ДН2 И &ДК2)
       |
       |УПОРЯДОЧИТЬ ПО
       |	НомерНаименование");

	ЗапросПроживающих.УстановитьПараметр("Статус",Перечисления.СтатусБрони.Проживает);								   
	ЗапросПроживающих.УстановитьПараметр("Статус2",Перечисления.СтатусБрони.Выехал);	
	ЗапросПроживающих.УстановитьПараметр("ДН",НачалоДня(Объект.Дата)+11*60*60);								   
	ЗапросПроживающих.УстановитьПараметр("ДК",КонецДня(Объект.Дата));	
	ЗапросПроживающих.УстановитьПараметр("ДН2",НачалоДня(Объект.Дата)+11*60*60);//КонецДня(Дата));								   
	ЗапросПроживающих.УстановитьПараметр("ДК2",КонецДня(Объект.Дата)+9*60*60);	
	
	ЗапросПроживающих.УстановитьПараметр("ДН3",НачалоДня(Объект.Дата));								   
	ЗапросПроживающих.УстановитьПараметр("ДК3",НачалоДня(Объект.Дата)+8*60*60);	
	////|	И (НЕ(ЗанятостьНомеров.Регистратор.ВремяЗаездаТочное МЕЖДУ &ДН3 И &ДК3))
	ТЗ=ЗапросПроживающих.Выполнить().Выгрузить();
	
	Для каждого Стр Из ТЗ Цикл
		Если Стр.Заезд>Дата(2000,1,1) и Стр.Заезд>КонецДня(Объект.Дата)+9*60*60 тогда
			Продолжить;
		конецесли;
		
		////Если Стр.Заезд>Дата(2000,1,1) и Стр.Заезд>КонецДня(Дата)+8*86400 тогда
		////	Продолжить;
		////конецесли;
		
		Если Стр.Выезд>Дата(2000,1,1) и Стр.Выезд<НачалоДня(Объект.Дата) тогда
			Продолжить;
		конецесли;
		
		Если Стр.Тариф.Код="000000400" тогда // романик
			Если Стр.Заезд>Дата(2000,1,1) и Стр.Выезд>Дата(2000,1,1) тогда
				Если НачалоДня(Стр.Заезд)<>НачалоДня(Стр.Выезд) тогда
					если Стр.Заезд<НачалоДня(Объект.Дата) тогда //вчерашний романтик
						Продолжить;	
					конецесли;
					
				конецесли;				
			конецесли;
		конецесли;
		
		
		Нов=Объект.ПроданныеНомера.Добавить();
