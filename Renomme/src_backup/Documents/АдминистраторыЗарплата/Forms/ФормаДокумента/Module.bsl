	 	+ ТД["КоличествоЗаселенийДомСоветов_" + Дата_И + "_Р"];
	ТД["КоличествоЗаселенийДомСоветов_" + Дата_И + "_Э"] = КоличествоЗаселенийДомСоветов;
	
	СуммаЗаселенийДомСоветов = СуммаЗаселенийЗаСмену(ТД.Администратор, ТД["КоличествоЗаселенийДомСоветов_" + Дата_И + "_Э"]);	
	ТД["СуммаЗаселенийДомСоветов_" + Дата_И] = СуммаЗаселенийДомСоветов;	
	
	КоличествоЗаселенийСтритАртЗаСмену = КоличествоЗаселенийЗаСмену(ЗаселенияВСтритАрт, ТД.Администратор, ДатаВремяС, ДатаВремяПо);
	ТД["КоличествоЗаселенийСтритАрт_" + Дата_И] = КоличествоЗаселенийСтритАртЗаСмену;
	КоличествоЗаселенийСтритАрт = ТД["КоличествоЗаселенийСтритАрт_" + Дата_И] 
	 	+ ТД["КоличествоЗаселенийСтритАрт_" + Дата_И + "_Р"];
	ТД["КоличествоЗаселенийСтритАрт_" + Дата_И + "_Э"] = КоличествоЗаселенийСтритАрт;
	
	СуммаЗаселенийСтритАрт = СуммаЗаселенийЗаСмену(ТД.Администратор, ТД["КоличествоЗаселенийСтритАрт_" + Дата_И + "_Э"]);	
	ТД["СуммаЗаселенийСтритАрт_" + Дата_И] = СуммаЗаселенийСтритАрт;	
	
~ВЫХОД:
	ТД["Итого_" + Дата_И] = 
	  ТД["Оклад_" + Дата_И + "_Э"]
	+ ТД["СуммаЗаПроживающих_"  + Дата_И]
	+ ТД["СуммаПереработка_" + Дата_И]
	+ ТД["СуммаЗаселенийЛайв_" + Дата_И]
	+ ТД["СуммаЗаселенийДомСоветов_" + Дата_И]
	+ ТД["СуммаЗаселенийСтритАрт_" + Дата_И]
	+ ТД["СуммаЗавтракиЧехов_" + Дата_И]
	+ ТД["СуммаЗавтракиДомСоветов_" + Дата_И]
	+ ТД["СуммаЗавтракиЛайв_" + Дата_И]
	+ ТД["СуммаДопУслуги_" + Дата_И]
	; 

	Дата_П = Дата_П + 24 * 60 * 60;
КонецЦикла;
КонецПроцедуры

&НаСервере
Процедура ОбновитьСтрокаЗарплатыСменаИзДат(Строка)
СуммаПереработка = 0;
	
КоличествоСмен = 0;
КоличествоЧасов = 0;
Оклад = 0;
Отпуск = 0;

СуммаЗаПроживающих = 0;
КоличествоЗаселенийЛайв = 0;
СуммаЗаселенийЛайв = 0;
КоличествоЗаселенийДомСоветов = 0;
СуммаЗаселенийДомСоветов = 0;
КоличествоЗаселенийСтритАрт = 0;
СуммаЗаселенийСтритАрт = 0;

КоличествоЗавтракиЧехов = 0;
СуммаЗавтракиЧехов = 0;
КоличествоЗавтракиДомСоветов = 0;
СуммаЗавтракиДомСоветов = 0;
КоличествоЗавтракиЛайв = 0;
СуммаЗавтракиЛайв = 0;

СуммаДопУслуги = 0;

Дата_П = Объект.ДН;
Пока Дата_П <= Объект.ДК Цикл
	Дата_С = Формат(Дата_П, "ДФ=dd.MM.yy");
	Дата_И = СтрЗаменить(Дата_С, ".", "");
	
	Имя = "СуммаПереработка_" + Дата_И;
	СуммаПереработка = СуммаПереработка + Строка[Имя];
	
	Имя = "КоличествоЗавтракиЧехов_" + Дата_И;
	КоличествоЗавтракиЧехов = КоличествоЗавтракиЧехов + Строка[Имя];
		
	Имя = "СуммаЗавтракиЧехов_" + Дата_И;
	СуммаЗавтракиЧехов = СуммаЗавтракиЧехов + Строка[Имя];
	
	Имя = "КоличествоЗавтракиДомСоветов_" + Дата_И;
	КоличествоЗавтракиДомСоветов = КоличествоЗавтракиДомСоветов + Строка[Имя];
		
	Имя = "СуммаЗавтракиДомСоветов_" + Дата_И;
	СуммаЗавтракиДомСоветов = СуммаЗавтракиДомСоветов + Строка[Имя];
	
	Имя = "КоличествоЗавтракиЛайв_" + Дата_И;
	КоличествоЗавтракиЛайв = КоличествоЗавтракиЛайв + Строка[Имя];
		
	Имя = "СуммаЗавтракиЛайв_" + Дата_И;
	СуммаЗавтракиЛайв = СуммаЗавтракиЛайв + Строка[Имя];
	
	Имя = "СуммаДопУслуги_" + Дата_И;
	СуммаДопУслуги = СуммаДопУслуги + Строка[Имя];
	
	Имя = "НомерСмены_" + Дата_И;
	Если Строка[Имя] = 0 Тогда Перейти ~ПРОДОЛЖИТЬ; КонецЕсли;
	
	Если Строка[Имя] = 3 Тогда
		Имя = "Оклад_" + Дата_И + "_Э";
		Отпуск = Отпуск + Строка[Имя];
	Иначе
		ДлинаСмены = Строка["ДлинаСмены_" + Дата_И];
		//Если ОтельИмя = "Чехов" 
		//И ДлинаСмены <= 12 
		//И (НЕ Строка.Администратор.Постоянный) 
		//Тогда
		//	КоличествоСмен = КоличествоСмен + 1;
		//Иначе
		//	КоличествоСмен = КоличествоСмен + 2;
		//КонецЕсли;
		Если ОтельИмя = "Чехов" Тогда 
			Если ДлинаСмены <= 12 
			//ИЛИ Строка.Администратор.Постоянный 
			Тогда
				КоличествоСмен = КоличествоСмен + 1;
			Иначе
				КоличествоСмен = КоличествоСмен + 2;
			КонецЕсли;   
		Иначе
	  		КоличествоСмен = КоличествоСмен + 1;
		КонецЕсли;   
			
	  //КоличествоСмен = КоличествоСмен + 1;
		
		Имя = "Оклад_" + Дата_И + "_Э";
		Оклад = Оклад + Строка[Имя];
		
		Имя = "СуммаЗаПроживающих_" + Дата_И;
		СуммаЗаПроживающих = СуммаЗаПроживающих + Строка[Имя];
			
		Имя = "КоличествоЗаселенийЛайв_" + Дата_И + "_Э";
		КоличествоЗаселенийЛайв = КоличествоЗаселенийЛайв + Строка[Имя];
			
		Имя = "СуммаЗаселенийЛайв_" + Дата_И;
		СуммаЗаселенийЛайв = СуммаЗаселенийЛайв + Строка[Имя];
		
		Имя = "КоличествоЗаселенийДомСоветов_" + Дата_И + "_Э";
		КоличествоЗаселенийДомСоветов = КоличествоЗаселенийДомСоветов + Строка[Имя];
			
		Имя = "СуммаЗаселенийДомСоветов_" + Дата_И;
		СуммаЗаселенийДомСоветов = СуммаЗаселенийДомСоветов + Строка[Имя];
		
		Имя = "КоличествоЗаселенийСтритАрт_" + Дата_И + "_Э";
		КоличествоЗаселенийСтритАрт = КоличествоЗаселенийСтритАрт + Строка[Имя];
			
		Имя = "СуммаЗаселенийСтритАрт_" + Дата_И;
		СуммаЗаселенийСтритАрт = СуммаЗаселенийСтритАрт + Строка[Имя];
		
	КонецЕсли;
	
~ПРОДОЛЖИТЬ:   

	Имя = "ДлинаСмены_" + Дата_И;
	КоличествоЧасов = КоличествоЧасов + Строка[Имя];;
	
	Имя = "ПереработкаЧасы_" + Дата_И;
	КоличествоЧасов = КоличествоЧасов + Строка[Имя];;

	Дата_П = Дата_П + 24 * 60 * 60;
КонецЦикла;
	
Строка.КоличествоСмен = КоличествоСмен;

Строка.КоличествоЧасов = КоличествоЧасов;

Если НЕ Строка.Администратор.Постоянный Тогда
	Строка.Оклад = Оклад;	
КонецЕсли;

Строка.Отпуск = Отпуск;	

Строка.СуммаПереработка = СуммаПереработка;	

Если НЕ Строка.Администратор.Постоянный Тогда
	Строка.СуммаЗаПроживающих = СуммаЗаПроживающих;	
КонецЕсли;

Строка.КоличествоЗаселенийЛайв = КоличествоЗаселенийЛайв;	
Строка.СуммаЗаселенийЛайв = СуммаЗаселенийЛайв;	
Строка.КоличествоЗаселенийДомСоветов = КоличествоЗаселенийДомСоветов;	
Строка.СуммаЗаселенийДомСоветов = СуммаЗаселенийДомСоветов;	
Строка.КоличествоЗаселенийСтритАрт = КоличествоЗаселенийСтритАрт;	
Строка.СуммаЗаселенийСтритАрт = СуммаЗаселенийСтритАрт;	

Строка.КоличествоЗавтракиЧехов = КоличествоЗавтракиЧехов;	
Строка.СуммаЗавтракиЧехов = СуммаЗавтракиЧехов;	
Строка.КоличествоЗавтракиДомСоветов = КоличествоЗавтракиДомСоветов;	
Строка.СуммаЗавтракиДомСоветов = СуммаЗавтракиДомСоветов;	
Строка.КоличествоЗавтракиЛайв = КоличествоЗавтракиЛайв;	
Строка.СуммаЗавтракиЛайв = СуммаЗавтракиЛайв;	

Строка.ДопУслуги = СуммаДопУслуги;	
КонецПроцедуры

&НаСервере
Процедура ОбновитьСтрокаЗарплатаСменыОсновные_Э(ТД)
Если ТД.Оклад_Есть Тогда 
	ТД.Оклад_Э = ТД.Оклад_Р;
Иначе
	ТД.Оклад_Э = ТД.Оклад;
КонецЕсли;

Если ТД.Отпуск_Есть Тогда 
	ТД.Отпуск_Э = ТД.Отпуск_Р;
Иначе
	ТД.Отпуск_Э = ТД.Отпуск;
КонецЕсли;

Если ТД.СуммаПереработка_Есть Тогда 
	ТД.СуммаПереработка_Э = ТД.СуммаПереработка_Р;
Иначе
	ТД.СуммаПереработка_Э = ТД.СуммаПереработка;
КонецЕсли;

Если ТД.НадбавкаЗаСтаж_Есть Тогда 
	ТД.НадбавкаЗаСтаж_Э = ТД.НадбавкаЗаСтаж_Р;
Иначе
	ТД.НадбавкаЗаСтаж_Э = ТД.НадбавкаЗаСтаж;
КонецЕсли;

Если ТД.НадбавкаЗаСтандарты_Есть Тогда 
	ТД.НадбавкаЗаСтандарты_Э = ТД.НадбавкаЗаСтандарты_Р;
Иначе
	ТД.НадбавкаЗаСтандарты_Э = ТД.НадбавкаЗаСтандарты;
КонецЕсли;

Если ТД.НадбавкаЗаИнЯзыки_Есть Тогда 
	ТД.НадбавкаЗаИнЯзыки_Э = ТД.НадбавкаЗаИнЯзыки_Р;
Иначе
	ТД.НадбавкаЗаИнЯзыки_Э = ТД.НадбавкаЗаИнЯзыки;
КонецЕсли;

Если ТД.СуммаЗаПроживающих_Есть Тогда 
	ТД.СуммаЗаПроживающих_Э = ТД.СуммаЗаПроживающих_Р;
Иначе
	ТД.СуммаЗаПроживающих_Э = ТД.СуммаЗаПроживающих;
КонецЕсли;

ТД.КоличествоЗаселенийЛайв_Э = ТД.КоличествоЗаселенийЛайв + ТД.КоличествоЗаселенийЛайв_Р;
ТД.СуммаЗаселенийЛайв_Э = ТД.СуммаЗаселенийЛайв + ТД.СуммаЗаселенийЛайв_Р;

ТД.КоличествоЗаселенийДомСоветов_Э = ТД.КоличествоЗаселенийДомСоветов + ТД.КоличествоЗаселенийДомСоветов_Р;
ТД.СуммаЗаселенийДомСоветов_Э = ТД.СуммаЗаселенийДомСоветов + ТД.СуммаЗаселенийДомСоветов_Р;

ТД.КоличествоЗаселенийСтритАрт_Э = ТД.КоличествоЗаселенийСтритАрт + ТД.КоличествоЗаселенийСтритАрт_Р;
ТД.СуммаЗаселенийСтритАрт_Э = ТД.СуммаЗаселенийСтритАрт + ТД.СуммаЗаселенийСтритАрт_Р;

ТД.КоличествоЗавтракиЧехов_Э = ТД.КоличествоЗавтракиЧехов + ТД.КоличествоЗавтракиЧехов_Р;
ТД.СуммаЗавтракиЧехов_Э = ТД.СуммаЗавтракиЧехов + ТД.СуммаЗавтракиЧехов_Р;

ТД.КоличествоЗавтракиДомСоветов_Э = ТД.КоличествоЗавтракиДомСоветов + ТД.КоличествоЗавтракиДомСоветов_Р;
ТД.СуммаЗавтракиДомСоветов_Э = ТД.СуммаЗавтракиДомСоветов + ТД.СуммаЗавтракиДомСоветов_Р;

ТД.КоличествоЗавтракиЛайв_Э = ТД.КоличествоЗавтракиЛайв + ТД.КоличествоЗавтракиЛайв_Р;
ТД.СуммаЗавтракиЛайв_Э = ТД.СуммаЗавтракиЛайв + ТД.СуммаЗавтракиЛайв_Р;
КонецПроцедуры

&НаСервере
Процедура ОбновитьЗарплатаСменыИтоги(ТД)
СменыИтого = ТД.Оклад_Э 
	+ ТД.СуммаПереработка_Э
	+ ТД.СуммаЗаПроживающих_Э
	+ ТД.СуммаЗаселенийЛайв_Э
	+ ТД.СуммаЗаселенийДомСоветов_Э
	+ ТД.СуммаЗаселенийСтритАрт_Э
	+ ТД.СуммаЗавтракиЧехов_Э
	+ ТД.СуммаЗавтракиДомСоветов_Э
	+ ТД.СуммаЗавтракиЛайв_Э
	;
	
ЗарплатаИтого = СменыИтого + ТД.НадбавкаЗаСтаж_Э + ТД.НадбавкаЗаСтандарты_Э + ТД.НадбавкаЗаИнЯзыки_Э
	+ ТД.Отпуск_Э 
	+ ТД.Больничный 
	+ ТД.Премия 
	+ ТД.ДопУслуги
	+ ТД.СуммаПрочее
	;
	
ТД.ИтогоСмены = СменыИтого;
ТД.Итого = ЗарплатаИтого;

Выплачено = ТД.АвансНал + ТД.АвансКарта + ТД.ОтпускныеКарта + ТД.ЗПКарта 
			+ ТД.ИныеВыплатыНал + ТД.ИныеВыплатыКарта; 
ТД.КВыплате = ЗарплатаИтого - Выплачено;

КонецПроцедуры
//

&НаСервере
Процедура ОбновитьЗарплатыСмена()
Для Каждого Строка Из ЗарплатаСмены Цикл
	ОбновитьСтрокаЗарплатыСмена(Строка);
КонецЦикла;	
КонецПроцедуры


//
&НаСервере
Процедура ПровестиНаСервере(ДН, ДК)
	
ЗаполнитьПередЗаписью(ДН, ДК);

ЭтотОбъект.Записать(Новый Структура("РежимЗаписи", РежимЗаписиДокумента.Проведение));
КонецПроцедуры

&НаКлиенте
Процедура ПередЗаписью(Отказ, ПараметрыЗаписи)
Если НЕ (ЗначениеЗаполнено(Объект.ДН) И ЗначениеЗаполнено(Объект.ДК)) Тогда 
	
	Отказ = Истина;
	Возврат; 
КонецЕсли; 

ПараметрыЗаписи.РежимЗаписи = РежимЗаписиДокумента.Проведение;
	
ЗаполнитьПередЗаписью(Объект.ДН, Объект.ДК);                   
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьПередЗаписью(ДН, ДК)
	
Объект.Зарплата.Очистить();	
	
//Объект.ЗарплатаСмены.Очистить();
МассивКУдалению = Новый Массив;
Для Каждого Строка Из Объект.ЗарплатаСмены Цикл
	Если Строка.ДатаСмены < ДН ИЛИ Строка.ДатаСмены > ДК Тогда Продолжить; КонецЕсли;
	
	МассивКУдалению.Добавить(Строка);
КонецЦикла;

Для Каждого Строка Из МассивКУдалению Цикл
	Объект.ЗарплатаСмены.Удалить(Строка);
КонецЦикла;

Для Каждого Строка Из ЗарплатаСмены Цикл
	//
	НоваяСтрокаЗарплата = Объект.Зарплата.Добавить();
	НоваяСтрокаЗарплата.Администратор = Строка.Администратор;
	
	НоваяСтрокаЗарплата.Оклад = Строка.Оклад;
	НоваяСтрокаЗарплата.Оклад_Р = Строка.Оклад_Р;
	НоваяСтрокаЗарплата.Оклад_Есть = Строка.Оклад_Есть;
	
	НоваяСтрокаЗарплата.Отпуск = Строка.Отпуск;
	НоваяСтрокаЗарплата.Отпуск_Р = Строка.Отпуск_Р;
	НоваяСтрокаЗарплата.Отпуск_Есть = Строка.Отпуск_Есть;
	
	НоваяСтрокаЗарплата.СуммаПереработка = Строка.СуммаПереработка;
	НоваяСтрокаЗарплата.СуммаПереработка_Р = Строка.СуммаПереработка_Р;
	НоваяСтрокаЗарплата.СуммаПереработка_Есть = Строка.СуммаПереработка_Есть;
	
	НоваяСтрокаЗарплата.НадбавкаЗаСтаж = Строка.НадбавкаЗаСтаж;
	НоваяСтрокаЗарплата.НадбавкаЗаСтаж_Р = Строка.НадбавкаЗаСтаж_Р;
	НоваяСтрокаЗарплата.НадбавкаЗаСтаж_Есть = Строка.НадбавкаЗаСтаж_Есть;
	
	НоваяСтрокаЗарплата.НадбавкаЗаСтандарты = Строка.НадбавкаЗаСтандарты;
	НоваяСтрокаЗарплата.НадбавкаЗаСтандарты_Р = Строка.НадбавкаЗаСтандарты_Р;
	НоваяСтрокаЗарплата.НадбавкаЗаСтандарты_Есть = Строка.НадбавкаЗаСтандарты_Есть;
	
	НоваяСтрокаЗарплата.НадбавкаЗаИнЯзыки = Строка.НадбавкаЗаИнЯзыки;
	НоваяСтрокаЗарплата.НадбавкаЗаИнЯзыки_Р = Строка.НадбавкаЗаИнЯзыки_Р;
	НоваяСтрокаЗарплата.НадбавкаЗаИнЯзыки_Есть = Строка.НадбавкаЗаИнЯзыки_Есть;
	
	НоваяСтрокаЗарплата.КоличествоСмен = Строка.КоличествоСмен;	
	
	НоваяСтрокаЗарплата.СуммаЗаПроживающих = Строка.СуммаЗаПроживающих;
