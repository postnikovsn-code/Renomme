Иначе
	Возврат Неопределено;
КонецЕсли;	

НомерИмяЯчейки = "R2"  + "C" + Строка(НачалоНомерСтолбцаДата);
//НомерИмяЯчейки = НомерИмяЯчейки + ":" + НомерИмяЯчейки;
НомерИмяЯчейки = НомерИмяЯчейки + ":" + "R2"  + "C" + Строка(НачалоНомерСтолбцаДата + 3);;
ОбластьДата = ПолеОтчета.ПолучитьОбласть(НомерИмяЯчейки);

