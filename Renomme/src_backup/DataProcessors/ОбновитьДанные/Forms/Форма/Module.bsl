&НаСервере
Процедура ОбновитьПутьДоФотоНаСервере()
Запрос = Новый Запрос("ВЫБРАТЬ
                      |	Клиенты.Ссылка КАК Ссылка
                      |ИЗ
                      |	Справочник.Клиенты КАК Клиенты");

ТЗ = Запрос.Выполнить().Выгрузить();

//Каталог = Константы.Папка_C_BASE.Получить() + "SCAN\";
Каталог = СлужебныеСервер.КаталогСканов();

Для Каждого Строка Из ТЗ Цикл
	КлиентОбъект = Строка.Ссылка.ПолучитьОбъект();
	
	Сканы = КлиентОбъект.СканыДокументов;
	Если Сканы.Количество() = 0 Тогда Продолжить; КонецЕсли;
	
	МассивКУдалению = Новый Массив;
	Для Каждого Скан Из Сканы Цикл
		ИмяФайлаИсточника = Скан.ПутьДоФото; 
		
		Индекс = СтрНайти(Скан.ПутьДоФото, "\", НаправлениеПоиска.СКонца);
		ИмяФайла = Сред(ИмяФайлаИсточника, Индекс + 1); 
		ИмяФайлаИсточника = Каталог + ИмяФайла;
		
		ГУИДСтрока = Строка(Строка.Ссылка.УникальныйИдентификатор());
		Если Лев(ИмяФайла, 36) = ГУИДСтрока Тогда Продолжить; КонецЕсли;
		
		Скан.ПутьДоФото = ГУИДСтрока + "_" + ИмяФайла; 
		
		ИмяФайлаПриемника = Каталог + Скан.ПутьДоФото; 
		
		Попытка
			ПереместитьФайл(ИмяФайлаИсточника, ИмяФайлаПриемника); 
		Исключение
			МассивКУдалению.Добавить(Скан);
		КонецПопытки;
	КонецЦикла;
	
	Для Каждого Элемент Из МассивКУдалению Цикл
		Сканы.Удалить(Элемент);		
	КонецЦикла;
	
	КлиентОбъект.Записать();	
КонецЦикла;
КонецПроцедуры
