
Функция СформироватьОтчетНаСервере(Макет, Знач ДатаОтчетаС, Знач ДатаОтчетаПо, ТипДатаС, ТипДатаПо, БронируетОтбор
	, НеПоказыватьЗакрытыеНераспределенныеОплаты, ЭтоОтчет) Экспорт
//ПолеОтчета.Очистить();

ТабДок = Новый ТабличныйДокумент;      

// + Оплаты Дни
ПолеОтчета = СформироватьОплатыДни(Макет,  ДатаОтчетаС,  ДатаОтчетаПо, ТипДатаС, ТипДатаПо, БронируетОтбор
	, НеПоказыватьЗакрытыеНераспределенныеОплаты, ЭтоОтчет);
	
ТабДок.Вывести(ПолеОтчета);
// - Оплаты Дни

////
// + Нераспределенные оплаты
ПолеОтчета = СформироватьНераспределенныеОплаты(Макет,  ДатаОтчетаС,  ДатаОтчетаПо, ТипДатаС, ТипДатаПо, БронируетОтбор
	, НеПоказыватьЗакрытыеНераспределенныеОплаты, ЭтоОтчет);
	
ТабДок.Вывести(ПолеОтчета);
// - Нераспределенные оплаты
	

// + Оплаты Бронь
ПолеОтчета = СформироватьОплатыБрони(Макет,  ДатаОтчетаС,  ДатаОтчетаПо, ТипДатаС, ТипДатаПо, БронируетОтбор
	, НеПоказыватьЗакрытыеНераспределенныеОплаты, ЭтоОтчет);
	
ТабДок.Вывести(ПолеОтчета);
// - Оплаты Бронь

// + Возвраты
ПолеОтчета = СформироватьВозвраты(Макет,  ДатаОтчетаС,  ДатаОтчетаПо, ТипДатаС, ТипДатаПо, БронируетОтбор
	, НеПоказыватьЗакрытыеНераспределенныеОплаты, ЭтоОтчет);
	
ТабДок.Вывести(ПолеОтчета);
// - Возвраты

// + Платежи
ПолеОтчета = СформироватьПлатежиКонтрагенту(Макет,  ДатаОтчетаС,  ДатаОтчетаПо, ТипДатаС, ТипДатаПо, БронируетОтбор
	, НеПоказыватьЗакрытыеНераспределенныеОплаты, ЭтоОтчет);
	
ТабДок.Вывести(ПолеОтчета);
// - Платежи


// + Оплаты                            
ПолеОтчета = СформироватьОплатыЗаявки(Макет,  ДатаОтчетаС,  ДатаОтчетаПо, ТипДатаС, ТипДатаПо, БронируетОтбор
	, НеПоказыватьЗакрытыеНераспределенныеОплаты, ЭтоОтчет);
ТабДок.Вывести(ПолеОтчета);
// - Оплаты 

	
////
 

//Если ЭтоОтчет Тогда
//	Колонка_1 = Область.ШиринаТаблицы - 3;
//	Колонка_2 = Область.ШиринаТаблицы - 1;
//	ПолеОтчета.Область(, Колонка_1, ,Колонка_2).Видимость = Ложь;   
//Иначе	
//	КолонкаЗавтракиЗаявка = Область.ШиринаТаблицы - 4;
//	ПолеОтчета.Область(, КолонкаЗавтракиЗаявка, ,КолонкаЗавтракиЗаявка).Видимость = Ложь;   
//	
//	КолонкаАвторскоеВознаграждениеОплата = Область.ШиринаТаблицы - 9;
//	КолонкаАвторскоеВознаграждениеФормаОплаты = Область.ШиринаТаблицы - 7;
//	ПолеОтчета.Область(, КолонкаАвторскоеВознаграждениеОплата, ,КолонкаАвторскоеВознаграждениеФормаОплаты).Видимость = Ложь;   
//	
//	КолонкаОплатил = Область.ШиринаТаблицы - 12;
//	ПолеОтчета.Область(, КолонкаОплатил, ,КолонкаОплатил).Видимость = Ложь;   
//КонецЕсли;

//Возврат ПолеОтчета;

Область = Макет.ПолучитьОбласть("Строка|КолонкиЛево");
КолонкаКоличествоСчетов = Область.ШиринаТаблицы;
ТабДок.Область(, КолонкаКоличествоСчетов, ,КолонкаКоличествоСчетов).Видимость = Ложь; 

Если ЭтоОтчет Тогда
	//Колонка_1 = Область.ШиринаТаблицы - 3;
	//Колонка_2 = Область.ШиринаТаблицы - 1;
	//ТабДок.Область(, Колонка_1, ,Колонка_2).Видимость = Ложь;   
Иначе	
	КолонкаЗавтракиЗаявка = Область.ШиринаТаблицы - 4;
	ТабДок.Область(, КолонкаЗавтракиЗаявка, ,КолонкаЗавтракиЗаявка).Видимость = Ложь;   
	
	КолонкаАвторскоеВознаграждениеОплата = Область.ШиринаТаблицы - 9;
	КолонкаАвторскоеВознаграждениеФормаОплаты = Область.ШиринаТаблицы - 7;
	ТабДок.Область(, КолонкаАвторскоеВознаграждениеОплата, ,КолонкаАвторскоеВознаграждениеФормаОплаты).Видимость = Ложь;   
	
	КолонкаОплатил = Область.ШиринаТаблицы - 12;
	ТабДок.Область(, КолонкаОплатил, ,КолонкаОплатил).Видимость = Ложь;   
КонецЕсли;

//
ТабДок.ОриентацияСтраницы = ОриентацияСтраницы.Ландшафт;
//ПолеОтчета.ОтображатьСетку = Истина;
//ПолеОтчета.ОтображатьЗаголовки = Истина;


//ОбластьШапка = ТабДок.Область("R1"); 
ОбластьШапка = ТабДок.Область(0,,0); 
ТабДок.ПовторятьПриПечатиСтроки = ОбластьШапка;

ТабДок.ФиксацияСверху = 1;
Возврат ТабДок;
КонецФункции

Функция СформироватьОплатыДни(Макет, Знач ДатаОтчетаС, Знач ДатаОтчетаПо, ТипДатаС, ТипДатаПо, БронируетОтбор
	, НеПоказыватьЗакрытыеНераспределенныеОплаты, ЭтоОтчет) Экспорт

ПолеОтчета = Новый ТабличныйДокумент;      

ПолеОтчета.ОриентацияСтраницы = ОриентацияСтраницы.Ландшафт;
//ПолеОтчета.ОтображатьСетку = Истина;
//ПолеОтчета.ОтображатьЗаголовки = Истина;

ТЗ_РодительУслуги = ТЗ_УслугиРодитель();

ОбластьЛево = Макет.ПолучитьОбласть("Шапка|КолонкиЛево");
ПолеОтчета.Вывести(ОбластьЛево, 0);

КоличествоКолонок = ОбластьЛево.ШиринаТаблицы;
Область = Макет.ПолучитьОбласть("Шапка|КолонкаУслуги");
Для Каждого Строка Из ТЗ_РодительУслуги Цикл
	Если ЗначениеЗаполнено(Строка.Папка) Тогда		
		Если ЗначениеЗаполнено(Строка.ЗаголовокОтчеты) Тогда
			ЗаголовокОтчета = Строка.ЗаголовокОтчеты;
		Иначе
			ЗаголовокОтчета = Строка.Папка;
		КонецЕсли;
		
		Область.Параметры.ШапкаДопУслуги = ЗаголовокОтчета;
	Иначе
		Область.Параметры.ШапкаДопУслуги = "Без папки";
	КонецЕсли;
	
	ПолеОтчета.Присоединить(Область, 0);
	
	КоличествоКолонок = КоличествоКолонок + 1;
КонецЦикла;

//Область = Макет.ПолучитьОбласть("Шапка|КолонкиПраво");
//ПолеОтчета.Присоединить(Область);

ОбластьШапка = ПолеОтчета.Область("R1"); 
ПолеОтчета.ПовторятьПриПечатиСтроки = ОбластьШапка;

ПолеОтчета.ФиксацияСверху = 1;
ПолеОтчета.НачатьАвтогруппировкуСтрок();

//
Итоги = Новый Структура();
Итоги.Вставить("КоличествоНочей", 0);
Итоги.Вставить("КоличествоСутокТариф", 0);
Итоги.Вставить("СуммаЦенаПроживание", 0);
Итоги.Вставить("СуммаПроживание", 0);
Итоги.Вставить("СуммаНомера", 0);

Итоги.Вставить("СуммаОплаты", 0);
Итоги.Вставить("СуммаОплаты_кк", 0);
Итоги.Вставить("СуммаОплаты_нал", 0);
Итоги.Вставить("СуммаЭквайринга", 0);

Итоги.Вставить("СуммаКомиссииИнформационно", 0);
Итоги.Вставить("СуммаКомиссииКВыплате", 0);
Итоги.Вставить("СуммаКомиссииОплата", 0);

Итоги.Вставить("КоличествоСтатус", 0);
Итоги.Вставить("КоличествоЗавтраки", 0);

Итоги.Вставить("КоличествоЧеловек", 0);

ДопУслугиИтоги = Новый ТаблицаЗначений;
ДопУслугиИтоги.Колонки.Добавить("УслугаРодитель");
ДопУслугиИтоги.Колонки.Добавить("СуммаУслуги");
Для Каждого Строка Из ТЗ_РодительУслуги Цикл
	НоваяСтрока = ДопУслугиИтоги.Добавить();
	НоваяСтрока.УслугаРодитель = Строка.Папка;	
	НоваяСтрока.СуммаУслуги = 0;	
КонецЦикла;
Итоги.Вставить("УслугиИтоги", ДопУслугиИтоги);
//

//
ИтогиДень = Новый Структура();
ИтогиДень.Вставить("КоличествоНочей", 0);
ИтогиДень.Вставить("КоличествоСутокТариф", 0);
ИтогиДень.Вставить("СуммаЦенаПроживание", 0);
ИтогиДень.Вставить("СуммаПроживание", 0);
ИтогиДень.Вставить("СуммаНомера", 0);

ИтогиДень.Вставить("СуммаОплаты", 0);
ИтогиДень.Вставить("СуммаОплаты_кк", 0);
ИтогиДень.Вставить("СуммаОплаты_нал", 0);
ИтогиДень.Вставить("СуммаЭквайринга", 0);

ИтогиДень.Вставить("СуммаКомиссииИнформационно", 0);
ИтогиДень.Вставить("СуммаКомиссииКВыплате", 0);
ИтогиДень.Вставить("СуммаКомиссииОплата", 0);

ИтогиДень.Вставить("КоличествоСтатус", 0);
ИтогиДень.Вставить("КоличествоЗавтраки", 0);

ИтогиДень.Вставить("КоличествоЧеловек", 0);

УслугиДеньИтоги = Новый ТаблицаЗначений;
УслугиДеньИтоги.Колонки.Добавить("УслугаРодитель");
УслугиДеньИтоги.Колонки.Добавить("СуммаУслуги");

Для Каждого Строка Из ТЗ_РодительУслуги Цикл
	НоваяСтрока = УслугиДеньИтоги.Добавить();
	НоваяСтрока.УслугаРодитель = Строка.Папка;	
	НоваяСтрока.СуммаУслуги = 0;	
КонецЦикла;
ИтогиДень.Вставить("УслугиДеньИтоги", УслугиДеньИтоги);
//

Запрос =	Новый Запрос ("ВЫБРАТЬ
        	              |	НомернойФонд.Ссылка КАК НомерВРезерв,
        	              |	ЗаявкаДанные.Ссылка КАК Заявка,
        	              |	ЗаявкаДанные.Дата КАК Дата,
        	              |	ЗаявкаДанные.Бронирует КАК Бронирует,
        	              |	ЗаявкаДанные.Оплачивает КАК Оплачивает,
        	              |	ЗаявкаДанные.Статус КАК Статус,
        	              |	ЗаявкаДанные.КолВоЧеловек КАК КолВоЧеловек,
        	              |	ЗаявкаДанные.КоличествоСчетов КАК КоличествоСчетов,
        	              |	ЗаявкаДанные.Номер КАК ЗаявкаНомер,
        	              |	ЗаявкаДанные.Дата КАК ЗаявкаДата,
        	              |	ЗаявкаДанные.БезЗавтрака КАК БезЗавтрака,
        	              |	ЗаявкаДанные.БонШанс КАК БонШанс,
        	              |	ЗаявкаДанные.Ссылка.РезервС КАК РезервС,
        	              |	ЗаявкаДанные.ДеньПроживанияМинимум КАК ДеньПроживанияМинимум,
        	              |	ЗаявкаДанные.ДеньПроживанияМаксимум КАК ДеньПроживанияМаксимум,
        	              |	ЗаявкаДанные.ДатаУслугиМинимум КАК ДатаУслугиМинимум,
        	              |	ЗаявкаДанные.ДатаУслугиМаксимум КАК ДатаУслугиМаксимум
        	              |ИЗ
        	              |	Справочник.НомернойФонд КАК НомернойФонд
        	              |		ВНУТРЕННЕЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
        	              |			ЗаявкаНаБронирование.Ссылка КАК Ссылка,
        	              |			ЗаявкаНаБронирование.НомерВРезерв КАК НомерВРезерв,
        	              |			ЗаявкаНаБронирование.Бронирует КАК Бронирует,
        	              |			ЗаявкаНаБронирование.Оплачивает КАК Оплачивает,
        	              |			ЗаявкаНаБронирование.Статус КАК Статус,
        	              |			ЗаявкаНаБронирование.КолВоЧеловек КАК КолВоЧеловек,
        	              |			СчетаКоличество.КоличествоСчетов КАК КоличествоСчетов,
        	              |			ЗаявкаНаБронирование.Номер КАК Номер,
        	              |			ЗаявкаНаБронирование.Дата КАК Дата,
        	              |			ЗаявкаНаБронирование.БезЗавтрака КАК БезЗавтрака,
        	              |			ЗаявкаНаБронирование.БонШанс КАК БонШанс,
        	              |			ЕСТЬNULL(Проживания.ДеньПроживанияМинимум, ДАТАВРЕМЯ(1, 1, 1)) КАК ДеньПроживанияМинимум,
        	              |			ЕСТЬNULL(Проживания.ДеньПроживанияМаксимум, ДАТАВРЕМЯ(1, 1, 1)) КАК ДеньПроживанияМаксимум,
        	              |			ЕСТЬNULL(ТЧДопУслуги.ДатаУслугиМинимум, ДАТАВРЕМЯ(1, 1, 1)) КАК ДатаУслугиМинимум,
        	              |			ЕСТЬNULL(ТЧДопУслуги.ДатаУслугиМаксимум, ДАТАВРЕМЯ(1, 1, 1)) КАК ДатаУслугиМаксимум
        	              |		ИЗ
        	              |			Документ.ЗаявкаНаБронирование КАК ЗаявкаНаБронирование
        	              |				ЛЕВОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
        	              |					ЗаявкаНаБронированиеСчета.Ссылка КАК Ссылка,
        	              |					КОЛИЧЕСТВО(РАЗЛИЧНЫЕ ЗаявкаНаБронированиеСчета.СчетГУИД) КАК КоличествоСчетов
        	              |				ИЗ
        	              |					Документ.ЗаявкаНаБронирование.Счета КАК ЗаявкаНаБронированиеСчета
        	              |				
        	              |				СГРУППИРОВАТЬ ПО
        	              |					ЗаявкаНаБронированиеСчета.Ссылка) КАК СчетаКоличество
        	              |				ПО ЗаявкаНаБронирование.Ссылка = СчетаКоличество.Ссылка
        	              |				ЛЕВОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
        	              |					ЗаявкаНаБронированиеПроживание.Ссылка КАК Ссылка,
        	              |					МИНИМУМ(ЗаявкаНаБронированиеПроживание.ДеньПроживания) КАК ДеньПроживанияМинимум,
        	              |					МАКСИМУМ(ЗаявкаНаБронированиеПроживание.ДеньПроживания) КАК ДеньПроживанияМаксимум
        	              |				ИЗ
        	              |					Документ.ЗаявкаНаБронирование.Проживание КАК ЗаявкаНаБронированиеПроживание
        	              |				
        	              |				СГРУППИРОВАТЬ ПО
        	              |					ЗаявкаНаБронированиеПроживание.Ссылка) КАК Проживания
        	              |				ПО ЗаявкаНаБронирование.Ссылка = Проживания.Ссылка
        	              |				ЛЕВОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
        	              |					ЗаявкаНаБронированиеДопУслуги.Ссылка КАК Ссылка,
        	              |					МИНИМУМ(ЗаявкаНаБронированиеДопУслуги.ДатаУслуги) КАК ДатаУслугиМинимум,
        	              |					МАКСИМУМ(ЗаявкаНаБронированиеДопУслуги.ДатаУслуги) КАК ДатаУслугиМаксимум
        	              |				ИЗ
        	              |					Документ.ЗаявкаНаБронирование.ДопУслуги КАК ЗаявкаНаБронированиеДопУслуги
        	              |				ГДЕ
        	              |					ЗаявкаНаБронированиеДопУслуги.ВСчет = ИСТИНА
        	              |				
        	              |				СГРУППИРОВАТЬ ПО
        	              |					ЗаявкаНаБронированиеДопУслуги.Ссылка) КАК ТЧДопУслуги
        	              |				ПО ЗаявкаНаБронирование.Ссылка = ТЧДопУслуги.Ссылка
        	              |		ГДЕ
        	              |			ЗаявкаНаБронирование.ПометкаУдаления = ЛОЖЬ
        	              |			И ВЫБОР
        	              |					КОГДА &ТипДатаС = ""ВсеЗаПериод""
        	              |							ИЛИ &ТипДатаПо = ""ВсеЗаПериод""
        	              |						ТОГДА ЕСТЬNULL(Проживания.ДеньПроживанияМаксимум, ДАТАВРЕМЯ(1, 1, 1)) >= &ДатаОтчетаС
        	              |									И ЕСТЬNULL(Проживания.ДеньПроживанияМинимум, ДАТАВРЕМЯ(1, 1, 1)) <= &ДатаОтчетаПо
        	              |								ИЛИ ЕСТЬNULL(ТЧДопУслуги.ДатаУслугиМаксимум, ДАТАВРЕМЯ(1, 1, 1)) >= &ДатаОтчетаС
        	              |									И ЕСТЬNULL(ТЧДопУслуги.ДатаУслугиМинимум, ДАТАВРЕМЯ(1, 1, 1)) <= &ДатаОтчетаПо
        	              |					ИНАЧЕ ВЫБОР
        	              |								КОГДА &ТипДатаС = ""ДатаВыезда""
        	              |									ТОГДА ЕСТЬNULL(Проживания.ДеньПроживанияМаксимум, ДАТАВРЕМЯ(1, 1, 1)) >= &ДатаОтчетаС
        	              |											ИЛИ ЕСТЬNULL(ТЧДопУслуги.ДатаУслугиМаксимум, ДАТАВРЕМЯ(1, 1, 1)) >= &ДатаОтчетаС
