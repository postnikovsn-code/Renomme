	ОбластьПараметры.Стоимость = Строка.Стоимость; 
	ОбластьПараметры.СуммаОплачено = Строка.СуммаОплачено; 
	
	ТабДок.Вывести(СтрокаТаблицы);
КонецЦикла;	
	
