Функция ПолучитьДанныеУзлаОбмена(КодУзлаОбмена) Экспорт 
Запрос = Новый Запрос("ВЫБРАТЬ
                      |	ГостиницыНастройкиОбмена.КодУзлаОбмена КАК КодУзлаОбмена,
                      |	ГостиницыНастройкиОбмена.АдресФТП КАК АдресФТП,
                      |	ГостиницыНастройкиОбмена.ИмяПользователя КАК ИмяПользователя,
                      |	ГостиницыНастройкиОбмена.Пароль КАК Пароль,
                      |	ГостиницыНастройкиОбмена.КаталогОбменаFTP КАК КаталогОбменаFTP
                      |ИЗ
                      |	РегистрСведений.ГостиницыНастройкиОбмена КАК ГостиницыНастройкиОбмена
                      |ГДЕ
                      |	ГостиницыНастройкиОбмена.КодУзлаОбмена = &КодУзлаОбмена");

Запрос.УстановитьПараметр("КодУзлаОбмена", КодУзлаОбмена);

ТЗ = Запрос.Выполнить().Выгрузить();
Если ТЗ.Количество() = 0 Тогда
	Возврат Неопределено;
Иначе
	Возврат ТЗ[0];
КонецЕсли;
КонецФункции

Функция ПолучитьИмяФайлаОбменаФТП(УзелИсточник, УзелПриемник, КаталогОбменаFTP) Экспорт
// Сформировать полное имя файла обмена.
ИмяФайла = КаталогОбменаFTP + "Message_" + СокрЛП(УзелИсточник.Код) 
	+ "_" + СокрЛП(УзелПриемник.Код) + ".xml";

Возврат ИмяФайла;
КонецФункции

Функция ПолучитьИмяФайлаОбмена_Пример(УзелИсточник, УзелПриемник) Экспорт
// Сформировать полное имя файла обмена.
Каталог = Константы.КаталогОбмена_ДляТеста.Получить();
ИмяФайла = Каталог + ?(Прав(Каталог, 1) = "\","", "\") + "Message_" +
	СокрЛП(УзелИсточник.Код) + "_" + СокрЛП(УзелПриемник.Код) + ".xml";

Возврат ИмяФайла;
КонецФункции
