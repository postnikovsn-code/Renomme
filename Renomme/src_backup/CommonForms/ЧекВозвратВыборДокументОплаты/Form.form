	ДокументКассовыйДокумент.НомерЧекаККМ КАК НомерЧекаККМ,
	ДокументКассовыйДокумент.ВозвратДокумент КАК ВозвратДокумент,
	ДокументКассовыйДокумент.Сумма КАК СуммаДокументаОплаты,
	ДокументКассовыйДокумент.СуммаКарта КАК СуммаКарта,
	ДокументКассовыйДокумент.СуммаНаличные КАК СуммаНаличные,
	Возвраты.Сумма КАК СуммаВозврат,
	Возвраты.СуммаКарта КАК СуммаВозвратКарта,
	Возвраты.СуммаНаличные КАК СуммаВозвратНаличные,
	ДокументКассовыйДокумент.Сумма - ЕСТЬNULL(Возвраты.Сумма, 0) КАК ОстатокДокументаОплаты,
	ДокументКассовыйДокумент.СуммаКарта - ЕСТЬNULL(Возвраты.СуммаКарта, 0) КАК ОстатокКарта,
	ДокументКассовыйДокумент.СуммаНаличные - ЕСТЬNULL(Возвраты.СуммаНаличные, 0) КАК ОстатокНаличные,
	ЕСТЬNULL(Оплаты.Сумма, 0) КАК СуммаОплачено,
	ДокументКассовыйДокумент.Аванс КАК Аванс,
	ДокументКассовыйДокумент.Отмена КАК Отмена
ИЗ
	Документ.КассовыйДокумент КАК ДокументКассовыйДокумент
		ЛЕВОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
			КассовыйДокумент.ВозвратДокумент КАК ВозвратДокумент,
			СУММА(КассовыйДокумент.Сумма) КАК Сумма,
			СУММА(КассовыйДокумент.СуммаКарта) КАК СуммаКарта,
			СУММА(КассовыйДокумент.СуммаНаличные) КАК СуммаНаличные
		ИЗ
			Документ.КассовыйДокумент КАК КассовыйДокумент
		
		СГРУППИРОВАТЬ ПО
			КассовыйДокумент.ВозвратДокумент) КАК Возвраты
		ПО ДокументКассовыйДокумент.Ссылка = Возвраты.ВозвратДокумент
		ЛЕВОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
			КассовыйДокументДолгиОплата.Ссылка КАК Ссылка,
			СУММА(КассовыйДокументДолгиОплата.Сумма) КАК Сумма,
			КассовыйДокументДолгиОплата.ДокументДолг КАК ДокументДолг
		ИЗ
			Документ.КассовыйДокумент.ДолгиОплата КАК КассовыйДокументДолгиОплата
		
		СГРУППИРОВАТЬ ПО
			КассовыйДокументДолгиОплата.Ссылка,
			КассовыйДокументДолгиОплата.ДокументДолг) КАК Оплаты
		ПО ДокументКассовыйДокумент.Ссылка = Оплаты.Ссылка
ГДЕ
	ДокументКассовыйДокумент.ПометкаУдаления = ЛОЖЬ
	И ДокументКассовыйДокумент.Приход = ИСТИНА
	И ДокументКассовыйДокумент.Сумма - ЕСТЬNULL(Возвраты.Сумма, 0) > 0
	И ДокументКассовыйДокумент.ОтКого В(&amp;КонтрагентыОтбор)
	И ВЫБОР
			КОГДА &amp;ДокументДолг = ЗНАЧЕНИЕ(Документ.ЗаявкаНаБронирование.ПустаяСсылка)
				ТОГДА ИСТИНА
			ИНАЧЕ Оплаты.ДокументДолг = &amp;ДокументДолг
		КОНЕЦ
	И ВЫБОР
			КОГДА &amp;ДокументОплаты = ЗНАЧЕНИЕ(Документ.КассовыйДокумент.ПустаяСсылка)
					ИЛИ &amp;ДокументОплаты = НЕОПРЕДЕЛЕНО
				ТОГДА ИСТИНА
			ИНАЧЕ ДокументКассовыйДокумент.Ссылка = &amp;ДокументОплаты
		КОНЕЦ</queryText>
      <mainTable>Document.КассовыйДокумент</mainTable>
      <autoFillAvailableFields>true</autoFillAvailableFields>
      <customQuery>true</customQuery>
      <autoSaveUserSettings>true</autoSaveUserSettings>
      <getInvisibleFieldPresentations>true</getInvisibleFieldPresentations>
    </extInfo>
