
////
&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
Элементы.Тест.Видимость = НастройкиСервер.ТекущийПользовательКодРавноАдминистратор();	
	
РаботаСИнтерфейсомСервер_УстановитьТолькоПросмотр = РаботаСИнтерфейсомСервер.УстановитьТолькоПросмотр(ЭтаФорма);
Если РаботаСИнтерфейсомСервер_УстановитьТолькоПросмотр Тогда 
	Элементы.Закрыто.ТолькоПросмотр = Истина;
КонецЕсли;

Если НЕ НастройкиСервер.ЭтоАдминистратор() Тогда
	Элементы.Закрыто.ТолькоПросмотр = Истина;
КонецЕсли;

Если РаботаСИнтерфейсомСервер_УстановитьТолькоПросмотр 
ИЛИ Объект.Закрыто
Тогда ЭтаФорма.ТолькоПросмотр = Истина; КонецЕсли;

ЮрЛицо = КлиентыСервер.ЭтоЮрЛицо(Объект.Контрагент);

ЭтаФормаНастройка();
КонецПроцедуры
 
&НаСервере
Процедура ЭтаФормаНастройка()
//Элементы.ФормаНаличные.Доступность = НЕ ЮрЛицо;	
//Элементы.ФормаБезнал.Доступность = ЮрЛицо;

ТипГрупповогоСчета = Объект.ТипГрупповогоСчета;

Если ТипГрупповогоСчета = Перечисления.ТипыГрупповогоСчета.ГруппаЗаявок Тогда 
	Элементы.ИтогоКОплате.Видимость = Истина;
	
	Элементы.ГруппаКомиссияДанные.Видимость = Ложь;
	
	Элементы.ГруппаНамДолжны.Видимость = Истина;
	Элементы.ИтогоДолгКЗачету.Видимость = Ложь;
	
	Элементы.ГруппаМыДолжны.Видимость = Ложь;
	Элементы.ИтогоКомиссияКЗачету.Видимость = Ложь;
	          
	Элементы.СтраницаДокументыДолги.Видимость = Истина;
	Элементы.СтраницаКомииссия.Видимость = Ложь;
	
	Элементы.СтраницаДокументыОплаты.Видимость = Истина;
	Элементы.ДокументыОплаты.КоманднаяПанель.ПодчиненныеЭлементы.ДокументыОплатыДобавитьОплатуЗачет.Видимость = Ложь;
	Элементы.ДокументыОплаты.КоманднаяПанель.ПодчиненныеЭлементы.ДокументыОплатыДобавитьСписаниеДолги.Видимость = Истина;

	Элементы.СтраницаРаспределениеОплат.Видимость = Истина;
	
	Элементы.СтраницаПлатежиКонтрагенту.Видимость = Ложь;
			
ИначеЕсли ТипГрупповогоСчета = Перечисления.ТипыГрупповогоСчета.ТурагентствоВзаимозачет Тогда 
	Элементы.ИтогоКОплате.Видимость = Истина;
	
	Элементы.ГруппаКомиссияДанные.Видимость = Истина;
	
	Элементы.СуммаОстатокВзаимозачета.Видимость = Истина;
	 
	Элементы.ГруппаНамДолжны.Видимость = Истина;
	Элементы.ИтогоДолгКЗачету.Видимость = Истина;
	
	Элементы.ГруппаМыДолжны.Видимость = Истина;
	Элементы.ИтогоКомиссияКЗачету.Видимость = Истина;

	Элементы.СтраницаДокументыДолги.Видимость = Истина;
	Элементы.СтраницаКомииссия.Видимость = Истина;
	
	Элементы.СтраницаДокументыОплаты.Видимость = Истина;
	Элементы.ДокументыОплаты.КоманднаяПанель.ПодчиненныеЭлементы.ДокументыОплатыДобавитьОплатуЗачет.Видимость = Истина;
	Элементы.ДокументыОплаты.КоманднаяПанель.ПодчиненныеЭлементы.ДокументыОплатыДобавитьСписаниеДолги.Видимость = Истина;

	Элементы.СтраницаРаспределениеОплат.Видимость = Истина;
	
	Элементы.СтраницаПлатежиКонтрагенту.Видимость = Истина;
	
ИначеЕсли ТипГрупповогоСчета = Перечисления.ТипыГрупповогоСчета.ТурагентствоДолги Тогда 
	Элементы.ИтогоКОплате.Видимость = Ложь;
	
	Элементы.ГруппаКомиссияДанные.Видимость = Истина;
	Элементы.СуммаОстатокВзаимозачета.Видимость = Истина;
	 
	Элементы.ГруппаНамДолжны.Видимость = Истина;
	Элементы.ИтогоДолгКЗачету.Видимость = Ложь;
	
	Элементы.ГруппаМыДолжны.Видимость = Истина;
	Элементы.ИтогоКомиссияКЗачету.Видимость = Ложь;
	          
	Элементы.СтраницаДокументыДолги.Видимость = Истина;
	Элементы.СтраницаКомииссия.Видимость = Истина;
	
	Элементы.СтраницаДокументыОплаты.Видимость = Истина;
	Элементы.ДокументыОплаты.КоманднаяПанель.ПодчиненныеЭлементы.ДокументыОплатыДобавитьОплатуЗачет.Видимость = Ложь;
	Элементы.ДокументыОплаты.КоманднаяПанель.ПодчиненныеЭлементы.ДокументыОплатыДобавитьСписаниеДолги.Видимость = Истина;
	
	Элементы.СтраницаПлатежиКонтрагенту.Видимость = Истина;
	
	Элементы.СтраницаРаспределениеОплат.Видимость = Истина;
Иначе
	Элементы.ИтогоКОплате.Видимость = Ложь;
	
	Элементы.ГруппаКомиссияДанные.Видимость = Ложь;
	 
	Элементы.ГруппаНамДолжны.Видимость = Ложь;
	
	Элементы.ГруппаМыДолжны.Видимость = Ложь;
	          
	Элементы.СтраницаДокументыДолги.Видимость = Ложь;
	Элементы.СтраницаКомииссия.Видимость = Ложь;
	
	Элементы.СтраницаДокументыОплаты.Видимость = Ложь;
	
	Элементы.СтраницаПлатежиКонтрагенту.Видимость = Ложь;
	
	Элементы.СтраницаРаспределениеОплат.Видимость = Ложь;
КонецЕсли;
	
Конецпроцедуры	

&НаСервере
Процедура ФормаРеквизитыТолькоПросмотр()
ТолькоПросмотр_П = НЕ ((Объект.ДокументыДолги.Количество() = 0) 
					И (Объект.КомиссияДокументыДолги.Количество() = 0)) ;
	
Элементы.ТипГрупповогоСчета.ТолькоПросмотр = ТолькоПросмотр_П;
Элементы.Контрагент.ТолькоПросмотр = ТолькоПросмотр_П;	
	
ЕстьПрочиеОплаты = ЕстьПрочиеОплатыВзаимозачет(); 
Элементы.СуммаКомиссииКонтрагента.ТолькоПросмотр = ЕстьПрочиеОплаты; 
Элементы.СуммаОстатокВзаимозачета.ТолькоПросмотр = ЕстьПрочиеОплаты; 
КонецПроцедуры	

&НаСервере
Функция ЕстьПрочиеОплатыВзаимозачет()
ЕстьПрочиеОплаты = Ложь;
Для Каждого Строка Из Объект.ДокументыОплаты Цикл
	Если ТипЗнч(Строка.ДокументОплаты) = Тип("ДокументСсылка.ПрочиеОплаты") Тогда 
		Если Строка.ДокументОплаты.ВидОперации = Справочники.ВидыОпераций.Взаимозачет Тогда 
			ЕстьПрочиеОплаты = Истина;
			Прервать;
		КонецЕсли;
	КонецЕсли;
КонецЦикла;

Возврат ЕстьПрочиеОплаты;                
КонецФункции
////

&НаКлиенте
Процедура ЗакрытоПриИзменении(Элемент)
Если Закрыто Тогда 
	ДанныеОбъект = Объект;		
	ГрупповойСчетКЗакрытию = ЗакрытиеСервер.ГрупповойСчетКЗакрытию(ДанныеОбъект);
	
	Если НЕ ГрупповойСчетКЗакрытию.ГрупповойСчетКЗакрытию Тогда
		Оповещение = Новый ОписаниеОповещения("ЗавершениеВопроса_ПодтвердитеГрупповогоСчета", ЭтаФорма);
		ТекстВопроса = "ВНИМАНИЕ ! ";
		Если ГрупповойСчетКЗакрытию.ДолгКОплате Тогда
			ТекстВопроса = ТекстВопроса + "Долг к оплате <> 0.";
		КонецЕсли;
		
		Если ГрупповойСчетКЗакрытию.КомиссияПлатежиКОплате Тогда
			Если СтрНайти(ТекстВопроса, "Долг") <> 0 Тогда
				ТекстВопроса = ТекстВопроса + Символы.ПС;
			КонецЕсли;
			ТекстВопроса = ТекстВопроса + "Комиссия платежи к оплате к оплате <> 0.";
		КонецЕсли;
		
		ТекстВопроса = ТекстВопроса + Символы.ПС + Символы.ПС
			+ "ПОДТВЕРДИТЕ ЗАКРЫТИЕ ЗАЯВКИ ...";
		
		ПоказатьВопрос(Оповещение, ТекстВопроса, РежимДиалогаВопрос.ОКОтмена);
		
		Возврат;
	КонецЕсли;
КонецЕсли;

ОткрытьЗакрытьГрупповойСчет();
КонецПроцедуры

&НаКлиенте
Процедура ЗавершениеВопроса_ПодтвердитеГрупповогоСчета(Результат, ДополнительныеПараметры) Экспорт
Если Результат = КодВозвратаДиалога.Отмена Тогда 
	Закрыто = Не Закрыто;
	
	Возврат; 
КонецЕсли;
	
ОткрытьЗакрытьГрупповойСчет();	
КонецПроцедуры

&НаКлиенте
Процедура ОткрытьЗакрытьГрупповойСчет() 
Объект.Закрыто = Закрыто;

Если Объект.Закрыто Тогда
	Объект.ДатаЗакрытия = ТекущаяДата();	
Иначе	
	Объект.ДатаЗакрытия = Неопределено;	
КонецЕсли;

ЭтаФорма.Записать(Новый Структура(РежимЗаписиДокумента.Проведение));
ЭтаФорма.ТолькоПросмотр = Закрыто;
КонецПроцедуры


//
&НаСервере
Процедура ПриЧтенииНаСервере(ТекущийОбъект)
ОбновитьДанные();

ЗагрузкаДеревоСчетДетально();

ФормаРеквизитыТолькоПросмотр();

ВывестиОшибки(ТекущийОбъект);
КонецПроцедуры

&НаСервере
Процедура ВывестиОшибки(ТекущийОбъект)
Ответ = ДокументыСервер.ПроверитьГрупповойСчет(ТекущийОбъект);

ТекстОшибки = Ответ.ТекстОшибки;
ТекстОшибки = ОбщийФункционалКлиентСервер.ДобавитьТекст(ТекстОшибки, Ответ.ТекстПредупреждения, Символы.ПС); 

Если ТекстОшибки = "" Тогда
	Элементы.ТекстОшибки.Видимость = Ложь;
Иначе
	Элементы.ТекстОшибки.Видимость = Истина;
	ЧислоСтрок = СтрЧислоСтрок(ТекстОшибки);
	Элементы.ТекстОшибки.МаксимальнаяВысота = ЧислоСтрок + 1 ;
КонецЕсли;
КонецПроцедуры


&НаСервере
Процедура ПослеЗаписиНаСервере(ТекущийОбъект, ПараметрыЗаписи)
ОбновитьДанные();

ЗагрузкаДеревоСчетДетально();

ФормаРеквизитыТолькоПросмотр();

ВывестиОшибки(ТекущийОбъект);
КонецПроцедуры

&НаСервере
Процедура ОбновитьДанные()
ОбновитьДанныеКолонокДокументыДолги();
ОбновитьДанныеКолонокДокументыОплаты();
ОбновитьДанныеКолонокКомиссияДокументыДолги();
ОбновитьДанныеКолонокПлатежиКонтрагенту();

ОбновитьДанныеКолонокРаспределениеОплат();

ОбновитьДанныеШапки();

ОбновитьЗакрыто();
КонецПроцедуры

&НаСервере
Процедура ОбновитьЗакрыто()
Закрыто = Объект.Закрыто; 	
КонецПроцедуры

&НаСервере
Процедура ОбновитьДанныеКолонокДокументыДолги()
ИтогоДокументыДолгиСуммаДолг = 0;
ИтогоДокументыДолгиСуммаОплачено = 0;

Если Объект.ДокументыДолги.Количество() = 0 Тогда Возврат; КонецЕсли; 

Запрос = Новый Запрос("ВЫБРАТЬ
                      |	ЗаявкаНаБронированиеСчета.Ссылка КАК Ссылка,
                      |	ЗаявкаНаБронированиеСчета.СчетГУИД КАК СчетГУИД,
                      |	ЗаявкаНаБронированиеСчета.Контрагент КАК Контрагент,
                      |	ЗаявкаНаБронированиеСчета.Клиент КАК Клиент,
                      |	ЗаявкаНаБронированиеСчета.НомерСчета КАК НомерСчета,
                      |	ЗаявкаНаБронированиеСчета.ДатаСчета КАК ДатаСчета,
                      |	ЗаявкаНаБронированиеСчета.ТолькоПроживание КАК ТолькоПроживание,
                      |	ЗаявкаНаБронированиеСчета.ТолькоУслуги КАК ТолькоУслуги,
                      |	СУММА(ЕСТЬNULL(Долги.СуммаДолг, 0)) КАК СуммаДолг,
                      |	СУММА(ЕСТЬNULL(Оплаты.СуммаОплаты, 0)) КАК СуммаОплачено,
                      |	ЗаявкаНаБронированиеСчета.ДатаС КАК ДатаС,
                      |	ЗаявкаНаБронированиеСчета.ДатаПо КАК ДатаПо
                      |ИЗ
                      |	Документ.ЗаявкаНаБронирование.Счета КАК ЗаявкаНаБронированиеСчета
                      |		ЛЕВОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
                      |			ЗаявкаНаБронированиеСчетаДетальноДолги.Ссылка КАК Ссылка,
                      |			ЗаявкаНаБронированиеСчетаДетальноДолги.СчетГУИД КАК СчетГУИД,
                      |			СУММА(ЗаявкаНаБронированиеСчетаДетальноДолги.СуммаДолг) КАК СуммаДолг
                      |		ИЗ
                      |			Документ.ЗаявкаНаБронирование.СчетаДетальноДолги КАК ЗаявкаНаБронированиеСчетаДетальноДолги
                      |		
                      |		СГРУППИРОВАТЬ ПО
                      |			ЗаявкаНаБронированиеСчетаДетальноДолги.Ссылка,
                      |			ЗаявкаНаБронированиеСчетаДетальноДолги.СчетГУИД) КАК Долги
                      |		ПО ЗаявкаНаБронированиеСчета.Ссылка = Долги.Ссылка
                      |			И ЗаявкаНаБронированиеСчета.СчетГУИД = Долги.СчетГУИД
                      |		ЛЕВОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
                      |			ЗаявкаНаБронированиеРаспределениеОплатДолги.Ссылка КАК Ссылка,
                      |			ЗаявкаНаБронированиеРаспределениеОплатДолги.СчетГУИД КАК СчетГУИД,
                      |			СУММА(ЗаявкаНаБронированиеРаспределениеОплатДолги.СуммаОплаты) КАК СуммаОплаты
                      |		ИЗ
                      |			Документ.ЗаявкаНаБронирование.РаспределениеОплатДолги КАК ЗаявкаНаБронированиеРаспределениеОплатДолги
                      |		
                      |		СГРУППИРОВАТЬ ПО
                      |			ЗаявкаНаБронированиеРаспределениеОплатДолги.Ссылка,
                      |			ЗаявкаНаБронированиеРаспределениеОплатДолги.СчетГУИД) КАК Оплаты
                      |		ПО ЗаявкаНаБронированиеСчета.Ссылка = Оплаты.Ссылка
                      |			И ЗаявкаНаБронированиеСчета.СчетГУИД = Оплаты.СчетГУИД
                      |ГДЕ
                      |	ЗаявкаНаБронированиеСчета.СчетГУИД В(&СписокСчетГУИД)
                      |
                      |СГРУППИРОВАТЬ ПО
                      |	ЗаявкаНаБронированиеСчета.Ссылка,
                      |	ЗаявкаНаБронированиеСчета.СчетГУИД,
                      |	ЗаявкаНаБронированиеСчета.Контрагент,
                      |	ЗаявкаНаБронированиеСчета.Клиент,
                      |	ЗаявкаНаБронированиеСчета.НомерСчета,
                      |	ЗаявкаНаБронированиеСчета.ДатаСчета,
                      |	ЗаявкаНаБронированиеСчета.ТолькоПроживание,
                      |	ЗаявкаНаБронированиеСчета.ТолькоУслуги,
                      |	ЗаявкаНаБронированиеСчета.ДатаС,
                      |	ЗаявкаНаБронированиеСчета.ДатаПо"
);

Запрос.УстановитьПараметр("СписокСчетГУИД", Объект.ДокументыДолги.Выгрузить().ВыгрузитьКолонку("СчетГУИД"));
ТЗ = Запрос.Выполнить().Выгрузить();
Если ТЗ.Количество() = 0 Тогда Возврат; КонецЕсли; 

Для Каждого Строка Из Объект.ДокументыДолги Цикл
	НайденнаяСтрока = ТЗ.Найти(Строка.СчетГУИД, "СчетГУИД");
    Если НайденнаяСтрока <> Неопределено  Тогда
        Строка.Контрагент = НайденнаяСтрока.Контрагент;
        Строка.Клиент = НайденнаяСтрока.Клиент;
        Строка.НомерСчета = НайденнаяСтрока.НомерСчета;
        Строка.ДатаСчета = НайденнаяСтрока.ДатаСчета;
        Строка.СуммаДолг = НайденнаяСтрока.СуммаДолг;
        Строка.СуммаОплачено = НайденнаяСтрока.СуммаОплачено;
		
        Строка.СчетДата_С = НайденнаяСтрока.ДатаС;
        Строка.СчетДата_По = НайденнаяСтрока.ДатаПо;
		
		Строка.ТолькоПроживание = НайденнаяСтрока.ТолькоПроживание;
		Строка.ТолькоУслуги = НайденнаяСтрока.ТолькоУслуги;
    КонецЕсли;
	
	ИтогоДокументыДолгиСуммаДолг = ИтогоДокументыДолгиСуммаДолг + Строка.СуммаДолг;
	ИтогоДокументыДолгиСуммаОплачено = ИтогоДокументыДолгиСуммаОплачено + Строка.СуммаОплачено;
КонецЦикла;
КонецПроцедуры

&НаСервере
Процедура ОбновитьДанныеКолонокКомиссияДокументыДолги()
ИтогоКомиссияСуммаДолг = 0; ИтогоКомиссияСуммаПроживание = 0; ИтогоКомиссияСуммаОплачено = 0;
ИтогоКомиссияСуммаКомиссииРасчет = 0; ИтогоКомиссияСуммаКомиссииКонтрагент = 0; 

Если Объект.КомиссияДокументыДолги.Количество() = 0 Тогда Возврат; КонецЕсли; 

Запрос = Новый Запрос(
	"ВЫБРАТЬ
	|	ЗаявкаНаБронирование.Ссылка КАК Ссылка,
	|	ЕСТЬNULL(СуммаДолги.СуммаДолг, 0) КАК СуммаДолг,
	|	ЕСТЬNULL(СуммаДолги.СуммаОплачено, 0) КАК СуммаОплачено,
	|	ЕСТЬNULL(СуммаПроживание.Сумма, 0) КАК СуммаПроживание,
	|	ЕСТЬNULL(СуммаПроживание.СуммаБезСкидки, 0) КАК СуммаБезСкидки
	|ИЗ
	|	Документ.ЗаявкаНаБронирование КАК ЗаявкаНаБронирование
	|		ЛЕВОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
	|			ЗаявкаНаБронированиеСчетаДетальноДолги.Ссылка КАК Ссылка,
	|			СУММА(ЗаявкаНаБронированиеСчетаДетальноДолги.СуммаДолг) КАК СуммаДолг,
	|			СУММА(ЗаявкаНаБронированиеСчетаДетальноДолги.СуммаОплачено) КАК СуммаОплачено
	|		ИЗ
	|			Документ.ЗаявкаНаБронирование.СчетаДетальноДолги КАК ЗаявкаНаБронированиеСчетаДетальноДолги
	|		
	|		СГРУППИРОВАТЬ ПО
	|			ЗаявкаНаБронированиеСчетаДетальноДолги.Ссылка) КАК СуммаДолги
	|		ПО ЗаявкаНаБронирование.Ссылка = СуммаДолги.Ссылка
	|		ЛЕВОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
	|			ЗаявкаНаБронированиеПроживание.Ссылка КАК Ссылка,
	|			СУММА(ЗаявкаНаБронированиеПроживание.Сумма) КАК Сумма,
	|			СУММА(ЗаявкаНаБронированиеПроживание.СуммаБезСкидки) КАК СуммаБезСкидки
	|		ИЗ
	|			Документ.ЗаявкаНаБронирование.Проживание КАК ЗаявкаНаБронированиеПроживание
	|		
	|		СГРУППИРОВАТЬ ПО
	|			ЗаявкаНаБронированиеПроживание.Ссылка) КАК СуммаПроживание
	|		ПО ЗаявкаНаБронирование.Ссылка = СуммаПроживание.Ссылка
	|ГДЕ
	|	ЗаявкаНаБронирование.Ссылка В(&МассивДокументДолг)
	|
	|СГРУППИРОВАТЬ ПО
	|	ЗаявкаНаБронирование.Ссылка,
	|	СуммаДолги.СуммаДолг,
	|	СуммаДолги.СуммаОплачено,
	|	СуммаПроживание.Сумма,
	|	СуммаПроживание.СуммаБезСкидки");

Запрос.УстановитьПараметр("МассивДокументДолг", Объект.КомиссияДокументыДолги.Выгрузить().ВыгрузитьКолонку("ДокументДолг"));
ТЗ = Запрос.Выполнить().Выгрузить();
Если ТЗ.Количество() = 0 Тогда Возврат; КонецЕсли; 

Для Каждого Строка Из Объект.КомиссияДокументыДолги Цикл
	НайденнаяСтрока = ТЗ.Найти(Строка.ДокументДолг, "Ссылка");
    Если НайденнаяСтрока <> Неопределено  Тогда
        Строка.СуммаПроживание = НайденнаяСтрока.СуммаПроживание;
        Строка.СуммаДолг = НайденнаяСтрока.СуммаДолг;
        Строка.СуммаОплачено = НайденнаяСтрока.СуммаОплачено;
		
		ПроцентКомиссии = ДокументыСервер.ПроцентКомиссииКлиента(Строка.ДокументДолг.Бронирует, Строка.ДокументДолг.РезервС); //, Строка.ДокументДолг.В2В);
		Строка.ПроцентКомиссии = ПроцентКомиссии; 
		
		СуммаКомиссии = ДокументыСервер.СуммаКомиссии(Строка.ДокументДолг, НайденнаяСтрока.СуммаБезСкидки
			, Строка.ДокументДолг.Счета, Строка.ДокументДолг.СчетаДетальноДолги, Строка.ДокументДолг.ДопУслуги, ПроцентКомиссии);

		Строка.СуммаКомиссииРасчет = СуммаКомиссии; 
			
		ИтогоКомиссияСуммаДолг = ИтогоКомиссияСуммаДолг + Строка.СуммаДолг; 
		ИтогоКомиссияСуммаПроживание = ИтогоКомиссияСуммаПроживание + Строка.СуммаПроживание; 
		ИтогоКомиссияСуммаОплачено = ИтогоКомиссияСуммаОплачено + Строка.СуммаОплачено; 
		
		ИтогоКомиссияСуммаКомиссииРасчет = ИтогоКомиссияСуммаКомиссииРасчет + Строка.СуммаКомиссииРасчет; 
		
		Если Строка.СуммаКомиссииКонтрагент = 0 Тогда
			ИтогоКомиссияСуммаКомиссииКонтрагент = ИтогоКомиссияСуммаКомиссииКонтрагент + Строка.СуммаКомиссииРасчет;
		Иначе			
			ИтогоКомиссияСуммаКомиссииКонтрагент = ИтогоКомиссияСуммаКомиссииКонтрагент + Строка.СуммаКомиссииКонтрагент;
		КонецЕсли;
	КонецЕсли;
КонецЦикла;

КонецПроцедуры

&НаСервере
Процедура ОбновитьДанныеКолонокДокументыОплаты()
МассивДокументовДолг = Новый Массив;
Для Каждого Строка Из Объект.ДокументыДолги Цикл
	МассивДокументовДолг.Добавить(Строка.ДокументДолг);	
КонецЦикла;

СуммаРаспределеноИтогоОплаты = 0;

//ОплатыОбщееСервер.ОбновитьДанныеКолонокДокументыОплаты(СуммаРаспределеноИтогоОплаты
//	, Объект.ДокументыОплаты, Объект.Ссылка, МассивДокументовДолг);	
ОплатыОбщееСервер.ОбновитьДанныеКолонокДокументыОплаты(СуммаРаспределеноИтогоОплаты
	, Объект.ДокументыОплаты, Объект, МассивДокументовДолг);	
	
Для Каждого Строка Из Объект.ДокументыОплаты Цикл
	ДокументОплаты = Строка.ДокументОплаты;
	Строка.ДатаОплаты = ДокументОплаты.ДатаОплаты;
	
	Строка.ВидОперации= ДокументОплаты.ВидОперации;

	Если ТипЗнч(ДокументОплаты) = Тип("ДокументСсылка.КассовыйДокумент") Тогда
		Строка.Аванс = ДокументОплаты.Аванс;	
	КонецЕсли;	
КонецЦикла;	
КонецПроцедуры

&НаСервере
Процедура ОбновитьДанныеКолонокПлатежиКонтрагенту()
ИтогоКомиссияПлатежиОплачено = 0;	
Для Каждого Строка Из Объект.ДокументыПлатежиКонтрагенту Цикл
	ДокументПлатежа = Строка.ДокументПлатежа;
	Строка.СуммаПлатежаДокумент = ДокументПлатежа.Сумма;
	
	ИтогоКомиссияПлатежиОплачено = ИтогоКомиссияПлатежиОплачено + Строка.СуммаПлатежаДокумент;
	
	//Если ТипЗнч(ДокументОплаты) = Тип("ДокументСсылка.КассовыйДокумент") Тогда
	//	Строка.Аванс = ДокументОплаты.Аванс;	
	//КонецЕсли;	
КонецЦикла;	
КонецПроцедуры

&НаСервере
Процедура ОбновитьДанныеКолонокРаспределениеОплат()
ИтогоДокументыРаспределениеОплатСуммаОплачено = 0;

Если Объект.РаспределениеОплат.Количество() = 0 Тогда Возврат; КонецЕсли; 

Для Каждого Строка Из Объект.РаспределениеОплат Цикл
	Запрос = Новый Запрос("ВЫБРАТЬ
	                      |	ЗаявкаНаБронированиеСчета.НомерСчета КАК НомерСчета
	                      |ИЗ
	                      |	Документ.ЗаявкаНаБронирование.Счета КАК ЗаявкаНаБронированиеСчета
	                      |ГДЕ
	                      |	ЗаявкаНаБронированиеСчета.Ссылка = &Ссылка
	                      |	И ЗаявкаНаБронированиеСчета.СчетГУИД = &СчетГУИД");
	
	Запрос.УстановитьПараметр("Ссылка", Строка.ДокументДолг );
	Запрос.УстановитьПараметр("СчетГУИД", Строка.СчетГУИД );
	
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Строка.НомерСчета = Выборка.НомерСчета;
	КонецЕсли;
КонецЦикла;
КонецПроцедуры

&НаСервере
Процедура ОбновитьДанныеШапки()
СуммаЗачетаОплачено = 0;
Для Каждого Строка Из Объект.ДокументыОплаты Цикл
	Если ТипЗнч(Строка.ДокументОплаты) = Тип("ДокументСсылка.ПрочиеОплаты") Тогда
		Если Строка.ДокументОплаты.ВидОперации = Справочники.ВидыОпераций.Взаимозачет Тогда 
			СуммаЗачетаОплачено = СуммаЗачетаОплачено + Строка.СуммаРаспределено;
		КонецЕсли;
	КонецЕсли;
КонецЦикла;
	
ИтогоДолг = ИтогоДокументыДолгиСуммаДолг;
ИтогоКомиссия = Объект.СуммаКомиссииКонтрагента;

Если Объект.ТипГрупповогоСчета = ПредопределенноеЗначение("Перечисление.ТипыГрупповогоСчета.ТурагентствоВзаимозачет") Тогда
	НащДолгКонтрагенту = ИтогоКомиссия + Объект.СуммаОстатокВзаимозачета;
	
	Если НащДолгКонтрагенту <= ИтогоДолг Тогда  
		ИтогоДолгКОплате = ИтогоДолг - ИтогоДокументыДолгиСуммаОплачено;
		ИтогоДолгКЗачету = 0;
		
		ИтогоКомиссияКЗачету = НащДолгКонтрагенту - СуммаЗачетаОплачено;
		ИтогоКомиссияПлатежиКОплате = 0;

		ИтогоКОплате = ИтогоДолгКОплате;	
	Иначе
		ИтогоДолгКОплате = 0;
		ИтогоДолгКЗачету = ИтогоДолг - ИтогоДокументыДолгиСуммаОплачено;
		
		ИтогоКомиссияПлатежиКОплате = НащДолгКонтрагенту - ИтогоКомиссияПлатежиОплачено - ИтогоДолгКЗачету - СуммаЗачетаОплачено;
		ИтогоКомиссияКЗачету = ИтогоДолгКЗачету;	
		
		ИтогоКОплате = ИтогоКомиссияПлатежиКОплате;	
	КонецЕсли;
	
ИначеЕсли Объект.ТипГрупповогоСчета = ПредопределенноеЗначение("Перечисление.ТипыГрупповогоСчета.ТурагентствоДолги") Тогда
	
	НащДолгКонтрагенту = ИтогоКомиссия + Объект.СуммаОстатокВзаимозачета;
	
	ИтогоДолгКОплате = ИтогоДолг - ИтогоДокументыДолгиСуммаОплачено;
	ИтогоДолгКЗачету = 0;
	
	ИтогоКомиссияПлатежиКОплате = НащДолгКонтрагенту - СуммаЗачетаОплачено - ИтогоКомиссияПлатежиОплачено;
	ИтогоКомиссияКЗачету = 0;	
	
	//ИтогоКОплате = ИтогоДолгКОплате;	

ИначеЕсли Объект.ТипГрупповогоСчета = ПредопределенноеЗначение("Перечисление.ТипыГрупповогоСчета.ГруппаЗаявок") Тогда
	
	НащДолгКонтрагенту = ИтогоКомиссия + Объект.СуммаОстатокВзаимозачета;
	
	ИтогоДолгКОплате = ИтогоДолг - ИтогоДокументыДолгиСуммаОплачено;
	ИтогоДолгКЗачету = 0;
	
	ИтогоКомиссияПлатежиКОплате = НащДолгКонтрагенту - СуммаЗачетаОплачено - ИтогоКомиссияПлатежиОплачено;
	ИтогоКомиссияКЗачету = 0;	
	
	ИтогоКОплате = ИтогоДолгКОплате;
	
Иначе
	ИтогоДолгКОплате = 0;
	ИтогоДолгКЗачету = 0;
	
	ИтогоКомиссияПлатежиКОплате = 0;
	ИтогоКомиссияКЗачету = 0;	
	
	ИтогоКОплате = 0;
	
КонецЕсли;
КонецПроцедуры
//

&НаКлиенте
Процедура ПередЗаписью(Отказ, ПараметрыЗаписи)
ДанныеОбъект = Объект;	
ТекстПредупреждения = ТекстПредупрежденияПроверкаПередЗаписью(ДанныеОбъект, Символы.ПС);  	
Если ТекстПредупреждения <> "" Тогда
	ТекстПредупреждения = ТекстПредупреждения + Символы.ПС + Символы.ПС + "ЗАПИСЬ ДОКУМЕНТА ОТМЕНЯЕТСЯ !";

	ПоказатьПредупреждение(, ТекстПредупреждения);	
	
	Отказ = Истина;
	Возврат;
КонецЕсли;
КонецПроцедуры

&НаСервере
Функция ТекстПредупрежденияПроверкаПередЗаписью(ТекущийОбъект, Разделитель)
ТекстПредупреждения = "";
Если НЕ ЗначениеЗаполнено(ТекущийОбъект.Ссылка) Тогда 
	Если НЕ ЗначениеЗаполнено(ТекущийОбъект.ТипГрупповогоСчета) Тогда 
		ТекстПредупреждения = ОбщийФункционалКлиентСервер.ДобавитьТекст(ТекстПредупреждения
			,"Не задан реквизит 'Тип группового счета'.", Разделитель);
	КонецЕсли;		

	Если НЕ ЗначениеЗаполнено(ТекущийОбъект.Контрагент) Тогда 
		ТекстПредупреждения = ОбщийФункционалКлиентСервер.ДобавитьТекст(ТекстПредупреждения
			,"Не задан реквизит 'Контрагент'.", Разделитель);
	КонецЕсли;		
КонецЕсли;

Возврат ТекстПредупреждения;
КонецФункции

&НаСервере
Процедура ПередЗаписьюНаСервере(Отказ, ТекущийОбъект, ПараметрыЗаписи)
ТекстПредупреждения = ТекстПредупрежденияПроверкаПередЗаписью(ТекущийОбъект, " ");  	
Если ТекстПредупреждения <> "" Тогда 
	ТекстПредупреждения = ТекстПредупреждения + " ЗАПИСЬ ДОКУМЕНТА ОТМЕНЯЕТСЯ !";
	Сообщить(ТекстПредупреждения);	
	
	Отказ = Истина;
	Возврат;
КонецЕсли;
	
Если НЕ ЗначениеЗаполнено(Объект.Ссылка) Тогда
	ТекущийОбъект.СчетГУИД = Новый УникальныйИдентификатор();
	ТекущийОбъект.НомерСчета = ДокументыСервер.НовыйНомерГрупповогоСчета();
	ТекущийОбъект.ДатаСчета = ТекущаяДата();
КонецЕсли;

КонецПроцедуры


