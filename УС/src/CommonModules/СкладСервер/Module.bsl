////////////////////////////////////////////////////////////////////////////////
// Складской учет — серверная логика.
//
// Общий модуль содержит процедуры проведения документов, контроль
// остатков, запросы к регистру «ОстаткиТоваров» и алгоритм заполнения
// демонстрационных данных при первом запуске информационной базы.
////////////////////////////////////////////////////////////////////////////////

#Область ПрограммныйИнтерфейс

Функция Привет()
	
КонецФункции

// Оприходует товары на склад по данным приходной накладной:
// проверяет корректность строк и записывает движения «Приход»
// в регистр накопления «ОстаткиТоваров».
//
// Параметры:
//  Документ - ДокументОбъект.ПриходнаяНакладная - проводимый документ;
//  Отказ    - Булево - устанавливается в Истина при обнаружении ошибки.
//


Процедура ОприходоватьТовары(Документ, Отказ) Экспорт

	Если Документ.Товары.Количество() = 0 Тогда
		СообщитьОбОшибке("В документе не заполнена табличная часть «Товары».", Отказ);
		Возврат;
	КонецЕсли;

	Движения = Документ.Движения.ОстаткиТоваров;
	Движения.Записывать = Истина;

	Для Каждого СтрокаТЧ Из Документ.Товары Цикл

		Если Не ЗначениеЗаполнено(СтрокаТЧ.Номенклатура) Тогда
			СообщитьОбОшибке(
				СтрШаблон("Строка %1: не указана номенклатура.", СтрокаТЧ.НомерСтроки),
				Отказ);
			Возврат;
		КонецЕсли;

		Если СтрокаТЧ.Количество <= 0 Тогда
			СообщитьОбОшибке(
				СтрШаблон("Строка %1: количество должно быть больше нуля.", СтрокаТЧ.НомерСтроки),
				Отказ);
			Возврат;
		КонецЕсли;

		Движение = Движения.Добавить();
		Движение.ВидДвижения  = ВидДвиженияНакопления.Приход;
		Движение.Период       = Документ.Дата;
		Движение.Склад        = Документ.Склад;
		Движение.Номенклатура = СтрокаТЧ.Номенклатура;
		Движение.Количество   = СтрокаТЧ.Количество;
		Движение.Сумма        = СтрокаТЧ.Сумма;

	КонецЦикла;

	Движения.Записать();

КонецПроцедуры

// Списывает товары со склада по данным расходной накладной.
// Перед записью движений «Расход» выполняется контроль остатков:
// если товара на складе недостаточно, проведение прерывается
// с расшифровкой дефицита по каждой проблемной позиции.
//
// Параметры:
//  Документ - ДокументОбъект.РасходнаяНакладная - проводимый документ;
//  Отказ    - Булево - устанавливается в Истина при дефиците или ошибке.
//
Процедура ОтгрузитьТовары(Документ, Отказ) Экспорт

	Если Документ.Товары.Количество() = 0 Тогда
		СообщитьОбОшибке("В документе не заполнена табличная часть «Товары».", Отказ);
		Возврат;
	КонецЕсли;

	// Суммируем требуемое количество по каждой позиции, чтобы корректно
	// обработать несколько строк документа с одной и той же номенклатурой.
	Требуется = Новый Соответствие;

	Для Каждого СтрокаТЧ Из Документ.Товары Цикл
		УжеТребуется = Требуется.Получить(СтрокаТЧ.Номенклатура);
		Если УжеТребуется = Неопределено Тогда
			УжеТребуется = 0;
		КонецЕсли;
		Требуется.Вставить(СтрокаТЧ.Номенклатура, УжеТребуется + СтрокаТЧ.Количество);
	КонецЦикла;

	// Контролируем остатки на дату документа.
	Остатки = ОстаткиТоваров(Документ.Склад, Документ.Дата);

	ЕстьДефицит = Ложь;

	Для Каждого КлючИЗначение Из Требуется Цикл
		Доступно = Остатки.Получить(КлючИЗначение.Ключ);
		Если Доступно = Неопределено Тогда
			Доступно = 0;
		КонецЕсли;
		Если Доступно < КлючИЗначение.Значение Тогда
			СообщитьОбОшибке(
				СтрШаблон("Недостаточно товара «%1»: требуется %2, на складе %3.",
					КлючИЗначение.Ключ, КлючИЗначение.Значение, Доступно),
				Отказ);
			ЕстьДефицит = Истина;
		КонецЕсли;
	КонецЦикла;

	Если ЕстьДефицит Тогда
		Возврат;
	КонецЕсли;

	Движения = Документ.Движения.ОстаткиТоваров;
	Движения.Записывать = Истина;

	Для Каждого СтрокаТЧ Из Документ.Товары Цикл

		Движение = Движения.Добавить();
		Движение.ВидДвижения  = ВидДвиженияНакопления.Расход;
		Движение.Период       = Документ.Дата;
		Движение.Склад        = Документ.Склад;
		Движение.Номенклатура = СтрокаТЧ.Номенклатура;
		Движение.Количество   = СтрокаТЧ.Количество;
		Движение.Сумма        = СтрокаТЧ.Сумма;

	КонецЦикла;

	Движения.Записать();

КонецПроцедуры

// Возвращает остатки товаров на складе на указанный момент времени.
//
// Параметры:
//  Склад        - СправочникСсылка.Склады - склад-фильтр;
//                 если Неопределено — остатки по всем складам;
//  МоментВремени - Дата - момент, на который нужны остатки;
//                 если Неопределено — текущий момент.
//
// Возвращаемое значение:
//  Соответствие - ключ: СправочникСсылка.Номенклатура,
//                 значение: остаток количества на складе.
//
Функция ОстаткиТоваров(Склад = Неопределено, МоментВремени = Неопределено) Экспорт

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ОстаткиТоваровОстатки.Номенклатура КАК Номенклатура,
	|	ОстаткиТоваровОстатки.КоличествоОстаток КАК Количество
	|ИЗ
	|	РегистрНакопления.ОстаткиТоваров.Остатки(
	|			&МоментВремени,
	|			Склад = &Склад) КАК ОстаткиТоваровОстатки";

	Запрос.УстановитьПараметр("Склад", Склад);
	Запрос.УстановитьПараметр("МоментВремени", МоментВремени);

	Результат = Новый Соответствие;

	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Результат.Вставить(Выборка.Номенклатура, Выборка.Количество);
	КонецЦикла;

	Возврат Результат;

КонецФункции

// Заполняет информационную базу демонстрационными данными:
// два склада, номенклатура, контрагенты и проведенные приходы —
// чтобы конфигурацию можно было посмотреть «в деле» сразу после запуска.
//
Процедура ЗаполнитьДемоДанные() Экспорт

	СкладОсновной  = СоздатьСклад("Основной склад",
		"г. Москва, ул. Складская, 12", "Иванов И. И.");
	СкладРозничный = СоздатьСклад("Розничный магазин",
		"г. Москва, Ленинский проспект, 45", "Петров П. П.");

	Поставщик = СоздатьКонтрагента("ООО «ТехноОпт»",
		"7712345678", "+7 (495) 123-45-67");
	СоздатьКонтрагента("ООО «Ритейл Групп»",
		"7798765432", "+7 (495) 765-43-21");

	// Стартовое оприходование на основной склад.
	Приход = Документы.ПриходнаяНакладная.СоздатьДокумент();
	Приход.Дата        = ТекущаяДата();
	Приход.Склад       = СкладОсновной;
	Приход.Поставщик   = Поставщик;
	Приход.Комментарий = "Демонстрационные данные: стартовое оприходование";

	ДобавитьПозицию(Приход, "Кабель HDMI 2.1, 2 м",        "KB-HDMI-21", "шт", 120, 590.00);
	ДобавитьПозицию(Приход, "Мышь беспроводная MX-200",     "KB-MX200",   "шт", 80,  1490.00);
	ДобавитьПозицию(Приход, "Клавиатура механическая K87",  "KB-K87-BRN", "шт", 45,  4290.00);
	ДобавитьПозицию(Приход, "Монитор 27"" QHD IPS",         "KB-QHD27",   "шт", 30,  21990.00);
	ДобавитьПозицию(Приход, "Коврик для мыши XL",           "KB-PAD-XL",  "шт", 200, 350.00);

	Приход.Записать(РежимЗаписиДокумента.Проведение);

	// Небольшая партия сразу на розничный склад —
	// чтобы отчет «Остатки товаров» показал данные по двум складам.
	ПриходРозница = Документы.ПриходнаяНакладная.СоздатьДокумент();
	ПриходРозница.Дата        = ТекущаяДата();
	ПриходРозница.Склад       = СкладРозничный;
	ПриходРозница.Поставщик   = Поставщик;
	ПриходРозница.Комментарий = "Демонстрационные данные: розничный склад";

	ДобавитьПозицию(ПриходРозница, "Кабель HDMI 2.1, 2 м",    "KB-HDMI-21", "шт", 40, 590.00);
	ДобавитьПозицию(ПриходРозница, "Мышь беспроводная MX-200", "KB-MX200",   "шт", 25, 1490.00);

	ПриходРозница.Записать(РежимЗаписиДокумента.Проведение);

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Выводит сообщение пользователю и устанавливает признак отказа
// от проведения. Параметры процедур 1С передаются по ссылке,
// поэтому изменение Отказ видно в вызывающем коде.
Процедура СообщитьОбОшибке(ТекстОшибки, Отказ) Экспорт

	Сообщение = Новый СообщениеПользователю;
	Сообщение.Текст = ТекстОшибки;
	Сообщение.Сообщить();

	Отказ = Истина;

КонецПроцедуры

Процедура ДобавитьПозицию(Документ, Наименование, Артикул, Единица, Количество, Цена)

	Номенклатура = СоздатьНоменклатуру(Наименование, Артикул, Единица, Цена);

	СтрокаТЧ = Документ.Товары.Добавить();
	СтрокаТЧ.Номенклатура = Номенклатура;
	СтрокаТЧ.Количество   = Количество;
	СтрокаТЧ.Цена         = Цена;
	СтрокаТЧ.Сумма        = Окр(Количество * Цена, 2);

КонецПроцедуры

Функция СоздатьНоменклатуру(Наименование, Артикул, Единица, Цена)

	Объект = Справочники.Номенклатура.СоздатьЭлемент();
	Объект.Наименование     = Наименование;
	Объект.Артикул          = Артикул;
	Объект.ЕдиницаИзмерения = Единица;
	Объект.БазоваяЦена      = Цена;
	Объект.Записать();

	Возврат Объект.Ссылка;

КонецФункции

Функция СоздатьСклад(Наименование, Адрес, Ответственный)

	Объект = Справочники.Склады.СоздатьЭлемент();
	Объект.Наименование  = Наименование;
	Объект.Адрес         = Адрес;
	Объект.Ответственный = Ответственный;
	Объект.Записать();

	Возврат Объект.Ссылка;

КонецФункции

Функция СоздатьКонтрагента(Наименование, ИНН, Телефон)

	Объект = Справочники.Контрагенты.СоздатьЭлемент();
	Объект.Наименование = Наименование;
	Объект.ИНН          = ИНН;
	Объект.Телефон      = Телефон;
	Объект.Записать();

	Возврат Объект.Ссылка;

КонецФункции

#КонецОбласти