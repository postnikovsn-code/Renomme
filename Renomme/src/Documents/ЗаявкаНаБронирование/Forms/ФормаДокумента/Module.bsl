// + Проживание Редактирование
&НаКлиенте
Процедура ДобавитьПроживание(Команда)
Если Объект.БонШанс Тогда
	Если Объект.Проживание.Количество() > 0 Тогда Возврат; КонецЕсли;
КонецЕсли;

Элементы.Проживание.ДобавитьСтроку();
КонецПроцедуры

&НаКлиенте
Процедура ПроживаниеПередНачаломИзменения(Элемент, Отказ)
ТекущиеДанные = Элемент.ТекущиеДанные;

Если ЕстьВГрупповомСчетеПредупреждение(ТекущиеДанные.ГУИД, "ИЗМЕНЕНИЕ")Тогда Отказ = Истина; Возврат; КонецЕсли;
Если ЕстьВЗакрытомСчетеПредупреждение(ТекущиеДанные.ГУИД, "ИЗМЕНЕНИЕ") Тогда Отказ = Истина; Возврат; КонецЕсли;
//Если ЕстьВОплаченномСчетеПредупреждение(ТекущиеДанные.ГУИД, "ИЗМЕНЕНИЕ") Тогда Отказ = Истина; Возврат; КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ПроживаниеПриНачалеРедактирования(Элемент, НоваяСтрока, Копирование)
ТекущиеДанные = Элемент.ТекущиеДанные;	
СуммаОплаченоПроживание_OldValue = ТекущиеДанные.СуммаОплачено;	
КоличествоПроживание_OldValue = ТекущиеДанные.Количество;	
ДеньПроживания_OldValue = ТекущиеДанные.ДеньПроживания;

Если НоваяСтрока Тогда
	МаксДата = ЗаявкаОбщееКлиентСервер.ДеньПроживанияМаксимум(Объект.Проживание);
	Если ЗначениеЗаполнено(МаксДата) Тогда
		ТекущиеДанные.ДеньПроживания = МаксДата + 86400;
	ИначеЕсли ЗначениеЗаполнено(Объект.РезервС) Тогда
		ТекущиеДанные.ДеньПроживания = Объект.РезервС;
	Иначе	
		ТекущиеДанные.ДеньПроживания = ТекущаяДата();
	КонецЕсли;
	
	Если НЕ Копирование Тогда
		Двухместный = ДвухМестныйПредупреждение();	
		Если Двухместный = Неопределено Тогда Возврат; КонецЕсли;
		
		ПроживаниеПриНачалеРедактированияНоваяСтрокаНаСервере(Элемент.ТекущаяСтрока, Двухместный);		
	КонецЕсли;		
КонецЕсли;	
КонецПроцедуры

&НаСервере
Процедура ПроживаниеПриНачалеРедактированияНоваяСтрокаНаСервере(Идентификатор, Двухместный)
ТекущиеДанные = Объект.Проживание.НайтиПоИдентификатору(Идентификатор);	

ТекущиеДанные.Количество = 1;

ТекущиеДанные.Цена =  ДокументыСервер.ЦенаНаДень(ТекущиеДанные.ДеньПроживания, Объект.КатегорияНомера
	, Объект.БезЗавтрака, Двухместный);
ТекущиеДанные.СуммаБезСкидки = ТекущиеДанные.Цена * ТекущиеДанные.Количество;

//ТекущиеДанные.ПроцентСкидкиКлиента =  ДокументыСервер.ИтогоСкидка(Объект);
ТекущиеДанные.ПроцентСкидкиКлиента =  ДокументыСервер.ИтогоСкидкаКлиент(Объект, Ложь);
ДокументыСервер.ЗаполнитьСуммаСоСкидкойСтрокаПроживание(ТекущиеДанные);
КонецПроцедуры

&НаКлиенте
Процедура ПроживаниеДеньПроживанияПриИзменении(Элемент)
ТекущиеДанные = Элементы.Проживание.ТекущиеДанные;

Если НЕ ЗначениеЗаполнено(ТекущиеДанные.ДеньПроживания) Тогда
	ТекущиеДанные.Цена = 0;	
	ТекущиеДанные.Сумма = 0;	
	ТекущиеДанные.ПроцентСкидкиКлиента = 0;	
	ТекущиеДанные.СуммаБезСкидки = 0;	
	ТекущиеДанные.Количество = 0;	
		
	Возврат;	
КонецЕсли;

Двухместный = ДвухМестныйПредупреждение();
Если Двухместный = Неопределено Тогда Возврат; КонецЕсли; 

ПроживаниеДеньПроживанияПриИзмененииНаСервере(Элементы.Проживание.ТекущаяСтрока, Двухместный);
КонецПроцедуры

&НаСервере
Процедура ПроживаниеДеньПроживанияПриИзмененииНаСервере(Идентификатор, Двухместный)
ТекущиеДанные = Объект.Проживание.НайтиПоИдентификатору(Идентификатор);	
ТекущиеДанные.Цена =  ДокументыСервер.ЦенаНаДень(ТекущиеДанные.ДеньПроживания, Объект.КатегорияНомера
	, Объект.БезЗавтрака, Двухместный);
КонецПроцедуры

&НаКлиенте
Процедура ПроживаниеПроцентСкидкиКлиентаНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
ДанныеВыбора = Новый СписокЗначений;
//ПроцентСкидки = ДокументыСервер.ИтогоСкидка(Объект.Ссылка);
ПроцентСкидки = ДокументыСервер.ИтогоСкидкаКлиент(Объект, Ложь);
ДанныеВыбора.Добавить(ПроцентСкидки);
СтандартнаяОбработка = Ложь;
КонецПроцедуры

&НаКлиенте
Процедура ПроживаниеПриОкончанииРедактирования(Элемент, НоваяСтрока, ОтменаРедактирования)
Если ОтменаРедактирования Тогда	
	Если Элемент.ТекущиеДанные = Неопределено Тогда Возврат; КонецЕсли;		
КонецЕсли;	

ПроживаниеПриОкончанииРедактированияНаСервере(Элемент.ТекущаяСтрока, НоваяСтрока);

ТекущиеДанные = Элемент.ТекущиеДанные;
Если ТекущиеДанные.Сумма = 0 Тогда 
	ПоказатьПредупреждение(, "ВНИМАНИЕ. Сумма = 0");
КонецЕсли;
КонецПроцедуры

&НаСервере
Процедура ПроживаниеПриОкончанииРедактированияНаСервере(Идентификатор, ЭтоНоваяСтрока)
ТекущиеДанные = Объект.Проживание.НайтиПоИдентификатору(Идентификатор);	

Если ЭтоНоваяСтрока Тогда
	ТекущиеДанные.ГУИД = Новый УникальныйИдентификатор;
КонецЕсли;

ТекущиеДанные.СуммаБезСкидки = ТекущиеДанные.Цена * ТекущиеДанные.Количество;
ДокументыСервер.ЗаполнитьСуммаСоСкидкойСтрокаПроживание(ТекущиеДанные);

Если НЕ ЭтоНоваяСтрока Тогда
	ОбновитьСтрокаСчетаДетальноДолги(ТекущиеДанные, Ложь, Объект);
	
	ОтборСтроки = Новый Структура("ДолгиГУИД", ТекущиеДанные.ГУИД); 
	ТекущиеДанные.СуммаОплачено = ЗаявкаСервер.СуммаОплатыРаспределениеОплатДолгиОтборСтроки(ОтборСтроки, Объект.РаспределениеОплатДолги);
		
	СуммаОплаченоИтогоПроживание = СуммаОплаченоИтогоПроживание - СуммаОплаченоПроживание_OldValue + ТекущиеДанные.СуммаОплачено;	
КонецЕсли;

Если НЕ ЭтоНоваяСтрока Тогда
	ДобавитьСчетаКОбновлению(ТекущиеДанные.ГУИД);
КонецЕсли
КонецПроцедуры

&НаКлиенте
Процедура ПроживаниеПередУдалением(Элемент, Отказ)
Если Элемент.ТекущаяСтрока = Неопределено Тогда Возврат; КонецЕсли;

ТекущиеДанные = Элемент.ТекущиеДанные;	

Если ЕстьВГрупповомСчетеПредупреждение(ТекущиеДанные.ГУИД, "УДАЛЕНИЕ")Тогда Отказ = Истина; Возврат; КонецЕсли;
Если ЕстьВЗакрытомСчетеПредупреждение(ТекущиеДанные.ГУИД, "УДАЛЕНИЕ") Тогда Отказ = Истина; Возврат; КонецЕсли;

ПроживаниеПередУдалениемНаСервере(Элемент.ТекущаяСтрока);
КонецПроцедуры

&НаСервере
Функция ПроживаниеПередУдалениемНаСервере(Идентификатор)
ТекущиеДанные = Объект.Проживание.НайтиПоИдентификатору(Идентификатор);	
СуммаОплаченоИтогоПроживание = СуммаОплаченоИтогоПроживание - ТекущиеДанные.СуммаОплачено;

ДолгиГУИД = ТекущиеДанные.ГУИД;
ДобавитьСчетаКОбновлению(ДолгиГУИД);

ОтборСтроки = Новый Структура("ДолгиГУИД", ДолгиГУИД);
ОбщийФункционалСервер.УдалитьСтрокиОтборСтроки(ОтборСтроки, Объект.СчетаДетальноДолги);
КонецФункции	

&НаКлиенте
Процедура ПроживаниеКоличествоПриИзменении(Элемент)
//ТД = Элементы.Проживание.ТекущиеДанные;
КонецПроцедуры

// - Проживание Редактирование

&НаСервере
Процедура ДобавитьСчетаКОбновлению(ГУИД)
ОтборСтроки = Новый Структура("ДолгиГУИД", ГУИД);
НайденныеСтроки = Объект.СчетаДетальноДолги.НайтиСтроки(ОтборСтроки);
Если НайденныеСтроки.Количество() > 0 Тогда
	СчетГУИД = НайденныеСтроки[0].СчетГУИД;
	НоваяСтрока = СчетаКОбновлению.Добавить();
	НоваяСтрока.СчетГУИД = СчетГУИД;
КонецЕсли
КонецПроцедуры

//// - Проживание

//// + ДопУслуги
&НаКлиенте
Процедура ДопУслугиПередНачаломИзменения(Элемент, Отказ)
ТекущиеДанные = Элемент.ТекущиеДанные;

Если ЕстьВГрупповомСчетеПредупреждение(ТекущиеДанные.ГУИД, "ИЗМЕНЕНИЕ")Тогда Отказ = Истина; Возврат; КонецЕсли;
Если ЕстьВЗакрытомСчетеПредупреждение(ТекущиеДанные.ГУИД, "ИЗМЕНЕНИЕ") Тогда Отказ = Истина; Возврат; КонецЕсли;

ДопУслугиВСчет_OldValue = ТекущиеДанные.ВСчет; 	
ДопУслугиУслуга_OldValue = ТекущиеДанные.Услуга; 

ДопУслугиКоличество_OldValue = ТекущиеДанные.Количество; 
ДопУслугиЦена_OldValue = ТекущиеДанные.Цена; 
КонецПроцедуры

&НаКлиенте
Процедура ДопУслугиУслугаПриИзменении(Элемент)
ДопУслугиУслугаПриИзмененииНаСервере(Элементы.ДопУслуги.ТекущаяСтрока);
КонецПроцедуры

&НаСервере
Процедура ДопУслугиУслугаПриИзмененииНаСервере(Идентификатор)
ТекущиеДанные = Объект.ДопУслуги.НайтиПоИдентификатору(Идентификатор);	

ТекущиеДанные.Цена=ТекущиеДанные.Услуга.Цена;

Если ДопУслугиУслуга_OldValue = Справочники.ДопУслуги.ДолгиЗаУслугиПрошлыйПериод Тогда
	ТекущиеДанные.Услуга = ДопУслугиУслуга_OldValue; 	
КонецЕсли;	
КонецПроцедуры

&НаКлиенте
Процедура ДопУслугиПриОкончанииРедактирования(Элемент, НоваяСтрока, ОтменаРедактирования)
Если ОтменаРедактирования Тогда	
	Если Элемент.ТекущиеДанные = Неопределено Тогда Возврат; КонецЕсли;		
КонецЕсли;	

ДопУслугиПриОкончанииРедактированияНаСервере(Элемент.ТекущаяСтрока, НоваяСтрока);

ТекущиеДанные = Элемент.ТекущиеДанные;
//Если НЕ ТекущиеДанные.ВСчет Тогда Возврат; КонецЕсли;	

Если ТекущиеДанные.ВСчет Тогда 	
	Если (ТекущиеДанные.Цена *  ТекущиеДанные.Количество) = 0 Тогда 
		ПоказатьПредупреждение(, "ВНИМАНИЕ. Сумма = 0");
	КонецЕсли;
КонецЕсли;

Если ОбновитьПрошлыйПериодДопУслуги(Элемент.ТекущаяСтрока, НоваяСтрока) Тогда
	ПоказатьПредупреждение(, "ВНИМАНИЕ ! Сумма > Суммы долга");
КонецЕсли;
КонецПроцедуры

&НаСервере
Процедура ДопУслугиПриОкончанииРедактированияНаСервере(Идентификатор, ЭтоНоваяСтрока)
ТекущиеДанные = Объект.ДопУслуги.НайтиПоИдентификатору(Идентификатор);	

Если ЭтоНоваяСтрока Тогда
	ТекущиеДанные.ГУИД = Новый УникальныйИдентификатор;
КонецЕсли;

Если НЕ ЗначениеЗаполнено(ТекущиеДанные.ДатаУслуги) Тогда
	Если Объект.РезервПо <= НачалоДня(ТекущаяДата()) Тогда
		Если Объект.РезервС = Объект.РезервПо Тогда
			ТекущиеДанные.ДатаУслуги = Объект.РезервС;
		Иначе
			ТекущиеДанные.ДатаУслуги = Объект.РезервПо - 24*60*60;
		КонецЕсли;
	ИначеЕсли Объект.РезервС > НачалоДня(ТекущаяДата()) Тогда
		ТекущиеДанные.ДатаУслуги = Объект.РезервС;
	Иначе
		ТекущиеДанные.ДатаУслуги = ТекущаяДата();
	КонецЕсли;
КонецЕсли;

Сумма_OldValue = ТекущиеДанные.Сумма;
ТекущиеДанные.Сумма = ТекущиеДанные.Цена * ТекущиеДанные.Количество;

ОтборСтроки = Новый Структура("ДолгиГУИД", ТекущиеДанные.ГУИД); 
НайденныеСтрокиСчетаДетальноДолги = Объект.СчетаДетальноДолги.НайтиСтроки(ОтборСтроки);

Если ТекущиеДанные.ВСчет = ДопУслугиВСчет_OldValue Тогда
	Если ТекущиеДанные.ВСчет Тогда 
		Если НЕ ЭтоНоваяСтрока Тогда
			ОбновитьСтрокаСчетаДетальноДолги(ТекущиеДанные, Истина, Объект);
			
			ОтборСтроки = Новый Структура("ДолгиГУИД", ТекущиеДанные.ГУИД); 
			ТекущиеДанные.СуммаОплачено = ЗаявкаСервер.СуммаОплатыРаспределениеОплатДолгиОтборСтроки(ОтборСтроки, Объект.РаспределениеОплатДолги);
		КонецЕсли;
		
		СуммаИтогоДопУслуги = СуммаИтогоДопУслуги - Сумма_OldValue + ТекущиеДанные.Сумма;
	КонецЕсли;
	
	Если НЕ ЭтоНоваяСтрока Тогда
		ДобавитьСчетаКОбновлению(ТекущиеДанные.ГУИД);
	КонецЕсли;
		
Иначе
	Если ТекущиеДанные.ВСчет Тогда	
		СуммаИтогоДопУслуги = СуммаИтогоДопУслуги + ТекущиеДанные.Сумма;
	Иначе	
		ОтборСтроки = Новый Структура("ДолгиГУИД", ТекущиеДанные.ГУИД);
		ТекущиеДанные.СуммаОплачено = ЗаявкаСервер.СуммаОплатыРаспределениеОплатДолгиОтборСтроки(ОтборСтроки, Объект.РаспределениеОплатДолги);
		
		Если НЕ ЭтоНоваяСтрока Тогда
			ДобавитьСчетаКОбновлению(ТекущиеДанные.ГУИД);
		КонецЕсли;
		
		ОбщийФункционалСервер.УдалитьСтрокиОтборСтроки(ОтборСтроки, Объект.СчетаДетальноДолги);
	КонецЕсли;	
КонецЕсли;

КонецПроцедуры

&НаСервере
Функция ОбновитьПрошлыйПериодДопУслуги(Идентификатор, ЭтоНоваяСтрока)
ТекущиеДанные = Объект.ДопУслуги.НайтиПоИдентификатору(Идентификатор);	

Если ТекущиеДанные.Услуга = Справочники.ДопУслуги.ДолгиЗаУслугиПрошлыйПериод Тогда
	ОтборСтроки = Новый Структура("ПрочиеОплатыДокументОплаты, ПрочиеОплатыДокументДолг"
		, ТекущиеДанные.ПрочиеОплатыДокументОплаты, ТекущиеДанные.ПрочиеОплатыДокументДолг);
	НайденныеСтроки = ПрошлыйПериодДопУслуги.НайтиСтроки(ОтборСтроки);	
	
	Если НайденныеСтроки.Количество() = 0 Тогда
		СтрокаПрошлыйПериодДопУслуги = ПрошлыйПериодДопУслуги.Добавить();
		СтрокаПрошлыйПериодДопУслуги.ПрочиеОплатыДокументОплаты = ТекущиеДанные.ПрочиеОплатыДокументОплаты;
		СтрокаПрошлыйПериодДопУслуги.ПрочиеОплатыДокументДолг = ТекущиеДанные.ПрочиеОплатыДокументДолг;
	Иначе
		СтрокаПрошлыйПериодДопУслуги = НайденныеСтроки[0]; 
	КонецЕсли;
	
	СтрокаПрошлыйПериодДопУслуги.Сумма = СтрокаПрошлыйПериодДопУслуги.Сумма 
		+ ТекущиеДанные.Количество * ТекущиеДанные.Цена 
		- ДопУслугиКоличество_OldValue * ДопУслугиЦена_OldValue; 
КонецЕсли;

Запрос = Новый Запрос;
Запрос.Текст = ЗаявкаСервер.ПрошлыйПериодДопУслуги_ТекстЗапроса();
Запрос.Текст = Запрос.Текст + "
                    |	И ПрочиеОплаты.Ссылка = &ДокументОплаты
                    |	И Долги.ДокументДолг = &ДокументДолг";

Запрос.УстановитьПараметр("ДокументОплаты", ТекущиеДанные.ПрочиеОплатыДокументОплаты);
Запрос.УстановитьПараметр("ДокументДолг", ТекущиеДанные.ПрочиеОплатыДокументДолг);

ТЗ_Параметр = ПрошлыйПериодДопУслуги.Выгрузить();
ТЗ_Параметр.Свернуть("ПрочиеОплатыДокументОплаты, ПрочиеОплатыДокументДолг", "Сумма");
Запрос.УстановитьПараметр("ТЗ", ТЗ_Параметр);

ТЗ = Запрос.Выполнить().Выгрузить();

Если ТЗ.Количество() = 0 Тогда
	Возврат Ложь;
КонецЕсли;

Возврат (ТЗ[0].СуммаКЗакрытию < 0);
КонецФункции

&НаКлиенте
Процедура ДопУслугиПередУдалением(Элемент, Отказ)
ТекущиеДанные = Элемент.ТекущиеДанные;	

Если ЕстьВГрупповомСчетеПредупреждение(ТекущиеДанные.ГУИД, "УДАЛЕНИЕ")Тогда Отказ = Истина; Возврат; КонецЕсли;
Если ЕстьВЗакрытомСчетеПредупреждение(ТекущиеДанные.ГУИД, "УДАЛЕНИЕ") Тогда Отказ = Истина; Возврат; КонецЕсли;

ДопУслугиПередУдалениемНаСервере(Элемент.ТекущаяСтрока);
КонецПроцедуры

&НаСервере
Процедура ДопУслугиПередУдалениемНаСервере(Идентификатор)
ТекущиеДанные = Объект.ДопУслуги.НайтиПоИдентификатору(Идентификатор);	
СуммаОплаченоИтогоДопУслуги = СуммаОплаченоИтогоДопУслуги - ТекущиеДанные.СуммаОплачено;

ДолгиГУИД = ТекущиеДанные.ГУИД;
ДобавитьСчетаКОбновлению(ДолгиГУИД);

ОтборСтроки = Новый Структура("ДолгиГУИД", ДолгиГУИД);
ОбщийФункционалСервер.УдалитьСтрокиОтборСтроки(ОтборСтроки, Объект.СчетаДетальноДолги);

//Если НЕ ТекущиеДанные.ВСчет Тогда Возврат; КонецЕсли;

Если ЗначениеЗаполнено(ТекущиеДанные.ПрочиеОплатыДокументОплаты) Тогда
	//
	ОтборСтроки = Новый Структура("ПрочиеОплатыДокументОплаты, ПрочиеОплатыДокументДолг"
		, ТекущиеДанные.ПрочиеОплатыДокументОплаты, ТекущиеДанные.ПрочиеОплатыДокументДолг);
	НайденныеСтроки = ПрошлыйПериодДопУслуги.НайтиСтроки(ОтборСтроки);	
	
	Если НайденныеСтроки.Количество() = 0 Тогда
		СтрокаПрошлыйПериодДопУслуги = ПрошлыйПериодДопУслуги.Добавить();
		СтрокаПрошлыйПериодДопУслуги.ПрочиеОплатыДокументОплаты = ТекущиеДанные.ПрочиеОплатыДокументОплаты;
		СтрокаПрошлыйПериодДопУслуги.ПрочиеОплатыДокументДолг = ТекущиеДанные.ПрочиеОплатыДокументДолг;
	Иначе
		СтрокаПрошлыйПериодДопУслуги = НайденныеСтроки[0]; 
	КонецЕсли;
	
	СтрокаПрошлыйПериодДопУслуги.Сумма = - (ТекущиеДанные.Количество * ТекущиеДанные.Цена);
	//	
КонецЕсли;	
КонецПроцедуры	
//// - ДопУслуги

//
&НаСервере
Функция ОбновитьСтрокаСчетаДетальноДолги(ТекущиеДанные, Услуга, ТекущийОбъект) Экспорт
ДолгиГУИД = ТекущиеДанные.ГУИД;	
ОтборСтроки = Новый Структура("ДолгиГУИД", ДолгиГУИД);
НайденныеСтрокиДолги = ТекущийОбъект.СчетаДетальноДолги.НайтиСтроки(ОтборСтроки);
Если НайденныеСтрокиДолги.Количество() = 0 Тогда Возврат Неопределено; КонецЕсли; 

ЗаявкаСервер.ОчиститьСчетаДетальноОплатыОтборСтроки(ОтборСтроки, ТекущийОбъект.РаспределениеОплатДолги, ТекущийОбъект.СчетаДетальноОплаты);

НайденнаяСтрокаДолги = НайденныеСтрокиДолги[0];

СчетГУИД = НайденнаяСтрокаДолги.СчетГУИД;
ЗаявкаСервер.ЗаполнитьСтрокаДолги(НайденнаяСтрокаДолги, ТекущиеДанные, СчетГУИД, Услуга);   

ОтборСтрокиСчет = Новый Структура("СчетГУИД", НайденнаяСтрокаДолги.СчетГУИД);
НайденныеСчета = ТекущийОбъект.Счета.НайтиСтроки(ОтборСтрокиСчет);
НайденныйСчет = НайденныеСчета[0];

Контрагент = НайденныйСчет.Контрагент;

Если НЕ НайденнаяСтрокаДолги.Услуга Тогда 
	
	Если Контрагент = ТекущийОбъект.Клиент ИЛИ Контрагент = ТекущийОбъект.Клиент2 Тогда
		РазделитьСчет = НайденныйСчет.РазделитьСчет;
		ЮрЛицо = КлиентыСервер.ЭтоЮрЛицо(Контрагент);
		ЕстьКлиент2 = ЗначениеЗаполнено(ТекущийОбъект.Клиент2);
		НеПервый = (Контрагент = ТекущийОбъект.Клиент2);
	
		ЗаявкаСервер.УстановитьЦенаСуммаСчетаДетальноДолгиДляРазделитьСчет(НайденнаяСтрокаДолги
			, РазделитьСчет, ЮрЛицо, ЕстьКлиент2, НеПервый);	                                                                                     	
	КонецЕсли;	
			
КонецЕсли;	
	
МассивОплатКонтрагента = ЗаявкаСервер.МассивОплатКонтрагента(Контрагент, ТекущийОбъект.СчетаДетальноОплаты); 
ЗаявкаСервер.РаспределитьСчетаДетальноОплатыДолгСтрока(НайденнаяСтрокаДолги
	, ТекущийОбъект.РаспределениеОплатДолги, МассивОплатКонтрагента, ТекущийОбъект);
//МассивОплатСчета = ОбщийМодульОплатыСервер.МассивОплатСчета(СчетГУИД, Объект); 
//ОбщийМодульОплатыСервер.РаспределитьОплатыДолгСтрока(НайденнаяСтрокаДолги, Объект.РаспределениеОплатДолги, МассивОплатСчета);
КонецФункции
//

////
&НаКлиенте
Функция ЕстьВЗакрытомСчетеПредупреждение(ДолгиГУИД, Текст)
ОтборСтроки = Новый Структура("ДолгиГУИД", ДолгиГУИД);
НайденныеСтрокиДолги = Объект.СчетаДетальноДолги.НайтиСтроки(ОтборСтроки);

Для Каждого НайденнаяСтрокаДолги Из НайденныеСтрокиДолги Цикл
	СчетГУИД = НайденнаяСтрокаДолги.СчетГУИД;
	
	ОтборСтрокиСчет = Новый Структура("СчетГУИД", НайденнаяСтрокаДолги.СчетГУИД);
	НайденныеСчета = Объект.Счета.НайтиСтроки(ОтборСтрокиСчет);
	НайденныйСчет = НайденныеСчета[0];
	
	Если НайденныйСчет.Закрыт Тогда 
		ПоказатьПредупреждение(, "Строка находится в закрытом счете" + Символы.ПС + Символы.ПС + Текст + " НЕ РАЗРЕШЕНО ...");		
		
		Возврат Истина;
	КонецЕсли;	
КонецЦикла;		

Возврат Ложь;
КонецФункции	

&НаКлиенте
Функция ЕстьВГрупповомСчетеПредупреждение(ДолгиГУИД, Текст)
ОтборСтроки = Новый Структура("ДолгиГУИД", ДолгиГУИД);
НайденныеСтрокиДолги = Объект.СчетаДетальноДолги.НайтиСтроки(ОтборСтроки);

Для Каждого НайденнаяСтрокаДолги Из НайденныеСтрокиДолги Цикл
	СчетГУИД = НайденнаяСтрокаДолги.СчетГУИД;
	
	ОтборСтрокиСчет = Новый Структура("СчетГУИД", НайденнаяСтрокаДолги.СчетГУИД);
	НайденныеСчета = Объект.Счета.НайтиСтроки(ОтборСтрокиСчет);
	НайденныйСчет = НайденныеСчета[0];
	
	Если ЗначениеЗаполнено(НайденныйСчет.ГрупповойСчет) Тогда
		ПоказатьПредупреждение(, "Строка находится в групповом счете" + Символы.ПС + Символы.ПС + Текст + " НЕ РАЗРЕШЕНО ...");		
		
		Возврат Истина;
	КонецЕсли;	
КонецЦикла;		

Возврат Ложь;
КонецФункции	

&НаКлиенте
Функция ЕстьВОплаченномСчетеПредупреждение(ДолгиГУИД, Текст)
ОтборСтроки = Новый Структура("ДолгиГУИД", ДолгиГУИД);
НайденныеСтрокиДолги = Объект.СчетаДетальноДолги.НайтиСтроки(ОтборСтроки);

Для Каждого НайденнаяСтрокаДолги Из НайденныеСтрокиДолги Цикл
	СчетГУИД = НайденнаяСтрокаДолги.СчетГУИД;
	Если ЕстьОплатыСчета(СчетГУИД) Тогда 
		ПоказатьПредупреждение(, "Строка находится в оплаченном счете" 
			+ Символы.ПС + Символы.ПС + Текст + " НЕ РАЗРЕШЕНО ...");
			
		Возврат Истина; 
	КонецЕсли;
КонецЦикла;		

Возврат Ложь;
КонецФункции	

&НаКлиенте
Функция ЕстьОплатыСчета(СчетГУИД)     
ОтборСтроки = Новый Структура("СчетГУИД", СчетГУИД);
НайденныеСтроки = Объект.РаспределениеОплатДолги.НайтиСтроки(ОтборСтроки);

Возврат (НайденныеСтроки.Количество() > 0); 
КонецФункции
