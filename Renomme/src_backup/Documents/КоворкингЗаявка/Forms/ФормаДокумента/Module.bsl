
&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
Если РаботаСИнтерфейсомСервер.УстановитьТолькоПросмотр(ЭтаФорма) Тогда Отказ = Истина; Возврат; КонецЕсли;

РаботаСИнтерфейсомКлиентСервер.УбратьКнопкуКоманднойПанелиФормы(ЭтаФорма.КоманднаяПанель,"ФормаУдалить");
	
Если НЕ ЗначениеЗаполнено(Объект.Ссылка) Тогда
	Если Параметры.Свойство("КоворкингНомер", Объект.КоворкингНомер) Тогда
		Элементы.КоворкингНомер.ТолькоПросмотр = Истина;
	КонецЕсли;
КонецЕсли;

Счета.Параметры.УстановитьЗначениеПараметра("КоворкингЗаявка", Объект.Ссылка);

НастройкаФормы();
КонецПроцедуры

&НаСервере
Процедура НастройкаФормы()
Объект.ПочасоваяОплата = Объект.КоворкингНомер.ПочасоваяОплата;
ПочасоваяОплата = Объект.ПочасоваяОплата;

//Элементы.ДатаПо.Видимость = НЕ ПочасоваяОплата; 
Элементы.ЧасС.Видимость = ПочасоваяОплата; 
Элементы.ЧасПо.Видимость = ПочасоваяОплата; 
//Элементы.ВключатьВыходные.Видимость = НЕ ПочасоваяОплата; 

Элементы.СчетаДатаПо.Видимость = НЕ ПочасоваяОплата; 
Элементы.СчетаЧасС.Видимость = ПочасоваяОплата; 
Элементы.СчетаЧасПо.Видимость = ПочасоваяОплата; 

Если ПочасоваяОплата Тогда
	Элементы.ПериодАренды.СписокВыбора.Добавить("ЧАС"); 
Иначе
	Элементы.ПериодАренды.СписокВыбора.Добавить("МЕСЯЦ"); 
	Элементы.ПериодАренды.СписокВыбора.Добавить("НЕДЕЛЯ"); 
	Элементы.ПериодАренды.СписокВыбора.Добавить("ДЕНЬ"); 
КонецЕсли;

Если ПочасоваяОплата Тогда
	Если Объект.ПериодАренды <> "ЧАС" Тогда
		Объект.ПериодАренды = "ЧАС";
	КонецЕсли;
	Объект.ДатаПо = Объект.ДатаС;

	Элементы.ПериодАренды.ТолькоПросмотр = Истина;
	
	КоворкингСервер.ЗаполнитьЧасыСписокВыбора(Элементы.ЧасС.СписокВыбора, Элементы.ЧасПо.СписокВыбора);
	
	Объект.Цена = Объект.КоворкингНомер.ЦенаЗаЧас;	
КонецЕсли;
КонецПроцедуры

//
&НаКлиенте
Процедура КоворкингНомерПриИзменении(Элемент)
Если КоворкингСервер.ЕстьКоворкингСчета(Объект.Ссылка) Тогда 	
	ПоказатьПредупреждение(, "Есть Счета.
	|
	|ИЗМЕНЕНИЕ НЕ РАЗРЕШЕНО ...");
	
	Объект.КоворкингНомер = ОбщийФункционалСервер.ЗначениеРеквизитаНаСервере(Объект.Ссылка, "КоворкингНомер");
	Возврат;
КонецЕсли;

КоворкингНомерПриИзмененииНаСервере();
КонецПроцедуры

&НаСервере
Процедура КоворкингНомерПриИзмененииНаСервере()
НастройкаФормы();
КонецПроцедуры

&НаКлиенте
Процедура ОплачиваетОнЖе(Команда)
Объект.Оплачивает = Объект.Клиент;	
КонецПроцедуры

&НаКлиенте
Процедура ПериодАрендыПриИзменении(Элемент)
ПериодАрендыПриИзмененииНаСервере();
КонецПроцедуры

&НаСервере
Процедура ПериодАрендыПриИзмененииНаСервере()
Если Объект.ПериодАренды = "МЕСЯЦ" Тогда
	Объект.Цена = Объект.КоворкингНомер.ЦенаЗаМесяц;		
ИначеЕсли Объект.ПериодАренды = "НЕДЕЛЯ" Тогда
	Объект.Цена = Объект.КоворкингНомер.ЦенаЗаНеделю;	
ИначеЕсли Объект.ПериодАренды = "ДЕНЬ" Тогда
	Объект.Цена = Объект.КоворкингНомер.ЦенаЗаДень;
ИначеЕсли Объект.ПериодАренды = "ЧАС" Тогда
	Объект.Цена = Объект.КоворкингНомер.ЦенаЗаЧас;;
Иначе	
	Объект.Цена = 0;
КонецЕсли;
КонецПроцедуры
//

//
&НаКлиенте
Процедура ДатаСПриИзменении(Элемент)
Если НЕ ЗначениеЗаполнено(Объект.ДатаС)	Тогда Возврат; КонецЕсли;
	
Если НЕ ЗначениеЗаполнено(Объект.ДатаПо) Тогда 
	Если Объект.ПочасоваяОплата Тогда
		Объект.ДатаПо = Объект.ДатаС;
	КонецЕсли;
КонецЕсли;
	
КонтрольДаты("ДатаС", "Дата С");
КонецПроцедуры

&НаКлиенте
Процедура ДатаПоПриИзменении(Элемент)
КонтрольДаты("ДатаПо", "Дата По");
КонецПроцедуры

&НаКлиенте
Процедура КонтрольДаты(ДатаИмяРеквизита, ДатаНаименованиеРеквизита)
Если НЕ (ЗначениеЗаполнено(Объект.ДатаС) И ЗначениеЗаполнено(Объект.ДатаПо)) Тогда 
	
	Возврат; 
КонецЕсли;

Если Объект.ДатаПо < Объект.ДатаС  Тогда 
	ПоказатьПредупреждение(, "'Дата По' меньше 'Дата С'
		|
		|ИЗМЕНЕНИЕ НЕ РАЗРЕШЕНО ...");
	
	Дата_OldValue = ОбщийФункционалСервер.ЗначениеРеквизитаНаСервере(Объект.Ссылка, ДатаИмяРеквизита);
	Объект[ДатаИмяРеквизита] = Дата_OldValue;
	
	Возврат; 
КонецЕсли;
КонецПроцедуры
//

//
&НаКлиенте
Процедура ЧасСПриИзменении(Элемент)
КонтрольЧасы("ЧасС", "Час С");
КонецПроцедуры

&НаКлиенте
Процедура ЧасПоПриИзменении(Элемент)
КонтрольЧасы("ЧасПо", "Час По");
КонецПроцедуры

&НаКлиенте
Процедура КонтрольЧасы(ЧасИмяРеквизита, ЧасНаименованиеРеквизита)
Если Объект.ЧасС = 0 ИЛИ Объект.ЧасПо = 0 Тогда Возврат; КонецЕсли;

ЧасыМинимумМаксимум = КоворкингСервер.НачальныйЧасКонечныйЧас();
Если Объект[ЧасИмяРеквизита] < ЧасыМинимумМаксимум.НачальныйЧас
ИЛИ Объект[ЧасИмяРеквизита] > ЧасыМинимумМаксимум.КонечныйЧас
Тогда 	
	Час_OldValue = ОбщийФункционалСервер.ЗначениеРеквизитаНаСервере(Объект.Ссылка, ЧасИмяРеквизита);
	Объект[ЧасИмяРеквизита] = Час_OldValue;
	
	Возврат;
КонецЕсли;

Если Объект.ЧасПо <= Объект.ЧасС Тогда 
	ПоказатьПредупреждение(, "'Час По' меньше либо равен 'Час С'.
		|
		|ИЗМЕНЕНИЕ НЕ РАЗРЕШЕНО ...");
	
	Дата_OldValue = ОбщийФункционалСервер.ЗначениеРеквизитаНаСервере(Объект.Ссылка, ЧасИмяРеквизита);
	Объект[ЧасИмяРеквизита] = Дата_OldValue;
	
	Возврат; 
КонецЕсли;
КонецПроцедуры
//

//
&НаКлиенте
Процедура ПередЗаписью(Отказ, ПараметрыЗаписи)
ТекстСообщения = ПроверкаЗаполненияТекстСообщенияПередЗаписьюНаСервере();
Если ТекстСообщения <> "" Тогда
	ТекстСообщения = ТекстСообщения + " ЗАПИСЬ ОТМЕНЯЕТСЯ.";
	Сообщить(ТекстСообщения); 
	
	Отказ = Истина;
	Возврат; 
КонецЕсли;

Если ПараметрыЗаписи.РежимЗаписи <> РежимЗаписиДокумента.ОтменаПроведения Тогда
	ДанныеОбъект = Объект;
	Результат = КоворкингСервер.ПроверкаЗанятостиКоворкинг(ДанныеОбъект);
	Если Результат.Ошибка Тогда
		ТекстПредупреждения = "";
		Первый = Истина;
		Для Каждого Строка Из Результат.Сообщение Цикл
			Если Первый Тогда Первый = Ложь; Продолжить; КонецЕсли; 
			
			ТекстПредупреждения = ТекстПредупреждения + Строка + Символы.ПС;
		КонецЦикла;
		ТекстПредупреждения = ТекстПредупреждения + Символы.ПС + "ЗАПИСЬ ОТМЕНЯЕТСЯ.";
		ПоказатьПредупреждение(,ТекстПредупреждения);
		
		ТекстСообщения = "";
		Для Каждого Строка Из Результат.Сообщение Цикл
			ТекстСообщения = ТекстСообщения + Строка + " ";
		КонецЦикла;	
		ТекстСообщения = ТекстСообщения + "ЗАПИСЬ ОТМЕНЯЕТСЯ.";
		Сообщить(ТекстСообщения);
		
		Отказ = Истина; Возврат;	
	КонецЕсли;
КонецЕсли;
КонецПроцедуры

&НаСервере
Функция ПроверкаЗаполненияТекстСообщенияПередЗаписьюНаСервере()
Возврат КоворкингСервер.ПроверкаЗаполненияКоворкингЗаявкаТекстСообщения(Объект, " ");
КонецФункции
