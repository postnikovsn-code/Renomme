&НаСервере
Процедура ВыгрузкаЗагрузитьПлатежиНаСервере()
Запрос = Новый Запрос("ВЫБРАТЬ
                      |	БезналЗагрузка.ГУИД КАК ГУИД,
                      |	БезналЗагрузка.ГУИДИсточникаСтрока КАК ГУИДИсточникаСтрока,
                      |	БезналЗагрузка.ДатаЗагрузки КАК ДатаЗагрузки,
                      |	БезналЗагрузка.КонтрагентНаименование КАК КонтрагентНаименованиеЗагрузка,
                      |	БезналЗагрузка.КонтрагентИНН КАК КонтрагентИННЗагрузка,
                      |	БезналЗагрузка.КонтрагентКПП КАК КонтрагентКППЗагрузка,
                      |	БезналЗагрузка.ДатаОплаты КАК ДатаПлатежа,
                      |	БезналЗагрузка.Сумма КАК СуммаПлатежа,
                      |	БезналЗагрузка.ТекстПлатежа КАК ТекстПлатежа,
                      |	БезналЗагрузка.Отменено КАК Отменено,
                      |	ВыпискаБанка.Ссылка КАК ДокументОплаты,
                      |	ВыпискаБанка.Сумма КАК СуммаДокументОплаты,
                      |	БезналЗагрузка.ПолучательПлатежа КАК ПолучательПлатежа,
                      |	БезналЗагрузка.СуммаЧехов КАК СуммаЧехов,
                      |	БезналЗагрузка.СуммаЛайв КАК СуммаЛайв,
                      |	БезналЗагрузка.СуммаДомСоветов КАК СуммаДомСоветов,
                      |	БезналЗагрузка.СуммаРеноме КАК СуммаРеноме,
                      |	БезналЗагрузка.СуммаСтритАрт КАК СуммаСтритАрт,
                      |	БезналЗагрузка.ДатаИзменения КАК ДатаИзменения
                      |ИЗ
                      |	РегистрСведений.БезналЗагрузка КАК БезналЗагрузка
                      |		ЛЕВОЕ СОЕДИНЕНИЕ Документ.ВыпискаБанка КАК ВыпискаБанка
                      |		ПО БезналЗагрузка.ГУИД = ВыпискаБанка.ГУИДЗагрузка
                      |ГДЕ
                      |	НЕ БезналЗагрузка.КонтрагентИНН В (&СписокИННЭквайринг)
                      |	И ВЫБОР
                      |			КОГДА &КонтрагентИНН = """"
                      |				ТОГДА ИСТИНА
                      |			ИНАЧЕ БезналЗагрузка.КонтрагентИНН = &КонтрагентИНН
                      |		КОНЕЦ
                      |	И ВЫБОР
                      |			КОГДА &ДатаПлатежаС = ДАТАВРЕМЯ(1, 1, 1, 0, 0, 0)
                      |				ТОГДА ИСТИНА
                      |			ИНАЧЕ БезналЗагрузка.ДатаОплаты >= &ДатаПлатежаС
                      |		КОНЕЦ
                      |	И ВЫБОР
                      |			КОГДА &ДатаПлатежаПо = ДАТАВРЕМЯ(1, 1, 1, 0, 0, 0)
                      |				ТОГДА ИСТИНА
                      |			ИНАЧЕ БезналЗагрузка.ДатаОплаты <= &ДатаПлатежаПо
                      |		КОНЕЦ
                      |	И ВЫБОР
                      |			КОГДА &ПлатежиТолькоНеотмененные
                      |				ТОГДА БезналЗагрузка.Отменено = ЛОЖЬ
                      |			ИНАЧЕ ИСТИНА
                      |		КОНЕЦ
                      |	И ВЫБОР
                      |			КОГДА &ПлатежиТолькоС2022
                      |				ТОГДА БезналЗагрузка.ДатаОплаты >= ДАТАВРЕМЯ(2022, 1, 1, 0, 0, 0)
                      |			ИНАЧЕ ИСТИНА
                      |		КОНЕЦ
                      |	И ВЫБОР
                      |			КОГДА &ПолучательПлатежаВсе
                      |				ТОГДА ИСТИНА
                      |			ИНАЧЕ БезналЗагрузка.ПолучательПлатежа = &ПолучательПлатежаОтбор
                      |		КОНЕЦ
                      |	И ВЫБОР
                      |			КОГДА &ПлатежиТолькоНовые
                      |				ТОГДА ВыпискаБанка.ПометкаУдаления ЕСТЬ NULL
                      |			ИНАЧЕ ЕСТЬNULL(ВыпискаБанка.ПометкаУдаления, ЛОЖЬ) = ЛОЖЬ
                      |		КОНЕЦ");

					  //|	БезналЗагрузка.КонтрагентИНН <> &КонтрагентИННЭквайринг


Запрос.УстановитьПараметр("КонтрагентИНН", СокрЛП(ВыгрузкаПлатежиКонтрагентИННОтбор));
Запрос.УстановитьПараметр("ДатаПлатежаС", ВыгрузкаДатаПлатежаС);
Запрос.УстановитьПараметр("ДатаПлатежаПо", ВыгрузкаДатаПлатежаПо);

Запрос.УстановитьПараметр("ПлатежиТолькоНовые", ВыгрузкаПлатежиТолькоНовые);
Запрос.УстановитьПараметр("ПлатежиТолькоНеотмененные", ВыгрузкаПлатежиТолькоНеотмененные);
Запрос.УстановитьПараметр("ПлатежиТолькоС2022", ВыгрузкаПлатежиТолькоС2022);

Запрос.УстановитьПараметр("ПолучательПлатежаВсе", ВыгрузкаПлатежиПолучательПлатежаВсе);
Запрос.УстановитьПараметр("ПолучательПлатежаОтбор", ВыгрузкаПлатежиПолучательПлатежаОтбор);

СписокИННЭквайринг = БезналРаспределениеСервер.СписокИННЭквайринг();
Запрос.УстановитьПараметр("СписокИННЭквайринг", СписокИННЭквайринг);

ТЗ = Запрос.Выполнить().Выгрузить(); 
ВыгрузкаПлатежи.Очистить();

Для Каждого Строка Из ТЗ Цикл
	НоваяСтрока = ВыгрузкаПлатежи.Добавить();		
	ЗаполнитьЗначенияСвойств(НоваяСтрока, Строка);
	
	УстановитьСуммыПлатежейТолькоПросмотр(НоваяСтрока, Строка);
КонецЦикла;

ВыгрузкаПлатежи.Сортировать("ДатаЗагрузки, ДатаПлатежа, КонтрагентИННЗагрузка,  КонтрагентКППЗагрузка, СуммаПлатежа");

Если ВыгрузкаПлатежи.Количество() = 0 Тогда
	ВыгрузкаПлатежиГУИД_Текущий = Неопределено;	
КонецЕсли;
КонецПроцедуры

&НаСервере
Процедура УстановитьСуммыПлатежейТолькоПросмотр(НоваяСтрока, Строка)
Для Каждого СтрокаНастройки Из БезналНастройкиРаспределениеПлатежей Цикл
	ИмяРеквизита = СтрокаНастройки.ИмяРеквизитаФормы + "_ТолькоПросмотр";
	Если Строка.ПолучательПлатежа = ПолучательПлатежа_Смешанный Тогда
		НоваяСтрока[ИмяРеквизита] = Ложь;
	ИначеЕсли Строка.ПолучательПлатежа = ПолучательПлатежа_Константа Тогда
		НоваяСтрока[ИмяРеквизита] = Истина;
	Иначе
		Если Строка.ПолучательПлатежа = СтрокаНастройки.ПолучательПлатежаЗначениеСпискаВыбора Тогда
			НоваяСтрока[ИмяРеквизита] = Ложь;
		Иначе		
			НоваяСтрока[ИмяРеквизита] = Истина;
		КонецЕсли;	
	КонецЕсли;	
КонецЦикла;
	
КонецПроцедуры
//

&НаКлиенте
Процедура ВыгрузкаПлатежиПриАктивизацииСтроки(Элемент)
Если Элемент.ТекущиеДанные = Неопределено Тогда	
	ВыгрузкаПлатежиГУИД_Текущий = Неопределено;
Иначе
	ВыгрузкаПлатежиГУИД_Текущий = Элемент.ТекущиеДанные.ГУИД;
КонецЕсли;
КонецПроцедуры

//
&НаКлиенте
Процедура ВыгрузкаПлатежиПередНачаломДобавления(Элемент, Отказ, Копирование, Родитель, Группа, Параметр)
Отказ = Истина;
КонецПроцедуры

&НаКлиенте
Процедура ВыгрузкаПлатежиПередУдалением(Элемент, Отказ)
Отказ = Истина;
КонецПроцедуры
//

//
&НаКлиенте
Процедура ВыгрузкаПлатежиПередНачаломИзменения(Элемент, Отказ)
ТД = Элемент.ТекущиеДанные;	
ЗапомнитьOldValueПередНачаломИзменения(ТД);		

ПолучательПлатежа_OldValue = ТД.ПолучательПлатежа;	
КонецПроцедуры

&НаКлиенте
Процедура ЗапомнитьOldValueПередНачаломИзменения(ТД)
Для Каждого Строка Из БезналНастройкиРаспределениеПлатежей Цикл
	ТД[Строка.ИмяРеквизитаФормы + "_OldValue"] = ТД[Строка.ИмяРеквизитаФормы]; 
КонецЦикла;		
КонецПроцедуры
//

//
&НаКлиенте
Процедура ВыгрузкаОтменитьВосстановитьПлатежи(Команда)
Для Каждого Строка Из Элементы.ВыгрузкаПлатежи.ВыделенныеСтроки Цикл
	ТС = Строка;	
	
	ТекстОшибки = ВыгрузкаУдалитьДокументОплатыНаСервере(ТС, "ОТМЕНЫ ПЛАТЕЖА");
	Если ТекстОшибки.Количество() > 0 Тогда 
		ТекстСообщения = "";
		Для Каждого Элемент Из ТекстОшибки Цикл 
		    ТекстСообщения = ТекстСообщения + Элемент; 
		КонецЦикла;
		
		Сообщить(ТекстСообщения);
		Продолжить; 
	КонецЕсли; 

	ВыгрузкаОтменитьВосстановитьПлатежНаСервере(ТС);	
КонецЦикла;
КонецПроцедуры

&НаКлиенте
Процедура ВыгрузкаОтменитьВосстановитьПлатеж(Команда)
ТС = Элементы.ВыгрузкаПлатежи.ТекущаяСтрока;	
Если ТС = Неопределено Тогда Возврат; КонецЕсли;   

ТекстОшибки = ВыгрузкаУдалитьДокументОплатыНаСервере(ТС, "ОТМЕНЫ ПЛАТЕЖА");
Если ТекстОшибки.Количество() > 0 Тогда 
	ТекстПредупреждения = "";
	Для Каждого Элемент Из ТекстОшибки Цикл 
	    ТекстПредупреждения = ТекстПредупреждения + Элемент + Символы.ПС; 
	КонецЦикла;
	ТекстПредупреждения = Лев(ТекстПредупреждения, СтрДлина(ТекстПредупреждения) - 1);
	
	ПоказатьПредупреждение(, ТекстПредупреждения);
	Возврат; 
КонецЕсли; 

ВыгрузкаОтменитьВосстановитьПлатежНаСервере(ТС);
КонецПроцедуры

&НаСервере
Процедура ВыгрузкаОтменитьВосстановитьПлатежНаСервере(ТС)
ТД = ВыгрузкаПлатежи.НайтиПоИдентификатору(ТС);

ОтменитьВосстановитьПлатеж(ТД);
КонецПроцедуры

&НаСервере
Процедура ОтменитьВосстановитьПлатеж(ТД)
Запись = РегистрыСведений.БезналЗагрузка.СоздатьМенеджерЗаписи();
Запись.ГУИД = ТД.ГУИД;
Запись.Прочитать();

Запись.Отменено = НЕ Запись.Отменено; 
Запись.Записать();

ТД.Отменено = Запись.Отменено;
КонецПроцедуры
//


//
&НаКлиенте
Процедура ВыгрузкаСоздатьДокументыОплаты(Команда)
Для Каждого ТС Из Элементы.ВыгрузкаПлатежи.ВыделенныеСтроки Цикл
	ВыгрузкаДокументОплатыСоздатьНаСервере(ТС);
КонецЦикла;
КонецПроцедуры

&НаКлиенте
Процедура ВыгрузкаДокументОплатыСоздать(Команда)
ТС = Элементы.ВыгрузкаПлатежи.ТекущаяСтрока;
Если ТС = Неопределено Тогда Возврат; КонецЕсли;	
	
ВыгрузкаДокументОплатыСоздатьНаСервере(ТС);
КонецПроцедуры

&НаСервере
Процедура ВыгрузкаДокументОплатыСоздатьНаСервере(ТС)
Строка = ВыгрузкаПлатежи.НайтиПоИдентификатору(ТС);	

ВыгрузкаДокументОплатыСоздатьДокумент(Строка);
КонецПроцедуры

&НаСервере
Процедура ВыгрузкаДокументОплатыСоздатьДокумент(Строка)
Если ЗначениеЗаполнено(Строка.ДокументОплаты) Тогда Возврат; КонецЕсли;

Если Строка.Отменено Тогда 
	//ТекстСообщения = "Платеж от " + Строка.ДатаПлатежа + " на сумму " + Строка.СуммаПлатежа  + " отменен. " 
	
	ТекстСообщения = ПлатежТекст(Строка);  
	ТекстСообщения = ТекстСообщения 
		+ Строка.КонтрагентНаименованиеЗагрузка 
		+ " с ИНН: " + Строка.КонтрагентИННЗагрузка 
		+ ". Документ оплаты НЕ создан.";
		
	Сообщить(ТекстСообщения);
	
	Возврат; 
КонецЕсли;

Если Строка.ПолучательПлатежа = "" Тогда 
	//ТекстСообщения = "Платеж от " + Строка.ДатаПлатежа + " на сумму " + Строка.СуммаПлатежа + ". "
		
	ТекстСообщения = ПлатежТекст(Строка);  
	ТекстСообщения = ТекстСообщения 
		+ "Не заполнен ПолучательПлатежа." + Строка.КонтрагентНаименованиеЗагрузка 
		+ " с ИНН: " + Строка.КонтрагентИННЗагрузка 
		+ ". Документ оплаты НЕ создан.";
		
	Сообщить(ТекстСообщения);
	
	Возврат; 
КонецЕсли;

ПолучательПлатежаБезналКонстанта = Константы.ПолучательПлатежаБезнал.Получить();	
Если НЕ (Строка.ПолучательПлатежа = ПолучательПлатежаБезналКонстанта  
ИЛИ	 Строка.ПолучательПлатежа = ПолучательПлатежа_Смешанный) Тогда
	//ТекстСообщения = "Платеж от " + Строка.ДатаПлатежа + " на сумму " + Строка.СуммаПлатежа + ". "
	
	ТекстСообщения = ПлатежТекст(Строка);  
	ТекстСообщения = ТекстСообщения 
		+ "ПолучательПлатежа." + Строка.КонтрагентНаименованиеЗагрузка 
		+ " с ИНН: " + Строка.КонтрагентИННЗагрузка + " не равен " + ПолучательПлатежаБезналКонстанта
		+ ". Документ оплаты НЕ создан.";
		
	Сообщить(ТекстСообщения);
	
	Возврат; 
КонецЕсли;
	
Запрос = Новый Запрос("ВЫБРАТЬ
                      |	Клиенты.Ссылка КАК Ссылка
                      |ИЗ
                      |	Справочник.Клиенты КАК Клиенты
                      |ГДЕ
                      |	Клиенты.ПометкаУдаления = ЛОЖЬ
                      |	И Клиенты.ТипКлиента = ЗНАЧЕНИЕ(Перечисление.ТипыКлиентов.ЮрЛицо)
                      |	И Клиенты.ИНН = &ИНН
                      |	И Клиенты.ИНН <> """"");

Запрос.УстановитьПараметр("ИНН", Строка.КонтрагентИННЗагрузка); 
ТЗ = Запрос.Выполнить().Выгрузить();

КоличествоКонтрагентов = ТЗ.Количество();

Если КоличествоКонтрагентов = 0 Тогда 
	//ТекстСообщения = "Платеж от " + Строка.ДатаПлатежа + " на сумму " + Строка.СуммаПлатежа + ". "
	
	ТекстСообщения = ПлатежТекст(Строка);  
	ТекстСообщения = ТекстСообщения 
		+ "В базе отсутствует контрагент: " + Строка.КонтрагентНаименованиеЗагрузка 
		+ " с ИНН: " + Строка.КонтрагентИННЗагрузка 
		+ ". Документ оплаты НЕ создан.";
		
	Сообщить(ТекстСообщения);
	Возврат; 
КонецЕсли;

Если КоличествоКонтрагентов > 1 Тогда 
	//ТекстСообщения = "Платеж от " + Строка.ДатаПлатежа + " на сумму " + Строка.СуммаПлатежа + ". "
	
	ТекстСообщения = ПлатежТекст(Строка);  
	ТекстСообщения = ТекстСообщения 
		+ "В базе есть несколько контрагентов (" + КоличествоКонтрагентов + ") с ИНН: " + Строка.КонтрагентИННЗагрузка 
		+ ". Наименование (загрузка): " + Строка.КонтрагентНаименованиеЗагрузка
		+ ". Документ оплаты НЕ создан.";
		
	Сообщить(ТекстСообщения);
	Возврат; 
КонецЕсли;

ВыпискаОбъект = Документы.ВыпискаБанка.СоздатьДокумент();		
ВыпискаОбъект.Дата = ТекущаяДата();

ВыпискаОбъект.ГУИДИсточникЗагрузка = Строка.ГУИДИсточникаСтрока;	
ВыпискаОбъект.ГУИДЗагрузка = Строка.ГУИД;	

ВыпискаОбъект.ДатаОплаты = Строка.ДатаПлатежа;

ВыпискаОбъект.ОтКого = ТЗ[0].Ссылка;

ВыпискаОбъект.Приход = Истина;
ВыпискаОбъект.ЭтоЭквайринг = Ложь;

Если Строка.ПолучательПлатежа = ПолучательПлатежа_Смешанный Тогда 
	ОтборСтроки = Новый Структура("ПолучательПлатежаЗначениеСпискаВыбора", ПолучательПлатежаБезналКонстанта);
	НайденныеСтроки = БезналНастройкиРаспределениеПлатежей.НайтиСтроки(ОтборСтроки);
	ИмяРеквизита = НайденныеСтроки[0].ИмяРеквизитаФормы;
	СуммаПлатежа = Строка[ИмяРеквизита];
Иначе
	СуммаПлатежа = Строка.СуммаПлатежа;
КонецЕсли;

ВыпискаОбъект.Сумма = СуммаПлатежа;

ВыпискаОбъект.ТекстПлатежа = Строка.ТекстПлатежа;

ВыпискаОбъект.Записать(РежимЗаписиДокумента.Проведение);

Строка.ДокументОплаты = ВыпискаОбъект.Ссылка;
Строка.СуммаДокументОплаты = ВыпискаОбъект.Сумма;
КонецПроцедуры
//

&НаКлиентеНаСервереБезКонтекста
Функция ПлатежТекст(Строка)
ПлатежТекст = "Платеж от " + Формат(Строка.ДатаПлатежа, "ДФ=dd.MM.yy") + " на сумму " + Строка.СуммаПлатежа + ". ";

Возврат ПлатежТекст;
КонецФункции

//
&НаКлиенте
Процедура ВыгрузкаУдалитьДокументОплаты(Команда)
ТС = Элементы.ВыгрузкаПлатежи.ТекущаяСтрока;
Если ТС = Неопределено Тогда Возврат; КонецЕсли;

ТекстОшибки = ВыгрузкаУдалитьДокументОплатыНаСервере(ТС, "УДАЛЕНИЯ ОПЛАТЫ");
Если ТекстОшибки.Количество() > 0 Тогда 
	ТекстПредупреждения = "";
	Для Каждого Элемент Из ТекстОшибки Цикл 
	    ТекстПредупреждения = ТекстПредупреждения + Элемент + Символы.ПС; 
	КонецЦикла;
	ТекстПредупреждения = Лев(ТекстПредупреждения, СтрДлина(ТекстПредупреждения) - 1);
	
	ПоказатьПредупреждение(, ТекстПредупреждения);
КонецЕсли;
КонецПроцедуры

&НаСервере
Функция ВыгрузкаУдалитьДокументОплатыНаСервере(ТС, ТекстСообщения)
ТД = ВыгрузкаПлатежи.НайтиПоИдентификатору(ТС);

ТекстОшибки = Новый Массив;

ДокументОплаты = ТД.ДокументОплаты;
Если НЕ ЗначениеЗаполнено(ДокументОплаты) Тогда Возврат ТекстОшибки; КонецЕсли;
	
ЕстьСвязиСДокументДолги = ЕстьСвязиДокументаОплатыСДокументДолги(ДокументОплаты);

Если ЕстьСвязиСДокументДолги  Тогда
	//ТекстОшибки.Добавить("Платеж от " + ТД.ДатаПлатежа + " на сумму " + ТД.СуммаПлатежа + ". ");
	
	Текст = ПлатежТекст(ТД);
	ТекстОшибки.Добавить(Текст);
	
	ТекстОшибки.Добавить("Есть документ оплаты, связанный с документом долга. ");
	ТекстОшибки.Добавить("");
	ТекстОшибки.Добавить("ДЛЯ " + ТекстСообщения + " УДАЛИТЕ СВЯЗЬ ДОКУМЕНТА ОПЛАТЫ С ДОКУМЕНТОМ ДОЛГА ...");	
	
	Возврат ТекстОшибки;
КонецЕсли;

ДокументОплатыОбъект = ДокументОплаты.ПолучитьОбъект();
ДокументОплатыОбъект.Удалить();       

ТД.ДокументОплаты = Неопределено;
ТД.СуммаДокументОплаты = 0;

Возврат ТекстОшибки;
КонецФункции

&НаСервере
Функция ЕстьСвязиДокументаОплатыСДокументДолги(ДокументОплаты)
Запрос = Новый Запрос( "ВЫБРАТЬ ПЕРВЫЕ 1
                       |	ЗаявкаНаБронированиеСчетаДетальноОплаты.Ссылка КАК Ссылка
                       |ИЗ
                       |	Документ.ЗаявкаНаБронирование.СчетаДетальноОплаты КАК ЗаявкаНаБронированиеСчетаДетальноОплаты
                       |ГДЕ
                       |	ЗаявкаНаБронированиеСчетаДетальноОплаты.ДокументОплаты = &ДокументОплаты
                       |
                       |ОБЪЕДИНИТЬ
                       |
                       |ВЫБРАТЬ ПЕРВЫЕ 1
                       |	ГрупповыеСчетаДокументыОплаты.Ссылка
                       |ИЗ
                       |	Документ.ГрупповыеСчета.ДокументыОплаты КАК ГрупповыеСчетаДокументыОплаты
                       |ГДЕ
                       |	ГрупповыеСчетаДокументыОплаты.ДокументОплаты = &ДокументОплаты
                       |
                       |ОБЪЕДИНИТЬ
                       |
                       |ВЫБРАТЬ ПЕРВЫЕ 1
                       |	КоворкингСчетаДокументыОплаты.Ссылка
                       |ИЗ
                       |	Документ.КоворкингСчета.ДокументыОплаты КАК КоворкингСчетаДокументыОплаты
                       |ГДЕ
                       |	КоворкингСчетаДокументыОплаты.ДокументОплаты = &ДокументОплаты");

Запрос.УстановитьПараметр("ДокументОплаты", ДокументОплаты);
ТЗ = Запрос.Выполнить().Выгрузить();
Возврат (ТЗ.Количество() > 0);
КонецФункции
