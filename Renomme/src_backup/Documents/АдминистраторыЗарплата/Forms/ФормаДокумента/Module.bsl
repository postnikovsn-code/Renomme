		ТД[Имя_П] = 0; 
		ТД["СуммаЗаселенийСтритАрт_" + Дата_И] = 0;
		
		ТД["Часы_" + Дата_И] = "00-0/00";
		
		Перейти ~ВЫХОД;;
	КонецЕсли;
	
	Если НомерСмены = 4 Тогда	
		//ТД["Оклад_" + Дата_И] = СтавкаЗаОтпуск(ТД.Администратор); 
		ТД["Оклад_" + Дата_И] = 0; 
		Имя_П = "Оклад_" + Дата_И + "_Р";
		ТД[Имя_П] = 0; 
		Имя_П = "Оклад_" + Дата_И + "_Есть";
		ТД[Имя_П] = Ложь; 
		ТД["Оклад_" + Дата_И + "_Э"] = ТД["Оклад_" + Дата_И];
		
		ТД["Часы_" + Дата_И] = "00-0/00";
		
		Перейти ~ВЫХОД;;
	КонецЕсли;
	
	
	//Если СокрЛП(ТД.Администратор.Наименование) = "Помыткина Анастасия" Тогда 
	//	 ш = 1;
	//КонецЕсли;
	
	ДатаВремяСмена = Документы.АдминистраторыЗарплата.ДатаВремяСмена(ДатаСмены, НомерСмены, ДлинаСмены, ПереработкаЧасы);
	ДатаВремяС = ДатаВремяСмена.ДатаВремяС;
	ДатаВремяПо = ДатаВремяСмена.ДатаВремяПо;

	ОкладЗаСмену = ОкладЗаСмену(ТД.Администратор, ДлинаСмены);
	Имя_П = "Оклад_" + Дата_И;
	ТД[Имя_П] = ОкладЗаСмену; 

	Если ТД["Оклад_" + Дата_И + "_Есть"] Тогда
		Оклад = ТД["Оклад_" + Дата_И + "_Р"];
	Иначе
