							|
							|ИЗМЕНЕНИЕ НЕ РАЗРЕШЕНО ...");
	
	ТД.ЭтоПредварительныйГрупповойСчет = ЭтоПредварительныйГрупповойСчет_OldValue;
	Возврат; 
КонецЕсли;

ОтборСтроки = Новый Структура("СчетГУИД", ТД.СчетГУИД);
НайденныеСтроки = Объект.РаспределениеОплатДолги.НайтиСтроки(ОтборСтроки);
Если НайденныеСтроки.Количество() > 0 Тогда
	ПоказатьПредупреждение(, "Счет оплачен
							|
							|ИЗМЕНЕНИЕ НЕ РАЗРЕШЕНО.
							|
							|Для изменения контрагента удалите оплаты счета ...");
	
	ТД.ЭтоПредварительныйГрупповойСчет = ЭтоПредварительныйГрупповойСчет_OldValue;
	Возврат; 
КонецЕсли;
