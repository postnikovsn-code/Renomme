КонецФункции
//

&НаКлиенте
Функция ПроверкаУстановкиПометкаУдаления_НеИспользуется()
Если ЗначениеЗаполнено(Объект.Ссылка) Тогда
	Если Объект.ПометкаУдаления Тогда
		Если Объект.ДокументыОплаты.Количество() > 0 Тогда 
			ПоказатьПредупреждение(,"У счета есть оплаты.
			|
			|Пометка удаления НЕ разрешена.
			|
			|ДОКУМЕНТ НЕ СОХРАНЕН !
			|
			|Для установки пометки удаления удалите оплаты");
			
			Сообщить("У счета есть оплаты. Пометка удаления НЕ разрешена. ДОКУМЕНТ НЕ СОХРАНЕН !");
			
			Возврат Истина;
		КонецЕсли;
	КонецЕсли;
КонецЕсли;

Возврат Ложь;
КонецФункции
//
&НаКлиенте
Процедура ДатаСПриИзменении(Элемент)
Если НЕ ЗначениеЗаполнено(Объект.ДатаС) Тогда Возврат; КонецЕсли;
	
Если НЕ ЗначениеЗаполнено(Объект.ДатаПо) Тогда
	ПериодАренды = ОбщийФункционалСервер.ЗначениеРеквизитаНаСервере(Объект.КоворкингЗаявка, "ПериодАренды");
	ДатаПо = КоворкингСервер.СчетДатаПо(Объект.ДатаС, ПериодАренды);
	Объект.ДатаПо = ДатаПо;
КонецЕсли;

КонтрольДаты("ДатаС", "Дата С");
КонецПроцедуры

&НаКлиенте
Процедура ДатаПоПриИзменении(Элемент)
КонтрольДаты("ДатаПо", "Дата По")
КонецПроцедуры

&НаКлиенте
Процедура КонтрольДаты(ДатаИмяРеквизита, ДатаНаименованиеРеквизита)
Если НЕ (ЗначениеЗаполнено(Объект.ДатаС) И ЗначениеЗаполнено(Объект.ДатаПо)) Тогда 
	ЗавершениеВопроса_РасчетнаяДатаНеРавноДатаПоСчета(КодВозвратаДиалога.Отмена, Неопределено);
	
	Возврат; 
КонецЕсли;

Если Объект.ДатаС > Объект.ДатаПо Тогда 
	ПоказатьПредупреждение(, "'Дата С' БОЛЬШЕ 'Дата По'
		|
		|ИЗМЕНЕНИЕ НЕ РАЗРЕШЕНО ...");
	
	Дата_OldValue = ОбщийФункционалСервер.ЗначениеРеквизитаНаСервере(Объект.Ссылка, ДатаИмяРеквизита);
	Объект[ДатаИмяРеквизита] = Дата_OldValue;
	
	//ЗавершениеВопроса_РасчетнаяДатаНеРавноДатаПоСчета(КодВозвратаДиалога.Отмена, Неопределено);
	
	Возврат; 
КонецЕсли;

Если КоворкингСервер.ЕстьОплатыСчет(Объект.Ссылка) Тогда
	ПоказатьПредупреждение(, "Есть оплаты счета.
		|
		|ИЗМЕНЕНИЕ НЕ РАЗРЕШЕНО ...
		|
		|Для изменения " + ДатаНаименованиеРеквизита + " удалите оплаты.");
	
	Дата_OldValue = ОбщийФункционалСервер.ЗначениеРеквизитаНаСервере(Объект.Ссылка, ДатаИмяРеквизита);
	Объект[ДатаИмяРеквизита] = Дата_OldValue;
	
	//ЗавершениеВопроса_РасчетнаяДатаНеРавноДатаПоСчета(КодВозвратаДиалога.Отмена, Неопределено);
	
	Возврат;
		
КонецЕсли;	

// + Аудит
ПериодАренды_П = ОбщийФункционалСервер.ЗначениеРеквизитаНаСервере(Объект.КоворкингЗаявка, "ПериодАренды");
Если ПериодАренды_П = "ЧАС"
И Объект.ДатаС <> Объект.ДатаПо 
Тогда 
	ПоказатьПредупреждение(, "'Дата С' = 'Дата По' для периода аренды 'ЧАС'
		|
		|ИЗМЕНЕНИЕ НЕ РАЗРЕШЕНО ...");
	
	Дата_OldValue = ОбщийФункционалСервер.ЗначениеРеквизитаНаСервере(Объект.Ссылка, ДатаИмяРеквизита);
	Объект[ДатаИмяРеквизита] = Дата_OldValue;
	
	//ЗавершениеВопроса_РасчетнаяДатаНеРавноДатаПоСчета(КодВозвратаДиалога.Отмена, Неопределено);
	
	Возврат; 
КонецЕсли;
// - Аудит

ПериодАренды = ОбщийФункционалСервер.ЗначениеРеквизитаНаСервере(Объект.КоворкингЗаявка, "ПериодАренды");
СчетДатаПо = КоворкингСервер.СчетДатаПо(Объект.ДатаС, ПериодАренды);
Если СчетДатаПо <> Объект.ДатаПо Тогда 
	
	Оповещение = Новый ОписаниеОповещения("ЗавершениеВопроса_РасчетнаяДатаНеРавноДатаПоСчета", ЭтаФорма);
	ПоказатьВопрос(Оповещение, "Период аренды: " + ПериодАренды + "
					|Расчетная дата По: " + Формат(СчетДатаПо, "ДФ=dd.MM.yyyy") + " НЕ РАВНА 'Дата по' счета: " + Формат(Объект.ДатаПо, "ДФ=dd.MM.yyyy") + "
					|
					|ПРОДОЛЖИТЬ ? "
					,РежимДиалогаВопрос.ОКОтмена);
					
	Возврат;
КонецЕсли;

ЗавершениеВопроса_РасчетнаяДатаНеРавноДатаПоСчета(КодВозвратаДиалога.ОК, Неопределено);
КонецПроцедуры

&НаКлиенте
Процедура ЗавершениеВопроса_РасчетнаяДатаНеРавноДатаПоСчета(Результат, ДополнительныеПараметры) Экспорт
Если Результат = КодВозвратаДиалога.Отмена Тогда 
	Объект.КоличествоЕдиниц = 0; 
	Объект.Количество = 0; 
	Объект.Сумма = 0;

	Возврат; 
КонецЕсли;	

СчетСуммаКоличествоДни();
КонецПроцедуры

&НаСервере
Процедура СчетСуммаКоличествоДни()
Если Объект.КоворкингЗаявка.ПериодАренды = "МЕСЯЦ" Тогда
		
	МесяцС = Месяц(Объект.ДатаС);
	МесяцПо = Месяц(Объект.ДатаПо);
			
	ГодС = Год(Объект.ДатаС);
	ГодПо = Год(Объект.ДатаПо);
	
	ДеньС = День(Объект.ДатаС);
	ДеньПо = День(Объект.ДатаПо);
	
	КоличествоМесяцев = (ГодПо - ГодС)*12 + (МесяцПо - МесяцС);
	Если ДеньПо >= ДеньС Тогда КоличествоМесяцев = КоличествоМесяцев + 1; КонецЕсли; 
	
	КоворкингСервер.ЗаполнитьСрокиАренды(Объект.СрокиАренды, Объект.ДатаС, Объект.ДатаПо);
	
	РазницаВДнях = (НачалоДня(Объект.ДатаПо) - НачалоДня(Объект.ДатаС)) / (60 * 60 * 24) + 1;
	Объект.КоличествоЕдиниц = РазницаВДнях;
	
	Объект.Количество = КоличествоМесяцев;
	Объект.Сумма = Объект.Количество * Объект.Цена;
	
ИначеЕсли Объект.КоворкингЗаявка.ПериодАренды = "НЕДЕЛЯ" Тогда	
	РазницаВДнях = (НачалоДня(Объект.ДатаПо) - НачалоДня(Объект.ДатаС)) / (60 * 60 * 24) + 1;
	Объект.КоличествоЕдиниц = РазницаВДнях;
	
	КоличествоНедель = Цел((РазницаВДнях - 1) / 7) + 1; 
		
	Объект.Количество = КоличествоНедель;
	Объект.Сумма = Объект.Количество * Объект.Цена;
	
ИначеЕсли Объект.КоворкингЗаявка.ПериодАренды = "ДЕНЬ" Тогда	
	РазницаВДнях = (НачалоДня(Объект.ДатаПо) - НачалоДня(Объект.ДатаС)) / (60 * 60 * 24) + 1;
	
	//Объект.КоличествоЕдиниц = 1;
	//Объект.Количество = 1;
	
	Объект.КоличествоЕдиниц = РазницаВДнях;
	Объект.Количество = РазницаВДнях;
	
	Объект.Сумма = Объект.Количество * Объект.Цена;
КонецЕсли;	
КонецПроцедуры

&НаСервере
Процедура СчетСуммаКоличество_Вариант()
//Если Объект.КоворкингЗаявка.ПериодАренды = "МЕСЯЦ" Тогда	
	ДеньС = День(Объект.ДатаС);
	ДеньПо = День(Объект.ДатаПо);   

	МесяцС = Месяц(Объект.ДатаС);
	МесяцПо = Месяц(Объект.ДатаПо);
	
	ГодС = Год(Объект.ДатаС);
	ГодПо = Год(Объект.ДатаПо);

	Год_П = ГодС;
	Месяц_П = МесяцС;
	Сумма = 0;
	
	ДлинаПериода = (НачалоДня(КонецМесяца(Объект.ДатаС)) - НачалоДня(НачалоМесяца(Объект.ДатаС))) / (60 * 60 * 24) + 1;
	ЦенаЗаДень = Объект.Цена / ДлинаПериода;

	Пока Истина Цикл
		ДеньС_П = ?(Месяц_П = МесяцС, ДеньС, 1);
		ДеньПо_П = ?(Месяц_П = МесяцПо, ДеньПо, День(КонецМесяца(Дата(Год_П, Месяц_П, 1))));
		
		ДатаС_П = Дата(Год_П, Месяц_П, ДеньС_П); 
		ДатаПо_П = Дата(Год_П, Месяц_П, ДеньПо_П); 
		Если ДатаПо_П > Объект.ДатаПо Тогда Прервать; КонецЕсли; 
		
		//ДлинаПериода = (НачалоДня(КонецМесяца(ДатаПо_П)) - НачалоДня(НачалоМесяца(ДатаПо_П))) / (60 * 60 * 24) + 1;
