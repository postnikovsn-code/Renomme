Функция СуммаЭквайрингаСчет(Счет, ТЗ_Оплаты) Экспорт
СуммаЭквайрингаСчет = 0;
		
ТЗ_Услуги = Счет.ДопУслугиКоворкинг;

Для Каждого СтрокаОплаты Из ТЗ_Оплаты Цикл
	СуммаЭквайрингаСчет_Услуги = 0;
		
	Если НЕ СтрокаОплаты.ЭтоУслуга Тогда
		СуммаЭквайрингаСчет = СуммаЭквайрингаСчет + СуммаЭквайринга(СтрокаОплаты);			
		
	Иначе
		
		ОтборСтрокиУслуги = Новый Структура("ГУИД", СтрокаОплаты.ДолгиГУИД);
		НайденныеУслуги = ТЗ_Услуги.НайтиСтроки(ОтборСтрокиУслуги);
		Для Каждого СтрокаУслуга Из НайденныеУслуги Цикл
			Результат = Справочники.ДопУслуги.ПустаяСсылка();
			Ссылка = СтрокаУслуга.Услуга; 
			ОбщийФункционалСервер.ВерхняяПапка(Ссылка, Результат);
			
			СуммаЭквайрингаСчет_Услуги = СуммаЭквайрингаСчет_Услуги + СуммаЭквайринга(СтрокаОплаты);			
		КонецЦикла;
	КонецЕсли;		
	
	СуммаЭквайрингаСчет = СуммаЭквайрингаСчет + СуммаЭквайрингаСчет_Услуги;
КонецЦикла;
		
Возврат СуммаЭквайрингаСчет;		
КонецФункции

Функция ТЗ_ОплатыСчет(Счет) Экспорт
Запрос = Новый Запрос("ВЫБРАТЬ
                      |	КоворкингСчетаРаспределениеОплатКоворкинг.Ссылка КАК Заявка,
                      |	КоворкингСчетаРаспределениеОплатКоворкинг.ДокументОплаты КАК ДокументОплаты,
                      |	КоворкингСчетаРаспределениеОплатКоворкинг.ЭтоУслуга КАК ЭтоУслуга,
                      |	КоворкингСчетаРаспределениеОплатКоворкинг.ГУИДДолги КАК ДолгиГУИД,
                      |	КоворкингСчетаРаспределениеОплатКоворкинг.СуммаОплаты КАК СуммаОплаты,
                      |	КоворкингСчетаРаспределениеОплатКоворкинг.ДокументОплаты.ДатаОплаты КАК ДокументОплатыДатаОплаты,
                      |	КоворкингСчетаРаспределениеОплатКоворкинг.ДокументОплаты.Номер КАК НомерДокументаОплаты,
                      |	КоворкингСчетаРаспределениеОплатКоворкинг.ДокументОплаты.Дата КАК ДатаДокументаОплаты,
                      |	ЕСТЬNULL(КоворкингСчетаРаспределениеОплатКоворкинг.ДокументОплаты.Сумма, 0) КАК СуммаДокументаОплаты,
                      |	КоворкингСчетаРаспределениеОплатКоворкинг.ДокументОплаты.ОтКого КАК ДокументаОплатыОтКого,
                      |	ВЫБОР
                      |		КОГДА КоворкингСчетаРаспределениеОплатКоворкинг.ДокументОплаты.ОтКого.ТипКлиента = ЗНАЧЕНИЕ(Перечисление.ТипыКлиентов.ЮрЛицо)
                      |			ТОГДА КоворкингСчетаРаспределениеОплатКоворкинг.ДокументОплаты.ОтКого.НаименованиеЮрЛица
                      |		ИНАЧЕ КоворкингСчетаРаспределениеОплатКоворкинг.ДокументОплаты.ОтКого.Наименование
                      |	КОНЕЦ КАК КонтрагентНаименование,
                      |	ВЫБОР
                      |		КОГДА ТИПЗНАЧЕНИЯ(КоворкингСчетаРаспределениеОплатКоворкинг.ДокументОплаты) = ТИП(Документ.КассовыйДокумент)
                      |			ТОГДА КоворкингСчетаРаспределениеОплатКоворкинг.ДокументОплаты.Сумма
                      |		ИНАЧЕ 0
                      |	КОНЕЦ КАК СуммаДокументаОплатыКасса,
                      |	ВЫБОР
                      |		КОГДА ТИПЗНАЧЕНИЯ(КоворкингСчетаРаспределениеОплатКоворкинг.ДокументОплаты) = ТИП(Документ.КассовыйДокумент)
                      |			ТОГДА КоворкингСчетаРаспределениеОплатКоворкинг.ДокументОплаты.СуммаНаличные
                      |		ИНАЧЕ 0
                      |	КОНЕЦ КАК СуммаДокументаОплатыНаличные,
                      |	ВЫБОР
                      |		КОГДА ТИПЗНАЧЕНИЯ(КоворкингСчетаРаспределениеОплатКоворкинг.ДокументОплаты) = ТИП(Документ.КассовыйДокумент)
                      |			ТОГДА КоворкингСчетаРаспределениеОплатКоворкинг.ДокументОплаты.СуммаКарта
                      |		ИНАЧЕ 0
                      |	КОНЕЦ КАК СуммаДокументаОплатыКарта,
                      |	ВЫБОР
                      |		КОГДА ТИПЗНАЧЕНИЯ(КоворкингСчетаРаспределениеОплатКоворкинг.ДокументОплаты) = ТИП(Документ.ВыпискаБанка)
