&НаСервере
Процедура ЗагрузитьЗаселенияНаСервере(ЗаселенияИмя, Данные)
Заселения = ЭтаФорма[ЗаселенияИмя];
Заселения.Очистить();

Если ЗаселенияИмя = "ЗаселенияВЛайв" Тогда
	ИмяРеквизита = "АдминистраторКодЛайв";
ИначеЕсли ЗаселенияИмя = "ЗаселенияВДомСоветов" Тогда
	ИмяРеквизита = "АдминистраторКодДомСоветов";
ИначеЕсли ЗаселенияИмя = "ЗаселенияВСтритАрт" Тогда
	ИмяРеквизита = "АдминистраторКодСтритАрт";
Иначе
	Возврат;
КонецЕсли;

Для Каждого Строка Из Данные Цикл
	АдминистраторКод = Строка.АвторЗаявкиКод;
	АдминистраторКод = СокрЛП(АдминистраторКод);
	
	Администратор = Справочники.Администраторы.НайтиПоРеквизиту(ИмяРеквизита, АдминистраторКод);
	
	ДатаВремя = Строка.ВремяЗаезда;
	
	// 0001.01.01Т01:01:01
	// 1234567890123456789
	Год = Число(Сред(ДатаВремя, 1, 4));
	Месяц = Число(Сред(ДатаВремя, 6, 2));
	День = Число(Сред(ДатаВремя, 9, 2));
	Час = Число(Сред(ДатаВремя, 12, 2));
	Минута = Число(Сред(ДатаВремя, 15, 2));
	Секунда = Число(Сред(ДатаВремя, 18, 2));
	
	ДатаВремя = Дата(Год, Месяц, День, Час, Минута, Секунда);  
	
	НоваяСтрока = Заселения.Добавить();
	НоваяСтрока.ДатаВремя = ДатаВремя;
	
	НоваяСтрока.Администратор = Администратор;
	НоваяСтрока.АдминистраторКодОбмен = Строка.АвторЗаявкиКод;
КонецЦикла;
КонецПроцедуры

