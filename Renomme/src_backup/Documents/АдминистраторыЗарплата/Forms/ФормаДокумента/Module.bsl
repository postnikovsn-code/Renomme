&НаСервере    
Функция СуммаНадбавкаЗаСтаж(Строка)
Администратор = Строка.Администратор;	
ДатаПриема = Администратор.ДатаПриема; 	
Если НЕ ЗначениеЗаполнено(ДатаПриема) Тогда Возврат 0; КонецЕсли;
Если Администратор.НеНачислятьЗаСтаж Тогда Возврат 0; КонецЕсли;

Если АдминистраторыНадбавкаЗаСтаж.Количество() = 0 Тогда Возврат 0; КонецЕсли;

ДатаУчета = Объект.ДК;
РазницаВДнях = (НачалоДня(ДатаУчета) - НачалоДня(ДатаПриема)) / (60 * 60 * 24);

СуммаНадбавкаЗаСтажПолная = 0;
Для Каждого СтрокаНадбавкаЗаСтаж Из АдминистраторыНадбавкаЗаСтаж Цикл
	Если РазницаВДнях >= СтрокаНадбавкаЗаСтаж.РазницаВДняхС И РазницаВДнях < СтрокаНадбавкаЗаСтаж.РазницаВДняхПо Тогда
		 СуммаНадбавкаЗаСтажПолная = СтрокаНадбавкаЗаСтаж.Сумма;
		 
		 Прервать;
	КонецЕсли;
КонецЦикла;

//КоличествоРасчетныхДней = КоличествоРасчетныхДней(Строка); 
КоличествоРасчетныхДней = ((НачалоДня(Объект.ДК) - НачалоДня(Объект.ДН)) / (60 * 60 * 24)) + 1;

МесяцРасчета = Объект.ДН;
КоличествоДнейМесяц = День(КонецМесяца(МесяцРасчета));
СуммаНадбавкаЗаСтаж = Окр(СуммаНадбавкаЗаСтажПолная * КоличествоРасчетныхДней / КоличествоДнейМесяц);

Возврат СуммаНадбавкаЗаСтаж;
КонецФункции

