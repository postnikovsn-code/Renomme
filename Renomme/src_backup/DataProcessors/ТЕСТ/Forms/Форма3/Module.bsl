                      |ИЗ
                      |	Документ.ЗаявкаНаБронирование.Проживание КАК ЗаявкаНаБронированиеПроживание
                      |ГДЕ
                      |	ЗаявкаНаБронированиеПроживание.Ссылка.ПометкаУдаления = ЛОЖЬ
                      |	И ЗаявкаНаБронированиеПроживание.Ссылка.РезервС >= &НачалоРезервС
                      |	И ЗаявкаНаБронированиеПроживание.Ссылка.РезервС <= &ОкончаниеРезервС
                      |	И ЗаявкаНаБронированиеПроживание.Ссылка.Бронирует = &Бронирует
                      |
                      |СГРУППИРОВАТЬ ПО
                      |	ЗаявкаНаБронированиеПроживание.Ссылка,
                      |	ЗаявкаНаБронированиеПроживание.Ссылка.Клиент,
                      |	ЗаявкаНаБронированиеПроживание.Ссылка.РезервС,
                      |	ЗаявкаНаБронированиеПроживание.Ссылка.Оплачивает
                      |
                      |УПОРЯДОЧИТЬ ПО
                      |	РезервС,
                      |	Клиент");

Запрос.УстановитьПараметр("НачалоРезервС", НачалоДня(Дата('20220301')));
Запрос.УстановитьПараметр("ОкончаниеРезервС", НачалоДня(Дата('20220331')));

