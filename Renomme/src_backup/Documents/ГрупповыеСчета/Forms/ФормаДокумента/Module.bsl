&НаСервере
Процедура ЗагрузкаДеревоСчетДетально()
Запрос = Новый Запрос(	
"ВЫБРАТЬ
|	ЗаявкаДолги.Ссылка КАК ЗаявкаСсылка,
|	ЗаявкаДолги.Услуга КАК Услуга,
|	ЗаявкаДолги.ДатаДолг КАК ДатаДолг,
|	ЗаявкаДолги.НаименованиеДолг КАК НаименованиеДолг,
|	ЗаявкаДолги.Количество КАК Количество,
|	ЗаявкаДолги.Цена КАК Цена,
|	ЗаявкаДолги.СуммаДолг КАК СуммаДолг,
|	ЗаявкаДолги.НомерВРезерв КАК НомерВРезерв,
|	ЗаявкаДолги.Клиент КАК Клиент,
|	ЗаявкаДолги.ТолькоПроживание КАК ТолькоПроживание,
|	ЗаявкаДолги.ТолькоУслуги КАК ТолькоУслуги,
|	ЗаявкаДолги.НомерСчета КАК НомерСчета,
|	ЗаявкаДолги.ДатаСчета КАК ДатаСчета
|ИЗ
|	Документ.ГрупповыеСчета.ДокументыДолги КАК ГрупповыеСчетаДокументыДолги
|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
|			ЗаявкаНаБронированиеСчетаДетальноДолги.Ссылка КАК Ссылка,
|			ЗаявкаНаБронированиеСчетаДетальноДолги.СчетГУИД КАК СчетГУИД,
|			ЗаявкаНаБронированиеСчетаДетальноДолги.Услуга КАК Услуга,
|			ЗаявкаНаБронированиеСчетаДетальноДолги.ДатаДолг КАК ДатаДолг,
|			ЗаявкаНаБронированиеСчетаДетальноДолги.НаименованиеДолг КАК НаименованиеДолг,
|			ЗаявкаНаБронированиеСчетаДетальноДолги.Количество КАК Количество,
|			ЗаявкаНаБронированиеСчетаДетальноДолги.Цена КАК Цена,
|			ЗаявкаНаБронированиеСчетаДетальноДолги.СуммаДолг КАК СуммаДолг,
|			ЗаявкаНаБронированиеСчетаДетальноДолги.Ссылка.НомерВРезерв КАК НомерВРезерв,
|			ЗаявкаНаБронированиеСчетаДетальноДолги.Ссылка.Клиент КАК Клиент,
|			ЗаявкаНаБронированиеСчета.ТолькоПроживание КАК ТолькоПроживание,
|			ЗаявкаНаБронированиеСчета.ТолькоУслуги КАК ТолькоУслуги,
|			ЗаявкаНаБронированиеСчета.НомерСчета КАК НомерСчета,
|			ЗаявкаНаБронированиеСчета.ДатаСчета КАК ДатаСчета
|		ИЗ
|			Документ.ЗаявкаНаБронирование.СчетаДетальноДолги КАК ЗаявкаНаБронированиеСчетаДетальноДолги
|				ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.ЗаявкаНаБронирование.Счета КАК ЗаявкаНаБронированиеСчета
|				ПО ЗаявкаНаБронированиеСчетаДетальноДолги.Ссылка = ЗаявкаНаБронированиеСчета.Ссылка
|					И ЗаявкаНаБронированиеСчетаДетальноДолги.СчетГУИД = ЗаявкаНаБронированиеСчета.СчетГУИД) КАК ЗаявкаДолги
|		ПО ГрупповыеСчетаДокументыДолги.ДокументДолг = ЗаявкаДолги.Ссылка
|			И ГрупповыеСчетаДокументыДолги.СчетГУИД = ЗаявкаДолги.СчетГУИД
|ГДЕ
|	ГрупповыеСчетаДокументыДолги.Ссылка = &Ссылка
|
|УПОРЯДОЧИТЬ ПО
|	ЗаявкаСсылка,
|	Услуга,
|	ДатаДолг
|ИТОГИ
|	СУММА(СуммаДолг)
|ПО
|	ЗаявкаСсылка");

Запрос.УстановитьПараметр("Ссылка", Объект.Ссылка);

ДЗРезультат = Запрос.Выполнить().Выгрузить(ОбходРезультатаЗапроса.ПоГруппировкам);

ЗначениеВРеквизитФормы(ДЗРезультат,"ДеревоСчетДетально");

ДеревоЭлементы = ДеревоСчетДетально.ПолучитьЭлементы();
Для Каждого СтрокаДерева Из ДеревоЭлементы Цикл
	УзелСтроки = СтрокаДерева.ПолучитьЭлементы();
	Если НЕ ЗначениеЗаполнено(УзелСтроки[0].ЗаявкаСсылка) Тогда Продолжить; КонецЕсли;
	
	Клиент = УзелСтроки[0].Клиент;
	НомерВРезерв = УзелСтроки[0].НомерВРезерв;

	МассивКУдалению = Новый Массив;
	Если Объект.СвернутьВСчете Тогда 
		
		ДатаМин = Дата('30000101');
		ДатаМакс = Дата('00010101');
		
		КоличествоСуток = 0;
		Для Каждого СтрокаУзла Из УзелСтроки Цикл
			Если НЕ СтрокаУзла.Услуга Тогда
				КоличествоСуток =  КоличествоСуток + СтрокаУзла.Количество;
			КонецЕсли;
			
			ДатаМин = Мин(СтрокаУзла.ДатаДолг, ДатаМин);
			ДатаМакс = Макс(СтрокаУзла.ДатаДолг, ДатаМакс);
			
			МассивКУдалению.Добавить(СтрокаУзла);	
		КонецЦикла;	
		
		Для Каждого Элемент Из МассивКУдалению Цикл
			УзелСтроки.Удалить(Элемент);	
		КонецЦикла;	
		
		СтрокаДерева.НаименованиеДолг = "Проживание " + Клиент.Наименование + " Номер " + НомерВРезерв 
			+ " с " + Формат(ДатаМин, "ДФ=dd.MM.yyyy") + " по " + Формат(ДатаМакс, "ДФ=dd.MM.yyyy");
			
		СтрокаДерева.Количество = КоличествоСуток;
		СтрокаДерева.Цена = ?(КоличествоСуток = 0, 0, Окр(СтрокаДерева.СуммаДолг/КоличествоСуток));  
			
	Иначе
		
		СтрокаДерева.НаименованиеДолг = Клиент.Наименование + " Номер " + НомерВРезерв;
		
		СуммаДолг = 0;
		Для Каждого СтрокаУзла Из УзелСтроки Цикл
			Если СтрокаУзла.ТолькоПроживание Тогда
				Если СтрокаУзла.Услуга Тогда 
					МассивКУдалению.Добавить(СтрокаУзла);
				КонецЕсли;
			Иначе	
				Если СтрокаУзла.Услуга Тогда 
					СуммаДолг = СуммаДолг + СтрокаУзла.СуммаДолг;
				КонецЕсли;
			КонецЕсли;
			
			Если СтрокаУзла.ТолькоУслуги Тогда
				Если НЕ СтрокаУзла.Услуга Тогда 
					МассивКУдалению.Добавить(СтрокаУзла);
				КонецЕсли;
			Иначе	
				Если НЕ СтрокаУзла.Услуга Тогда 
					СуммаДолг = СуммаДолг + СтрокаУзла.СуммаДолг;
				КонецЕсли;
			КонецЕсли;
			
			СтрокаУзла.ЗаявкаСсылка = Неопределено;	
		КонецЦикла;	
		
		Для Каждого Элемент Из МассивКУдалению Цикл
			УзелСтроки.Удалить(Элемент);	
		КонецЦикла;	

		СтрокаДерева.СуммаДолг = СуммаДолг;
	КонецЕсли;	
	
КонецЦикла;	

КонецПроцедуры
