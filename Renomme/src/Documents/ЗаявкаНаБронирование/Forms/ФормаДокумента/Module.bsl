&НаСервере
Функция ВывестиШахматку(ДатаС,ДатаПо,Детализация)  
	ТЗШахм.Очистить();
	
	ДатаС=?(Детализация="День",НачалоДня(ДатаС),НачалоЧаса(ДатаС));
	
	Запрос=Новый Запрос("ВЫБРАТЬ
	|	ЗанятостьНомеров.Клиент
	|ИЗ
	|	РегистрСведений.ЗанятостьНомеров КАК ЗанятостьНомеров
	|ГДЕ
	|	ЗанятостьНомеров.ПериодРезерва МЕЖДУ &ДатаС И &ДатаПо
	|	И ЗанятостьНомеров.Зарезервирован = ИСТИНА");	
	
	Запрос.УстановитьПараметр("ДатаС",ДатаС);						
	Запрос.УстановитьПараметр("ДатаПо",ДатаПо);
	ТЗКлиентов=Запрос.Выполнить().Выгрузить();
	
	ТЗКлиентов.Колонки.Добавить("Цвет");
// + ПСН	
	ТЗКлиентов.Колонки.Добавить("ЦветТекста");
// - ПСН	
	
	Сч=0;
	//СписокЦветов=Новый СписокЗначений;
	Для каждого СтрКлиент Из ТЗКлиентов Цикл		
		Случай=Новый ГенераторСлучайныхЧисел();
		СлучайР=Новый ГенераторСлучайныхЧисел(100+Случай.СлучайноеЧисло(0,1000));
		СлучайГ=Новый ГенераторСлучайныхЧисел(200+Случай.СлучайноеЧисло(0,1000));
		СлучайБ=Новый ГенераторСлучайныхЧисел(300+Случай.СлучайноеЧисло(0,1000));
		НовЦвет=Новый Цвет(СлучайР.СлучайноеЧисло(10,200),СлучайГ.СлучайноеЧисло(10,200),СлучайБ.СлучайноеЧисло(10,200));
		Если ТЗКлиентов.Найти(НовЦвет,"Цвет")<>Неопределено тогда
			Случай=Новый ГенераторСлучайныхЧисел();
			СлучайР=Новый ГенераторСлучайныхЧисел(100+Случай.СлучайноеЧисло(0,1000));
			СлучайГ=Новый ГенераторСлучайныхЧисел(200+Случай.СлучайноеЧисло(0,1000));
			СлучайБ=Новый ГенераторСлучайныхЧисел(300+Случай.СлучайноеЧисло(0,1000));
			НовЦвет=Новый Цвет(СлучайР.СлучайноеЧисло(10,200),СлучайГ.СлучайноеЧисло(10,200),СлучайБ.СлучайноеЧисло(10,200));
		КонецЕсли;
		СтрКлиент.Цвет=НовЦвет;
// + ПСН		
		ЦветТекста = ОбщийФункционалСервер.ПолучитьЦветТекстаПоЦветуФона(НовЦвет);
		СтрКлиент.ЦветТекста = ЦветТекста;
// - ПСН		

	КонецЦикла; 
	
	Запрос=Новый Запрос("ВЫБРАТЬ
	|	ЗанятостьНомеров.Номер,
	|	ЗанятостьНомеров.Клиент,
	|	ЗанятостьНомеров.ПериодРезерва
	|ИЗ
	|	РегистрСведений.ЗанятостьНомеров КАК ЗанятостьНомеров
	|ГДЕ
	|	ЗанятостьНомеров.ПериодРезерва МЕЖДУ &ДатаС И &ДатаПо
	|	И ЗанятостьНомеров.Номер = &Номер
	|	И ЗанятостьНомеров.Зарезервирован = ИСТИНА");	
	
	Запрос.УстановитьПараметр("ДатаС",ДатаС);						
	Запрос.УстановитьПараметр("ДатаПо",ДатаПо);
	//	ТЗЗапроса=Запрос.Выполнить().Выгрузить();
	    
	//ЭлементыФормы.ПолеОтчета.Очистить();
	ПолеОтчета.Очистить();
	
	ТемпС=ДатаС;
	ТемпПо=ДатаПо;
	
	//Макет=ПолучитьМакет("Макет");
	Макет=ПолучитьМакетНаСервере("Объект", "Макет");

	ТабДок=Новый ТабличныйДокумент;
	Обл=Макет.ПолучитьОбласть("Шапка|ШапкаВерх");
	ТабДок.Присоединить(Обл);
	
	Обл=Макет.ПолучитьОбласть("Шапка|СтрПериод");
	Пока ТемпС<=ТемпПо цикл
		Обл.Параметры.Период=Формат(ТемпС, ?(Детализация="День","ДФ='dd.MM'","ДФ='dd.MM HH:mm'"));
		ТабДок.Присоединить(Обл);
		ТемпС=ТемпС+?(Детализация="День",86400,3600*6);
	КонецЦикла;
	//ЭлементыФормы.ПолеОтчета.Вывести(ТабДок);
	ПолеОтчета.Вывести(ТабДок);
	
//	Возврат Неопределено;
	
	СпрНомеров=Справочники.НомернойФонд.Выбрать();
	Х=0;
	У=0;
	
	Пока СпрНомеров.Следующий() цикл
		Если СпрНомеров.ПометкаУдаления Тогда Продолжить; КонецЕсли;
		
		У=У+1;
		
		ТабДок=Новый ТабличныйДокумент;
		ТемпС=ДатаС;
		ТемпПо=ДатаПо;
		
		Обл=Макет.ПолучитьОбласть("Строка|ШапкаВерх");
		Обл.Параметры.Номер=СпрНомеров.Наименование;
		ТабДок.Присоединить(Обл);
		
		ТемпКл=Справочники.Клиенты.ПустаяСсылка();
		СписОб=Новый СписокЗначений;
		Сч=1;
		НачИ=2;	
		Пока ТемпС<=ТемпПо цикл
			Х=Х+1;			
			ПС=?(Детализация="День",НачалоДня(ТемпС),НачалоЧаса(ТемпС));
			ПК=?(Детализация="День",КонецДня(ТемпС),КонецЧаса(ТемпС));
			Запрос.УстановитьПараметр("ДатаС",ПС);						
			Запрос.УстановитьПараметр("ДатаПо",ПК);
			Запрос.УстановитьПараметр("Номер",СпрНомеров.Ссылка);
			ТЗЗапроса=Запрос.Выполнить().Выгрузить();
			Обл=Макет.ПолучитьОбласть("Строка|СтрПериод");
			
			Если ТЗЗапроса.Количество()<>0 тогда
				//Цв=ТЗКлиентов.Найти(ТЗЗапроса[0].Клиент,"Клиент").Цвет;
				КлиентЦвет=ТЗКлиентов.Найти(ТЗЗапроса[0].Клиент,"Клиент");
				Цв=КлиентЦвет.Цвет;
				
// + ПСН		
				ЦвТекста = КлиентЦвет.ЦветТекста; 
// - ПСН		
				
				ТекКл=ТЗЗапроса[0].Клиент;
				
				Обл.Область(1,1,1,1).ЦветФона=Цв;
// + ПСН		
				Обл.Область(1,1,1,1).ЦветТекста=ЦвТекста;
// - ПСН		

				
				Обл.Параметры.Период=ТекКл.Наименование;
				НовШ=ТЗШахм.Добавить();
				НовШ.Х=Х;
				НовШ.У=У;
				НовШ.Клиент=ТекКл;
				НовШ.Номер=СпрНомеров.Ссылка;
				НовШ.Период=?(Детализация="День",НачалоДня(ТемпС),НачалоЧаса(ТемпС));
			иначе
				ТекКл=Справочники.Клиенты.ПустаяСсылка();			
			конецесли;
			
			Если ТекКл<>ТемпКл тогда
				
				НовОб=новый Структура("Нач,Кон",НачИ,сч);
				СписОб.Добавить(НовОб);
				ТемпКл=ТекКл;
				НачИ=Сч+1;
				
			конецесли;
			
			ТабДок.Присоединить(Обл);
			ТемпС=ТемпС+?(Детализация="День",86400,3600*6);
			сч=сч+1;
		КонецЦикла;
		
		НовОб=новый Структура("Нач,Кон",НачИ,сч);
		СписОб.Добавить(НовОб);
		
		Для каждого Об Из СписОб Цикл
			ТабДок.Область(1,Об.Значение.Нач,1,Об.Значение.Кон).Объединить();
		КонецЦикла; 
		//ЭлементыФормы.ПолеОтчета.Вывести(ТабДок);
		ПолеОтчета.Вывести(ТабДок);
		
	КонецЦикла;
	
	//ЭлементыФормы.ПолеОтчета.ФиксацияСлева=1;
	ПолеОтчета.ФиксацияСлева=1;
	
	// + ПСН
	ПолеОтчета.ФиксацияСверху = 2;
	// - ПСН
	
	//ТЗЗапроса
КонецФункции
