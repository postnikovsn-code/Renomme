Если ТипЗнч(Расшифровка) = Тип("Структура") Тогда
	
	Если Расшифровка.Расшифровка = "РасшифровкаДолгосрочнаяЦена" 
	ИЛИ Расшифровка.Расшифровка = "РасшифровкаТекущаяЦена" 
	Тогда
	
		ТабДок = ПолучитьТабДокРасшифровки(Расшифровка);
			
		ПараметрыФормы = Новый Структура("ПолеОтчета, ЗаголовокОтчета", ТабДок, "Расшифровка цены");
			
		ОткрытьФорму("ОбщаяФорма.ВыводОтчета", ПараметрыФормы, ЭтаФорма
			,,,,, РежимОткрытияОкнаФормы.БлокироватьВесьИнтерфейс);
			
	ИначеЕсли Расшифровка.Расшифровка = "РасшифровкаЦенаДата" Тогда
		
		ТабДок = ПолучитьТабДокРасшифровкаКонкурентыЦенаДата(Расшифровка);
		
		ПараметрыФормы = Новый Структура("ПолеОтчета, ЗаголовокОтчета", ТабДок, "Цены конкурентов");
			
		ОткрытьФорму("ОбщаяФорма.ВыводОтчета", ПараметрыФормы, ЭтаФорма
			,,,,, РежимОткрытияОкнаФормы.БлокироватьВесьИнтерфейс);
		
	ИначеЕсли Расшифровка.Расшифровка = "РасшифровкаЦенаАналитика" Тогда
		
		ТабДок = КалендарьЦен.ПолучитьТабДокРасшифровкаКонкурентыЦенаАналитика(Расшифровка.Дата, ТЗОтели);
		
		ПараметрыФормы = Новый Структура("ПолеОтчета, ЗаголовокОтчета", ТабДок, "Цены конкурентов");
			
		ОткрытьФорму("ОбщаяФорма.ВыводОтчета", ПараметрыФормы, ЭтаФорма
			,,,,, РежимОткрытияОкнаФормы.БлокироватьВесьИнтерфейс);
	КонецЕсли;
	
КонецЕсли;
		
КонецПроцедуры

&НаСервере
Функция ПолучитьТабДокРасшифровки(Расшифровка)
ВидЦены = Расшифровка.ВидЦены;	
ДатаЦены = Расшифровка.Дата;
КатегорияНомера_П = Расшифровка.КатегорияНомера;
БезЗавтрака_П = Расшифровка.БезЗавтрака;

МодульОбработки = КалендарьЦен; 

ТЗ_БазовыеЦены = МодульОбработки.ПолучитьТЗБазовыеЦены(ДатаЦены);
Если ТЗ_БазовыеЦены.Количество() = 0 Тогда
	БазоваяЦена = 0;	
	ДоплатаЗавтрак = 0;	
	ДоплатаДвухместный = 0;
	
	ДоплатаКатегория = 0;
	
	АвторБазоваяЦена = Справочники.Пользователи.ПустаяСсылка();
	ДатаИзмененияБазоваяЦена = '00010101';
Иначе
	Строка = ТЗ_БазовыеЦены[0];
	
	БазоваяЦена = Строка.БазоваяЦена;	
	ДоплатаЗавтрак = Строка.ДоплатаЗаЗавтрак;	
	ДоплатаДвухместный = Строка.ДоплатаЗаДвухместный;
	
	ДоплатыЗаКатегории = Строка.ДоплатыЗаКатегории;
	ОтборСтроки = Новый Структура("КатегорияНомера", КатегорияНомера_П); 	
	НайденныеСтроки = ДоплатыЗаКатегории.НайтиСтроки(ОтборСтроки);
	Если НайденныеСтроки.Количество() = 0 Тогда
		ДоплатаКатегория = 0;
	Иначе
		ДоплатаКатегория = НайденныеСтроки[0].ДоплатаЗаКатегорию;
	КонецЕсли;	
	
	АвторБазоваяЦена = Строка.Автор;
	ДатаИзмененияБазоваяЦена = Строка.ДатаИзменения;
КонецЕсли;

ТЗ_КалендарьЦенБазовый = МодульОбработки.ПолучитьКалендарьЦенБазовый(ДатаЦены, ВидЦены);

БазоваяЦенаИзменения = Неопределено;
ДоплатаДвухместныйИзменения = Неопределено;
ДоплатаЗавтракИзменения = Неопределено;           

Если ТЗ_КалендарьЦенБазовый.Количество() > 0 Тогда

	Для Каждого Строка Из ТЗ_КалендарьЦенБазовый Цикл
		Если Строка.ТипЦены = Перечисления.КалендарьЦенТипЦены.БазоваяЦена Тогда
			БазоваяЦенаИзменения = Строка.ЦенаДоплата;
			АвторБазоваяЦенаИзменения = Строка.Автор;
			ДатаИзмененияБазоваяЦенаИзменения = Строка.ДатаИзменения;
		ИначеЕсли Строка.ТипЦены =Перечисления.КалендарьЦенТипЦены.ДоплатаЗаДвухместный Тогда
		    ДоплатаДвухместныйИзменения = Строка.ЦенаДоплата;
			АвторДоплатаДвухместныйИзменения = Строка.Автор;
			ДатаИзмененияДоплатаДвухместныйИзменения = Строка.ДатаИзменения;
		ИначеЕсли Строка.ТипЦены = Перечисления.КалендарьЦенТипЦены.ДоплатаЗаЗавтрак Тогда
		    ДоплатаЗавтракИзменения = Строка.ЦенаДоплата;
			АвторДоплатаЗавтракИзменения = Строка.Автор;
			ДатаИзмененияДоплатаЗавтракИзменения = Строка.ДатаИзменения;
		КонецЕсли;		
	КонецЦикла;
КонецЕсли;

ТЗ_КалендарьЦенКатегории = КалендарьЦен.ПолучитьТЗКалендарьЦенКатегории(ДатаЦены, КатегорияНомера_П, ВидЦены);

ДоплатаКатегорияИзменения = Неопределено;
Если ТЗ_КалендарьЦенКатегории.Количество() > 0 Тогда
	Строка = ТЗ_КалендарьЦенКатегории[0];
	
	ДоплатаКатегорияИзменения = Строка.ДоплатаЗаКатегорию;
	АвторДоплатаКатегорияИзменения = Строка.Автор;
	ДатаИзмененияДоплатаКатегорияИзменения = Строка.ДатаИзменения;
КонецЕсли;
 
//
Макет = Обработки.КалендарьЦен.ПолучитьМакет("РасшифровкаЦены");
ТабДок = Новый ТабличныйДокумент;
 
ТабДок1 = Новый ТабличныйДокумент;
Макет1 = Обработки.КалендарьЦен.ПолучитьМакет("РасшифровкаЦеныИтоги");

ШрифтИзменения = Новый Шрифт("Arial", 8, Истина);
ЦветТекстаИзменения = Новый Цвет(150, 50,0);

//
Область = Макет1.ПолучитьОбласть("Заголовок");
СтрокаЗаголовок = "Вид цены: " + ВидЦены + " Дата цены: " + Формат(ДатаЦены, "ДФ=dd.MM.yy") + " Категория: " + Объект.КатегорияНомера;
Если Объект.БезЗавтрака Тогда
	СтрокаЗаголовок = СтрокаЗаголовок + " Без завтрака";
Иначе	
	СтрокаЗаголовок = СтрокаЗаголовок + " Завтрак";
КонецЕсли;	
Область.Параметры.СтрокаЗаголовок = СтрокаЗаголовок;	
ТабДок1.Вывести(Область);
//

Область = Макет1.ПолучитьОбласть("Шапка"); 
ТабДок1.Вывести(Область);

ШиринаТаблицы = Область.ШиринаТаблицы;

//
Область = Макет1.ПолучитьОбласть("Строка");
Область.Параметры.Наименование = "Базовая цена одноместный";

Цена = 0;
//Если БазоваяЦенаИзменения = Неопределено Тогда
//	Область.Параметры.БазоваяЦена = БазоваяЦена;	
//	Цена = Цена + БазоваяЦена;	
//Иначе
//	Область.Параметры.БазоваяЦена = БазоваяЦенаИзменения;	
//	Цена = Цена + БазоваяЦенаИзменения;	
//КонецЕсли;
Область.Параметры.БазоваяЦена = БазоваяЦена;	
Цена = Цена + БазоваяЦена;	

//Если НЕ Объект.БезЗавтрака Тогда
//	Если ДоплатаЗавтракИзменения = Неопределено Тогда
//		Область.Параметры.ДоплатаЗавтрак = ДоплатаЗавтрак;	
//		Цена = Цена + ДоплатаЗавтрак;	
//	Иначе	
//		Область.Параметры.ДоплатаЗавтрак = ДоплатаЗавтракИзменения;	
//		Цена = Цена + ДоплатаЗавтракИзменения;	
//	КонецЕсли;
//КонецЕсли;
Если НЕ Объект.БезЗавтрака Тогда
	Область.Параметры.ДоплатаЗавтрак = ДоплатаЗавтрак;	
	Цена = Цена + ДоплатаЗавтрак;	
КонецЕсли;

Область.Параметры.ДоплатаКатегория = ДоплатаКатегория;	
Цена = Цена + ДоплатаКатегория;	

Область.Параметры.Цена = Цена;
ТабДок1.Вывести(Область);
//

//
Область = Макет1.ПолучитьОбласть("Строка");
Область.Параметры.Наименование = "Текущая цена одноместный";

Цена = 0;
Если БазоваяЦенаИзменения = Неопределено Тогда
	Область.Параметры.БазоваяЦена = БазоваяЦена;	
	Цена = Цена + БазоваяЦена;	
Иначе
	Область.Параметры.БазоваяЦена = БазоваяЦенаИзменения;	
	Цена = Цена + БазоваяЦенаИзменения;	
КонецЕсли;

Если НЕ Объект.БезЗавтрака Тогда
	Если ДоплатаЗавтракИзменения = Неопределено Тогда
		Область.Параметры.ДоплатаЗавтрак = ДоплатаЗавтрак;	
		Цена = Цена + ДоплатаЗавтрак;	
	Иначе	
		Область.Параметры.ДоплатаЗавтрак = ДоплатаЗавтракИзменения;	
		Цена = Цена + ДоплатаЗавтракИзменения;	
	КонецЕсли;
КонецЕсли;

Если ДоплатаКатегорияИзменения = Неопределено Тогда
	Область.Параметры.ДоплатаКатегория = ДоплатаКатегория;	
	Цена = Цена + ДоплатаКатегория;	
Иначе
	Область.Параметры.ДоплатаКатегория = ДоплатаКатегорияИзменения;	
	Цена = Цена + ДоплатаКатегорияИзменения;	
КонецЕсли;
	
Область.Параметры.Цена = Цена;

Область.Область(1,1,1, ШиринаТаблицы).Шрифт = ШрифтИзменения;
Область.Область(1,1,1, ШиринаТаблицы).ЦветТекста = ЦветТекстаИзменения;

ТабДок1.Вывести(Область);
//

//
Область = Макет1.ПолучитьОбласть("Строка");
Область.Параметры.Наименование = "Базовая цена двухместный";

Цена = 0;
//Если БазоваяЦенаИзменения = Неопределено Тогда
//	Область.Параметры.БазоваяЦена = БазоваяЦена;	
//	Цена = Цена + БазоваяЦена;	
//Иначе
//	Область.Параметры.БазоваяЦена = БазоваяЦенаИзменения;	
//	Цена = Цена + БазоваяЦенаИзменения;	
//КонецЕсли;
Область.Параметры.БазоваяЦена = БазоваяЦена;	
Цена = Цена + БазоваяЦена;	

//Если НЕ Объект.БезЗавтрака Тогда
//	Если ДоплатаЗавтракИзменения = Неопределено Тогда
//		Область.Параметры.ДоплатаЗавтрак = 2 * ДоплатаЗавтрак;	
//		Цена = Цена + 2 * ДоплатаЗавтрак;	
//	Иначе	
//		Область.Параметры.ДоплатаЗавтрак = 2 * ДоплатаЗавтракИзменения;	
//		Цена = Цена + 2 * ДоплатаЗавтракИзменения;	
//	КонецЕсли;
//КонецЕсли;
Если НЕ Объект.БезЗавтрака Тогда
	Область.Параметры.ДоплатаЗавтрак = 2 * ДоплатаЗавтрак;	
	Цена = Цена + 2 * ДоплатаЗавтрак;	
КонецЕсли;

//Если ДоплатаДвухместныйИзменения = Неопределено Тогда
//	Область.Параметры.ДоплатаДвухместный = ДоплатаДвухместный;	
//	Цена = Цена + ДоплатаДвухместный;	
//Иначе
//	Область.Параметры.ДоплатаДвухместный = ДоплатаДвухместныйИзменения;	
//	Цена = Цена + ДоплатаДвухместныйИзменения;
//КонецЕсли;
Область.Параметры.ДоплатаДвухместный = ДоплатаДвухместный;	
Цена = Цена + ДоплатаДвухместный;	

Область.Параметры.ДоплатаКатегория = ДоплатаКатегория;	
Цена = Цена + ДоплатаКатегория;	

Область.Параметры.Цена = Цена;
ТабДок1.Вывести(Область);
//

//
Область = Макет1.ПолучитьОбласть("Строка");
Область.Параметры.Наименование = "Текущая цена двухместный";

Цена = 0;
Если БазоваяЦенаИзменения = Неопределено Тогда
	Область.Параметры.БазоваяЦена = БазоваяЦена;	
	Цена = Цена + БазоваяЦена;	
Иначе
	Область.Параметры.БазоваяЦена = БазоваяЦенаИзменения;	
	Цена = Цена + БазоваяЦенаИзменения;	
КонецЕсли;

Если НЕ Объект.БезЗавтрака Тогда
	Если ДоплатаЗавтракИзменения = Неопределено Тогда
		Область.Параметры.ДоплатаЗавтрак = 2 * ДоплатаЗавтрак;	
		Цена = Цена + 2 * ДоплатаЗавтрак;	
	Иначе	
		Область.Параметры.ДоплатаЗавтрак = 2 * ДоплатаЗавтракИзменения;	
		Цена = Цена + 2 * ДоплатаЗавтракИзменения;	
	КонецЕсли;
КонецЕсли;

Если ДоплатаДвухместныйИзменения = Неопределено Тогда
	Область.Параметры.ДоплатаДвухместный = ДоплатаДвухместный;	
	Цена = Цена + ДоплатаДвухместный;	
Иначе
	Область.Параметры.ДоплатаДвухместный = ДоплатаДвухместныйИзменения;	
	Цена = Цена + ДоплатаДвухместныйИзменения;
КонецЕсли;

Если ДоплатаКатегорияИзменения = Неопределено Тогда
	Область.Параметры.ДоплатаКатегория = ДоплатаКатегория;	
	Цена = Цена + ДоплатаКатегория;	
Иначе
	Область.Параметры.ДоплатаКатегория = ДоплатаКатегорияИзменения;	
	Цена = Цена + ДоплатаКатегорияИзменения;	
КонецЕсли;

Область.Параметры.Цена = Цена;

Область.Область(1,1,1, ШиринаТаблицы).Шрифт = ШрифтИзменения;
Область.Область(1,1,1, ШиринаТаблицы).ЦветТекста = ЦветТекстаИзменения;
ТабДок1.Вывести(Область);

Область = Макет1.ПолучитьОбласть("Подножие");
ТабДок1.Вывести(Область);
//

//
Область = Макет.ПолучитьОбласть("Шапка");
ТабДок.Вывести(Область);

ШиринаТаблицы = Область.ШиринаТаблицы;

Область = Макет.ПолучитьОбласть("Строка");
Область.Параметры.Наименование = "Базовая цена";
Область.Параметры.Стоимость = БазоваяЦена;
Область.Параметры.Автор = АвторБазоваяЦена;
Область.Параметры.ДатаИзменения = ДатаИзмененияБазоваяЦена;
ТабДок.Вывести(Область);

Если БазоваяЦенаИзменения <> Неопределено Тогда
	Область = Макет.ПолучитьОбласть("Строка");
	Область.Параметры.Наименование = "Базовая цена изменения";
	Область.Параметры.Стоимость = БазоваяЦенаИзменения;
	Область.Параметры.Автор = АвторБазоваяЦена;
	Область.Параметры.ДатаИзменения = ДатаИзмененияБазоваяЦена;
	
	Область.Область(1, 1, 1, ШиринаТаблицы).Шрифт = ШрифтИзменения;
	Область.Область(1, 1, 1, ШиринаТаблицы).ЦветТекста = ЦветТекстаИзменения;
	ТабДок.Вывести(Область);
КонецЕсли;	

Область = Макет.ПолучитьОбласть("Строка");
Область.Параметры.Наименование = "Доплата двухместный";
Область.Параметры.Стоимость = ДоплатаДвухместный;
Область.Параметры.Автор = АвторБазоваяЦена;
Область.Параметры.ДатаИзменения = ДатаИзмененияБазоваяЦена;
ТабДок.Вывести(Область);

Если ДоплатаДвухместныйИзменения <> Неопределено Тогда
	Область = Макет.ПолучитьОбласть("Строка");
	Область.Параметры.Наименование = "Доплата двухместный изменения";
	Область.Параметры.Стоимость = ДоплатаДвухместныйИзменения;
	Область.Параметры.Автор = АвторДоплатаДвухместныйИзменения;
	Область.Параметры.ДатаИзменения = ДатаИзмененияДоплатаДвухместныйИзменения;
	
	Область.Область(1, 1, 1, ШиринаТаблицы).Шрифт = ШрифтИзменения;
	Область.Область(1, 1, 1, ШиринаТаблицы).ЦветТекста = ЦветТекстаИзменения;
	ТабДок.Вывести(Область);
КонецЕсли;	

Если НЕ Объект.БезЗавтрака Тогда
	Область = Макет.ПолучитьОбласть("Строка");
	Область.Параметры.Наименование = "Доплата за завтрак";
	Область.Параметры.Стоимость = ДоплатаЗавтрак;
	Область.Параметры.Автор = АвторБазоваяЦена;
	Область.Параметры.ДатаИзменения = ДатаИзмененияБазоваяЦена;
	ТабДок.Вывести(Область);

	Если ДоплатаЗавтракИзменения <> Неопределено Тогда
		Область = Макет.ПолучитьОбласть("Строка");
		Область.Параметры.Наименование = "Доплата за завтрак изменения";
		Область.Параметры.Стоимость = ДоплатаЗавтракИзменения;
		Область.Параметры.Автор = АвторДоплатаЗавтракИзменения;
		Область.Параметры.ДатаИзменения = ДатаИзмененияДоплатаЗавтракИзменения;
		
		Область.Область(1, 1, 1, ШиринаТаблицы).Шрифт = ШрифтИзменения;
		Область.Область(1, 1, 1, ШиринаТаблицы).ЦветТекста = ЦветТекстаИзменения;
		ТабДок.Вывести(Область);
	КонецЕсли;
КонецЕсли;

Если НЕ Объект.КатегорияНомера.Базовый Тогда
	Область = Макет.ПолучитьОбласть("Строка");
	Область.Параметры.Наименование = "Доплата за категорию";
	Область.Параметры.Стоимость = ДоплатаКатегория;
	Область.Параметры.Автор = АвторБазоваяЦена;
	Область.Параметры.ДатаИзменения = ДатаИзмененияБазоваяЦена;
	ТабДок.Вывести(Область);

	Если ДоплатаКатегорияИзменения <> Неопределено Тогда
		Область = Макет.ПолучитьОбласть("Строка");
		Область.Параметры.Наименование = "Доплата за категорию изменения";
		Область.Параметры.Стоимость = ДоплатаКатегорияИзменения;
		Область.Параметры.Автор = АвторДоплатаКатегорияИзменения;
		Область.Параметры.ДатаИзменения = ДатаИзмененияДоплатаКатегорияИзменения;
		
		Область.Область(1, 1, 1, ШиринаТаблицы).Шрифт = ШрифтИзменения;
		Область.Область(1, 1, 1, ШиринаТаблицы).ЦветТекста = ЦветТекстаИзменения;
		ТабДок.Вывести(Область);
	КонецЕсли;
КонецЕсли;

Область = Макет.ПолучитьОбласть("Подножие");
ТабДок.Вывести(Область);
//

//ОбщийФункционалСервер.ВставитьТабличныйДокумент(ТабДок, ТабДок1);
