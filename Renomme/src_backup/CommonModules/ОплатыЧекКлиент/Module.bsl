Процедура ЗаполнитьПозицииЧекаККМОплатаКоворкинг(ПозицииЧекаККМ, ДокументДолгОбъектДанные) Экспорт
ПозицииЧекаККМ.Очистить();

ДатаУчетаНДС = ДокументДолгОбъектДанные.ДатаПо;
СтавкаНДС = ДокументыСервер.СтавкаНДС(Истина); СтавкаНДС = ДокументыСервер.СтавкаНДСТекущая(СтавкаНДС, ДатаУчетаНДС);

ДатаУчета = ОбщийФункционалСервер.ЗначениеРеквизитаНаСервере(ДокументДолгОбъектДанные.Ссылка, "ДатаПо");
УчитыватьНДС = ДокументыСервер.УчитыватьНДС_Чек(ДатаУчета);

ПозицииЧекаККМШаблон = ОбщийФункционалСервер.СтруктураИзТабличнаяЧастьДокумента("КассовыйДокумент", "ЧекККМДетально");

Если ДокументДолгОбъектДанные.Сумма <> 0 Тогда 
	НовЗапч = ОбщийФункционалСервер.СкопироватьСтруктуру(ПозицииЧекаККМШаблон);

	КоличествоДниЧасы =  Формат(ДокументДолгОбъектДанные.Количество, "ЧГ=");
	Если ДокументДолгОбъектДанные.ПочасоваяОплата Тогда 
		КоличествоДниЧасы =  КоличествоДниЧасы + " час.";
	Иначе
		КоличествоДниЧасы =  КоличествоДниЧасы + " сут.";
	КонецЕсли;

	НовЗапч.Наименование="Коворкинг " + КоличествоДниЧасы;   

	НовЗапч.Количество=1;
	НовЗапч.Цена = ДокументДолгОбъектДанные.Сумма;
	НовЗапч.Сумма= ДокументДолгОбъектДанные.Сумма;

	НовЗапч.Скидка=0;
	
	Если УчитыватьНДС Тогда
		НовЗапч.СтавкаНДС = СтавкаНДС;
		НовЗапч.СуммаНДС = НовЗапч.СуммаНДС = ДокументыСервер.СуммаНДС(СтавкаНДС, ДокументДолгОбъектДанные.Сумма);
	КонецЕсли;
	
	ПозицииЧекаККМ.Добавить(НовЗапч);
КонецЕсли;

ДопУслугиКоворкинг = ДокументДолгОбъектДанные.ДопУслугиКоворкинг;

СуммаУслуги = 0;
Для Каждого Строка Из ДопУслугиКоворкинг Цикл
	СуммаУслуги = СуммаУслуги + Строка.Сумма;	
КонецЦикла; 	

Если СуммаУслуги <> 0 Тогда 
	НовЗапч = ОбщийФункционалСервер.СкопироватьСтруктуру(ПозицииЧекаККМШаблон);

	НовЗапч.Наименование="Дополнительные услуги";

	Если УчитыватьНДС Тогда
		НовЗапч.СтавкаНДС = СтавкаНДС;
		НовЗапч.СуммаНДС = ДокументыСервер.СуммаНДС(СтавкаНДС, СуммаУслуги);
	КонецЕсли;
	
	НовЗапч.Количество=1;
	НовЗапч.Цена = СуммаУслуги;
	НовЗапч.Сумма = СуммаУслуги;

	НовЗапч.Скидка=0;

	ПозицииЧекаККМ.Добавить(НовЗапч);
КонецЕсли;

КонецПроцедуры

