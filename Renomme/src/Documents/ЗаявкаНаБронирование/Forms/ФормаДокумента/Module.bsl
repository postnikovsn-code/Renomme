ИсторияОплат.Очистить();

ЗапросОплат=Новый Запрос("ВЫБРАТЬ
                         |	""БезНал"" КАК ВидОплаты,
                         |	ВыпискаБанка.Ссылка КАК Ссылка,
                         |	ВыпискаБанка.Дата КАК ДатаДокумента,
                         |	ВыпискаБанка.ДатаОплаты КАК ДатаОплаты,
