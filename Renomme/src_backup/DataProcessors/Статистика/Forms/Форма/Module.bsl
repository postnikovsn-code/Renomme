	Итоги.ГостейСЗавтраком = Итоги.ГостейСЗавтраком + ГостейСЗавтраком;
	Итоги.Романтик = Итоги.Романтик + Романтик;

	Итоги.НомеровСоСкидкой_0 = Итоги.НомеровСоСкидкой_0 + НомеровСоСкидкой_0;
	Итоги.НомеровСоСкидкой_1_9 = Итоги.НомеровСоСкидкой_1_9 + НомеровСоСкидкой_1_9;
	Итоги.НомеровСоСкидкой_10_14 = Итоги.НомеровСоСкидкой_10_14 + НомеровСоСкидкой_10_14;
	Итоги.НомеровСоСкидкой_15_19 = Итоги.НомеровСоСкидкой_15_19 + НомеровСоСкидкой_15_19;
	Итоги.НомеровСоСкидкой_20 = Итоги.НомеровСоСкидкой_20 + НомеровСоСкидкой_20;
	Итоги.НомеровСТарифныйПлан = Итоги.НомеровСТарифныйПлан + НомеровСТарифныйПлан;

	Итоги.ПостоянныхГостей = Итоги.ПостоянныхГостей + ПостоянныхГостей;
	Итоги.КоличествоНомеров = Итоги.КоличествоНомеров + КоличествоНомеров;
	
	Итоги.СуммаНомера = Итоги.СуммаНомера + СуммаНомера;
	
	КатегорииИтоги = Итоги.КатегорииИтоги;
	Для Каждого Строка Из КатегорииИтоги Цикл
		ОтборСтроки = Новый Структура("Категория", Строка.Категория);
		НайденныеСтроки = ТЗ_КатегорииЗаявки.НайтиСтроки(ОтборСтроки);
		
		Если НайденныеСтроки.Количество() > 0 Тогда
			СтрокаКатегория = НайденныеСтроки[0];
			
			Строка.СуммаНомера = Строка.СуммаНомера + СтрокаКатегория.СуммаНомера;
			Строка.ПроживаниеКоличество = Строка.ПроживаниеКоличество + СтрокаКатегория.ПроживаниеКоличество;
		КонецЕсли;					
	КонецЦикла;
	
	ТурагентстваИтоги = Итоги.ТурагентстваИтоги;
	Для Каждого Строка Из ТурагентстваИтоги Цикл
		ОтборСтроки = Новый Структура("Турагентство", Строка.Турагентство);
		НайденныеСтроки = ТЗ_ТурагентстваЗаявки.НайтиСтроки(ОтборСтроки);
		
		Если НайденныеСтроки.Количество() > 0 Тогда 
			СтрокаТурагентство = НайденныеСтроки[0];
			
			Строка.НомеровОтТурагентства = Строка.НомеровОтТурагентства + СтрокаТурагентство.КоличествоНомерВРезерв;
		КонецЕсли;		
	КонецЦикла;

	КоличествоЗаписейМесяц = КоличествоЗаписейМесяц + 1;
	КоличествоЗаписей = КоличествоЗаписей + 1;
	
	//НетЗаписей = Ложь;
	
~ПРОДОЛЖИТЬ_ДатаОтчетаПо:

	//Если НетЗаписей Тогда Перейти ~СЛЕДУЮЩАЯ_ДАТА; КонецЕсли;
	
	ИтогиМесяц.Номеров = ИтогиМесяц.Номеров + Номеров;
	ИтогиМесяц.Гостей = ИтогиМесяц.Гостей + Гостей;
	ИтогиМесяц.ГостейБезЗавтрака = ИтогиМесяц.ГостейБезЗавтрака + ГостейБезЗавтрака;
	ИтогиМесяц.ГостейСЗавтраком = ИтогиМесяц.ГостейСЗавтраком + ГостейСЗавтраком;
	ИтогиМесяц.Романтик = ИтогиМесяц.Романтик + Романтик;

	ИтогиМесяц.НомеровСоСкидкой_0 = ИтогиМесяц.НомеровСоСкидкой_0 + НомеровСоСкидкой_0;
	ИтогиМесяц.НомеровСоСкидкой_1_9 = ИтогиМесяц.НомеровСоСкидкой_1_9 + НомеровСоСкидкой_1_9;
	ИтогиМесяц.НомеровСоСкидкой_10_14 = ИтогиМесяц.НомеровСоСкидкой_10_14 + НомеровСоСкидкой_10_14;
	ИтогиМесяц.НомеровСоСкидкой_15_19 = ИтогиМесяц.НомеровСоСкидкой_15_19 + НомеровСоСкидкой_15_19;
	ИтогиМесяц.НомеровСоСкидкой_20 = ИтогиМесяц.НомеровСоСкидкой_20 + НомеровСоСкидкой_20;
	ИтогиМесяц.НомеровСТарифныйПлан = ИтогиМесяц.НомеровСТарифныйПлан + НомеровСТарифныйПлан;

	ИтогиМесяц.ПостоянныхГостей = ИтогиМесяц.ПостоянныхГостей + ПостоянныхГостей;
	ИтогиМесяц.КоличествоНомеров = ИтогиМесяц.КоличествоНомеров + КоличествоНомеров;
	
	ИтогиМесяц.СуммаНомера = ИтогиМесяц.СуммаНомера + СуммаНомера;
	
	КатегорииИтогиМесяц = ИтогиМесяц.КатегорииИтогиМесяц;
	Для Каждого Строка Из КатегорииИтогиМесяц Цикл
		ОтборСтроки = Новый Структура("Категория", Строка.Категория);
		НайденныеСтроки = ТЗ_КатегорииЗаявки.НайтиСтроки(ОтборСтроки);
		
		Если НайденныеСтроки.Количество() > 0 Тогда
			СтрокаКатегория = НайденныеСтроки[0];
			
			Строка.СуммаНомера = Строка.СуммаНомера + СтрокаКатегория.СуммаНомера;
			Строка.ПроживаниеКоличество = Строка.ПроживаниеКоличество + СтрокаКатегория.ПроживаниеКоличество;
		КонецЕсли;					
	КонецЦикла;
	
	ТурагентстваИтогиМесяц = ИтогиМесяц.ТурагентстваИтогиМесяц;
	Для Каждого Строка Из ТурагентстваИтогиМесяц Цикл
		ОтборСтроки = Новый Структура("Турагентство", Строка.Турагентство);
		НайденныеСтроки = ТЗ_ТурагентстваЗаявки.НайтиСтроки(ОтборСтроки);
		
		Если НайденныеСтроки.Количество() > 0 Тогда 
			СтрокаТурагентство = НайденныеСтроки[0];
			
			Строка.НомеровОтТурагентства = Строка.НомеровОтТурагентства + СтрокаТурагентство.КоличествоНомерВРезерв;
		КонецЕсли;		
	КонецЦикла;
	
	Если ТЗ_ЗаявкиВсе.Количество() = Индекс + 1 Тогда
		СменаМесяца = Истина;
	Иначе
		СменаМесяца = ТЗ_ЗаявкиВсе[Индекс + 1].ДеньПроживания > НачалоДня(КонецМесяца(Дата_П));
	КонецЕсли;	
	
	Если СменаМесяца Тогда
		//НетЗаписей = Истина;
		
		ОбластьИтогиМесяц = Макет.ПолучитьОбласть("ИтогиМесяц|КолонкиЛево");

		ОбластьИтогиМесяц.Параметры.ИтогоМесяц = "Итого " + Формат(Дата_П, "ДФ='ММMM yy'") + ":";
		
		ОбластьИтогиМесяц.Параметры.Номеров = ИтогиМесяц.Номеров;
		ОбластьИтогиМесяц.Параметры.Гостей = ИтогиМесяц.Гостей;
		
		ОбластьИтогиМесяц.Параметры.СреднееГостей = Окр(ИтогиМесяц.Гостей  / ИтогиМесяц.КоличествоНомеров, 2);
		
		ОбластьИтогиМесяц.Параметры.ГостейБезЗавтрака = ИтогиМесяц.ГостейБезЗавтрака;
		ОбластьИтогиМесяц.Параметры.ГостейСЗавтраком = ИтогиМесяц.ГостейСЗавтраком;
		ОбластьИтогиМесяц.Параметры.Романтик = ИтогиМесяц.Романтик;

		ОбластьИтогиМесяц.Параметры.НомеровСоСкидкой_0 = ИтогиМесяц.НомеровСоСкидкой_0;
		ОбластьИтогиМесяц.Параметры.НомеровСоСкидкой_1_9 = ИтогиМесяц.НомеровСоСкидкой_1_9;
		ОбластьИтогиМесяц.Параметры.НомеровСоСкидкой_10_14 = ИтогиМесяц.НомеровСоСкидкой_10_14;
		ОбластьИтогиМесяц.Параметры.НомеровСоСкидкой_15_19 = ИтогиМесяц.НомеровСоСкидкой_15_19;
		ОбластьИтогиМесяц.Параметры.НомеровСоСкидкой_20 = ИтогиМесяц.НомеровСоСкидкой_20;
		ОбластьИтогиМесяц.Параметры.НомеровСТарифныйПлан = ИтогиМесяц.НомеровСТарифныйПлан;

		ОбластьИтогиМесяц.Параметры.ПостоянныхГостей = ИтогиМесяц.ПостоянныхГостей;
		
		Если ИтогиМесяц.Номеров <> 0 Тогда
			СредняяЦенаНомераИтогиМесяц = Окр(ИтогиМесяц.СуммаНомера / ИтогиМесяц.Номеров, 0); 
			ОбластьИтогиМесяц.Параметры.СредняяЦенаНомера = СредняяЦенаНомераИтогиМесяц; 
		КонецЕсли;	
			
		Если ИтогиМесяц.КоличествоНомеров <> 0 Тогда
			ОбластьИтогиМесяц.Параметры.ПостоянныхГостейПроцент = Окр(ИтогиМесяц.ПостоянныхГостей * 100 / ИтогиМесяц.КоличествоНомеров, 0);
		КонецЕсли;

		Если КоличествоЗаписейМесяц > 0 Тогда 
			СреднееКоличествоНомеровМесяц = ИтогиМесяц.Номеров / КоличествоЗаписейМесяц;
			ОбластьИтогиМесяц.Параметры.ЗагрузкаПроцент = Окр(СреднееКоличествоНомеровМесяц * 100 / ОбщееКоличествоНомеров, 0) ;
		КонецЕсли;

		ИтогиНомеровСоСкидкойМесяц = ИтогиМесяц.НомеровСоСкидкой_1_9 + ИтогиМесяц.НомеровСоСкидкой_10_14 + ИтогиМесяц.НомеровСоСкидкой_15_19 
								+ ИтогиМесяц.НомеровСоСкидкой_20 + ИтогиМесяц.НомеровСТарифныйПлан; 
								
		ИтогиНомеровМесяц = ИтогиНомеровСоСкидкойМесяц + ИтогиМесяц.НомеровСоСкидкой_0; 						
		Если ИтогиНомеровМесяц <> 0 Тогда						
			ОбластьИтогиМесяц.Параметры.ПроцентНомеровСоСкидкой = Окр(ИтогиНомеровСоСкидкойМесяц * 100 / ИтогиНомеровМесяц, 0) ;
		КонецЕсли;
		
		ПолеОтчета.Вывести(ОбластьИтогиМесяц, 0);
			
		КатегорииИтогиМесяц = ИтогиМесяц.КатегорииИтогиМесяц;
		Для Каждого Строка Из ТЗ_КатегорииНомеров Цикл
			ОтборСтроки = Новый Структура("Категория", Строка.Категория);
			НайденныеСтроки = КатегорииИтогиМесяц.НайтиСтроки(ОтборСтроки);
			СтрокаКатегория = НайденныеСтроки[0];
			
			ОбластьКатегория = Макет.ПолучитьОбласть("ИтогиМесяц|КолонкиЦенаКатегория");
			
			Если СтрокаКатегория.ПроживаниеКоличество <> 0 Тогда			
				ЦенаКатегория = Окр(СтрокаКатегория.СуммаНомера / СтрокаКатегория.ПроживаниеКоличество, 2); 
				ОбластьКатегория.Параметры.ЦенаКатегория = ЦенаКатегория;
			КонецЕсли;
			
			ПолеОтчета.Присоединить(ОбластьКатегория, 0);
		КонецЦикла;
		
		ТурагентстваИтогиМесяц = ИтогиМесяц.ТурагентстваИтогиМесяц;
		Для Каждого Строка Из ТЗ_Турагентства Цикл
			ОтборСтроки = Новый Структура("Турагентство", Строка.Турагентство);
			НайденныеСтроки = ТурагентстваИтогиМесяц.НайтиСтроки(ОтборСтроки);
			СтрокаТурагентство = НайденныеСтроки[0];
			
			ОбластьТурагентство = Макет.ПолучитьОбласть("ИтогиМесяц|КолонкиТурагентства");
			ОбластьТурагентство.Параметры.НомеровОтТурагентства = СтрокаТурагентство.НомеровОтТурагентства;
			
			ПолеОтчета.Присоединить(ОбластьТурагентство, 0);
		КонецЦикла;
		
		КоличествоЗаписейМесяц = 0;
		
		ИтогиМесяц.Номеров = 0;
		ИтогиМесяц.Гостей = 0;
		ИтогиМесяц.ГостейБезЗавтрака = 0;
		ИтогиМесяц.ГостейСЗавтраком = 0;
		ИтогиМесяц.Романтик = 0;

		ИтогиМесяц.НомеровСоСкидкой_0 = 0;
		ИтогиМесяц.НомеровСоСкидкой_1_9 = 0;
		ИтогиМесяц.НомеровСоСкидкой_10_14 = 0;
		ИтогиМесяц.НомеровСоСкидкой_15_19 = 0;
		ИтогиМесяц.НомеровСоСкидкой_20 = 0;
		ИтогиМесяц.НомеровСТарифныйПлан = 0;

		ИтогиМесяц.ПостоянныхГостей = 0;
		ИтогиМесяц.КоличествоНомеров = 0;
		
		ИтогиМесяц.СуммаНомера = 0;
		
		КатегорииИтогиМесяц = ИтогиМесяц.КатегорииИтогиМесяц;
		Для Каждого Строка Из КатегорииИтогиМесяц Цикл
			Строка.СуммаНомера = 0;
			Строка.ПроживаниеКоличество = 0;
		КонецЦикла;
		
		ТурагентстваИтогиМесяц = ИтогиМесяц.ТурагентстваИтогиМесяц;
		Для Каждого Строка Из ТурагентстваИтогиМесяц Цикл
			Строка.НомеровОтТурагентства = 0;
		КонецЦикла;
	КонецЕсли;	

~СЛЕДУЮЩАЯ_ДАТА:
	//Дата_П = Дата_П + 60*60*24;	
КонецЦикла;

ОбластьИтоги = Макет.ПолучитьОбласть("Итоги|КолонкиЛево");

ОбластьИтоги.Параметры.Номеров = Итоги.Номеров;
ОбластьИтоги.Параметры.Гостей = Итоги.Гостей;

Если Итоги.Номеров <> 0 Тогда
	ОбластьИтоги.Параметры.СреднееГостей = Окр(Итоги.Гостей  / Итоги.Номеров, 2);
КонецЕсли;
	
ОбластьИтоги.Параметры.ГостейБезЗавтрака = Итоги.ГостейБезЗавтрака;
ОбластьИтоги.Параметры.ГостейСЗавтраком = Итоги.ГостейСЗавтраком;
ОбластьИтоги.Параметры.Романтик = Итоги.Романтик;

ОбластьИтоги.Параметры.НомеровСоСкидкой_0 = Итоги.НомеровСоСкидкой_0;
ОбластьИтоги.Параметры.НомеровСоСкидкой_1_9 = Итоги.НомеровСоСкидкой_1_9;
ОбластьИтоги.Параметры.НомеровСоСкидкой_10_14 = Итоги.НомеровСоСкидкой_10_14;
ОбластьИтоги.Параметры.НомеровСоСкидкой_15_19 = Итоги.НомеровСоСкидкой_15_19;
ОбластьИтоги.Параметры.НомеровСоСкидкой_20 = Итоги.НомеровСоСкидкой_20;
ОбластьИтоги.Параметры.НомеровСТарифныйПлан = Итоги.НомеровСТарифныйПлан;

Если Итоги.Номеров <> 0 Тогда
	СредняяЦенаНомераИтоги = Окр(Итоги.СуммаНомера / Итоги.Номеров, 0); 
	ОбластьИтоги.Параметры.СредняяЦенаНомера = СредняяЦенаНомераИтоги; 
КонецЕсли;
	
ОбластьИтоги.Параметры.ПостоянныхГостей = Итоги.ПостоянныхГостей;
Если Итоги.Гостей <> 0 Тогда
	ОбластьИтоги.Параметры.ПостоянныхГостейПроцент = Окр(Итоги.ПостоянныхГостей * 100 / Итоги.Гостей, 0);
КонецЕсли;

Если КоличествоЗаписей > 0 Тогда 
	СреднееКоличествоНомеров = Итоги.Номеров / КоличествоЗаписей;
	ОбластьИтоги.Параметры.ЗагрузкаПроцент = Окр(СреднееКоличествоНомеров * 100 / ОбщееКоличествоНомеров, 0) ;
КонецЕсли;

ИтогиНомеровСоСкидкой = Итоги.НомеровСоСкидкой_1_9 + Итоги.НомеровСоСкидкой_10_14 + Итоги.НомеровСоСкидкой_15_19 
						+ Итоги.НомеровСоСкидкой_20 + Итоги.НомеровСТарифныйПлан; 
ИтогиНомеров = ИтогиНомеровСоСкидкой + Итоги.НомеровСоСкидкой_0; 						
Если ИтогиНомеров <> 0 Тогда  
	ОбластьИтоги.Параметры.ПроцентНомеровСоСкидкой = Окр(ИтогиНомеровСоСкидкой * 100 / ИтогиНомеров, 0) ;
КонецЕсли;

ПолеОтчета.Вывести(ОбластьИтоги, 0);

КатегорииИтоги = Итоги.КатегорииИтоги;
Для Каждого Строка Из ТЗ_КатегорииНомеров Цикл
	ОтборСтроки = Новый Структура("Категория", Строка.Категория);
	НайденныеСтроки = КатегорииИтоги.НайтиСтроки(ОтборСтроки);
	СтрокаКатегория = НайденныеСтроки[0];
	
	ОбластьКатегория = Макет.ПолучитьОбласть("Итоги|КолонкиЦенаКатегория");
	Если СтрокаКатегория.ПроживаниеКоличество <> 0 Тогда			
		ЦенаКатегория = Окр(СтрокаКатегория.СуммаНомера / СтрокаКатегория.ПроживаниеКоличество, 2); 
		ОбластьКатегория.Параметры.ЦенаКатегория = ЦенаКатегория;
	КонецЕсли;
	
	ПолеОтчета.Присоединить(ОбластьКатегория, 0);
КонецЦикла;

ТурагентстваИтоги = Итоги.ТурагентстваИтоги;
Для Каждого Строка Из ТЗ_Турагентства Цикл
	ОтборСтроки = Новый Структура("Турагентство", Строка.Турагентство);
