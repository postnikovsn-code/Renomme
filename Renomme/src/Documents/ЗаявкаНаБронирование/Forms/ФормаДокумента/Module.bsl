&НаСервере
Функция ЕстьИсторияКлиентаДопПожелания() 
Запрос = Новый Запрос("ВЫБРАТЬ
                      |	ИсторияКлиентаДопПожелания.Клиент КАК Клиент
                      |ИЗ
                      |	РегистрСведений.ИсторияКлиентаДопПожелания КАК ИсторияКлиентаДопПожелания
                      |ГДЕ
                      |	ИсторияКлиентаДопПожелания.Клиент = &Клиент");

Запрос.УстановитьПараметр("Клиент", Объект.Клиент);

Возврат НЕ Запрос.Выполнить().Пустой();
