	Обл.Параметры.Значение=Формат(?(КолВоДнейВых=0,0,(Заселяемость.ЧеловекДеньВых/(КолВоДнейВых*40))*100), "ЧДЦ=2; ЧГ=")+"%";
	//ЭлементыФормы.ПолеОтчета.Вывести(Обл);
	ПолеОтчета.Вывести(Обл);
	
