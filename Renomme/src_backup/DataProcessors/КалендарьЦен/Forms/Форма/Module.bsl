&НаСервере
Функция ПолучитьТабДокРасшифровкаКонкурентыЦенаДата(Расшифровка)
Дата = Расшифровка.Дата;	
	
Макет = Обработки.КалендарьЦен.ПолучитьМакет("РасшифровкаКонкуренты");
ТабДок = Новый ТабличныйДокумент;

Область = Макет.ПолучитьОбласть("Заголовок");
Область.Параметры.Дата = Формат(Дата, "ДФ=dd.MM.yy");
ТабДок.Вывести(Область);

Область = Макет.ПолучитьОбласть("Шапка");
ТабДок.Вывести(Область);

Запрос = Новый Запрос("ВЫБРАТЬ
                      |	ЦеныКонкурентов.Дата КАК Дата,
                      |	ЦеныКонкурентов.НаименованиеОтеля КАК НаименованиеОтеля,
                      |	ЦеныКонкурентов.Цена КАК Цена
                      |ИЗ
                      |	РегистрСведений.ЦеныКонкурентов КАК ЦеныКонкурентов
                      |ГДЕ
                      |	ЦеныКонкурентов.Дата = &Дата
                      |	И ЦеныКонкурентов.НаименованиеОтеля <> &НаименованиеОтеля
                      |
                      |УПОРЯДОЧИТЬ ПО
                      |	НаименованиеОтеля");

Запрос.УстановитьПараметр("Дата", Дата);
Запрос.УстановитьПараметр("НаименованиеОтеля", НаименованиеОтеляАналитика);


ТЗ = Запрос.Выполнить().Выгрузить();

Для Каждого Строка Из ТЗ Цикл
	Область = Макет.ПолучитьОбласть("Строка");
	
	Область.Параметры.Отель = Строка.НаименованиеОтеля;
	Область.Параметры.Цена = Строка.Цена;
	
	ТабДок.Вывести(Область);
КонецЦикла;

Возврат ТабДок;	
КонецФункции

&НаСервере
Функция ПолучитьТабДокРасшифровкаКонкурентыЦенаАналитика_1(Расшифровка)
ДатаРасшифровка = Расшифровка.Дата;	
	
Макет = Обработки.КалендарьЦен.ПолучитьМакет("РасшифровкаКонкурентыАналитика");
ТабДок = Новый ТабличныйДокумент;

Запрос = Новый Запрос("ВЫБРАТЬ
                      |	ЦеныКонкурентовАналитикаДанныеДата.Ссылка.ДатаЗадания КАК ДатаЗадания,
                      |	ЦеныКонкурентовАналитикаДанныеДата.ЗанятоПроцент КАК ЗанятоПроцент,
                      |	ЦеныКонкурентовАналитикаДанныеДата.СреднийADR КАК СреднийADR,
                      |	ЦеныКонкурентовАналитикаДанныеДата.ГлубинаБронирования КАК ГлубинаБронирования,
                      |	ЦеныКонкурентовАналитикаДанныеДата.НашаЦена КАК НашаЦена,
                      |	ЦеныКонкурентовАналитикаДанныеОтели.Отель КАК Отель,
                      |	ЦеныКонкурентовАналитикаДанныеОтели.Цена КАК Цена,
                      |	ЦеныКонкурентовАналитикаДанныеОтели.ПродажиЗакрыты КАК ПродажиЗакрыты
                      |ИЗ
                      |	Документ.ЦеныКонкурентовАналитика.ДанныеДата КАК ЦеныКонкурентовАналитикаДанныеДата
                      |		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.ЦеныКонкурентовАналитика.ДанныеОтели КАК ЦеныКонкурентовАналитикаДанныеОтели
                      |		ПО ЦеныКонкурентовАналитикаДанныеДата.Ссылка = ЦеныКонкурентовАналитикаДанныеОтели.Ссылка
                      |			И ЦеныКонкурентовАналитикаДанныеОтели.Дата = ЦеныКонкурентовАналитикаДанныеДата.Дата
                      |ГДЕ
                      |	ЦеныКонкурентовАналитикаДанныеДата.Ссылка.ПометкаУдаления = ЛОЖЬ
                      |	И ЦеныКонкурентовАналитикаДанныеДата.Дата = &Дата");


Запрос.УстановитьПараметр("Дата", ДатаРасшифровка);

ТЗ = Запрос.Выполнить().Выгрузить();

ТабДокДата = Новый ТабличныйДокумент;

Область = Макет.ПолучитьОбласть("Заголовок|Заголовки");
Область.Параметры.ДатаРасшифровка = Формат(ДатаРасшифровка, "ДФ=dd.MM.yy");
ТабДокДата.Вывести(Область);

ОбластьЗаголовки = Макет.ПолучитьОбласть("Строка|Заголовки");
ТабДокДата.Вывести(ОбластьЗаголовки);

ОбластьЗаголовки = Макет.ПолучитьОбласть("ОтелиШапка|Заголовки");
ТабДокДата.Вывести(ОбластьЗаголовки);

Для Каждого Строка Из ТЗОтели Цикл
	ОбластьЗаголовки = Макет.ПолучитьОбласть("ОтелиСтрока|Заголовки");
	ОбластьЗаголовки.Параметры.Отель = Строка.Отель;
	
	ТабДокДата.Вывести(ОбластьЗаголовки);
КонецЦикла;
ТабДок.Присоединить(ТабДокДата);

ОтборСтроки = Новый Структура("Отель", Справочники.КонкурентыОтели.ПустаяСсылка());
ТЗДаты = ТЗ.Скопировать(ОтборСтроки);
ТЗДаты.Свернуть("ДатаЗадания, ЗанятоПроцент, СреднийADR, ГлубинаБронирования, НашаЦена, Цена");  

Для Каждого Строка Из ТЗДаты Цикл
	ТабДокДата = Новый ТабличныйДокумент;
	
	ОбластьДата = Макет.ПолучитьОбласть("Заголовок|Дата");
	ТабДокДата.Вывести(ОбластьДата);
	
	ОбластьДата = Макет.ПолучитьОбласть("Строка|Дата");
	ОбластьДата.Параметры.Дата = Формат(Строка.ДатаЗадания, "ДФ=dd.MM.yy");
	ОбластьДата.Параметры.ЗагрузкаПроцент = Строка.ЗанятоПроцент;
	ОбластьДата.Параметры.СреднийADR = Строка.СреднийADR;
	ОбластьДата.Параметры.НашаЦена = Строка.НашаЦена;
	ОбластьДата.Параметры.ГлубинаБронирования = Строка.ГлубинаБронирования;
	
	ЦенаТравелЛайн = КалендарьЦен.СредняяЦенаКонкурентовАналитика(ТЗ, Строка.Цена);
 
	ОбластьДата.Параметры.ЦенаТравелЛайн = ЦенаТравелЛайн;

	ТабДокДата.Вывести(ОбластьДата);
		
	ОбластьДата = Макет.ПолучитьОбласть("ОтелиШапка|Дата");
	ТабДокДата.Вывести(ОбластьДата);
	Для Каждого СтрокаОтель Из ТЗ Цикл
		Если ЗначениеЗаполнено(СтрокаОтель.Отель) Тогда
			ОбластьДата = Макет.ПолучитьОбласть("ОтелиСтрока|Дата");
			ОбластьДата.Параметры.Цена = КалендарьЦен.ОтчетЦенаОтель(СтрокаОтель);
			                                                                                                  
			ТабДокДата.Вывести(ОбластьДата);
		КонецЕсли;
	КонецЦикла;
	
	ТабДок.Присоединить(ТабДокДата);
КонецЦикла;

Возврат ТабДок;	
КонецФункции

&НаСервере
Функция ПолучитьОбластьСтрокаЦеныОдноместный(Макет, БазоваяЦена, БазоваяЦенаИзменения
	, ДоплатаЗавтрак, ДоплатаЗавтракИзменения, ДоплатаКатегория)
Область = Макет.ПолучитьОбласть("СтрокаЦены");

СтрокаЦены = "Базовая цена одноместный: ";
Цена = 0; 
Если БазоваяЦенаИзменения = Неопределено Тогда
	СтрокаЦены = СтрокаЦены + БазоваяЦена;	
	Цена = Цена + БазоваяЦена;	
Иначе
	СтрокаЦены = СтрокаЦены + БазоваяЦенаИзменения;	
	Цена = Цена + БазоваяЦенаИзменения;	
КонецЕсли;

Если НЕ Объект.БезЗавтрака Тогда
	Если ДоплатаЗавтракИзменения = Неопределено Тогда
		СтрокаЦены = СтрокаЦены + " + " + ДоплатаЗавтрак;
		Цена = Цена + ДоплатаЗавтрак;	
	Иначе	
		СтрокаЦены = СтрокаЦены + " + " + ДоплатаЗавтрак;
		Цена = Цена + ДоплатаЗавтрак;	
	КонецЕсли;
КонецЕсли;
	
СтрокаЦены = СтрокаЦены + " + " + ДоплатаКатегория;
Цена = Цена + ДоплатаКатегория;	

СтрокаЦены = СтрокаЦены + " = " + Цена;

Область = Макет.ПолучитьОбласть("СтрокаЦены");
Область.Параметры.СтрокаЦены = СтрокаЦены;

Возврат Область;
//
КонецФункции

