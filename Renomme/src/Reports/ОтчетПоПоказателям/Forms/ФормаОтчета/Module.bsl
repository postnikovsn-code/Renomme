	Обл.Параметры.Значение=Формат(Заселяемость.Гости, "ЧДЦ=0; ЧГ=");
	//ЭлементыФормы.ПолеОтчета.Вывести(Обл);
	ПолеОтчета.Вывести(Обл);

	Обл=Макет.ПолучитьОбласть("Строка");
	Обл.Параметры.Показатель="Количество номеров, которым предоставлена скидка 10%";
	Обл.Параметры.Значение=Формат(Заселяемость.Скидка10, "ЧДЦ=0; ЧГ=");
	//ЭлементыФормы.ПолеОтчета.Вывести(Обл);
	ПолеОтчета.Вывести(Обл);
	        
	Обл=Макет.ПолучитьОбласть("Строка");
	Обл.Параметры.Показатель="Количество номеров, которым предоставлена скидка 15%";
	Обл.Параметры.Значение=Формат(Заселяемость.Скидка15, "ЧДЦ=0; ЧГ=");
	//ЭлементыФормы.ПолеОтчета.Вывести(Обл);
	ПолеОтчета.Вывести(Обл);

	Обл=Макет.ПолучитьОбласть("Строка");
