  <allowFormCustomize>true</allowFormCustomize>
  <enabled>true</enabled>
  <showTitle>true</showTitle>
  <showCloseButton>true</showCloseButton>
  <attributes>
    <name>Объект</name>
    <id>1</id>
    <valueType>
      <types>DataProcessorObject.ОтчетДокументыДляСчетовФактур</types>
    </valueType>
    <view>
      <common>true</common>
    </view>
    <edit>
      <common>true</common>
    </edit>
    <main>true</main>
  </attributes>
  <attributes>
    <name>ДатаС</name>
    <title>
      <key>ru</key>
      <value>Дата С</value>
    </title>
    <id>2</id>
    <valueType>
      <types>Date</types>
      <dateQualifiers>
        <dateFractions>Date</dateFractions>
      </dateQualifiers>
    </valueType>
    <view>
      <common>true</common>
    </view>
    <edit>
      <common>true</common>
    </edit>
  </attributes>
  <attributes>
    <name>ДатаПо</name>
    <title>
      <key>ru</key>
      <value>Дата по</value>
    </title>
    <id>3</id>
    <valueType>
      <types>Date</types>
      <dateQualifiers>
        <dateFractions>Date</dateFractions>
      </dateQualifiers>
    </valueType>
    <view>
      <common>true</common>
    </view>
    <edit>
      <common>true</common>
    </edit>
  </attributes>
  <attributes>
    <name>СписокСчета</name>
    <title>
      <key>ru</key>
      <value>Список счета</value>
    </title>
    <id>5</id>
    <valueType>
      <types>DynamicList</types>
    </valueType>
    <view>
      <common>true</common>
    </view>
    <edit>
      <common>true</common>
    </edit>
    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>СписокСчета.ДатаСчета</segments>
    </notDefaultUseAlwaysAttributes>
    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>СписокСчета.Заявка</segments>
    </notDefaultUseAlwaysAttributes>
    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>СписокСчета.СвернутьВСчете</segments>
    </notDefaultUseAlwaysAttributes>
    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>СписокСчета.СчетГУИД</segments>
    </notDefaultUseAlwaysAttributes>
    <extInfo xsi:type="form:DynamicListExtInfo">
      <queryText>ВЫБРАТЬ
	ЗаявкаНаБронированиеСчета.Ссылка КАК Заявка,
	ЗаявкаНаБронированиеСчета.Ссылка.Бронирует КАК Бронирует,
	ЗаявкаНаБронированиеСчета.Ссылка.Номер КАК НомерЗаявки,
	ЗаявкаНаБронированиеСчета.Ссылка.Дата КАК ДатаЗаявки,
	ЗаявкаНаБронированиеСчета.Ссылка.РезервС КАК ДатаЗаезда,
	ЗаявкаНаБронированиеСчета.Ссылка.РезервПо КАК ДатаВыезда,
	ЗаявкаНаБронированиеСчета.Ссылка.Статус КАК Статус,
	ЗаявкаНаБронированиеСчета.НомерСчета КАК НомерСчета,
	ЗаявкаНаБронированиеСчета.ДатаСчета КАК ДатаСчета,
	ЗаявкаНаБронированиеСчета.ДатаС КАК ДатаС,
	ЗаявкаНаБронированиеСчета.ДатаПо КАК ДатаПо,
	ЗаявкаНаБронированиеСчета.ЭтоПредварительныйГрупповойСчет КАК ЭтоПредварительныйГрупповойСчет,
	ЗаявкаНаБронированиеСчета.ГрупповойСчет КАК ГрупповойСчет,
	ЗаявкаНаБронированиеСчета.Клиент КАК Гость,
	ЗаявкаНаБронированиеСчета.Контрагент КАК Плательщик,
	ЗаявкаНаБронированиеСчета.СчетГУИД КАК СчетГУИД,
	ЗаявкаНаБронированиеСчета.СвернутьВСчете КАК СвернутьВСчете,
	РАЗНОСТЬДАТ(ЗаявкаНаБронированиеСчета.ДатаС, ЗаявкаНаБронированиеСчета.ДатаПо, ДЕНЬ) КАК КоличествоНочей,
	ВЫБОР
		КОГДА СчетаБронируетРавноКонтрагент.ЕстьДанные ЕСТЬ NULL
			ТОГДА ЛОЖЬ
		ИНАЧЕ ИСТИНА
	КОНЕЦ КАК ЕстьСчетТурагентству,
	ВЫБОР
		КОГДА ЗаявкаНаБронированиеСчета.Ссылка.Бронирует.Турагентство = ЛОЖЬ
				И ЗаявкаНаБронированиеСчета.Контрагент.ТипКлиента = ЗНАЧЕНИЕ(Перечисление.ТипыКлиентов.ЮрЛицо)
				И НЕ(ЗаявкаНаБронированиеСчета.ЭтоПредварительныйГрупповойСчет
						ИЛИ ЗаявкаНаБронированиеСчета.ГрупповойСчет &lt;> ЗНАЧЕНИЕ(Документ.ГрупповыеСчета.ПустаяСсылка))
			ТОГДА &quot;Счет Юрлицу&quot;
		КОГДА ЗаявкаНаБронированиеСчета.Ссылка.Бронирует.Турагентство = ИСТИНА
				И ЗаявкаНаБронированиеСчета.Контрагент = ЗаявкаНаБронированиеСчета.Ссылка.Бронирует
				И НЕ(ЗаявкаНаБронированиеСчета.ЭтоПредварительныйГрупповойСчет
						ИЛИ ЗаявкаНаБронированиеСчета.ГрупповойСчет &lt;> ЗНАЧЕНИЕ(Документ.ГрупповыеСчета.ПустаяСсылка))
			ТОГДА &quot;Прямой счет Турагентству&quot;
		КОГДА ЗаявкаНаБронированиеСчета.Ссылка.Бронирует.Турагентство = ЛОЖЬ
				И ЗаявкаНаБронированиеСчета.Контрагент.ТипКлиента = ЗНАЧЕНИЕ(Перечисление.ТипыКлиентов.ЮрЛицо)
				И (ЗаявкаНаБронированиеСчета.ЭтоПредварительныйГрупповойСчет
					ИЛИ ЗаявкаНаБронированиеСчета.ГрупповойСчет &lt;> ЗНАЧЕНИЕ(Документ.ГрупповыеСчета.ПустаяСсылка))
			ТОГДА &quot;Входит в групповой счет Юрлицу&quot;
		КОГДА ЗаявкаНаБронированиеСчета.Ссылка.Бронирует.Турагентство = ЛОЖЬ
					И ЗаявкаНаБронированиеСчета.Контрагент.ТипКлиента = ЗНАЧЕНИЕ(Перечисление.ТипыКлиентов.ФизЛицо)
				ИЛИ ЗаявкаНаБронированиеСчета.Ссылка.Бронирует.Турагентство = ИСТИНА
					И ЗаявкаНаБронированиеСчета.Контрагент.ТипКлиента = ЗНАЧЕНИЕ(Перечисление.ТипыКлиентов.ФизЛицо)
					И НЕ(ЗаявкаНаБронированиеСчета.ЭтоПредварительныйГрупповойСчет
							ИЛИ ЗаявкаНаБронированиеСчета.ГрупповойСчет &lt;> ЗНАЧЕНИЕ(Документ.ГрупповыеСчета.ПустаяСсылка))
					И ВЫБОР
						КОГДА СчетаБронируетРавноКонтрагент.ЕстьДанные ЕСТЬ NULL
							ТОГДА ЛОЖЬ
						ИНАЧЕ ИСТИНА
					КОНЕЦ
			ТОГДА &quot;Счет Физлицу&quot;
		КОГДА ЗаявкаНаБронированиеСчета.Ссылка.Бронирует.Турагентство = ИСТИНА
				И ЗаявкаНаБронированиеСчета.Контрагент.ТипКлиента = ЗНАЧЕНИЕ(Перечисление.ТипыКлиентов.ФизЛицо)
				И НЕ(ЗаявкаНаБронированиеСчета.ЭтоПредварительныйГрупповойСчет
						ИЛИ ЗаявкаНаБронированиеСчета.ГрупповойСчет &lt;> ЗНАЧЕНИЕ(Документ.ГрупповыеСчета.ПустаяСсылка))
				И НЕ ВЫБОР
						КОГДА СчетаБронируетРавноКонтрагент.ЕстьДанные ЕСТЬ NULL
							ТОГДА ЛОЖЬ
						ИНАЧЕ ИСТИНА
					КОНЕЦ
			ТОГДА &quot;Прямой счет Физлицу (бронирует Турагентство)&quot;
		КОГДА ЗаявкаНаБронированиеСчета.Ссылка.Бронирует.Турагентство = ИСТИНА
				И (ЗаявкаНаБронированиеСчета.ЭтоПредварительныйГрупповойСчет
					ИЛИ ЗаявкаНаБронированиеСчета.ГрупповойСчет &lt;> ЗНАЧЕНИЕ(Документ.ГрупповыеСчета.ПустаяСсылка))
			ТОГДА &quot;Входит в Групповой счет Турагентству&quot;
		ИНАЧЕ &quot;НЕ ОПРЕДЕЛЕНО&quot;
	КОНЕЦ КАК ТипДокумента,
	ВЫБОР
		КОГДА СчетаДолги.УслугаМин = 0
				И СчетаДолги.УслугаМакс = 0
			ТОГДА &quot;П&quot;
		КОГДА СчетаДолги.УслугаМин = 1
				И СчетаДолги.УслугаМакс = 1
			ТОГДА &quot;У&quot;
		ИНАЧЕ &quot;П и У&quot;
	КОНЕЦ КАК ТипСчета,
	ВЫРАЗИТЬ(NULL КАК СТРОКА) КАК НомерСчетаФактуры,
	НАЧАЛОПЕРИОДА(ВЫРАЗИТЬ(NULL КАК ДАТА), ДЕНЬ) КАК ДатаСчетаФактуры,
	ВЫБОР
		КОГДА ЗаявкаНаБронированиеСчета.СвернутьВСчете
			ТОГДА 0
		ИНАЧЕ СчетаДолги.СуммаНДС
	КОНЕЦ КАК СуммаНДС,
	СчетаДолги.СуммаДолг КАК Стоимость,
	СчетаДолги.СуммаОплачено КАК СуммаОплачено,
	СчетаДолги.СуммаДолг КАК СуммаДолг,
	СчетаДолги.УслугаМин КАК УслугаМин,
	СчетаДолги.УслугаМакс КАК УслугаМакс
ИЗ
	Документ.ЗаявкаНаБронирование.Счета КАК ЗаявкаНаБронированиеСчета
		ВНУТРЕННЕЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
			ЗаявкаНаБронированиеСчетаДетальноДолги.Ссылка КАК Ссылка,
			ЗаявкаНаБронированиеСчетаДетальноДолги.СчетГУИД КАК СчетГУИД,
			СУММА(ЗаявкаНаБронированиеСчетаДетальноДолги.СуммаДолг) КАК СуммаДолг,
			СУММА(ЗаявкаНаБронированиеСчетаДетальноДолги.СуммаОплачено) КАК СуммаОплачено,
			СУММА(ВЫРАЗИТЬ(ВЫБОР
						КОГДА &amp;ВсеСНДС
							ТОГДА ЗаявкаНаБронированиеСчетаДетальноДолги.СуммаДолг * (&amp;СтавкаНДС / (100 + &amp;СтавкаНДС))
						ИНАЧЕ ВЫБОР
								КОГДА ЗаявкаНаБронированиеСчетаДетальноДолги.ЕстьНДС
									ТОГДА ЗаявкаНаБронированиеСчетаДетальноДолги.СуммаДолг * (&amp;СтавкаНДС / (100 + &amp;СтавкаНДС))
								ИНАЧЕ 0
							КОНЕЦ
					КОНЕЦ КАК ЧИСЛО(15, 2))) КАК СуммаНДС,
			МИНИМУМ(ВЫБОР
					КОГДА ЗаявкаНаБронированиеСчетаДетальноДолги.Услуга
						ТОГДА 1
					ИНАЧЕ 0
				КОНЕЦ) КАК УслугаМин,
			МАКСИМУМ(ВЫБОР
					КОГДА ЗаявкаНаБронированиеСчетаДетальноДолги.Услуга
						ТОГДА 1
					ИНАЧЕ 0
				КОНЕЦ) КАК УслугаМакс
		ИЗ
			Документ.ЗаявкаНаБронирование.СчетаДетальноДолги КАК ЗаявкаНаБронированиеСчетаДетальноДолги
		
		СГРУППИРОВАТЬ ПО
			ЗаявкаНаБронированиеСчетаДетальноДолги.Ссылка,
			ЗаявкаНаБронированиеСчетаДетальноДолги.СчетГУИД) КАК СчетаДолги
		ПО ЗаявкаНаБронированиеСчета.Ссылка = СчетаДолги.Ссылка
			И ЗаявкаНаБронированиеСчета.СчетГУИД = СчетаДолги.СчетГУИД
		ЛЕВОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
			ЗаявкаНаБронированиеСчета.Ссылка КАК ЕстьДанные
		ИЗ
			Документ.ЗаявкаНаБронирование.Счета КАК ЗаявкаНаБронированиеСчета
		ГДЕ
			ЗаявкаНаБронированиеСчета.Контрагент = ЗаявкаНаБронированиеСчета.Ссылка.Бронирует
		
		СГРУППИРОВАТЬ ПО
			ЗаявкаНаБронированиеСчета.Ссылка) КАК СчетаБронируетРавноКонтрагент
		ПО ЗаявкаНаБронированиеСчета.Ссылка = СчетаБронируетРавноКонтрагент.ЕстьДанные
ГДЕ
	ЗаявкаНаБронированиеСчета.Ссылка.ПометкаУдаления = ЛОЖЬ
	И НЕ(ЗаявкаНаБронированиеСчета.Ссылка.Статус = ЗНАЧЕНИЕ(Перечисление.СтатусБрони.ОтменаБронирования)
				ИЛИ ЗаявкаНаБронированиеСчета.Ссылка.Статус = ЗНАЧЕНИЕ(Перечисление.СтатусБрони.ОтказОтБронирования))
	И ЗаявкаНаБронированиеСчета.ДатаПо >= &amp;ДатаС
	И ЗаявкаНаБронированиеСчета.ДатаПо &lt;= &amp;ДатаПо

УПОРЯДОЧИТЬ ПО
	ДатаПо,
	НомерЗаявки,
	НомерСчета</queryText>
      <autoFillAvailableFields>true</autoFillAvailableFields>
      <customQuery>true</customQuery>
      <autoSaveUserSettings>true</autoSaveUserSettings>
      <getInvisibleFieldPresentations>true</getInvisibleFieldPresentations>
    </extInfo>
  </attributes>
  <attributes>
    <name>Отчет</name>
    <title>
      <key>ru</key>
      <value>Отчет</value>
    </title>
    <id>6</id>
    <valueType>
      <types>SpreadsheetDocument</types>
    </valueType>
    <view>
      <common>true</common>
    </view>
    <edit>
      <common>true</common>
    </edit>
    <extInfo xsi:type="form:SpreadsheetDocumentExtInfo"/>
  </attributes>
  <attributes>
    <name>СписокГрупповыеСчета</name>
    <title>
      <key>ru</key>
      <value>Список групповые счета</value>
    </title>
    <id>4</id>
    <valueType>
      <types>DynamicList</types>
    </valueType>
    <view>
      <common>true</common>
    </view>
    <edit>
      <common>true</common>
    </edit>
    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>СписокГрупповыеСчета.ЕстьБронь</segments>
    </notDefaultUseAlwaysAttributes>
    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>СписокГрупповыеСчета.ЕстьОшибки</segments>
    </notDefaultUseAlwaysAttributes>
    <extInfo xsi:type="form:DynamicListExtInfo">
      <queryText>ВЫБРАТЬ
	ГрупповыеСчета.Ссылка КАК ГрупповойСчет,
	ГрупповыеСчета.НомерСчета КАК НомерСчета,
	ГрупповыеСчета.ДатаСчета КАК ДатаСчета,
	ГрупповыеСчета.ДатаДокумента КАК ДатаДокумента,
	ГрупповыеСчета.Контрагент КАК Контрагент,
	ГрупповыеСчета.Контрагент.ТипКлиента КАК ТипКонтрагента,
	ВЫБОР
		КОГДА ГрупповыеСчета.Контрагент.ТипКлиента = ЗНАЧЕНИЕ(Перечисление.ТипыКлиентов.ФизЛицо)
			ТОГДА &quot;Гр. счет Физлицу&quot;
		КОГДА ГрупповыеСчета.Контрагент.ТипКлиента = ЗНАЧЕНИЕ(Перечисление.ТипыКлиентов.ЮрЛицо)
				И НЕ ГрупповыеСчета.Контрагент.Турагентство
			ТОГДА &quot;Гр. счет Юрлицу&quot;
		КОГДА ГрупповыеСчета.Контрагент.Турагентство
			ТОГДА &quot;Гр. Cчет Турагентству&quot;
	КОНЕЦ КАК ТипДокумента,
	ВЫРАЗИТЬ(NULL КАК СТРОКА(100)) КАК НомерСчетаФактуры,
	НАЧАЛОПЕРИОДА(ВЫРАЗИТЬ(NULL КАК ДАТА), ДЕНЬ) КАК ДатаСчетаФактуры,
	ГрупповойСчетДолги.СуммаДолг КАК СуммаДолг,
	ГрупповойСчетДолги.СуммаНДС КАК СуммаНДС,
	ГрупповойСчетДолги.ЕстьОшибки КАК ЕстьОшибки,
	ГрупповойСчетДолги.ЕстьБронь КАК ЕстьБронь,
	ЕСТЬNULL(Оплаты.СуммаРаспределено, 0) КАК СуммаОплачено
ИЗ
	Документ.ГрупповыеСчета КАК ГрупповыеСчета
		ВНУТРЕННЕЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
			ГрупповыеСчетаДокументыДолги.Ссылка КАК Ссылка,
			МАКСИМУМ(ВЫБОР
					КОГДА СчетаДолги.Статус = ЗНАЧЕНИЕ(Перечисление.СтатусБрони.ОтказОтБронирования)
							ИЛИ СчетаДолги.Статус = ЗНАЧЕНИЕ(Перечисление.СтатусБрони.ОтменаБронирования)
						ТОГДА 1
					ИНАЧЕ 0
				КОНЕЦ) КАК ЕстьОшибки,
			МАКСИМУМ(ВЫБОР
					КОГДА СчетаДолги.Статус = ЗНАЧЕНИЕ(Перечисление.СтатусБрони.Бронь)
						ТОГДА 1
					ИНАЧЕ 0
				КОНЕЦ) КАК ЕстьБронь,
			МАКСИМУМ(ВЫБОР
					КОГДА СчетаДолги.Статус &lt;> ЗНАЧЕНИЕ(Перечисление.СтатусБрони.Бронь)
						ТОГДА 1
					ИНАЧЕ 0
				КОНЕЦ) КАК НетБрони,
			СУММА(СчетаДолги.СуммаДолг) КАК СуммаДолг,
			СУММА(СчетаДолги.СуммаНДС) КАК СуммаНДС
		ИЗ
			Документ.ГрупповыеСчета.ДокументыДолги КАК ГрупповыеСчетаДокументыДолги
				ВНУТРЕННЕЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
					ЗаявкаНаБронированиеСчета.Ссылка КАК Ссылка,
					ЗаявкаНаБронированиеСчета.Ссылка.Статус КАК Статус,
					ЗаявкаНаБронированиеСчета.СчетГУИД КАК СчетГУИД,
					ВЫБОР
						КОГДА ЗаявкаНаБронированиеСчета.Ссылка.Статус = ЗНАЧЕНИЕ(Перечисление.СтатусБрони.ОтменаБронирования)
								ИЛИ ЗаявкаНаБронированиеСчета.Ссылка.Статус = ЗНАЧЕНИЕ(Перечисление.СтатусБрони.ОтказОтБронирования)
								ИЛИ ЗаявкаНаБронированиеСчета.Ссылка.Статус = ЗНАЧЕНИЕ(Перечисление.СтатусБрони.Бронь)
							ТОГДА 0
						ИНАЧЕ ЗаявкиСчетаДолги.СуммаДолг
					КОНЕЦ КАК СуммаДолг,
					ВЫБОР
						КОГДА ЗаявкаНаБронированиеСчета.Ссылка.Статус = ЗНАЧЕНИЕ(Перечисление.СтатусБрони.ОтменаБронирования)
								ИЛИ ЗаявкаНаБронированиеСчета.Ссылка.Статус = ЗНАЧЕНИЕ(Перечисление.СтатусБрони.ОтказОтБронирования)
								ИЛИ ЗаявкаНаБронированиеСчета.Ссылка.Статус = ЗНАЧЕНИЕ(Перечисление.СтатусБрони.Бронь)
							ТОГДА 0
						ИНАЧЕ ВЫБОР
								КОГДА ЗаявкаНаБронированиеСчета.СвернутьВСчете
									ТОГДА 0
								ИНАЧЕ ЗаявкиСчетаДолги.СуммаНДС
							КОНЕЦ
					КОНЕЦ КАК СуммаНДС
				ИЗ
					Документ.ЗаявкаНаБронирование.Счета КАК ЗаявкаНаБронированиеСчета
						ВНУТРЕННЕЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
							ЗаявкаНаБронированиеСчетаДетальноДолги.Ссылка КАК Ссылка,
							ЗаявкаНаБронированиеСчетаДетальноДолги.СчетГУИД КАК СчетГУИД,
							СУММА(ЗаявкаНаБронированиеСчетаДетальноДолги.СуммаДолг) КАК СуммаДолг,
							СУММА(ВЫРАЗИТЬ(ВЫБОР
										КОГДА &amp;ВсеСНДС
											ТОГДА ЗаявкаНаБронированиеСчетаДетальноДолги.СуммаДолг * (&amp;СтавкаНДС / (100 + &amp;СтавкаНДС))
										ИНАЧЕ ВЫБОР
												КОГДА ЗаявкаНаБронированиеСчетаДетальноДолги.ЕстьНДС
													ТОГДА ЗаявкаНаБронированиеСчетаДетальноДолги.СуммаДолг * (&amp;СтавкаНДС / (100 + &amp;СтавкаНДС))
												ИНАЧЕ 0
											КОНЕЦ
									КОНЕЦ КАК ЧИСЛО(15, 2))) КАК СуммаНДС
						ИЗ
							Документ.ЗаявкаНаБронирование.СчетаДетальноДолги КАК ЗаявкаНаБронированиеСчетаДетальноДолги
						
						СГРУППИРОВАТЬ ПО
							ЗаявкаНаБронированиеСчетаДетальноДолги.Ссылка,
							ЗаявкаНаБронированиеСчетаДетальноДолги.СчетГУИД) КАК ЗаявкиСчетаДолги
						ПО ЗаявкаНаБронированиеСчета.Ссылка = ЗаявкиСчетаДолги.Ссылка
							И ЗаявкаНаБронированиеСчета.СчетГУИД = ЗаявкиСчетаДолги.СчетГУИД) КАК СчетаДолги
				ПО ГрупповыеСчетаДокументыДолги.ДокументДолг = СчетаДолги.Ссылка
					И ГрупповыеСчетаДокументыДолги.СчетГУИД = СчетаДолги.СчетГУИД
		
		СГРУППИРОВАТЬ ПО
			ГрупповыеСчетаДокументыДолги.Ссылка) КАК ГрупповойСчетДолги
		ПО ГрупповыеСчета.Ссылка = ГрупповойСчетДолги.Ссылка
		ЛЕВОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
			ГрупповыеСчетаДокументыОплаты.Ссылка КАК Ссылка,
			СУММА(ГрупповыеСчетаДокументыОплаты.СуммаРаспределено) КАК СуммаРаспределено
		ИЗ
			Документ.ГрупповыеСчета.ДокументыОплаты КАК ГрупповыеСчетаДокументыОплаты
		
		СГРУППИРОВАТЬ ПО
			ГрупповыеСчетаДокументыОплаты.Ссылка) КАК Оплаты
		ПО ГрупповыеСчета.Ссылка = Оплаты.Ссылка
ГДЕ
	ГрупповыеСчета.ПометкаУдаления = ЛОЖЬ
	И ГрупповыеСчета.Контрагент.Турагентство = ЛОЖЬ
	И ГрупповыеСчета.Контрагент.ТипКлиента = ЗНАЧЕНИЕ(Перечисление.ТипыКлиентов.ЮрЛицо)
	И ГрупповыеСчета.ДатаДокумента >= &amp;ДатаС
	И ГрупповыеСчета.ДатаДокумента &lt;= &amp;ДатаПо

УПОРЯДОЧИТЬ ПО
	ГрупповыеСчета.ДатаДокумента</queryText>
      <autoFillAvailableFields>true</autoFillAvailableFields>
      <customQuery>true</customQuery>
      <autoSaveUserSettings>true</autoSaveUserSettings>
      <getInvisibleFieldPresentations>true</getInvisibleFieldPresentations>
    </extInfo>
  </attributes>
  <attributes>
    <name>СписокПредоплата</name>
    <title>
      <key>ru</key>
      <value>Список предоплат Юр. лица</value>
    </title>
    <id>7</id>
    <valueType>
      <types>DynamicList</types>
    </valueType>
    <view>
      <common>true</common>
    </view>
    <edit>
      <common>true</common>
    </edit>
    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>СписокПредоплата.ДатаСчета</segments>
    </notDefaultUseAlwaysAttributes>
    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>СписокПредоплата.Заявка</segments>
    </notDefaultUseAlwaysAttributes>
    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>СписокПредоплата.СвернутьВСчете</segments>
    </notDefaultUseAlwaysAttributes>
    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>СписокПредоплата.СчетГУИД</segments>
    </notDefaultUseAlwaysAttributes>
    <extInfo xsi:type="form:DynamicListExtInfo">
      <queryText>ВЫБРАТЬ
	ЗаявкаНаБронированиеСчета.Ссылка КАК Заявка,
	ЗаявкаНаБронированиеСчета.Ссылка.Номер КАК НомерЗаявки,
	ЗаявкаНаБронированиеСчета.Ссылка.Дата КАК ДатаЗаявки,
	ЗаявкаНаБронированиеСчета.Ссылка.РезервС КАК РезервС,
	ЗаявкаНаБронированиеСчета.Ссылка.РезервПо КАК РезервПо,
	ЗаявкаНаБронированиеСчета.Ссылка.Статус КАК Статус,
	ЗаявкаНаБронированиеСчета.НомерСчета КАК НомерСчета,
	ЗаявкаНаБронированиеСчета.ДатаСчета КАК ДатаСчета,
	ЗаявкаНаБронированиеСчета.ДатаС КАК ДатаС,
	ЗаявкаНаБронированиеСчета.ДатаПо КАК ДатаПо,
	ЗаявкаНаБронированиеСчета.ЭтоПредварительныйГрупповойСчет КАК ЭтоПредварительныйГрупповойСчет,
	ЗаявкаНаБронированиеСчета.ГрупповойСчет КАК ГрупповойСчет,
	ЗаявкаНаБронированиеСчета.Клиент КАК Гость,
	ЗаявкаНаБронированиеСчета.Контрагент КАК Плательщик,
	ЗаявкаНаБронированиеСчета.Ссылка.КолВоДней КАК КоличествоНочей,
	ЗаявкаНаБронированиеСчета.СчетГУИД КАК СчетГУИД,
	ЗаявкаНаБронированиеСчета.СвернутьВСчете КАК СвернутьВСчете,
	ВЫБОР
		КОГДА ЗаявкаНаБронированиеСчета.Контрагент.ТипКлиента = ЗНАЧЕНИЕ(Перечисление.ТипыКлиентов.ФизЛицо)
			ТОГДА &quot;Счет Физлицу&quot;
		КОГДА ЗаявкаНаБронированиеСчета.Контрагент.ТипКлиента = ЗНАЧЕНИЕ(Перечисление.ТипыКлиентов.ЮрЛицо)
				И НЕ ЗаявкаНаБронированиеСчета.Контрагент.Турагентство
				И НЕ(ЗаявкаНаБронированиеСчета.ЭтоПредварительныйГрупповойСчет
						ИЛИ ЗаявкаНаБронированиеСчета.ГрупповойСчет &lt;> ЗНАЧЕНИЕ(Документ.ГрупповыеСчета.ПустаяСсылка))
			ТОГДА &quot;Счет Юрлицу&quot;
		КОГДА НЕ ЗаявкаНаБронированиеСчета.Контрагент.Турагентство
				И (ЗаявкаНаБронированиеСчета.ЭтоПредварительныйГрупповойСчет
					ИЛИ ЗаявкаНаБронированиеСчета.ГрупповойСчет &lt;> ЗНАЧЕНИЕ(Документ.ГрупповыеСчета.ПустаяСсылка))
			ТОГДА &quot;Входит в групповой счет Юрлицу&quot;
		КОГДА ЗаявкаНаБронированиеСчета.Контрагент.Турагентство
			ТОГДА &quot;Cчет Турагентству&quot;
	КОНЕЦ КАК ТипДокумента,
	ВЫБОР
		КОГДА СчетаДолги.УслугаМин = 0
				И СчетаДолги.УслугаМакс = 0
			ТОГДА &quot;П&quot;
		КОГДА СчетаДолги.УслугаМин = 1
				И СчетаДолги.УслугаМакс = 1
			ТОГДА &quot;У&quot;
		ИНАЧЕ &quot;П и У&quot;
	КОНЕЦ КАК ТипСчета,
	ВЫРАЗИТЬ(NULL КАК СТРОКА) КАК НомерСчетаФактуры,
	НАЧАЛОПЕРИОДА(ВЫРАЗИТЬ(NULL КАК ДАТА), ДЕНЬ) КАК ДатаСчетаФактуры,
	СчетаДолги.СуммаДолг КАК Стоимость,
	ВЫБОР
		КОГДА ЗаявкаНаБронированиеСчета.СвернутьВСчете
			ТОГДА 0
		ИНАЧЕ СчетаДолги.СуммаНДС
	КОНЕЦ КАК СуммаНДС,
	СчетаДолги.СуммаОплачено КАК СуммаОплачено,
	СчетаДолги.СуммаДолг КАК СуммаДолг,
	СчетаДолги.УслугаМин КАК УслугаМин,
	СчетаДолги.УслугаМакс КАК УслугаМакс
ИЗ
	Документ.ЗаявкаНаБронирование.Счета КАК ЗаявкаНаБронированиеСчета
		ВНУТРЕННЕЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
			ЗаявкаНаБронированиеСчетаДетальноДолги.Ссылка КАК Ссылка,
			ЗаявкаНаБронированиеСчетаДетальноДолги.СчетГУИД КАК СчетГУИД,
			СУММА(ЗаявкаНаБронированиеСчетаДетальноДолги.СуммаДолг) КАК СуммаДолг,
			СУММА(ЗаявкаНаБронированиеСчетаДетальноДолги.СуммаОплачено) КАК СуммаОплачено,
			МИНИМУМ(ВЫБОР
					КОГДА ЗаявкаНаБронированиеСчетаДетальноДолги.Услуга
						ТОГДА 1
					ИНАЧЕ 0
				КОНЕЦ) КАК УслугаМин,
			МАКСИМУМ(ВЫБОР
					КОГДА ЗаявкаНаБронированиеСчетаДетальноДолги.Услуга
						ТОГДА 1
					ИНАЧЕ 0
				КОНЕЦ) КАК УслугаМакс,
			СУММА(ВЫРАЗИТЬ(ВЫБОР
						КОГДА &amp;ВсеСНДС
							ТОГДА ЗаявкаНаБронированиеСчетаДетальноДолги.СуммаДолг * (&amp;СтавкаНДС / (100 + &amp;СтавкаНДС))
						ИНАЧЕ ВЫБОР
								КОГДА ЗаявкаНаБронированиеСчетаДетальноДолги.ЕстьНДС
									ТОГДА ЗаявкаНаБронированиеСчетаДетальноДолги.СуммаДолг * (&amp;СтавкаНДС / (100 + &amp;СтавкаНДС))
								ИНАЧЕ 0
							КОНЕЦ
					КОНЕЦ КАК ЧИСЛО(15, 2))) КАК СуммаНДС
		ИЗ
			Документ.ЗаявкаНаБронирование.СчетаДетальноДолги КАК ЗаявкаНаБронированиеСчетаДетальноДолги
		
		СГРУППИРОВАТЬ ПО
			ЗаявкаНаБронированиеСчетаДетальноДолги.Ссылка,
			ЗаявкаНаБронированиеСчетаДетальноДолги.СчетГУИД) КАК СчетаДолги
		ПО ЗаявкаНаБронированиеСчета.Ссылка = СчетаДолги.Ссылка
			И ЗаявкаНаБронированиеСчета.СчетГУИД = СчетаДолги.СчетГУИД
ГДЕ
	ЗаявкаНаБронированиеСчета.Ссылка.ПометкаУдаления = ЛОЖЬ
	И ЗаявкаНаБронированиеСчета.Ссылка.Статус = ЗНАЧЕНИЕ(Перечисление.СтатусБрони.Бронь)
	И ЗаявкаНаБронированиеСчета.ЭтоПредварительныйГрупповойСчет = ЛОЖЬ
	И ЗаявкаНаБронированиеСчета.ГрупповойСчет = ЗНАЧЕНИЕ(Документ.ГрупповыеСчета.ПустаяСсылка)
	И СчетаДолги.СуммаОплачено &lt;> 0
	И ЗаявкаНаБронированиеСчета.ДатаСчета >= &amp;ДатаС
	И ЗаявкаНаБронированиеСчета.ДатаСчета &lt;= &amp;ДатаПо

УПОРЯДОЧИТЬ ПО
	ДатаПо,
	ДатаС</queryText>
      <autoFillAvailableFields>true</autoFillAvailableFields>
      <customQuery>true</customQuery>
      <autoSaveUserSettings>true</autoSaveUserSettings>
      <getInvisibleFieldPresentations>true</getInvisibleFieldPresentations>
    </extInfo>
  </attributes>
  <attributes>
    <name>СписокГрупповыеСчетаПредоплата</name>
    <title>
      <key>ru</key>
      <value>Список групповые счета</value>
    </title>
    <id>8</id>
    <valueType>
      <types>DynamicList</types>
    </valueType>
    <view>
      <common>true</common>
    </view>
    <edit>
      <common>true</common>
    </edit>
    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>СписокГрупповыеСчетаПредоплата.ГрупповойСчет</segments>
    </notDefaultUseAlwaysAttributes>
    <extInfo xsi:type="form:DynamicListExtInfo">
      <queryText>ВЫБРАТЬ
	ГрупповыеСчета.Ссылка КАК ГрупповойСчет,
	ГрупповыеСчета.НомерСчета КАК НомерСчета,
	ГрупповыеСчета.ДатаСчета КАК ДатаСчета,
	ГрупповыеСчета.Контрагент КАК Контрагент,
	ГрупповыеСчета.Контрагент.ТипКлиента КАК ТипКонтрагента,
	ВЫБОР
		КОГДА ГрупповыеСчета.Контрагент.ТипКлиента = ЗНАЧЕНИЕ(Перечисление.ТипыКлиентов.ФизЛицо)
			ТОГДА &quot;Гр. счет Физлицу&quot;
		КОГДА ГрупповыеСчета.Контрагент.ТипКлиента = ЗНАЧЕНИЕ(Перечисление.ТипыКлиентов.ЮрЛицо)
				И НЕ ГрупповыеСчета.Контрагент.Турагентство
			ТОГДА &quot;Гр. счет Юрлицу&quot;
		КОГДА ГрупповыеСчета.Контрагент.Турагентство
			ТОГДА &quot;Гр. Cчет Турагентству&quot;
	КОНЕЦ КАК ТипДокумента,
	ВЫРАЗИТЬ(NULL КАК СТРОКА(100)) КАК НомерСчетаФактуры,
	НАЧАЛОПЕРИОДА(ВЫРАЗИТЬ(NULL КАК ДАТА), ДЕНЬ) КАК ДатаСчетаФактуры,
	ГрупповойСчетДолги.СуммаДолг КАК СуммаДолг,
	ГрупповойСчетДолги.СуммаНДС КАК СуммаНДС,
	ГрупповойСчетДолги.ЕстьОшибки КАК ЕстьОшибки,
	ГрупповойСчетДолги.НетБрони КАК НетБрони,
	ГрупповойСчетДолги.СуммаДолг КАК Стоимость,
	Оплаты.СуммаРаспределено КАК СуммаОплачено
ИЗ
	Документ.ГрупповыеСчета КАК ГрупповыеСчета
		ВНУТРЕННЕЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
			ГрупповыеСчетаДокументыДолги.Ссылка КАК Ссылка,
			МАКСИМУМ(ВЫБОР
					КОГДА СчетаДолги.Статус = ЗНАЧЕНИЕ(Перечисление.СтатусБрони.ОтказОтБронирования)
							ИЛИ СчетаДолги.Статус = ЗНАЧЕНИЕ(Перечисление.СтатусБрони.ОтменаБронирования)
						ТОГДА 1
					ИНАЧЕ 0
				КОНЕЦ) КАК ЕстьОшибки,
			МАКСИМУМ(ВЫБОР
					КОГДА СчетаДолги.Статус = ЗНАЧЕНИЕ(Перечисление.СтатусБрони.Бронь)
						ТОГДА 1
					ИНАЧЕ 0
				КОНЕЦ) КАК ЕстьБронь,
			МАКСИМУМ(ВЫБОР
					КОГДА СчетаДолги.Статус &lt;> ЗНАЧЕНИЕ(Перечисление.СтатусБрони.Бронь)
						ТОГДА 1
					ИНАЧЕ 0
				КОНЕЦ) КАК НетБрони,
			СУММА(СчетаДолги.СуммаДолг) КАК СуммаДолг,
			СУММА(СчетаДолги.СуммаНДС) КАК СуммаНДС
		ИЗ
			Документ.ГрупповыеСчета.ДокументыДолги КАК ГрупповыеСчетаДокументыДолги
				ВНУТРЕННЕЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
					ЗаявкаНаБронированиеСчета.Ссылка КАК Ссылка,
					ЗаявкаНаБронированиеСчета.Ссылка.Статус КАК Статус,
					ЗаявкаНаБронированиеСчета.СчетГУИД КАК СчетГУИД,
					ВЫБОР
						КОГДА ЗаявкаНаБронированиеСчета.Ссылка.Статус = ЗНАЧЕНИЕ(Перечисление.СтатусБрони.Бронь)
							ТОГДА ЗаявкиСчетаДолги.СуммаДолг
						ИНАЧЕ 0
					КОНЕЦ КАК СуммаДолг,
					ВЫБОР
						КОГДА ЗаявкаНаБронированиеСчета.СвернутьВСчете
							ТОГДА 0
						ИНАЧЕ ЗаявкиСчетаДолги.СуммаНДС
					КОНЕЦ КАК СуммаНДС
				ИЗ
					Документ.ЗаявкаНаБронирование.Счета КАК ЗаявкаНаБронированиеСчета
						ВНУТРЕННЕЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
							ЗаявкаНаБронированиеСчетаДетальноДолги.Ссылка КАК Ссылка,
							ЗаявкаНаБронированиеСчетаДетальноДолги.СчетГУИД КАК СчетГУИД,
							СУММА(ЗаявкаНаБронированиеСчетаДетальноДолги.СуммаДолг) КАК СуммаДолг,
							СУММА(ВЫРАЗИТЬ(ВЫБОР
										КОГДА &amp;ВсеСНДС
											ТОГДА ЗаявкаНаБронированиеСчетаДетальноДолги.СуммаДолг * (&amp;СтавкаНДС / (100 + &amp;СтавкаНДС))
										ИНАЧЕ ВЫБОР
												КОГДА ЗаявкаНаБронированиеСчетаДетальноДолги.ЕстьНДС
													ТОГДА ЗаявкаНаБронированиеСчетаДетальноДолги.СуммаДолг * (&amp;СтавкаНДС / (100 + &amp;СтавкаНДС))
												ИНАЧЕ 0
											КОНЕЦ
									КОНЕЦ КАК ЧИСЛО(15, 2))) КАК СуммаНДС
						ИЗ
							Документ.ЗаявкаНаБронирование.СчетаДетальноДолги КАК ЗаявкаНаБронированиеСчетаДетальноДолги
						
						СГРУППИРОВАТЬ ПО
							ЗаявкаНаБронированиеСчетаДетальноДолги.Ссылка,
							ЗаявкаНаБронированиеСчетаДетальноДолги.СчетГУИД) КАК ЗаявкиСчетаДолги
						ПО ЗаявкаНаБронированиеСчета.Ссылка = ЗаявкиСчетаДолги.Ссылка
							И ЗаявкаНаБронированиеСчета.СчетГУИД = ЗаявкиСчетаДолги.СчетГУИД) КАК СчетаДолги
				ПО ГрупповыеСчетаДокументыДолги.ДокументДолг = СчетаДолги.Ссылка
					И ГрупповыеСчетаДокументыДолги.СчетГУИД = СчетаДолги.СчетГУИД
		
		СГРУППИРОВАТЬ ПО
			ГрупповыеСчетаДокументыДолги.Ссылка) КАК ГрупповойСчетДолги
		ПО ГрупповыеСчета.Ссылка = ГрупповойСчетДолги.Ссылка
		ЛЕВОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
			ГрупповыеСчетаДокументыОплаты.Ссылка КАК Ссылка,
			СУММА(ГрупповыеСчетаДокументыОплаты.СуммаРаспределено) КАК СуммаРаспределено
		ИЗ
			Документ.ГрупповыеСчета.ДокументыОплаты КАК ГрупповыеСчетаДокументыОплаты
		
		СГРУППИРОВАТЬ ПО
			ГрупповыеСчетаДокументыОплаты.Ссылка) КАК Оплаты
		ПО ГрупповыеСчета.Ссылка = Оплаты.Ссылка
ГДЕ
	ГрупповыеСчета.ПометкаУдаления = ЛОЖЬ
	И ГрупповыеСчета.Контрагент.ТипКлиента = ЗНАЧЕНИЕ(Перечисление.ТипыКлиентов.ЮрЛицо)
	И ГрупповыеСчета.Контрагент.Турагентство = ЛОЖЬ
	И ГрупповойСчетДолги.СуммаДолг &lt;> 0
	И ГрупповыеСчета.ДатаДокумента >= &amp;ДатаС
	И ГрупповыеСчета.ДатаДокумента &lt;= &amp;ДатаПо

УПОРЯДОЧИТЬ ПО
	ГрупповыеСчета.ДатаДокумента</queryText>
      <autoFillAvailableFields>true</autoFillAvailableFields>
      <customQuery>true</customQuery>
      <autoSaveUserSettings>true</autoSaveUserSettings>
      <getInvisibleFieldPresentations>true</getInvisibleFieldPresentations>
    </extInfo>
  </attributes>
