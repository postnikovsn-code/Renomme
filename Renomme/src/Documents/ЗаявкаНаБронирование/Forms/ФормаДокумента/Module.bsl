&НаКлиенте
Процедура Анкета(Команда)
Если НастройкиСервер.ЭтоРеноме() ИЛИ НастройкиСервер.ЭтоЧехов() Тогда 
	АнкетаДействие(Истина);
Иначе	
	АнкетаДействие(Ложь);
КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура АнкетаДействие(ЭтоНоваяАнкета)
	Если ЗначениеЗаполнено(Объект.Ссылка) тогда
		
		Массив = ЗапросПоискАнкеты(ЭтоНоваяАнкета);
		
		Если ЭтоНоваяАнкета Тогда
			ФормаИмя = "Документ.АнкетаНовая.Форма.ФормаДокумента";
		Иначе	
			ФормаИмя = "Документ.Анкета.Форма.ФормаДокумента";
		КонецЕсли;				
		
		Если Массив.Количество() <> 0 Тогда
			
			Ключ = Массив[0].Ссылка; 
			Парам = Новый Структура("Ключ", Ключ);
			
			ОткрытьФорму(ФормаИмя, Парам, ЭтаФорма
				,,,,, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);	
		Иначе
			Ключ = Неопределено; 
			Парам = Новый Структура("Ключ", Ключ);
			
			ФормаАнкета = ОткрытьФорму(ФормаИмя, Парам, ЭтаФорма
				,,,,, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);	
				
			ФормаАнкета.Объект.Бронь =  Объект.Ссылка;
			ФормаАнкета.Объект.Клиент =  Объект.Клиент;
			
			Если ЭтоНоваяАнкета Тогда
				Телефон = ОбщийФункционалСервер.ЗначениеРеквизитаНаСервере(Объект.Клиент, "Телефон");	
				ФормаАнкета.Объект.Телефон = Телефон;
				ЭлПочта = ОбщийФункционалСервер.ЗначениеРеквизитаНаСервере(Объект.Клиент, "ЭлПочта");	
				ФормаАнкета.Объект.EMail = ЭлПочта;
			КонецЕсли;	
				
		КонецЕсли;
		
	иначе
		Предупреждение("Сначала запишите бронь!");   
	конецесли;
КонецПроцедуры

&НаСервере
Функция ЗапросПоискАнкеты(ЭтоНоваяАнкета)
Если ЭтоНоваяАнкета Тогда
	ЗапросПоискАнкеты = Новый Запрос("ВЫБРАТЬ
		|	Анкета.Ссылка
		|ИЗ
		|	Документ.АнкетаНовая КАК Анкета
		|ГДЕ
		|	Анкета.Бронь = &Бронь");
Иначе	
	ЗапросПоискАнкеты = Новый Запрос("ВЫБРАТЬ
         |	Анкета.Ссылка КАК Ссылка
         |ИЗ
         |	Документ.Анкета КАК Анкета
         |ГДЕ
         |	Анкета.Бронь = &Бронь");
КонецЕсли;	
	
ЗапросПоискАнкеты.УстановитьПараметр("Бронь", Объект.Ссылка);
ТЗА=ЗапросПоискАнкеты.Выполнить().Выгрузить();
Массив = ОбщийФункционалСервер.ТаблицаЗначенийВМассивСтруктур(ТЗА);

Возврат Массив;
КонецФункции


