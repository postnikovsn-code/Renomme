Функция ЗаполнитьТаблицуНаСервере()
	//Перерисовать=Истина;
	
	////Запрос=Новый Запрос("ВЫБРАТЬ РАЗЛИЧНЫЕ
	////				|	ЗанятостьНомеров.Номер КАК НомерКомнаты,
	////				|	ЗанятостьНомеров.Клиент КАК Гость,
	////				|	УборкиНомеров.Горничная,
	////				|	УборкиНомеров.Минибар КАК МиниБарОтГорничной,
	////				|	ЗанятостьНомеров.Регистратор КАК Бронь,
	////				|	УборкиНомеров.ВремяУброки КАК ВремяУборки
	////				|ИЗ
	////				|	РегистрСведений.ЗанятостьНомеров КАК ЗанятостьНомеров
	////				|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.УборкиНомеров КАК УборкиНомеров
	////				|		ПО ЗанятостьНомеров.Номер = УборкиНомеров.Комната
	////				|			И (НАЧАЛОПЕРИОДА(ЗанятостьНомеров.ПериодРезерва, ДЕНЬ) = НАЧАЛОПЕРИОДА(УборкиНомеров.ВремяУброки, ДЕНЬ))
	////				|ГДЕ
	////				|	НАЧАЛОПЕРИОДА(УборкиНомеров.ВремяУброки, ДЕНЬ) = &Период
	////				|	И НАЧАЛОПЕРИОДА(ЗанятостьНомеров.ПериодРезерва, ДЕНЬ) = &Период
	////				|	И УборкиНомеров.Минибар <> """"
	////				|	И (НЕ УборкиНомеров.КомментарийАдминистрации ПОДОБНО &КомментарийАдминистрации)");	

	Запрос=Новый Запрос("ВЫБРАТЬ РАЗЛИЧНЫЕ
	                    |	ЗанятостьНомеров.Номер КАК НомерКомнаты,
	                    |	ЗанятостьНомеров.Клиент КАК Гость,
	                    |	УборкиНомеров.Горничная,
	                    |	УборкиНомеров.Минибар КАК МиниБарОтГорничной,
	                    |	ЗанятостьНомеров.Регистратор КАК Бронь,
	                    |	УборкиНомеров.ВремяУброки КАК ВремяУборки
	                    |ИЗ
	                    |	РегистрСведений.ЗанятостьНомеров КАК ЗанятостьНомеров
	                    |		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.УборкиНомеров КАК УборкиНомеров
	                    |		ПО ЗанятостьНомеров.Номер = УборкиНомеров.Комната
	                    |ГДЕ
	                    |	НАЧАЛОПЕРИОДА(УборкиНомеров.ВремяУброки, ДЕНЬ) = &Период
	                    |	И НАЧАЛОПЕРИОДА(ЗанятостьНомеров.ПериодРезерва, ДЕНЬ) = &Период
	                    |	И УборкиНомеров.Минибар <> """"
	                    |	И (НЕ УборкиНомеров.КомментарийАдминистрации ПОДОБНО &КомментарийАдминистрации)
	                    |
	                    |ОБЪЕДИНИТЬ
	                    |
	                    |ВЫБРАТЬ РАЗЛИЧНЫЕ
	                    |	ЗанятостьНомеров.Номер,
	                    |	ЗанятостьНомеров.Клиент,
	                    |	УборкиНомеров.Горничная,
	                    |	УборкиНомеров.Минибар,
	                    |	ЗанятостьНомеров.Регистратор,
	                    |	УборкиНомеров.ВремяУброки
	                    |ИЗ
	                    |	РегистрСведений.ЗанятостьНомеров КАК ЗанятостьНомеров
	                    |		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.УборкиНомеров КАК УборкиНомеров
	                    |		ПО ЗанятостьНомеров.Номер = УборкиНомеров.Комната
	                    |ГДЕ
	                    |	НАЧАЛОПЕРИОДА(УборкиНомеров.ВремяУброки, ДЕНЬ) = &Период
	                    |	И НАЧАЛОПЕРИОДА(ЗанятостьНомеров.ПериодРезерва, ДЕНЬ) = &Период2
	                    |	И УборкиНомеров.Минибар <> """"
	                    |	И (НЕ УборкиНомеров.КомментарийАдминистрации ПОДОБНО &КомментарийАдминистрации)");	
	Запрос.УстановитьПараметр("Период",НачалоДня(Объект.ДатаУборки));
	Запрос.УстановитьПараметр("Период2",НачалоДня(Объект.ДатаУборки-86400));

	Запрос.УстановитьПараметр("КомментарийАдминистрации","%<Минибар зафиксирован>%");

	ТЗ=Запрос.Выполнить().Выгрузить();
	
	Объект.ДанныеПоМинибару.Очистить();
	
	// + ПСН
	ПредНомер = Справочники.НомернойФонд.ПустаяСсылка();
	Цвет = Ложь;
	// - ПСН
	
	Для каждого СтрМБ Из ТЗ Цикл  
	
		НовД=Объект.ДанныеПоМинибару.Добавить();
		НовД.Бронь=СтрМБ.Бронь;
		Новд.ВремяУборки=СтрМБ.ВремяУборки;
		НовД.Горничная=СтрМБ.Горничная;
		НовД.Гость=СтрМБ.Гость;
		НовД.МиниБарОтГорничной=СтрМБ.МиниБарОтГорничной;
		НовД.НомерКомнаты=СтрМБ.НомерКомнаты;
		
		// + ПСН
		//Если Перерисовать тогда
			Если НовД.НомерКомнаты<>ПредНомер тогда
				Цвет=Не Цвет;
				ПредНомер=НовД.НомерКомнаты;		
			конецесли;
			НовД.Цвет=Цвет;
		//КонецЕсли;		
		// - ПСН
		
	
	КонецЦикла;
	
	
//   //ЭлементыФормы.ДанныеПоМинибару.ОбновитьСтроки();
 //   Элементы.ДанныеПоМинибару.ЗакончитьРедактированиеСтроки(Ложь);
 //   
 //   Перерисовать=Ложь;
