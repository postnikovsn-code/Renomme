//
&НаСервере
Функция ОбновитьГод(Знач ГодОбновления)
СписВыбранных.Очистить();

ПолеОтчета.Очистить();
Если НЕ ЗначениеЗаполнено(Объект.КатегорияНомера) Тогда Возврат Неопределено; КонецЕсли;

ОбновитьТЗБазовыеЦены_OLD();
ОбновитьТЗЦен_OLD();

ТабДок=Новый ТабличныйДокумент;

ИмяОбработки = ОбщийФункционалКлиентСервер.ИмяОбработки(ЭтаФорма);
Макет = Обработки[ИмяОбработки].ПолучитьМакет("МакетОсновной");

КатегорияНомера = Объект.КатегорияНомера;

Обл=Макет.ПолучитьОбласть("Шапка|ШапкаВерх");
ТабДок.Присоединить(Обл);

Для сч=1 По 6 Цикл
	Обл=Макет.ПолучитьОбласть("Шапка|Неделя");
	ТабДок.Присоединить(Обл);
КонецЦикла; 

ПолеОтчета.Вывести(ТабДок, 0);

Начало=?(Объект.ПоказатьПрошлыеДаты,1,Месяц(ТекущаяДата()));

ВысотаПолеОтчетаМинимум = 2;
ВысотаПоляОтчетаМаксимум = 0;

ШиринаПоляОтчетаМаксимум = 2;

//Для сч = Начало По 12 Цикл
Конец =  12 + Начало - 1;
Для сч = Начало По Конец Цикл
	
	Если сч > 12 Тогда
		ГодОбновления_П = ГодОбновления + 1;
		Месяц_П = сч - 12;
	Иначе
		ГодОбновления_П = ГодОбновления;
		Месяц_П = сч;
	КонецЕсли;
	
	ТабДок_Разделитель = Новый ТабличныйДокумент;
	Обл = Макет.ПолучитьОбласть("Разделитель");
	Обл.Параметры.Месяц = ПолучитьМесяц(Месяц_П)+ " " + Формат(ГодОбновления_П, "ЧГ=");

	ТабДок_Разделитель.Вывести(Обл);
	ПолеОтчета.Вывести(ТабДок_Разделитель);
	
	ТабДок = Новый ТабличныйДокумент;
	
	Обл=Макет.ПолучитьОбласть("Строка|ШапкаВерх");
	Обл.Параметры.Месяц = ПолучитьМесяц(Месяц_П)+ " " + Формат(ГодОбновления_П, "ЧГ=");
	ТабДок.Вывести(Обл);

	Для сч2 = 1 По 6 Цикл
		
		Обл=Макет.ПолучитьОбласть("Строка|Неделя");
		ДатыНедели = НеделяМесяца(Дата(ГодОбновления_П, Месяц_П, 1), сч2);
		Если ДатыНедели<>Неопределено тогда
			ДТН=ДатыНедели.ДТН;
			ДТК=ДатыНедели.ДТК;
			
			Пока ДТН<=ДТК цикл
				НетЗаполненияДаты = Истина;
				
				Обл.Параметры["Д"+ДеньНедели(ДТН)]=ДТН;
				
				ЗаполнитьЯчейкиОтчета(ДТН, Обл);
				
				ДТН=ДТН+86400;
			КонецЦикла;				
		конецесли;
		
		ТабДок.Присоединить(Обл);
	КонецЦикла; 
	
	ГруппаОткрыта = (сч - Начало < 2);
	ПолеОтчета.НачатьГруппуСтрок(ГруппаОткрыта, ГруппаОткрыта);
	ПолеОтчета.Вывести(ТабДок);

	ТабДок2 = Новый ТабличныйДокумент;
	
	ДатаС = НачалоДня(Дата(ГодОбновления_П, Месяц_П, 1));
	ДатаПо = НачалоДня(КонецМесяца(ДатаС));
	
	ПолеОтчета.НачатьГруппуСтрок(, Ложь);
	//СформироватьАналитика(ТабДок2, ДатаС, ДатаПо);
	СформироватьАналитикаОтчет(ТабДок2, ДатаС, ДатаПо);
	
	ПолеОтчета.Вывести(ТабДок2);
	ПолеОтчета.ЗакончитьГруппуСтрок();
	
	ПолеОтчета.ЗакончитьГруппуСтрок();
	
	//ВысотаПоляОтчетаМаксимум = ВысотаПоляОтчетаМаксимум + 3;		
	ВысотаПоляОтчетаМаксимум = ВысотаПоляОтчетаМаксимум + 4 + Сдвиг;		
КонецЦикла; 

ШиринаПолеОтчета.Очистить();
ШиринаПоляОтчетаМаксимум = 6*7 + 1;
Для НомерСтроки = ВысотаПолеОтчетаМинимум По ВысотаПоляОтчетаМаксимум Цикл
	
	СтрокаШиринаПолеОтчета = ШиринаПолеОтчета.Добавить();
	СтрокаШиринаПолеОтчета.НомерСтроки = НомерСтроки;
	
	ЭтоСтрокаДата = ЭтоСтрокаДата(НомерСтроки, Сдвиг); 
	Если ЭтоСтрокаДата Тогда 
		СтрокаШиринаПолеОтчета.ШиринаПолеОтчетаМинимум = 2;
		СтрокаШиринаПолеОтчета.ШиринаПоляОтчетаМаксимум = 1;
	Иначе	
		СтрокаШиринаПолеОтчета.ШиринаПолеОтчетаМинимум = 0;
		СтрокаШиринаПолеОтчета.ШиринаПоляОтчетаМаксимум = 0;
		Продолжить; 
	КонецЕсли;
	
	НетЗаполненияДаты = Истина;
	Для НомерСтолбца =  2 По ШиринаПоляОтчетаМаксимум Цикл
	    ДанныеОбласти = "R" + Строка(НомерСтроки) + "C" + Строка(НомерСтолбца);
		
		Если ЗначениеЗаполнено(ПолеОтчета.Область(ДанныеОбласти).Текст) Тогда
			НетЗаполненияДаты = Ложь;
			СтрокаШиринаПолеОтчета.ШиринаПоляОтчетаМаксимум = СтрокаШиринаПолеОтчета.ШиринаПоляОтчетаМаксимум + 1;
		Иначе	
			Если НетЗаполненияДаты Тогда
				СтрокаШиринаПолеОтчета.ШиринаПолеОтчетаМинимум = СтрокаШиринаПолеОтчета.ШиринаПолеОтчетаМинимум + 1;
				СтрокаШиринаПолеОтчета.ШиринаПоляОтчетаМаксимум = СтрокаШиринаПолеОтчета.ШиринаПоляОтчетаМаксимум + 1;
			КонецЕсли;		
		КонецЕсли;
	КонецЦикла;		
КонецЦикла;

ПолеОтчета.ФиксацияСверху=1;
ПолеОтчета.ФиксацияСлева=1;

КонецФункции

&НаСервереБезКонтекста
Функция ПолучитьМесяц(М)
	Если М=1 тогда
		Возврат "Январь";
	ИначеЕсли М=2 тогда
		Возврат "Февраль";
	ИначеЕсли М=3 тогда
		Возврат "Март";
	ИначеЕсли М=4 тогда
		Возврат "Апрель";
	ИначеЕсли М=5 тогда
		Возврат "Май";
	ИначеЕсли М=6 тогда
		Возврат "Июнь";
	ИначеЕсли М=7 тогда
		Возврат "Июль";
	ИначеЕсли М=8 тогда
		Возврат "Август";
	ИначеЕсли М=9 тогда
		Возврат "Сентябрь";
	ИначеЕсли М=10 тогда
		Возврат "Октябрь";
	ИначеЕсли М=11 тогда
		Возврат "Ноябрь";
	ИначеЕсли М=12 тогда
		Возврат "Декабрь";
	КонецЕсли;
КонецФункции

&НаСервереБезКонтекста
Функция НеделяМесяца(НачМес,Нед)
	ДТН=Макс(НачалоНедели(НачМес+7*(НЕД-1)*86400),НачМес);
	Если Месяц(ДТН)<>Месяц(НачМес) тогда
		возврат Неопределено
	конецесли;
	ДТК=МИН(КонецМесяца(НачМес),КонецНедели(ДТН));
	Возврат Новый Структура("ДТН,ДТК",ДТН,ДТК);
КонецФункции
