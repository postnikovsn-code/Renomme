ЭлементОтбора.Использование     = Истина;
 
//ЭлементОформления.Оформление.УстановитьЗначениеПараметра("ЦветТекста", WebЦвета.Зеленый);
ЭлементОформления.Оформление.УстановитьЗначениеПараметра("ЦветФона", Новый Цвет(209,209,209));
 
// Укажем какие поля (колонки) оформлять
ПолеОформления      = ЭлементОформления.Поля.Элементы.Добавить();
ПолеОформления.Поле = Новый ПолеКомпоновкиДанных("ДанныеПоМинибару");
ПолеОформления.Использование = Истина; 
 
