	//	
	//	ОтборСтроки = Новый Структура("Горничная, Помещение", Строка.Горничная, СтрокаПомещение.Помещение);
	//	НайденныеСтроки = Объект.ЗарплатаПомещения.НайтиСтроки(ОтборСтроки);
	//	Если НайденныеСтроки.Количество() > 0 Тогда
	//		НайденнаяСтрока = НайденныеСтроки[0];
	//	
	//		ОбластьПомещение.Параметры.Помещение_Количество = НайденнаяСтрока.Количество;
	//		ОбластьПомещение.Параметры.Помещение_Сумма = НайденнаяСтрока.Цена * НайденнаяСтрока.Количество;
	//	КонецЕсли;
	//	
	//	ТабДок.Присоединить(ОбластьПомещение);
	//КонецЦикла;	
	////
КонецЦикла;

Область = Макет.ПолучитьОбласть("Итоги|Лево");

//Оклад = Строка.Оклад_Э;
Оклад = Зарплата.Итог("Оклад_Э");
//НадбавкаЗаСтаж = Строка.НадбавкаЗаСтаж_Э;
НадбавкаЗаСтаж = Зарплата.Итог("НадбавкаЗаСтаж_Э");
//НадбавкаЗаСтандарты = Строка.НадбавкаЗаСтандарты_Э;
НадбавкаЗаСтандарты = Зарплата.Итог("НадбавкаЗаСтандарты_Э");

//Отпуск = Строка.Отпуск_Э;
Отпуск = Зарплата.Итог("Отпуск_Э");
//Больничный = Строка.Больничный;
Больничный = Зарплата.Итог("Больничный");
//Премия = Строка.Премия;
Премия = Зарплата.Итог("Премия");

//ДопРаботы = Строка.ДопРаботы;
ДопРаботы = Зарплата.Итог("ДопРаботы");
//Сдельно = Строка.Сдельно;
Сдельно = Зарплата.Итог("Сдельно");

//КорректировкаДопНачислено = Строка.КорректировкаДопНачислено;      
КорректировкаДопНачислено = Зарплата.Итог("КорректировкаДопНачислено");

//СуммаПрачечная = Строка.СуммаПрачечная_Э;
СуммаПрачечная = Зарплата.Итог("СуммаПрачечная_Э");

//СуммаУборки = Строка.СуммаУборки;
СуммаУборки = Зарплата.Итог("СуммаУборки");
//СуммаПомещения = Строка.СуммаПомещения;
СуммаПомещения = Зарплата.Итог("СуммаПомещения");

//Итого = Строка.Итого;      
Итого = Зарплата.Итог("Итого");
//ЗарплатаИтого = Строка.ЗарплатаИтого;      
ЗарплатаИтого = Зарплата.Итог("ЗарплатаИтого");

//Аванс_кк = Строка.Аванс_кк;      
