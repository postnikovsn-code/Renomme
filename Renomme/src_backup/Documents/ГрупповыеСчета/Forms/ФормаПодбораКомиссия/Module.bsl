//Если НЕ Параметры.Свойство("Неоплачено", Неоплачено) Тогда Неоплачено = Истина; КонецЕсли; 

Параметры.Свойство("ДатаСОтбор", РезервСОтбор); 
Параметры.Свойство("ДатаПоОтбор", РезервПоОтбор);

УстановитьОтборПараметры();

//УсловноеОформлениеЗагрузить();
