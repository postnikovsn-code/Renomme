
&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
ЭтаФорма.ТолькоПросмотр = НастройкиСервер.ФормаТолькоПросмотр(Ложь);

ТекущийПользовательКодРавноАдминистратор = НастройкиСервер.ТекущийПользовательКодРавноАдминистратор();
Элементы.ГУИДЗагрузка.Видимость = ТекущийПользовательКодРавноАдминистратор;
Элементы.СозданПрограммно.Видимость = ТекущийПользовательКодРавноАдминистратор;

РучнойВвод = НЕ ЗначениеЗаполнено(Объект.ГУИДЗагрузка);

Если НЕ ЗначениеЗаполнено(Объект.Ссылка) Тогда
	Если Параметры.Свойство("ЭтоПлатежКонтрагенту") Тогда	
		ЭтоПлатежКонтрагенту = Параметры.ЭтоПлатежКонтрагенту;
		
		ЭтоВозврат = Ложь;
		СозданПрограммно = Истина;		
		
	ИначеЕсли Параметры.Свойство("ЭтоВозврат") Тогда
		ЭтоВозврат = Параметры.ЭтоВозврат;
		
		ЭтоПлатежКонтрагенту = Ложь;
		СозданПрограммно = Истина;	
		
	Иначе	
		ЭтоВозврат = Ложь;
		ЭтоПлатежКонтрагенту = Ложь;
		СозданПрограммно = Ложь;
		
	КонецЕсли;	

	Если ЭтоПлатежКонтрагенту Тогда 
		Объект.Приход = Ложь;
		Объект.Возврат = Ложь;
		Объект.ЭтоПлатежКонтрагенту = Истина;
		
		Параметры.Свойство("ОтКого", Объект.ОтКого);
		Если ЗначениеЗаполнено(Объект.ОтКого) Тогда Элементы.ОтКого.ТолькоПросмотр = Истина; КонецЕсли;  
		
		Параметры.Свойство("Сумма", Объект.Сумма);
		//Если ЗначениеЗаполнено(Объект.Сумма) Тогда Элементы.Сумма.ТолькоПросмотр = НЕ ЭтоАдминистратор; КонецЕсли;  
		
	ИначеЕсли ЭтоВозврат Тогда
		Объект.Приход = Ложь;
		Объект.Возврат = Истина;
		Объект.ЭтоПлатежКонтрагенту = Ложь;
		
		Параметры.Свойство("ОтКого", Объект.ОтКого);
		Если ЗначениеЗаполнено(Объект.ОтКого) Тогда Элементы.ОтКого.ТолькоПросмотр = Истина; КонецЕсли;  

		Параметры.Свойство("ВозвратДокумент", Объект.ВозвратДокумент);
		Если ЗначениеЗаполнено(Объект.ВозвратДокумент) Тогда Элементы.ВозвратДокумент.ТолькоПросмотр = Истина; КонецЕсли;  
		
		Параметры.Свойство("ВозвратСумма", Объект.Сумма);
		//Если ЗначениеЗаполнено(Объект.Сумма) Тогда Элементы.Сумма.ТолькоПросмотр = НЕ ЭтоАдминистратор; КонецЕсли;  
		
	Иначе	
		Объект.Приход = Истина;
		Объект.Возврат = Ложь;
		Объект.ЭтоПлатежКонтрагенту = Ложь;
	КонецЕсли;
Иначе	
	СозданПрограммно = (НЕ РучнойВвод) ИЛИ Объект.Возврат ИЛИ Объект.ЭтоПлатежКонтрагенту;
КонецЕсли;

Если Объект.ЭтоПлатежКонтрагенту Тогда 
	Элементы.ДекорацияТипДокумента.Заголовок = "Платеж";
	Элементы.ДекорацияТипДокумента.ЦветТекста = WebЦвета.Фиолетовый;
ИначеЕсли Объект.Возврат Тогда
	Элементы.ДекорацияТипДокумента.Заголовок = "Возврат";
	Элементы.ДекорацияТипДокумента.ЦветТекста = WebЦвета.Красный;
ИначеЕсли Объект.Приход Тогда 	
	Элементы.ДекорацияТипДокумента.Заголовок = "Приход";
	Элементы.ДекорацияТипДокумента.ЦветТекста = WebЦвета.Зеленый;
Иначе	
	Элементы.ДекорацияТипДокумента.Заголовок = "Расход";
	Элементы.ДекорацияТипДокумента.ЦветТекста = WebЦвета.Коричневый;
КонецЕсли; 

Если СозданПрограммно Тогда
	Если Объект.ЭтоПлатежКонтрагенту Тогда 
		Элементы.ЭтоПлатежКонтрагенту.ТолькоПросмотр = Истина;
		Элементы.ЭтоПлатежКонтрагенту.Видимость = Истина;
		
		Элементы.Приход.ТолькоПросмотр = Истина;

		Элементы.ЭтоЭквайринг.ТолькоПросмотр = Истина;
		Элементы.ЭтоЭквайринг.Видимость = ЭтоАдминистратор;
		
		Элементы.ЭтоКоворкинг.ТолькоПросмотр = Истина;
		Элементы.ЭтоКоворкинг.Видимость = ЭтоАдминистратор;
		
		Элементы.Возврат.ТолькоПросмотр = Истина;
		Элементы.Возврат.Видимость = ЭтоАдминистратор;
		
		Элементы.ВозвратДокумент.Видимость = ЭтоАдминистратор;
		Элементы.СуммаВозвратДокумент.Видимость = ЭтоАдминистратор;
		Элементы.СуммаОстатокВозврат.Видимость = ЭтоАдминистратор;
		
		Элементы.СуммаВозврат.Видимость = ЭтоАдминистратор;
		Элементы.СуммаОстаток.Видимость = ЭтоАдминистратор;

		Элементы.ФормаСоздатьВозврат.Доступность = Ложь;
		Элементы.ФормаСоздатьВозврат.Видимость = ЭтоАдминистратор;
		
		Элементы.Возвраты.ТолькоПросмотр = Истина;			
		Элементы.Возвраты.Видимость = ЭтоАдминистратор;	
		
		Элементы.ДолгиОплата.ТолькоПросмотр = Истина;	
		Элементы.ДолгиОплата.Видимость = ЭтоАдминистратор;	
		
	ИначеЕсли Объект.Возврат Тогда
		Элементы.ЭтоПлатежКонтрагенту.ТолькоПросмотр = Истина;
		Элементы.ЭтоПлатежКонтрагенту.Видимость = ЭтоАдминистратор;
		
		Элементы.Приход.ТолькоПросмотр = Истина;
		
		Элементы.ЭтоЭквайринг.ТолькоПросмотр = Истина;
		Элементы.ЭтоЭквайринг.Видимость = ЭтоАдминистратор;
		
		Элементы.ЭтоКоворкинг.ТолькоПросмотр = Истина;
		Элементы.ЭтоКоворкинг.Видимость = ЭтоАдминистратор;
		
		Элементы.Возврат.ТолькоПросмотр = Истина;
		Элементы.Возврат.Видимость = Истина;
		
		Элементы.ВозвратДокумент.ТолькоПросмотр = НЕ ЭтоАдминистратор;
		Элементы.ВозвратДокумент.Видимость = Истина;
		
		Элементы.СуммаОстатокВозврат.Видимость = Истина;
		Элементы.СуммаВозвратДокумент.Видимость = Истина;
		
		Элементы.СуммаВозврат.Видимость = ЭтоАдминистратор;
		Элементы.СуммаОстаток.Видимость = ЭтоАдминистратор;
		
		Элементы.ФормаСоздатьВозврат.Доступность = Ложь;
		Элементы.ФормаСоздатьВозврат.Видимость = ЭтоАдминистратор;

		Элементы.Возвраты.ТолькоПросмотр = Истина;			
		Элементы.Возвраты.Видимость = ЭтоАдминистратор;			

		Элементы.ДолгиОплата.ТолькоПросмотр = Истина;	
		Элементы.ДолгиОплата.Видимость = ЭтоАдминистратор;	
		
		СуммаВозвратОстаток = СуммаОстаткаВозврат();
		СуммаВозвратДокумент = Объект.ВозвратДокумент.Сумма;

	Иначе	
		Элементы.ЭтоПлатежКонтрагенту.ТолькоПросмотр = Истина;
		Элементы.ЭтоПлатежКонтрагенту.Видимость = ЭтоАдминистратор;
		
		Элементы.Приход.ТолькоПросмотр = Истина;
		
		Элементы.ЭтоЭквайринг.ТолькоПросмотр = Истина;
		Элементы.ЭтоЭквайринг.Видимость = Истина;
		
		Элементы.ЭтоКоворкинг.ТолькоПросмотр = Истина;
		Элементы.ЭтоКоворкинг.Видимость = Истина;
		
		Элементы.Возврат.ТолькоПросмотр = НЕ ЭтоАдминистратор;
		Элементы.Возврат.Видимость = ЭтоАдминистратор;
		
		Элементы.ВозвратДокумент.ТолькоПросмотр = НЕ ЭтоАдминистратор;
		Элементы.ВозвратДокумент.Видимость = ЭтоАдминистратор;
		
		Элементы.СуммаОстатокВозврат.Видимость = ЭтоАдминистратор;
		Элементы.СуммаВозвратДокумент.Видимость = ЭтоАдминистратор;
		
		Элементы.СуммаВозврат.Видимость = Истина;
		Элементы.СуммаОстаток.Видимость = Истина;

		Элементы.ФормаСоздатьВозврат.Доступность = Истина;
		Элементы.ФормаСоздатьВозврат.Видимость = Истина;
		
		Элементы.Возвраты.ТолькоПросмотр = НЕ ЭтоАдминистратор;	
		Элементы.Возвраты.Видимость = Истина;			
		
		Элементы.ДолгиОплата.ТолькоПросмотр = НЕ ЭтоАдминистратор;	
		Элементы.ДолгиОплата.Видимость = Истина;	
	КонецЕсли;
Иначе	
	Элементы.ЭтоПлатежКонтрагенту.ТолькоПросмотр = Истина;
	Элементы.ЭтоПлатежКонтрагенту.Видимость = ЭтоАдминистратор;
	
	Элементы.Приход.ТолькоПросмотр = Истина;
		
	Элементы.ЭтоЭквайринг.ТолькоПросмотр = Ложь;
	Элементы.ЭтоЭквайринг.Видимость = Истина;
	
	Элементы.ЭтоКоворкинг.ТолькоПросмотр = Ложь;
	Элементы.ЭтоКоворкинг.Видимость = Истина;
	
	Элементы.Возврат.ТолькоПросмотр = НЕ ЭтоАдминистратор;
	Элементы.Возврат.Видимость = ЭтоАдминистратор;
	
	Элементы.ВозвратДокумент.ТолькоПросмотр = НЕ ЭтоАдминистратор;
	Элементы.ВозвратДокумент.Видимость = ЭтоАдминистратор;
	
	Элементы.СуммаОстатокВозврат.Видимость = ЭтоАдминистратор;
	Элементы.СуммаВозвратДокумент.Видимость = ЭтоАдминистратор;
	
	Элементы.СуммаВозврат.Видимость = Истина;
	Элементы.СуммаОстаток.Видимость = Истина;
	
	Элементы.ФормаСоздатьВозврат.Доступность = Истина;
	Элементы.ФормаСоздатьВозврат.Видимость = Истина;
		
	Элементы.Возвраты.ТолькоПросмотр = НЕ ЭтоАдминистратор;	
	Элементы.Возвраты.Видимость = Истина;		
	
	Элементы.ДолгиОплата.ТолькоПросмотр = ЭтоАдминистратор;	
	Элементы.ДолгиОплата.Видимость = Истина;	
КонецЕсли;

ОтКогоНаименование = КлиентыСервер.КлиентПредставление(Объект.ОтКого);
Элементы.ОтКого.Видимость = КлиентыСервер.ЭтоЮрЛицо(Объект.ОтКого);
КонецПроцедуры

//
&НаКлиенте
Процедура ПриОткрытии(Отказ)
Если ОбщееСервер.ПроверитьДату(Объект.Дата) тогда
	//Для каждого ЭФ Из Элементы Цикл
	//	Если ЭФ.Имя="ПолеHTMLДокумента1" или ЭФ.Имя="Панель1" тогда
	//		Продолжить;
	//	конецесли;
	//	
	//	ЭФ.Доступность=Ложь;			
	//КонецЦикла; 
	
	ОбщийФункционалКлиент.ЗащититьФорму(ЭтаФорма);
	
	ПоказатьПредупреждение( ,"Документ закрыт для редактирования!");
Иначе
	//Если Не ЭтоНовый() Тогда
	Если ЗначениеЗаполнено(Объект.Ссылка) Тогда
		ПересчетДолга();
	КонецЕсли;
КонецЕсли;

Элементы.ФормаЗакрытьОткрыть.Заголовок = ?(Объект.Закрыт, "Открыть", "Закрыть");
КонецПроцедуры

&НаСервере
Процедура ПересчетДолга()
Возврат;	
	
Если НЕ ЗначениеЗаполнено(Объект.ДокументДолг) Тогда 
	Элементы.НадписьДолг.Заголовок = "";
	Элементы.НадписьДолг.ЦветТекста = ЦветаСтиля.ЦветТекстаФормы;		
	Возврат; 
КонецЕсли;
	
ЗапросДолга=Новый запрос("ВЫБРАТЬ
                         |	ЕстьNULL(ДолгиОстатки.СуммаОстаток,0) КАК СуммаОстаток
                         |ИЗ
                         |	РегистрНакопления.Долги.Остатки(
                         |		,
                         |			ДокументДолг = &Док
						 //|				И Контрагент = &Клиент
						 |) КАК ДолгиОстатки");	
ЗапросДолга.УстановитьПараметр("Док",Объект.ДокументДолг.Ссылка);
ЗапросДолга.УстановитьПараметр("Клиент", Объект.ОтКого);
ТЗДолг=ЗапросДолга.Выполнить().Выгрузить();
Если ТЗДолг.Количество()=0 тогда
	Долг=0;
иначе
	Долг=ТЗДолг[0].СуммаОстаток;
конецесли;

//Элементы.НадписьДолг.Заголовок=?(Долг <> 0,"Долг по брони "+Формат(Долг, "ЧГ="),"Долг отсутствует!");
Если Долг > 0 тогда
	Текст = "Долг по брони "+Формат(Долг, "ЧГ=");
ИначеЕсли Долг < 0 тогда
	Текст = "Переплата по брони "+Формат(-Долг, "ЧГ=");
Иначе
	Текст = "Долг отсутствует.";
КонецЕсли;	

Элементы.НадписьДолг.Заголовок = Текст;
Если Долг < 0 тогда
	Элементы.НадписьДолг.ЦветТекста = ЦветаСтиля.ЦветОсобогоТекста;
Иначе
	Элементы.НадписьДолг.ЦветТекста = ЦветаСтиля.ЦветТекстаФормы;
КонецЕсли;
КонецПроцедуры
//

//
&НаСервере
Процедура ПриЧтенииНаСервере(ТекущийОбъект)
ОбновитьДанные(ТекущийОбъект);
КонецПроцедуры

&НаСервере
Процедура ПослеЗаписиНаСервере(ТекущийОбъект, ПараметрыЗаписи)
ОбновитьДанные(ТекущийОбъект);
КонецПроцедуры

&НаСервере
Процедура ОбновитьДанные(ТекущийОбъект)
Если Объект.Возврат Тогда	
	Ответ = СуммыВозвраты();

	СуммаВозвратДокумент = Ответ.Сумма;
	СуммаВозвратДокументВозвраты = Ответ.СуммаВозвраты;
	СуммаВозвратОстаток = Ответ.СуммаОстаток;
Иначе	
	Запрос = Новый Запрос("ВЫБРАТЬ
	                      |	ВыпискаБанка.Ссылка КАК ДокументВозврата,
	                      |	ВыпискаБанка.Дата КАК ДатаВозврата,
	                      |	ВыпискаБанка.Сумма КАК СуммаВозврата
	                      |ИЗ
	                      |	Документ.ВыпискаБанка КАК ВыпискаБанка
	                      |ГДЕ
	                      |	ВыпискаБанка.ПометкаУдаления = ЛОЖЬ
	                      |	И ВыпискаБанка.ВозвратДокумент = &ВозвратДокумент
	                      |	И ВыпискаБанка.Возврат = &Возврат");

	Запрос.УстановитьПараметр("ВозвратДокумент", Объект.Ссылка);
	Запрос.УстановитьПараметр("Возврат", Истина);
	ТЗ = Запрос.Выполнить().Выгрузить();
	Возвраты.Очистить();
	Для Каждого Строка Из ТЗ Цикл
		НовыйВозврат = Возвраты.Добавить();	
		ЗаполнитьЗначенияСвойств(НовыйВозврат, Строка); 
	КонецЦикла;

	СуммаВозврат = Возвраты.Итог("СуммаВозврата");
	СуммаОстаток = Объект.Сумма - СуммаВозврат - Объект.ДолгиОплата.Итог("Сумма");
КонецЕсли;

СуммаДоЗаписи = Объект.Сумма;
КонецПроцедуры

&НаСервере
Функция СуммыВозвраты()
Запрос = Новый Запрос("ВЫБРАТЬ
                      |	ВыпискаБанка.Сумма КАК Сумма,
                      |	ЕСТЬNULL(Возвраты.Сумма, 0) КАК СуммаВозвраты,
                      |	ВыпискаБанка.Сумма - ЕСТЬNULL(Возвраты.Сумма, 0) - ЕСТЬNULL(ВыпискаБанкаДолгиОплата.Сумма, 0) КАК СуммаОстаток
                      |ИЗ
                      |	Документ.ВыпискаБанка КАК ВыпискаБанка
                      |		ЛЕВОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
                      |			ВыпискаБанка.ВозвратДокумент КАК ВозвратДокумент,
                      |			СУММА(ВыпискаБанка.Сумма) КАК Сумма
                      |		ИЗ
                      |			Документ.ВыпискаБанка КАК ВыпискаБанка
                      |		ГДЕ
                      |			ВыпискаБанка.ПометкаУдаления = ЛОЖЬ
                      |		
                      |		СГРУППИРОВАТЬ ПО
                      |			ВыпискаБанка.ВозвратДокумент) КАК Возвраты
                      |		ПО ВыпискаБанка.Ссылка = Возвраты.ВозвратДокумент
                      |		ЛЕВОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
                      |			ВыпискаБанкаДолгиОплата.Ссылка КАК Ссылка,
                      |			СУММА(ВыпискаБанкаДолгиОплата.Сумма) КАК Сумма
                      |		ИЗ
                      |			Документ.ВыпискаБанка.ДолгиОплата КАК ВыпискаБанкаДолгиОплата
                      |		
                      |		СГРУППИРОВАТЬ ПО
                      |			ВыпискаБанкаДолгиОплата.Ссылка) КАК ВыпискаБанкаДолгиОплата
                      |		ПО ВыпискаБанка.Ссылка = ВыпискаБанкаДолгиОплата.Ссылка
                      |ГДЕ
                      |	ВыпискаБанка.Ссылка = &ВозвратДокумент");

Запрос.УстановитьПараметр("ВозвратДокумент", Объект.ВозвратДокумент); 
