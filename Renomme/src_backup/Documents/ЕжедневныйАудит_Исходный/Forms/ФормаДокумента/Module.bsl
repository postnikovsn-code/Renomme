&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Элементы.ПроданныеНомераКомментарий.СписокВыбора.Добавить("Гость поздно выселен из программы");
	Элементы.ПроданныеНомераКомментарий.СписокВыбора.Добавить("Тарификация за пол суток как с 6 утра");
	Элементы.ПроданныеНомераКомментарий.СписокВыбора.Добавить("Оплата согласно брони");
	Элементы.ПроданныеНомераКомментарий.СписокВыбора.Добавить("Аннуляционный сбор");
	Элементы.ПроданныеНомераКомментарий.СписокВыбора.Добавить("Комплементарный заезд-выезд");
	Элементы.ПроданныеНомераКомментарий.СписокВыбора.Добавить("Ошибка выставления тарифа");
	Элементы.ПроданныеНомераКомментарий.СписокВыбора.Добавить("Дополнительное место");
	
	
	ТекПол = ПараметрыСеанса["ТекущийПользователь"];
	//Если ЭтоНовый() тогда
	Если НЕ ЗначениеЗаполнено(Объект.Ссылка) тогда
		//ТекПол = ОбщиеСервер.ПолучитьЗначениеПараметраСеанса("ТекущийПользователь");
		Автор=ТекПол;
		
		// + ПСН
		Объект.Дата = ТекущаяДата();
		// - ПСН
		
		ЗаполнитьТаб();
	конецесли;
	   
	Если  Объект.ПроданныеНомера.Количество()=0 тогда
		ЗаполнитьТаб();
		//Записать(РежимЗаписиДокумента.Запись);
		//ЭтотОбъект.Записать(РежимЗаписиДокумента.Запись);
		ЭтотОбъект.Записать();
	иначе
		
		если ТекПол.Админ тогда
			Элементы.Проверка.Доступность=Истина;
		иначе
			Элементы.Проверка.Доступность=Ложь;
		конецесли;
	КонецЕсли;
КонецПроцедуры

