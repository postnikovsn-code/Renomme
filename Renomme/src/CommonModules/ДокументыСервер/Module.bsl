Функция ПроверитьГрупповойСчет(ГрупповойСчет) Экспорт
Ответ = Новый Структура("Ошибка, ТекстОшибки, ТекстПредупреждения", Ложь, "", "");	
	
ДокументыДолги = ГрупповойСчет.ДокументыДолги;

ТекстОшибки = "";
НачалоМесяцаДатаПо = НачалоМесяца(ГрупповойСчет.ДатаДокумента);

Для Каждого Строка Из ДокументыДолги Цикл
	Запрос = Новый Запрос("ВЫБРАТЬ
	                      |	ЗаявкаНаБронированиеСчета.Ссылка КАК Заявка,
	                      |	ЗаявкаНаБронированиеСчета.ДатаС КАК ДатаС,
	                      |	ЗаявкаНаБронированиеСчета.ДатаПо КАК ДатаПо
	                      |ИЗ
	                      |	Документ.ЗаявкаНаБронирование.Счета КАК ЗаявкаНаБронированиеСчета
	                      |ГДЕ
	                      |	ЗаявкаНаБронированиеСчета.Ссылка = &ДокументДолг
	                      |	И ЗаявкаНаБронированиеСчета.СчетГУИД = &СчетГУИД");
	
	Запрос.УстановитьПараметр("ДокументДолг", Строка.ДокументДолг);
	Запрос.УстановитьПараметр("СчетГУИД", Строка.СчетГУИД);
	
	ТЗ = Запрос.Выполнить().Выгрузить();
	Если ТЗ.Количество() = 0 Тогда Продолжить; КонецЕсли;
	
	СтрокаТЗ = ТЗ[0];
	
	//Если ДатаПо <> Неопределено Тогда 
		//Если НачалоМесяца(СтрокаТЗ.ДатаПо) <> НачалоМесяцаДатаПо Тогда 
		//	Текст = " есть счет за другой месяц. Заявка " +  СтрокаТЗ.Заявка;
		//	ТекстОшибки = ОбщийФункционалКлиентСервер.ДобавитьТекст(ТекстОшибки, Текст, "," + Символы.ПС);
		//КонецЕсли;	
	//КонецЕсли;	
	
	Если СтрокаТЗ.Заявка.Статус = Перечисления.СтатусБрони.ОтказОтБронирования 
	ИЛИ СтрокаТЗ.Заявка.Статус = Перечисления.СтатусБрони.ОтменаБронирования 
	Тогда
		Текст = "Есть Заявка " + СтрокаТЗ.Заявка + " со статусом " + СтрокаТЗ.Заявка.Статус;
		ТекстОшибки = ОбщийФункционалКлиентСервер.ДобавитьТекст(ТекстОшибки, Текст, "," + Символы.ПС);
	КонецЕсли;
КонецЦикла;

Если ТекстОшибки <> "" Тогда
	Ответ.ТекстОшибки = ТекстОшибки;
	Ответ.Ошибка = Истина;
КонецЕсли;

ЕстьБронь = Ложь;
Для Каждого Строка Из ДокументыДолги Цикл
	Если Строка.ДокументДолг.Статус = Перечисления.СтатусБрони.Бронь Тогда
		ЕстьБронь = Истина;
		
		Прервать;
	КонецЕсли;
КонецЦикла;

ЕстьНеБронь = Ложь;
Для Каждого Строка Из ДокументыДолги Цикл
	Если Строка.ДокументДолг.Статус <> Перечисления.СтатусБрони.Бронь Тогда
		ЕстьНеБронь = Истина;
		
		Прервать;
	КонецЕсли;
КонецЦикла;

Если ЕстьБронь И ЕстьНеБронь Тогда
	Текст = "Есть Заявки со статусом 'Бронь' и НЕ 'Бронь";
	Ответ.ТекстПредупреждения = Текст;
КонецЕсли;

Возврат Ответ;
КонецФункции
