		ТоварКлиент = ТоварКлиент + ", " + Клиент2;
	КонецЕсли;
КонецЕсли;
ТоварКлиент = ТоварКлиент + ". ";

СуммаДляПечати = 0;
//НомерСтроки		Товар	Количество			ЕдиницаИзмерения		Цена				Сумма	
