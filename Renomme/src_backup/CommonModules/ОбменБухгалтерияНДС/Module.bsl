Функция МассивСтроки(ТЗСтроки, СодержаниеДополнение, СтавкаНДСЧисло)
МассивСтроки = Новый Массив;
Для Каждого СтрокаТЗСтроки Из ТЗСтроки Цикл
	Содержание = СтрокаТЗСтроки.НаименованиеТовара + СодержаниеДополнение; 
	
	Если СтрокаТЗСтроки.СуммаНДС <> 0 Тогда
		СтавкаНДС = СтавкаНДСЧисло;
	Иначе
		СтавкаНДС = 0;
	КонецЕсли;
	
	СтрокаМассива = Новый Структура("Содержание, ЭтоУслуга, СтавкаНДС"
		+ ", СуммаНДС, СуммаБезНДС, СуммаСНДС"
		+ ", Количество, Цена, ДатаУслуги"
		, Содержание, СтрокаТЗСтроки.ЭтоУслуга, СтавкаНДС
		, СтрокаТЗСтроки.СуммаНДС, СтрокаТЗСтроки.СуммаБезНДС, СтрокаТЗСтроки.СуммаСНДС
		, СтрокаТЗСтроки.Количество, СтрокаТЗСтроки.Цена, СтрокаТЗСтроки.Дата
		);
		
	МассивСтроки.Добавить(СтрокаМассива);
КонецЦикла;
	
Возврат МассивСтроки;	
