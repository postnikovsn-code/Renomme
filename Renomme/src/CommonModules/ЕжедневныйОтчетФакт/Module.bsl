                      |	ЕжедневныйОтчетФакт.Мероприятия КАК Мероприятия
                      |ИЗ
                      |	РегистрСведений.ЕжедневныйОтчетФакт КАК ЕжедневныйОтчетФакт
                      |ГДЕ
                      |	ЕжедневныйОтчетФакт.Дата = ДАТАВРЕМЯ(1, 1, 1)"); 	
	


ТЗ_Данные = Запрос.Выполнить().Выгрузить(); 
ТЗ_Данные.Колонки.Добавить("СортировкаОтель", Новый ОписаниеТипов("Число"));
Для Каждого Строка Из МассивРеноме Цикл
	НоваяСтрока = ТЗ_Данные.Добавить();
	
	ЗаполнитьЗначенияСвойств(НоваяСтрока, Строка); 
	
	НоваяСтрока.СортировкаОтель = 1; 
КонецЦикла;

Для Каждого Строка Из МассивЛайв Цикл
	НоваяСтрока = ТЗ_Данные.Добавить();
	
	ЗаполнитьЗначенияСвойств(НоваяСтрока, Строка); 
	
	НоваяСтрока.СортировкаОтель = 2; 
КонецЦикла;

Для Каждого Строка Из МассивЧехов Цикл
	НоваяСтрока = ТЗ_Данные.Добавить();
	
	ЗаполнитьЗначенияСвойств(НоваяСтрока, Строка); 
	
	НоваяСтрока.СортировкаОтель = 3; 
КонецЦикла;

Для Каждого Строка Из МассивДомСоветов Цикл
	НоваяСтрока = ТЗ_Данные.Добавить();
	
	ЗаполнитьЗначенияСвойств(НоваяСтрока, Строка); 
	
	НоваяСтрока.СортировкаОтель = 4; 
КонецЦикла;

Для Каждого Строка Из МассивСтритАрт Цикл
	НоваяСтрока = ТЗ_Данные.Добавить();
	
	ЗаполнитьЗначенияСвойств(НоваяСтрока, Строка); 
	
	НоваяСтрока.СортировкаОтель = 5; 
КонецЦикла;

ТЗ_Данные.Сортировать("Дата, СортировкаОтель"); 

ТабДок.Очистить();	

Макет = Обработки.ЕжедневныйОтчетФактСводный.ПолучитьМакет("Макет");

Область = Макет.ПолучитьОбласть("Шапка");
ТабДок.Вывести(Область);

ИтогиДень = Новый Структура;
ИтогиДень.Вставить("Дата");

ИтогиДень.Вставить("КоличествоДвухместныеРазмещения", 0);
ИтогиДень.Вставить("СуммаДвухместныеРазмещения", 0);
ИтогиДень.Вставить("ADRДвухместныеРазмещения", 0);
ИтогиДень.Вставить("ПроцентДвухместныеРазмещения", 0);
ИтогиДень.Вставить("КоличествоОдноместныеРазмещения", 0);
ИтогиДень.Вставить("СуммаОдноместныеРазмещения", 0);
ИтогиДень.Вставить("ADRОдноместныеРазмещения", 0);
ИтогиДень.Вставить("ПроцентОдноместныеРазмещения", 0);
ИтогиДень.Вставить("СуммаАгентскогоВознаграждения", 0);
ИтогиДень.Вставить("ИтогоЗанятыеНомера", 0);
ИтогиДень.Вставить("ПроцентЗаселяемости", 0);
ИтогиДень.Вставить("ИтогоСумма", 0);
ИтогиДень.Вставить("ИтогоСредняяСтоимость", 0);

Итоги = ОбщийФункционалСервер.СкопироватьСтруктуру(ИтогиДень);

ДТ = ДатаС;

ИтогиКоличество = 0;
Пока ДТ <= ДатаПо Цикл
	ИтогиДень.Дата = ДТ;
	
	ОтборСтроки = Новый Структура("Дата", ДТ);
	ТЗ_Строки = ТЗ_Данные.Скопировать(ОтборСтроки);
	ТЗ_Строки.Сортировать("Дата, СортировкаОтель"); 
	
	Если ТЗ_Строки.Количество() > 1 Тогда 
		//ТабДок.НачатьГруппуСтрок("ГруппаСтрок_1", Ложь);		
	КонецЕсли;
	
	Для Каждого Строка Из ТЗ_Строки Цикл
		Область = Макет.ПолучитьОбласть("Строка");	
	
		ОбластьПараметры = Область.Параметры; 
		
		ОбластьПараметры.Отель = Строка.Отель;
		ОбластьПараметры.КоличествоНомеров = Строка.КоличествоНомеров;
		
		//ОбластьПараметры.Дата = Формат(Строка.Дата,"ДФ=dd.MM.yy");
		ОбластьПараметры.Дата = Строка.Дата;
		ОбластьПараметры.ДеньНедели = Формат(Строка.Дата,"ДФ=дддд");
		
		ОбластьПараметры.КоличествоДвухместныеРазмещения = Строка.КоличествоДвухместныеРазмещения;
		ОбластьПараметры.СуммаДвухместныеРазмещения = Строка.СуммаДвухместныеРазмещения;
		ОбластьПараметры.КоличествоОдноместныеРазмещения = Строка.КоличествоОдноместныеРазмещения;
		ОбластьПараметры.СуммаОдноместныеРазмещения = Строка.СуммаОдноместныеРазмещения;
		ОбластьПараметры.Процент_НА = Строка.Процент_НА;
		ОбластьПараметры.ADR_НА = Строка.ADR_НА;
		
		Если Строка.КоличествоДвухместныеРазмещения = 0 Тогда
			ADRДвухместныеРазмещения = 0;	
		Иначе	
			ADRДвухместныеРазмещения = Окр((Строка.СуммаДвухместныеРазмещения / Строка.КоличествоДвухместныеРазмещения));
		КонецЕсли;
		ОбластьПараметры.ADRДвухместныеРазмещения = ADRДвухместныеРазмещения;
		
		Если Строка.КоличествоОдноместныеРазмещения = 0 Тогда
			ADRОдноместныеРазмещения = 0;	
		Иначе	
			ADRОдноместныеРазмещения = Окр((Строка.СуммаОдноместныеРазмещения / Строка.КоличествоОдноместныеРазмещения));;
		КонецЕсли;
		ОбластьПараметры.ADRОдноместныеРазмещения = ADRОдноместныеРазмещения;
		
		ИтогоЗанятыеНомера = Строка.КоличествоОдноместныеРазмещения +  Строка.КоличествоДвухместныеРазмещения;
		ОбластьПараметры.ИтогоЗанятыеНомера = ИтогоЗанятыеНомера;
		
		ПроцентЗаселяемости = Окр((ИтогоЗанятыеНомера / Строка.КоличествоНомеров) * 100);
		ОбластьПараметры.ПроцентЗаселяемости = ПроцентЗаселяемости;
		
		ИтогоСумма = Строка.СуммаОдноместныеРазмещения + Строка.СуммаДвухместныеРазмещения;
		ОбластьПараметры.ИтогоСумма = ИтогоСумма;
		Если ИтогоЗанятыеНомера = 0 Тогда
			ИтогоСредняяСтоимость = 0;
		Иначе
			ИтогоСредняяСтоимость = Окр(ИтогоСумма / ИтогоЗанятыеНомера);
		КонецЕсли;	
		ОбластьПараметры.ИтогоСредняяСтоимость = ИтогоСредняяСтоимость;
			
		ПроцентДвухместныеРазмещения = 0;
		ПроцентОдноместныеРазмещения = 0;

		Если ИтогоЗанятыеНомера = 0 Тогда
			ПроцентДвухместныеРазмещения = 0;
			ПроцентОдноместныеРазмещения = 0;
		Иначе
			ПроцентДвухместныеРазмещения = Окр((Строка.КоличествоДвухместныеРазмещения / ИтогоЗанятыеНомера) * 100);
			ПроцентОдноместныеРазмещения = Окр((Строка.КоличествоОдноместныеРазмещения / ИтогоЗанятыеНомера) * 100);
		КонецЕсли;	
		ОбластьПараметры.ПроцентДвухместныеРазмещения = ПроцентДвухместныеРазмещения;
		ОбластьПараметры.ПроцентОдноместныеРазмещения = ПроцентОдноместныеРазмещения;
		
		ОбластьПараметры.СуммаАгентскогоВознаграждения = Строка.СуммаАгентскогоВознаграждения;
		
		ОбластьПараметры.Мероприятия = Строка.Мероприятия;
		
		ТабДок.Вывести(Область);
		
		ИтогиДень.КоличествоДвухместныеРазмещения = ИтогиДень.КоличествоДвухместныеРазмещения + Строка.КоличествоДвухместныеРазмещения;
		ИтогиДень.СуммаДвухместныеРазмещения = ИтогиДень.СуммаДвухместныеРазмещения + Строка.СуммаДвухместныеРазмещения;
		ИтогиДень.КоличествоОдноместныеРазмещения = ИтогиДень.КоличествоОдноместныеРазмещения + Строка.КоличествоОдноместныеРазмещения;
		ИтогиДень.СуммаОдноместныеРазмещения = ИтогиДень.СуммаОдноместныеРазмещения + Строка.СуммаОдноместныеРазмещения;
		
		ИтогиДень.СуммаАгентскогоВознаграждения = ИтогиДень.СуммаАгентскогоВознаграждения + Строка.СуммаАгентскогоВознаграждения;
		
		ИтогиДень.ADRДвухместныеРазмещения = ИтогиДень.ADRДвухместныеРазмещения + ADRДвухместныеРазмещения;
		ИтогиДень.ADRОдноместныеРазмещения = ИтогиДень.ADRОдноместныеРазмещения + ADRОдноместныеРазмещения;
		
		ИтогиДень.ПроцентДвухместныеРазмещения = ИтогиДень.ПроцентДвухместныеРазмещения + ПроцентДвухместныеРазмещения;
		ИтогиДень.ПроцентОдноместныеРазмещения = ИтогиДень.ПроцентОдноместныеРазмещения + ПроцентОдноместныеРазмещения;
		
		ИтогиДень.ИтогоЗанятыеНомера = ИтогиДень.ИтогоЗанятыеНомера + ИтогоЗанятыеНомера;
		ИтогиДень.ПроцентЗаселяемости = ИтогиДень.ПроцентЗаселяемости + ПроцентЗаселяемости;
		
		ИтогиДень.ИтогоСумма = ИтогиДень.ИтогоСумма + ИтогоСумма;
		ИтогиДень.ИтогоСредняяСтоимость = ИтогиДень.ИтогоСредняяСтоимость + ИтогоСредняяСтоимость;
		
	КонецЦикла;
	
	Если ТЗ_Строки.Количество() > 1 Тогда 
		ТЗ_Количество = ТЗ_Строки.Количество();
		
		//ТабДок.ЗакончитьГруппуСтрок();

		Область = Макет.ПолучитьОбласть("ИтогиДень");	

		ОбластьПараметры = Область.Параметры; 
		
		ОбластьПараметры.Дата = Формат(Строка.Дата,"ДФ=dd.MM.yy");
		ОбластьПараметры.ДеньНедели = Формат(Строка.Дата,"ДФ=дддд");
		
		ОбластьПараметры.КоличествоДвухместныеРазмещения = ИтогиДень.КоличествоДвухместныеРазмещения;
		ОбластьПараметры.СуммаДвухместныеРазмещения = ИтогиДень.СуммаДвухместныеРазмещения;
		ОбластьПараметры.КоличествоОдноместныеРазмещения = ИтогиДень.КоличествоОдноместныеРазмещения;
		ОбластьПараметры.СуммаОдноместныеРазмещения = ИтогиДень.СуммаОдноместныеРазмещения;
		
		ОбластьПараметры.СуммаАгентскогоВознаграждения = ИтогиДень.СуммаАгентскогоВознаграждения;
		ОбластьПараметры.ИтогоСумма = ИтогиДень.ИтогоСумма;
		ОбластьПараметры.ИтогоЗанятыеНомера = ИтогиДень.ИтогоЗанятыеНомера;
		
		ADRДвухместныеРазмещения = Окр(ИтогиДень.ADRДвухместныеРазмещения / ТЗ_Количество);
		ОбластьПараметры.ADRДвухместныеРазмещения = ADRДвухместныеРазмещения;
		
		ADRОдноместныеРазмещения = Окр(ИтогиДень.ADRОдноместныеРазмещения / ТЗ_Количество);
		ОбластьПараметры.ADRОдноместныеРазмещения = ADRОдноместныеРазмещения;
		
		ПроцентЗаселяемости = Окр(ИтогиДень.ПроцентЗаселяемости / ТЗ_Количество);
		ОбластьПараметры.ПроцентЗаселяемости = ПроцентЗаселяемости;

		ИтогоСредняяСтоимость = Окр(ИтогиДень.ИтогоСредняяСтоимость / ТЗ_Количество);
		ОбластьПараметры.ИтогоСредняяСтоимость = ИтогоСредняяСтоимость;
		
		ПроцентДвухместныеРазмещения = Окр(ИтогиДень.ПроцентДвухместныеРазмещения / ТЗ_Количество);
		ОбластьПараметры.ПроцентДвухместныеРазмещения = ПроцентДвухместныеРазмещения;
		
		ПроцентОдноместныеРазмещения = Окр(ИтогиДень.ПроцентОдноместныеРазмещения / ТЗ_Количество);
		ОбластьПараметры.ПроцентОдноместныеРазмещения = ПроцентОдноместныеРазмещения;
		
		//ТабДок.Вывести(Область);
	Иначе
		ADRДвухместныеРазмещения = 0;
		ADRОдноместныеРазмещения = 0;
		
		ПроцентЗаселяемости = 0;

		ИтогоСредняяСтоимость = 0;
		
		ПроцентДвухместныеРазмещения = 0;
		ПроцентОдноместныеРазмещения = 0;
	КонецЕсли;
	
	Итоги.КоличествоДвухместныеРазмещения = Итоги.КоличествоДвухместныеРазмещения + ИтогиДень.КоличествоДвухместныеРазмещения;
	Итоги.СуммаДвухместныеРазмещения = Итоги.СуммаДвухместныеРазмещения + ИтогиДень.СуммаДвухместныеРазмещения;
	Итоги.КоличествоОдноместныеРазмещения = Итоги.КоличествоОдноместныеРазмещения + ИтогиДень.КоличествоОдноместныеРазмещения;
	Итоги.СуммаОдноместныеРазмещения = Итоги.СуммаОдноместныеРазмещения + ИтогиДень.СуммаОдноместныеРазмещения;
	
	Итоги.СуммаАгентскогоВознаграждения = Итоги.СуммаАгентскогоВознаграждения + ИтогиДень.СуммаАгентскогоВознаграждения;
	Итоги.ИтогоЗанятыеНомера = Итоги.ИтогоЗанятыеНомера + ИтогиДень.ИтогоЗанятыеНомера;
	Итоги.ИтогоСумма = Итоги.ИтогоСумма + ИтогиДень.ИтогоСумма;
	
	Итоги.ADRДвухместныеРазмещения = Итоги.ADRДвухместныеРазмещения + ADRДвухместныеРазмещения;
	Итоги.ADRОдноместныеРазмещения = Итоги.ADRОдноместныеРазмещения + ADRОдноместныеРазмещения;
	
	Итоги.ПроцентДвухместныеРазмещения = Итоги.ПроцентДвухместныеРазмещения + ПроцентДвухместныеРазмещения;
	Итоги.ПроцентОдноместныеРазмещения = Итоги.ПроцентОдноместныеРазмещения + ПроцентОдноместныеРазмещения;
	
	Итоги.ПроцентЗаселяемости = Итоги.ПроцентЗаселяемости + ПроцентЗаселяемости;
	
	Итоги.ИтогоСредняяСтоимость = Итоги.ИтогоСредняяСтоимость + ИтогоСредняяСтоимость;	
	
	Для Каждого Элемент Из ИтогиДень Цикл
		Если Элемент.Ключ = "Дата" 
	    Тогда ИтогиДень[Элемент.Ключ] = Неопределено; Продолжить; КонецЕсли;
		
		ИтогиДень[Элемент.Ключ] = 0;
	КонецЦикла;

	ДТ = ДТ + 24 * 60 * 60;
	
	ИтогиКоличество = ИтогиКоличество + 1; 
КонецЦикла;

Если ИтогиКоличество > 0 Тогда
	Область = Макет.ПолучитьОбласть("Итоги");	

	ОбластьПараметры = Область.Параметры; 

	ОбластьПараметры.КоличествоДвухместныеРазмещения = Итоги.КоличествоДвухместныеРазмещения;
	ОбластьПараметры.СуммаДвухместныеРазмещения = Итоги.СуммаДвухместныеРазмещения;
	ОбластьПараметры.КоличествоОдноместныеРазмещения = Итоги.КоличествоОдноместныеРазмещения;
	ОбластьПараметры.СуммаОдноместныеРазмещения = Итоги.СуммаОдноместныеРазмещения;

	ОбластьПараметры.СуммаАгентскогоВознаграждения = Итоги.СуммаАгентскогоВознаграждения;
	ОбластьПараметры.ИтогоСумма = Итоги.ИтогоСумма;
	ОбластьПараметры.ИтогоЗанятыеНомера = Итоги.ИтогоЗанятыеНомера;

	ADRДвухместныеРазмещения = Окр(Итоги.ADRДвухместныеРазмещения / ИтогиКоличество);
	ОбластьПараметры.ADRДвухместныеРазмещения = ADRДвухместныеРазмещения;

	ADRОдноместныеРазмещения = Окр(Итоги.ADRОдноместныеРазмещения / ИтогиКоличество);
	ОбластьПараметры.ADRОдноместныеРазмещения = ADRОдноместныеРазмещения;

	ПроцентЗаселяемости = Окр(Итоги.ПроцентЗаселяемости / ИтогиКоличество);
	ОбластьПараметры.ПроцентЗаселяемости = ПроцентЗаселяемости;

	ИтогоСредняяСтоимость = Окр(Итоги.ИтогоСредняяСтоимость / ИтогиКоличество);
	ОбластьПараметры.ИтогоСредняяСтоимость = ИтогоСредняяСтоимость;

	ПроцентДвухместныеРазмещения = Окр(Итоги.ПроцентДвухместныеРазмещения / ИтогиКоличество);
	ОбластьПараметры.ПроцентДвухместныеРазмещения = ПроцентДвухместныеРазмещения;

	ПроцентОдноместныеРазмещения = Окр(Итоги.ПроцентОдноместныеРазмещения / ИтогиКоличество);
	ОбластьПараметры.ПроцентОдноместныеРазмещения = ПроцентОдноместныеРазмещения;

	ТабДок.Вывести(Область);
КонецЕсли;

Возврат ТабДок;
КонецФункции

Функция ПолучитьДанныеДляЕжедневныйОтчетФактСводный(ДатаС, ДатаПо) Экспорт
ТекстОшибки = "";	
	
Ответ = ЗагрузитьHTTP_ЕжедневныйОтчетФакт(ДатаС, ДатаПо, "СерверЛайвHTTP");
Если Ответ.Ошибка Тогда
	Текст = "Данные из Лайв НЕ Загружены. " + Ответ.ТекстОшибки; 
	//Сообщить(Текст);	
	ТекстОшибки = ОбщийФункционалКлиентСервер.ДобавитьТекст(ТекстОшибки, Текст, Символы.ПС);
	
	МассивЛайв = Новый Массив;
Иначе
	МассивЛайв = Ответ.Данные;
КонецЕсли;

Ответ = ЗагрузитьHTTP_ЕжедневныйОтчетФакт(ДатаС, ДатаПо, "СерверЧеховHTTP");
Если Ответ.Ошибка Тогда
	Текст = "Данные из Чехов НЕ Загружены. " + Ответ.ТекстОшибки; 
	//Сообщить(Текст);	
	ТекстОшибки = ОбщийФункционалКлиентСервер.ДобавитьТекст(ТекстОшибки, Текст, Символы.ПС);
	
	МассивЧехов = Новый Массив;
Иначе
	МассивЧехов = Ответ.Данные;
КонецЕсли;

Ответ = ЗагрузитьHTTP_ЕжедневныйОтчетФакт(ДатаС, ДатаПо, "СерверДомСоветовHTTP");
Если Ответ.Ошибка Тогда
	Текст = "Данные из Дом Советов НЕ Загружены. " + Ответ.ТекстОшибки; 
	//Сообщить(Текст);	
	ТекстОшибки = ОбщийФункционалКлиентСервер.ДобавитьТекст(ТекстОшибки, Текст, Символы.ПС);
	
	МассивДомСоветов = Новый Массив;
Иначе
	МассивДомСоветов = Ответ.Данные;
КонецЕсли;

Ответ = ЗагрузитьHTTP_ЕжедневныйОтчетФакт(ДатаС, ДатаПо, "СерверСтритАртHTTP");
Если Ответ.Ошибка Тогда
	Текст = "Данные из СтритАрт НЕ Загружены. " + Ответ.ТекстОшибки; 
	//Сообщить(Текст);	
	ТекстОшибки = ОбщийФункционалКлиентСервер.ДобавитьТекст(ТекстОшибки, Текст, Символы.ПС);
	
	МассивСтритАрт = Новый Массив;
Иначе
	МассивСтритАрт = Ответ.Данные;
КонецЕсли;

МассивРеноме = МассивРеноме(ДатаС, ДатаПо);

Результат = Новый Структура("ТекстОшибки, ДатаС, ДатаПо, МассивЛайв, МассивРеноме, МассивЧехов, МассивДомСоветов, МассивСтритАрт"
	, ТекстОшибки, ДатаС, ДатаПо ,МассивЛайв, МассивРеноме, МассивЧехов, МассивДомСоветов, МассивСтритАрт);
Возврат Результат;	
КонецФункции

Функция ЗагрузитьHTTP_ЕжедневныйОтчетФакт(ДатаС, ДатаПо, ИмяСервера)
Ответ = Новый Структура("Ошибка, ТекстОшибки, Данные", Ложь, "", Неопределено);	
	
Результат = HTTP_Модуль.ПолучитьЕжедневныйОтчетФакт(ДатаС, ДатаПо, ИмяСервера);
Если Результат.Ошибка Тогда
	Ответ.Ошибка = Истина;
	Ответ.ТекстОшибки = "Ошибка соединения с HTTP сервисом " + ИмяСервера + ". ОБРАТИТЕСЬ К АДМИНИСТРАТОРУ ПРОГРАММЫ." + Символы.ПС
		+ Результат.ТекстОшибки;
	
	Возврат Ответ; 
КонецЕсли;

Если Результат.Данные = Неопределено Тогда 
	Ответ.Ошибка = Истина;
	Ответ.ТекстОшибки = "Ошибка подготовки данных в HTTP сервисе " + ИмяСервера + ". ОБРАТИТЕСЬ К АДМИНИСТРАТОРУ ПРОГРАММЫ."; 	
	
	Возврат Ответ; 
КонецЕсли;

//ЗагрузитьЗаселенияНаСервере("ЗаселенияВЛайв", Результат.Данные);
Ответ.Данные = Результат.Данные;
Возврат Ответ;
КонецФункции

Функция МассивРеноме(ДатаС, ДатаПо)
ТЗ_ОтчетДанные = ЕжедневныйОтчетФакт.ТЗ_ОтчетДанные(ДатаС, ДатаПо);	
	
ЕжедневныйОтчетФакт.ЗаполнитьРегистрЕжедневныйОтчетФакт(ТЗ_ОтчетДанные);

ТЗ = ЕжедневныйОтчетФакт.РегистрЕжедневныйОтчетФактВыгрузить(ДатаС, ДатаПо);

МассивРеноме = ОбщийФункционалСервер.ТаблицаЗначенийВМассивСтруктур(ТЗ);

Возврат МассивРеноме;
КонецФункции
