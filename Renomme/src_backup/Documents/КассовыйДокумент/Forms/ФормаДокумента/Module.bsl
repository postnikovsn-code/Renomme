&НаКлиенте
Процедура ПередЗаписью(Отказ, ПараметрыЗаписи)
Ответ = ТекстОшибки();
Если ЗначениеЗаполнено(Ответ) Тогда
	ТекстПредупреждение = Ответ.ТекстПредупреждение;
	ТекстСообщение = Ответ.ТекстСообщение; 
	
	ТекстПредупреждение = "ОШИБОЧНЫЕ ДАННЫЕ" + Символы.ПС + ТекстПредупреждение;	
	ТекстПредупреждение = ТекстПредупреждение + Символы.ПС + "Документ НЕ сохранен";	
	ПоказатьПредупреждение(, ТекстПредупреждение); 
	
	ТекстСообщение = "ОШИБОЧНЫЕ ДАННЫЕ: " + ТекстСообщение;	
	ТекстСообщение = ТекстСообщение + ". Документ НЕ сохранен.";	
	Сообщить(ТекстСообщение);
	
	Отказ = Истина;
КонецЕсли;
КонецПроцедуры

&НаСервере
Функция ТекстОшибки()
ДокументОбъект = РеквизитФормыВЗначение("Объект");
ТекстОшибки = ДокументОбъект.ТекстОшибки();

Если НЕ Объект.Возврат Тогда Перейти ~ВЫХОД; КонецЕсли;

Запрос = Новый Запрос ("ВЫБРАТЬ
                       |	КассовыйДокумент.Ссылка КАК ДокументОплаты,
                       |	КассовыйДокумент.Сумма - ЕСТЬNULL(Возвраты.Сумма, 0) - ЕСТЬNULL(Долги.Сумма, 0) КАК ОстатокОплаты
                       |ИЗ
                       |	Документ.КассовыйДокумент КАК КассовыйДокумент
                       |		ЛЕВОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
                       |			КассовыйДокумент.ВозвратДокумент КАК ВозвратДокумент,
                       |			СУММА(КассовыйДокумент.Сумма) КАК Сумма
                       |		ИЗ
                       |			Документ.КассовыйДокумент КАК КассовыйДокумент
                       |		ГДЕ
                       |			КассовыйДокумент.ПометкаУдаления = ЛОЖЬ
                       |		
                       |		СГРУППИРОВАТЬ ПО
                       |			КассовыйДокумент.ВозвратДокумент) КАК Возвраты
                       |		ПО (КассовыйДокумент.Ссылка = КассовыйДокумент.ВозвратДокумент)
                       |		ЛЕВОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
                       |			КассовыйДокументДолгиОплата.Ссылка КАК Ссылка,
                       |			СУММА(КассовыйДокументДолгиОплата.Сумма) КАК Сумма
                       |		ИЗ
                       |			Документ.КассовыйДокумент.ДолгиОплата КАК КассовыйДокументДолгиОплата
                       |		
                       |		СГРУППИРОВАТЬ ПО
                       |			КассовыйДокументДолгиОплата.Ссылка) КАК Долги
                       |		ПО КассовыйДокумент.Ссылка = Долги.Ссылка
                       |ГДЕ
                       |	ИСТИНА
                       |	И КассовыйДокумент.Ссылка = &ВозвратДокумент");

Запрос.УстановитьПараметр("ВозвратДокумент", Объект.ВозвратДокумент);

Выборка = Запрос.Выполнить().Выбрать();
Если Выборка.Следующий() Тогда
	ОстатокОплаты = Выборка.ОстатокОплаты;
Иначе
	Перейти ~ВЫХОД;
КонецЕсли;

Если ОстатокОплаты < Объект.Сумма Тогда
	ТекстОшибки_П = "Остаток оплаты < Сумма возврата";
	
	Если ТекстОшибки = Неопределено Тогда 
		ТекстОшибки = Новый Структура("ТекстПредупреждение, ТекстСообщение", ТекстОшибки_П, ТекстОшибки_П);
	Иначе
		ТекстПредупреждение = ОбщийФункционалКлиентСервер.ДобавитьТекст(ТекстОшибки.ТекстПредупреждение, ТекстОшибки_П, Символы.ПС); 
		ТекстСообщение = ОбщийФункционалКлиентСервер.ДобавитьТекст(ТекстОшибки.ТекстСообщение, ТекстОшибки_П, " "); 
		
		ТекстОшибки.ТекстПредупреждение = ТекстПредупреждение;
		ТекстОшибки.ТекстСообщение = ТекстСообщение;
	КонецЕсли;
КонецЕсли;

 ~ВЫХОД:

Возврат ТекстОшибки;	
КонецФункции	

