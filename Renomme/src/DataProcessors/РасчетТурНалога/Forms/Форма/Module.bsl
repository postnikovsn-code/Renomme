
&НаКлиенте
Процедура ДатаРасчетаПриИзменении(Элемент)
	ДатаРасчета = КонецМесяца(ДатаРасчета);
КонецПроцедуры

&НаКлиенте
Процедура РасчитатьТурНалог(Команда)
	РасчитатьТурНалогНаСервере();
КонецПроцедуры

//
&НаСервере
Процедура РасчитатьТурНалогНаСервере()
ЗаполнитьТурНалогЗаявки();

СуммаПроживаниеИтого = ТурНалогДетально.Итог("СуммаПроживание");
СуммаОплатыИтого = ТурНалогДетально.Итог("СуммаОплаты");
СуммаТурНалогИтого = ТурНалогДетально.Итог("СуммаТурНалог");

//ЗаполнитьТурналогИстория();

//СуммаТурНалогИзмененияИтого = ТурНалогДетальноИзменения.Итог("СуммаТурНалог");
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьТурНалогЗаявки()

Запрос = Новый Запрос("ВЫБРАТЬ
                      |	""Начисление"" КАК ТипОперации,
                      |	ЗаявкаНаБронирование.Ссылка КАК ДокументДолг,
                      |	ЗаявкаНаБронирование.Номер КАК НомерДокумента,
                      |	ЗаявкаНаБронирование.Дата КАК ДатаДокумента,
                      |	ЗаявкаНаБронирование.РезервС КАК РезервС,
                      |	ЗаявкаНаБронирование.РезервПо КАК РезервПо,
                      |	ЗаявкаНаБронирование.Статус КАК Статус,
                      |	ЗаявкаНаБронирование.Оплачивает КАК Оплачивает,
                      |	ЗаявкаНаБронирование.Оплачивает.Турагентство КАК ОплачиваетТурагентство,
                      |	ЗаявкаНаБронирование.Бронирует.Турагентство КАК БронируетТурагентство,
                      |	СчетаЗаявка.ДатаСМинимум КАК ДатаС,
                      |	СчетаЗаявка.ДатаПоМаксимум КАК ДатаПо,
                      |	ОплатыЗаявка.СуммаОплаты КАК СуммаОплаты,
                      |	ОплатыЗаявка.ДатаОплатыМаксимум КАК ДатаОплатыМаксимум,
                      |	ПроживаниеЗаявка.ПроживаниеСуммаДолг КАК ПроживаниеСуммаДолг,
                      |	ПроживаниеЗаявка.ПроживаниеСумма КАК ПроживаниеСумма,
                      |	ПроживаниеЗаявка.ПроживаниеСуммаБезСкидки КАК ПроживаниеСуммаБезСкидки,
                      |	УслугиЗаявка.УслугиСумма КАК УслугиСумма,
                      |	ВЫБОР
                      |		КОГДА ЗаявкаНаБронирование.Оплачивает.Турагентство
                      |			ТОГДА СчетаЗаявка.ДатаСМинимум
                      |		ИНАЧЕ ОплатыЗаявка.ДатаОплатыМаксимум
                      |	КОНЕЦ КАК ДатаОплаты,
                      |	ВЫБОР
                      |		КОГДА ЗаявкаНаБронирование.Оплачивает.Турагентство
                      |			ТОГДА ""Оплата Турагентством""
                      |		КОГДА ЗаявкаНаБронирование.Оплачивает.Турагентство
                      |			ТОГДА ""Оплата НЕ Турагентством""
                      |		КОГДА ЗаявкаНаБронирование.Оплачивает.ТипКлиента = ЗНАЧЕНИЕ(Перечисление.ТипыКлиентов.ЮрЛицо)
                      |			ТОГДА ""Оплата Юр. лицом""
                      |		КОГДА ЗаявкаНаБронирование.Оплачивает.ТипКлиента = ЗНАЧЕНИЕ(Перечисление.ТипыКлиентов.ФизЛицо)
                      |			ТОГДА ""Оплата Физ. лицом""
                      |	КОНЕЦ КАК ТипОплаты,
                      |	ВЫБОР
                      |		КОГДА ОплатыЗаявка.ДатаОплатыМаксимум < ЗаявкаНаБронирование.РезервС
                      |			ТОГДА ИСТИНА
                      |		ИНАЧЕ ЛОЖЬ
                      |	КОНЕЦ КАК Предоплата,
                      |	ВЫБОР
                      |		КОГДА РАЗНОСТЬДАТ(СчетаЗаявка.ДатаСМинимум, СчетаЗаявка.ДатаПоМаксимум, ДЕНЬ) <= 0
                      |			ТОГДА 1
                      |		ИНАЧЕ РАЗНОСТЬДАТ(СчетаЗаявка.ДатаСМинимум, СчетаЗаявка.ДатаПоМаксимум, ДЕНЬ)
                      |	КОНЕЦ КАК КоличествоДней,
                      |	ЕСТЬNULL(ВЫБОР
                      |			КОГДА ЗаявкаНаБронирование.Оплачивает.Турагентство
                      |				ТОГДА ПроживаниеЗаявка.ПроживаниеСуммаБезСкидки
                      |			ИНАЧЕ ПроживаниеЗаявка.ПроживаниеСумма
                      |		КОНЕЦ, 0) + ЕСТЬNULL(УслугиЗаявка.УслугиСумма, 0) КАК СуммаПроживание,
                      |	ВЫРАЗИТЬ((ЕСТЬNULL(ВЫБОР
                      |				КОГДА ЗаявкаНаБронирование.Оплачивает.Турагентство
                      |					ТОГДА ПроживаниеЗаявка.ПроживаниеСуммаБезСкидки
                      |				ИНАЧЕ ПроживаниеЗаявка.ПроживаниеСумма
                      |			КОНЕЦ, 0) + ЕСТЬNULL(УслугиЗаявка.УслугиСумма, 0)) * &К1 / &К2 КАК ЧИСЛО) КАК Сумма_1,
                      |	(ВЫРАЗИТЬ(100 КАК ЧИСЛО)) * ВЫБОР
                      |		КОГДА РАЗНОСТЬДАТ(СчетаЗаявка.ДатаСМинимум, СчетаЗаявка.ДатаПоМаксимум, ДЕНЬ) <= 0
                      |			ТОГДА 1
                      |		ИНАЧЕ РАЗНОСТЬДАТ(СчетаЗаявка.ДатаСМинимум, СчетаЗаявка.ДатаПоМаксимум, ДЕНЬ)
                      |	КОНЕЦ КАК Сумма_100,
                      |	ВЫРАЗИТЬ(ВЫБОР
                      |			КОГДА (ЕСТЬNULL(ВЫБОР
                      |						КОГДА ЗаявкаНаБронирование.Оплачивает.Турагентство
                      |							ТОГДА ПроживаниеЗаявка.ПроживаниеСуммаБезСкидки
                      |						ИНАЧЕ ПроживаниеЗаявка.ПроживаниеСумма
                      |					КОНЕЦ, 0) + ЕСТЬNULL(УслугиЗаявка.УслугиСумма, 0)) * &К1 / &К2 > 100 * ВЫБОР
                      |					КОГДА РАЗНОСТЬДАТ(СчетаЗаявка.ДатаСМинимум, СчетаЗаявка.ДатаПоМаксимум, ДЕНЬ) <= 0
                      |						ТОГДА 1
                      |					ИНАЧЕ РАЗНОСТЬДАТ(СчетаЗаявка.ДатаСМинимум, СчетаЗаявка.ДатаПоМаксимум, ДЕНЬ)
                      |				КОНЕЦ
                      |				ТОГДА (ЕСТЬNULL(ВЫБОР
                      |							КОГДА ЗаявкаНаБронирование.Оплачивает.Турагентство
                      |								ТОГДА ПроживаниеЗаявка.ПроживаниеСуммаБезСкидки
                      |							ИНАЧЕ ПроживаниеЗаявка.ПроживаниеСумма
                      |						КОНЕЦ, 0) + ЕСТЬNULL(УслугиЗаявка.УслугиСумма, 0)) * &К1 / &К2
                      |			ИНАЧЕ 100 * ВЫБОР
                      |					КОГДА РАЗНОСТЬДАТ(СчетаЗаявка.ДатаСМинимум, СчетаЗаявка.ДатаПоМаксимум, ДЕНЬ) <= 0
                      |						ТОГДА 1
                      |					ИНАЧЕ РАЗНОСТЬДАТ(СчетаЗаявка.ДатаСМинимум, СчетаЗаявка.ДатаПоМаксимум, ДЕНЬ)
                      |				КОНЕЦ
                      |		КОНЕЦ КАК ЧИСЛО) КАК СуммаТурНалог,
                      |	ГрупповыеСчета_ДокументДолг.ДокументДолг КАК ГруппповыеСчетаДокументДолг
                      |ИЗ
                      |	Документ.ЗаявкаНаБронирование КАК ЗаявкаНаБронирование
                      |		ВНУТРЕННЕЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
                      |			ЗаявкаНаБронированиеСчета.Ссылка КАК Ссылка,
                      |			МИНИМУМ(ЗаявкаНаБронированиеСчета.ДатаС) КАК ДатаСМинимум,
                      |			МАКСИМУМ(ЗаявкаНаБронированиеСчета.ДатаПо) КАК ДатаПоМаксимум
                      |		ИЗ
                      |			Документ.ЗаявкаНаБронирование.Счета КАК ЗаявкаНаБронированиеСчета
                      |		
                      |		СГРУППИРОВАТЬ ПО
                      |			ЗаявкаНаБронированиеСчета.Ссылка) КАК СчетаЗаявка
                      |		ПО ЗаявкаНаБронирование.Ссылка = СчетаЗаявка.Ссылка
                      |		ЛЕВОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
                      |			ЗаявкаНаБронированиеРаспределениеОплатДолги.Ссылка КАК Ссылка,
                      |			СУММА(ЗаявкаНаБронированиеРаспределениеОплатДолги.СуммаОплаты) КАК СуммаОплаты,
                      |			МАКСИМУМ(ЗаявкаНаБронированиеРаспределениеОплатДолги.ДокументОплаты.ДатаОплаты) КАК ДатаОплатыМаксимум
                      |		ИЗ
                      |			Документ.ЗаявкаНаБронирование.РаспределениеОплатДолги КАК ЗаявкаНаБронированиеРаспределениеОплатДолги
                      |				ВНУТРЕННЕЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
                      |					ЗаявкаНаБронированиеСчетаДетальноДолги.Ссылка КАК Ссылка,
                      |					ЗаявкаНаБронированиеСчетаДетальноДолги.СчетГУИД КАК СчетГУИД
                      |				ИЗ
                      |					Документ.ЗаявкаНаБронирование.СчетаДетальноДолги КАК ЗаявкаНаБронированиеСчетаДетальноДолги
                      |				ГДЕ
                      |					(ЗаявкаНаБронированиеСчетаДетальноДолги.Услуга = ЛОЖЬ
                      |							ИЛИ ЗаявкаНаБронированиеСчетаДетальноДолги.Услуга = ИСТИНА
                      |								И ЗаявкаНаБронированиеСчетаДетальноДолги.ПрограммныйКодУслуги = ЗНАЧЕНИЕ(Перечисление.ПрограммныйКодУслуги.ПРОЖИВАНИЕ_УСЛУГИ))
                      |				
                      |				СГРУППИРОВАТЬ ПО
                      |					ЗаявкаНаБронированиеСчетаДетальноДолги.Ссылка,
                      |					ЗаявкаНаБронированиеСчетаДетальноДолги.СчетГУИД) КАК СчетаДетальноДолгиЗаявка
                      |				ПО ЗаявкаНаБронированиеРаспределениеОплатДолги.Ссылка = СчетаДетальноДолгиЗаявка.Ссылка
                      |					И ЗаявкаНаБронированиеРаспределениеОплатДолги.СчетГУИД = СчетаДетальноДолгиЗаявка.СчетГУИД
                      |		ГДЕ
                      |			ТИПЗНАЧЕНИЯ(ЗаявкаНаБронированиеРаспределениеОплатДолги.ДокументОплаты) <> ТИП(Документ.ПрочиеОплаты)
                      |		
                      |		СГРУППИРОВАТЬ ПО
                      |			ЗаявкаНаБронированиеРаспределениеОплатДолги.Ссылка) КАК ОплатыЗаявка
                      |		ПО ЗаявкаНаБронирование.Ссылка = ОплатыЗаявка.Ссылка
                      |		ЛЕВОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
                      |			ЗаявкаНаБронированиеСчетаДетальноДолги.Ссылка КАК Ссылка,
                      |			СУММА(ЕСТЬNULL(ЗаявкаНаБронированиеСчетаДетальноДолги.СуммаДолг, 0)) КАК ПроживаниеСуммаДолг,
                      |			СУММА(ЕСТЬNULL(ЗаявкаНаБронированиеПроживание.Сумма, 0)) КАК ПроживаниеСумма,
                      |			СУММА(ЕСТЬNULL(ЗаявкаНаБронированиеПроживание.СуммаБезСкидки, 0)) КАК ПроживаниеСуммаБезСкидки
                      |		ИЗ
                      |			Документ.ЗаявкаНаБронирование.СчетаДетальноДолги КАК ЗаявкаНаБронированиеСчетаДетальноДолги
                      |				ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.ЗаявкаНаБронирование.Проживание КАК ЗаявкаНаБронированиеПроживание
                      |				ПО ЗаявкаНаБронированиеСчетаДетальноДолги.Ссылка = ЗаявкаНаБронированиеПроживание.Ссылка
                      |					И ЗаявкаНаБронированиеСчетаДетальноДолги.ДолгиГУИД = ЗаявкаНаБронированиеПроживание.ГУИД
                      |		ГДЕ
                      |			ЗаявкаНаБронированиеСчетаДетальноДолги.Услуга = ЛОЖЬ
                      |		
                      |		СГРУППИРОВАТЬ ПО
                      |			ЗаявкаНаБронированиеСчетаДетальноДолги.Ссылка) КАК ПроживаниеЗаявка
                      |		ПО ЗаявкаНаБронирование.Ссылка = ПроживаниеЗаявка.Ссылка
                      |		ЛЕВОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
                      |			ЗаявкаНаБронированиеСчетаДетальноДолги.Ссылка КАК Ссылка,
                      |			ЗаявкаНаБронированиеСчетаДетальноДолги.СчетГУИД КАК СчетГУИД,
                      |			СУММА(ЕСТЬNULL(ЗаявкаНаБронированиеСчетаДетальноДолги.СуммаОплачено, 0)) КАК СуммаОплачено,
                      |			СУММА(ЕСТЬNULL(ЗаявкаНаБронированиеДопУслуги.Цена * ЗаявкаНаБронированиеДопУслуги.Количество, 0)) КАК УслугиСумма
                      |		ИЗ
                      |			Документ.ЗаявкаНаБронирование.СчетаДетальноДолги КАК ЗаявкаНаБронированиеСчетаДетальноДолги
                      |				ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.ЗаявкаНаБронирование.ДопУслуги КАК ЗаявкаНаБронированиеДопУслуги
                      |					ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.ДопУслуги КАК ДопУслуги
                      |					ПО ЗаявкаНаБронированиеДопУслуги.Услуга = ДопУслуги.Ссылка
                      |				ПО ЗаявкаНаБронированиеСчетаДетальноДолги.Ссылка = ЗаявкаНаБронированиеДопУслуги.Ссылка
                      |					И ЗаявкаНаБронированиеСчетаДетальноДолги.ДолгиГУИД = ЗаявкаНаБронированиеДопУслуги.ГУИД
                      |		ГДЕ
                      |			ЗаявкаНаБронированиеСчетаДетальноДолги.Услуга = ИСТИНА
                      |			И ДопУслуги.ПрограммныйКод = ЗНАЧЕНИЕ(Перечисление.ПрограммныйКодУслуги.ПРОЖИВАНИЕ_УСЛУГИ)
                      |		
                      |		СГРУППИРОВАТЬ ПО
                      |			ЗаявкаНаБронированиеСчетаДетальноДолги.Ссылка,
                      |			ЗаявкаНаБронированиеСчетаДетальноДолги.СчетГУИД) КАК УслугиЗаявка
                      |		ПО ЗаявкаНаБронирование.Ссылка = УслугиЗаявка.Ссылка
                      |		ЛЕВОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
                      |			ГрупповыеСчетаДокументыДолги.ДокументДолг КАК ДокументДолг
                      |		ИЗ
                      |			Документ.ГрупповыеСчета.ДокументыДолги КАК ГрупповыеСчетаДокументыДолги
                      |				ВНУТРЕННЕЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
                      |					ГрупповыеСчетаДокументыДолги.Ссылка КАК Ссылка,
                      |					КОЛИЧЕСТВО(РАЗЛИЧНЫЕ ГрупповыеСчетаДокументыДолги.ДокументДолг.РезервС) КАК КоличествоРазличныхДокументДолгРезервС,
                      |					КОЛИЧЕСТВО(РАЗЛИЧНЫЕ ГрупповыеСчетаДокументыДолги.ДокументДолг.РезервПо) КАК КоличествоРазличныхДокументДолгРезервПо,
                      |					КОЛИЧЕСТВО(ГрупповыеСчетаДокументыДолги.СчетГУИД) КАК КоличествоДокументДолг
                      |				ИЗ
                      |					Документ.ГрупповыеСчета.ДокументыДолги КАК ГрупповыеСчетаДокументыДолги
                      |				
                      |				СГРУППИРОВАТЬ ПО
                      |					ГрупповыеСчетаДокументыДолги.Ссылка) КАК ГрупповыеСчета_Различные
                      |				ПО ГрупповыеСчетаДокументыДолги.Ссылка = ГрупповыеСчета_Различные.Ссылка
                      |		ГДЕ
                      |			ВЫБОР
                      |					КОГДА ГрупповыеСчета_Различные.КоличествоРазличныхДокументДолгРезервС = 1
                      |								И ГрупповыеСчета_Различные.КоличествоРазличныхДокументДолгРезервПо = 1
                      |							ИЛИ ГрупповыеСчета_Различные.КоличествоДокументДолг = 1
                      |						ТОГДА ИСТИНА
                      |					ИНАЧЕ ЛОЖЬ
                      |				КОНЕЦ) КАК ГрупповыеСчета_ДокументДолг
                      |		ПО ЗаявкаНаБронирование.Ссылка = ГрупповыеСчета_ДокументДолг.ДокументДолг
                      |ГДЕ
                      |	ИСТИНА
                      |	И ЗаявкаНаБронирование.ПометкаУдаления = ЛОЖЬ
                      |	И ЗаявкаНаБронирование.Статус <> ЗНАЧЕНИЕ(Перечисление.СтатусБрони.ОтменаБронирования)
                      |	И ЗаявкаНаБронирование.Статус <> ЗНАЧЕНИЕ(Перечисление.СтатусБрони.ОтказОтБронирования)
