Функция ПечатьУПДНаСервере(ТС, ДокументОбъект) Экспорт
Счет = ДокументОбъект.Счета.НайтиПоИдентификатору(ТС);

НомерАктаДатаАкта = ПечатьСервер.НомерДатаДокумента(ДокументОбъект, Счет.НомерСчета, Счет.ДатаПо);
Номер = НомерАктаДатаАкта.Номер;
Дата =  НомерАктаДатаАкта.Дата;

ДокументОтгрузки = "Акт № " + Номер + " от " + Формат(Дата, "ДФ=dd.MM.yyyy"); 
	
ТабДок = ПечатьСервер.ПечатьУПД(Номер, Дата, ДокументОбъект.Ссылка, Счет);

Возврат ТабДок;	
КонецФункции

Функция ПечатьУПД(Номер, Дата, Заявка, Счет) Экспорт
ТабДок = Новый ТабличныйДокумент;	
	
Макет = ПолучитьОбщийМакет("ПФ_MXL_УниверсальныйПередаточныйДокумент2026");

ТекущаяОрганизация = НастройкиСервер.ПолучитьТекущуюОрганизацию();
СтавкаНДС = ТекущаяОрганизация.СтавкаНДС; 
//ДатаУчетаНДС = Счет.Ссылка.РезервПо; 
ДатаУчетаНДС = Счет.ДатаПо;

СтавкаНДС = ДокументыСервер.СтавкаНДСТекущая(СтавкаНДС, ДатаУчетаНДС);
ВсеСНДС = ТекущаяОрганизация.ВсеСНДС; 

Область = Макет.ПолучитьОбласть("Шапка");

Область.Параметры.СтатусУПД = 1;

Область.Параметры.Номер = Номер;
Область.Параметры.Дата = Формат(Дата, "ДФ=dd.MM.yyyy");

ДокументОтгрузки = "Акт № " + Номер + " от " + Формат(Дата, "ДФ=dd.MM.yyyy"); 
Область.Параметры.ДокументыОбОтгрузке = ДокументОтгрузки;
	
Продавец = ТекущаяОрганизация.ОрганизацияДляДокументов;
АдресПродавца = ТекущаяОрганизация.ОрганизацияАдресДляДокументов;
ИННКПППродавца = ТекущаяОрганизация.ИНН + "/" + ТекущаяОрганизация.КПП;

Область.Параметры.ПредставлениеПоставщика = Продавец;
Область.Параметры.АдресПоставщика = АдресПродавца;
Область.Параметры.ИННПоставщика	 = ИННКПППродавца;

Контрагент = Счет.Контрагент;
Область.Параметры.ПредставлениеПокупателя = ?(ЗначениеЗаполнено(Контрагент.НаименованиеЮрЛица)
									, Контрагент.НаименованиеЮрЛица, Контрагент.Наименование);
Область.Параметры.АдресПокупателя = Контрагент.Адрес;
Область.Параметры.ИННПокупателя	 = Контрагент.ИНН + "/" + Контрагент.КПП;

ТабДок.Вывести(Область);

Область = Макет.ПолучитьОбласть("ЗаголовокТаблицы");
ТабДок.Вывести(Область);

ОтборСтроки = Новый Структура("СчетГУИД", Счет.СчетГУИД);
СчетаДетальноДолги_П = Заявка.СчетаДетальноДолги.НайтиСтроки(ОтборСтроки);
ИтогиЗаявка = ИтогиЗаявка(СчетаДетальноДолги_П, СтавкаНДС, ВсеСНДС);

ВсегоСуммаПроживание = ИтогиЗаявка.СуммаПроживание;
ВсегоКоличествоПроживание = ИтогиЗаявка.КоличествоПроживание;
ВсегоСуммаУслуги = ИтогиЗаявка.СуммаУслуги;
ВсегоСуммаНДС = ИтогиЗаявка.СуммаНДС;

//ТЗ = СчетФактураСтроки(СчетаДетальноДолги, СвернутьВСчете);


ТЗСтроки = ПечатьСервер.УПДСтроки(Заявка, Счет);


ИтогоСумма = 0;
ИтогоСуммаБезНДС = 0;
ИтогоСуммаНДС = 0;
	
Для Каждого Строка Из ТЗСтроки Цикл
	Область = Макет.ПолучитьОбласть("Строка");
	
	Область.Параметры.НомерСтроки = Строка.НомерСтроки;
	
	Область.Параметры.ТоварНаименование = Строка.НаименованиеТовара; 
	
	Область.Параметры.ЕдиницаИзмеренияКод =Строка.КодЕдиницыИзмерения;
	Область.Параметры.ЕдиницаИзмерения = Строка.ЕдиницаИзмерения;
	
	Область.Параметры.Количество = Строка.Количество;
	Область.Параметры.Цена = Строка.Цена;
	
	Область.Параметры.Стоимость = Строка.СуммаБезНДС;
	
	Область.Параметры.СтавкаНДС = Строка.НалоговаяСтавка;

	Область.Параметры.СуммаНДС = Строка.СуммаНДС;
	Область.Параметры.Всего = Строка.СуммаСНДС;
	
	ТабДок.Вывести(Область);
	
	ИтогоСуммаБезНДС = ИтогоСуммаБезНДС + Строка.СуммаБезНДС;
	ИтогоСуммаНДС = ИтогоСуммаНДС + Строка.СуммаНДС;
	ИтогоСумма = ИтогоСумма + Строка.СуммаСНДС;
КонецЦикла;
	
Область = Макет.ПолучитьОбласть("Итого");

Область.Параметры.ИтогоСтоимость = ИтогоСуммаБезНДС;
Область.Параметры.ИтогоСуммаНДС = ИтогоСуммаНДС;
Область.Параметры.ИтогоВсего = ИтогоСумма;

ТабДок.Вывести(Область);

Область = Макет.ПолучитьОбласть("Подвал");

Область.Параметры.ФИОРуководителя =  ТекущаяОрганизация.ОрганизацияФИОРуководительДляДокументов;
Область.Параметры.ФИОГлавногоБухгалтера =  ТекущаяОрганизация.ОрганизацияФИОБухгалтерДляСчетаФактуры;

ТабДок.Вывести(Область);

ТабДок.ОриентацияСтраницы = ОриентацияСтраницы.Ландшафт;
ТабДок.АвтоМасштаб = Истина;

Возврат ТабДок;
КонецФункции

Функция УПДСтроки(ДокументДолгСсылка, Счет) Экспорт
ОтборСтроки = Новый Структура("СчетГУИД", Счет.СчетГУИД);
СчетаДетальноДолги = ДокументДолгСсылка.СчетаДетальноДолги.НайтиСтроки(ОтборСтроки);

СвернутьВСчете = Счет.СвернутьВСчете;

ТекущаяОрганизация = НастройкиСервер.ПолучитьТекущуюОрганизацию();
СтавкаНДС = ТекущаяОрганизация.СтавкаНДС; 
ДатаУчетаНДС = ДокументДолгСсылка.РезервПо;
СтавкаНДС = ДокументыСервер.СтавкаНДСТекущая(СтавкаНДС, ДатаУчетаНДС);
ВсеСНДС = ТекущаяОрганизация.ВсеСНДС; 

ИтогиЗаявка = ИтогиЗаявка(СчетаДетальноДолги, СтавкаНДС, ВсеСНДС);

ВсегоСуммаПроживание = ИтогиЗаявка.СуммаПроживание;
ВсегоКоличествоПроживание = ИтогиЗаявка.КоличествоПроживание;
ВсегоСуммаУслуги = ИтогиЗаявка.СуммаУслуги;
ВсегоСуммаНДС = ИтогиЗаявка.СуммаНДС;

ТЗ = Новый ТаблицаЗначений;
ТЗ.Колонки.Добавить("НомерСтроки");
ТЗ.Колонки.Добавить("НаименованиеТовара");
ТЗ.Колонки.Добавить("КодЕдиницыИзмерения");
ТЗ.Колонки.Добавить("ЕдиницаИзмерения");
ТЗ.Колонки.Добавить("Количество");
ТЗ.Колонки.Добавить("Цена");
ТЗ.Колонки.Добавить("НалоговаяСтавка");
ТЗ.Колонки.Добавить("СуммаНДС");
ТЗ.Колонки.Добавить("СуммаБезНДС");
ТЗ.Колонки.Добавить("СуммаСНДС");
ТЗ.Колонки.Добавить("ЭтоУслуга");
ТЗ.Колонки.Добавить("Дата");

ТоварКлиент = ТоварКлиент(ДокументДолгСсылка, Счет); 

сч =0;
Если СвернутьВСчете Тогда
	СтрокаТЗ = ТЗ.Добавить();
	
	СтрокаТЗ.НомерСтроки = сч;
	
	ДатаС = ИтогиЗаявка.ДатаС_Проживание; 
	Если ЗначениеЗаполнено(ДатаС) Тогда
		ДатаПо = ИтогиЗаявка.ДатаПо_Проживание + 24 * 60 * 60;
	Иначе 
		ДатаС = ИтогиЗаявка.ДатаС_Услуги; 
		Если ЗначениеЗаполнено(ДатаС) Тогда
			ДатаПо = ИтогиЗаявка.ДатаПо_Услуги;
		КонецЕсли;
	КонецЕсли;
	
	НаименованиеТовара = "" + ТоварКлиент + ", услуги по предоставлению мест для временного проживания в гостинице";
	Если ЗначениеЗаполнено(ДатаС) Тогда
		Если ДатаС = ДатаПо Тогда
			ДатаСПо = " " + Формат(ДатаС, "ДФ=dd.MM.yy"); 
		Иначе
			ДатаСПо = " с " + Формат(ДатаС, "ДФ=dd.MM.yy") + " по " + Формат(ДатаПо, "ДФ=dd.MM.yy"); 
		КонецЕсли;
	Иначе		
		ДатаСПо = "";
	КонецЕсли;
		
	СтрокаТЗ.НаименованиеТовара = НаименованиеТовара + ДатаСПо; 
	
	СтрокаТЗ.КодЕдиницыИзмерения = "359"; 
	СтрокаТЗ.ЕдиницаИзмерения = "сутки";
	
	Если ВсегоКоличествоПроживание = 0 Тогда
		 ВсегоКоличествоПроживание = 1;
	КонецЕсли;
	
	Сумма = ВсегоСуммаПроживание + ВсегоСуммаУслуги; 
	
	СтрокаТЗ.Количество = ВсегоКоличествоПроживание;
	СтрокаТЗ.Цена = Окр(Сумма / ВсегоКоличествоПроживание, 2);
	
	Если ВсеСНДС Тогда
		СтрокаТЗ.НалоговаяСтавка = СтавкаНДС;
		
		СуммаНДС = ВсегоСуммаНДС;
		СуммаБезНДС = ДокументыСервер.СуммаБезНДС(СтавкаНДС, Сумма);
	Иначе
		Если СтрокаТЗ.НалоговаяСтавка = Перечисления.СтавкиНДС.БезНДС
		ИЛИ СтрокаТЗ.НалоговаяСтавка = Перечисления.СтавкиНДС.ПустаяСсылка()
		Тогда 
			СтавкаНДС_П = СтавкаНДС;
		Иначе	
			СтавкаНДС_П = Перечисления.СтавкиНДС.НДС0;
		КонецЕсли;
		
		СтрокаТЗ.НалоговаяСтавка = СтавкаНДС_П;
		
		СуммаНДС = 0;
		СуммаБезНДС = Сумма;
	КонецЕсли;
	
	СтрокаТЗ.СуммаНДС = СуммаНДС;
	СтрокаТЗ.СуммаБезНДС = СуммаБезНДС;
	СтрокаТЗ.СуммаСНДС = Сумма;
	
	СтрокаТЗ.ЭтоУслуга = Ложь;
	СтрокаТЗ.Дата = '00010101';
Иначе
	Сумма = ВсегоСуммаПроживание; 

	Если Сумма <> 0 Тогда		
		
		СтрокаТЗ = ТЗ.Добавить();
		
		сч = сч + 1;
		СтрокаТЗ.НомерСтроки = сч;
		
		ДатаС = ИтогиЗаявка.ДатаС_Проживание; 
		ДатаПо = ИтогиЗаявка.ДатаПо_Проживание + 24 * 60 * 60;
		
		НаименованиеТовара = "" + ТоварКлиент + ", услуги по предоставлению мест для временного проживания в гостинице"
			+ " с " + Формат(ДатаС, "ДФ=dd.MM.yy") + " по " + Формат(ДатаПо, "ДФ=dd.MM.yy"); 
		
		СтрокаТЗ.НаименованиеТовара = НаименованиеТовара; 
		
		СтрокаТЗ.КодЕдиницыИзмерения = "359";
		СтрокаТЗ.ЕдиницаИзмерения = "сутки";
		
		Если ВсегоКоличествоПроживание = 0 Тогда
			 ВсегоКоличествоПроживание = 1;
		КонецЕсли;
		
		СтрокаТЗ.Количество = ВсегоКоличествоПроживание;
		СтрокаТЗ.Цена = Окр(Сумма / ВсегоКоличествоПроживание, 2);
		
		Если ВсеСНДС Тогда
			СтавкаНДС_П = СтавкаНДС;
			
			СуммаНДС = ДокументыСервер.СуммаНДС(СтавкаНДС, Сумма);
			СуммаБезНДС = ДокументыСервер.СуммаБезНДС(СтавкаНДС, Сумма);
		Иначе	
			Если СтавкаНДС = Перечисления.СтавкиНДС.БезНДС
			ИЛИ СтавкаНДС = Перечисления.СтавкиНДС.ПустаяСсылка()
			Тогда 
				СтавкаНДС_П = СтавкаНДС;
			Иначе	
				СтавкаНДС_П = Перечисления.СтавкиНДС.НДС0;
			КонецЕсли;
			
			СуммаНДС = 0;
			СуммаБезНДС = Сумма;
		КонецЕсли;
	
		СтрокаТЗ.НалоговаяСтавка = СтавкаНДС_П;
		
		СтрокаТЗ.СуммаНДС = СуммаНДС;
		СтрокаТЗ.СуммаБезНДС = СуммаБезНДС;
		СтрокаТЗ.СуммаСНДС = Сумма;
		
		СтрокаТЗ.ЭтоУслуга = Ложь;
		СтрокаТЗ.Дата = '00010101';
	КонецЕсли;

	Для Каждого Строка Из СчетаДетальноДолги Цикл
		Если НЕ Строка.Услуга Тогда Продолжить; КонецЕсли;
		Если Строка.ПрограммныйКодУслуги = Перечисления.ПрограммныйКодУслуги.ПРОЖИВАНИЕ_УСЛУГИ
		Тогда Продолжить; КонецЕсли;
		
		СтрокаТЗ = ТЗ.Добавить();
		
		сч = сч + 1;
	    СтрокаТЗ.НомерСтроки = сч;
		
		НаименованиеТовара = НаименованиеДляДокумента(Строка);
		НаименованиеТовара = "" + ТоварКлиент + ". " + НаименованиеТовара;
		
		СтрокаТЗ.НаименованиеТовара = НаименованиеТовара;

		СтрокаТЗ.КодЕдиницыИзмерения = "796";
		СтрокаТЗ.ЕдиницаИзмерения = "шт";
		
		Если Строка.Количество = 0 Тогда
		     Количество = 1;
		Иначе
		     Количество = Строка.Количество;
		КонецЕсли;
			
		СтрокаТЗ.Количество = Количество;
		СтрокаТЗ.Цена = Строка.Цена;
		
		СтрокаТЗ.НалоговаяСтавка = СтавкаНДС;
		
		СуммаБезНДС = ДокументыСервер.СуммаБезНДС(СтавкаНДС, Строка.СуммаДолг);
		СтрокаТЗ.СуммаБезНДС = СуммаБезНДС;
		
		СуммаНДС = ДокументыСервер.СуммаНДС(СтавкаНДС, Строка.СуммаДолг);;
		СтрокаТЗ.СуммаНДС = СуммаНДС;

		СтрокаТЗ.СуммаСНДС = Строка.СуммаДолг;
		
		СтрокаТЗ.ЭтоУслуга = Истина;
		СтрокаТЗ.Дата = Строка.ДатаДолг;
	КонецЦикла;	
КонецЕсли;

Возврат ТЗ;
КонецФункции

Функция ТоварКлиент_1(ДокументДолгСсылка, Счет) Экспорт
Клиент = Счет.Клиент;
	
Если Счет.РазделитьСчет Тогда
	ТоварКлиент = Клиент;
Иначе
	Клиент2 = ДокументДолгСсылка.Клиент2;
	Если ЗначениеЗаполнено(Клиент2)  
	И Клиент <> Клиент2 Тогда 
		ТоварКлиент = "" + Клиент + ", " + Клиент2;
	Иначе
		ТоварКлиент = Клиент;
	КонецЕсли;	
КонецЕсли;	

Возврат ТоварКлиент;
КонецФункции
