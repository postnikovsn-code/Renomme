ДанныеУзлаОбмена = ФТПСервер.ПолучитьДанныеУзлаОбмена(Ссылка.Код);

ИмяФайла = ПолучитьИмяВременногоФайла("xml");

//ИмяФайлаФТП = ОбменГостиницы.ПолучитьИмяФайлаОбменаФТП(Ссылка, ПланыОбмена.ВГ_ВыпискаГостиницы.ЭтотУзел(), ДанныеУзлаОбмена.КаталогОбменаFTP);
