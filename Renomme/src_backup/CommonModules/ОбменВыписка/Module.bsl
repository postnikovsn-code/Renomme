Функция УзелОбменаТекущий()
Узел = ПланыОбмена.ВГ_ВыпискаГостиницы.НайтиПоКоду("БУХ");
Возврат Узел;
КонецФункции	

Функция ВыполнитьВыгрузкуУзла() Экспорт
Узел = УзелОбменаТекущий();
УзелОбмена = Узел.ПолучитьОбъект();

// Записать новое сообщение обмена.
Результат = УзелОбмена.ЗаписатьСообщениеПодтверждения();

Возврат Результат;
КонецФункции

Функция ВыполнитьЗагрузкуУзла() Экспорт
Узел = УзелОбменаТекущий();
УзелОбмена = Узел.ПолучитьОбъект();

// Прочитать новое сообщение обмена.
Результат = УзелОбмена.ПрочитатьСообщениеСИзменениями();

Возврат Результат;
КонецФункции

Функция ВыполнитьОбменДанными() Экспорт
Узел = УзелОбменаТекущий();
УзелОбмена = Узел.ПолучитьОбъект();

Результат = Новый Структура("РезультатЧтения, РезультатЗаписи", Неопределено, Неопределено); 

РезультатЧтения = УзелОбмена.ПрочитатьСообщениеСИзменениями();
Результат.РезультатЧтения = РезультатЧтения;

Если РезультатЧтения.Ошибка Тогда 
	Если НЕ (РезультатЧтения.КодОшибки = 1 ИЛИ РезультатЧтения.КодОшибки = 30) Тогда Возврат Результат; КонецЕсли;
КонецЕсли;
	
РезультатЗаписи = УзелОбмена.ЗаписатьСообщениеПодтверждения();
Результат.РезультатЗаписи = РезультатЗаписи;

Возврат Результат;
КонецФункции
