&НаКлиенте
Процедура НомерСмены_ПриИзменении(Элемент)
ОбновитьДанныеПоДНиДК();	

ТД = Элементы.ЗарплатаСмены.ТекущиеДанные;

ИмяЭлемента = Элемент.Имя;
Имя_Право = Прав(ИмяЭлемента, 6);

Имя_НомерСмены = "НомерСмены_" + Имя_Право;
НомерСмены = ТД[Имя_НомерСмены];


Если НомерСмены > 0 Тогда
	Постоянный = ОбщийФункционалСервер.ЗначениеРеквизитаНаСервере(ТД.Администратор, "Постоянный");  
	Если Постоянный Тогда
		ТекстПредупреждения = "Для постоянных администраторов Номер смены д. б. 0 или 3 или 4";
		ПроверкаНомераСмены = НЕ (НомерСмены = 3 ИЛИ НомерСмены = 4);
	Иначе
		ТекстПредупреждения = "Номер смены д. б. 0 или 1 или 2 или 3";
		ПроверкаНомераСмены = НЕ (НомерСмены = 1 ИЛИ НомерСмены = 2 ИЛИ НомерСмены = 3);
	КонецЕсли;	
		
	Если ПроверкаНомераСмены Тогда
		ПоказатьПредупреждение(, ТекстПредупреждения);
		
		ОтборСтроки = Новый Структура("Администратор", ТД.Администратор);
		НайденныеСтрока = ЗарплатаСмены_OldValue.НайтиСтроки(ОтборСтроки);
		НайденнаяСтрока = НайденныеСтрока[0];
		
		ТД[Имя_НомерСмены] = НайденнаяСтрока[Имя_НомерСмены];
		Возврат;
	КонецЕсли;
КонецЕсли;

ИмяДлинаСмены = "ДлинаСмены_" + Имя_Право;
ДлинаСмены = ТД[ИмяДлинаСмены];	

Если НомерСмены = 4 Тогда
	Если ДлинаСмены = 0 Тогда
		 ТД[ИмяДлинаСмены] = 8;
	КонецЕсли;
КонецЕсли;
	
ТС = Элементы.ЗарплатаСмены.ТекущаяСтрока;
РасчитатьСтрокаЗарплатаСмены_НаСервере(ТС, Имя_Право);
КонецПроцедуры

