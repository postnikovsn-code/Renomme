&НаКлиенте
Процедура ОчиститьОсновныеДанныеДействие()
Для Каждого Строка Из Объект.Зарплата Цикл	
	Строка.Оклад_Р = 0; Строка.Оклад_Есть = Ложь;
	Строка.Отпуск_Р = 0; Строка.Отпуск_Есть = Ложь; 
	Строка.НадбавкаЗаСтаж_Р = 0; Строка.НадбавкаЗаСтаж_Есть = Ложь; 
	Строка.НадбавкаЗаСтандарты_Р = 0; Строка.НадбавкаЗаСтандарты_Есть = Ложь; 
