  <attributes>
    <name>Список</name>
    <title>
      <key>ru</key>
      <value>Список</value>
    </title>
    <id>1</id>
    <valueType>
      <types>DynamicList</types>
    </valueType>
    <view>
      <common>true</common>
    </view>
    <edit>
      <common>true</common>
    </edit>
    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>Список.ДатаСменыККТ</segments>
    </notDefaultUseAlwaysAttributes>
    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>Список.НомерСменыККТ</segments>
    </notDefaultUseAlwaysAttributes>
    <extInfo xsi:type="form:DynamicListExtInfo">
      <queryText>ВЫБРАТЬ
	СменыККТ.Организация КАК Организация,
	СменыККТ.НомерСменыККТ КАК НомерСменыККТ,
	СменыККТ.ДатаСменыККТ КАК ДатаСменыККТ,
	НачалоСменыККТМинимум.НачалоКассовойСмены КАК НачалоКассовойСмены,
	ОкончаниеСменыМаксимум.ОкончаниеКассовойСмены КАК ОкончаниеКассовойСмены,
	СменыККТ.Статус КАК Статус
ИЗ
	(ВЫБРАТЬ
		КассоваяСмена.НомерСменыККТ КАК НомерСменыККТ,
		КассоваяСмена.ДатаСменыККТ КАК ДатаСменыККТ,
		МАКСИМУМ(КассоваяСмена.Статус) КАК Статус,
		КассоваяСмена.Организация КАК Организация
	ИЗ
		Документ.КассоваяСмена КАК КассоваяСмена
	ГДЕ
		ВЫБОР
				КОГДА &amp;Организация = ЗНАЧЕНИЕ(Справочник.Организации.ПустаяСсылка)
					ТОГДА ИСТИНА
				ИНАЧЕ КассоваяСмена.Организация = &amp;Организация
			КОНЕЦ
	
	СГРУППИРОВАТЬ ПО
		КассоваяСмена.НомерСменыККТ,
		КассоваяСмена.ДатаСменыККТ,
		КассоваяСмена.Организация) КАК СменыККТ
		ЛЕВОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
			КассоваяСмена.НомерСменыККТ КАК НомерСменыККТ,
			КассоваяСмена.ДатаСменыККТ КАК ДатаСменыККТ,
			МИНИМУМ(КассоваяСмена.НачалоКассовойСмены) КАК НачалоКассовойСмены
		ИЗ
			Документ.КассоваяСмена КАК КассоваяСмена
		ГДЕ
			ВЫБОР
					КОГДА &amp;Организация = ЗНАЧЕНИЕ(Справочник.Организации.ПустаяСсылка)
						ТОГДА ИСТИНА
					ИНАЧЕ КассоваяСмена.Организация = &amp;Организация
				КОНЕЦ
		
		СГРУППИРОВАТЬ ПО
			КассоваяСмена.ДатаСменыККТ,
			КассоваяСмена.НомерСменыККТ) КАК НачалоСменыККТМинимум
		ПО СменыККТ.НомерСменыККТ = НачалоСменыККТМинимум.НомерСменыККТ
			И СменыККТ.ДатаСменыККТ = НачалоСменыККТМинимум.ДатаСменыККТ
		ЛЕВОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
			КассоваяСмена.ДатаСменыККТ КАК ДатаСменыККТ,
			КассоваяСмена.НомерСменыККТ КАК НомерСменыККТ,
			МАКСИМУМ(КассоваяСмена.ОкончаниеКассовойСмены) КАК ОкончаниеКассовойСмены
		ИЗ
			Документ.КассоваяСмена КАК КассоваяСмена
		ГДЕ
			ВЫБОР
					КОГДА &amp;Организация = ЗНАЧЕНИЕ(Справочник.Организации.ПустаяСсылка)
						ТОГДА ИСТИНА
					ИНАЧЕ КассоваяСмена.Организация = &amp;Организация
				КОНЕЦ
		
		СГРУППИРОВАТЬ ПО
			КассоваяСмена.ДатаСменыККТ,
			КассоваяСмена.НомерСменыККТ) КАК ОкончаниеСменыМаксимум
		ПО СменыККТ.НомерСменыККТ = ОкончаниеСменыМаксимум.НомерСменыККТ
			И СменыККТ.ДатаСменыККТ = ОкончаниеСменыМаксимум.ДатаСменыККТ</queryText>
      <autoFillAvailableFields>true</autoFillAvailableFields>
      <customQuery>true</customQuery>
      <autoSaveUserSettings>true</autoSaveUserSettings>
      <getInvisibleFieldPresentations>true</getInvisibleFieldPresentations>
    </extInfo>
  </attributes>
