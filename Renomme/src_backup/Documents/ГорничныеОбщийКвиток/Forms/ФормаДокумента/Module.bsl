&НаКлиенте
Процедура КвитокПриОкончанииРедактирования(Элемент, НоваяСтрока, ОтменаРедактирования)
ТД = Элемент.ТекущиеДанные;

ОтборСтроки = Новый Структура("Горничная, КодЗаполнения", ТД.Горничная, ТД.КодЗаполнения); 	
НайденныеСтроки = ТЗ_Квитки.НайтиСтроки(ОтборСтроки);	

Если СтрНайти(ТД.КодЗаполнения, "Пусто_") > 0  Тогда  
	НайденныеСтроки[0].Наименование = ТД.Наименование;	
КонецЕсли;

НайденныеСтроки[0].Количество_Р = ТД.Количество_Р;	
НайденныеСтроки[0].Количество_Есть = ТД.Количество_Есть;		

НайденныеСтроки[0].Сумма_Р = ТД.Сумма_Р;	
НайденныеСтроки[0].Сумма_Есть = ТД.Сумма_Есть;	

КвитокИтоги = КвитокИтоги();
ОтборСтроки = Новый Структура("КодЗаполнения", "ИтогоНачисления");
НайденныеСтроки = Квиток.НайтиСтроки(ОтборСтроки);
НайденныеСтроки[0].Сумма_Э = КвитокИтоги.ИтогоНачисления;

ОтборСтроки = Новый Структура("КодЗаполнения", "ОстатокКВыплате");
НайденныеСтроки = Квиток.НайтиСтроки(ОтборСтроки);
НайденныеСтроки[0].Сумма_Э = КвитокИтоги.ОстатокКВыплате;
КонецПроцедуры

&НаКлиенте
Процедура ДобавитьСтроку(Команда)
ТС = Элементы.Квиток.ТекущаяСтрока;	
Если ТС = Неопределено Тогда Возврат; КонецЕсли;

ТСНоваяСтрока  = ДобавитьСтрокуНаСервере(ТС);
Если ТСНоваяСтрока = Неопределено Тогда Возврат; КонецЕсли;

Элементы.Квиток.ТекущаяСтрока = ТСНоваяСтрока;	
КонецПроцедуры

&НаСервере
Функция ДобавитьСтрокуНаСервере(ТС)
СтрокаКвиток = Квиток.НайтиПоИдентификатору(ТС);	

Если СтрокаКвиток.ТипСтроки = 1 ИЛИ СтрокаКвиток.КодЗаполнения = "ИтогоНачисления" Тогда
	ТипСтроки = 1;
ИначеЕсли СтрокаКвиток.ТипСтроки = -1 ИЛИ СтрокаКвиток.КодЗаполнения = "ОстатокКВыплате" Тогда
	ТипСтроки = -1;
Иначе
	Возврат Неопределено;	
КонецЕсли;

Индекс = Квиток.Индекс(СтрокаКвиток);

НоваяСтрокаКвиток = Квиток.Вставить(Индекс);	
НоваяСтрокаКвиток.Горничная= СтрокаКвиток.Горничная;

Объект.НомерСтрокиНачисления = Объект.НомерСтрокиНачисления + 1; 
НоваяСтрокаКвиток.КодЗаполнения = "Пусто_" + Строка(Объект.НомерСтрокиНачисления);

НоваяСтрокаКвиток.ТипСтроки = ТипСтроки;
	
//	
ТС = НоваяСтрокаКвиток.ПолучитьИдентификатор();

ОтборСтроки = Новый Структура("Горничная, КодЗаполнения", СтрокаКвиток.Горничная, СтрокаКвиток.КодЗаполнения); 	
НайденныеСтроки = ТЗ_Квитки.НайтиСтроки(ОтборСтроки);
СтрокаТЗ_Квитки = НайденныеСтроки[0];
Индекс = ТЗ_Квитки.Индекс(СтрокаТЗ_Квитки);

НоваяСтрокаТЗ_Квитки = ТЗ_Квитки.Вставить(Индекс);	
НоваяСтрокаТЗ_Квитки.Горничная= СтрокаТЗ_Квитки.Горничная;

НоваяСтрокаТЗ_Квитки.КодЗаполнения = НоваяСтрокаКвиток.КодЗаполнения;

НоваяСтрокаТЗ_Квитки.ТипСтроки = НоваяСтрокаКвиток.ТипСтроки;

Возврат ТС;
КонецФункции

&НаКлиенте
Процедура КвитокПередУдалением(Элемент, Отказ)
ТД = Элемент.ТекущиеДанные;
Если ТД = Неопределено Тогда Возврат; КонецЕсли;

Если СтрНайти(ТД.КодЗаполнения, "Пусто_") = 0  Тогда  
