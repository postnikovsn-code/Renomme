	НомерСмены = ТД["НомерСмены_" + Дата_И];
	ДлинаСмены = ТД["ДлинаСмены_" + Дата_И];
	
	ПереработкаЧасы = ТД["ПереработкаЧасы_" + Дата_И];
	СуммаПереработка = СуммаПереработкаЗаСмену(ТД.Администратор, ПереработкаЧасы);
	ТД["СуммаПереработка_" + Дата_И] = СуммаПереработка;
	
	КоличествоЗавтракиЧехов = ТД["КоличествоЗавтракиЧехов_" + Дата_И];
	СуммаЗавтракиЧехов  = СуммаЗавтракиЧеховЗаСмену(ТД.Администратор, КоличествоЗавтракиЧехов);
