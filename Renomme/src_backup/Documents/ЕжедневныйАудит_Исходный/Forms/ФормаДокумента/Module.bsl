	|	И ЗаявкаНаБронирование.Статус = &Статус");
	
	ЗапросАннул.УстановитьПараметр("Статус",Перечисления.СтатусБрони.ОтменаБронирования);								   
	ЗапросАннул.УстановитьПараметр("ДН",НачалоДня(Объект.Дата));								   
	ЗапросАннул.УстановитьПараметр("ДК",КонецДня(Объект.Дата+86400));	
	ТЗ=ЗапросАннул.Выполнить().Выгрузить();
	
	Для каждого Стр Из ТЗ Цикл
		
		
		Нов=Объект.Аннуляции.Добавить();
