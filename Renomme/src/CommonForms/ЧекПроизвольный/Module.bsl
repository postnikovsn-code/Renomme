
&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
ЭтоКоворкинг = Истина; 	
Если ЭтоКоворкинг Тогда
	ЭтаФорма.Заголовок = "КОВОРКИНГ";	
КонецЕсли;

ДатаОплаты = ТекущаяДата();
ДатаУчетаНДС = ДатаОплаты;
СтавкаНДС = ДокументыСервер.СтавкаНДС(ЭтоКоворкинг); СтавкаНДС = ДокументыСервер.СтавкаНДСТекущая(СтавкаНДС, ДатаУчетаНДС);

Элементы.СуммаОплаты.ТолькоПросмотр = Истина; 
Элементы.СуммаКарта.ТолькоПросмотр = Истина; 
Элементы.СуммаНаличные.ТолькоПросмотр = Истина; 

Элементы.АвансПолныйРасчет.СписокВыбора.Добавить("Аванс");
Элементы.АвансПолныйРасчет.СписокВыбора.Добавить("Полный расчет");

Элементы.ТипОплаты.СписокВыбора.Добавить("Карта");
Элементы.ТипОплаты.СписокВыбора.Добавить("Наличные");
Элементы.ТипОплаты.СписокВыбора.Добавить("Смешанная");

//ВидимостьОплатаЭТ = ОбщийМодульНастройки.ЭтоЛайв() ИЛИ ОбщийМодульНастройки.ЭтоСтритАрт() ИЛИ ОбщийМодульНастройки.ЭтоДомСоветов();
ВидимостьОплатаЭТ = Ложь;
Элементы.ОплатитьКарта.Видимость =  ВидимостьОплатаЭТ;
КонецПроцедуры


&НаКлиенте
Процедура Отменить(Команда)
Закрыть();
КонецПроцедуры

//
&НаКлиенте
Процедура АвансПолныйРасчетПриИзменении(Элемент)
Если АвансПолныйРасчет = "Аванс" Тогда	
	ЭтоАванс = Истина;
Иначе
	ЭтоАванс = Ложь;
КонецЕсли;	
КонецПроцедуры

&НаКлиенте
Процедура ТипОплатыПриИзменении(Элемент)
Если ТипОплаты = "Карта" тогда
	СуммаКарта = СуммаОплаты;	
	СуммаНаличные = 0;
	
	Элементы.СуммаКарта.ТолькоПросмотр = Истина; 
	Элементы.СуммаНаличные.ТолькоПросмотр = Истина; 
ИначеЕсли ТипОплаты = "Наличные" Тогда 
	СуммаКарта = 0;	
	СуммаНаличные = СуммаОплаты;	
	
	Элементы.СуммаКарта.ТолькоПросмотр = Истина; 
	Элементы.СуммаНаличные.ТолькоПросмотр = Истина; 
Иначе 
	СуммаНаличные = 0;	
	СуммаКарта = 0;	
	
	Элементы.СуммаКарта.ТолькоПросмотр = Ложь; 
	Элементы.СуммаНаличные.ТолькоПросмотр = Ложь;       
КонецЕсли;	

Элементы.СуммаОплаты.ТолькоПросмотр = Ложь;       
КонецПроцедуры

&НаКлиенте
Процедура СуммаОплатыПриИзменении(Элемент)
Если ТипОплаты = "Карта" тогда
	СуммаКарта = СуммаОплаты;	
	СуммаНаличные = 0;
ИначеЕсли ТипОплаты = "Наличные" Тогда 
	СуммаКарта = 0;	
	СуммаНаличные = СуммаОплаты;	
КонецЕсли;	
КонецПроцедуры

&НаКлиенте
Процедура СуммаКартаПриИзменении(Элемент)
СуммаНаличные = СуммаОплаты - СуммаКарта;
КонецПроцедуры

&НаКлиенте
Процедура СуммаНаличныеПриИзменении(Элемент)
СуммаКарта = СуммаОплаты - СуммаНаличные;
КонецПроцедуры
//

&НаКлиенте
Процедура КассовыйЧек(Команда)
Если ПроверкаДанныхФормы() Тогда Возврат; КонецЕсли;

Оповещение = Новый ОписаниеОповещения("ЗавершениеВопросаБудетВыведенЧекНаСумму", ЭтаФорма);
ТекстВопроса = "Будет выведен чек" + ?(ЭтоАванс, " на АВАНС", "");
ТекстВопроса = ТекстВопроса + " на сумму: " + СуммаОплаты 
		+ Символы.ПС + "Карта: " + СуммаКарта + ", наличные: " + СуммаНаличные  
		+ Символы.ПС + Символы.ПС + "Тип оплаты: " + ТипОплаты 
		+ Символы.ПС + Символы.ПС + "ПОДТВЕРДИТЕ ...";		
		
		
ПоказатьВопрос(Оповещение, ТекстВопроса, РежимДиалогаВопрос.ОКОтмена);
КонецПроцедуры

&НаКлиенте
Функция ПроверкаДанныхФормы()
ТекстПредупреждения_П = "";
Если ТипОплаты = "" Тогда
	ТекстПредупреждения_П = "Выберите тип оплаты ...";
КонецЕсли;
	                      
Если АвансПолныйРасчет = ""  Тогда
	ТекстПредупреждения_П = ТекстПредупреждения_П + Символы.ПС  + Символы.ПС  + "Укажите Аванс / Полный расчет ...";
КонецЕсли;

Если ТаблицаПозицииЧека.Количество() = 0 Тогда
	ТекстПредупреждения_П = ТекстПредупреждения_П + Символы.ПС  + Символы.ПС  + "Заполните таблицу позиций чека ...";
КонецЕсли;

Если СуммаОплаты > 0 И СуммаКарта = 0 И СуммаНаличные = 0 Тогда
	ТекстПредупреждения_П = ТекстПредупреждения_П + Символы.ПС  + Символы.ПС  + "Введите Сумму по карте и (или) Сумму наличными ...";
КонецЕсли;

ИтогоТаблицаПозицииЧека = ТаблицаПозицииЧека.Итог("Сумма");
Если СуммаКарта + СуммаНаличные <> ИтогоТаблицаПозицииЧека Тогда
	ТекстПредупреждения_П = ТекстПредупреждения_П + Символы.ПС  + Символы.ПС  + "Сумма по карте + Сумма наличными <> Итоги таблицы позиций чека";
КонецЕсли;

//
Если ТекстПредупреждения_П <> "" Тогда
	ПоказатьПредупреждение(, ТекстПредупреждения_П);	
	
	Возврат Истина;	
Иначе 	
	Возврат Ложь;	
КонецЕсли;
КонецФункции

&НаКлиенте
Процедура ЗавершениеВопросаБудетВыведенЧекНаСумму(Результат, ДополнительныеПараметры) Экспорт
Если Результат = КодВозвратаДиалога.Отмена Тогда Возврат; КонецЕсли; 	

ВывестиЧек();
КонецПроцедуры

