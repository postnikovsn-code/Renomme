Процедура ОткрытьЗакрытьЗаявку() 
//Если НЕ ЭтаФорма.Записать(Новый Структура("РежимЗаписи", РежимЗаписиДокумента.Проведение)) Тогда Возврат; КонецЕсли;	
	
Объект.Закрыто = Закрыто;

Если Объект.Закрыто Тогда
	Объект.ДатаЗакрытия = ТекущаяДата();	
Иначе	
	Объект.ДатаЗакрытия = Неопределено;	
