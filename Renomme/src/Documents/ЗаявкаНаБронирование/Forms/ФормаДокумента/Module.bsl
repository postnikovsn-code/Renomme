&НаКлиенте
Процедура КлиентПриИзмененииЗавершение(Клиент_OldValue, ЗаменитьСкидку)
Если ЗаменитьКлиентаНаСервере(Клиент_OldValue, ЗаменитьСкидку) Тогда Возврат; КонецЕсли;

ОтборТаблицаАнкет(); 
Если ЗначениеЗаполнено(Объект.Клиент) Тогда 
	НеПоказыватьИсторию = ОбщийФункционалСервер.ЗначениеРеквизитаНаСервере(Объект.Клиент, "НеПоказыватьИсторию");
Иначе
	НеПоказыватьИсторию = Истина;
КонецЕсли;	
Если НЕ НеПоказыватьИсторию Тогда ПредпочтенияИсторияКлиента(); КонецЕсли;

Если НЕ КлиентыСервер.ЭтоЮрЛицо(Объект.Клиент) Тогда
	ПредупрежденияЧСКурит(Объект.Клиент);
КонецЕсли;
КонецПроцедуры

&НаСервере
Функция ЗаменитьКлиентаНаСервере(Клиент_OldValue, ЗаменитьСкидку) 
НачатьТранзакцию();

ЗаменитьКлиентаДействие(Клиент_OldValue, ЗаменитьСкидку);

Если ЭтотОбъектЗаписатьНаСервере() Тогда 
	ОтменитьТранзакцию();
	Объект.Клиент = Клиент_OldValue;
	
	Возврат Истина;
Иначе
	ЗафиксироватьТранзакцию();
	
	Возврат Ложь;
Конецесли;
КонецФункции

&НаСервере
Процедура ЗаменитьКлиентаДействие(Клиент_OldValue, ЗаменитьСкидку) 
Если НЕ ЗначениеЗаполнено(Клиент_OldValue) Тогда Возврат; КонецЕсли;

Если ЗаменитьСкидку Тогда ЗаменаПроцентСкидки(); КонецЕсли;

Для Каждого Счет из Объект.Счета Цикл
	Если Счет.Клиент = Клиент_OldValue Тогда
		Счет.Клиент = Объект.Клиент; 
	КонецЕсли;
КонецЦикла;

Если ЗначениеЗаполнено(Объект.Оплачивает) И Объект.Оплачивает = Клиент_OldValue Тогда
	Объект.Оплачивает = Объект.Клиент; 
КонецЕсли;

Для Каждого Счет из Объект.Счета Цикл
	Если ЗначениеЗаполнено(Счет.ГрупповойСчет) Тогда Продолжить; КонецЕсли;
	
	Если Счет.Контрагент = Клиент_OldValue Тогда
		Счет.Контрагент = Объект.Клиент;
	КонецЕсли;
КонецЦикла;

ЗаменитьКонтрагентаДокументОплатыКасса(Объект.Клиент, Клиент_OldValue);

ЗаменитьУдалитьКонтрагентаДокументОплатыВыписка(Объект.Клиент, Клиент_OldValue);
КонецПроцедуры

//
&НаСервере
Функция ЗаменитьКонтрагентаДокументОплатыКасса(Контрагент, Контрагент_OldValue) 
Для Каждого Строка Из Объект.СчетаДетальноОплаты Цикл
	Если Строка.ГрупповаяОплата Тогда Продолжить; КонецЕсли; 
	
	ДокументОплаты = Строка.ДокументОплаты;

	Если ДокументОплаты.ОтКого <> Контрагент_OldValue Тогда Продолжить; КонецЕсли;
	
	Если ТипЗнч(ДокументОплаты) = Тип("ДокументСсылка.КассовыйДокумент") Тогда
		ДокументОплатыОбъект = ДокументОплаты.ПолучитьОбъект();
		ДокументОплатыОбъект.ОтКого = Контрагент;
	    ДокументОплатыОбъект.Записать(РежимЗаписиДокумента.Проведение);
		
		Запрос = Новый Запрос("ВЫБРАТЬ
		                      |	КассовыйДокумент.Ссылка КАК Ссылка
		                      |ИЗ
		                      |	Документ.КассовыйДокумент КАК КассовыйДокумент
		                      |ГДЕ
		                      |	КассовыйДокумент.ВозвратДокумент = &ВозвратДокумент");
		Запрос.УстановитьПараметр("ВозвратДокумент", ДокументОплаты); 
		ТЗ = Запрос.Выполнить().Выгрузить();
		Для Каждого СтрокаТЗ Из ТЗ Цикл
			ДокументОплатыТЗ = СтрокаТЗ.Ссылка;
			ДокументОплатыОбъект = ДокументОплатыТЗ.ПолучитьОбъект(); 								
			ДокументОплатыОбъект.ОтКого = Контрагент;
			
		    ДокументОплатыОбъект.Записать(РежимЗаписиДокумента.Проведение);								
		КонецЦикла;
	КонецЕсли;
КонецЦикла;
КонецФункции	

&НаСервере
Функция ЗаменитьУдалитьКонтрагентаДокументОплатыВыписка(Контрагент, Контрагент_OldValue) 
Если Контрагент_OldValue.ТипКлиента = Перечисления.ТипыКлиентов.ФизЛицо Тогда
	Если Контрагент.ТипКлиента = Перечисления.ТипыКлиентов.ФизЛицо Тогда
		ЗаменитьКонтрагентаДокументОплатыВыписка(Контрагент, Контрагент_OldValue);
	Иначе	
		УдалитьДокументыОплатыВыписка(Контрагент_OldValue);
	КонецЕсли;
Иначе	
	 УдалитьДокументыОплатыВыписка(Контрагент_OldValue);
КонецЕсли;		
КонецФункции

&НаСервере
Функция ЗаменитьКонтрагентаДокументОплатыВыписка(Контрагент, Контрагент_OldValue) 
Для Каждого Строка Из Объект.СчетаДетальноОплаты Цикл
	Если Строка.ГрупповаяОплата Тогда Продолжить; КонецЕсли; 
	
	ДокументОплаты = Строка.ДокументОплаты;

	Если ДокументОплаты.ОтКого <> Контрагент_OldValue Тогда Продолжить; КонецЕсли;
	
	Если ТипЗнч(ДокументОплаты) = Тип("ДокументСсылка.ВыпискаБанка") Тогда
		ДокументОплатыОбъект = ДокументОплаты.ПолучитьОбъект();
		ДокументОплатыОбъект.ОтКого = Контрагент;
	    ДокументОплатыОбъект.Записать(РежимЗаписиДокумента.Проведение);
		
		Запрос = Новый Запрос("ВЫБРАТЬ
		                      |	ВыпискаБанка.Ссылка КАК Ссылка
		                      |ИЗ
		                      |	Документ.ВыпискаБанка КАК ВыпискаБанка
		                      |ГДЕ
		                      |	ВыпискаБанка.ВозвратДокумент = &ВозвратДокумент");
		Запрос.УстановитьПараметр("ВозвратДокумент", ДокументОплаты); 
		ТЗ = Запрос.Выполнить().Выгрузить();
		Для Каждого СтрокаТЗ Из ТЗ Цикл
			ДокументОплатыТЗ = СтрокаТЗ.Ссылка;
			ДокументОплатыОбъект = ДокументОплатыТЗ.ПолучитьОбъект(); 								
			ДокументОплатыОбъект.ОтКого = Контрагент;
			
		    ДокументОплатыОбъект.Записать(РежимЗаписиДокумента.Проведение);								
		КонецЦикла;
	КонецЕсли;
КонецЦикла;
КонецФункции	
