Запрос.УстановитьПараметр("ДатаИзмененияС", НачалоМесяца(ДатаРасчета));
Запрос.УстановитьПараметр("ДатаИзмененияПо", КонецМесяца(ДатаРасчета));
Запрос.УстановитьПараметр("ДатаСоздания", НачалоМесяца(ДатаРасчета));
Запрос.УстановитьПараметр("ДатаРасчета", КонецМесяца(ДатаРасчета));

ТЗ = Запрос.Выполнить().Выгрузить();

Возврат ТЗ;
КонецФункции

&НаКлиенте
Процедура ТурНалогДетальноВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
ТД = ТурНалогДетально.НайтиПоИдентификатору(ВыбраннаяСтрока);	
	
ПараметрыФормы = Новый Структура("ТолькоПросмотр", Истина);

Если Поле.Имя = "ТурНалогДетальноГрупповойСчет" Тогда
	Если ЗначениеЗаполнено(ТД.ГрупповойСчет) Тогда
		ПараметрыФормы.Вставить("Ключ", ТД.ГрупповойСчет);	

		ОткрытьФорму("Документ.ГрупповыеСчета.Форма.ФормаДокумента", ПараметрыФормы, ЭтаФорма
			,,,,, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	КонецЕсли;			
Иначе
	Если ЗначениеЗаполнено(ТД.ДокументДолг) Тогда
		ПараметрыФормы.Вставить("Ключ", ТД.ДокументДолг);	

		ОткрытьФорму("Документ.ЗаявкаНаБронирование.Форма.ФормаДокумента", ПараметрыФормы, ЭтаФорма
			,,,,, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	Иначе	
		Если ЗначениеЗаполнено(ТД.ГрупповойСчет) Тогда
			ПараметрыФормы.Вставить("Ключ", ТД.ГрупповойСчет);	

			ОткрытьФорму("Документ.ГрупповыеСчета.Форма.ФормаДокумента", ПараметрыФормы, ЭтаФорма
				,,,,, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
		КонецЕсли;			
	КонецЕсли;
КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ТурНалогДетальноИзмененияВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
ТД = ТурНалогДетальноИзменения.НайтиПоИдентификатору(ВыбраннаяСтрока);	
	
ПараметрыФормы = Новый Структура("ТолькоПросмотр", Истина);

ПараметрыФормы.Вставить("Ключ", ТД.ДокументДолг);	
ОткрытьФорму("Документ.ЗаявкаНаБронирование.Форма.ФормаДокумента", ПараметрыФормы, ЭтаФорма
	,,,,, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
КонецПроцедуры

&НаКлиенте
Процедура ТурНалогЗаявкиВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
ТД = ТурНалогЗаявки.НайтиПоИдентификатору(ВыбраннаяСтрока);	
	
Если НЕ ЗначениеЗаполнено(ТД.ДокументДолг) Тогда Возврат; КонецЕсли;

ПараметрыФормы = Новый Структура("ТолькоПросмотр", Истина);
		
Если ТипЗнч(ТД.ДокументДолг) = Тип("ДокументСсылка.ГрупповыеСчета") Тогда
	ПараметрыФормы.Вставить("Ключ", ТД.ДокументДолг);	

	ОткрытьФорму("Документ.ГрупповыеСчета.Форма.ФормаДокумента", ПараметрыФормы, ЭтаФорма
		,,,,, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
Иначе
	ПараметрыФормы.Вставить("Ключ", ТД.ДокументДолг);	

	ОткрытьФорму("Документ.ЗаявкаНаБронирование.Форма.ФормаДокумента", ПараметрыФормы, ЭтаФорма
		,,,,, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
КонецЕсли;
КонецПроцедуры
