&НаКлиенте
Процедура НомерКоворкингДеревоПриАктивизацииСтроки(Элемент)
ТС = Элементы.НомерКоворкингДерево.ТекущаяСтрока;	
Если ТС = Неопределено Тогда 
	Заявки.Параметры.УстановитьЗначениеПараметра("КоворкингНомер", Неопределено);
	Счета.Параметры.УстановитьЗначениеПараметра("КоворкингЗаявка", Неопределено);
	Оплаты.Параметры.УстановитьЗначениеПараметра("КоворкингСчет", Неопределено);
	
	Возврат; 
КонецЕсли;

ТД = НомерКоворкингДерево.НайтиПоИдентификатору(ТС);
Если ТД.ЭтоГруппа Тогда 
	Заявки.Параметры.УстановитьЗначениеПараметра("КоворкингНомер", Неопределено);
	Счета.Параметры.УстановитьЗначениеПараметра("КоворкингЗаявка", Неопределено);
	Оплаты.Параметры.УстановитьЗначениеПараметра("КоворкингСчет", Неопределено);
	
	Возврат; 
КонецЕсли;

Заявки.Параметры.УстановитьЗначениеПараметра("КоворкингНомер", ТД.НомерКоворкинг);

Элементы.ЧасС.Видимость = ТД.ПочасоваяОплата;
Элементы.ЧасПо.Видимость = ТД.ПочасоваяОплата;
КонецПроцедуры
