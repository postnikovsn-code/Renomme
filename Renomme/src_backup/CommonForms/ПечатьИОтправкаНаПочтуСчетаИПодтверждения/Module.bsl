&НаКлиенте
Процедура СохранитьСчетВEXCEL(Команда)
СохранитьСчетДиалогВEXCEL();
КонецПроцедуры

&НаКлиенте
Функция СохранитьСчетДиалогВEXCEL()
Диалог = Новый ДиалогВыбораФайла(РежимДиалогаВыбораФайла.Сохранение);
Диалог.Расширение = "XLSX";

//Фильтр = НСтр("ru = 'Текст'; en = 'Text'")
//    + "(*.PDF)|*.PDF";
	
Диалог.Фильтр = "(*.xlsx)|*.xlsx";;

Диалог.ПолноеИмяФайла = ИмяФайлаСчет;

Если Диалог.Выбрать() Тогда
	ПолноеИмяФайлаСчет = Диалог.ПолноеИмяФайла; 
    ТабличныйДокумент.Записать(Диалог.ПолноеИмяФайла, ТипФайлаТабличногоДокумента.XLSX);
	
	Возврат Ложь;
КонецЕсли;

Возврат Истина;
КонецФункции

&НаКлиенте
Процедура ОткрытьСчетВEXCEL(Команда)
Если ПроверитьСчет() Тогда Возврат; КонецЕсли;

Excel = Новый COMОбъект("Excel.Application");
Excel.Visible = Истина;
Книга = Excel.WorkBooks.Open(ПолноеИмяФайлаСчет);
КонецПроцедуры

&НаКлиенте
Функция ПроверитьСчет()
Если ПолноеИмяФайлаСчет = "" Тогда 	
    ПоказатьПредупреждение(,"Счет не сохранен");
	Возврат Истина;
КонецЕсли;

ФайлНаДиске = Новый Файл(ПолноеИмяФайлаСчет);
Если НЕ ФайлНаДиске.Существует() Тогда
    ПоказатьПредупреждение(,"Файл счета отсутствует");
	Возврат Истина;
КонецЕсли;	

Возврат Ложь;
КонецФункции

&НаКлиенте
Процедура ОткрытьСчетВEXCEL_Вариант(Команда)
Если ПолноеИмяФайлаСчет = "" Тогда Перейти ~СОХРАНИТЬ_ФАЙЛ; КонецЕсли;

ФайлНаДиске = Новый Файл(ПолноеИмяФайлаСчет);
Если ФайлНаДиске.Существует() Тогда Перейти ~ОТКРЫТЬ_ФАЙЛ; КонецЕсли;		

~СОХРАНИТЬ_ФАЙЛ:
Если СохранитьСчетДиалогВEXCEL() Тогда Возврат; КонецЕсли;

 ~ОТКРЫТЬ_ФАЙЛ:
Excel = Новый COMОбъект("Excel.Application");	   
Книга = Excel.WorkBooks.Open(ПолноеИмяФайлаСчет);

Excel.Activate();
КонецПроцедуры
