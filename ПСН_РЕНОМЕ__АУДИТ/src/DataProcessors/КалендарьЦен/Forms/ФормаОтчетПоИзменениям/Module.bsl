		ПолеОтчетаПоИзменениям.Вывести(ТабДок);
	КонецЦикла; 
	
	ТабДок=Новый ТабличныйДокумент;	
	Обл=Макет.ПолучитьОбласть("Строка2|ШапкаВерх");	
	Обл.Параметры.Катагория=Категория;
	ТабДок.Присоединить(Обл);	
	
	ДТ_С=ДТН;
	ПоискЦен=Новый Запрос("ВЫБРАТЬ ПЕРВЫЕ 1
	                      |	ИзменениеЦеныДатаЦены.Процент
	                      |ИЗ
	                      |	Документ.ИзменениеЦены.ДатаЦены КАК ИзменениеЦеныДатаЦены
	                      |ГДЕ
	                      |	ИзменениеЦеныДатаЦены.ДатаЦены = &ДатаЦены
	                      |	И ИзменениеЦеныДатаЦены.Категория = &Категория
	                      |	И ИзменениеЦеныДатаЦены.Двухместный = &Двухместный
	                      |
	                      |УПОРЯДОЧИТЬ ПО
	                      |	ИзменениеЦеныДатаЦены.Ссылка.Дата УБЫВ");
	ПоискЦен.УстановитьПараметр("Категория",Справочники.КатегорииНомеров.НайтиПоНаименованию(Категория));
	
	Пока ДТ_С<=ДТК цикл
		Обл=Макет.ПолучитьОбласть("Строка2|ДатаЦены");
		
		ПоискЦен.УстановитьПараметр("ДатаЦены",НачалоДня(ДТ_С));
		ПоискЦен.УстановитьПараметр("Двухместный",Ложь);
        ТЗЦ=ПоискЦен.Выполнить().Выгрузить();
		ПоискЦен.УстановитьПараметр("Двухместный",Ложь);
        ТЗЦ2=ПоискЦен.Выполнить().Выгрузить();

		Результат = КалендарьЦен.БазоваяЦенаДня(ДТ_С, ТЗБазовыеЦены, БТ, БТ_Вых, БТ_Двух, БТ_Вых_Двух);
		
		БЦО = Результат.БазоваяЦенаДняОдноместный;
		БЦД = Результат.БазоваяЦенаДняДвухместный;
		
		Изм1=?(ТЗЦ.Количество()=0,0,ТЗЦ[0].Процент);
		Изм2=?(ТЗЦ2.Количество()=0,0,ТЗЦ2[0].Процент);
		
		Если ТЗЦ.Количество()=0 И ТЗЦ2.Количество()=0 Тогда
			Обл.Параметры.Цена = БЦО;
			Обл.Параметры.Цена2 = БЦД;
		иначе
			Изм1=?(ТЗЦ.Количество()=0,0,ТЗЦ[0].Процент);
			Изм2=?(ТЗЦ2.Количество()=0,0,ТЗЦ2[0].Процент);
			
			//Обл.Параметры.Цена = Формат(?(ДеньНедели(ДТ_С)<5,БТ+Изм1,БТ_Вых+Изм1), "ЧГ=");
			//Обл.Параметры.Цена2 = Формат(?(ДеньНедели(ДТ_С)<5,БТ_Двух+Изм2,БТ_Вых_Двух+Изм2), "ЧГ=");
			Обл.Параметры.Цена = БЦО + Изм1;
			Обл.Параметры.Цена2 = БЦД + Изм2;
			
			Если ТЗЦ[0].Процент>0 тогда
					Обл.Область(1,1,1,2).ЦветФона=Новый Цвет(117, 253, 79);
				иначеЕсли ТЗЦ[0].Процент<0 тогда
					Обл.Область(1,1,1,2).ЦветФона=Новый Цвет(255, 208, 198);
				Иначе
					Обл.Область(1,1,1,2).ЦветФона=Новый Цвет(255,255,255);
				КонецЕсли;
		КонецЕсли;
		
		
		//если ТЗЦ.Количество()=0 и ТЗЦ2.Количество()=0 тогда
		//	Обл.Параметры.Цена=Формат(?(ДеньНедели(ДТ_С)<5, БТ, БТ_Вых), "ЧГ=");
		//	Обл.Параметры.Цена2=Формат(?(ДеньНедели(ДТ_С)<5,БТ_Двух,БТ_Вых_Двух), "ЧГ=");
		//иначе
		//	Изм1=?(ТЗЦ.Количество()=0,0,ТЗЦ[0].Процент);
		//	Изм2=?(ТЗЦ2.Количество()=0,0,ТЗЦ2[0].Процент);
		//	Обл.Параметры.Цена=Формат(?(ДеньНедели(ДТ_С)<5,БТ+Изм1,БТ_Вых+Изм1), "ЧГ=");
		//	Обл.Параметры.Цена2=Формат(?(ДеньНедели(ДТ_С)<5,БТ_Двух+Изм2,БТ_Вых_Двух+Изм2), "ЧГ=");
		//	Если ТЗЦ[0].Процент>0 тогда
		//			Обл.Область(1,1,1,2).ЦветФона=Новый Цвет(117, 253, 79);
		//		иначеЕсли ТЗЦ[0].Процент<0 тогда
		//			Обл.Область(1,1,1,2).ЦветФона=Новый Цвет(255, 208, 198);
		//		Иначе
		//			Обл.Область(1,1,1,2).ЦветФона=Новый Цвет(255,255,255);
		//		КонецЕсли;
		//КонецЕсли;
		
		ТабДок.Присоединить(Обл);
		ДТ_С=ДТ_С+86400;	
	КонецЦикла;
	
	//ЭлементыФормы.ПолеОтчетаПоИзменениям.Вывести(ТабДок);
	ПолеОтчетаПоИзменениям.Вывести(ТабДок);
КонецФункции

