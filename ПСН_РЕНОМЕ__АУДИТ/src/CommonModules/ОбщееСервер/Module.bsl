//	|	ЗаявкаНаБронирование.Клиент,
//	|	ЗаявкаНаБронирование.ссылка

	|");
	//Запрос.УстановитьПараметр("Клиент",Клиент);						
	Запрос.УстановитьПараметр("НачДата",НачалоГода(НачалоГода(ТекущаяДата())-1));  // выборка с начала прошлого года
	Запрос.УстановитьПараметр("КонДата",КонецДня(ТекущаяДата()));                  //по текущую дату
	Запрос.УстановитьПараметр("НачалоДня",НачалоДня(ТекущаяДата()));
	//Заезд=Запрос.Выполнить().Выгрузить(ОбходРезультатаЗапроса.ПоГруппировкам);
	Заезд=Запрос.Выполнить().Выгрузить();
//	Выборка = Заезд.Выбрать();

    Таб = Новый ТаблицаЗначений;    
    Таб.Колонки.Добавить("Клиент");
    Таб.Колонки.Добавить("Количество");
	Таб.Колонки.Добавить("Результат");
	Для каждого Стр  Из Заезд Цикл
		ЧислоВизитов = КоличествоПроживанийЗаПериод(Стр.Клиент);
	    Если ЧислоВизитов >2 Тогда
          Строка = Таб.Добавить();
          Строка.Клиент = Стр.Клиент;
	      Строка.Количество = ЧислоВизитов;
		КонецЕсли;
	КонецЦикла;  
	
	Если Таб.Количество()>0 Тогда
		//   ЗарегистрироватьВБонуснойБазе
		
	
		//СтрокаПодключения  = "File = ""C:\BONUS""; Usr=""Admin""; Pwd=""123"";";
		//Ком = Новый COMОбъект("V82.COMConnector");	
		
		//Папка_C_BONUS = ОбщийФункционалСервер.ПолучитьЗначениеКонстанты("Папка_C_BONUS");
		//СтрокаПодключения  = "File = """ + Папка_C_BONUS +  """; Usr=""Admin""; Pwd=""123"";";
		//Ком = Новый COMОбъект("V83.COMConnector");
		//
		//База = Ком.Connect(СтрокаПодключения);
		
		База =СлужебныеСервер.ConnectБаза_BONUS();;
		
		Для ном=0 По Таб.Количество()-1 Цикл
			Попытка
				Рез=База.ЗарегистрироватьКлиента(Таб[Ном].Клиент.Фамилия,Таб[Ном].Клиент.Имя,Таб[Ном].Клиент.Отчество,Таб[Ном].Клиент.ДатаРождения,Таб[Ном].Клиент.Код);
				Таб[Ном].Результат  =  Рез.РезультатРегистрации;
		    Исключение
				Таб[Ном].Результат  =  "Сбой регистрации в базе бонусов"; 		
			КонецПопытки;
		КонецЦикла; 
		// сохраним в файл
		ТабДок = Новый ТабличныйДокумент;
	    Секция = ТабДок.ПолучитьОбласть("R1");
	    
	    Для Н=0 По Таб.Количество()-1 Цикл 
	        С= Н+1; 
	        Секция.Область("R"+Строка(С)+"C1").Текст = Таб[Н].Клиент;
	        Секция.Область("R"+Строка(С)+"C2").Текст = Таб[Н].Количество;
	        Секция.Область("R"+Строка(С)+"C3").Текст = Таб[Н].Результат;
	    КонецЦикла;
	    
	    ТабДок.Вывести(Секция);
		
		//ТабДок.Записать("C:\BASE\REP\Bonus.xls",ТипФайлаТабличногоДокумента.XLS97);
		
		ИмяФ = ОбщийФункционалСервер.ПолучитьЗначениеКонстанты("Папка_C_BASE");
		ИмяФ =  ИмяФ + "REP\Bonus.xls";
		ТабДок.Записать(ИмяФ,ТипФайлаТабличногоДокумента.XLS97);
		
		//ОтправитьМейлом("Обновление бонусной базы Реноме","C:\BASE\REP\Bonus.xls","1@renome-hotel.ru");
		
		Получатели = Новый СписокЗначений;
		Получатели.Добавить("postnikov_sn@invina.ru");
		
		//Получатели.Добавить("1@renome-hotel.ru");
		//Получатели.Добавить("pka@5sreda.ru");
		
		Файлы = Новый СписокЗначений;
		Файлы.Добавить(ИмяФ);
		
		СлужебныеСервер.ОтправитьМейлом("Обновление бонусной базы Реноме", Файлы, Получатели);
		
	  //  ///
	  //  //Сообщить(Рез.РезультатРегистрации);
	  //  
	  //  //Сообщить("Не получилось выполнить регистрацию в бонусной базе");
	  //
	  //  	///   ЗарегистрироватьВБонуснойБазе
  КонецЕсли;
  
Возврат Неопределено;
КонецФункции	

Функция КоличествоПроживанийЗаПериод(Клиент) 
  КоличествоПроживаний=0;	
  Запрос=Новый Запрос("ВЫБРАТЬ
	|	ЗаявкаНаБронирование.Ссылка
	|ИЗ
	|	Документ.ЗаявкаНаБронирование КАК ЗаявкаНаБронирование
	|ГДЕ
	|	(ЗаявкаНаБронирование.Клиент = &Клиент) 
	|	И (ЗаявкаНаБронирование.Дата МЕЖДУ &НачДата И &КонДата)
	|	И (ЗаявкаНаБронирование.Статус = &Статус)");
	Запрос.УстановитьПараметр("Клиент",Клиент);						
	Запрос.УстановитьПараметр("НачДата",НачалоГода(НачалоГода(ТекущаяДата())-1));  // выборка с начала прошлого года
	Запрос.УстановитьПараметр("КонДата",КонецДня(ТекущаяДата()));                  //по текущую дату
	Запрос.УстановитьПараметр("Статус",Перечисления.СтатусБрони.Выехал);
	Заезд=Запрос.Выполнить().Выгрузить();
	Возврат Заезд.Количество()   
КонецФункции              
