Функция СообщениеОБаллахИПризах(Клиент) Экспорт
// + Пока Заблокировано	
	Возврат "";
// - Пока Заблокировано	
	
	
	Попытка
		//СтрокаПодключения  = "File = ""C:\BONUS""; Usr=""Admin""; Pwd=""123"";";
		//Ком = Новый COMОбъект("V82.COMConnector");	
		//База = Ком.Connect(СтрокаПодключения);
		
		//СтрокаПодключения  = "File = """ + ОбщийФункционалСервер.ПолучитьЗначениеКонстанты("Папка_C_BONUS") + """;" + " Usr=""Admin""; Pwd=""123"";";

		//Ком = Новый COMОбъект("V83.COMConnector");	
		//База = Ком.Connect(СтрокаПодключения);
		
		База = СлужебныеСервер.ConnectБаза_BONUS();;

		Рез=База.БаллыИПризыПоКлиенту(Клиент.Код);
		Если Рез<>"Клиент отсутствует в базе" тогда
			Макет=ПолучитьОбщийМакет("МакетПризыИБаллы");
			ТабДок=Новый ТабличныйДокумент;
			Обл=Макет.ПолучитьОбласть("Шапка");
			Обл.Параметры.Баллы=Рез.Баллы;
			ТабДок.Вывести(Обл);

			Обл=Макет.ПолучитьОбласть("Шапка1");
			ТабДок.Вывести(Обл);
			Ном=1;
			Для каждого СтрП Из Рез.Призы Цикл
				Обл=Макет.ПолучитьОбласть("Строка");
				Обл.Параметры.Ном=Ном;
				Обл.Параметры.Приз=СтрП.Приз;
				Обл.Параметры.Стоимость=СтрП.Стоимость;
				ТабДок.Вывести(Обл);

			    Ном=Ном+1;
			КонецЦикла; 
			
			
			Возврат ТабДок;
			
		////	Возврат "Текущие баллы - " +  Рез.Баллы + ?(Рез.Призы="",""," Возможные призы: "+Рез.Призы);
		иначе
			Возврат "";
		КонецЕсли;
	Исключение
		Возврат "";
		
	КонецПопытки;
	
КонецФункции

