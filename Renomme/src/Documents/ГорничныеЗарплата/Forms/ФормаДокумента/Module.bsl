Процедура КвитокПечать(Команда)
ЭтаФорма.Записать(Новый Структура("РежимЗаписи", РежимЗаписиДокумента.Проведение)); 	
	
ТД = Элементы.Зарплата.ТекущиеДанные;	
Если ТД = Неопределено Тогда Возврат; КонецЕсли;

ТС = Элементы.Зарплата.ТекущаяСтрока;	

ТабДок = КвитокПечатьНаСервере(ТС);

ПараметрыФормы = Новый Структура("ПолеОтчета, ЗаголовокОтчета", ТабДок, "Квиток " + ТД.Горничная); 
ОткрытьФорму("ОбщаяФорма.ВыводОтчета", ПараметрыФормы, ,Истина);
