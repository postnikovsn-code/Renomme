//
&НаКлиенте
Процедура ДокументыКСписаниюОтметкаПриИзменении(Элемент)
ТД = Элементы.ДокументыКСписанию.ТекущиеДанные;	
Если (НЕ ТД.ДолгРавенСчетДолг) ИЛИ ТД.СуммаДолг = ТД.СуммаОплатыДолг Тогда
	ТД.Отметка = Ложь;		
КонецЕсли;
КонецПроцедуры


&НаКлиенте
Процедура УстановитьФлажки(Команда)
Для Каждого Строка Из Объект.ДокументыКСписанию Цикл
	Если (НЕ Строка.ДолгРавенСчетДолг) ИЛИ Строка.СуммаДолг = Строка.СуммаОплатыДолг Тогда
		Строка.Отметка = Ложь;		
	Иначе
		Строка.Отметка = Истина;		
	КонецЕсли;
КонецЦикла;		
КонецПроцедуры

&НаКлиенте
Процедура СнятьФлажки(Команда)
Для Каждого Строка Из Объект.ДокументыКСписанию Цикл
	Строка.Отметка = Ложь;		
КонецЦикла;		  
КонецПроцедуры
//

&НаСервере
Функция ИмяОбъекта()
ТекущийОбъект = РеквизитФормыВЗначение("Объект");
Имя = ТекущийОбъект.Метаданные().Имя;

Возврат Имя;
КонецФункции

&НаКлиенте
Процедура ОтборДокументовСписания(Команда)
Если НЕ ЗначениеЗаполнено(Объект.РезервСОтбор) Тогда Возврат; КонецЕсли;	
Если НЕ ЗначениеЗаполнено(Объект.РезервПоОтбор) Тогда Возврат; КонецЕсли;	
	
Оповещение = Новый ОписаниеОповещения("ЗавершениеФормы_ОтборДокументыКСписанию", ЭтаФорма);	
Имя = ИмяОбъекта();
ФормаИмя = "Документ." + Имя + ".Форма.ОтборДокументыКСписанию"; 

ПараметрыФормы = Новый Структура("РезервСОтбор, РезервПоОтбор", Объект.РезервСОтбор, Объект.РезервПоОтбор);

ОткрытьФорму(ФормаИмя, ПараметрыФормы, ЭтаФорма
	,,,, Оповещение, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
КонецПроцедуры

&НаКлиенте
Процедура ЗавершениеФормы_ОтборДокументыКСписанию(Результат, ДополнительныеПараметры) Экспорт
Если Результат = Неопределено Тогда Возврат; КонецЕсли;
	
ДокументыКСписаниюОтбор = Результат;
ДокументыКСписанию = Объект.ДокументыКСписанию;

Для Каждого Строка Из ДокументыКСписаниюОтбор Цикл
	ОтборСтроки = Новый Структура("ДокументДолг", Строка.ДокументДолг);
	НайденныеСтроки = ДокументыКСписанию.НайтиСтроки(ОтборСтроки);
	Если НайденныеСтроки.Количество() > 0 Тогда Продолжить; КонецЕсли; 
	
	НоваяСтрока = ДокументыКСписанию.Добавить();
	
	//НоваяСтрока.ДокументДолг = Строка.ДокументДолг;
	ЗаполнитьЗначенияСвойств(НоваяСтрока, Строка); 
КонецЦикла;

ЭтаФорма.Записать(Новый Структура(РежимЗаписиДокумента.Проведение));
КонецПроцедуры

//
&НаКлиенте
Процедура ДокументыКСписаниюПередНачаломДобавления(Элемент, Отказ, Копирование, Родитель, Группа, Параметр)
Отказ = Истина;
КонецПроцедуры

//
&НаКлиенте
Процедура ДокументыКСписаниюПередУдалением(Элемент, Отказ)
ТД = Элемент.ТекущиеДанные;	
Если ТД.СуммаСписано <> 0 Тогда
	ПоказатьПредупреждение(, "Есть документы списания
	|
	|Для удаления строки удалите документ списания в Заявке");
	
	Отказ = Истина;
	Возврат;
КонецЕсли;
	
Если ТД.ОстатокДолг <> 0 Тогда
	Текст = "ВНИМАНИЕ ! Остаток к оплате <> 0
		|
		|"; 
Иначе
	Текст = "";
КонецЕсли;
Текст = Текст + "ПОДТВЕРДИТЕ УДАЛЕНИЕ ..."; 

Оповещение = Новый ОписаниеОповещения("Завершение_ДокументыКСписаниюПередУдалением", ЭтаФорма);	
ПоказатьВопрос(Оповещение, Текст, РежимДиалогаВопрос.ОКОтмена); 
	
Отказ = Истина;
КонецПроцедуры

&НаКлиенте
Процедура Завершение_ДокументыКСписаниюПередУдалением(Результат, ДополнительныеПараметры) Экспорт
Если Результат = КодВозвратаДиалога.Отмена Тогда  Возврат; КонецЕсли;			

ТД = Элементы.ДокументыКСписанию.ТекущиеДанные;
ДокументДолг = ТД.ДокументДолг;
Объект.ДокументыКСписанию.Удалить(ТД);
УдалитьДокументСписанияНаСервере(ДокументДолг); 
КонецПроцедуры
//

//
&НаКлиенте
Процедура УдалитьДокументСписания(Команда)
ТД = Элементы.ДокументыКСписанию.ТекущиеДанные;

УдалитьДокументСписанияНаСервере(ТД.ДокументДолг);
КонецПроцедуры

&НаСервере
Процедура УдалитьДокументСписанияНаСервере(ДокументДолг)
НачатьТранзакцию();	
	
ДокументДолгОбъект = ДокументДолг.ПолучитьОбъект();

СтрокиОплаты = Новый Массив;
Для Каждого Строка Из ДокументДолгОбъект.СчетаДетальноОплаты Цикл
	Если Строка.ДокументОплаты.ВидОперации <> Справочники.ВидыОпераций.СписаниеДопУслуг Тогда Продолжить; КонецЕсли;
	
	СтрокиОплаты.Добавить(Строка);
КонецЦикла;

Для Каждого Строка Из СтрокиОплаты Цикл
	ЗаявкаСервер.УдалитьСтрокаОплатыНаСервере(Строка, ДокументДолгОбъект);
КонецЦикла;

ДокументДолгОбъект.Записать(РежимЗаписиДокумента.Проведение);

ЭтаФорма.Записать(Новый Структура(РежимЗаписиДокумента.Проведение));
ЗафиксироватьТранзакцию();	
КонецПроцедуры
//



//
&НаКлиенте
Процедура СоздатьДокументыСписания(Команда)
Если НЕ ЭтаФорма.Записать(Новый Структура(РежимЗаписиДокумента.Проведение)) Тогда Возврат; КонецЕсли;	

СоздатьДокументыСписанияНаСервере();
ЭтаФорма.Записать(Новый Структура(РежимЗаписиДокумента.Проведение));
КонецПроцедуры

&НаСервере
Процедура СоздатьДокументыСписанияНаСервере()
Ошибки.Очистить();	
	
Для Каждого Строка Из Объект.ДокументыКСписанию Цикл
	Если НЕ Строка.Отметка Тогда Продолжить; КонецЕсли;
	
	Строка.Отметка = Ложь;

	Если Строка.СуммаДолг = Строка.СуммаОплатыДолг Тогда Продолжить; КонецЕсли;
	Если Строка.СуммаДолг <> Строка.СуммаСчетДолг Тогда 
		НоваяСтрокаОшибки = Ошибки.Добавить();
		НоваяСтрокаОшибки.ДокументДолг = Строка.ДокументДолг;
		НоваяСтрокаОшибки.Примечание = "Сумма долга за доп. услуги <> сумме долга за доп. услуги в счетах.";
		
		//Сообщить("Заявка " + Строка.ДокументДолг 
		//	+ ". Сумма долга за доп. услуги <> сумме долга за доп. услуги в счетах. СОЗДАНИЕ ДОКУМЕНТА СПИСАНИЯ ОТМЕНЯЕТСЯ."); 
			
		Продолжить; 
	КонецЕсли;
	
	ДобавитьОплатаСписание(Строка);
КонецЦикла;	
КонецПроцедуры

&НаСервере
Процедура ДобавитьОплатаСписание(Строка)
ДокументДолгОбъект = Строка.ДокументДолг.ПолучитьОбъект();

СуммаКСписанию = СуммаКСписанию(ДокументДолгОбъект);
Если СуммаКСписанию = 0 Тогда Возврат; КонецЕсли;

ДобавитьОплатаСписаниеНаСервере(ДокументДолгОбъект, СуммаКСписанию);
КонецПроцедуры

&НаСервере
Функция СуммаКСписанию(ДокументДолгОбъект)
ОтборСтроки = Новый Структура("Услуга, ГрупповойСчет", Истина, Ложь);
//ОтборСтроки = Новый Структура("Услуга", Истина);

СчетаДетальноДолги = ДокументДолгОбъект.СчетаДетальноДолги.Выгрузить(ОтборСтроки);
СуммаДолг = СчетаДетальноДолги.Итог("СуммаКЗакрытию");  	
	
ОстатокДолга = СуммаДолг; // - ОплатыРаспределено;

Если ОстатокДолга < 0 Тогда ОстатокДолга = 0; КонецЕсли; 

Возврат ОстатокДолга;
КонецФункции

&НаСервере
Процедура ДобавитьОплатаСписаниеНаСервере(ДокументДолгОбъект, СуммаОплаты)
НачатьТранзакцию();

ДокументОплаты = ОплатыОбщееСервер.СоздатьПрочиеОплатыСписание(ДокументДолгОбъект.Клиент, ДокументДолгОбъект.Ссылка, СуммаОплаты
		, Справочники.ВидыОпераций.СписаниеДопУслуг);

СтрокаОплата = ЗаявкаСервер.ДобавитьОплатаСчетаДетальноОплаты(ДокументДолгОбъект.СчетаДетальноОплаты, ДокументОплаты, Ложь);  

ЗаявкаСервер.РаспределитьСтрокаОплатыСчетаДетальноДолги(СтрокаОплата, СуммаОплаты, ДокументДолгОбъект, Истина);
	
ДокументДолгОбъект.Записать(РежимЗаписиДокумента.Проведение);

ЭтаФорма.Записать(Новый Структура("РежимЗаписи", РежимЗаписиДокумента.Проведение));
ЗафиксироватьТранзакцию();
//ОтменитьТранзакцию();
КонецПроцедуры

&НаКлиенте
Процедура ДокументыКСписаниюВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
ТД = Элементы.ДокументыКСписанию.ДанныеСтроки(ВыбраннаяСтрока);

ПараметрыФормы = Новый Структура("Ключ", ТД.ДокументДолг);
ОткрытьФорму("Документ.ЗаявкаНаБронирование.Форма.ФормаДокумента", ПараметрыФормы, ЭтаФорма
	,,,,, РежимОткрытияОкнаФормы.Независимый);
КонецПроцедуры

&НаКлиенте
Процедура ОшибкиВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
ТД = Элементы.Ошибки.ДанныеСтроки(ВыбраннаяСтрока);

ПараметрыФормы = Новый Структура("Ключ", ТД.ДокументДолг);
ОткрытьФорму("Документ.ЗаявкаНаБронирование.Форма.ФормаДокумента", ПараметрыФормы, ЭтаФорма
	,,,,, РежимОткрытияОкнаФормы.Независимый);
КонецПроцедуры
//


//
&НаКлиенте
Процедура ПечатьАкта(Команда)
ТабДок = ПечатьАктаНаСервере();

ПараметрыФормы = Новый Структура("ПолеОтчета, ЗаголовокОтчета", ТабДок, "Акт списания: " + Объект.Ссылка); 
ОткрытьФорму("ОбщаяФорма.ВыводОтчета", ПараметрыФормы, ,Истина);
КонецПроцедуры

&НаСервере
Функция ПечатьАктаНаСервере()
ТабДок = Новый ТабличныйДокумент;

ИмяОбъекта = ИмяОбъекта();

//ИмяМакета = "Акт";
//МакетИмя = ПолучитьМакетИмяАкта(ИмяМакета); 
МакетИмя = "АктСписания";
Макет = Документы[ИмяОбъекта].ПолучитьМакет(МакетИмя);

Если НастройкиСервер.ЭтоРеноме() Тогда
	Область = Макет.ПолучитьОбласть("Реноме");
ИначеЕсли НастройкиСервер.ЭтоЛайв() Тогда
	Область = Макет.ПолучитьОбласть("Лайв");
ИначеЕсли НастройкиСервер.ЭтоДомСоветов() Тогда
	Область = Макет.ПолучитьОбласть("ДомСоветов");
ИначеЕсли НастройкиСервер.ЭтоЧехов() Тогда
	Область = Макет.ПолучитьОбласть("Чехов");
ИначеЕсли НастройкиСервер.ЭтоСтритАрт() Тогда
	Область = Макет.ПолучитьОбласть("СтритАрт");
КонецЕсли;
Если Область <> Неопределено Тогда ТабДок.Вывести(Область); КонецЕсли;

Область = Макет.ПолучитьОбласть("Заголовок");
НомерАкта = ОбщийФункционалКлиентСервер.УбратьНезначащиеНули(Объект.Номер); 
ТекстЗаголовка = "Акт списания доп. услуг № " + НомерАкта + " от " + Формат(Объект.Дата, "ДФ=dd.MM.yy"); 
Область.Параметры.ТекстЗаголовка = ТекстЗаголовка;
ТабДок.Вывести(Область);

Область = Макет.ПолучитьОбласть("ШапкаТаблицы|Лево");
ТабДок.Вывести(Область);

Для Каждого Строка Из УслугиРодительСправочник Цикл
	ОбластьУслуги = Макет.ПолучитьОбласть("ШапкаТаблицы|Услуга");
	ОбластьУслуги.Параметры.ШапкаУслуга = Строка.ЗаголовокОтчеты;
	ТабДок.Присоединить(ОбластьУслуги);
КонецЦикла;

ИтогоСуммаДолг = 0;
ИтогоСуммаСписано = 0;
ДатаРезервПо_П = ?(ЗначениеЗаполнено(Объект.РезервПоОтбор), Объект.РезервПоОтбор, '30010101');
Для Каждого СтрокаДокументыКСписанию Из Объект.ДокументыКСписанию Цикл
	Область = Макет.ПолучитьОбласть("Строка|Лево");
	
	//Если НЕ Строка.Отметка Тогда Продолжить; КонецЕсли;
	
	Если СтрокаДокументыКСписанию.СуммаДолг <> СтрокаДокументыКСписанию.СуммаСчетДолг Тогда Продолжить; КонецЕсли;
	Если СтрокаДокументыКСписанию.СуммаСписано = 0 Тогда Продолжить; КонецЕсли;

	ТЗ = Документы[ИмяОбъекта].ПолучитьДокументыКСписанию(Объект.РезервСОтбор, ДатаРезервПо_П, Ложь ,СтрокаДокументыКСписанию.ДокументДолг);
	Если  ТЗ.Количество() = 0 Тогда Продолжить; КонецЕсли;
	СтрокаДолг = ТЗ[0];
	Если СтрокаДолг.СуммаДолг <> СтрокаДолг.СуммаСчетДолг Тогда Продолжить; КонецЕсли;  
	
	Задолженность = "Задолженность за доп. услуги по документу " + СтрокаДокументыКСписанию.ДокументДолг;
	Область.Параметры.Товар = Задолженность;
	
	СуммаДолгТекущая = СтрокаДолг.ОстатокДолг + СтрокаДолг.СуммаСписано;
	Область.Параметры.СуммаДолг = СуммаДолгТекущая;
	Область.Параметры.СуммаСписано = СтрокаДолг.СуммаСписано;
	
	ИтогоСуммаДолг = ИтогоСуммаДолг + СуммаДолгТекущая;
	ИтогоСуммаСписано = ИтогоСуммаСписано + СтрокаДолг.СуммаСписано;

	ТабДок.Вывести(Область);
	
	//	
	Запрос = Новый Запрос("ВЫБРАТЬ
	                      |	ЗаявкаНаБронирование.Ссылка КАК ДокументДолг,
	                      |	ДопУслугиОплаты.Услуга КАК Услуга,
	                      |	ЕСТЬNULL(ДопУслугиОплаты.СуммаДолг, 0) КАК СуммаДолг,
	                      |	ЕСТЬNULL(ДопУслугиОплаты.СуммаОплаты, 0) КАК СуммаОплаты
	                      |ИЗ
	                      |	Документ.ЗаявкаНаБронирование КАК ЗаявкаНаБронирование
	                      |		ЛЕВОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
	                      |			ЗаявкаНаБронированиеДопУслуги.Ссылка КАК Ссылка,
	                      |			ЗаявкаНаБронированиеДопУслуги.Услуга КАК Услуга,
	                      |			ЗаявкаНаБронированиеДопУслуги.Цена * ЗаявкаНаБронированиеДопУслуги.Количество КАК СуммаДолг,
	                      |			ЗаявкаНаБронированиеРаспределениеОплатДолги.СуммаОплаты КАК СуммаОплаты
	                      |		ИЗ
	                      |			Документ.ЗаявкаНаБронирование.ДопУслуги КАК ЗаявкаНаБронированиеДопУслуги
	                      |				ЛЕВОЕ СОЕДИНЕНИЕ Документ.ЗаявкаНаБронирование.РаспределениеОплатДолги КАК ЗаявкаНаБронированиеРаспределениеОплатДолги
	                      |				ПО ЗаявкаНаБронированиеДопУслуги.Ссылка = ЗаявкаНаБронированиеРаспределениеОплатДолги.Ссылка
	                      |					И ЗаявкаНаБронированиеДопУслуги.ГУИД = ЗаявкаНаБронированиеРаспределениеОплатДолги.ДолгиГУИД
	                      |		ГДЕ
	                      |			ЗаявкаНаБронированиеДопУслуги.ВСчет = ИСТИНА
	                      |			И ЗаявкаНаБронированиеРаспределениеОплатДолги.ДокументОплаты.ВидОперации = ЗНАЧЕНИЕ(Справочник.ВидыОпераций.СписаниеДопУслуг)) КАК ДопУслугиОплаты
	                      |		ПО ЗаявкаНаБронирование.Ссылка = ДопУслугиОплаты.Ссылка
	                      |ГДЕ
	                      |	ЗаявкаНаБронирование.Ссылка = &ДокументДолг");


	Запрос.УстановитьПараметр("ДокументДолг", СтрокаДокументыКСписанию.ДокументДолг); 
	ТЗ_Услуги = Запрос.Выполнить().Выгрузить();	
		
	ТЗ_УслугиРодитель = ТЗ_Услуги.Скопировать();
	ТЗ_УслугиРодитель.Колонки.Добавить("УслугаРодитель");
	Для Каждого Строка Из ТЗ_УслугиРодитель Цикл 
		Результат = Справочники.ДопУслуги.ПустаяСсылка();
		Ссылка = Строка.Услуга; 
		ОбщийФункционалСервер.ВерхняяПапка(Ссылка, Результат);			
		
		Строка.УслугаРодитель = Результат;	
	КонецЦикла;	
	ТЗ_УслугиРодитель.Свернуть("ДокументДолг, УслугаРодитель", "СуммаДолг, СуммаОплаты");

	Для каждого СтрокаУслугиСправочник Из УслугиРодительСправочник Цикл
		ОбластьУслуга = Макет.ПолучитьОбласть("Строка|Услуга");
		
		ОтборСтроки = Новый Структура("ДокументДолг, УслугаРодитель", СтрокаДокументыКСписанию.ДокументДолг, СтрокаУслугиСправочник.УслугаРодитель);
		СтрокиУслугиРодитель = ТЗ_УслугиРодитель.НайтиСтроки(ОтборСтроки);
		Если СтрокиУслугиРодитель.Количество() > 0 Тогда 
			СтрокиУслугиРодитель = СтрокиУслугиРодитель[0]; 
			ОбластьУслуга.Параметры.СуммаУслуга = СтрокиУслугиРодитель.СуммаОплаты;
		КонецЕсли;
		
		ТабДок.Присоединить(ОбластьУслуга);
		
	КонецЦикла;
КонецЦикла;

Область = Макет.ПолучитьОбласть("Итого");
Область.Параметры.ИтогоСуммаДолг = ИтогоСуммаДолг;
Область.Параметры.ИтогоСуммаСписано = ИтогоСуммаСписано;
ТабДок.Вывести(Область);

Область = Макет.ПолучитьОбласть("Подписи");
ТабДок.Вывести(Область);

Возврат ТабДок; 
КонецФункции

