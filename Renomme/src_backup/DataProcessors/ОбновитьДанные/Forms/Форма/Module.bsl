КонецЦикла;

НоваяЗапись = ИсторияКлиента.Добавить();

НоваяЗапись.Клиент = Клиент;
//НоваяЗапись.Заявка = Заявка;
НоваяЗапись.ЗаявкаГУИД = ЗаявкаГУИД;

НоваяЗапись.ДатаЗаявки = Строка.Дата;
