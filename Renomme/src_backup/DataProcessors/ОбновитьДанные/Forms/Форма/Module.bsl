//
&НаКлиенте
Процедура ЗаполнитьДолгиОплатаКассовыйДокумент(Команда)
ЗаполнитьДолгиОплатаКассовыйДокументНаСервере();
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьДолгиОплатаКассовыйДокументНаСервере()
Запрос = Новый Запрос("ВЫБРАТЬ
               |	КассовыйДокумент.Ссылка КАК ДокументОплаты
               |ИЗ
               |	Документ.КассовыйДокумент КАК КассовыйДокумент
               |ГДЕ
               |	КассовыйДокумент.ПометкаУдаления = ЛОЖЬ");
	
ТЗОплаты = Запрос.Выполнить().Выгрузить();

Для Каждого СтрокаТЗОплаты Из ТЗОплаты Цикл
	ДокументОплаты = СтрокаТЗОплаты.ДокументОплаты;
	
	Запрос = Новый Запрос("ВЫБРАТЬ
	                      |	ЗаявкаНаБронированиеРаспределениеОплатДолги.Ссылка КАК ДокументДолг,
	                      |	ЗаявкаНаБронированиеРаспределениеОплатДолги.СчетГУИД КАК СчетГУИД,
	                      |	СУММА(ЗаявкаНаБронированиеРаспределениеОплатДолги.СуммаОплаты) КАК СуммаОплаты
	                      |ИЗ
	                      |	Документ.ЗаявкаНаБронирование.РаспределениеОплатДолги КАК ЗаявкаНаБронированиеРаспределениеОплатДолги
	                      |		ЛЕВОЕ СОЕДИНЕНИЕ Документ.ЗаявкаНаБронирование.Счета КАК ЗаявкаНаБронированиеСчета
	                      |		ПО ЗаявкаНаБронированиеРаспределениеОплатДолги.СчетГУИД = ЗаявкаНаБронированиеСчета.СчетГУИД
	                      |ГДЕ
	                      |	ЗаявкаНаБронированиеРаспределениеОплатДолги.Ссылка.ПометкаУдаления = ЛОЖЬ
	                      |	И ЗаявкаНаБронированиеРаспределениеОплатДолги.ДокументОплаты = &ДокументОплаты
	                      |	И ЗаявкаНаБронированиеСчета.ГрупповойСчет = ЗНАЧЕНИЕ(Документ.ГрупповыеСчета.ПустаяСсылка)
	                      |
	                      |СГРУППИРОВАТЬ ПО
	                      |	ЗаявкаНаБронированиеРаспределениеОплатДолги.Ссылка,
	                      |	ЗаявкаНаБронированиеРаспределениеОплатДолги.СчетГУИД");
	
	Запрос.УстановитьПараметр("ДокументОплаты", ДокументОплаты);
	
	ТЗДолги = Запрос.Выполнить().Выгрузить();
	Если ТЗДолги.Количество() = 0 Тогда Продолжить; КонецЕсли;
	
	ДокументОплатыОбъект = ДокументОплаты.ПолучитьОбъект();
	ДокументОплатыОбъект.ДолгиОплата.Очистить();
	Для Каждого СтрокаТЗДолги Из ТЗДолги Цикл 
		СтрокаДолгиОплата = ДокументОплатыОбъект.ДолгиОплата.Добавить();
		ЗаполнитьЗначенияСвойств(СтрокаДолгиОплата, СтрокаТЗДолги); 
		
		СтрокаДолгиОплата.Сумма = СтрокаТЗДолги.СуммаОплаты;		
	КонецЦикла;
	
	ДокументОплатыОбъект.Записать(РежимЗаписиДокумента.Проведение);
КонецЦикла;

// Групповые Счета
Для Каждого СтрокаТЗОплаты Из ТЗОплаты Цикл
	ДокументОплаты = СтрокаТЗОплаты.ДокументОплаты;
	
	Запрос = Новый Запрос("ВЫБРАТЬ
	                      |	ГрупповыеСчетаРаспределениеОплат.Ссылка.Ссылка КАК ДокументДолг,
	                      |	ГрупповыеСчетаРаспределениеОплат.Ссылка.СчетГУИД КАК СчетГУИД,
	                      |	СУММА(ГрупповыеСчетаРаспределениеОплат.СуммаОплаты) КАК СуммаОплаты
	                      |ИЗ
	                      |	Документ.ГрупповыеСчета.РаспределениеОплат КАК ГрупповыеСчетаРаспределениеОплат
	                      |ГДЕ
	                      |	ГрупповыеСчетаРаспределениеОплат.Ссылка.ПометкаУдаления = ЛОЖЬ
	                      |	И ГрупповыеСчетаРаспределениеОплат.ДокументОплаты = &ДокументОплаты
	                      |
	                      |СГРУППИРОВАТЬ ПО
	                      |	ГрупповыеСчетаРаспределениеОплат.Ссылка.Ссылка,
	                      |	ГрупповыеСчетаРаспределениеОплат.Ссылка.СчетГУИД");
	
	Запрос.УстановитьПараметр("ДокументОплаты", ДокументОплаты);
	
	ТЗДолги = Запрос.Выполнить().Выгрузить();
	Если ТЗДолги.Количество() = 0 Тогда Продолжить; КонецЕсли;
	
	ДокументОплатыОбъект = ДокументОплаты.ПолучитьОбъект();
	ДокументОплатыОбъект.ДолгиОплата.Очистить();
	Для Каждого СтрокаТЗДолги Из ТЗДолги Цикл 
		СтрокаДолгиОплата = ДокументОплатыОбъект.ДолгиОплата.Добавить();
		ЗаполнитьЗначенияСвойств(СтрокаДолгиОплата, СтрокаТЗДолги); 
		
		СтрокаДолгиОплата.Сумма = СтрокаТЗДолги.СуммаОплаты;		
	КонецЦикла;
	
	ДокументОплатыОбъект.Записать(РежимЗаписиДокумента.Проведение);
КонецЦикла;

КонецПроцедуры
