	Элементы.ВыпискаОплаты.ТолькоПросмотр = Истина;
	Элементы.ВыпискаСчета.ТолькоПросмотр = Истина;
	Элементы.ВыпискаСвязиОплатыСчета.ТолькоПросмотр = Истина;
