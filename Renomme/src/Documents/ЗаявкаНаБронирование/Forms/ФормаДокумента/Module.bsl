&НаКлиенте
Процедура ПровестиКоманда(Команда)
фл_ОтправитьСМС = Истина;
ЭтаФорма.Записать(Новый Структура("РежимЗаписи", РежимЗаписиДокумента.Проведение));
фл_ОтправитьСМС = Ложь;
КонецПроцедуры

&НаКлиенте
Процедура ПровестиИЗакрытьКоманда(Команда)
фл_ОтправитьСМС = Истина;
Если ЭтаФорма.Записать(Новый Структура("РежимЗаписи", РежимЗаписиДокумента.Проведение)) Тогда
	ЭтаФорма.Закрыть();	
КонецЕсли;
фл_ОтправитьСМС = Ложь;
КонецПроцедуры
//

//// + Отправка СМС

//
&НаКлиенте
Процедура ОтправитьСМСПослеЗаписи()
ВопросОтправитьСМС(Ложь); 
КонецПроцедуры

&НаКлиенте
Процедура ОтправитьСМСКоманда(Команда)
Если НЕ ЭтаФорма.Записать(Новый Структура("РежимЗаписи", РежимЗаписиДокумента.Проведение)) Тогда Возврат; КонецЕсли;	
	
ВопросОтправитьСМС(Истина);
КонецПроцедуры

&НаКлиенте
Процедура ВопросОтправитьСМС(ВызовИзКоманды) 
ОтменаБронирования = Неопределено;		
Если Объект.Статус = ПредопределенноеЗначение("Перечисление.СтатусБрони.Бронь") тогда
	ОтменаБронирования = Ложь;		
	
ИначеЕсли Объект.Статус = ПредопределенноеЗначение("Перечисление.СтатусБрони.ОтменаБронирования") Тогда
	ОтменаБронирования = Истина;		
КонецЕсли;
Если ОтменаБронирования = Неопределено Тогда Возврат; КонецЕсли;

КлиентТелефон = ОбщийФункционалСервер.ПолучитьЗначениеРеквизитаНаСервере(Объект.Клиент, "Телефон");
КлиентТелефон = СокрЛП(КлиентТелефон);

НетОтправленныхСМС = НетОтправленныхСМС(ОтменаБронирования);

Если НЕ НетОтправленныхСМС И НЕ ВызовИзКоманды Тогда Возврат; КонецЕсли;

Ответ = СлужебныеКлиентСервер.ПроверкаНомераТелефона(КлиентТелефон); 

Если Ответ.КодОшибки = 1 Тогда Возврат; КонецЕсли;

Если Ответ.КодОшибки = -1 Тогда
	ПоказатьПредупреждение(, "ОТПРАВКА СМС
							|
							|Некорректный номер телефона у клиента для отправки СМС: " + КлиентТелефон
		+ Символы.ПС + Символы.ПС + "Отправка СМС невозможна !");
		
	Если НетОтправленныхСМС Тогда	
		МесенджерВключен = МесенджерСервер.МесенджерВключен();
		ЗаписатьОтправкуСМС(КлиентТелефон, "", ОтменаБронирования
			, МесенджерВключен, 10, "Некорректный номер телефона: " + КлиентТелефон);
	КонецЕсли;
	
	Возврат;
КонецЕсли;

ДопПараметры = Новый Структура; 
ДопПараметры.Вставить("Телефон", КлиентТелефон); 
ДопПараметры.Вставить("ОтменаБронирования", ОтменаБронирования); 
ДопПараметры.Вставить("НетОтправленныхСМС", НетОтправленныхСМС); 

Оповещение = Новый ОписаниеОповещения("ЗавершениеВопросаОтправитьСМС", ЭтаФорма, ДопПараметры);

Если ОтменаБронирования Тогда
	ТекстВопроса = "Отправить СМС об отмене бронирования на номер:" + КлиентТелефон + " ?";
Иначе
	ТекстВопроса = "Отправить СМС о бронировании на номер: " + КлиентТелефон + " ?";
КонецЕсли;

Если НЕ НетОтправленныхСМС Тогда
	ТекстВопроса = "ПОВТОРНОЕ ОТПРАВЛЕНИЕ СМС. " + Символы.ПС + Символы.ПС + ТекстВопроса;
КонецЕсли;
	
ПоказатьВопрос(Оповещение, ТекстВопроса, РежимДиалогаВопрос.ДаНет);
КонецПроцедуры	

&НаКлиенте
Процедура ЗавершениеВопросаОтправитьСМС(Результат, ДопПараметры) Экспорт
КлиентТелефон = ДопПараметры.Телефон;
ОтменаБронирования = ДопПараметры.ОтменаБронирования;
НетОтправленныхСМС = ДопПараметры.НетОтправленныхСМС;

МесенджерВключен = МесенджерСервер.МесенджерВключен();

Если Результат = КодВозвратаДиалога.Да  Тогда
	Если ОтменаБронирования Тогда
		ТекстWhatsApp = ЗаполнитьТекстДляСМСОтменаБронирования();
		ТекстСМС = ЗаполнитьТекстДляСМСОтменаБронирования();
	Иначе
		ТекстWhatsApp = ЗаполнитьТекстДляWhatsAppБронирование();
		ТекстСМС = ЗаполнитьТекстДляСМСБронирование();
	КонецЕсли;
	
	Если НЕ ЗначениеЗаполнено(ТекстWhatsApp) Тогда ТекстWhatsApp = ТекстСМС; КонецЕсли;
	
	Результат = ОтправитьСМС(КлиентТелефон, ТекстСМС, ТекстWhatsApp, МесенджерВключен);
	
	Если МесенджерВключен И Результат.КодВозврата = 0 Тогда
		ТекстСообщения = ТекстWhatsApp;
	Иначе
		ТекстСообщения = ТекстСМС;
	КонецЕсли;		
	
	ЗаписатьОтправкуСМС(КлиентТелефон, ТекстСообщения, ОтменаБронирования
		, МесенджерВключен, Результат.КодВозврата, Результат.ОписаниеОшибки);
	
Иначе	
	Если НетОтправленныхСМС Тогда
		Если ОтменаБронирования Тогда
			ТекстСМС = "Отмена отправки СМС об отмене бронирования";
		Иначе
			ТекстСМС = "Отмена отправки СМС о бронировании";
		КонецЕсли;
		
		ЗаписатьОтправкуСМС(КлиентТелефон, ТекстСМС, ОтменаБронирования
			, МесенджерВключен, 0, "");
	КонецЕсли; 	
КонецЕсли; 	
КонецПроцедуры	

&НаСервере
Функция НетОтправленныхСМС(ОтметкаОтменаБронирования)   
ОтборСтроки = Новый Структура("ОтметкаОтменаБронирования, КодОшибки", ОтметкаОтменаБронирования, 0);
НайденныеСтроки = Объект.СМС.НайтиСтроки(ОтборСтроки);

Возврат НайденныеСтроки.Количество() = 0;
КонецФункции

&НаСервере
Функция НетОтправленныхСМС_Регистр(ОтметкаОтменаБронирования)
Запрос = Новый Запрос("ВЫБРАТЬ
                      |	СМС.Бронь КАК Бронь
                      |ИЗ
                      |	РегистрСведений.СМС КАК СМС
                      |ГДЕ
                      |	СМС.Бронь = &Бронь
                      |	И СМС.ОтметкаОтменаБронирования = &ОтметкаОтменаБронирования");
Запрос.УстановитьПараметр("Бронь", Объект.Ссылка);
Запрос.УстановитьПараметр("ОтметкаОтменаБронирования", ОтметкаОтменаБронирования);

Возврат Запрос.Выполнить().Пустой();
КонецФункции

&НаКлиенте
Функция ЗаполнитьТекстДляWhatsAppБронирование() Экспорт
КатегорияНомераНаименование = ОбщийФункционалСервер.ПолучитьЗначениеРеквизитаНаСервере(Объект.КатегорияНомера, "Наименование");

//СуммаИтого = Объект.Проживание.Итог("Сумма");
СуммаИтого = Объект.СчетаДетальноДолги.Итог("СуммаДолг");

ТекстДляСМС = "";	
Если НастройкиСервер.ЭтоЛайв() Тогда
	ТекстДляСМС = ТекстДляСМС + "Дорогой Гость!";
	ТекстДляСМС = ТекстДляСМС + Символы.ПС + "Подтверждаем бронирование в city-отеле LIVE!";
	ТекстДляСМС = ТекстДляСМС + Символы.ПС + "Номер: " + КатегорияНомераНаименование;
	ТекстДляСМС = ТекстДляСМС + Символы.ПС + "Кол-во Гостей: " + Строка(Объект.КолВоЧеловек);
	ТекстДляСМС = ТекстДляСМС + Символы.ПС + "Заезд: " + Формат(Объект.РезервС, "ДФ=dd.MM.yy");
	ТекстДляСМС = ТекстДляСМС + Символы.ПС + "Выезд: " + Формат(Объект.РезервПо, "ДФ=dd.MM.yy");
	
	ТекстДляСМС = ТекстДляСМС + Символы.ПС + "Итого: " + СуммаИтого;
	
	ТекстДляСМС = ТекстДляСМС + Символы.ПС + "Будем рады принять любые пожелания и ответить на Ваши вопросы.";
	ТекстДляСМС = ТекстДляСМС + Символы.ПС + "До скорой встречи!";
	ТекстДляСМС = ТекстДляСМС + Символы.ПС + "г. Екатеринбург, ул.Красноармейская, 72";
ИначеЕсли НастройкиСервер.ЭтоЧехов() Тогда
	ТекстДляСМС = ТекстДляСМС + "Дорогой Гость!";
	ТекстДляСМС = ТекстДляСМС + Символы.ПС + "Подтверждаем бронирование в бутик-отель 'Чехов'!";
	ТекстДляСМС = ТекстДляСМС + Символы.ПС + "Номер: " + КатегорияНомераНаименование;
	ТекстДляСМС = ТекстДляСМС + Символы.ПС + "Кол-во Гостей: " + Строка(Объект.КолВоЧеловек);
	ТекстДляСМС = ТекстДляСМС + Символы.ПС + "Заезд: " + Формат(Объект.РезервС, "ДФ=dd.MM.yy");
	ТекстДляСМС = ТекстДляСМС + Символы.ПС + "Выезд: " + Формат(Объект.РезервПо, "ДФ=dd.MM.yy");
	
	ТекстДляСМС = ТекстДляСМС + Символы.ПС + "Итого: " + СуммаИтого;
	
	ТекстДляСМС = ТекстДляСМС + Символы.ПС + "Будем рады принять любые пожелания и ответить на Ваши вопросы.";
