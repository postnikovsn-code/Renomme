		ГорничныеПомещение = Справочники.ГорничныеПомещения.НайтиПоРеквизиту("ПомещениеГорничные", СтрокаУборки.ПомещениеГорничные);
		Если НЕ ЗначениеЗаполнено(ГорничныеПомещение) Тогда
			Сообщить("Не найдено помещение в справочнике Горничные помещения. Номер из БД Горничные: " 
				+ ?(ЗначениеЗаполнено(СтрокаУборки.ПомещениеГорничные), СтрокаУборки.ПомещениеГорничные, "Пусто") 
				+ ". ДАННЫЕ ДОКУМЕНТА НЕ ЗАГРУЖЕНЫ."); 
				
			Продолжить;	
		КонецЕсли; 
		
		НоваяСтрока.ГорничныеПомещение = ГорничныеПомещение;
		
		НоваяСтрока.ВремяУборки = СтрокаУборки.ВремяУборки;
		НоваяСтрока.Обслужено = СтрокаУборки.Обслужено;
		
		//ГорничнаяНаименование = СтрокаУборки.ГорничнаяНаименование;
		//Если СокрЛП(ГорничнаяНаименование) = "" Тогда
		//	Горничная = Неопределено;
		//Иначе	
		//	Горничная = Справочники.Горничные.НайтиПоНаименованию(СтрокаУборки.ГорничнаяНаименование);
		//	Если Горничная.Пустая() Тогда
		//		НовГ=Справочники.Горничные.СоздатьЭлемент();
		//		НовГ.Наименование=СтрокаУборки.ГорничнаяНаименование;
		//		НовГ.Записать();
		//		Горничная = НовГ.Ссылка;
		//	КонецЕсли;
		//КонецЕсли;
		//НоваяСтрока.Горничная = Горничная;
	КонецЦикла;
	
	//ГорничныеОбслуживаниеПомещенияОбъект.ГорничныеПомещение = ГорничныеПомещение;
	//ГорничныеОбслуживаниеПомещенияОбъект.ВремяУборки = Строка.ВремяУборки;
	//ГорничныеОбслуживаниеПомещенияОбъект.Обслужено = Строка.Обслужено;
	//
	//ГорничнаяНаименование = Строка.ГорничнаяНаименование;
	//Если СокрЛП(ГорничнаяНаименование) = "" Тогда
	//	Горничная = Неопределено;
	//Иначе	
	//	Горничная = Справочники.Горничные.НайтиПоНаименованию(Строка.ГорничнаяНаименование);
	//	Если Горничная.Пустая() Тогда
	//		НовГ=Справочники.Горничные.СоздатьЭлемент();
	//		НовГ.Наименование=Строка.ГорничнаяНаименование;
	//		НовГ.Записать();
	//		Горничная = НовГ.Ссылка;
	//	КонецЕсли;
	//КонецЕсли;
	//ГорничныеОбслуживаниеПомещенияОбъект.Горничная = Горничная;
	
	Если Строка.ПометкаУдаления Тогда
		ГорничныеОбслуживаниеПомещенияОбъект.Записать(РежимЗаписиДокумента.Запись);
	Иначе
		ГорничныеОбслуживаниеПомещенияОбъект.Записать(РежимЗаписиДокумента.Проведение);
	КонецЕсли;	
КонецЦикла;
КонецПроцедуры

Процедура ЗагрузитьСмены(ДатаОбслуживания_С, ДатаОбслуживания_По) Экспорт
ОбменСГорничными = Константы.ОбменСГорничными.Получить();
Если НЕ ОбменСГорничными Тогда Возврат; КонецЕсли;

Соединение = Соединение();
Если Соединение = Неопределено Тогда 
	Сообщить("Нет связи с БД Горничные. ОБРАТИТЕСЬ К АДМИНИСТРАТОРУ ПРОГРАММЫ");
	
	Возврат;
КонецЕсли;

Попытка
	ТЗДанные = Соединение.ОбменГорничныеСервер.ВыгрузитьСмены(ДатаОбслуживания_С, ДатаОбслуживания_По);
Исключение
	Сообщить("Ошибка загрузки смен. " + ОписаниеОшибки());
	
	Возврат;
КонецПопытки;
	
Для Каждого Строка Из ТЗДанные Цикл
	
	ГорничнаяНаименование = Строка.ГорничнаяНаименование;
	Если СокрЛП(ГорничнаяНаименование) = "" Тогда
		Горничная = Неопределено;
	Иначе	
		Горничная = Справочники.Горничные.НайтиПоНаименованию(Строка.ГорничнаяНаименование);
		Если Горничная.Пустая() Тогда
			НовГ=Справочники.Горничные.СоздатьЭлемент();
			НовГ.Наименование=Строка.ГорничнаяНаименование;
			НовГ.Записать();
			Горничная = НовГ.Ссылка;
		КонецЕсли;
	КонецЕсли;
	
	Запрос = Новый Запрос("ВЫБРАТЬ
	                      |	ГорничныеСмены.Ссылка КАК Ссылка
	                      |ИЗ
	                      |	Документ.ГорничныеСмены КАК ГорничныеСмены
	                      |ГДЕ
	                      |	ГорничныеСмены.ПометкаУдаления = ЛОЖЬ
	                      |	И ГорничныеСмены.ДатаСмены = &ДатаСмены
	                      |	И ГорничныеСмены.Горничная = &Горничная");
	
	//Запрос.УстановитьПараметр("ГУИД", Строка.ГУИД);
	Запрос.УстановитьПараметр("ДатаСмены", Строка.ДатаСмены);
	Запрос.УстановитьПараметр("Горничная", Горничная);
	
	ТЗ = Запрос.Выполнить().Выгрузить();

	Если ТЗ.Количество() = 0 Тогда
		ГорничныеСменыОбъект = Документы.ГорничныеСмены.СоздатьДокумент();
		ГорничныеСменыОбъект.Дата = ТекущаяДата();
	Иначе
		ГорничныеСменыОбъект = ТЗ[0].Ссылка.ПолучитьОбъект();
	КонецЕсли;
	
	Если Строка.ПометкаУдаления Тогда
		Если ЗначениеЗаполнено(ГорничныеСменыОбъект.Ссылка) Тогда
			ГорничныеСменыОбъект.УстановитьПометкуУдаления(Истина);
		Иначе
			ГорничныеСменыОбъект.ПометкаУдаления = Истина;
		КонецЕсли;	
	Иначе
		Если ЗначениеЗаполнено(ГорничныеСменыОбъект.Ссылка) Тогда
			ГорничныеСменыОбъект.УстановитьПометкуУдаления(Ложь);
		Иначе
			ГорничныеСменыОбъект.ПометкаУдаления = Ложь;
		КонецЕсли;	
	КонецЕсли;	
	
	ГорничныеСменыОбъект.ГУИД = Новый УникальныйИдентификатор(Строка.ГУИДСтрока);
	ГорничныеСменыОбъект.ДатаСмены = Строка.ДатаСмены;
	
	Если ЗначениеЗаполнено(Строка.ВремяОткрытияСмены) Тогда
		ГорничныеСменыОбъект.ВремяОткрытияСмены = Строка.ВремяОткрытияСмены;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(Строка.ВремяЗакрытияСмены) Тогда
		ГорничныеСменыОбъект.ВремяЗакрытияСмены = Строка.ВремяЗакрытияСмены;
	КонецЕсли;
	
	//ГорничнаяНаименование = Строка.ГорничнаяНаименование;
	//Если СокрЛП(ГорничнаяНаименование) = "" Тогда
	//	Горничная = Неопределено;
	//Иначе	
	//	Горничная = Справочники.Горничные.НайтиПоНаименованию(Строка.ГорничнаяНаименование);
	//	Если Горничная.Пустая() Тогда
	//		НовГ=Справочники.Горничные.СоздатьЭлемент();
	//		НовГ.Наименование=Строка.ГорничнаяНаименование;
	//		НовГ.Записать();
	//		Горничная = НовГ.Ссылка;
	//	КонецЕсли;
	//КонецЕсли;
	ГорничныеСменыОбъект.Горничная = Горничная;
	
	Если Строка.ПометкаУдаления Тогда
		ГорничныеСменыОбъект.Записать(РежимЗаписиДокумента.Запись);
	Иначе
		ГорничныеСменыОбъект.Записать(РежимЗаписиДокумента.Проведение);
	КонецЕсли;	
КонецЦикла;
КонецПроцедуры
