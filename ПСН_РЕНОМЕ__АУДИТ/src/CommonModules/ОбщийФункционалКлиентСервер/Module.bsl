Функция ТекстСообщенияИзМассив(Массив) Экспорт
ТекстСообщенияИзМассив = "";
Для Каждого Элемент Из Массив Цикл
	ТекстСообщенияИзМассив = ТекстСообщенияИзМассив + Элемент;	
КонецЦикла;

Возврат ТекстСообщенияИзМассив; 
КонецФункции

Процедура УбратьКнопкуКоманднойПанелиФормы_КУдалению(КоманднаяПанель, ИмяКнопки) Экспорт
ТекущийПользовательКодРавноАдминистратор = НастройкиСервер.ТекущийПользовательКодРавноАдминистратор();	
Если НЕ ТекущийПользовательКодРавноАдминистратор Тогда
	КнопкаУдалить = КоманднаяПанель.ПодчиненныеЭлементы.Найти(ИмяКнопки);
	Если КнопкаУдалить <> Неопределено Тогда 
		КнопкаУдалить.Видимость = Ложь;
	КонецЕсли;
КонецЕсли;
КонецПроцедуры

Функция ДобавитьТекст(ТекстИсходный, ТекстДобавление, Разделитель) Экспорт
Если ТекстИсходный = "" Тогда
	ТекстРезультат = ТекстДобавление;
Иначе
	Если ТекстДобавление = "" Тогда 
		ТекстРезультат = ТекстИсходный;
	Иначе
		ТекстРезультат = ТекстИсходный + Разделитель + ТекстДобавление;
	КонецЕсли;	
КонецЕсли;

Возврат ТекстРезультат;
КонецФункции	

Функция НайтиВМассивеСтрок(Массив, Имя, Значение) Экспорт
Для Каждого Элемент Из Массив Цикл
	Если Элемент[Имя] = Значение Тогда
		Возврат Элемент;		
	КонецЕсли;	
КонецЦикла;	

Возврат Неопределено;
КонецФункции	

//
Процедура ЗаполнитьЭлементОтбораСписок(Список, ИмяПолеКомпоновкиДанных, ПравоеЗначение
	, ВидСравненияКомпоновкиДанных, ВсеПриПусто) Экспорт
	
ПолеКомпоновкиДанных = Новый ПолеКомпоновкиДанных(ИмяПолеКомпоновкиДанных);	

ЭлементОтбора = ЭлементОтбора(Список, ПолеКомпоновкиДанных);
Если ЭлементОтбора = Неопределено Тогда
	Если (НЕ ЗначениеЗаполнено(ПравоеЗначение)) И (ВсеПриПусто) Тогда Возврат; КонецЕсли;
	
	ЭлементОтбора = Список.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	ЭлементОтбора.ЛевоеЗначение = ПолеКомпоновкиДанных;
Иначе
	Если (НЕ ЗначениеЗаполнено(ПравоеЗначение)) И (ВсеПриПусто) Тогда
		Список.Отбор.Элементы.Удалить(ЭлементОтбора);	
		
		Возврат;
	КонецЕсли;
КонецЕсли;

ЭлементОтбора.ВидСравнения = ВидСравненияКомпоновкиДанных;
ЭлементОтбора.Использование = Истина;
ЭлементОтбора.ПравоеЗначение = ПравоеЗначение;	
КонецПроцедуры

Функция ЭлементОтбора(Список, ПолеКомпоновкиДанных) 
Для Каждого Элемент Из Список.Отбор.Элементы Цикл
	Если Элемент.ЛевоеЗначение = ПолеКомпоновкиДанных Тогда Возврат Элемент; КонецЕсли;
КонецЦикла;	
Возврат Неопределено;
КонецФункции	
