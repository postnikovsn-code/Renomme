		, Строка.ДокументОплаты, Строка.ДокументДолг);
	НайденныеСтроки = ПрошлыйПериодДопУслуги.НайтиСтроки(ОтборСтроки);	
	
	Если НайденныеСтроки.Количество() = 0 Тогда
		СтрокаПрошлыйПериодДопУслуги = ПрошлыйПериодДопУслуги.Добавить();
		СтрокаПрошлыйПериодДопУслуги.ПрочиеОплатыДокументОплаты = Строка.ДокументОплаты;
		СтрокаПрошлыйПериодДопУслуги.ПрочиеОплатыДокументДолг = Строка.ДокументДолг;
	Иначе
		СтрокаПрошлыйПериодДопУслуги = НайденныеСтроки[0]; 
	КонецЕсли;
	
	СтрокаПрошлыйПериодДопУслуги.Сумма = Сумма;
	//	
КонецЦикла;
