Процедура ПолучитьКлиентИзЗаявкаСайт()
Результат = ПолучитьКлиентИзЗаявкаСайтНаСервере();

Если Результат = Неопределено Тогда
	ЗаполнитьЗаявкуИзЗаявкаСайтТекстПредупреждения = "У клиента из заявки с сайта ФИО - пусто
		|
		|СОЗДАЙТЕ Клиента из данных Заявки с сайта ..."	;
	
	КлиентИзЗаявкаСайт = Неопределено;
	ЗаполнитьЗаявкуИзЗаявкаСайтОткрытьФормуКлиента = Истина;
ИначеЕсли Результат.ТипСовпадения = 1 Тогда
	ЗаполнитьЗаявкуИзЗаявкаСайтТекстПредупреждения = Результат.Текст + "
		|
		|СОЗДАЙТЕ Клиента из данных Заявки с сайта ..."	;
		
	КлиентИзЗаявкаСайт = Неопределено;
	ЗаполнитьЗаявкуИзЗаявкаСайтОткрытьФормуКлиента = Истина;
ИначеЕсли Результат.ТипСовпадения = 2 Тогда
	ЗаполнитьЗаявкуИзЗаявкаСайтТекстПредупреждения = Результат.Текст + "
		|
		|ВЫБЕРИТЕ Клиента непосредственно в заявке ...";	
		
	КлиентИзЗаявкаСайт = Неопределено;
	ЗаполнитьЗаявкуИзЗаявкаСайтОткрытьФормуКлиента = Истина;
Иначе
	КлиентИзЗаявкаСайт = Результат.Клиент;	
	
	ЗаполнитьЗаявкуИзЗаявкаСайтТекстПредупреждения = Результат.Текст;
	ЗаполнитьЗаявкуИзЗаявкаСайтОткрытьФормуКлиента = Ложь;
КонецЕсли;
КонецПроцедуры

&НаСервере
Функция ПолучитьКлиентИзЗаявкаСайтНаСервере()
Результат = Новый Структура("Клиент, ТипСовпадения, Текст"
	, Неопределено, 1, "Нет совпадений наименования (ФИО) или телефона");
Клиент = Неопределено;	
	
Если ЗначениеЗаполнено(ЗаявкаСайтОбъект.Фамилия) Тогда
	КлиентНаименование = ЗаявкаСайтОбъект.Фамилия;
	Если ЗначениеЗаполнено(ЗаявкаСайтОбъект.Имя) Тогда
	    КлиентНаименование = КлиентНаименование + " " + ЗаявкаСайтОбъект.Имя;
	КонецЕсли;
Иначе
	Возврат Неопределено;
КонецЕсли;
КлиентНаименование = "%" + КлиентНаименование + "%";

Ответ = СлужебныеКлиентСервер.ПроверкаНомераТелефона(ЗаявкаСайтОбъект.Телефон); 
Если Ответ.КодОшибки = -1 Тогда
	ТелефонНормализованный = "";	
Иначе	
	ТелефонНормализованный = Ответ.ТелефонНомер;	
КонецЕсли;

ЗапросТекст = "ВЫБРАТЬ ПЕРВЫЕ 2
              |	Клиенты.Ссылка КАК Ссылка
              |ИЗ
              |	Справочник.Клиенты КАК Клиенты
              |ГДЕ
              |	Клиенты.ПометкаУдаления = ЛОЖЬ";

Если ТелефонНормализованный = "" Тогда
	ЗапросТекстНаименование = ЗапросТекст + "
				|	И Клиенты.Наименование Подобно &КлиентНаименование";
	Запрос = Новый Запрос(ЗапросТекстНаименование);
	Запрос.УстановитьПараметр("КлиентНаименование", КлиентНаименование);

	ТЗ = Запрос.Выполнить().Выгрузить();
	Если ТЗ.Количество() = 1 Тогда
		Результат.Клиент = ТЗ[0].Ссылка;
		Результат.ТипСовпадения = 0;
		Результат.Текст = "Совпало наименование (ФИО) клиента из Заявки";
	ИначеЕсли ТЗ.Количество() > 1 Тогда
		Результат.ТипСовпадения = 2;
		Результат.Текст = "Найдено несколько совпадений наименования (ФИО) клиента из Заявки";
	Иначе	
		Результат.ТипСовпадения = 1;
		Результат.Текст = "Нет совпадений наименования (ФИО)";
	КонецЕсли;
Иначе
	ЗапросТекстНаименованиеТелефон = ЗапросТекст + "
				|	И Клиенты.Наименование Подобно &КлиентНаименование
				|	И Клиенты.ТелефонНормализованный = &ТелефонНормализованный";
	Запрос = Новый Запрос(ЗапросТекстНаименованиеТелефон);
	Запрос.УстановитьПараметр("ТелефонНормализованный", ТелефонНормализованный); 
	
	Запрос.УстановитьПараметр("КлиентНаименование", КлиентНаименование);

	ТЗ = Запрос.Выполнить().Выгрузить();
	Если ТЗ.Количество() = 1 Тогда
		Результат.Клиент = ТЗ[0].Ссылка;
		Результат.ТипСовпадения = 0;
		Результат.Текст = "Совпало наименование (ФИО) и телефон.";
	ИначеЕсли ТЗ.Количество() > 1 Тогда
		Результат.ТипСовпадения = 2;
		Результат.Текст = "Найдено несколько совпадений наименования (ФИО) и телефона";
	Иначе
		ЗапросТекстТелефон = ЗапросТекст + "
					|	И Клиенты.ТелефонНормализованный = &ТелефонНормализованный";
		Запрос = Новый Запрос(ЗапросТекстТелефон);
		Запрос.УстановитьПараметр("ТелефонНормализованный", ТелефонНормализованный); 
		
		ТЗ_1 = Запрос.Выполнить().Выгрузить();
		Если ТЗ_1.Количество() = 1 Тогда
			Результат.Клиент = ТЗ_1[0].Ссылка;
			Результат.ТипСовпадения = 0;
			Результат.Текст = "Совпал телефон.";
		ИначеЕсли ТЗ_1.Количество() > 1 Тогда
			Результат.ТипСовпадения = 2;
			Результат.Текст = "Найдено несколько совпадений телефона";
			
		Иначе
			ЗапросТекстНаименование = ЗапросТекст + "
				|	И Клиенты.Наименование Подобно &КлиентНаименование
				|	И Клиенты.ТелефонНормализованный <> &ТелефонНормализованный
				|";
			Запрос = Новый Запрос(ЗапросТекстНаименование);
			Запрос.УстановитьПараметр("КлиентНаименование", КлиентНаименование); 
			Запрос.УстановитьПараметр("ТелефонНормализованный", ТелефонНормализованный); 
			
			ТЗ_2 = Запрос.Выполнить().Выгрузить();
			Если ТЗ_2.Количество() = 1 Тогда
				Результат.Клиент = ТЗ_2[0].Ссылка;
				Результат.ТипСовпадения = 0;
				Результат.Текст = "Совпали наименование (ФИО) и НЕ совпал телефон";
			ИначеЕсли ТЗ_2.Количество() > 1 Тогда
				Результат.ТипСовпадения = 2;
				Результат.Текст = "Найдено несколько совпадений наименования (ФИО)";
			Иначе
				Результат.ТипСовпадения = 1;
				Результат.Текст = "Нет совпадений наименования (ФИО) или телефона";
			КонецЕсли;
		КонецЕсли;	
	КонецЕсли;	
КонецЕсли;	

Возврат Результат;
КонецФункции

&НаСервере
Процедура ЗаполнитьЗаявкуИзЗаявкаСайт()
Объект.Дата = ТекущаяДата();
Объект.ЗаявкаСайт = ЗаявкаСайт;

Объект.Клиент = КлиентИзЗаявкаСайт;

Объект.КолВоЧеловек = 1;

Объект.РезервС = ЗаявкаСайтОбъект.ДатаЗаезда;
Объект.РезервПо = ЗаявкаСайтОбъект.ДатаВыезда;

Объект.ВремяЗаезда = ЗаявкаСайтОбъект.ВремяЗаезда;
Объект.ВремяВыезда = ЗаявкаСайтОбъект.ВремяВыезда;

Объект.КатегорияНомера = ЗаявкаСайтОбъект.КатегорияНомера;
Объект.РаздельныеКровати = ЗаявкаСайтОбъект.РаздельныеКровати;

Объект.БезЗавтрака = НЕ ЗаявкаСайтОбъект.Завтрак;
Объект.КолВоЧеловек = ЗаявкаСайтОбъект.КоличествоЧеловек;

Объект.КаналБронирования = Справочники.КаналыБронирования.НашCайт;
Объект.ТипБронирования = Справочники.ТипБронирования.ЧастныйГость;

Объект.Примечание = ЗаявкаСайтОбъект.Комментарий;

Проживание = Объект.Проживание;

Для Каждого Строка Из ЗаявкаСайтОбъект.Проживание Цикл
	Если Строка.СуммаЗаДень = 0 Тогда
		Прервать;		
	КонецЕсли;
	
	НоваяСтрока = Проживание.Добавить();
	НоваяСтрока.ГУИД = Новый УникальныйИдентификатор();
	
	НоваяСтрока.ДеньПроживания = Строка.ДатаПроживания;
	НоваяСтрока.Цена = Строка.СуммаЗаДень;
	НоваяСтрока.Количество = 1;
	НоваяСтрока.Сумма = Строка.СуммаЗаДень;
	НоваяСтрока.СуммаБезСкидки = Строка.СуммаЗаДень;
КонецЦикла;	
КонецПроцедуры
