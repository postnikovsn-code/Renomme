
&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
Если РаботаСИнтерфейсомСервер.УстановитьТолькоПросмотр(ЭтаФорма) Тогда Отказ = Истина; Возврат; КонецЕсли;
	
//Если ЭтоНовый() тогда
Если НЕ ЗначениеЗаполнено(Объект.Ссылка) Тогда
	Спр=Справочники.ЦелиВизита.Выбрать(,,,"Код");
	Пока Спр.Следующий() Цикл
		НовВ=Объект.ЦелиВизита.Добавить();
		НовВ.Цель=Спр.Ссылка;
	КонецЦикла;
	
	Спр=Справочники.ВопросыАнкеты.Выбрать(,,,"Код");
	Пока Спр.Следующий() Цикл
		НовВ=Объект.Вопросы.Добавить();
		НовВ.Вопрос=Спр.Ссылка;
	КонецЦикла;

	Спр=Справочники.ХарактеристикиОтеля.Выбрать(,,,"Код");
	Пока Спр.Следующий() Цикл
		НовВ=Объект.ХарактеристикиОтеля.Добавить();
		НовВ.Характеристика=Спр.Ссылка;
	КонецЦикла;

КонецЕсли;
КонецПроцедуры

