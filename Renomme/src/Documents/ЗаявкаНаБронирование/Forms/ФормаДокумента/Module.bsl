&НаКлиенте
Процедура СоздатьПустойСчет(Команда)
ПараметрыФормы = Новый Структура();	
ПараметрыФормы.Вставить("ДокументДолг", Объект);

// + Счет
СчетГУИД = ОбщийФункционалСервер.УникальныйИдентификаторПустой();

КонтрагентПустаяСсылка = ПредопределенноеЗначение("Справочник.Клиенты.ПустаяСсылка");

ЕстьКлиент2 = (ЗначениеЗаполнено(Объект.Клиент2) И Объект.РазделитьСчет);
Если ЕстьКлиент2 Тогда 
	Клиент = КонтрагентПустаяСсылка;
Иначе
	Клиент = Объект.Клиент;
КонецЕсли;

Если ЗначениеЗаполнено(Объект.Оплачивает) Тогда 
	Контрагент = Объект.Оплачивает;
ИначеЕсли ЕстьКлиент2 Тогда 
	Контрагент = КонтрагентПустаяСсылка;
Иначе
	Контрагент = Объект.Клиент;
КонецЕсли;

ТолькоПроживание = Ложь;
ТолькоУслуги = Ложь;
РазделитьСчет = Ложь;
СвернутьВСчете = ЛОжь;
Закрыт = Ложь;
ДатаС = Объект.РезервС;
ДатаПо =  Объект.РезервПо; 
НомерСчета = 0; 
ДатаСчета = ТекущаяДата();

ГрупповойСчет = Неопределено; 
ЭтоПредварительныйГрупповойСчет = ЭтоПредварительныйГрупповойСчет(Контрагент); 

Счет = ЗаявкаСервер.СчетСтруктура(СчетГУИД, Контрагент, Клиент, ТолькоПроживание, ТолькоУслуги, РазделитьСчет
	, СвернутьВСчете, Закрыт, ДатаС, ДатаПо, НомерСчета, ДатаСчета, ГрупповойСчет, ЭтоПредварительныйГрупповойСчет); 
ПараметрыФормы.Вставить("Счет", Счет);
// - Счет

ОткрытьФорму("ОбщаяФорма.СчетНаОплату", ПараметрыФормы, Элементы.Счета
	,,,, , РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
КонецПроцедуры

// + СчетНаОплатуОткрытьФорму
&НаКлиенте
Процедура СчетаВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
Если Поле.Имя = "СчетаДатаСчета"
ИЛИ Поле.Имя = "СчетаСвернутьВСчете" 
ИЛИ  Поле.Имя = "ЭтоПредварительныйГрупповойСчет"
ИЛИ Поле.Имя = "СчетаКонтрагент"
Тогда Возврат; КонецЕсли;	

ТекущиеДанные = Элемент.ТекущиеДанные;

Если Поле.Имя = "СчетаГрупповойСчет" Тогда 
	Если ЗначениеЗаполнено(ТекущиеДанные.ГрупповойСчет) Тогда
		ПараметрыФормы = Новый Структура;
		ПараметрыФормы.Вставить("Ключ", ТекущиеДанные.ГрупповойСчет); 
		ОткрытьФорму("Документ.ГрупповыеСчета.Форма.ФормаДокумента", ПараметрыФормы, ЭтаФорма
			,,,,, РежимОткрытияОкнаФормы.Независимый);
	КонецЕсли;
		
	Возврат; 
КонецЕсли;

СчетНаОплатуОткрытьФорму(ТекущиеДанные.СчетГУИД, ТекущиеДанные.Контрагент, ТекущиеДанные.Клиент
	, ТекущиеДанные.ТолькоПроживание, ТекущиеДанные.ТолькоУслуги, ТекущиеДанные.РазделитьСчет
	, ТекущиеДанные.СвернутьВСчете, ТекущиеДанные.Закрыт, ТекущиеДанные.ДатаС, ТекущиеДанные.ДатаПо
	, ТекущиеДанные.НомерСчета, ТекущиеДанные.ДатаСчета, ТекущиеДанные.ГрупповойСчет
	, ТекущиеДанные.ЭтоПредварительныйГрупповойСчет);
КонецПроцедуры

&НаКлиенте
Процедура СчетНаОплатуОткрытьФорму(СчетГУИД, Контрагент, Клиент, ТолькоПроживание, ТолькоУслуги, РазделитьСчет
			, СвернутьВСчете, Закрыт,  ДатаС, ДатаПо, НомерСчета, ДатаСчета, ГрупповойСчет, ЭтоПредварительныйГрупповойСчет)
				
Если ЭтотОбъектЗаписатьНаКлиенте() Тогда Возврат; КонецЕсли;
				
ПараметрыФормы = Новый Структура();
ПараметрыФормы.Вставить("ТолькоПросмотр", Ложь);
Если ЭтаФорма.ТолькоПросмотр Тогда 
	ПараметрыФормы.ТолькоПросмотр = Истина;
КонецЕсли;
Если ЗначениеЗаполнено(ГрупповойСчет) Тогда 
	ПараметрыФормы.ТолькоПросмотр = Истина;
КонецЕсли;

ПараметрыФормы.Вставить("ДокументДолг", Объект);

// + Счет
Счет = ЗаявкаСервер.СчетСтруктура(СчетГУИД, Контрагент, Клиент, ТолькоПроживание, ТолькоУслуги, РазделитьСчет
	, СвернутьВСчете, Закрыт, ДатаС, ДатаПо, НомерСчета, ДатаСчета, ГрупповойСчет, ЭтоПредварительныйГрупповойСчет); 
			
ПараметрыФормы.Вставить("Счет", Счет);
// - Счет

ОткрытьФорму("ОбщаяФорма.СчетНаОплату", ПараметрыФормы, Элементы.Счета
	,,,, , РежимОткрытияОкнаФормы.БлокироватьВесьИнтерфейс);
КонецПроцедуры
// - СчетНаОплатуОткрытьФорму

// + Возврат из СчетНаОплатуОткрытьФорму 
&НаКлиенте
Процедура СчетаОбработкаВыбора(Элемент, ВыбранноеЗначение, СтандартнаяОбработка)
СчетВыбранноеЗначение = ВыбранноеЗначение.Счет;
НовыйСчет = ВыбранноеЗначение.НовыйСчет;
ДанныеСчетаВыбранноеЗначение = ВыбранноеЗначение.ДанныеСчета;  	

ОбновитьДанныеСчетаЗаявка_ЗавершениеСчетНаОплату(СчетВыбранноеЗначение, ДанныеСчетаВыбранноеЗначение);	
