Процедура ПоказатьПодтверждениеСообщение(Результат) Экспорт
ОшибкаОперации = Результат.ОшибкаОперации;
ОшибкаЭТ = Результат.ОшибкаЭТ;
ТекстПредупреждения = Результат.ТекстПредупреждения;
ТекстСообщения = Результат.ТекстСообщения;

Если ОшибкаОперации тогда 
	Если НЕ ОшибкаЭТ Тогда
		ТекстПредупреждения_ФС = Новый ФорматированнаяСтрока(ТекстПредупреждения + Символы.ПС + Символы.ПС
			, Новый Шрифт(, 11, Истина), WebЦвета.Коричневый);
		ДополнениеСтрока = Новый ФорматированнаяСтрока("После устранения ошибки" 
				+ Символы.ПС + "НЕ ЗАБУДЬТЕ ОФОРМИТЬ КАССОВЫЙ ЧЕК !!!"
			, Новый Шрифт(, 12, Истина), WebЦвета.Красный);
		ТекстПредупреждения_ФС = Новый ФорматированнаяСтрока(ТекстПредупреждения_ФС, ДополнениеСтрока);
		ПоказатьПредупреждение(, ТекстПредупреждения_ФС); 
		
		ТекстСообщения_П = ТекстСообщения + Символы.ПС + "ПОСЛЕ УСТРАНЕНИЯ ОШИБКИ НЕ ЗАБУДЬТЕ ОФОРМИТЬ КАССОВЫЙ ЧЕК !!!" 
	Иначе
		ПоказатьПредупреждение(, ТекстПредупреждения);
		ТекстСообщения_П = ТекстСообщения;
	КонецЕсли;
	
	Сообщить(ТекстСообщения_П);
Иначе
	ПоказатьПредупреждение(, ТекстПредупреждения);
КонецЕсли;
КонецПроцедуры
