&НаСервере
Процедура УстановитьОтборПараметры()
РезервПоОтбор_П = ?(ЗначениеЗаполнено(РезервПоОтбор), РезервПоОтбор, '30010101'); 

Список.Параметры.УстановитьЗначениеПараметра("КонтрагентОтбор", КонтрагентОтбор);
Список.Параметры.УстановитьЗначениеПараметра("РезервС", РезервСОтбор);
Список.Параметры.УстановитьЗначениеПараметра("РезервПо", РезервПоОтбор_П);

Список.Параметры.УстановитьЗначениеПараметра("Все", Все);
КонецПроцедуры

&НаКлиенте
Процедура УстановитьОтборНеоплачено()
ИмяПоля = "СуммаОплаты"; Значение_П = 0; РежимОтображения = РежимОтображенияЭлементаНастройкиКомпоновкиДанных.Недоступный; 
Если Неоплачено Тогда	
	ВидСравнения_П = ВидСравненияКомпоновкиДанных.Равно;
Иначе
	ВидСравнения_П = ВидСравненияКомпоновкиДанных.БольшеИлиРавно;
КонецЕсли;	
УстановитьПользовательскийОтборДинамическогоСписка(Список, ИмяПоля, Значение_П, ВидСравнения_П, РежимОтображения);
КонецПроцедуры

&НаКлиенте
Процедура УстановитьПользовательскийОтборДинамическогоСписка(Список, ИмяПоля, Значение, ВидСравнения, РежимОтображения)
Для Каждого ЭлементОтбора Из Список.КомпоновщикНастроек.ПользовательскиеНастройки.Элементы Цикл
	
	Если ТипЗнч(ЭлементОтбора) = Тип("ОтборКомпоновкиДанных") Тогда
		
		ПользовательскийОтбор = ЭлементОтбора.Элементы;
		
		НовыйЭлементОтбора = Неопределено;
		Для Каждого СуществующийЭлементОтбора Из ПользовательскийОтбор Цикл
			Если СуществующийЭлементОтбора.ЛевоеЗначение = Новый ПолеКомпоновкиДанных(ИмяПоля) Тогда
				НовыйЭлементОтбора = СуществующийЭлементОтбора;
				
				 Прервать;
			КонецЕсли;	
		КонецЦикла;
		
		Если СуществующийЭлементОтбора = Неопределено Тогда
			НовыйЭлементОтбора = ПользовательскийОтбор.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
			НовыйЭлементОтбора.ЛевоеЗначение = Новый ПолеКомпоновкиДанных(ИмяПоля);
		КонецЕсли;
	
		НовыйЭлементОтбора.ВидСравнения = ВидСравнения;
		НовыйЭлементОтбора.Использование = Истина;
		//НовыйЭлементОтбора.РежимОтображения = РежимОтображенияЭлементаНастройкиКомпоновкиДанных.Обычный;
		//НовыйЭлементОтбора.РежимОтображения = РежимОтображенияЭлементаНастройкиКомпоновкиДанных.БыстрыйДоступ;
		НовыйЭлементОтбора.РежимОтображения = РежимОтображенияЭлементаНастройкиКомпоновкиДанных.Недоступный;
		НовыйЭлементОтбора.РежимОтображения = РежимОтображения;
		НовыйЭлементОтбора.ПравоеЗначение = Значение;
	КонецЕсли;                                                  
КонецЦикла;
КонецПроцедуры

&НаСервере
Процедура УсловноеОформлениеЗагрузить()
УсловноеОформление.Элементы.Очистить();

ЭлементыТабНаФормеИмя = Элементы.Список.Имя;

ПутьКПолюОтбора = "Список.СуммаОплаты";
Вид_Сравнения = ВидСравненияКомпоновкиДанных.Больше;
ПравоеЗначение = 0;
Web_Цвета = WebЦвета.БледноЛиловый;

ОбщийФункционалСервер.УсловноеОформлениеДобавитьПоле(УсловноеОформление
	,ЭлементыТабНаФормеИмя, ПутьКПолюОтбора, Вид_Сравнения, ПравоеЗначение, Web_Цвета );
КонецПроцедуры
