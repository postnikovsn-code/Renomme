
&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
УсловноеОформлениеЗагрузить();

ОбщийФункционалСервер.КонтекстноеМенюВставитьКнопку(ЭтаФорма.Элементы, "УдалитьДокументСписания", "УдалитьДокументСписания", "ОформлениеКрест"
	, Элементы.ДокументыКСписаниюКонтекстноеМеню
	, ЭтаФорма.ПодчиненныеЭлементы.ДокументыКСписанию.КонтекстноеМеню.ПодчиненныеЭлементы, 1);                  
	
ДобавитьУслугиРодитель();
ОбновитьКолонкиУслуги(Объект);
КонецПроцедуры

&НаСервере
Процедура ДобавитьУслугиРодитель()
ИмяОбъекта = ИмяОбъекта();	
Документы[ИмяОбъекта].ЗаполнитьУслугиРодительСправочник(УслугиРодительСправочник);

// + Доп. реквизиты
ДобавляемыеРеквизиты	= Новый Массив;

Индекс = 1;
ОписаниеЧисло_10_2 = Новый ОписаниеТипов("Число", ,,Новый КвалификаторыЧисла(10, 2)); 
Для Каждого Строка Из УслугиРодительСправочник Цикл
	ДобавляемыеРеквизиты.Добавить(Новый РеквизитФормы("Услуга_" + Строка(Индекс), ОписаниеЧисло_10_2, "Объект.ДокументыКСписанию"));
	
	Индекс = Индекс + 1;
КонецЦикла;	

// Добавим новые реквизиты в форму
ЭтаФорма.ИзменитьРеквизиты(ДобавляемыеРеквизиты);

Номер = 1;
Для Каждого Строка Из УслугиРодительСправочник Цикл
	Имя = "Услуга_" + Строка(Номер); 
	НовыйЭлемент = Элементы.Добавить(Имя, Тип("ПолеФормы"), Элементы.ДокументыКСписанию);       
	НовыйЭлемент.Вид = ВидПоляФормы.ПолеВвода;
	НовыйЭлемент.ПутьКДанным = "Объект.ДокументыКСписанию." + Имя;
	//НовыйЭлемент.Ширина = 10;
	НовыйЭлемент.Заголовок = Строка.ЗаголовокОтчеты;
	НовыйЭлемент.ТолькоПросмотр = Истина;
	
	Номер = Номер + 1;
КонецЦикла;
// - Доп. реквизиты
КонецПроцедуры

