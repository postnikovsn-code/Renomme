	НоваяЗапись.РезервС = ЭтотОбъект.РезервС;
	НоваяЗапись.РезервПо = ЭтотОбъект.РезервПо;
	
	НоваяЗапись.ВидИнформации = Строка.ВидИнформации.Наименование;
	НоваяЗапись.Информация = Строка.Информация;
	
	Индекс = Индекс + 1;	
КонецЦикла;

