&НаКлиенте
Процедура ГруппаЭлемент_ПриИзменении(Элемент, ЭтоЗамена)
ТС = Элемент.Родитель.Родитель.Родитель.ТекущаяСтрока;		
ТД = ЗарплатаСмены.НайтиПоИдентификатору(ТС);
//ЗарплатаСмены
//1234567890123
ИмяЭлемента = Сред(Элемент.Имя, 14);
Индекс = СтрНайти(ИмяЭлемента, "_Э");
ИмяРеквизита = Сред(ИмяЭлемента, 1, Индекс - 1);  

Если ЭтоЗамена Тогда
	ТД[ИмяРеквизита + "_Р"] = ТД[ИмяРеквизита + "_Э"];
	ТД[ИмяРеквизита + "_Есть"] = Истина;
Иначе
	ТД[ИмяРеквизита + "_Р"] = ТД[ИмяРеквизита + "_Э"] - ТД[ИмяРеквизита];
КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ГруппаЭлемент_Очистка(Элемент, ЭтоЗамена)
ТС = Элемент.Родитель.Родитель.Родитель.ТекущаяСтрока;		
ТД = ЗарплатаСмены.НайтиПоИдентификатору(ТС);

ИмяРеквизита = Элемент.Имя;
ИмяРеквизита = Сред(ИмяРеквизита, 14);
ИмяРеквизита = Лев(ИмяРеквизита, СтрДлина(ИмяРеквизита) - 2);
	
Если ЭтоЗамена Тогда
	Имя = ИмяРеквизита + "_Р";
	ТД[Имя] = 0;
	Имя = ИмяРеквизита + "_Есть";
	ТД[Имя] = Ложь;
Иначе
	Имя = ИмяРеквизита + "_Р";
	ТД[Имя] = 0;
КонецЕсли;	
Имя = ИмяРеквизита + "_Э";
ТД[Имя] = ТД[ИмяРеквизита];

Элементы.ЗарплатаСмены.ЗакончитьРедактированиеСтроки(Ложь);
КонецПроцедуры

