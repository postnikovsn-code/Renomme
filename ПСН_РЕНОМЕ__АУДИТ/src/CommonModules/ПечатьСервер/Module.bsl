Функция ДокументТелоСтроки(ДокументДолгСсылка, Счет, ЭтоПечатьАктаНаПолнуюСумму = Ложь) Экспорт
	
ТЗ = Новый ТаблицаЗначений;
ТЗ.Колонки.Добавить("НомерСтроки");
ТЗ.Колонки.Добавить("Категория");
ТЗ.Колонки.Добавить("Клиент");
ТЗ.Колонки.Добавить("НаименованиеТовара");
//ТЗ.Колонки.Добавить("КодЕдиницыИзмерения");
ТЗ.Колонки.Добавить("ЕдиницаИзмерения");
ТЗ.Колонки.Добавить("Количество");
ТЗ.Колонки.Добавить("Цена");
ТЗ.Колонки.Добавить("НалоговаяСтавка");
ТЗ.Колонки.Добавить("СуммаНДС");
ТЗ.Колонки.Добавить("СуммаБезНДС");
ТЗ.Колонки.Добавить("СуммаСНДС");
ТЗ.Колонки.Добавить("ЭтоУслуга");
ТЗ.Колонки.Добавить("Дата");
ТЗ.Колонки.Добавить("ДатаС");	
ТЗ.Колонки.Добавить("ДатаПо");	

ТоварКлиент = "" + ТоварКлиент(ДокументДолгСсылка, Счет); // + ". ";
	
//НомерВРезерв = ДокументДолгСсылка.НомерВРезерв;	

ДатаУчетаНДС = ДокументДолгСсылка.РезервПо;
ТекущаяОрганизация = НастройкиСервер.ПолучитьТекущуюОрганизацию();
СтавкаНДС = ТекущаяОрганизация.СтавкаНДС; СтавкаНДС = ДокументыСервер.СтавкаНДСТекущая(СтавкаНДС, ДатаУчетаНДС);
ВсеСНДС = ТекущаяОрганизация.ВсеСНДС; 

ЭтоФизЛицо = Счет.Контрагент.ТипКлиента <> Перечисления.ТипыКлиентов.ЮрЛицо;	
СвернутьВСчете = Счет.СвернутьВСчете;

ОтборСтроки = Новый Структура("СчетГУИД", Счет.СчетГУИД);
СчетаДетальноДолги = ДокументДолгСсылка.СчетаДетальноДолги.Выгрузить(ОтборСтроки);

Если ЭтоПечатьАктаНаПолнуюСумму Тогда
	Проживание = ДокументДолгСсылка.Проживание;
	Для Каждого Строка Из СчетаДетальноДолги Цикл
		Если Строка.Услуга Тогда Продолжить; КонецЕсли;
		
		ОтборСтроки = Новый Структура("ГУИД", Строка.ДолгиГУИД);
		ПроживаниеСтроки = Проживание.НайтиСтроки(ОтборСтроки);
		Если ПроживаниеСтроки.Количество() = 0 Тогда Продолжить; КонецЕсли;
		
		Строка.СуммаДолг = ПроживаниеСтроки[0].СуммаБезСкидки;
	КонецЦикла;
КонецЕсли;	

ИтогиЗаявка = ИтогиЗаявка(СчетаДетальноДолги, СтавкаНДС, ВсеСНДС);
ВсегоСуммаПроживание = ИтогиЗаявка.СуммаПроживание;
ВсегоКоличествоПроживание = ИтогиЗаявка.КоличествоПроживание;
ВсегоСуммаУслуги = ИтогиЗаявка.СуммаУслуги;
ВсегоСуммаНДС = ИтогиЗаявка.СуммаНДС;

СчетчикСтрок = 0;
Если СвернутьВСчете Тогда
	Сумма = ВсегоСуммаПроживание + ВсегоСуммаУслуги; 
	
	НоваяСтрока = ТЗ.Добавить();
	
	Если Сумма <> 0 Тогда
		СчетчикСтрок = СчетчикСтрок + 1;
		НоваяСтрока.НомерСтроки = СчетчикСтрок;
		
		//НаименованиеДляСчета = "Услуги гостиницы";
		НаименованиеДляСчета = "Услуги по предоставлению мест для временного проживания в гостинице";
		Если ЭтоФизЛицо Тогда
			Товар = НаименованиеДляСчета;
		Иначе
			Товар = ТоварКлиент + ". " + НаименованиеДляСчета;
		КонецЕсли;
		
		Если ЗначениеЗаполнено(ИтогиЗаявка.ДатаС_Проживание) Тогда
			НоваяСтрока.ДатаС = ИтогиЗаявка.ДатаС_Проживание; 
			НоваяСтрока.ДатаПо = ИтогиЗаявка.ДатаПо_Проживание;
			
			ДатаПо = НоваяСтрока.ДатаПо + 24 * 60 * 60;
			ДатыСПо = " с " + Формат(НоваяСтрока.ДатаС,"ДФ=dd.MM.yy") 
				+ " по " + Формат(ДатаПо,"ДФ=dd.MM.yy") ;
		Иначе
			НоваяСтрока.ДатаС = ИтогиЗаявка.ДатаС_Услуги;
			НоваяСтрока.ДатаПо = ИтогиЗаявка.ДатаПо_Услуги;
			
			Если НоваяСтрока.ДатаС = НоваяСтрока.ДатаПо Тогда
				ДатыСПо = Формат(НоваяСтрока.ДатаС,"ДФ=dd.MM.yy"); 
			Иначе
				ДатаПо = НоваяСтрока.ДатаПо;
				ДатыСПо = " с " + Формат(НоваяСтрока.ДатаС,"ДФ=dd.MM.yy") 
					+ " по " + Формат(ДатаПо,"ДФ=dd.MM.yy") ;
			КонецЕсли;		
		КонецЕсли;
		НоваяСтрока.НаименованиеТовара = Товар + " " + ДатыСПо;
		
		НоваяСтрока.Клиент = ТоварКлиент;
		
		НоваяСтрока.Категория = ДокументДолгСсылка.КатегорияНомера.Наименование;
		
		//НаименованиеДляСчета = "Услуги гостиницы";
		//Если ЭтоФизЛицо Тогда
		//	Товар = НаименованиеДляСчета;
		//Иначе
		//	Товар = ТоварКлиент + НаименованиеДляСчета;
		//КонецЕсли;
		
		//Если НоваяСтрока.ДатаС = НоваяСтрока.ДатаПо Тогда
		//	ДатыСПо = Формат(НоваяСтрока.ДатаС,"ДФ=dd.MM.yy"); 
		//Иначе
		//	ДатаПо = НоваяСтрока.ДатаПо + 24 * 60 * 60;
		//	ДатыСПо = " с " + Формат(НоваяСтрока.ДатаС,"ДФ=dd.MM.yy") 
		//		+ " по " + Формат(ДатаПо,"ДФ=dd.MM.yy") ;
		//КонецЕсли;		
		//НоваяСтрока.НаименованиеТовара = Товар + " " + ДатыСПо;

		Если ВсегоКоличествоПроживание = 0 Тогда
			 ВсегоКоличествоПроживание = 1;
		КонецЕсли;
		НоваяСтрока.Количество = ВсегоКоличествоПроживание;
		
		НоваяСтрока.ЕдиницаИзмерения = "сутки";
			
		НоваяСтрока.Цена = Окр(Сумма / ВсегоКоличествоПроживание, 2);
		НоваяСтрока.СуммаСНДС = Сумма;
		
		НоваяСтрока.ЭтоУслуга = Ложь;
	КонецЕсли;	
Иначе	
	Для Каждого Строка Из СчетаДетальноДолги Цикл
		
		НоваяСтрока = ТЗ.Добавить();
		
		СчетчикСтрок = СчетчикСтрок + 1;
		НоваяСтрока.НомерСтроки = СчетчикСтрок;
		
		НоваяСтрока.Клиент = ТоварКлиент;
		
		НаименованиеДляСчета = НаименованиеДляДокумента(Строка);

		Если ЭтоФизЛицо Тогда
			Товар = НаименованиеДляСчета;
		Иначе
			Товар = ТоварКлиент + ". " + НаименованиеДляСчета;
		КонецЕсли;
		НоваяСтрока.НаименованиеТовара = Товар;

		НоваяСтрока.ДатаС = Строка.ДатаДолг;
		НоваяСтрока.ДатаПо = Строка.ДатаДолг;		
		
		Если Строка.Количество = 0 Тогда
			 Количество = 1;
		Иначе	 
			 Количество = Строка.Количество;
		КонецЕсли;
		НоваяСтрока.Количество = Количество;
		
		Если Строка.Услуга Тогда
			НоваяСтрока.ЭтоУслуга = Истина;
			НоваяСтрока.ЕдиницаИзмерения = "шт";
		Иначе			
			НоваяСтрока.ЭтоУслуга = Ложь;
			НоваяСтрока.ЕдиницаИзмерения = "сутки";
			НоваяСтрока.Категория = ДокументДолгСсылка.КатегорияНомера.Наименование;
		КонецЕсли;
			
		Сумма = Строка.СуммаДолг;
		НоваяСтрока.СуммаСНДС = Сумма;
		
		Цена = Окр(Сумма / Количество, 2);
		НоваяСтрока.Цена = Цена;
		
	КонецЦикла;		
КонецЕсли;	

Возврат Новый Структура("ТЗСтроки, СчетаДетальноДолги", ТЗ, СчетаДетальноДолги);
КонецФункции

Процедура ПечатьДокументаТело(ТабДок, Макет, СчетчикСтрок, СуммаДляПечатиОбщая, ДокументДолгСсылка, Счет, УчитыватьНДС
	, ПечататьВсегоКОплате, ЭтоПечатьАктаНаПолнуюСумму = Ложь)

ТекущаяОрганизация = НастройкиСервер.ПолучитьТекущуюОрганизацию();    

СтавкаНДС = ТекущаяОрганизация.СтавкаНДС; 

ДатаУчетаНДС = ДокументДолгСсылка.РезервПо;
СтавкаНДС = ДокументыСервер.СтавкаНДСТекущая(СтавкаНДС, ДатаУчетаНДС);

ВсеСНДС = ТекущаяОрганизация.ВсеСНДС; 

ЭтоФизЛицо = Счет.Контрагент.ТипКлиента <> Перечисления.ТипыКлиентов.ЮрЛицо;	
СвернутьВСчете = Счет.СвернутьВСчете;

ЭтоШтрафЗаНезаезд = ЭтоШтрафЗаНезаезд(ДокументДолгСсылка, Счет);

Ответ = ДокументТелоСтроки(ДокументДолгСсылка, Счет, ЭтоПечатьАктаНаПолнуюСумму);
ТЗСтроки = Ответ.ТЗСтроки;
СчетаДетальноДолги = Ответ.СчетаДетальноДолги; 

ИтогиЗаявка = ИтогиЗаявка(СчетаДетальноДолги, СтавкаНДС, ВсеСНДС);
ВсегоСуммаПроживание = ИтогиЗаявка.СуммаПроживание;
ВсегоКоличествоПроживание = ИтогиЗаявка.КоличествоПроживание;
ВсегоСуммаУслуги = ИтогиЗаявка.СуммаУслуги;
ВсегоСуммаНДС = ИтогиЗаявка.СуммаНДС;

Область = Макет.ПолучитьОбласть("ШапкаТаблицы");
ОбластьПовтора = ТабДок.Вывести(Область);
ТабДок.ПовторятьПриПечатиСтроки = ОбластьПовтора;

СчетчикСтрок = 0;
Для Каждого Строка Из ТЗСтроки Цикл
	СтрокаТабл = Макет.ПолучитьОбласть("Строка");
	СтрокаТаблПараметры = СтрокаТабл.Параметры;
	
	СтрокаТаблПараметры.НомерСтроки = Строка.НомерСтроки;
			
	СтрокаТаблПараметры.Товар = Строка.НаименованиеТовара;
	
	СтрокаТаблПараметры.ЕдиницаИзмерения = Строка.ЕдиницаИзмерения;
	
	СтрокаТаблПараметры.Количество = Строка.Количество;
	СтрокаТаблПараметры.Цена = Строка.Цена;
	
	СтрокаТаблПараметры.Сумма = Строка.СуммаСНДС;
	
	ТабДок.Вывести(СтрокаТабл);
	
	СчетчикСтрок = СчетчикСтрок + 1;
КонецЦикла;

ВсегоИтого = ВсегоСуммаПроживание + ВсегоСуммаУслуги;

//
ИтогоСтр=Макет.ПолучитьОбласть("Итоги");
ИтогоСтр.Параметры.Всего = ВсегоИтого;
ТабДок.Вывести(ИтогоСтр);

Если ЭтоШтрафЗаНезаезд Тогда
	СтавкаНДС = Перечисления.СтавкиНДС.БезНДС;
КонецЕсли;

ПечатьИтогиНДС(ТабДок, Макет, УчитыватьНДС, ВсеСНДС, СтавкаНДС, ВсегоСуммаНДС, СвернутьВСчете
	, ИтогиЗаявка.ЕстьНДС0, ИтогиЗаявка.ЕстьНДСНе0);

Если ПечататьВсегоКОплате Тогда
	ИтогоСтр=Макет.ПолучитьОбласть("ВсегоКОплате");
	ИтогоСтр.Параметры.ВсегоКОплате = ВсегоИтого;
	ТабДок.Вывести(ИтогоСтр);
КонецЕсли;

ИтогоСтр=Макет.ПолучитьОбласть("СуммаПрописью");  
ИтогоСтр.Параметры.ИтоговаяСтрока="Всего "+Строка(СчетчикСтрок) + " наименований на сумму:";
ИтогоСтр.Параметры.СуммаПрописью=ЧислоПрописью(ВсегоИтого,,"рубль, рубля, рублей, м, копейка, копейки, копеек, ж, 2");

ТабДок.Вывести(ИтогоСтр);	

СуммаДляПечатиОбщая = ВсегоИтого;
КонецПроцедуры

Функция ЭтоШтрафЗаНезаезд(ДокументДолгСсылка, Счет) Экспорт
ЭтоШтрафЗаНезаезд_1 = Счет.ТолькоУслуги И (ДокументДолгСсылка.Статус = Перечисления.СтатусБрони.Неустойка);

ОтборСтроки = Новый Структура("СчетГУИД, Услуга", Счет.СчетГУИД, Истина);
СчетаДетальноДолги = ДокументДолгСсылка.СчетаДетальноДолги.НайтиСтроки(ОтборСтроки);

ЭтоШтрафЗаНезаезд_2 = Ложь;
Для Каждого Строка Из СчетаДетальноДолги Цикл
	ОтборСтроки = Новый Структура("ГУИД", Строка.ДолгиГУИД);
	ДопУслуги = ДокументДолгСсылка.ДопУслуги.НайтиСтроки(ОтборСтроки);
	Если ДопУслуги.Количество() = 0 Тогда Продолжить; КонецЕсли;
	
	Если ДопУслуги[0].Услуга.ПрограммныйКод = Перечисления.ПрограммныйКодУслуги.ШТРАФ Тогда
		ЭтоШтрафЗаНезаезд_2 = Истина;
		Прервать;
	КонецЕсли;	
КонецЦикла;

ЭтоШтрафЗаНезаезд = ЭтоШтрафЗаНезаезд_1 ИЛИ ЭтоШтрафЗаНезаезд_2;

Возврат ЭтоШтрафЗаНезаезд;	
КонецФункции

Процедура ПечатьИтогиНДС(ТабДок, Макет, УчитыватьНДС, ВсеСНДС, СтавкаНДС, ВсегоСуммаНДС, СвернутьВСчете, ЕстьНДС0, ЕстьНДСНе0)
Если НЕ УчитыватьНДС Тогда
	ВсегоНДС = ВсегоНДС(Перечисления.СтавкиНДС.БезНДС, 0, Ложь, Ложь); 
ИначеЕсли СтавкаНДС = Перечисления.СтавкиНДС.БезНДС Тогда
	ВсегоНДС = ВсегоНДС(Перечисления.СтавкиНДС.БезНДС, 0, Ложь, Ложь); 
Иначе		
	Если СвернутьВСчете Тогда
		ВсегоНДС = ВсегоНДС(Перечисления.СтавкиНДС.НДС0, 0, Истина, Ложь);
	Иначе	
		Если ВсеСНДС Тогда 
			ВсегоНДС = ВсегоНДС(СтавкаНДС, ВсегоСуммаНДС, Ложь, Истина);
		Иначе	
			ВсегоНДС = ВсегоНДС(СтавкаНДС, ВсегоСуммаНДС, ЕстьНДС0, ЕстьНДСНе0);
		КонецЕсли;
	КонецЕсли;
КонецЕсли;

ВсегоНДСТекст = ВсегоНДС.ВсегоНДСТекст;
ВсегоНДССумма = ВсегоНДС.ВсегоНДССумма;

ИтогоСтр=Макет.ПолучитьОбласть("ИтогоНДС");
ИтогоСтр.Параметры.ВсегоНДСТекст =ВсегоНДСТекст;
ИтогоСтр.Параметры.ВсегоНДССумма =ВсегоНДССумма;
ТабДок.Вывести(ИтогоСтр);

КонецПроцедуры

Функция ВсегоНДС(СтавкаНДС, ВсегоСуммаНДС, ЕстьНДС0, ЕстьНДСНе0)

Если СтавкаНДС = Перечисления.СтавкиНДС.БезНДС 
ИЛИ СтавкаНДС = Перечисления.СтавкиНДС.ПустаяСсылка()
Тогда
	ВсегоНДСТекст = "Без налога (НДС):";		
ИначеЕсли ЕстьНДС0 И ЕстьНДСНе0 Тогда
	ВсегоНДСТекст = "В том числе НДС:";		
ИначеЕсли ЕстьНДС0 Тогда
	ВсегоНДСТекст = "НДС 0%:";		
ИначеЕсли ЕстьНДСНе0 Тогда
	Если СтавкаНДС = Перечисления.СтавкиНДС.НДС22 Тогда
		ВсегоНДСТекст = "В том числе НДС 22%:";	
	ИначеЕсли СтавкаНДС = Перечисления.СтавкиНДС.НДС20 Тогда
		ВсегоНДСТекст = "В том числе НДС 20%:";	
	ИначеЕсли СтавкаНДС = Перечисления.СтавкиНДС.НДС5 Тогда
		ВсегоНДСТекст = "В том числе НДС 5%:";		
	КонецЕсли;	
Иначе	
	ВсегоНДСТекст = "В том числе НДС:";		
КонецЕсли; 

Если ВсегоСуммаНДС = 0 ТОгда
	ВсегоНДССумма = "-";
Иначе
	ВсегоНДССумма = ВсегоСуммаНДС;
КонецЕсли;	
Возврат Новый Структура("ВсегоНДСТекст, ВсегоНДССумма", ВсегоНДСТекст, ВсегоНДССумма);
КонецФункции

