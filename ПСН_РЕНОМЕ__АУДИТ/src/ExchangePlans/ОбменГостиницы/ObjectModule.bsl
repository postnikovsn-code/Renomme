//	, ДанныеУзлаОбмена.АдресФТП, ДанныеУзлаОбмена.ИмяПользователя, ДанныеУзлаОбмена.Пароль); 
//Если Результат.ЕстьОшибки Тогда
//	Сообщить("Ошибка удаления файла FTP: " + Результат.ОписаниеОшибки);
//КонецЕсли;

Сообщение = Новый СообщениеПользователю;
Сообщение.Текст = "-------- Конец загрузки ------------";
