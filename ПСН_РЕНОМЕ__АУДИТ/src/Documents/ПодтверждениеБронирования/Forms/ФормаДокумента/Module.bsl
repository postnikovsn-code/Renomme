Функция ЗаполнитьРеквизитыНовоеПодтверждение()
	ОбщСт=0;
	сч=1;
	СтруктураРеквизитов=Новый Структура;
	
	Для каждого СтрНом Из НовНомера Цикл
		
		//СтруктураРеквизитов.Вставить("ФИО"+Строка(Сч),СтрНом.Бронь.Клиент.Наименование+"("+СтрНом.Бронь.НомерВРезерв.КатегорияНомера.Наименование+")");
		СтруктураРеквизитов.Вставить("ФИО"+Строка(Сч),СтрНом.Бронь.Клиент.Наименование
			+"("+СтрНом.Бронь.КатегорияНомера.Наименование+")");
		СтруктураРеквизитов.Вставить("ДТ"+Строка(Сч),СтрНом.РезервС);
		СтруктураРеквизитов.Вставить("К"+Строка(Сч),Строка(СтрНом.КолВо));
		СтруктураРеквизитов.Вставить("ДТВ"+Строка(Сч),СтрНом.РезервПо);
		СтруктураРеквизитов.Вставить("СТ"+Строка(Сч),Строка(СтрНом.СТ));
		СтруктураРеквизитов.Вставить("СТО"+Строка(Сч),Строка(СтрНом.СТ*СтрНом.КолВо));
		ОбщСт=ОбщСт+СтрНом.СТ*СтрНом.КолВо;	
		сч=сч+1;
		Если Сч>25 тогда
			Прервать;
		КонецЕсли;
		
	КонецЦикла; 
	Пока Сч<=25 цикл
		СтруктураРеквизитов.Вставить("ФИО"+Строка(Сч),"");
		СтруктураРеквизитов.Вставить("ДТ"+Строка(Сч),"");
		СтруктураРеквизитов.Вставить("К"+Строка(Сч),"");
		СтруктураРеквизитов.Вставить("ДТВ"+Строка(Сч),"");
		СтруктураРеквизитов.Вставить("СТ"+Строка(Сч),"");
		СтруктураРеквизитов.Вставить("СТО"+Строка(Сч),"");
		сч=сч+1;
	КонецЦикла;
	
	СтруктураРеквизитов.Вставить("СТОИ",ОбщСт);
	
	//СтруктураРеквизитов.Вставить("ИмяПользователя",ТекПол.наименование);
	ТекПолНаименование = ПараметрыСеанса["ТекущийПользователь"].Наименование;
	СтруктураРеквизитов.Вставить("ИмяПользователя", ТекПолНаименование);
	
	Возврат СтруктураРеквизитов;
КонецФункции
