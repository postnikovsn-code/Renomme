Функция  БлокироватьОбъект(ОбъектДляБлокировки) Экспорт
Ответ = Новый Структура("Ошибка, ТекстОшибки", Ложь, "");	
	
Попытка 
	ОбъектДляБлокировки.Заблокировать();
	Возврат Ответ;
Исключение
	Ответ.Ошибка = Истина;
	
	ОписаниеОшибки = ОписаниеОшибки();
	Индекс = СтрНайти(ОписаниеОшибки, "Объект уже заблокирован");  
	//12345678901234567890123
	//Объект уже заблокирован
	Если Индекс = 0 Тогда 
		Ответ.ТекстОшибки = ОписаниеОшибки;
		Возврат Ответ;
	КонецЕсли;
	
	ТекстОшибки = Сред(ОписаниеОшибки, Индекс + 25);
	//, приложение
	Индекс = СтрНайти(ТекстОшибки, ", приложение"); 
	Если Индекс = 0 Тогда 
		Ответ.ТекстОшибки = ТекстОшибки;
		Возврат Ответ;
	КонецЕсли;
	
	Ответ.ТекстОшибки = Лев(ТекстОшибки, Индекс -1);		
	Возврат Ответ;		
КонецПопытки;	
		
КонецФункции

Функция ПроверкаБлокировкиСообщение(МассивОбъектов, ТекстОшибки) Экспорт
МассивОшибок = ЗаявкаСервер.БлокироватьЗаявки(МассивОбъектов);	
Если МассивОшибок.Количество() = 0  Тогда Возврат Ложь; КонецЕсли;

Сообщить(ТекстОшибки + " Есть открытые (заблокированные) Заявки. ЗАКРОЙТЕ ОТКРЫТЫЕ ЗАЯВКИ И ПОВТОРИТЕ ОПЕРАЦИЮ ...");
Для Каждого Элемент Из МассивОшибок Цикл
	Сообщить(Элемент);					 
КонецЦикла;		

Возврат Истина;
КонецФункции	
