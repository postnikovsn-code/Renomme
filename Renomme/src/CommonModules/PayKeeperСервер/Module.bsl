Функция Счет(ОбъектДанные, СчетГУИД) 
Если ТипЗнч(ОбъектДанные.Ссылка) = Тип("ДокументСсылка.ЗаявкаНаБронирование") Тогда
	ОтборСтроки = Новый Структура("СчетГУИД", СчетГУИД);
	НайденныеСтроки = ОбъектДанные.Счета.НайтиСтроки(ОтборСтроки);
	Если НайденныеСтроки.Количество() = 0 Тогда 
		Счет =  Неопределено;
	Иначе
		Счет = НайденныеСтроки[0];
	КонецЕсли;
Иначе
	Счет =  Неопределено;
КонецЕсли;

Возврат Счет;
КонецФункции

Функция Контрагент(ОбъектДанные, Счет) Экспорт
Если ТипЗнч(ОбъектДанные.Ссылка) = Тип("ДокументСсылка.КоворкингСчета") Тогда
	Если ЗначениеЗаполнено(ОбъектДанные.ОплачиваетСчет) Тогда
		Контрагент = ОбъектДанные.ОплачиваетСчет;
	Иначе		
		Контрагент = ОбъектДанные.КоворкингЗаявка.Клиент;
	КонецЕсли;
ИначеЕсли ТипЗнч(ОбъектДанные.Ссылка) = Тип("ДокументСсылка.ГрупповыеСчета") Тогда
	Контрагент = ОбъектДанные.Контрагент;
ИначеЕсли ТипЗнч(ОбъектДанные.Ссылка) = Тип("ДокументСсылка.ЗаявкаНаБронирование") Тогда
	Если Счет =  Неопределено Тогда
		Контрагент =  Неопределено;
	Иначе
		Контрагент = Счет.Контрагент;
	КонецЕсли;
Иначе
	Контрагент =  Неопределено;
КонецЕсли;

Возврат Контрагент;
КонецФункции

Функция СуммыКОплатеКоворкинг(ОбъектДанные) 
СуммаКЗакрытиюДопУслуги = СуммаКЗакрытиюДопУслугиКоворкинг(ОбъектДанные);
СуммаКЗакрытиюКоворкинг = ОбъектДанные.Сумма - ОбъектДанные.СуммаОплачено;
СуммаКЗакрытию = СуммаКЗакрытиюКоворкинг + СуммаКЗакрытиюДопУслуги;

СтрокаДанные = Новый Структура("СуммаКЗакрытиюКоворкинг, СуммаКЗакрытиюДопУслуги, СуммаКЗакрытию"
	, СуммаКЗакрытиюКоворкинг, СуммаКЗакрытиюДопУслуги, СуммаКЗакрытию);
	
Возврат СтрокаДанные;
КонецФункции

Функция СуммаКЗакрытиюДопУслугиКоворкинг(ОбъектДанные)
СуммаКЗакрытиюДопУслуги = 0;	

Для Каждого Строка Из ОбъектДанные.ДопУслугиКоворкинг Цикл
	СуммаКЗакрытиюДопУслуги = СуммаКЗакрытиюДопУслуги + Строка.Сумма - Строка.СуммаОплачено;		
КонецЦикла;		
	
Возврат СуммаКЗакрытиюДопУслуги;	
КонецФункции

Функция СуммыКОплатеГрупповойСчетНДС(ДокументДолгОбъектДанные) Экспорт
Запрос = Новый Запрос("ВЫБРАТЬ
                      |	ЗаявкиДолги.ЕстьНДС КАК ЕстьНДС,
                      |	ЕСТЬNULL(СУММА(ЗаявкиДолги.СуммаКЗакрытию), 0) КАК СуммаКЗакрытию
                      |ИЗ
                      |	Документ.ГрупповыеСчета.ДокументыДолги КАК ГрупповыеСчетаДокументыДолги
                      |		ЛЕВОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
                      |			ЗаявкаНаБронированиеСчетаДетальноДолги.Ссылка КАК Ссылка,
                      |			ЗаявкаНаБронированиеСчетаДетальноДолги.СчетГУИД КАК СчетГУИД,
                      |			ЗаявкаНаБронированиеСчетаДетальноДолги.ЕстьНДС КАК ЕстьНДС,
                      |			СУММА(ЗаявкаНаБронированиеСчетаДетальноДолги.СуммаКЗакрытию) КАК СуммаКЗакрытию
                      |		ИЗ
                      |			Документ.ЗаявкаНаБронирование.СчетаДетальноДолги КАК ЗаявкаНаБронированиеСчетаДетальноДолги
                      |		
                      |		СГРУППИРОВАТЬ ПО
                      |			ЗаявкаНаБронированиеСчетаДетальноДолги.Ссылка,
                      |			ЗаявкаНаБронированиеСчетаДетальноДолги.СчетГУИД,
                      |			ЗаявкаНаБронированиеСчетаДетальноДолги.ЕстьНДС) КАК ЗаявкиДолги
                      |		ПО ГрупповыеСчетаДокументыДолги.ДокументДолг = ЗаявкиДолги.Ссылка
                      |			И ГрупповыеСчетаДокументыДолги.СчетГУИД = ЗаявкиДолги.СчетГУИД
                      |ГДЕ
                      |	ГрупповыеСчетаДокументыДолги.Ссылка = &ДокументДолг
                      |
                      |СГРУППИРОВАТЬ ПО
                      |	ЗаявкиДолги.ЕстьНДС");

Запрос.УстановитьПараметр("ДокументДолг", ДокументДолгОбъектДанные.Ссылка); 

ТЗ = Запрос.Выполнить().Выгрузить();

Возврат ТЗ;
КонецФункции


Функция НомерСчета(ОбъектДанные, Счет) Экспорт
НомерСчета = 0;
Если ТипЗнч(ОбъектДанные.Ссылка) = Тип("ДокументСсылка.КоворкингСчета") Тогда
	
	НомерСчета_П = ОбщийФункционалКлиентСервер.УбратьНезначащиеНули(ОбъектДанные.Номер);
	НомерСчетаПочта = НомерСчета_П;
	
	Ответ = PayKeeperКлиентСервер.ИмяКоворкингСчетPayKeeper();
	ИмяЗаявкаСчетPayKeeper = Ответ.Имя;
	НомерСчетаPayKeeper = ИмяЗаявкаСчетPayKeeper + НомерСчета_П;
	
ИначеЕсли ТипЗнч(ОбъектДанные.Ссылка) = Тип("ДокументСсылка.ГрупповыеСчета") Тогда
	
	НомерСчета_П = ОбщийФункционалКлиентСервер.УбратьНезначащиеНули(ОбъектДанные.Номер);
	НомерСчетаПочта = НомерСчета_П;
	
	Ответ = PayKeeperКлиентСервер.ИмяГрупповойСчетPayKeeper();
	ИмяЗаявкаСчетPayKeeper = Ответ.Имя;
	НомерСчетаPayKeeper = ИмяЗаявкаСчетPayKeeper + НомерСчета_П;
	
ИначеЕсли ТипЗнч(ОбъектДанные.Ссылка) = Тип("ДокументСсылка.ЗаявкаНаБронирование") Тогда
	НомерСчета = Счет.НомерСчета;

	НомерСчета_П = ПечатьСервер.НомерСчетаДляПечати(ОбъектДанные.Номер, НомерСчета);
	НомерСчетаПочта = НомерСчета_П;
	
	Ответ = PayKeeperКлиентСервер.ИмяЗаявкаСчетPayKeeper();
	ИмяЗаявкаСчетPayKeeper = Ответ.Имя;
	НомерСчетаPayKeeper = ИмяЗаявкаСчетPayKeeper + НомерСчета_П; 
Иначе
	
	Сообщить("ПРОГРАММНАЯ ОШИБКА. Неверный тип документа к оплате: " + ТипЗнч(ОбъектДанные.Ссылка)); 
	
	Возврат Неопределено;	
КонецЕсли;

Результат = Новый Структура("НомерСчета, НомерСчетаПочта, НомерСчетаPayKeeper"
	, НомерСчета, НомерСчетаПочта, НомерСчетаPayKeeper);
Возврат Результат;
КонецФункции
