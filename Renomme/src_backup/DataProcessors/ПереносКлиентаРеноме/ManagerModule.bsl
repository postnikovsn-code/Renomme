//
Процедура ЗагрузитьИсториюКлиентовНаСервере(ПутьКФайловойБазе, ИмяПользователя, Пароль, РезервС, РезервПо) Экспорт
Перем ЗначениеХодаВыполнения, Сч, Объект, СтруктураВозврата; 
ЗначениеХодаВыполнения = Новый Структура("ПроцентВыполнения, КоличествоСозданныхЭлементов", 0, 0);

Соединение = ПолучитьПодключениеКФайловойБД(ПутьКФайловойБазе, ИмяПользователя, Пароль);

Запрос = Соединение.NewObject("Запрос");
Запрос.Текст = "ВЫБРАТЬ
|	ЗаявкаНаБронирование.Ссылка КАК Ссылка,
|	ЗаявкаНаБронирование.Клиент КАК Клиент,
|	ЗаявкаНаБронирование.Дата КАК Дата,
|	ЗаявкаНаБронирование.РезервС КАК РезервС,
|	ЗаявкаНаБронирование.РезервПо КАК РезервПо,
|	ЗаявкаНаБронирование.НомерВРезерв.Наименование КАК НомерВРезервНаименование,
|	ЗаявкаНаБронирование.Статус КАК Статус,
|	ЗаявкаНаБронирование.ДопПожелания.(
|		Ссылка КАК Ссылка,
|		НомерСтроки КАК НомерСтроки,
|		Информация КАК Информация,
|		ВидИнформации КАК ВидИнформации
|	) КАК ДопПожелания
|ИЗ
|	Документ.ЗаявкаНаБронирование КАК ЗаявкаНаБронирование
|ГДЕ
|	ЗаявкаНаБронирование.ПометкаУдаления = ЛОЖЬ
|	И ЗаявкаНаБронирование.РезервПо < &РезервПо
|	И ЗаявкаНаБронирование.РезервС > &РезервС
|	И ЗаявкаНаБронирование.РезервПо <> ДАТАВРЕМЯ(1, 1, 1, 0, 0, 0)";	

//|	И ЗаявкаНаБронирование.Клиент.Наименование = ""Ardeleanu Serban""
	
Запрос.УстановитьПараметр("РезервПо", РезервПо); 
Запрос.УстановитьПараметр("РезервС", РезервС); 

ТЗ = Запрос.Выполнить().Выгрузить();
ш = 0; 
КоличествоЭлементов = ТЗ.Количество(); 
Для Каждого Строка Из ТЗ Цикл
	ш = ш + 1;
	ЗначениеХодаВыполнения.КоличествоСозданныхЭлементов = ЗначениеХодаВыполнения.КоличествоСозданныхЭлементов + 1;
	ЗначениеХодаВыполнения.ПроцентВыполнения = Окр(ЗначениеХодаВыполнения.КоличествоСозданныхЭлементов / КоличествоЭлементов * 100);		
	АсинхронныеВызовы.ОбновитьЗначениеХодаВыполнения(ЗначениеХодаВыполнения);
	Если ш%100 = 0 Тогда
		АсинхронныеВызовы.ДобавитьСообщениеХодаВыполнения("Выполнили " + ЗначениеХодаВыполнения.ПроцентВыполнения + "%");
	КонецЕсли;
	
	ДобавитьИсториюКлиента(Строка, Соединение);	
КонецЦикла;
КонецПроцедуры

Процедура ДобавитьИсториюКлиента(Строка, Соединение)  
КлиентЗагрузкаГИУДСтрока = Соединение.XMLСтрока(Строка.Клиент.Ссылка);
Клиент = Справочники.Клиенты.НайтиПоРеквизиту("ЗагрузкаГИУДСтрока", КлиентЗагрузкаГИУДСтрока);

Если НЕ ЗначениеЗаполнено(Клиент) Тогда Возврат; КонецЕсли;
	
ИсторияКлиента = РегистрыСведений.ИсторияКлиента.СоздатьНаборЗаписей();

ЗаявкаГУИДСтрока = Соединение.XMLСтрока(Строка.Ссылка);
ЗаявкаГУИД = Новый УникальныйИдентификатор(ЗаявкаГУИДСтрока);

//ИсторияКлиента.Отбор.Клиент.Установить(Клиент);
//ИсторияКлиента.Отбор.ЗаявкаГУИД.Установить(ЗаявкаГУИД);

ИсторияКлиента.Отбор.ЗаявкаГУИД.Установить(ЗаявкаГУИД);
Для Каждого Строка Из ИсторияКлиента Цикл
	ИсторияКлиента.Удалить(Строка);
КонецЦикла;
	
НоваяЗапись = ИсторияКлиента.Добавить();

НоваяЗапись.Клиент = Клиент;
НоваяЗапись.ЗаявкаГУИД = ЗаявкаГУИД;

НоваяЗапись.ДатаЗаявки = Строка.Дата;
НоваяЗапись.РезервС = Строка.РезервС;
НоваяЗапись.РезервПо = Строка.РезервПо;
НоваяЗапись.НомерВРезерв = Строка.НомерВРезервНаименование;

ИмяЗначениеПеречисления = ИмяЗначенияПеречисление(Соединение, Строка.Статус);
Если ИмяЗначениеПеречисления <> "" Тогда 
	Попытка
		НоваяЗапись.Статус  = Перечисления.СтатусБрони[ИмяЗначениеПеречисления];
	Исключение
	КонецПопытки;	
КонецЕсли;	
	
ИсторияКлиента.Записать(Истина);
	
ИсторияКлиентаДопПожелания = РегистрыСведений.ИсторияКлиентаДопПожелания.СоздатьНаборЗаписей();
//ИсторияКлиентаДопПожелания.Отбор.Клиент.Установить(Клиент);
//ИсторияКлиентаДопПожелания.Отбор.ЗаявкаГУИД.Установить(ЗаявкаГУИД);

ИсторияКлиентаДопПожелания.Отбор.ЗаявкаГУИД.Установить(ЗаявкаГУИД);
Для Каждого Строка Из ИсторияКлиентаДопПожелания Цикл
	ИсторияКлиентаДопПожелания.Удалить(Строка);
КонецЦикла;

Индекс = 1;
Для Каждого СтрокаДопПожелания Из Строка.ДопПожелания Цикл
	НоваяЗапись = ИсторияКлиентаДопПожелания.Добавить();
	
	НоваяЗапись.Клиент = Клиент;
	НоваяЗапись.ЗаявкаГУИД = ЗаявкаГУИД;
	НоваяЗапись.ДопПожеланияИндекс = Индекс;

	НоваяЗапись.РезервС = Строка.РезервС;
	НоваяЗапись.РезервПо = Строка.РезервПо;;
	НоваяЗапись.ДатаРегистрации = Строка.РезервС;
	
	НоваяЗапись.ВидИнформации = СтрокаДопПожелания.ВидИнформации.Наименование;
	НоваяЗапись.Информация = СтрокаДопПожелания.Информация;
	
	Индекс = Индекс + 1;	
КонецЦикла;

ИсторияКлиентаДопПожелания.Записать(Истина);
КонецПроцедуры
//

//
Процедура ЗагрузитьЗаявкиНаСервере(ПутьКФайловойБазе, ИмяПользователя, Пароль, РезервС, ПапкаГости) Экспорт
	Перем ЗначениеХодаВыполнения, Сч, Объект, СтруктураВозврата; 
	ЗначениеХодаВыполнения = Новый Структура("ПроцентВыполнения, КоличествоСозданныхЭлементов", 0, 0);
	
Соединение = ПолучитьПодключениеКФайловойБД(ПутьКФайловойБазе, ИмяПользователя, Пароль);

Запрос = Соединение.NewObject("Запрос");

Запрос.Текст = "ВЫБРАТЬ
|	ЗаявкаНаБронирование.Ссылка,
|	ЗаявкаНаБронирование.Дата,
|	ЗаявкаНаБронирование.Клиент,
|	ЗаявкаНаБронирование.РезервС,
|	ЗаявкаНаБронирование.РезервПо,
|	ЗаявкаНаБронирование.НомерВРезерв,
|	ЗаявкаНаБронирование.ВремяЗаезда,
|	ЗаявкаНаБронирование.ВремяВыезда,
|	ЗаявкаНаБронирование.КатегорияНомера,
|	ЗаявкаНаБронирование.Статус,
|	ЗаявкаНаБронирование.СвернутьВСчете,
|	ЗаявкаНаБронирование.КолВоЧеловек,
|	ЗаявкаНаБронирование.Бронирует,
|	ЗаявкаНаБронирование.Оплачивает,
|	ЗаявкаНаБронирование.ВСчет,
|	ЗаявкаНаБронирование.Клиент2,
|	ЗаявкаНаБронирование.ДатаАннуляции,
|	ЗаявкаНаБронирование.РаздельныеКровати,
|	ЗаявкаНаБронирование.РазделитьСчет,
|	ЗаявкаНаБронирование.ЦветR,
|	ЗаявкаНаБронирование.ЦветG,
|	ЗаявкаНаБронирование.ЦветB,
|	ЗаявкаНаБронирование.Источник,
|	ЗаявкаНаБронирование.БезЗавтрака,
|	ЗаявкаНаБронирование.НовыйРассчет,
|	ЗаявкаНаБронирование.Примечание,
|	ЗаявкаНаБронирование.ДопУслуги.(
|		Ссылка,
|		НомерСтроки,
|		Услуга,
|		Цена,
|		КолВо,
|		Оплачено,
|		ВСчет,
|		ДатаУслуги,
|		ОтГорничной,
|		ВремяУборки
|	),
|	ЗаявкаНаБронирование.ДопПожелания.(
|		Ссылка,
|		НомерСтроки,
|		Информация,
|		ВидИнформации
|	)
|ИЗ
|	Документ.ЗаявкаНаБронирование КАК ЗаявкаНаБронирование
|ГДЕ
|	ЗаявкаНаБронирование.ПометкаУдаления = ЛОЖЬ
|	И ЗаявкаНаБронирование.РезервС > &РезервС";


Запрос.УстановитьПараметр("РезервС", РезервС);
ТЗ_ЗаявкиСоединение = Запрос.Выполнить().Выгрузить(); 
Если ТЗ_ЗаявкиСоединение.Количество() = 0 Тогда 
	Сообщить("Нет Заявок");
	Возврат; 
КонецЕсли;

КоличествоЭлементов = ТЗ_ЗаявкиСоединение.Количество();

//Клиенты = Справочники.Клиенты;

СоединениеКлиентПустаяСсылка = Соединение.Справочники.Клиенты.ПустаяСсылка(); 

//ПустаяСсылка = Справочники.Клиенты.ПустаяСсылка(); 

МассивИменаПолей = Новый Массив;
Для Каждого Строка Из ТЗ_ЗаявкиСоединение.Колонки Цикл
	МассивИменаПолей.Добавить(Строка.Имя);
КонецЦикла;	

ш = 0;
Для Каждого Строка Из ТЗ_ЗаявкиСоединение Цикл
	//Ход выполнения
	ш = ш + 1;
	ЗначениеХодаВыполнения.КоличествоСозданныхЭлементов = ЗначениеХодаВыполнения.КоличествоСозданныхЭлементов + 1;
	ЗначениеХодаВыполнения.ПроцентВыполнения = Окр(ЗначениеХодаВыполнения.КоличествоСозданныхЭлементов / КоличествоЭлементов * 100);		
	АсинхронныеВызовы.ОбновитьЗначениеХодаВыполнения(ЗначениеХодаВыполнения);
	Если ш%100 = 0 Тогда
		АсинхронныеВызовы.ДобавитьСообщениеХодаВыполнения("Выполнили " + ЗначениеХодаВыполнения.ПроцентВыполнения + "%");
	КонецЕсли;
	
	ЗагрузкаГИУДСтрока = Соединение.XMLСтрока(Строка.Ссылка);
	ЗаявкаЗагрузкаГИУДСтрока = Документы.ЗаявкаНаБронирование.НайтиПоРеквизиту("ЗагрузкаГИУДСтрока", ЗагрузкаГИУДСтрока);
	Если ЗначениеЗаполнено(ЗаявкаЗагрузкаГИУДСтрока) Тогда 
		ЗаявкаОбъект = ЗаявкаЗагрузкаГИУДСтрока.ПолучитьОбъект();
	Иначе
		ЗаявкаОбъект = Документы.ЗаявкаНаБронирование.СоздатьДокумент();
		ЗаявкаОбъект.ЗагрузкаГИУДСтрока = ЗагрузкаГИУДСтрока;
	КонецЕсли;
		
	//КлиентОбъект = Клиенты.СоздатьЭлемент();
	//КлиентОбъект.ЗагрузкаГИУДСтрока = ЗагрузкаГИУДСтрока;
	ЗаполнитьЗначенияЗаявка(ЗаявкаОбъект, Строка, МассивИменаПолей, Соединение, ПапкаГости);
	
	ЗаявкаОбъект.ДопУслуги.Очистить();
	Для Каждого СтрокаДопУслуги Из Строка.ДопУслуги Цикл
		НовыйДопУслуги = ЗаявкаОбъект.ДопУслуги.Добавить();
		
		НовыйДопУслуги.ГУИД = Новый УникальныйИдентификатор;
		
		СсылкаУслуга = ПереносЗначенияКласификатора("ДопУслуги", СтрокаДопУслуги.Услуга);
		НовыйДопУслуги.Услуга = СсылкаУслуга; 
		
		НовыйДопУслуги.Цена = СтрокаДопУслуги.Цена; 
		НовыйДопУслуги.Количество = СтрокаДопУслуги.КолВо; 
		НовыйДопУслуги.ВСчет = СтрокаДопУслуги.ВСчет; 
		НовыйДопУслуги.ДатаУслуги = СтрокаДопУслуги.ДатаУслуги; 
		НовыйДопУслуги.ОтГорничной = СтрокаДопУслуги.ОтГорничной; 
	КонецЦикла;	
	
	ЗаявкаОбъект.ДопПожелания.Очистить();
	Для Каждого СтрокаДопПожелания Из Строка.ДопПожелания Цикл
		НовыйДопПожелания = ЗаявкаОбъект.ДопПожелания.Добавить();
		Ссылка = ПереносЗначенияКласификатора("ВидыИнформации", СтрокаДопПожелания.ВидИнформации);
		
		НовыйДопПожелания.ВидИнформации = Ссылка; 
		НовыйДопПожелания.Информация = СтрокаДопПожелания.Информация; 
	КонецЦикла;	
	
	Попытка
		ЗаявкаОбъект.Записать(РежимЗаписиДокумента.Проведение);
	Исключение
		//Сообщить(ОписаниеОшибки());		
		ЗаявкаОбъект.Записать(РежимЗаписиДокумента.Запись);
		АсинхронныеВызовы.ДобавитьСообщениеХодаВыполнения("Ошибка переноса: " + ЗаявкаОбъект.Номер
			+ " " + ЗаявкаОбъект.Клиент + " " + ОписаниеОшибки());
	КонецПопытки;
	
	//Если ш > 100 Тогда Прервать; КонецЕсли;
КонецЦикла;
	
КонецПроцедуры

Процедура ЗаполнитьЗначенияЗаявка(Получатель, Источник, МассивИменаПолей, Соединение, ПапкаГости)
	
Для Каждого Имя Из МассивИменаПолей Цикл
	Если Имя = "Ссылка" 
	
	//ИЛИ Имя = "МестоРождения" 
	ИЛИ Имя = "ДопУслуги" 
	ИЛИ Имя = "ДопПожелания" 
	
	Тогда Продолжить; КонецЕсли;	
	
	Значение = Источник[Имя];
	Если ТипЗнч(Значение) = Тип("COMОбъект") Тогда
		
		Если Имя = "Клиент" тогда
			Получатель[Имя] = ЗначениеКлиент(Значение, Соединение, ПапкаГости);
			
		ИначеЕсли Имя = "НомерВРезерв" тогда
			Получатель[Имя] = ЗначениеКласиификатораПоНаименованию("НомернойФонд", Значение);

		
		ИначеЕсли Имя = "ВремяЗаезда" тогда
			ИмяЗначениеПеречисления = ИмяЗначенияПеречисление(Соединение, Значение);
			
			Если ИмяЗначениеПеречисления = "Вр12" Тогда ИмяЗначениеПеречисления = "ВР14"; КонецЕсли;
				
			Если ИмяЗначениеПеречисления <> "" Тогда 
				Попытка
					Получатель[Имя] = Перечисления.ВремяЗаезда[ИмяЗначениеПеречисления];
				Исключение
				КонецПопытки;	
			КонецЕсли;			
			
			Получатель.ГорничныеВремяЗаезда = ЗначениеГорничныеВремяЗаезда(Значение, Соединение)
			
		ИначеЕсли Имя = "ВремяВыезда" тогда
			ИмяЗначениеПеречисления = ИмяЗначенияПеречисление(Соединение, Значение);
			
			Если ИмяЗначениеПеречисления <> "" Тогда 
				Попытка
					Получатель[Имя] = Перечисления.ВремяВыезда[ИмяЗначениеПеречисления];
				Исключение
				КонецПопытки;	
			КонецЕсли;				
			
		ИначеЕсли Имя = "КатегорияНомера" тогда
			Получатель[Имя] = ЗначениеКласиификатораПоНаименованию("КатегорииНомеров", Значение);
			
			
		ИначеЕсли Имя = "Статус" тогда
			ИмяЗначениеПеречисления = ИмяЗначенияПеречисление(Соединение, Значение);
			
			Если ИмяЗначениеПеречисления <> "" Тогда 
				Попытка
					Получатель[Имя] = Перечисления.СтатусБрони[ИмяЗначениеПеречисления];
				Исключение
				КонецПопытки;	
			КонецЕсли;				
			
		ИначеЕсли Имя = "Бронирует" тогда
			Получатель[Имя] = ЗначениеКлиент(Значение, Соединение, ПапкаГости);
			
		ИначеЕсли Имя = "Оплачивает" тогда
			Получатель[Имя] = ЗначениеКлиент(Значение, Соединение, ПапкаГости);
			
		ИначеЕсли Имя = "Клиент2" тогда
			Получатель[Имя] = ЗначениеКлиент(Значение, Соединение, ПапкаГости);
			
		ИначеЕсли Имя = "Источник" тогда
			Получатель[Имя] = ПереносЗначенияКласификатора("ИсточникиБронирования", Значение);
			
		КонецЕсли;
	Иначе
		Если Имя = "" тогда
		Иначе
			Получатель[Имя] = Источник[Имя];
		КонецЕсли;		
	КонецЕсли;   
КонецЦикла;
КонецПроцедуры	

Функция ЗначениеКлиент(Значение, Соединение, ПапкаГости)
ЗагрузкаГИУДСтрока = Соединение.XMLСтрока(Значение.Ссылка);
ЗначениеКлиент = Справочники.Клиенты.НайтиПоРеквизиту("ЗагрузкаГИУДСтрока", ЗагрузкаГИУДСтрока);

Если ЗначениеЗаполнено(ЗначениеКлиент) И ЗначениеКлиент.ТипКлиента = Перечисления.ТипыКлиентов.ФизЛицо тогда
	КлиентОбъект = ЗначениеКлиент.ПолучитьОбъект();
	КлиентОбъект.Родитель = ПапкаГости;
	КлиентОбъект.Записать();
КонецЕсли;

Возврат ЗначениеКлиент; 
КонецФункции

Функция ЗначениеКласиификатораПоНаименованию(ИмяКлассификатора, Значение)
Наименование = Значение.Description;
ЗначениеКласиификатораПоНаименованию = Справочники[ИмяКлассификатора].НайтиПоНаименованию(Наименование, Истина);
Возврат ЗначениеКласиификатораПоНаименованию; 
КонецФункции

Функция ЗначениеГорничныеВремяЗаезда(ВремяЗаезда, Соединение)
Если ВремяЗаезда = Соединение.Перечисления.ВремяЗаезда.Вр0 Тогда
	Возврат 0;
ИначеЕсли ВремяЗаезда = Соединение.Перечисления.ВремяЗаезда.Вр6 Тогда
	Возврат 6;
ИначеЕсли ВремяЗаезда = Соединение.Перечисления.ВремяЗаезда.Вр12 Тогда
	Возврат 14;
ИначеЕсли ВремяЗаезда = Соединение.Перечисления.ВремяЗаезда.Вр18 Тогда
	Возврат 18;
Иначе	
	Возврат 0;
КонецЕсли;	
КонецФункции
