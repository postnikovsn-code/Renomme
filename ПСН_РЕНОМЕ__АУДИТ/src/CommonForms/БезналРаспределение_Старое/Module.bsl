                      |			И ВыпискаБанкаДолгиОплата.СчетГУИД = РаспределениеОплат.ДокументДолг.СчетГУИД
                      |ГДЕ
                      |	ВыпискаБанкаДолгиОплата.Ссылка.ПометкаУдаления = ЛОЖЬ
                      |	И ВыпискаБанкаДолгиОплата.Ссылка.ГУИДЗагрузка = &ГУИДЗагрузка");

Запрос.УстановитьПараметр("ГУИДЗагрузка", ГУИДЗагрузка);

ТЗ = Запрос.Выполнить().Выгрузить();

Для Каждого Строка Из ТЗ Цикл
	НоваяСтрока = ЭквайрингВыпискаСвязиОплатыСчета.Добавить();
	ЗаполнитьЗначенияСвойств(НоваяСтрока, Строка); 
	
	НоваяСтрока.ГУИД = ГУИДЗагрузка;
КонецЦикла;

Запрос = Новый Запрос("ВЫБРАТЬ
                      |	ВыпискаБанкаДолгиОплата.Ссылка КАК ДокументОплаты,
                      |	ВыпискаБанкаДолгиОплата.ДокументДолг КАК ДокументДолг,
                      |	ДолгиОплаты.ДокументДолг.Номер КАК НомерСчета,
                      |	ДолгиОплаты.ДокументДолг.Дата КАК ДатаСчета,
                      |	ДолгиОплаты.ДокументДолг.СчетГУИД КАК СчетГУИД,
                      |	ДолгиОплаты.СуммаРаспределено КАК СуммаРаспределено
                      |ИЗ
                      |	Документ.ВыпискаБанка.ДолгиОплата КАК ВыпискаБанкаДолгиОплата
                      |		ВНУТРЕННЕЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
                      |			КоворкингСчетаДокументыОплаты.Ссылка КАК ДокументДолг,
                      |			КоворкингСчетаДокументыОплаты.ДокументОплаты КАК ДокументОплаты,
                      |			СУММА(КоворкингСчетаДокументыОплаты.СуммаРаспределено) КАК СуммаРаспределено
                      |		ИЗ
                      |			Документ.КоворкингСчета.ДокументыОплаты КАК КоворкингСчетаДокументыОплаты
                      |		
                      |		СГРУППИРОВАТЬ ПО
                      |			КоворкингСчетаДокументыОплаты.Ссылка,
                      |			КоворкингСчетаДокументыОплаты.ДокументОплаты) КАК ДолгиОплаты
                      |		ПО ВыпискаБанкаДолгиОплата.Ссылка = ДолгиОплаты.ДокументОплаты
                      |			И ВыпискаБанкаДолгиОплата.ДокументДолг = ДолгиОплаты.ДокументДолг
                      |ГДЕ
                      |	ВыпискаБанкаДолгиОплата.Ссылка.ПометкаУдаления = ЛОЖЬ
                      |	И ВыпискаБанкаДолгиОплата.Ссылка.ГУИДЗагрузка = &ГУИДЗагрузка");


Запрос.УстановитьПараметр("ГУИДЗагрузка", ГУИДЗагрузка);

ТЗ = Запрос.Выполнить().Выгрузить();

Для Каждого Строка Из ТЗ Цикл
	НоваяСтрока = ЭквайрингВыпискаСвязиОплатыСчета.Добавить();
	ЗаполнитьЗначенияСвойств(НоваяСтрока, Строка); 
	
	НоваяСтрока.ГУИД = ГУИДЗагрузка;
КонецЦикла;

ЭквайрингВыпискаСвязиОплатыСчета.Сортировать("ДокументОплаты, ДокументДолг, ДатаСчета, СуммаРаспределено УБЫВ");

ЭквайрингВыпискаСчетаОтмеченоИтого = 0;
КонецПроцедуры
