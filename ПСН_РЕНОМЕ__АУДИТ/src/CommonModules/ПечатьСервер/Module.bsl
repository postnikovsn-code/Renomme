Функция ГрупповойСчетТелоСтроки(Счетчик, СуммаДляПечатиОбщая, СуммаДляПечатиОбщаяНДС
	, ЕстьНДС0, ЕстьНДСНе0
	, ГрупповойСчетОбъект) Экспорт
		
ТЗ = Новый ТаблицаЗначений;
ТЗ.Колонки.Добавить("Бронь");
ТЗ.Колонки.Добавить("КолвоЧеловек");
ТЗ.Колонки.Добавить("Категория");

ТЗ.Колонки.Добавить("НомерСтроки");
ТЗ.Колонки.Добавить("Клиент");
ТЗ.Колонки.Добавить("НаименованиеТовара");
//ТЗ.Колонки.Добавить("КодЕдиницыИзмерения");
ТЗ.Колонки.Добавить("ЕдиницаИзмерения");
ТЗ.Колонки.Добавить("Количество");
ТЗ.Колонки.Добавить("Цена");
ТЗ.Колонки.Добавить("НалоговаяСтавка");
ТЗ.Колонки.Добавить("СуммаНДС");
ТЗ.Колонки.Добавить("СуммаБезНДС");
ТЗ.Колонки.Добавить("СуммаСНДС");
ТЗ.Колонки.Добавить("ЭтоУслуга");
ТЗ.Колонки.Добавить("Дата");
ТЗ.Колонки.Добавить("ДатаС");	
ТЗ.Колонки.Добавить("ДатаПо");	
		
ДокументыДолги = ГрупповойСчетОбъект.ДокументыДолги.Выгрузить();
ДокументыДолги.Сортировать("ДокументДолг");

Если ДокументыДолги.Количество() = 0 тогда Возврат Неопределено; КонецЕсли; 	

ДатаУчетаНДС = ГрупповойСчетСервер.ДатаУчетаНДС(ГрупповойСчетОбъект);
УчитыватьНДС = ДокументыСервер.УчитыватьНДС(ДатаУчетаНДС);

ТекущаяОрганизация = НастройкиСервер.ПолучитьТекущуюОрганизацию();
СтавкаНДС = ТекущаяОрганизация.СтавкаНДС; СтавкаНДС = ДокументыСервер.СтавкаНДСТекущая(СтавкаНДС, ДатаУчетаНДС);
ВсеСНДС = ТекущаяОрганизация.ВсеСНДС;

Контрагент = ГрупповойСчетОбъект.Контрагент; 

ТолькоПроживание = Ложь;
ТолькоУслуги = Ложь;

СвернутьВСчете = ГрупповойСчетОбъект.СвернутьВСчете;

сч=0;

ЕстьНДС0 = Ложь;
ЕстьНДСНе0 = Ложь;

СуммаДляПечатиОбщая = 0;
СуммаДляПечатиОбщаяНДС = 0;
Для каждого СтрокаТаблицы Из ДокументыДолги Цикл
	ДокументДолг = СтрокаТаблицы.ДокументДолг;
	СчетГУИД = СтрокаТаблицы.СчетГУИД;
	
	ОтборСтроки = Новый Структура("СчетГУИД", СчетГУИД); 
	Счета_М = ДокументДолг.Счета.НайтиСтроки(ОтборСтроки); 
	Если Счета_М.Количество() = 0 Тогда Продолжить; КонецЕсли; 
	Счет = Счета_М[0]; 
	
	СчетаДетальноДолги_М = ДокументДолг.СчетаДетальноДолги.НайтиСтроки(ОтборСтроки); 
	
	ТоварКлиент = "" + ТоварКлиент(ДокументДолг, Счет);

	ИтогиЗаявка = ИтогиЗаявка(СчетаДетальноДолги_М, СтавкаНДС, ВсеСНДС);
	СуммаПроживание = ИтогиЗаявка.СуммаПроживание;
	КоличествоСуток = ИтогиЗаявка.КоличествоПроживание;
	СуммаУслуги = ИтогиЗаявка.СуммаУслуги;
	СуммаНДС = ИтогиЗаявка.СуммаНДС ;
	
	Если СвернутьВСчете тогда
		СуммаВсего = СуммаПроживание + СуммаУслуги;
		
		//Если  СуммаПроживание > 0 Тогда
		Если  СуммаВсего > 0 Тогда
			//СтрокаТабл = Макет.ПолучитьОбласть("Строка");
			
			СтрокаТабл = ТЗ.Добавить();
			
			сч=сч+1;
			СтрокаТабл.НомерСтроки = сч;
			
			СтрокаТабл.Бронь = ДокументДолг;
			СтрокаТабл.Категория = ДокументДолг.КатегорияНомера.Наименование;
