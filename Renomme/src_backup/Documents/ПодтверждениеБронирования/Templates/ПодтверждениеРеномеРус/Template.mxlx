					<tl>
						<v8:item>
							<v8:lang>ru</v8:lang>
							<v8:content>• от 6 до 12 часов – плата за половину суток;</v8:content>
						</v8:item>
					</tl>
				</c>
			</c>
		</row>
	</rowsItem>
