&НаСервере
Процедура ЗаменитьОплачиваетНаСервере(Оплачивает_OldValue, ЗаменитьСкидку, Клиент_OldValue)
НачатьТранзакцию();

ЗаменитьОплачивает(Оплачивает_OldValue, ЗаменитьСкидку, Клиент_OldValue);

Если ЭтотОбъектЗаписатьНаСервере() Тогда 
	ОтменитьТранзакцию();
	
	Объект.Оплачивает = Оплачивает_OldValue;
Иначе
	ЗафиксироватьТранзакцию();
Конецесли;
