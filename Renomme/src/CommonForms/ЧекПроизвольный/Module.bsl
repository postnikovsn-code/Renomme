&НаСервере
Процедура СоздатьКассовыйДокумент()
КассовыйДокументОбъект = Документы.КассовыйДокумент.СоздатьДокумент();

КассовыйДокументОбъект.Дата = ТекущаяДата();

КассовыйДокументОбъект.ДатаОплаты = ТекущаяДата();

ОтКого = Справочники.Клиенты.ФизЛицоПроизвольный;
КассовыйДокументОбъект.ОтКого = ОтКого;

КассовыйДокументОбъект.Приход = Истина;
КассовыйДокументОбъект.Сумма = СуммаОплаты;

КредитнаяКарта = (ТипОплаты = "Карта") ИЛИ (ТипОплаты = "Смешанная");
КассовыйДокументОбъект.КредитнаяКарта = КредитнаяКарта;
КассовыйДокументОбъект.СуммаКарта = СуммаКарта;

Наличные = (ТипОплаты = "Наличные") ИЛИ (ТипОплаты = "Смешанная");
КассовыйДокументОбъект.Наличные = Наличные;
КассовыйДокументОбъект.СуммаНаличные = СуммаНаличные;

КассовыйДокументОбъект.НомерСменыККМ = НомерСменыККМ;
КассовыйДокументОбъект.НомерЧекаККМ = НомерЧекаККМ;

КассовыйДокументОбъект.ЭтоПроизвольныйЧек = Истина; 

КассовыйДокументОбъект.Записать(РежимЗаписиДокумента.Проведение);
КонецПроцедуры	


