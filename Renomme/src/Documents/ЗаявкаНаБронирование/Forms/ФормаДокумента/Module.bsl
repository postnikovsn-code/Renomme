&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
Параметры.Свойство("ЗаявкаСайт", ЗаявкаСайт);
Если ЗначениеЗаполнено(Объект.Ссылка) Тогда
	ЗаявкаСайт = Объект.ЗаявкаСайт;
КонецЕсли;
Если НЕ ЗначениеЗаполнено(ЗаявкаСайт) Тогда
	Элементы.ГруппаЗаявкаСайт.Видимость = Ложь;
КонецЕсли;
	
РаботаСИнтерфейсомКлиентСервер.УбратьКнопкуКоманднойПанелиФормы(ЭтаФорма.КоманднаяПанель, "ФормаУдалить");

ТекущийПользователь = ПараметрыСеанса.ТекущийПользователь;

ПараметрыТолькоПросмотр = Неопределено;
Параметры.Свойство("ТолькоПросмотр", ПараметрыТолькоПросмотр);
Если ПараметрыТолькоПросмотр = Неопределено Тогда
	ПараметрыТолькоПросмотр = Ложь;
КонецЕсли;

РаботаСИнтерфейсомСервер_УстановитьТолькоПросмотр = РаботаСИнтерфейсомСервер.УстановитьТолькоПросмотр(ЭтаФорма);
Если РаботаСИнтерфейсомСервер_УстановитьТолькоПросмотр Тогда 
	Элементы.Закрыто.ТолькоПросмотр = Истина;
Иначе
	Если НЕ НастройкиСервер.ЭтоАдминистратор() Тогда
		Элементы.Закрыто.ТолькоПросмотр = Истина;
	КонецЕсли;
КонецЕсли;

Если РаботаСИнтерфейсомСервер_УстановитьТолькоПросмотр
ИЛИ ПараметрыТолькоПросмотр
ИЛИ Объект.Закрыто
Тогда ЭтаФорма.ТолькоПросмотр = Истина; КонецЕсли;

ЭтоАдминистратор = НастройкиСервер.ЭтоАдминистратор();

ЕстьПравоСписаниеДолгов = НастройкиСервер.ПользовательЕстьПраво(Перечисления.ПраваПользователя.СписаниеДолгов);
Элементы.ПодменюСписание.Видимость = ЕстьПравоСписаниеДолгов ИЛИ ЭтоАдминистратор;

Разрешение = НастройкиСервер.ЭтоАдмин() ИЛИ ЭтоАдминистратор;
Элементы.ФормаГруппаДобавитьОплату.Доступность = Разрешение;

Элементы.ЧекАванс.Доступность = Разрешение;

//
ЭтоРазработчик = (СокрЛП(ТекущийПользователь.Код) = "Администратор"); 
Элементы.ФормаТЕСТ.Видимость = ЭтоРазработчик;
Элементы.ФормаОчиститьДанные.Видимость  = ЭтоРазработчик; 

Элементы.ГруппаРаспределениеОплатДолги.Видимость  = ЭтоРазработчик; 
Элементы.ГруппаСчетаДетальноДолги.Видимость  = ЭтоРазработчик; 
//

ТарифныеПланы = Константы.ТарифныеПланы.Получить();
Элементы.ТарифныйПлан.Видимость = ТарифныеПланы;

УсловноеОформлениеИсторияОплат();

ДопМестоВозрастСписокВыбораУстановить(Элементы.ДопМесто_1_Возраст.СписокВыбора);
ДопМестоВозрастСписокВыбораУстановить(Элементы.ДопМесто_2_Возраст.СписокВыбора);
ДопМестоТипДопМестаСписокВыбораУстановить(Элементы.ДопМесто_1_ТипДопМеста.СписокВыбора);
ДопМестоТипДопМестаСписокВыбораУстановить(Элементы.ДопМесто_2_ТипДопМеста.СписокВыбора);

ГорничныеВремяЗаездаСписокВыбораУстановить(Элементы.ГорничныеВремяЗаезда.СписокВыбора);

Если НастройкиСервер.ЭтоСтритАрт() Тогда
	Элементы.СчетаОтправитьВPayKeeper.Доступность = Ложь;
	Элементы.СчетаПроверитьОплатуPayKeepr.Доступность = Ложь;
Конецесли;

ТипБронирования_СписокВыбора = Элементы.ТипБронирования.СписокВыбора;
Запрос = Новый Запрос("ВЫБРАТЬ
                      |	ТипБронирования.Ссылка КАК Ссылка,
                      |	ТипБронирования.Наименование КАК Наименование
                      |ИЗ
                      |	Справочник.ТипБронирования КАК ТипБронирования
                      |ГДЕ
                      |	ТипБронирования.ПометкаУдаления = ЛОЖЬ
                      |
                      |УПОРЯДОЧИТЬ ПО
                      |	ТипБронирования.Номер_пп");

Выборка = Запрос.Выполнить().Выбрать();
Пока Выборка.Следующий() Цикл
	 ТипБронирования_СписокВыбора.Добавить(Выборка.Ссылка, Выборка.Наименование);
КонецЦикла;
 
УстановитьПроцентыВ2В();

ФормаОтладка();

ПроверкаДанныхЗаявки = ПроверитьДанныеЗаявки();
КонецПроцедуры

&НаСервере
