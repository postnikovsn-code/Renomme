 ////////////////////////////////////////////////////////////////////////////////
// Складской учет — повторно используемые значения.
//
// Общий модуль возвращает данные, которые допустимо кэшировать
// в течение серверного вызова (повторное использование результатов).
////////////////////////////////////////////////////////////////////////////////

#Область ПрограммныйИнтерфейс

// Возвращает основной склад — первый по коду элемент справочника «Склады».
// Используется как значение по умолчанию в документах.
//
// Возвращаемое значение:
//  СправочникСсылка.Склады - ссылка на склад или пустая ссылка.
//
Функция ОсновнойСклад() Экспорт

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	Склады.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.Склады КАК Склады
	|УПОРЯДОЧИТЬ ПО
	|	Склады.Код";

	Выборка = Запрос.Выполнить().Выбрать();

	Если Выборка.Следующий() Тогда
		Возврат Выборка.Ссылка;
	КонецЕсли;

	Возврат Справочники.Склады.ПустаяСсылка();

КонецФункции

// Определяет, является ли информационная база пустой:
// в справочнике «Склады» нет ни одного элемента.
// Признак используется для автозаполнения демо-данных при первом запуске.
//
// Возвращаемое значение:
//  Булево - Истина, если справочник «Склады» пуст.
//
Функция ИнформационнаяБазаПустая() Экспорт

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	КОЛИЧЕСТВО(РАЗЛИЧНЫЕ Склады.Ссылка) КАК Количество
	|ИЗ
	|	Справочник.Склады КАК Склады";

	Выборка = Запрос.Выполнить().Выбрать();
	Выборка.Следующий();

	Возврат Выборка.Количество = 0;

КонецФункции

#КонецОбласти