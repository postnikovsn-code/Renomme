
Функция ТЗ_ОтчетДанные(ДатаС, ДатаПо) Экспорт
Запрос = Новый Запрос("ВЫБРАТЬ
                      |	ЗаявкаНаБронированиеПроживание.Ссылка.Номер КАК Номер,
                      |	ЗаявкаНаБронированиеПроживание.Ссылка КАК Заявка,
                      |	ЗаявкаНаБронированиеПроживание.ГУИД КАК ГУИД,
                      |	ЗаявкаНаБронированиеПроживание.Ссылка.КолВоЧеловек КАК КолВоЧеловек,
                      |	ЗаявкаНаБронированиеПроживание.Ссылка.Бронирует КАК Бронирует,
                      |	ЗаявкаНаБронированиеПроживание.ДеньПроживания КАК ДеньПроживания,
                      |	ЗаявкаНаБронированиеПроживание.Тариф КАК Тариф,
                      |	ЗаявкаНаБронированиеПроживание.Сумма КАК Сумма,
                      |	ЗаявкаНаБронированиеПроживание.СуммаБезСкидки КАК СуммаБезСкидки,
                      |	ЗаявкаНаБронированиеПроживание.ПроцентСкидкиКлиента КАК ПроцентСкидкиКлиента,
                      |	ЗаявкаНаБронированиеПроживание.Цена КАК Цена,
                      |	ЗаявкаНаБронированиеПроживание.Количество КАК Количество
                      |ИЗ
                      |	Документ.ЗаявкаНаБронирование.Проживание КАК ЗаявкаНаБронированиеПроживание
                      |		ВНУТРЕННЕЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
                      |			ЗаявкаНаБронированиеСчетаДетальноДолги.Ссылка КАК Ссылка,
                      |			ЗаявкаНаБронированиеСчетаДетальноДолги.ДолгиГУИД КАК ДолгиГУИД
                      |		ИЗ
                      |			Документ.ЗаявкаНаБронирование.СчетаДетальноДолги КАК ЗаявкаНаБронированиеСчетаДетальноДолги
                      |				ЛЕВОЕ СОЕДИНЕНИЕ Документ.ЗаявкаНаБронирование.Счета КАК ЗаявкаНаБронированиеСчета
                      |				ПО ЗаявкаНаБронированиеСчетаДетальноДолги.Ссылка = ЗаявкаНаБронированиеСчета.Ссылка
                      |					И ЗаявкаНаБронированиеСчетаДетальноДолги.СчетГУИД = ЗаявкаНаБронированиеСчета.СчетГУИД) КАК Счет
                      |		ПО ЗаявкаНаБронированиеПроживание.Ссылка = Счет.Ссылка
                      |			И ЗаявкаНаБронированиеПроживание.ГУИД = Счет.ДолгиГУИД
                      |ГДЕ
                      |	ЗаявкаНаБронированиеПроживание.Ссылка.ПометкаУдаления = ЛОЖЬ
                      |	И (ЗаявкаНаБронированиеПроживание.Ссылка.Статус = ЗНАЧЕНИЕ(Перечисление.СтатусБрони.Проживает)
                      |			ИЛИ ЗаявкаНаБронированиеПроживание.Ссылка.Статус = ЗНАЧЕНИЕ(Перечисление.СтатусБрони.Выехал)
                      |			ИЛИ ЗаявкаНаБронированиеПроживание.Ссылка.Статус = ЗНАЧЕНИЕ(Перечисление.СтатусБрони.Неустойка))
                      |	И ЗаявкаНаБронированиеПроживание.ДеньПроживания >= &ДатаС
                      |	И ЗаявкаНаБронированиеПроживание.ДеньПроживания <= &ДатаПо
                      |	И ЗаявкаНаБронированиеПроживание.Ссылка.БонШанс = ЛОЖЬ
                      |
                      |УПОРЯДОЧИТЬ ПО
                      |	Номер");
	
Запрос.УстановитьПараметр("ДатаС", ДатаС);
Запрос.УстановитьПараметр("ДатаПо", ДатаПо);
ТЗ_Проживание = Запрос.Выполнить().Выгрузить();

ТЗ_Заявки = ТЗ_Проживание.Скопировать(,"Заявка");
ТЗ_Заявки.Свернуть("Заявка");
МассивЗаявки = ТЗ_Заявки.ВыгрузитьКолонку("Заявка");

ТЗ_Проживание.Колонки.Добавить("КоличествоДвухместныеРазмещения", Новый ОписаниеТипов("Число")); 
ТЗ_Проживание.Колонки.Добавить("КоличествоОдноместныеРазмещения", Новый ОписаниеТипов("Число")); 

Запрос = Новый Запрос("ВЫБРАТЬ
                      |	ЗаявкаНаБронированиеДопУслуги.Ссылка КАК Заявка,
                      |	ЗаявкаНаБронированиеДопУслуги.ГУИД КАК ГУИД,
                      |	ЗаявкаНаБронированиеДопУслуги.Услуга КАК Услуга,
                      |	ЗаявкаНаБронированиеДопУслуги.Цена КАК Цена,
                      |	ЗаявкаНаБронированиеДопУслуги.Количество КАК Количество,
                      |	ЗаявкаНаБронированиеДопУслуги.ВСчет КАК ВСчет,
                      |	ЗаявкаНаБронированиеДопУслуги.ДатаУслуги КАК ДатаУслуги,
                      |	ЗаявкаНаБронированиеДопУслуги.Цена * ЗаявкаНаБронированиеДопУслуги.Количество КАК Сумма,
                      |	ЗаявкаНаБронированиеДопУслуги.Цена * ЗаявкаНаБронированиеДопУслуги.Количество КАК СуммаУслугиДолг,
                      |	ЗаявкаНаБронированиеСчетаДетальноДолги.СчетГУИД КАК СчетГУИД
                      |ИЗ
                      |	Документ.ЗаявкаНаБронирование.ДопУслуги КАК ЗаявкаНаБронированиеДопУслуги
                      |		ЛЕВОЕ СОЕДИНЕНИЕ Документ.ЗаявкаНаБронирование.СчетаДетальноДолги КАК ЗаявкаНаБронированиеСчетаДетальноДолги
                      |		ПО ЗаявкаНаБронированиеДопУслуги.Ссылка = ЗаявкаНаБронированиеСчетаДетальноДолги.Ссылка
                      |			И ЗаявкаНаБронированиеДопУслуги.ГУИД = ЗаявкаНаБронированиеСчетаДетальноДолги.ДолгиГУИД
                      |ГДЕ
                      |	ЗаявкаНаБронированиеДопУслуги.Ссылка В(&Заявки)
                      |	И ЗаявкаНаБронированиеДопУслуги.ДатаУслуги >= &ДатаС
                      |	И ЗаявкаНаБронированиеДопУслуги.ДатаУслуги <= &ДатаПо");

Запрос.УстановитьПараметр("Заявки", МассивЗаявки);
Запрос.УстановитьПараметр("ДатаС", ДатаС);
Запрос.УстановитьПараметр("ДатаПо", ДатаПо);
ТЗ_УслугиЗаявки = Запрос.Выполнить().Выгрузить();	

Запрос = Новый Запрос ("ВЫБРАТЬ
                       |	ЗаявкаНаБронированиеРаспределениеОплатДолги.Ссылка КАК Ссылка,
                       |	ЗаявкаНаБронированиеРаспределениеОплатДолги.ДолгиГУИД КАК ДолгиГУИД,
                       |	ЗаявкаНаБронированиеРаспределениеОплатДолги.СуммаОплаты КАК СуммаОплаты,
                       |	ЗаявкаНаБронированиеРаспределениеОплатДолги.ДокументОплаты КАК ДокументОплаты
                       |ИЗ
                       |	Документ.ЗаявкаНаБронирование.РаспределениеОплатДолги КАК ЗаявкаНаБронированиеРаспределениеОплатДолги
                      |ГДЕ
                      |	ЗаявкаНаБронированиеРаспределениеОплатДолги.Ссылка В (&Заявки)");


Запрос.УстановитьПараметр("Заявки", МассивЗаявки);
ТЗ_Оплаты = Запрос.Выполнить().Выгрузить();

ПроцентыЭквайринга = ПроцентыЭквайрингаЗагрузить();

ТекущаяОрганизация = НастройкиСервер.ПолучитьТекущуюОрганизацию();
Отель = ТекущаяОрганизация.Наименование;

Запрос = Новый Запрос("ВЫБРАТЬ
                      |	КОЛИЧЕСТВО(РАЗЛИЧНЫЕ НомернойФонд.Ссылка) КАК КоличествоНомеров
                      |ИЗ
                      |	Справочник.НомернойФонд КАК НомернойФонд
                      |ГДЕ
                      |	НомернойФонд.ПометкаУдаления = ЛОЖЬ");

ТЗ = Запрос.Выполнить().Выгрузить();
КоличествоНомеровОтель = ТЗ[0].КоличествоНомеров;

Запрос = Новый Запрос("ВЫБРАТЬ
                      |	ЕжедневныйОтчетФакт.Дата КАК Дата,
                      |	ЕжедневныйОтчетФакт.Отель КАК Отель,
                      |	ЕжедневныйОтчетФакт.КоличествоНомеров КАК КоличествоНомеров,
                      |	ЕжедневныйОтчетФакт.КоличествоДвухместныеРазмещения КАК КоличествоДвухместныеРазмещения,
                      |	ЕжедневныйОтчетФакт.СуммаДвухместныеРазмещения КАК СуммаДвухместныеРазмещения,
                      |	ЕжедневныйОтчетФакт.КоличествоОдноместныеРазмещения КАК КоличествоОдноместныеРазмещения,
                      |	ЕжедневныйОтчетФакт.СуммаОдноместныеРазмещения КАК СуммаОдноместныеРазмещения,
                      |	ЕжедневныйОтчетФакт.СуммаАгентскогоВознаграждения КАК СуммаАгентскогоВознаграждения,
                      |	ЕжедневныйОтчетФакт.Процент_НА КАК Процент_НА,
                      |	ЕжедневныйОтчетФакт.ADR_НА КАК ADR_НА,
                      |	ЕжедневныйОтчетФакт.Мероприятия КАК Мероприятия
                      |ИЗ
                      |	РегистрСведений.ЕжедневныйОтчетФакт КАК ЕжедневныйОтчетФакт
                      |ГДЕ
                      |	ЕжедневныйОтчетФакт.Дата = &Дата");
					  
Запрос.УстановитьПараметр("Дата", Неопределено);					  
ТЗ_ОтчетДанные = Запрос.Выполнить().Выгрузить();

ТЗ_ОтчетДанные.Колонки.Добавить("СуммаКомиссии");
ТЗ_ОтчетДанные.Колонки.Добавить("СуммаВ2В");

ДТ = ДатаС;
Пока ДТ <= ДатаПо Цикл
	//ОтборСтроки = Новый Структура("ДеньПроживания", ДТ);
	//НайденныеСтрокиДолги = ТЗ_Проживание.НайтиСтроки(ОтборСтроки);
	//
	//Если НайденныеСтрокиДолги.Количество() = 0 Тогда
	//	НоваяСтрока = ТЗ_ОтчетДанные.Добавить();
	//	
	//	НоваяСтрока.Дата = ДТ;
	//	НоваяСтрока.Отель = Отель;
	//	НоваяСтрока.КоличествоНомеров = КоличествоНомеровОтель;
	//	
	//	Перейти ~ПРОДОЛЖИТЬ;
	//КонецЕсли;	
	
	Для Каждого Заявка Из МассивЗаявки Цикл 
		
	//Для Каждого СтрокаДолги Из НайденныеСтрокиДолги Цикл 
		
		ОтборСтроки = Новый Структура(" Заявка, ДеньПроживания", Заявка, ДТ);
		НайденныеСтрокиДолги = ТЗ_Проживание.НайтиСтроки(ОтборСтроки);
		
		Если НайденныеСтрокиДолги.Количество() = 0 Тогда
			НоваяСтрока = ТЗ_ОтчетДанные.Добавить();
			
			НоваяСтрока.Дата = ДТ;
			НоваяСтрока.Отель = Отель;
			НоваяСтрока.КоличествоНомеров = КоличествоНомеровОтель;
			
			//Перейти ~ПРОДОЛЖИТЬ;
			Продолжить;	
		КонецЕсли;		
		
		СтрокаДолги = НайденныеСтрокиДолги[0];
		
		ПроцентКомиссии = ДокументыСервер.ПроцентКомиссииКлиента(СтрокаДолги.Заявка.Бронирует, СтрокаДолги.Заявка.РезервС);	
		
		ОтборСтроки = Новый Структура("Заявка", СтрокаДолги.Заявка);
		ТЗ_Услуги = ТЗ_УслугиЗаявки.Скопировать(ОтборСтроки);
		
		СуммаКомиссии_П = ДокументыСервер.СуммаКомиссии(СтрокаДолги.Заявка, СтрокаДолги.СуммаБезСкидки, СтрокаДолги.Заявка.Счета
			, СтрокаДолги.Заявка.СчетаДетальноДолги, ТЗ_Услуги, ПроцентКомиссии);   
		
		СуммаКомиссии = Окр(СуммаКомиссии_П, 2); 
		
		ПроцентВ2В = ДокументыСервер.ПроцентВ2В(СтрокаДолги.Заявка.Бронирует, СтрокаДолги.Заявка.РезервС);
		СуммаВ2В_П = ДокументыСервер.СуммаВ2В(СтрокаДолги.Заявка, ПроцентВ2В, СтрокаДолги);
		СуммаВ2В = Окр(СуммаВ2В_П); 
		
		СуммаКомиссииПроживание = СуммаКомиссии + СуммаВ2В;
		
		ОтборСтроки = Новый Структура("Ссылка, ДолгиГУИД", СтрокаДолги.Заявка, СтрокаДолги.ГУИД);
		НайденныеОплаты = ТЗ_Оплаты.НайтиСтроки(ОтборСтроки);
		СуммаЭквайринга = 0;
		Для Каждого СтрокаОплаты Из НайденныеОплаты Цикл
			Если ЗначениеЗаполнено(СтрокаОплаты.ДокументОплаты) Тогда
				ДатаОплаты_П = СтрокаОплаты.ДокументОплаты.ДатаОплаты;
			Иначе
				ДатаОплаты_П = '00010101';
			КонецЕсли;

			ПроцентыЭквайринга_П = ПроцентыЭквайринга(ПроцентыЭквайринга, ДатаОплаты_П);
			ПроцентЭквайринга = ПроцентыЭквайринга_П.ПроцентЭквайринга;
			ПроцентЭквайрингаСБП = ПроцентыЭквайринга_П.ПроцентЭквайрингаСБП;
			
			СуммаЭквайринга = СуммаЭквайринга + СуммаЭквайринга(СтрокаОплаты, ПроцентЭквайринга, ПроцентЭквайрингаСБП); 				
		КонецЦикла;
		
		НоваяСтрока = ТЗ_ОтчетДанные.Добавить();
		
		НоваяСтрока.СуммаКомиссии = СуммаКомиссии;
		НоваяСтрока.СуммаВ2В = СуммаВ2В;
		
		НоваяСтрока.Дата = ДТ;
		НоваяСтрока.Отель = Отель;
		НоваяСтрока.КоличествоНомеров = КоличествоНомеровОтель;
		
		Если СтрокаДолги.КолвоЧеловек < 2 Тогда
			//НоваяСтрока.КоличествоОдноместныеРазмещения = 1;
			НоваяСтрока.КоличествоОдноместныеРазмещения = СтрокаДолги.Количество;
			НоваяСтрока.КоличествоДвухместныеРазмещения = 0;
			Если СтрокаДолги.Бронирует.Турагентство Тогда
				СуммаОдноместныеРазмещения = СтрокаДолги.СуммаБезСкидки - СуммаКомиссииПроживание;
				СуммаАгентскогоВознаграждения = СуммаКомиссииПроживание;
			Иначе	
				СуммаОдноместныеРазмещения = СтрокаДолги.Сумма;
				СуммаАгентскогоВознаграждения = 0;
			КонецЕсли;
			
			СуммаОдноместныеРазмещения = СуммаОдноместныеРазмещения - СуммаЭквайринга; 
			НоваяСтрока.СуммаОдноместныеРазмещения = СуммаОдноместныеРазмещения;
			НоваяСтрока.СуммаАгентскогоВознаграждения = СуммаАгентскогоВознаграждения;
		Иначе
			//НоваяСтрока.КоличествоДвухместныеРазмещения =  1;
			НоваяСтрока.КоличествоДвухместныеРазмещения =  СтрокаДолги.Количество;
			НоваяСтрока.КоличествоОдноместныеРазмещения = 0;
			Если СтрокаДолги.Бронирует.Турагентство Тогда
				СуммаДвухместныеРазмещения = СтрокаДолги.СуммаБезСкидки - СуммаКомиссииПроживание;
				СуммаАгентскогоВознаграждения = СуммаКомиссииПроживание;
			Иначе	
				СуммаДвухместныеРазмещения = СтрокаДолги.Сумма;
				СуммаАгентскогоВознаграждения = 0;
			КонецЕсли;
			
			СуммаДвухместныеРазмещения = СуммаДвухместныеРазмещения - СуммаЭквайринга; 
			НоваяСтрока.СуммаДвухместныеРазмещения = СуммаДвухместныеРазмещения;
			НоваяСтрока.СуммаАгентскогоВознаграждения = СуммаАгентскогоВознаграждения;
		КонецЕсли;
	КонецЦикла;
	
~ПРОДОЛЖИТЬ: 
 	ДТ = ДТ + 24*60*60;
КонецЦикла;

ТЗ_ОтчетДанные.Свернуть("Дата, Отель, КоличествоНомеров",
	"КоличествоОдноместныеРазмещения, СуммаОдноместныеРазмещения, КоличествоДвухместныеРазмещения, СуммаДвухместныеРазмещения" 
	+ ", СуммаАгентскогоВознаграждения, СуммаВ2В, СуммаКомиссии");
	
ТЗ_ОтчетДанные.Колонки.Добавить("Мероприятия");	
	
Для Каждого Строка Из ТЗ_ОтчетДанные Цикл
	ЗапросМероприятия = Новый Запрос("ВЫБРАТЬ
		                                 |	Мероприятия.Ссылка КАК Ссылка,
		                                 |	Мероприятия.Наименование КАК Наименование,
		                                 |	Мероприятия.ДатаС КАК ДатаС,
		                                 |	Мероприятия.ДатаПо КАК ДатаПо,
		                                 |	Мероприятия.ТипМероприятия КАК ТипМероприятия,
		                                 |	Мероприятия.Мероприятие КАК Мероприятие
		                                 |ИЗ
		                                 |	Справочник.Мероприятия КАК Мероприятия
		                                 |ГДЕ
		                                 |	Мероприятия.ПометкаУдаления = ЛОЖЬ
		                                 |	И Мероприятия.ДатаС <= &Дата
		                                 |	И Мероприятия.ДатаПо >= &Дата
		                                 |
		                                 |УПОРЯДОЧИТЬ ПО
		                                 |	ДатаС");
		
		ЗапросМероприятия.УстановитьПараметр("Дата", Строка.Дата);
		ТЗМероприятия = ЗапросМероприятия.Выполнить().Выгрузить();
		Мероприятия = "";
		Для Каждого СтрокаТЗМероприятия Из ТЗМероприятия Цикл
			Мероприятие = ?(ЗначениеЗаполнено(СтрокаТЗМероприятия.Мероприятие), СтрокаТЗМероприятия.Мероприятие, СтрокаТЗМероприятия.Наименование);
			Мероприятия = Мероприятия + Мероприятие + Символы.ПС;
		КонецЦикла;
		Если Мероприятия <> "" Тогда 
			Мероприятия = Лев(Мероприятия, СтрДлина(Мероприятия) - 1);
		КонецЕсли; 
	
		Строка.Мероприятия = Мероприятия;		
КонецЦикла;

Для Каждого Строка Из ТЗ_ОтчетДанные Цикл
	Строка.СуммаАгентскогоВознаграждения = Строка.СуммаКомиссии + Строка.СуммаВ2В; 	
КонецЦикла;
	
Возврат ТЗ_ОтчетДанные;
КонецФункции

