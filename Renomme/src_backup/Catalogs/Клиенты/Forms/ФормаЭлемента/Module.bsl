Иначе
	Видимость_П = Ложь;
	
	Массив.Добавить(Тип("Строка"));  
КонецЕсли;	

ОписаниеТипов = Новый ОписаниеТипов(Массив);

Элементы.ПредставительКодОрганаФМС.Видимость = Видимость_П;
Элементы.ПредставительПунктыВыдачиФМС.ОграничениеТипа = ОписаниеТипов;
КонецПроцедуры

&НаКлиенте
Процедура ПредставительКодОрганаФМСПриИзменении(Элемент)
НовыйМассив = Новый Массив;
	
Если СокрЛП(Объект.ПредставительКодОрганаФМС) = "" Тогда Перейти ~ВЫХОД; КонецЕсли;

ПредставительТипДокументаФМС_ID = ОбщийФункционалСервер.ЗначениеРеквизитаНаСервере(Объект.ПредставительТипДокументаФМС_NEW, "ID");
Если НЕ КодОрганаРазрешен(ПредставительТипДокументаФМС_ID) Тогда Перейти ~ВЫХОД; КонецЕсли;

Результат = КлиентыСервер.ПунктыВыдачиФМС(Объект.ПредставительКодОрганаФМС, Объект.ПредставительДатаВыдачиДокументаФМС); 
ПунктыВыдачиФМС = Результат.ПунктыВыдачиФМС; 

НовыйМассив = Новый Массив;
Если ЗначениеЗаполнено(ПунктыВыдачиФМС) Тогда
	Объект.ПредставительПунктыВыдачиФМС_NEW = ПунктыВыдачиФМС;
	
	Если Результат.СостояниеВыбора = "НЕТ ДАННЫХ" Тогда
		ПоказатьПредупреждение(, "Уточните 'Кем выдан'");
	ИначеЕсли Результат.СостояниеВыбора = "НЕТ ДАТЫ" Тогда
		ПоказатьПредупреждение(, "'Дата выдачи' - пусто
			| Уточните 'Кем выдан'");
	КонецЕсли;
	
	НовыйПараметр = Новый ПараметрВыбора("Отбор.CODE_0", Объект.ПредставительКодОрганаФМС);
	НовыйМассив.Добавить(НовыйПараметр);

Иначе
	ТекстПредупреждения = "У Представителя  
		| некорректный реквизит 'код органа, выдавшего документ'.";

	ПоказатьПредупреждение(, ТекстПредупреждения);
	Сообщить(ТекстПредупреждения);
КонецЕсли;	

~ВЫХОД:
НовыеПараметры = Новый ФиксированныйМассив(НовыйМассив);
Элементы.ПредставительПунктыВыдачиФМС.ПараметрыВыбора = НовыеПараметры;
КонецПроцедуры

// + Сканы Документов
&НаКлиенте
Процедура СканыДокументовПриАктивизацииСтроки(Элемент)
ТД = Элемент.ТекущиеДанные; 		
Если ТД = Неопределено Тогда 
	ПутьДоФото = ""; 
Иначе
	ПутьДоФото = КаталогФото + ТД.ПутьДоФото;
КонецЕсли;	
	
ПоказатьКартинку(ПутьДоФото, Фото_3);
КонецПроцедуры

&НаКлиенте
Процедура СканыДокументовПередУдалением(Элемент, Отказ)
ДопПараметры = Элемент.ТекущаяСтрока;	
Оповещение = Новый ОписаниеОповещения("ЗавершениеВопроса_УдалениеСкана", ЭтаФорма, ДопПараметры);	
ПоказатьВопрос(Оповещение, "ПОДТВЕРДИТЕ УДАЛЕНИЕ ...", РежимДиалогаВопрос.ОКОтмена);

Отказ = Истина;
КонецПроцедуры

&НаКлиенте
Процедура ЗавершениеВопроса_УдалениеСкана(Результат, ДополнительныеПараметры) Экспорт
Если Результат = КодВозвратаДиалога.Отмена Тогда Возврат; КонецЕсли;

ТС = ДополнительныеПараметры;

ТД = Объект.СканыДокументов.НайтиПоИдентификатору(ТС);
Объект.СканыДокументов.Удалить(ТД);;

Попытка
	ИмяФайла = КаталогФото + ТД.ПутьДоФото;
	УдалитьФайлы(ИмяФайла);
Исключение
КонецПопытки;

ЭтаФорма.Записать();
КонецПроцедуры
// - Сканы Документов


&НаКлиенте
Процедура ПередЗакрытием(Отказ, ЗавершениеРаботы, ТекстПредупреждения, СтандартнаяОбработка)
Если НЕ флЗакрытиеФормы Тогда	
	Если ЗначениеЗаполнено(ЗаявкаСайт) Тогда
		флЗакрытиеФормы = Истина;
		
		СтандартнаяОбработка = Ложь;
		Закрыть(Объект.Ссылка);
	ИначеЕсли ВызовИзКлиенты Тогда
		флЗакрытиеФормы = Истина;
		
		Если флЗаписано Тогда
			СтандартнаяОбработка = Ложь;
			Закрыть(Объект.Ссылка);
		Иначе
			Закрыть();
		КонецЕсли;	
	КонецЕсли;	
КонецЕсли;	
КонецПроцедуры

