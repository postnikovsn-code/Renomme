&НаКлиенте
Процедура ПриОткрытии(Отказ)
Для Каждого Элемент Из ИменаВопросыТЗ Цикл	
	//Элементы.Вопросы1КоманднаяПанель.ПодчиненныеЭлементы.Вопросы1Добавить.Видимость = Ложь;
	//Элементы.Вопросы1КоманднаяПанель.ПодчиненныеЭлементы.Вопросы1Скопировать.Видимость = Ложь; 
	Имя = Элемент.Значение + "КоманднаяПанель";
	Элементы[Имя].ПодчиненныеЭлементы[Элемент.Значение + "Добавить"].Видимость = Ложь;
	Элементы[Имя].ПодчиненныеЭлементы[Элемент.Значение + "Скопировать"].Видимость = Ложь; 
КонецЦикла;
КонецПроцедуры

&НаКлиенте
Процедура ПередЗаписью(Отказ, ПараметрыЗаписи)
Ответы_ПХУП = Объект.Ответы_ПХУП;	
Ответы_ПХУП.Очистить();

Ответы_Текст = Объект.Ответы_Текст;	
Ответы_Текст.Очистить();

Ответы_ДаНет = Объект.Ответы_ДаНет;	
Ответы_ДаНет.Очистить();

Ответы_ТаблицаДаНет = Объект.Ответы_ТаблицаДаНет;	
Ответы_ТаблицаДаНет.Очистить();

Для Каждого Строка Из Объект.Заголовки Цикл
	Если Строка.ЗаголовокТип = "ОтветыПХУП" Тогда
		
		Имя = "ПХУП_ОтветыТЗ" + Строка.ЗаголовокНомер_пп;	
		
		ОтборСтроки = Новый Структура("ЗаголовокКод"
			, Строка.ЗаголовокКод);
		НайденныеСтроки = ЭтаФорма[Имя].НайтиСтроки(ОтборСтроки);
		
		Для Каждого НайденнаяСтрока Из НайденныеСтроки Цикл 
			НоваяСтрока = Ответы_ПХУП.Добавить();
			
			НоваяСтрока.ЗаголовокКод = Строка.ЗаголовокКод;		
			
			НоваяСтрока.ВопросКод = НайденнаяСтрока.ВопросКод;		
			НоваяСтрока.ВопросНомер_пп = НайденнаяСтрока.ВопросНомер_пп;	
			
			НоваяСтрока.Превосходно = НайденнаяСтрока.Превосходно;
			НоваяСтрока.Хорошо = НайденнаяСтрока.Хорошо;
			НоваяСтрока.Удовлетворительно = НайденнаяСтрока.Удовлетворительно;
			НоваяСтрока.Плохо = НайденнаяСтрока.Плохо;
		КонецЦикла;		
		
	ИначеЕсли Строка.ЗаголовокТип = "ОтветТекст" ИЛИ Строка.ЗаголовокТип = "ОтветТекстБезСтроки"Тогда
		
		Имя = "ОтветТекст" + Строка.ЗаголовокНомер_пп;	
		НоваяСтрока = Ответы_Текст.Добавить();
		НоваяСтрока.ЗаголовокКод = Строка.ЗаголовокКод;		
		
		НоваяСтрока.ОтветТекст = ЭтаФорма[Имя];
		
	ИначеЕсли Строка.ЗаголовокТип = "ОтветДаНет" Тогда
		
		ИмяДа = "ОтветДа" + Строка.ЗаголовокНомер_пп;	
		ИмяНет = "ОтветНет" + Строка.ЗаголовокНомер_пп;	
		
		НоваяСтрока = Ответы_ДаНет.Добавить();
		НоваяСтрока.ЗаголовокКод = Строка.ЗаголовокКод;		
			
		НоваяСтрока.ОтветДа = ЭтаФорма[ИмяДа];	
		НоваяСтрока.ОтветНет = ЭтаФорма[ИмяНет];	
		
	ИначеЕсли Строка.ЗаголовокТип = "ОтветыТаблицаДаНет" Тогда
		
		ОтборСтроки = Новый Структура("ЗаголовокКод"
			, Строка.ЗаголовокКод);
		НайденныеСтроки = Объект.Вопросы.НайтиСтроки(ОтборСтроки);
		
		Для Каждого НайденнаяСтрока Из НайденныеСтроки Цикл

			Имя = "ОтветТаблицаДаНет" + Строка.ЗаголовокНомер_пп 
				+ "_" + НайденнаяСтрока.ВопросКод + "_" + НайденнаяСтрока.ВопросНомер_пп; 
		
			НоваяСтрока = Ответы_ТаблицаДаНет.Добавить();
			НоваяСтрока.ЗаголовокКод = Строка.ЗаголовокКод;		
		
			НоваяСтрока.ВопросКод = НайденнаяСтрока.ВопросКод;		
			НоваяСтрока.ВопросНомер_пп = НайденнаяСтрока.ВопросНомер_пп;		
			
			НоваяСтрока.ОтветДаНет = ЭтаФорма[Имя];
		КонецЦикла;
	КонецЕсли;	
	
КонецЦикла;
	
	
КонецПроцедуры

&НаКлиенте
Процедура КлиентПриИзменении(Элемент)
Наименование = ОбщийФункционалСервер.ЗначениеРеквизитаНаСервере(Объект.Клиент, "Наименование");	
Объект.ФИО = Наименование;	
Телефон = ОбщийФункционалСервер.ЗначениеРеквизитаНаСервере(Объект.Клиент, "Телефон");		
Объект.Телефон = Телефон;	
ЭлПочта = ОбщийФункционалСервер.ЗначениеРеквизитаНаСервере(Объект.Клиент, "ЭлПочта");		
Объект.EMail = ЭлПочта;	
КонецПроцедуры





