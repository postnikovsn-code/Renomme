// + Копия Чека;
&НаКлиенте
Процедура КопияЧека(Команда)
Оповещение = Новый ОписаниеОповещения("ЗавершениеФормы_КассовыйДокументФормаВыбораИзКопияЧека", ЭтаФорма);

ДокументыОплатыОтбор = Новый СписокЗначений;
Для Каждого Строка Из Объект.СчетаДетальноОплаты Цикл
	Если Строка.ГрупповаяОплата Тогда Продолжить; КонецЕсли;
	Если ТипЗнч(Строка.ДокументОплаты) <> Тип("ДокументСсылка.КассовыйДокумент") Тогда Продолжить; КонецЕсли;
	
	ДокументыОплатыОтбор.Добавить(Строка.ДокументОплаты);
КонецЦикла;
	
ПараметрыФормы = Новый Структура("ДокументыОплатыОтбор", ДокументыОплатыОтбор);

ОткрытьФорму("Документ.КассовыйДокумент.Форма.ФормаВыбораКопияЧек", ПараметрыФормы, ЭтаФорма
	,,,,Оповещение , РежимОткрытияОкнаФормы.БлокироватьВесьИнтерфейс);
КонецПроцедуры

&НаКлиенте
Процедура ЗавершениеФормы_КассовыйДокументФормаВыбораИзКопияЧека(Результат, ДополнительныеПараметры) Экспорт
Если Результат = Неопределено Тогда	Возврат; КонецЕсли;

Текст = ПолучитьТекстКопииЧека(Результат);
ФУ_Клиент.ВыполнитьПечатьТекста(ЭтаФорма, Текст);
КонецПроцедуры

&НаСервере
Функция ПолучитьТекстКопииЧека(КассовыйДокумент) 
Строка = "";

Организация = НастройкиСервер.ПолучитьТекущуюОрганизацию();
НаименованиеДляФУ = ОбщийФункционалСервер.ЗначениеРеквизитаНаСервере(Организация, "НаименованиеДляФУ");
Строка = Строка + НаименованиеДляФУ;

Пока СтрДлина(Строка)<32 цикл
Строка=" " + Строка + " ";
конеццикла;

СуммаЧека=0;
Позиция = Неопределено;
КассовыйДокументЧекККМДетально = 
	ОбщийФункционалСервер.ТабличнаяЧастьДокументаВМассивСтруктур(КассовыйДокумент, "ЧекККМДетально");
Для Каждого Позиция Из КассовыйДокументЧекККМДетально Цикл
	Строка = Строка + Символы.ПС + "-------------------------------";
    Строка = Строка + Символы.ПС + Позиция.Наименование;
	
	СтрСумма=Формат(Позиция.Сумма, "ЧДЦ=2; ЧГ=");
	Пока СтрДлина(СтрСумма)<32 цикл
		СтрСумма=" "+СтрСумма;
	конеццикла;
	
	Строка = Строка + Символы.ПС + СтрСумма;
	
    СуммаЧека=СуммаЧека + Позиция.Сумма;
КонецЦикла;

СтрСумма="ИТОГ "+Формат(СуммаЧека, "ЧДЦ=2; ЧГ=");
	Пока СтрДлина(СтрСумма)<32 цикл
		СтрСумма=" "+СтрСумма;
	конеццикла;
	
Строка = Строка + Символы.ПС + СтрСумма;
Строка = Строка + Символы.ПС + "-------------------------------";

ДокОснДата = ОбщийФункционалСервер.ПолучитьЗначениеРеквизитаНаСервере(КассовыйДокумент, "Дата");

Строка = Строка + Символы.ПС + Формат(ДокОснДата, "ДФ=dd.MM.yy");

Строка = Строка + Символы.ПС + "КОПИЯ ЧЕКА";
			
Возврат Строка;
КонецФункции 
