	//ЭлементыФормы.ПолеОтчета.Вывести(ТабДок);
	ПолеОтчета.Вывести(ТабДок);
	
	
	СпрНомеров=Справочники.НомернойФонд.Выбрать();
	Х=0;
	У=0;
	
	Пока СпрНомеров.Следующий() цикл
		
		У=У+1;
		
		ТабДок=Новый ТабличныйДокумент;
