					УстановитьЦветЯчеекВыбор(ДТ, ОбластьПоиск);
				конецесли;	
			КонецЕсли;
		КонецЦикла; 
		
	иначеЕсли Область.лево=1 тогда // месяц целиком
		ш =1;
	
		Для Сч=1 По 35 Цикл
			ОбластьПоиск=ПолеОтчета.Область(Область.Верх,сч+1,Область.Верх,сч+1);
			
			ДТ=ОбластьПоиск.Значение;
			
			Если ЗначениеЗаполнено(ДТ) тогда
				
				Если ДТ < ДокументыСервер.ДатаПереходаНаНовыйКалендарьЦен() Тогда
					Возврат;
				КонецЕсли;
			
				ПоискЗНЧ=СписВыбранных.НайтиПоЗначению(ДТ);
				Если ПоискЗНЧ=Неопределено тогда
					СписВыбранных.Добавить(ДТ);
					
					ПолеОтчета.Область(ОбластьПоиск.Верх,ОбластьПоиск.Лево,ОбластьПоиск.Верх + 3,ОбластьПоиск.Лево).ЦветФона=Новый Цвет(102, 144, 198);
				иначе
					СписВыбранных.Удалить(ПоискЗНЧ);
					
					УстановитьЦветЯчеекВыбор(ДТ, ОбластьПоиск);
				конецесли;	
			КонецЕсли;
		КонецЦикла; 
	иначе
		
		Если ЭтоСтрокаДата(Область.верх, Сдвиг) тогда
			ДТ=Область.Значение;
			
			Если ЗначениеЗаполнено(ДТ) тогда
				Если ДТ < ДокументыСервер.ДатаПереходаНаНовыйКалендарьЦен() Тогда
					Возврат;
				КонецЕсли;	
				
				ПоискЗНЧ=СписВыбранных.НайтиПоЗначению(ДТ);
				Если ПоискЗНЧ=Неопределено тогда
					СписВыбранных.Добавить(ДТ);
					
					ПолеОтчета.Область(Область.Верх,Область.Лево,Область.Верх + 3,Область.Лево).ЦветФона=Новый Цвет(102, 144, 198);
				иначе
					СписВыбранных.Удалить(ПоискЗНЧ);

					УстановитьЦветЯчеекВыбор(ДТ, Область);
				конецесли;	
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
Исключение
	
КонецПопытки; 
