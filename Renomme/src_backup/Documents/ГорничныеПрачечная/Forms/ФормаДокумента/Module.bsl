
&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
ТолькоПросмотр = РаботаСИнтерфейсомСервер.ПользовательТолькоПросмотр();
ЭтаФорма.ТолькоПросмотр = ТолькоПросмотр; 
	
ПроцентОтеля = 10;	
Если НЕ ЗначениеЗаполнено(Объект.Ссылка) Тогда
	Объект.ПроцентОтеля = ПроцентОтеля;
КонецЕсли;

ТекущаяОрганизация = НастройкиСервер.ПолучитьТекущуюОрганизацию();
СтавкаНДСОрганизация = ТекущаяОрганизация.СтавкаНДС; 
//СтавкаНДС = ДокументыСервер.СтавкаНДСТекущая(СтавкаНДС); 
//СтавкаНДСЧисло = ДокументыСервер.СтавкаНДСЧисло(СтавкаНДС);

ПриЧтенииНаСервере(Объект);
КонецПроцедуры

&НаКлиенте
Процедура ПроцентОтеляПриИзменении(Элемент)
Для Каждого Строка Из Объект.Прачечная Цикл
	ОбновитьСуммаПрачечная(Строка);
КонецЦикла;
КонецПроцедуры

&НаКлиенте
Процедура ПрачечнаяПередОкончаниемРедактирования(Элемент, НоваяСтрока, ОтменаРедактирования, Отказ)
ТД = Элемент.ТекущиеДанные;

Если ОтменаРедактирования Тогда 
	ТД.ДатаУслуги = ДатаУслуги_OldValue;
	ТД.Горничная = Горничная_OldValue;

	Возврат; 
КонецЕсли;

Если НЕ ЗначениеЗаполнено(ТД.ДатаУслуги) Тогда
	ЭтаФорма.ТекущийЭлемент = Элементы.ПрачечнаяДатаУслуги;
	Отказ = Истина;
КонецЕсли;

Если НЕ ЗначениеЗаполнено(ТД.Горничная) Тогда
	ЭтаФорма.ТекущийЭлемент = Элементы.ПрачечнаяГорничная;
	Отказ = Истина;
КонецЕсли;

ТС = Элемент.ТекущаяСтрока;
ОбновитьСуммаПрачечнаяНаСервере(ТС);
КонецПроцедуры

&НаСервере
Процедура ОбновитьСуммаПрачечнаяНаСервере(ТС)
ТД = Объект.Прачечная.НайтиПоИдентификатору(ТС);	
ОбновитьСуммаПрачечная(ТД);
КонецПроцедуры

&НаСервере
Процедура ОбновитьСуммаПрачечная(ТД) 
//ТекущаяОрганизация = НастройкиСервер.ПолучитьТекущуюОрганизацию();
//СтавкаНДС = ТекущаяОрганизация.СтавкаНДС; 
СтавкаНДС = ДокументыСервер.СтавкаНДСТекущая(СтавкаНДСОрганизация, ТД.ДатаУслуги); 
СтавкаНДСЧисло = ДокументыСервер.СтавкаНДСЧисло(СтавкаНДС);
	
ТД.СуммаНДС = Окр(ТД.СуммаОплаты * СтавкаНДСЧисло / (100 + СтавкаНДСЧисло));
ТД.СуммаБезНДС = ТД.СуммаОплаты - ТД.СуммаНДС;

ТД.СуммаОтелю = Окр(ТД.СуммаБезНДС * Объект.ПроцентОтеля / 100);

ТД.СуммаПрачечная = Окр(ТД.СуммаБезНДС * (1 - Объект.ПроцентОтеля / 100));
КонецПроцедуры

&НаКлиенте
Процедура ПрачечнаяПриАктивизацииСтроки(Элемент)
ТД = Элемент.ТекущиеДанные;
Если ТД = Неопределено Тогда 
	ДатаУслуги_OldValue = Неопределено;
	Горничная_OldValue = Неопределено;
Иначе	
	ДатаУслуги_OldValue = ТД.ДатаУслуги;
	Горничная_OldValue = ТД.Горничная;
КонецЕсли;
КонецПроцедуры

&НаСервере
Процедура ПриЧтенииНаСервере(ТекущийОбъект)
Для Каждого Строка Из Объект.Прачечная Цикл
	ОбновитьСуммаПрачечная(Строка);	
КонецЦикла;	
КонецПроцедуры

&НаСервере
Процедура ПослеЗаписиНаСервере(ТекущийОбъект, ПараметрыЗаписи)
Для Каждого Строка Из Объект.Прачечная Цикл
	ОбновитьСуммаПрачечная(Строка);	
КонецЦикла;	
КонецПроцедуры


