//
Функция ТЗ_ПроживаниеЗаявки(Заявки) Экспорт 
	Запрос = Новый Запрос("ВЫБРАТЬ
	                      |	ЗаявкаНаБронированиеПроживание.Ссылка КАК Заявка,
	                      |	ЗаявкаНаБронированиеПроживание.ГУИД КАК ГУИД,
	                      |	ЗаявкаНаБронированиеПроживание.ДеньПроживания КАК ДеньПроживания,
	                      |	ЗаявкаНаБронированиеПроживание.Тариф КАК Тариф,
	                      |	ЗаявкаНаБронированиеПроживание.Сумма КАК Сумма,
	                      |	ЗаявкаНаБронированиеПроживание.СуммаБезСкидки КАК СуммаБезСкидки,
	                      |	ЗаявкаНаБронированиеПроживание.ПроцентСкидкиКлиента КАК ПроцентСкидкиКлиента,
	                      |	ЗаявкаНаБронированиеПроживание.Цена КАК Цена,
	                      |	ЗаявкаНаБронированиеПроживание.Количество КАК Количество,
	                      |	ЕСТЬNULL(Счет.ГрупповойСчет, ЗНАЧЕНИЕ(Документ.ГрупповыеСчета.ПустаяСсылка)) <> ЗНАЧЕНИЕ(Документ.ГрупповыеСчета.ПустаяСсылка) КАК ЭтоГрупповойСчет,
	                      |	ЕСТЬNULL(Счет.ЭтоПредварительныйГрупповойСчет, ЛОЖЬ) КАК ЭтоПредварительныйГрупповойСчет,
	                      |	ЕСТЬNULL(Счет.СвернутьВСчете, ЛОЖЬ) КАК СвернутьВСчете
	                      |ИЗ
	                      |	Документ.ЗаявкаНаБронирование.Проживание КАК ЗаявкаНаБронированиеПроживание
	                      |		ЛЕВОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
	                      |			ЗаявкаНаБронированиеСчетаДетальноДолги.Ссылка КАК Ссылка,
	                      |			ЗаявкаНаБронированиеСчетаДетальноДолги.ДолгиГУИД КАК ДолгиГУИД,
	                      |			ЗаявкаНаБронированиеСчета.ГрупповойСчет КАК ГрупповойСчет,
	                      |			ЗаявкаНаБронированиеСчета.ЭтоПредварительныйГрупповойСчет КАК ЭтоПредварительныйГрупповойСчет,
	                      |			ЗаявкаНаБронированиеСчета.СвернутьВСчете КАК СвернутьВСчете
	                      |		ИЗ
	                      |			Документ.ЗаявкаНаБронирование.СчетаДетальноДолги КАК ЗаявкаНаБронированиеСчетаДетальноДолги
	                      |				ЛЕВОЕ СОЕДИНЕНИЕ Документ.ЗаявкаНаБронирование.Счета КАК ЗаявкаНаБронированиеСчета
	                      |				ПО ЗаявкаНаБронированиеСчетаДетальноДолги.Ссылка = ЗаявкаНаБронированиеСчета.Ссылка
	                      |					И ЗаявкаНаБронированиеСчетаДетальноДолги.СчетГУИД = ЗаявкаНаБронированиеСчета.СчетГУИД) КАК Счет
	                      |		ПО ЗаявкаНаБронированиеПроживание.Ссылка = Счет.Ссылка
	                      |			И ЗаявкаНаБронированиеПроживание.ГУИД = Счет.ДолгиГУИД
	                      |ГДЕ
	                      |	ЗаявкаНаБронированиеПроживание.Ссылка В(&Заявки)");
	
	Запрос.УстановитьПараметр("Заявки", Заявки);
	ТЗ_Проживание = Запрос.Выполнить().Выгрузить(); 
