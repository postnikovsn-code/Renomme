	Область.Параметры.КоличествоСмен = Строка.КоличествоСмен_Э;      
	Область.Параметры.КоличествоЧасов = Строка.КоличествоЧасов_Э;      
	
	ТабДок.Вывести(Область);
	
	////
	//Для Каждого СтрокаПомещение Из ПомещенияСправочник Цикл
