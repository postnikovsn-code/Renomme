Функция ОплатилНаименование_ПеренесеноВОтчтетыСервер(Строка)
Если Строка.ТипОплаты = 0 Тогда	
	Возврат "Гость смеш.";
ИначеЕсли Строка.ТипОплаты = 1 Тогда	
	Возврат "Гость к/к";
ИначеЕсли Строка.ТипОплаты = 2 Тогда	
	Возврат "Гость нал";
ИначеЕсли Строка.ТипОплаты = 3 Тогда	
	//Возврат "б/н";
	//Возврат "" + Строка.КонтрагентНаименование + " б/н";
	Если ТипЗнч(Строка.ДокументОплаты) = Тип("УникальныйИдентификатор") Тогда
		Возврат "" + Строка.КонтрагентНаименование + " б/н";
	Иначе		
		Возврат "" + Строка.ДокументОплаты.ОтКого + " б/н";
	КонецЕсли;		
ИначеЕсли Строка.ТипОплаты = 4 Тогда	
	Возврат "Гость п/к";
ИначеЕсли Строка.ТипОплаты = 5 Тогда	
	Возврат "Гость сбп";
ИначеЕсли Строка.ТипОплаты = 9 Тогда	
	Возврат "" + Строка.ДокументОплаты.ОтКого + " в/з";
КонецЕсли;

Возврат "";	
КонецФункции
 
Функция ТЗ_УслугиРодитель()
Запрос = Новый Запрос("ВЫБРАТЬ
                      |	ДопУслуги.Ссылка КАК Папка,
                      |	ДопУслуги.НомерПП КАК НомерПП,
                      |	ДопУслуги.ЗаголовокОтчеты КАК ЗаголовокОтчеты
                      |ИЗ
                      |	Справочник.ДопУслуги КАК ДопУслуги
                      |ГДЕ
                      |	ДопУслуги.ПометкаУдаления = ЛОЖЬ
                      |	И ДопУслуги.ЭтоГруппа = ИСТИНА
                      |	И ДопУслуги.Родитель = ЗНАЧЕНИЕ(Справочник.ДопУслуги.ПустаяСсылка)
                      |
                      |УПОРЯДОЧИТЬ ПО
                      |	НомерПП");

ТЗ_УслугиРодитель = Запрос.Выполнить().Выгрузить();
ТЗ_УслугиРодитель.Сортировать("НомерПП");

НоваяСтрока = ТЗ_УслугиРодитель.Добавить();
НоваяСтрока.Папка = Справочники.ДопУслуги.ПустаяСсылка();	

Возврат ТЗ_УслугиРодитель;
КонецФункции

Функция ПроживаниеЗаявка(Заявка) 
Запрос = Новый Запрос("ВЫБРАТЬ
                      |	ЗаявкаНаБронированиеПроживание.Ссылка КАК Ссылка,
                      |	СУММА(ЗаявкаНаБронированиеПроживание.СуммаБезСкидки) КАК СуммаБезСкидки,
                      |	СУММА(ЗаявкаНаБронированиеПроживание.Сумма) КАК Сумма,
                      |	СРЕДНЕЕ(ЗаявкаНаБронированиеПроживание.Цена) КАК Цена,
                      |	СУММА(ЗаявкаНаБронированиеПроживание.Количество) КАК Количество
                      |ИЗ
                      |	Документ.ЗаявкаНаБронирование.Проживание КАК ЗаявкаНаБронированиеПроживание
                      |ГДЕ
                      |	ЗаявкаНаБронированиеПроживание.Ссылка = &Заявка
                      |
                      |СГРУППИРОВАТЬ ПО
                      |	ЗаявкаНаБронированиеПроживание.Ссылка");

Запрос.УстановитьПараметр("Заявка", Заявка);

ТЗ = Запрос.Выполнить().Выгрузить();
Для Каждого Строка Из ТЗ Цикл
	Строка.Цена = Окр(Строка.Цена);	
КонецЦикла;

Возврат ТЗ;
КонецФункции

Функция Список_ОплатыКоворкинг(ТипДокумента)
Список_ОплатыКоворкинг = Новый СписокЗначений;
	
Если ТипДокумента = "КД" Тогда	
	Запрос = Новый Запрос("ВЫБРАТЬ
	                      |	КассовыйДокументДолгиОплата.Ссылка КАК Ссылка
	                      |ИЗ
	                      |	Документ.КассовыйДокумент.ДолгиОплата КАК КассовыйДокументДолгиОплата
	                      |ГДЕ
	                      |	ТИПЗНАЧЕНИЯ(КассовыйДокументДолгиОплата.ДокументДолг) = ТИП(Документ.КоворкингСчета)
	                      |	И КассовыйДокументДолгиОплата.Ссылка.ПометкаУдаления = ЛОЖЬ
	                      |
	                      |СГРУППИРОВАТЬ ПО
	                      |	КассовыйДокументДолгиОплата.Ссылка");
	
ИначеЕсли ТипДокумента = "ВБ" Тогда	
	Запрос = Новый Запрос("ВЫБРАТЬ
	                      |	ВыпискаБанкаДолгиОплата.Ссылка КАК Ссылка
	                      |ИЗ
	                      |	Документ.ВыпискаБанка.ДолгиОплата КАК ВыпискаБанкаДолгиОплата
	                      |ГДЕ
	                      |	ТИПЗНАЧЕНИЯ(ВыпискаБанкаДолгиОплата.ДокументДолг) = ТИП(Документ.КоворкингСчета)
	                      |	И ВыпискаБанкаДолгиОплата.Ссылка.ПометкаУдаления = ЛОЖЬ
	                      |
	                      |СГРУППИРОВАТЬ ПО
	                      |	ВыпискаБанкаДолгиОплата.Ссылка");
	
Иначе
	Возврат Список_ОплатыКоворкинг;
КонецЕсли;

ТЗ = Запрос.Выполнить().Выгрузить();
Для Каждого Строка Из ТЗ Цикл
	Список_ОплатыКоворкинг.Добавить(Строка.Ссылка);
КонецЦикла;

Возврат Список_ОплатыКоворкинг;
КонецФункции

Функция Список_ПлатежиКонтрагенту(ТипДокумента)
