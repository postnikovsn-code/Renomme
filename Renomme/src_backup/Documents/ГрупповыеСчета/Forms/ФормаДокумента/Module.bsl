&НаСервере
Функция СуммаКОплате()
Запрос = Новый Запрос("ВЫБРАТЬ
                      |	СУММА(СчетаДетальноДолги.СуммаКЗакрытию) КАК СуммаКЗакрытию
                      |ИЗ
                      |	Документ.ЗаявкаНаБронирование.Счета КАК ЗаявкаНаБронированиеСчета
                      |		ВНУТРЕННЕЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
                      |			ЗаявкаНаБронированиеСчетаДетальноДолги.Ссылка КАК Ссылка,
                      |			ЗаявкаНаБронированиеСчетаДетальноДолги.СчетГУИД КАК СчетГУИД,
                      |			СУММА(ЗаявкаНаБронированиеСчетаДетальноДолги.СуммаКЗакрытию) КАК СуммаКЗакрытию
                      |		ИЗ
                      |			Документ.ЗаявкаНаБронирование.СчетаДетальноДолги КАК ЗаявкаНаБронированиеСчетаДетальноДолги
                      |		
                      |		СГРУППИРОВАТЬ ПО
                      |			ЗаявкаНаБронированиеСчетаДетальноДолги.Ссылка,
                      |			ЗаявкаНаБронированиеСчетаДетальноДолги.СчетГУИД) КАК СчетаДетальноДолги
                      |		ПО ЗаявкаНаБронированиеСчета.Ссылка = СчетаДетальноДолги.Ссылка
                      |			И ЗаявкаНаБронированиеСчета.СчетГУИД = СчетаДетальноДолги.СчетГУИД
                      |ГДЕ
                      |	ЗаявкаНаБронированиеСчета.ГрупповойСчет = &ГрупповойСчет");	

Запрос.УстановитьПараметр("ГрупповойСчет", Объект.Ссылка);

ТЗ = Запрос.Выполнить().Выгрузить();
Если ТЗ.Количество() = 0 Тогда
	Возврат 0;
Иначе
	Возврат ТЗ[0].СуммаКЗакрытию;
КонецЕсли;
КонецФункции	

