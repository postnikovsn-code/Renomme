&НаСервере
Функция СформироватьАнкету()
//	Макет=ПолучитьМакет("Макет");
	
	ОбъектМакет = РеквизитФормыВЗначение("Объект");
	Макет = ОбъектМакет.ПолучитьМакет("Макет");
	
	ТабДок = Новый ТабличныйДокумент;
	Обл = Макет.ПолучитьОбласть("Шапка");
	Обл.Параметры.Клиент = Объект.Клиент;
	Обл.Параметры.Номер = Объект.Бронь.НомерВРезерв;
	Обл.Параметры.Город = Объект.Клиент.ПроживаниеГород;
	Обл.Параметры.Дата = Формат(Объект.Дата, "ДФ=dd.MM.yy");
	ТабДок.Вывести(Обл);
	
	Для каждого СтрЦ Из Объект.ЦелиВизита Цикл
		Если СтрЦ.Подходит тогда
			Обл=макет.ПолучитьОбласть("СтрокаЦельДа");
		иначе
			Обл=макет.ПолучитьОбласть("СтрокаЦельНет");
		конецесли;
		Обл.Параметры.цель=СтрЦ.Цель.Наименование;
		
		ТабДок.Вывести(Обл);
	КонецЦикла; 
	
	Обл=Макет.ПолучитьОбласть("ДругаяЦель");
	Обл.Параметры.ДругаяЦель = Объект.ДругаяЦель;
	ТабДок.Вывести(Обл);
		
	Обл=Макет.ПолучитьОбласть("ШапкаВопросы");
	ТабДок.Вывести(Обл);
	Для каждого Стр Из Объект.Вопросы Цикл
	
		Обл=Макет.ПолучитьОбласть("СтрокаВопрос");
		Обл.Параметры.Вопрос=Стр.Вопрос;
		Обл.Параметры.Отл=?(Стр.Отлично,"*","");
		Обл.Параметры.Хор=?(Стр.Хорошо,"*","");
		Обл.Параметры.Уд=?(Стр.Удовлетворительно,"*","");
		Обл.Параметры.Пл=?(Стр.Плохо,"*","");
		ТабДок.Вывести(Обл);
		
	КонецЦикла; 
	
	Обл=Макет.ПолучитьОбласть("ШапкаХар");
	Обл.Параметры.Понравилось=Объект.Понравилось;
	Обл.Параметры.НеПонравилось=Объект.НеПонравилось;
	ТабДок.Вывести(Обл);
	
	Для каждого СтрХ Из Объект.ХарактеристикиОтеля Цикл
	     Обл=Макет.ПолучитьОбласть("СтрокаХар");
		 Обл.Параметры.Характеристика=СтрХ.Характеристика;//	 
		 Обл.Параметры.ДаНет=СтрХ.Подходит;//	 
		 ТабДок.Вывести(Обл);
	 КонецЦикла; 
	 
     Обл=Макет.ПолучитьОбласть("СтрокаХар");
	 Обл.Параметры.Характеристика="Желаете получить скидку?";
	 Обл.Параметры.ДаНет=Формат(Объект.ЖелаетеПолучитьСкидку, "БЛ=Нет; БИ=Да");
	 ТабДок.Вывести(Обл);
     Обл=Макет.ПолучитьОбласть("СтрокаХар");
	 Обл.Параметры.Характеристика="Контактная информация";
	 Обл.Параметры.ДаНет= Объект.КонтактнаяИнформация;
	 ТабДок.Вывести(Обл);

	Возврат ТабДок;
КонецФункции
//








