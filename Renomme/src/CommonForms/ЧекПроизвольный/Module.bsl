&НаСервере
Функция ПолучитьПараметрыЧекаЗапрос(ДокументДолг, СуммаОперации) 

Запрос = Новый Запрос("ВЫБРАТЬ
                      |	ОперацииЭТ.СсылочныйНомер КАК СсылочныйНомер,
                      |	ОперацииЭТ.СуммаОперации КАК СуммаОперации,
                      |	ЕСТЬNULL(Возвраты.СуммаВозврата, 0) КАК СуммаВозврата
                      |ИЗ
                      |	РегистрСведений.ОперацииЭТ КАК ОперацииЭТ
                      |		ЛЕВОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
                      |			ОперацииЭТ.СсылочныйНомерВозврат КАК СсылочныйНомерВозврат,
                      |			СУММА(ОперацииЭТ.СуммаОперации) КАК СуммаВозврата
                      |		ИЗ
                      |			РегистрСведений.ОперацииЭТ КАК ОперацииЭТ
                      |		
                      |		СГРУППИРОВАТЬ ПО
                      |			ОперацииЭТ.СсылочныйНомерВозврат) КАК Возвраты
                      |		ПО ОперацииЭТ.СсылочныйНомер = Возвраты.СсылочныйНомерВозврат
                      |ГДЕ
                      |	ОперацииЭТ.ТипТранзакции = ""AuthorizeSales""
                      |	И ОперацииЭТ.ДокументДолг = &ДокументДолг
                      |	И ОперацииЭТ.СуммаОперации = &СуммаОперации");

Запрос.УстановитьПараметр("ДокументДолг", ДокументДолг);
Запрос.УстановитьПараметр("СуммаОперации", СуммаОперации);

ТЗ = Запрос.Выполнить().Выгрузить();
Если ТЗ.Количество() = 0 Тогда
	Возврат "-";
ИначеЕсли ТЗ.Количество() > 1 Тогда
	Возврат "+";
Иначе
	СсылочныйНомер = ТЗ[0].СсылочныйНомер;
	Остаток = ТЗ[0].СуммаОперации - ТЗ[0].СуммаВозврата; 
	Результат = Новый Структура("СсылочныйНомер, Остаток", СсылочныйНомер, Остаток); 
	
	Возврат Результат; 
КонецЕсли;
КонецФункции

&НаКлиенте
Процедура ОплатитьКартаВыполнить()
Оповещение = Новый ОписаниеОповещения("ЗавершениеВопроса_БудетПроизведенаОплата", ЭтаФорма);
ПоказатьВопрос(Оповещение, "Будет произведена оплата через эквайринговый терминал на сумму:" + СуммаКарта + "
	|
	|ПРОДОЛЖИТЬ ?"
	, РежимДиалогаВопрос.ОКОтмена); 
КонецПроцедуры

&НаКлиенте
Процедура ЗавершениеВопроса_БудетПроизведенаОплата(Результат, ДополнитерльныеПараметры) Экспорт
Если Результат = КодВозвратаДиалога.Отмена Тогда Возврат; КонецЕсли;

ОплатитьКартаДействие(СуммаКарта);
КонецПроцедуры

&НаКлиенте
Процедура ОплатитьКартаДействие(СуммаОперации) 
ФормаУникальныйИдентификатор = ЭтаФорма.УникальныйИдентификатор;

ЭтаФорма.Доступность = Ложь;

ПараметрыОперации = ОборудованиеПлатежныеСистемыКлиентСервер.ПараметрыВыполненияЭквайринговойОперации();
//ПараметрыОперации.ТипТранзакции  = Параметры.ТипТранзакции;
//ПараметрыОперации.СуммаОперации  = Результат.Сумма;
ТипТранзакции = "AuthorizeSales";
ПараметрыОперации.ТипТранзакции  = ТипТранзакции;
ПараметрыОперации.СуммаОперации  = СуммаОперации;

//ПараметрыОперации.НомерЧека      = ?(Результат.Свойство("НомерЧека")  , Результат.НомерЧека, "");
//ПараметрыОперации.НомерЧекаЭТ    = ?(Результат.Свойство("НомерЧекаЭТ"), Результат.НомерЧекаЭТ, "");

//ПараметрыОперации.СсылочныйНомер = Результат.СсылочныйНомер;
СсылочныйНомер = "";
ПараметрыОперации.СсылочныйНомер = СсылочныйНомер;

ДанныеОперации = Новый Структура();
ДанныеОперации.Вставить("ТипТранзакции", ТипТранзакции);
//ДанныеОперации.Вставить("ДанныеКарты", ?(Результат.Свойство("ДанныеКарты")  , Результат.ДанныеКарты, ""));
//ДанныеОперации.Вставить("ТипКарты", ?(Результат.Свойство("ТипКарты")  , Результат.ТипКарты, 0));
//ДанныеОперации.Вставить("НомерЧека", ?(Результат.Свойство("НомерЧека")  , Результат.НомерЧека, ""));

ДанныеОперации.Вставить("СсылочныйНомерВозврат", СсылочныйНомер);

ДанныеОперации.Вставить("ДокументДолг", ДокументДолг);

ДанныеОперации.Вставить("ЭтоКоворкинг", ЭтоКоворкинг);

//ДанныеОперации.Вставить("ФормаУникальныйИдентификатор",  Параметры.ФормаУникальныйИдентификатор);
//ДанныеОперации.Вставить("ФормаУникальныйИдентификатор",  ФормаУникальныйИдентификатор);

//ИмяОповещенияОЗавершении = Параметры.ИмяОповещенияОЗавершении;
Оповещение = Новый ОписаниеОповещения("ОплатитьКартаДействие_Завершение", ЭтотОбъект, ДанныеОперации);
ОборудованиеПлатежныеСистемыКлиент.НачатьВыполнениеОперацииНаЭквайринговомТерминале(Оповещение
	, ФормаУникальныйИдентификатор, Неопределено, ПараметрыОперации);
КонецПроцедуры

&НаКлиенте
Процедура ОплатитьКартаДействие_Завершение(РезультатВыполнения, ДополнительныеПараметры) Экспорт
//ФормаУникальныйИдентификатор = Параметры.ФормаУникальныйИдентификатор;

ЭтаФорма.Доступность = Истина;

Если РезультатВыполнения.Результат Тогда
	ТекстСообщения = "Эквайринговая Операция выполнена успешно." + Символы.ПС;
	ТекстПредупреждения = ТекстСообщения + Символы.ПС;
	
	ТипТранзакции = ДополнительныеПараметры.ТипТранзакции; 
	
	ГУИД_ЭТ = Неопределено;
	Если ТипТранзакции = "AuthorizeSales" 
	//ИЛИ  ТипТранзакции = "AuthorizeRefund" 
	//ИЛИ  ТипТранзакции = "AuthorizeVoid" 
	Тогда
		ГУИД_ЭТ = ЭТСервер.ЗаписатьОперацию(РезультатВыполнения, ДополнительныеПараметры);
	КонецЕсли;
	
	ВывестиЧек();	
Иначе
	ТекстПредупреждения = "Ошибка эквайрингого терминала";
	ТекстСообщения = "Ошибка эквайрингового терминала: " + РезультатВыполнения.ОписаниеОшибки;
	
	ОшибкаОперации = Истина;
	ОшибкаЭТ = Истина;
	
	ЗавершитьОтбитиеЧека();
КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ЭтоКоворкингПриИзменении(Элемент)
Если ЭтоКоворкинг Тогда
	ЭтаФорма.Заголовок = "КОВОРКИНГ";	
Иначе
	ЭтаФорма.Заголовок = "ОТЕЛЬ";	
КонецЕсли;

СтавкаНДС = ДокументыСервер.СтавкаНДС(ЭтоКоворкинг); СтавкаНДС = ДокументыСервер.СтавкаНДСТекущая(СтавкаНДС, ДатаОплаты);
КонецПроцедуры

&НаКлиенте
Процедура ТаблицаПозицииЧекаПриНачалеРедактирования(Элемент, НоваяСтрока, Копирование)
ТД = Элемент.ТекущиеДанные;	
Если НоваяСтрока Тогда
	ТД.СтавкаНДС = СтавкаНДС;		
КонецЕсли;		
КонецПроцедуры

&НаКлиенте
Процедура ТаблицаПозицииЧекаКоличествоПриИзменении(Элемент)
ТД = Элементы.ТаблицаПозицииЧека.ТекущиеДанные;
ТД.Сумма = ТД.Количество * ТД.Цена;
КонецПроцедуры

&НаКлиенте
Процедура ТаблицаПозицииЧекаЦенаПриИзменении(Элемент)
ТД = Элементы.ТаблицаПозицииЧека.ТекущиеДанные;
ТД.Сумма = ТД.Количество * ТД.Цена;
КонецПроцедуры

