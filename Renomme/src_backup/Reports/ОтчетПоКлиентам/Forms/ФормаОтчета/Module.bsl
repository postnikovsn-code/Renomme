		ТабДок.Область(2,Об.КолонкаС+1,2,Об.КолонкаС+1).Текст=Об.ДТ;
		
		ТабДок.Область(2,Об.КолонкаС+1,2,Об.КолонкаПо+1).Объединить();
		
