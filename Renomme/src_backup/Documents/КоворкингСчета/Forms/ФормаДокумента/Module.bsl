&НаСервере
Функция СписокЗначенийКонтрагенты()
ТЗ = Новый ТаблицаЗначений;	
ТЗ.Колонки.Добавить("Контрагент");

Для Каждого Строка Из Объект.ДокументыОплаты Цикл
	НоваяСтрока = ТЗ.Добавить();
	НоваяСтрока.Контрагент = Строка.ДокументОплаты.ОтКого;
КонецЦикла;	

НоваяСтрока = ТЗ.Добавить();
НоваяСтрока.Контрагент = Объект.КоворкингЗаявка.Клиент;

Если ЗначениеЗаполнено(Объект.ОплачиваетСчет) Тогда
	НоваяСтрока = ТЗ.Добавить();
	НоваяСтрока.Контрагент = Объект.ОплачиваетСчет;
КонецЕсли;

ТЗ.Свернуть("Контрагент");

СписокКонтрагентов = Новый СписокЗначений;
Для Каждого Строка Из ТЗ Цикл
	СписокКонтрагентов.Добавить(Строка.Контрагент);	
КонецЦикла;

Возврат СписокКонтрагентов;
КонецФункции

