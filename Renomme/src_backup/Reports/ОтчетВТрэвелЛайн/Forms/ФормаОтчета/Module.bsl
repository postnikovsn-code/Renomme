&НаКлиенте
Процедура ВыгрузитьВEXELДействие(ПолноеИмяФайла)
ПолноеИмяФайла = ВыборФайла();
Если НЕ ЗначениеЗаполнено(ПолноеИмяФайла) Тогда Возврат; КонецЕсли;

ТекстСообщения = "Формирование файла EXEL
			|
			|ПОДОЖДИТЕ ...";	
ПараметрыФормы = Новый Структура("ТекстСообщения", ТекстСообщения);
Форма = ОткрытьФорму("ОбщаяФорма.СообщениеОперация", ПараметрыФормы,ЭтаФорма
	,,,,, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	
ТабДок = ОтчетВТревелЛайнНаСервере(); 	

Ячейка = ТабДок.Область(1,1,1,1);
Если НЕ ЗначениеЗаполнено(Ячейка.Текст) Тогда Возврат; КонецЕсли;

Excel = Новый COMОбъект("Excel.Application"); //подключение к Excel
Книга = Excel.WorkBooks.Add();  //добавление книги
Лист = Книга.Worksheets.add(); //добавление листа
Лист.Name = "Отчет"; //имя листа (без проблелов)
Excel.displayAlerts = 0; //отключить модальное окно Excel на перезапись файла

Excel.Visible = Ложь;

ВсегоСтрок = ТабДок.ВысотаТаблицы;
ВсегоКолонок = ТабДок.ШиринаТаблицы;

НачальнаяСтрока = 4;

Колонка = 1;
Пока Колонка <= ВсегоКолонок Цикл 		
	ЯчейкаОтчета = ТабДок.Область(1, Колонка, 1, Колонка);
	
	СтрокаEXEL = НачальнаяСтрока;
	ЯчейкаEXEL =  Лист.Cells(СтрокаEXEL, Колонка);	
	
	Value = ЯчейкаОтчета.Текст;
	Value = СтрЗаменить(Value, Символы.ПС, " ");
	
	ЯчейкаEXEL.Value = Value;
	
	Колонка = Колонка + 1;
КонецЦикла;

Строка = 2;
Пока Строка < ВсегоСтрок Цикл
	Колонка = 1;
	Пока Колонка <= ВсегоКолонок Цикл 		
		ЯчейкаОтчета = ТабДок.Область(Строка, Колонка, Строка, Колонка);
		
		СтрокаEXEL = НачальнаяСтрока + Строка - 1;
		ЯчейкаEXEL =  Лист.Cells(СтрокаEXEL, Колонка);	
		
		Если Колонка > 2 Тогда
			Value = ОбщийФункционалКлиентСервер.ПолучитьЧисло(ЯчейкаОтчета.Текст);
		Иначе	
			Value = ЯчейкаОтчета.Текст;
		КонецЕсли;
		ЯчейкаEXEL.Value = Value;
		
		Колонка = Колонка + 1;
	КонецЦикла;
	
	Строка = Строка + 1;	
КонецЦикла;

Попытка
	Книга.SaveAs(ПолноеИмяФайла); //сохранения файла
Исключение
	Сообщить("Нет доступа к файлу " + ПолноеИмяФайла);	
КонецПопытки;
Книга.Close(); //закрытие книги
Excel.Quit(); //закрытие COM

Форма.Закрыть();
КонецПроцедуры

