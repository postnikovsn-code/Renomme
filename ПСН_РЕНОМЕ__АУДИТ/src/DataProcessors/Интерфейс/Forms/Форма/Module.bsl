&НаКлиенте
Асинх Процедура ЗаполнитьДанныеОрганизацияСДанныхКоворкинг(Команда)
Если НЕ НастройкиСервер.ЭтоСтритАрт() Тогда Возврат; КонецЕсли;
	
Если ТекущаяДата() < '20250101' Тогда 
	ПоказатьПредупреждение(, "НУЖНО ЗАПУСТИТЬ 01 января 2025 г.
			|
			|Перед запуском ЗАКРОЙТЕ кассовые смены");
	
	Сообщить("НУЖНО ЗАПУСТИТЬ 01 января 2025 г.
			|Перед запуском ЗАКРОЙТЕ кассовые смены");
	
	Возврат;
КонецЕсли;

Текст = ДокументыСервер.ПроверитьВозможностьЗаполненияДанныеОрганизацияСДанныхКоворкинг();
Если Текст <> "" Тогда
	ПоказатьПредупреждение(, Текст);
	Сообщить(Текст);
	
	Возврат;
КонецЕсли;

Результат = Ждать ВопросАсинх("Подтвердите заполнение ... " 
	, РежимДиалогаВопрос.ОКОтмена,,КодВозвратаДиалога.Отмена); 		
	
Если Результат = КодВозвратаДиалога.Отмена Тогда Возврат; КонецЕсли;

ДокументыСервер.ЗаполнитьДанныеОрганизацияСДанныхКоворкинг();

Сообщить("Операция успешно завершена");
КонецПроцедуры

























