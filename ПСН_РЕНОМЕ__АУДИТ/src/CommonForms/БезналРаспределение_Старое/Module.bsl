//
&НаКлиенте
Процедура ВыпискаОплатыЗакрытьОткрыть(Команда)
ВыпискаОплатыЗакрытьОткрытьНаСервере();
КонецПроцедуры

&НаСервере
Процедура ВыпискаОплатыЗакрытьОткрытьНаСервере()
ТС = Элементы.ВыпискаОплаты.ТекущаяСтрока;
Если ТС = Неопределено Тогда Возврат; КонецЕсли;

ТД = ВыпискаОплаты.НайтиПоИдентификатору(ТС);

ДокументОплатыОбъект = ТД.ДокументОплаты.ПолучитьОбъект(); 
ДокументОплатыОбъект.Закрыт = НЕ ДокументОплатыОбъект.Закрыт;
ДокументОплатыОбъект.Записать(РежимЗаписиДокумента.Проведение);

ТД.Закрыт = ДокументОплатыОбъект.Закрыт;
КонецПроцедуры
//

//
&НаКлиенте
Процедура ВыпискаОплатыПриАктивизацииСтроки(Элемент)
Если Элемент.ТекущиеДанные = Неопределено Тогда	
	ВыпискаОплатыДокументОплаты_Текущий = Неопределено;
Иначе
	ВыпискаОплатыДокументОплаты_Текущий = Элемент.ТекущиеДанные.ДокументОплаты;
КонецЕсли;	
	
ТекущаяСтрока = Элемент.ТекущаяСтрока;
Если ТекущаяСтрока = Неопределено Тогда 
	ВыпискаОплатыТекущаяСтрока = -1; 
Иначе	
	ВыпискаОплатыТекущаяСтрока = ТекущаяСтрока; 
	
	Если Элемент.ТекущиеДанные.Контрагент <> ВыпискаКонтрагент_Предыдущий Тогда 	
		ВыпискаКонтрагент_Предыдущий = Элемент.ТекущиеДанные.Контрагент;
		ВстатьНаСтрокуСчета();
 	КонецЕсли;
КонецЕсли;

ОбновитьСчетаСвязи();
КонецПроцедуры

&НаКлиенте
Процедура ВыпискаОплатыПриАктивизацииСтроки_Вариант(Элемент)
ТекущаяСтрока = Элемент.ТекущаяСтрока;
Если ТекущаяСтрока = Неопределено Тогда 
	ВыпискаОплатыТекущаяСтрока = -1; 
Иначе	
	ВыпискаОплатыТекущаяСтрока = ТекущаяСтрока; 
	
	Если Элемент.ТекущиеДанные.Контрагент = ВыпискаКонтрагент_Предыдущий Тогда Возврат; КонецЕсли;
	
	ВыпискаКонтрагент_Предыдущий = Элемент.ТекущиеДанные.Контрагент;
	ВстатьНаСтрокуСчета();
КонецЕсли;

ОбновитьСчетаСвязи();
КонецПроцедуры

&НаКлиенте
Процедура ВыпискаОплатыВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
Если ВыбраннаяСтрока = Неопределено Тогда Возврат; КонецЕсли;

ТД = ВыпискаОплаты.НайтиПоИдентификатору(ВыбраннаяСтрока);

ОплатыОбщееКлиент.ОткрытьДокументОплаты(ЭтаФорма, ТД.ДокументОплаты, Истина, Неопределено);
КонецПроцедуры

&НаКлиенте
Процедура ВстатьНаСтрокуСчета()
ТекущиеДанныеВыпискаОплаты = Элементы.ВыпискаОплаты.ТекущиеДанные;
//Если ТекущиеДанныеВыпискаОплаты.ОстатокОплаты <> 0 Тогда 
	
	ОтборСтроки = Новый Структура("Контрагент", ТекущиеДанныеВыпискаОплаты.Контрагент);
	НайденныеСтрокиСчета = ВыпискаСчета.НайтиСтроки(ОтборСтроки);
	Если НайденныеСтрокиСчета.Количество() > 0 Тогда
		Для Каждого Строка Из НайденныеСтрокиСчета Цикл
			Если Строка.ОстатокКЗакрытию = 0 Тогда Продолжить; КонецЕсли;
			
			Элементы.ВыпискаСчета.ТекущаяСтрока = Строка.ПолучитьИдентификатор();
			Возврат;
		КонецЦикла;
	КонецЕсли;	
	
//КонецЕсли;

Элементы.ВыпискаСчета.ТекущаяСтрока = Неопределено;
КонецПроцедуры

