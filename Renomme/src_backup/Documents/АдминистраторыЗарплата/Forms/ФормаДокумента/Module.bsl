&НаСервере
Функция РеквизитыЗарплатаСмены(ДН, ДК)
Реквизиты	= Новый Массив;

Если НЕ (ЗначениеЗаполнено(ДН) И ЗначениеЗаполнено(ДК)) Тогда Возврат Реквизиты; КонецЕсли;

Дата_П = ДН;
Пока Дата_П <= ДК Цикл
	Дата_С = Формат(Дата_П, "ДФ=dd.MM.yy");
	Дата_И = СтрЗаменить(Дата_С, ".", "");
	
	Имя = "Дата_" + Дата_И;
	НовыйРеквизит = Новый РеквизитФормы(Имя, Новый ОписаниеТипов("Дата", ,,, Новый КвалификаторыДаты(ЧастиДаты.Дата))
		, "ЗарплатаСмены", Дата_С );
	Реквизиты.Добавить(НовыйРеквизит);		
		
	Имя = "Часы_" + Дата_И;
	НовыйРеквизит = Новый РеквизитФормы(Имя, Новый ОписаниеТипов("Строка", , , , Новый КвалификаторыСтроки(7))
		, "ЗарплатаСмены", "Смена");
	Реквизиты.Добавить(НовыйРеквизит);		
	
	Имя = "НомерСмены_" + Дата_И;
	НовыйРеквизит = Новый РеквизитФормы(Имя, Новый ОписаниеТипов("Число", , ,Новый КвалификаторыЧисла(1, 0))
		, "ЗарплатаСмены", "Номер Смены");
	Реквизиты.Добавить(НовыйРеквизит);		
	
	Имя = "ДлинаСмены_" + Дата_И;
	НовыйРеквизит = Новый РеквизитФормы(Имя, Новый ОписаниеТипов("Число", , ,Новый КвалификаторыЧисла(2, 0))
		, "ЗарплатаСмены", "Длина Смены");
	Реквизиты.Добавить(НовыйРеквизит);		
	
	Имя = "ПереработкаЧасы_" + Дата_И;
	НовыйРеквизит = Новый РеквизитФормы(Имя, Новый ОписаниеТипов("Число", , ,Новый КвалификаторыЧисла(2, 0))
		, "ЗарплатаСмены", "Переработка");
	Реквизиты.Добавить(НовыйРеквизит);		
	
	Имя = "СуммаПереработка_" + Дата_И;
	НовыйРеквизит = Новый РеквизитФормы(Имя, Новый ОписаниеТипов("Число")
		, "ЗарплатаСмены", "Сумма Переработка");
	Реквизиты.Добавить(НовыйРеквизит);	
	
	Имя = "Оклад_" + Дата_И;
	НовыйРеквизит = Новый РеквизитФормы(Имя, Новый ОписаниеТипов("Число")
		, "ЗарплатаСмены", "Оклад");
	Реквизиты.Добавить(НовыйРеквизит);		
	
	Имя = "Оклад_" + Дата_И + "_Р";
	НовыйРеквизит = Новый РеквизитФормы(Имя, Новый ОписаниеТипов("Число")
		, "ЗарплатаСмены", "Оклад");
	Реквизиты.Добавить(НовыйРеквизит);	
	
	Имя = "Оклад_" + Дата_И + "_Есть";
	НовыйРеквизит = Новый РеквизитФормы(Имя, Новый ОписаниеТипов("Булево")
		, "ЗарплатаСмены", "Оклад");
	Реквизиты.Добавить(НовыйРеквизит);	
	
	Имя = "Оклад_" + Дата_И + "_Э";
	НовыйРеквизит = Новый РеквизитФормы(Имя, Новый ОписаниеТипов("Число")
		, "ЗарплатаСмены", "Оклад");
	Реквизиты.Добавить(НовыйРеквизит);	
	
	Имя = "СуммаЗаПроживающих_" + Дата_И;
	НовыйРеквизит = Новый РеквизитФормы(Имя, Новый ОписаниеТипов("Число")
		, "ЗарплатаСмены", "Сумма За Проживающих");
