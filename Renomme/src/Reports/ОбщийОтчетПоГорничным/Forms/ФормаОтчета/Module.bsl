Процедура УстановитьСписокВыбораТехническаяНеисправность()
СписокВыбора = Элементы.ТехническаяНеисправность.СписокВыбора;
СписокВыбора.Очистить();
Запрос = Новый Запрос("ВЫБРАТЬ
                      |	ГорничныеОбслуживаниеНомераТехническиеНеисправности.ТехническаяНеисправность КАК ТехническаяНеисправность
                      |ИЗ
                      |	Документ.ГорничныеОбслуживаниеНомера.ТехническиеНеисправности КАК ГорничныеОбслуживаниеНомераТехническиеНеисправности
                      |ГДЕ
                      |	ГорничныеОбслуживаниеНомераТехническиеНеисправности.Ссылка.ПометкаУдаления = ЛОЖЬ
                      |	И ГорничныеОбслуживаниеНомераТехническиеНеисправности.Ссылка.ВремяУборки МЕЖДУ &ВремяУборкиНачало И &ВремяУборкиОкончание
                      |
                      |СГРУППИРОВАТЬ ПО
                      |	ГорничныеОбслуживаниеНомераТехническиеНеисправности.ТехническаяНеисправность
                      |
                      |УПОРЯДОЧИТЬ ПО
                      |	ТехническаяНеисправность");

Запрос.УстановитьПараметр("ВремяУборкиНачало", Отчет.ДатаС);
Запрос.УстановитьПараметр("ВремяУборкиОкончание", КонецДня(Отчет.ДатаПо));

Выборка = Запрос.Выполнить().Выбрать();

Пока Выборка.Следующий() Цикл
	 СписокВыбора.Добавить(Выборка.ТехническаяНеисправность);
КонецЦикла;
КонецПроцедуры

