Функция ПолучитьТЗЦен(ДатаЦеныНачалоГода, КатегорияНомера, БезЗавтрака, ПроцентСкидкиБезЗавтрака) Экспорт
ЗапросЦен=Новый Запрос("ВЫБРАТЬ
                       |	ЦеныПоДатам.ДатаЦены КАК ДатаЦены,
                       |	ЦеныПоДатам.Тариф_НеИспользуется КАК Тариф_НеИспользуется,
                       |	ЦеныПоДатам.ПроцентИзменения КАК ПроцентИзменения,
                       |	ЦеныПоДатам.Категория КАК КатегорияНомера,
                       |	ЦеныПоДатам.БезЗавтрака КАК БезЗавтрака,
                       |	ЦеныПоДатам.Двухместный КАК Двухместный
                       |ИЗ
                       |	РегистрСведений.ЦеныПоДатам КАК ЦеныПоДатам
                       |ГДЕ
                       |	НАЧАЛОПЕРИОДА(ЦеныПоДатам.ДатаЦены, ГОД) = &ДатаЦены
                       |	И ВЫБОР
                       |			КОГДА &Категория = ""ВСЕ""
                       |				ТОГДА ИСТИНА
                       |			ИНАЧЕ ЦеныПоДатам.Категория = &Категория
                       |		КОНЕЦ
                       |	И ВЫБОР
                       |			КОГДА &БезЗавтрака = ""ВСЕ""
                       |				ТОГДА ИСТИНА
                       |			ИНАЧЕ ЦеныПоДатам.БезЗавтрака = &БезЗавтрака
                       |		КОНЕЦ");
ЗапросЦен.УстановитьПараметр("ДатаЦены", ДатаЦеныНачалоГода);
ЗапросЦен.УстановитьПараметр("Категория", КатегорияНомера);

Если ПроцентСкидкиБезЗавтрака <> 0 И БезЗавтрака Тогда 
	БезЗавтрака_П = Ложь;
Иначе
	БезЗавтрака_П = БезЗавтрака;    
КонецЕсли;

ЗапросЦен.УстановитьПараметр("БезЗавтрака", БезЗавтрака_П);
ТЗ = ЗапросЦен.Выполнить().Выгрузить();

Возврат ТЗ;
КонецФункции

