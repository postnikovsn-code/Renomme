	ОбластьПараметры.Глубина_31_60 = Глубина_31_60;	          
	ОбластьПараметры.Глубина_60 = Глубина_60;	
	ОбластьПараметры.ПроживанияЗаездРаньше = ПроживанияЗаездРаньше;	
	
	ОбластьПараметры.Мероприятия = Мероприятия;	
	//ПрогнозЗагрузки	Глубина_0_1	Глубина_2_3	Глубина_4_7	Глубина_6_7	Глубина_8_14	Глубина_11_14	Глубина_15_30	Глубина_31_60	Глубина_60	ПроживанияЗаездРаньше	Меропрятия
	
	ТабДок.Вывести(Область);
	
	Дата_П = Дата_П + 24* 60 * 60;	 
КонецЦикла;

