//// + Копия Чека
Процедура ВыполнитьПечатьТекста(Форма, Текст) Экспорт
	
	ОчиститьСообщения();
	
	ПоддерживаемыеТипыВО = Новый Массив();
	//ПоддерживаемыеТипыВО.Добавить("ФискальныйРегистратор");
	//ПоддерживаемыеТипыВО.Добавить("ПринтерЧеков");
	ПоддерживаемыеТипыВО.Добавить("ККТ");
	
	ДополнительныеПараметры = Новый Структура;;
	ДополнительныеПараметры.Вставить("Форма", Форма); 
	//ДополнительныеПараметры.Вставить("ОповещениеЗавершение", ОповещениеЗавершение); 
	ДополнительныеПараметры.Вставить("Текст", Текст); 
	
	ОписаниеОповещения = Новый ОписаниеОповещения("ПечатьТекста", ЭтотОбъект, ДополнительныеПараметры); 
	МенеджерОборудованияКлиент.ВыбратьУстройство(ОписаниеОповещения, ПоддерживаемыеТипыВО,
		НСтр("ru='Выберите фискальное устройство'"), 
		НСтр("ru='Фискальное устройство не подключено.'"), 
		НСтр("ru='Фискальное устройство не выбрано.'"));

КонецПроцедуры

Процедура ПечатьТекста(Результат, ДополнительныеПараметры) Экспорт
	
	Форма = ДополнительныеПараметры.Форма;
    Форма.Доступность = Ложь; // При необходимости можно заблокировать интерфейс пользователя.
    
	//Текст = "ТЕКСТ ДЛЯ ПЕЧАТИ"; // Произвольный текст для печати в чеке
    Текст = ДополнительныеПараметры.Текст;; // Произвольный текст для печати в чеке
    ПараметрыОперации = ОборудованиеЧекопечатающиеУстройстваКлиентСервер.ПараметрыПечатиТеста(Текст);
    
    ОповещениеПриЗавершении = Новый ОписаниеОповещения("ПечатьТекстаЗавершение", ЭтотОбъект, ДополнительныеПараметры);
    ОборудованиеЧекопечатающиеУстройстваКлиент.НачатьПечатьТекста(
        ОповещениеПриЗавершении, Форма.УникальныйИдентификатор, Результат.ИдентификаторУстройства, ПараметрыОперации);
    
КонецПроцедуры

Процедура ПечатьТекстаЗавершение(РезультатВыполнения, ДополнительныеПараметры) Экспорт
    
	Форма = ДополнительныеПараметры.Форма;
    Форма.Доступность = Истина; // При необходимости разблокируем интерфейс пользователя.
    
    Если НЕ РезультатВыполнения.Результат Тогда
        ТекстСообщения = НСтр("ru = 'При выполнении операции произошла ошибка:""%ОписаниеОшибки%"".'");
        ТекстСообщения = СтрЗаменить(ТекстСообщения, "%ОписаниеОшибки%", РезультатВыполнения.ОписаниеОшибки);
        Сообщить(ТекстСообщения);
    КонецЕсли;
    
КонецПроцедуры
