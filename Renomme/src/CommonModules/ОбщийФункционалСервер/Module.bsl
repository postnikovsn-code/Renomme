Процедура КонтекстноеМенюВставитьКнопку(Элементы, ИмяКнопки, ИмяКоманды, ИмяКартинки, Элементы_ДокументыКСписаниюКонтекстноеМеню
	, КонтекстноеМеню_ПодчиненныеЭлементы, ИндексКнопкиПеред) Экспорт
Если ИндексКнопкиПеред = Неопределено Тогда	
	ЭлементПеред = Неопределено; 
Иначе	
	ЭлементПеред = КонтекстноеМеню_ПодчиненныеЭлементы.Получить(ИндексКнопкиПеред); 
КонецЕсли;

НовЭлемент = Элементы.Вставить(ИмяКнопки, Тип("КнопкаФормы"), Элементы_ДокументыКСписаниюКонтекстноеМеню, ЭлементПеред);

Если ЗначениеЗаполнено(ИмяКартинки) Тогда
	НоваяКартинка = БиблиотекаКартинок[ИмяКартинки]; 
	НовЭлемент.Картинка = НоваяКартинка;
КонецЕсли;

НовЭлемент.ИмяКоманды = ИмяКоманды; 
КонецПроцедуры

 Процедура ВставитьТабличныйДокумент(ИсходныйДокумент, ВставляемыйДокумент) Экспорт
   
    Для НомерСтроки = 1 По ВставляемыйДокумент.ВысотаТаблицы Цикл
        
        НачалоНовогоФорматаСтрок = ИсходныйДокумент.ВысотаТаблицы + 1;
        
        ОбластьПрямоугольная = ВставляемыйДокумент.Область(НомерСтроки, ,НомерСтроки);
        ИсходныйДокумент.ВставитьОбласть(ОбластьПрямоугольная, ИсходныйДокумент.Область(НачалоНовогоФорматаСтрок, 1));
        ИсходныйДокумент.Область(НачалоНовогоФорматаСтрок, ,НачалоНовогоФорматаСтрок).СоздатьФорматСтрок();
        
        СтрокаРезультатата = ВставляемыйДокумент.ПолучитьОбласть(НомерСтроки,,НомерСтроки);
        
        Если СтрокаРезультатата.ШиринаТаблицы = 0 Тогда
            СтрокаРезультатата = ВставляемыйДокумент.ПолучитьОбласть(НомерСтроки,1,НомерСтроки,1);
            ИсходныйДокумент.Область(НачалоНовогоФорматаСтрок,1).Текст = " ";
        КонецЕсли;
        
        Для Счетчик = 1 По Макс(СтрокаРезультатата.ШиринаТаблицы,1) Цикл
            ИсходныйДокумент.Область(НачалоНовогоФорматаСтрок, Счетчик).РастягиватьПоГоризонтали = СтрокаРезультатата.Область(1, Счетчик).РастягиватьПоГоризонтали;
            ИсходныйДокумент.Область(НачалоНовогоФорматаСтрок, Счетчик).ШиринаКолонки = СтрокаРезультатата.Область(1, Счетчик).ШиринаКолонки;
        КонецЦикла;
        
    КонецЦикла;
    
КонецПроцедуры                                          


Функция Сравнить_Две_Таблицы_Значений(ТЗn1, ТЗn2, КлючСортировки) Экспорт

   // Данный метод программно сравнивает две таблицы значений по всем признакам
  Если ТипЗнч(ТЗn1) <> Тип("ТаблицаЗначений")  Тогда
       Сообщить("Параметр N1 не является Таблицой значений");
       Возврат Ложь;
   КонецЕсли;

   Если ТипЗнч(ТЗn2) <> Тип("ТаблицаЗначений") Тогда
       Сообщить("Параметр N2 не является Таблицой значений");
       Возврат Ложь;
   КонецЕсли;

   Если ТЗn1.Количество() <> ТЗn2.Количество() Тогда
       Сообщить("Количество строк у таблиц значений различное");
       Возврат Ложь;
   КонецЕсли;

   Если ТЗn1.Колонки.Количество() <> ТЗn2.Колонки.Количество() Тогда
       Сообщить("Количество колонок у таблиц значений различное");
       Возврат Ложь;
   КонецЕсли;

   // Предварительно сортируем обе таблицы по одному и тому же уникальному ключу
  //ТЗn1.Сортировать("КатегорияНомера Возр");   // прим. УникКлюч - свой идентиф.
  //ТЗn2.Сортировать("КатегорияНомера Возр");
  ТЗn1.Сортировать(КлючСортировки + " Возр");   // прим. УникКлюч - свой идентиф.
  ТЗn2.Сортировать(КлючСортировки + " Возр");

   // Преобразуем
   СтрВнутрТЗn1 = ЗначениеВСтрокуВнутр(ТЗn1.Скопировать());
   СтрВнутрТЗn2 = ЗначениеВСтрокуВнутр(ТЗn2.Скопировать());

   Если СтрВнутрТЗn1 <> СтрВнутрТЗn2 Тогда
       Возврат Ложь;
   Иначе
       Возврат Истина;
   КонецЕсли;

КонецФункции

Функция УникальныйИдентификаторПустой() Экспорт
ГУИД = Новый УникальныйИдентификатор("00000000-0000-0000-0000-000000000000");
Возврат ГУИД;
КонецФункции
