ОтборЭлемента.ВидСравнения = ВидСравненияКомпоновкиДанных.ВСписке;

ОтборСтроки = Новый Структура("КоличествоТолькоПросмотр", Истина);
НайденныеСтроки = Настройки.НайтиСтроки(ОтборСтроки);
