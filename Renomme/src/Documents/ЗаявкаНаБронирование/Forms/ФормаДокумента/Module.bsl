//
&НаСервере
Функция ОбновитьСумму()
СуммаПроживание = 0; СуммаПроживаниеОплачено = 0;
Для Каждого Строка Из Объект.Проживание Цикл
	СуммаПроживание = СуммаПроживание + Строка.Сумма;
	СуммаПроживаниеОплачено = СуммаПроживаниеОплачено + Строка.СуммаОплачено;
КонецЦикла;	
СуммаПроживаниеКОплате = СуммаПроживание - СуммаПроживаниеОплачено;  

СуммаУслуги = 0; СуммаУслугиОплачено = 0;
Для Каждого Строка Из Объект.ДопУслуги Цикл
	Если НЕ Строка.ВСчет Тогда Продолжить; КонецЕсли;
	
	СуммаУслуги = СуммаУслуги + Строка.Сумма;
	СуммаУслугиОплачено = СуммаУслугиОплачено + Строка.СуммаОплачено;
КонецЦикла;	
СуммаУслугиКОплате = СуммаУслуги - СуммаУслугиОплачено;  

СуммаРаспределеноКасса = 0;
СуммаРаспределеноВыписка = 0;
СуммаРаспределеноПрочиеОплаты = 0;
Для Каждого Строка из Объект.СчетаДетальноОплаты Цикл
	Если ТипЗнч(Строка.ДокументОплаты) = ТИП("ДокументСсылка.КассовыйДокумент") Тогда 
		СуммаРаспределеноКасса = СуммаРаспределеноКасса + Строка.СуммаРаспределено;
	ИначеЕсли ТипЗнч(Строка.ДокументОплаты) = ТИП("ДокументСсылка.ВыпискаБанка") Тогда
		СуммаРаспределеноВыписка = СуммаРаспределеноВыписка + Строка.СуммаРаспределено;
	ИначеЕсли ТипЗнч(Строка.ДокументОплаты) = ТИП("ДокументСсылка.ПрочиеОплаты") Тогда
		СуммаРаспределеноПрочиеОплаты = СуммаРаспределеноПрочиеОплаты + Строка.СуммаРаспределено;
	КонецЕсли;
КонецЦикла;	

СуммаОплаты = СуммаРаспределеноКасса + СуммаРаспределеноВыписка + СуммаРаспределеноПрочиеОплаты;
СуммаНачислено = СуммаПроживание + СуммаУслуги;
СуммаДолг = СуммаНачислено - СуммаОплаты;

НадписьСумма = "ИТОГО к оплате: " + "проживание " + СуммаПроживание
		+ ", услуги " + СуммаУслуги + ", итого: " + СуммаНачислено  + ". ";
		
НадписьОшибка = "";
Если СуммаДолг = 0 Тогда  
	НадписьСумма = НадписьСумма + "Долг отсутсвует."		
Иначе
	Если СуммаДолг > 0 Тогда	
		НадписьОшибка = НадписьОшибка + "Долг: " + "проживание " + СуммаПроживаниеКОплате
			+ ", услуги " + СуммаУслугиКОплате + ".";
	ИначеЕсли СуммаДолг < 0 Тогда  
	//	НадписьОшибка = НадписьОшибка + "Переплата: " + "касса " + СуммаОстатокКассаКРаспределению
	//		+ ", выписка " + СуммаОстатокВыпискаКРаспределению + ".";
		НадписьОшибка = НадписьОшибка + "Переплата: " + "касса " + Строка(-СуммаДолг);
	КонецЕсли;
КонецЕсли;

Элементы.НадписьСумма.Ширина = СтрДлина(НадписьСумма) + 1; 
Элементы.НадписьСумма.Заголовок = НадписьСумма;

//НадписьОшибка = "";
//СуммаДолгиКОплате = СуммаПроживаниеКОплате + СуммаУслугиКОплате;
//Если НЕ (СуммаДолгиКОплате = 0 ИЛИ СуммаОстатокКассаКРаспределению = 0) Тогда
//	НадписьОшибка = "Незакрытый долг: " + "проживание " + СуммаПроживаниеКОплате
//		+ ", услуги " + СуммаУслугиКОплате + ". "; 
//	НадписьОшибка = НадписьОшибка + "Нераспределенные оплаты: " + "Касса " + СуммаОстатокКассаКРаспределению 
