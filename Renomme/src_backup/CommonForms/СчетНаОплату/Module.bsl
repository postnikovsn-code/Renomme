&НаКлиенте
Процедура СчетаДетальноОплатыВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
СтандартнаяОбработка = Ложь;
ТД = Элементы.СчетаДетальноОплаты.ТекущиеДанные;

ТолькоПросмотр = Истина;
ОплатыОбщееКлиент.ОткрытьДокументОплаты(ЭтаФорма, ТД.ДокументОплаты, ТолькоПросмотр, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
КонецПроцедуры

// + Фискализация Чека

&НаКлиенте
Процедура Чек(Команда)
Если КлиентыСервер.ЭтоЮрЛицо(Контрагент) Тогда 	
	ПоказатьПредупреждение(,"Счет выписан на юр. лицо"	
		+ Символы.ПС + Символы.ПС + "Операция НЕ возможна");		
	Возврат;
КонецЕсли;

Если ОплатыОбщееСервер.ЕстьОстаткиОплатКассаКонтрагент(Контрагент) Тогда
	ДопПараметры = Новый Структура;
	ДопПараметры.Вставить("Счет", Счет);
	ОписаниеОповещения = Новый ОписаниеОповещения("ЗавершитьВопрос_ЕстьКассовыеОстаткиОплат", ЭтаФорма, ДопПараметры);
	
	ПоказатьВопрос(ОписаниеОповещения, "Есть кассовые остатки оплат для контрагента
										|
										|ПРОДОЛЖИТЬ ФОРМИРОВАНИЕ ЧЕКА ?"
					, РежимДиалогаВопрос.ОКОтмена);
						
	Возврат;				
КонецЕсли;

ЧекОплатыДействие();
КонецПроцедуры

&НаКлиенте
Процедура ЗавершитьВопрос_ЕстьКассовыеОстаткиОплат(Результат, ДополнительныеПараметры) Экспорт
Если Результат = КодВозвратаДиалога.Отмена Тогда Возврат; КонецЕсли;
	
ЧекОплатыДействие();
КонецПроцедуры

&НаКлиенте
Процедура ЧекОплатыДействие()
СохранитьКоманда(Неопределено);	

ДопПараметры = Новый Структура;
ДопПараметры.Вставить("Счет", Счет);  
ДопПараметры.Вставить("ДокументДолгОбъектДанные", ДокументДолгОбъект);  

ДопПараметры.Вставить("ЭтоСчетНаОплату", Истина);

ДопПараметры.Вставить("СчетаДетальноДолги", СчетаДетальноДолги);  
ДопПараметры.Вставить("РаспределениеОплатДолги", РаспределениеОплатДолги);  
ДопПараметры.Вставить("СчетаДетальноОплаты", СчетаДетальноОплаты);  

ДопПараметрыОповещения = Новый Структура;
ОповещениеЗавершениеЧекОплаты = Новый ОписаниеОповещения("ОповещениеЗавершениеЧекОплаты", ЭтаФорма, ДопПараметрыОповещения);
ДопПараметры.Вставить("ОповещениеЗавершениеЧек", ОповещениеЗавершениеЧекОплаты);

ОплатыЧекКлиент.ЧекОплаты(ДопПараметры, ЭтаФорма);
КонецПроцедуры

&НаКлиенте
Процедура ОповещениеЗавершениеЧекОплаты(Результат, ДополнительныеПараметры) Экспорт
ЗаполнитьСчетаДетальноСтроки();

СохранитьКоманда(Неопределено);
КонецПроцедуры	
// + Фискализация Чека

// + Безнал
&НаКлиенте
Процедура БезналСчет(Команда)
СохранитьКоманда(Неопределено);	

ПараметрыФормы = Новый Структура();
ДопПараметры = Новый Структура();

СписокКонтрагентыЗаявка = Новый СписокЗначений; 
СписокКонтрагентыЗаявка.Добавить(Контрагент);

ПараметрыФормы.Вставить("ОтКого", СписокКонтрагентыЗаявка);

СуммаКОплатеСчет = 0;
Для Каждого Строка Из СчетаДетальноДолги Цикл
	СуммаКОплатеСчет = СуммаКОплатеСчет + Строка.СуммаКЗакрытию;
КонецЦикла;
Если СуммаКОплатеСчет <= 0 Тогда Возврат; КонецЕсли;

ПараметрыФормы.Вставить("СуммаКОплате", СуммаКОплатеСчет);
ДопПараметры.Вставить("СуммаКОплатеСчет", СуммаКОплатеСчет);

Оповещение = Новый ОписаниеОповещения("ЗавершениеФормаВыбораОплата_БезналСчет", ЭтаФорма, ДопПараметры);
ОткрытьФорму("Документ.ВыпискаБанка.Форма.ФормаВыбораОплата", ПараметрыФормы , ЭтаФорма
	,,,, Оповещение, РежимОткрытияОкнаФормы .БлокироватьОкноВладельца);
КонецПроцедуры

&НаКлиенте
Процедура ЗавершениеФормаВыбораОплата_БезналСчет(Результат, ДополнительныеПараметры) Экспорт
Если Результат = Неопределено Тогда Возврат; КонецЕсли;

ДокументОплаты = Результат;
СуммаКОплатеСчет = ДополнительныеПараметры.СуммаКОплатеСчет; 

ДобавитьОплатаБезналНаСервере_БезналСчет(ДокументОплаты, СуммаКОплатеСчет);

ЗаполнитьСчетаДетальноСтроки();

СохранитьКоманда(Неопределено);
Конецпроцедуры

&НаСервере
Процедура ДобавитьОплатаБезналНаСервере_БезналСчет(ДокументОплаты, СуммаКОплате) Экспорт
СуммаКРаспределению = ДокументОплаты.Сумма - ДокументОплаты.ДолгиОплата.Итог("Сумма");

Если СуммаКОплате > СуммаКРаспределению Тогда
	СуммаОплаты = СуммаКРаспределению;
Иначе
	СуммаОплаты = СуммаКОплате;
КонецЕсли;                                       

СтрокаОплаты = ЗаявкаСервер.ДобавитьОплатаСчетаДетальноОплаты(СчетаДетальноОплаты, ДокументОплаты, Ложь);

ЗаявкаОбщееКлиентСервер.РаспределитьОплатаНаСчетаДетальноДолги(СтрокаОплаты, СуммаОплаты, СчетаДетальноДолги, РаспределениеОплатДолги);  
КонецПроцедуры
// - Безнал
//// - Оплаты


