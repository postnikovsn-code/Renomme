	                                 |	Мероприятия.ДатаС КАК ДатаС,
	                                 |	Мероприятия.ДатаПо КАК ДатаПо,
	                                 |	Мероприятия.ТипМероприятия КАК ТипМероприятия,
	                                 |	Мероприятия.Мероприятие КАК Мероприятие
	                                 |ИЗ
	                                 |	Справочник.Мероприятия КАК Мероприятия
	                                 |ГДЕ
	                                 |	Мероприятия.ПометкаУдаления = ЛОЖЬ
	                                 |	И Мероприятия.ДатаС <= &Дата
	                                 |	И Мероприятия.ДатаПо >= &Дата
	                                 |
	                                 |УПОРЯДОЧИТЬ ПО
	                                 |	ДатаС");
	
	ЗапросМероприятия.УстановитьПараметр("Дата", Дата_П);
	ТЗМероприятия = ЗапросМероприятия.Выполнить().Выгрузить();
	Мероприятия = "";
	Для Каждого Строка Из ТЗМероприятия Цикл
		Мероприятие = ?(ЗначениеЗаполнено(Строка.Мероприятие), Строка.Мероприятие, Строка.Наименование);
		Мероприятия = Мероприятия + Мероприятие + Символы.ПС;
	КонецЦикла;
	Если Мероприятия <> "" Тогда 
		Мероприятия = Лев(Мероприятия, СтрДлина(Мероприятия) - 1);
	КонецЕсли; 
	
	Область = Макет.ПолучитьОбласть("Строка");	 
	ОбластьПараметры = Область.Параметры;
	
	ОбластьПараметры.Дата = Формат(Дата_П, "ДФ=dd.MM.yy");
	ДеньНедели = ОбщийФункционалКлиентСервер.ДеньНеделиСтрока(ДеньНедели(Дата_П)); 
	ОбластьПараметры.ДеньНедели = ДеньНедели;	
	
	ОбластьПараметры.ИтогоНомеров = ИтогоНомеров;	
	ОбластьПараметры.ПрогнозЗагрузки = ПрогнозЗагрузки;	
	ОбластьПараметры.Глубина_0_1 = Глубина_0_1;	
	ОбластьПараметры.Глубина_2_3 = Глубина_2_3;	
	ОбластьПараметры.Глубина_4_7 = Глубина_4_7;	
	ОбластьПараметры.Глубина_8_14 = Глубина_8_14;	
