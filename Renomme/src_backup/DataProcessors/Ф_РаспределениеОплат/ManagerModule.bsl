		ОбластьСтрокаОплаты.Параметры.ДокументОплаты = СтрокаОплаты.ДокументОплаты;
		ОбластьСтрокаОплаты.Параметры.ДокументОплатыРасшифровка = СтрокаОплаты.ДокументОплаты;
		
		ОбластьСтрокаОплаты.Параметры.ДатаОплаты = Формат(СтрокаОплаты.ДатаОплаты, "ДФ=dd.MM.yy");
		ОбластьСтрокаОплаты.Параметры.НомерСменыККМ = СтрокаОплаты.НомерСменыККМ;
		ОбластьСтрокаОплаты.Параметры.СуммаОплаты = СтрокаОплаты.Сумма;
		ОбластьСтрокаОплаты.Параметры.СуммаКарта = СтрокаОплаты.СуммаКарта;
		ОбластьСтрокаОплаты.Параметры.СуммаНаличные = СтрокаОплаты.СуммаНаличные;
		ОбластьСтрокаОплаты.Параметры.СуммаВозврат = СтрокаОплаты.СуммаВозврат;
		
