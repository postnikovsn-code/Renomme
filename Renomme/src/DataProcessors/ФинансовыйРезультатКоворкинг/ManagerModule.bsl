	КонецЕсли;	
	ПолеОтчета.Присоединить(ОбластьУслуги, 1);
КонецЦикла;

Если ЭтоОтчет Тогда
	Область = Макет.ПолучитьОбласть("Строка|КолонкиЛево");
	Колонка_1 = Область.ШиринаТаблицы - 5;
