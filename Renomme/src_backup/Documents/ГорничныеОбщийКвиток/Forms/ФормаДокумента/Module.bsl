ЭлементОформления.Оформление.УстановитьЗначениеПараметра("ТолькоПросмотр", Истина);
//

ЭлементОформления = УсловноеОформление.Элементы.Добавить();
ПолеЭлемента = ЭлементОформления.Поля.Элементы.Добавить();
	
ОтборЭлемента = ЭлементОформления.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
ОтборЭлемента.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("Квиток.КодЗаполнения");
ОтборЭлемента.ВидСравнения = ВидСравненияКомпоновкиДанных.ВСписке;

СписокКоличество = Новый СписокЗначений;
СписокКоличество.Добавить("ИтогоНачисления");
СписокКоличество.Добавить("ОстатокКВыплате");

ОтборЭлемента.ПравоеЗначение = СписокКоличество;
ОтборЭлемента.Использование  = Истина;

ЭлементОформления.Использование = Истина;

ПолеЭлемента.Поле = Новый ПолеКомпоновкиДанных(Элементы.Квиток.Имя);
ЭлементОформления.Оформление.УстановитьЗначениеПараметра("ТолькоПросмотр", Истина);
ЭлементОформления.Оформление.УстановитьЗначениеПараметра("Шрифт", Новый Шрифт(,,Истина));

