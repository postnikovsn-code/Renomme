Функция ПечатьСчетаНаАнглийском(Объект, ТолькоУслуги, ТолькоПроживание) Экспорт 
ТабДок = Новый ТабличныйДокумент;

//Макет = Документы.ЗаявкаНаБронирование.ПолучитьМакет("СчетАнгл");
Макет = ПолучитьМакетДокументаЗаявкаНаБронирование("СчетАнгл");

// Заголовок
Область = Макет.ПолучитьОбласть("ЗаголовокСчета");
ТабДок.Вывести(Область);
Область = Макет.ПолучитьОбласть("Заголовок");
Область.Параметры.ТекстЗаголовка=" Invoice № "+Формат(Объект.Номер, "ЧГ=")+" printed "+ Формат(Объект.Дата, "ДФ=dd.MM.yy");	
ТабДок.Вывести(Область);

Область = Макет.ПолучитьОбласть("Поставщик");
Область.Параметры.ПредставлениеПолучателя="Guest : "+Объект.Клиент.Наименование;	
Область.Параметры.ПредставлениеНомера="Room number: "+Объект.НомерВРезерв.Наименование;	
Область.Параметры.ПредставлениеКорпуса="Check in : "+Формат(Объект.РезервС, "ДФ=dd.MM.yy")+" 12:00";	
Область.Параметры.ПредставлениеКорпуса2="Check out : "+Формат(Объект.РезервПо, "ДФ=dd.MM.yy")+" 12:00";
ТабДок.Вывести(Область);

//Оплачивает2 = Объект.Оплачивает;

СуммаДляПечати=0;
//СуммаПроживание=РассчитатьСуммуЗаПроживание(Неопределено,Объект.ПеременныйТариф);//Тариф.Цена*КолВо;
Первый = Истина; РазделитьСчет = Ложь;
СуммаПроживание = 0;
Если (НЕ ТолькоУслуги) Тогда
	Для Каждого Строка Из Объект.Проживание Цикл
		СуммаПроживание = СуммаПроживание + Строка.Сумма; 	
	КонецЦикла;	
КонецЕсли;

//СуммаДляПечати = ?(Объект.ВСчет, СуммаДляПечати + СуммаПроживание, СуммаДляПечати);
СуммаДляПечати = СуммаПроживание;
Если (НЕ ТолькоПроживание) Тогда
	Для каждого ДопУсл Из Объект.ДопУслуги Цикл
		Если НЕ ДопУсл.ВСчет тогда Продолжить; конецесли;
		
		СуммаДляПечати = СуммаДляПечати + ДопУсл.Количество*ДопУсл.Цена;
	КонецЦикла; 
КонецЕсли;

// Шапка
Шапка = Макет.ПолучитьОбласть("ШапкаТаблицы");
ТабДок.Вывести(Шапка);

СтрокаТабл = Макет.ПолучитьОбласть("Строка");
Если Объект.СвернутьВСчете тогда
	//	НомерСтроки	Товар	Количество	ЕдиницаИзмерения	Цена	Сумма
	
	СтрокаТабл.Параметры.НомерСтроки=1;
	
	СтрокаТабл.Параметры.Товар="Standart";// +Тариф.Наименование+ " " + Клиент.Наименование + " с "+ Формат(РезервС, "ДФ=dd.MM.yy")+ " по "+ Формат(РезервПо, "ДФ=dd.MM.yy");
	СтрокаТабл.Параметры.Период=Объект.КолВо;
	////СтрокаТабл.Параметры.Период="С "+Формат(РезервС, "ДФ=dd.MM.yy")+ " по "+Формат(РезервПо, "ДФ=dd.MM.yy");
	
	//СтрокаТабл.Параметры.Цена=Формат(?(Объект.Колво=0, Объект.Тариф.Цена, Окр(СуммаДляПечати/Объект.КолВо,2)), "ЧДЦ=0");
	СтрокаТабл.Параметры.Цена = Формат(?(Объект.Колво=0, 0, ДокументыСервер.ОкруглитьЦену(СуммаДляПечати / Объект.КолВо))
		, "ЧДЦ=0");
		
	СтрокаТабл.Параметры.Сумма=Формат(ДокументыСервер.ОкруглитьСумма(СуммаДляПечати), "ЧДЦ=0");
	ТабДок.Вывести(СтрокаТабл);
	
	сч=1;
иначе
	//Если Объект.Всчет тогда
	Если (НЕ ТолькоУслуги) тогда
		сч=0;
		
		Для каждого Стр Из Объект.Проживание Цикл
			сч = сч + 1;
			СтрокаТабл.Параметры.НомерСтроки = сч;
			
			СтрокаТабл.Параметры.Товар="Проживание с " + Формат(Стр.ДеньПроживания, "ДФ=dd.MM.yy")
				+ " по "+ Формат(Стр.ДеньПроживания+86400, "ДФ=dd.MM.yy")
				//+ " " + Объект.НомерВРезерв.КатегорияНомера.Наименование
				//+ " " + Объект.КатегорияНомера.Наименование
				;
			СтрокаТабл.Параметры.Период=1;
			
			//Скидка = ДокументыСервер.ИтогоСкидка(Объект);
			Скидка = ДокументыСервер.ИтогоСкидкаКлиент(Объект, Истина);
			
			//Цена = Окр(Стр.Цена*(1 - Скидка/100), 2);
			Цена = ДокументыСервер.ОкруглитьЦену(Стр.Цена*(1 - Скидка/100));
			СтрокаТабл.Параметры.Цена = Формат(Цена, "ЧДЦ=0");
			
			Сумма = ДокументыСервер.ОкруглитьСумма(Стр.Сумма);
			СтрокаТабл.Параметры.Сумма = Формат(Сумма, "ЧДЦ=0");

			ТабДок.Вывести(СтрокаТабл);
		КонецЦикла; 
	иначе
		
		Сч=0;
	конецесли;
	
	Если НЕ ТолькоПроживание тогда
		Для каждого Усл Из Объект.ДопУслуги Цикл
			Если НЕ Усл.ВСчет тогда Продолжить; конецесли;
			
			сч = сч + 1;
			СтрокаТабл.Параметры.НомерСтроки = сч;
			
			СтрокаТабл.Параметры.Товар=Усл.Услуга.Наименование;
			СтрокаТабл.Параметры.Период=Усл.Количество;
			////СтрокаТабл.Параметры.Период="С "+Формат(РезервС, "ДФ=dd.MM.yy")+ " по "+Формат(РезервПо, "ДФ=dd.MM.yy");
			
			СтрокаТабл.Параметры.Цена=Формат(Усл.Цена, "ЧДЦ=0");
			СтрокаТабл.Параметры.Сумма=Формат(Усл.Цена * Усл.Количество, "ЧДЦ=0");
			
			ТабДок.Вывести(СтрокаТабл);
		КонецЦикла; 
	КонецЕсли;
КонецЕсли;

ИтогоСтр=Макет.ПолучитьОбласть("Итого");
ИтогоСтр.Параметры.Всего=СуммаДляПечати;
ТабДок.Вывести(ИтогоСтр);

ИтогоСтр=Макет.ПолучитьОбласть("ПодвалЗаказа");
ТабДок.Вывести(ИтогоСтр);

ТабДок.ОтображатьСетку = Ложь;
ТабДок.Защита = Ложь;
ТабДок.ТолькоПросмотр = Истина;
ТабДок.ОтображатьЗаголовки = Ложь;

Возврат ТабДок;			
КонецФункции
