КонецПроцедуры

&НаСервере
Функция КоличествоЧасовНаСервере(Строка, КоличествоСмен)
ДлинаСмены = Строка.Горничная.ДлинаСмены;	
Если ДлинаСмены = 0 Тогда Возврат 0; КонецЕсли;	
	
КоличествоЧасов = КоличествоСмен * ДлинаСмены;
Возврат КоличествоЧасов; 
КонецФункции

&НаКлиенте
Функция КоличествоЧасовНаКлиенте(Строка, КоличествоСмен)
ДлинаСмены = ОбщийФункционалСервер.ЗначениеРеквизитаНаСервере(Строка.Горничная, "ДлинаСмены");	
Если ДлинаСмены = 0 Тогда Возврат 0; КонецЕсли;	
	
// + Аудит
//КоличествоЧасов = КоличествоСмен * 8;
КоличествоЧасов = КоличествоСмен * ДлинаСмены;
// - Аудит
Возврат КоличествоЧасов; 
КонецФункции

&НаСервере
Функция СуммаНадбавкаЗаСтажЗаполнение(ДатаПриема)
//0,5года -500
//1 год -1000
//2 года-2000
//3года -3000
//5 лет -3500 


Если НЕ ЗначениеЗаполнено(ДатаПриема) Тогда Возврат 0; КонецЕсли;

Если ГорничныеНадбавкаЗаСтаж.Количество() = 0 Тогда Возврат 0; КонецЕсли;

ДатаУчета = Объект.ДН;
РазницаВДнях = (НачалоДня(ДатаУчета) - НачалоДня(ДатаПриема)) / (60 * 60 * 24);

СуммаНадбавкаЗаСтаж = 0;
Для Каждого Строка Из ГорничныеНадбавкаЗаСтаж Цикл
	Если РазницаВДнях >= Строка.РазницаВДняхС И РазницаВДнях < Строка.РазницаВДняхПо Тогда
		 СуммаНадбавкаЗаСтаж = Строка.Сумма;
		 
		 Прервать;
	КонецЕсли;
КонецЦикла;

Возврат СуммаНадбавкаЗаСтаж;
КонецФункции

&НаСервере
Функция СуммаНадбавкаЗаСтаж(ГорничнаяСправочник) 
//КоличествоДней = КоличествоРасчетныхДней(ГорничнаяСправочник.Горничная); 
КоличествоДней = ((НачалоДня(Объект.ДК) - НачалоДня(Объект.ДН)) / (60 * 60 * 24)) + 1;
	
КоличествоДнейМесяц = День(КонецМесяца(Объект.МесяцРасчета));

СуммаНадбавкаЗаСтаж = Окр(ГорничнаяСправочник.НадбавкаЗаСтаж * КоличествоДней / КоличествоДнейМесяц);

Возврат СуммаНадбавкаЗаСтаж;
КонецФункции

&НаСервере
Функция СуммаНадбавкаЗаСтандарты(Горничная) 
//КоличествоДней = КоличествоРасчетныхДней(Горничная); 
КоличествоДней = ((НачалоДня(Объект.ДК) - НачалоДня(Объект.ДН)) / (60 * 60 * 24)) + 1;
	
КоличествоДнейМесяц = День(КонецМесяца(Объект.МесяцРасчета));

СуммаНадбавкаЗаСтандарты = Окр(Горничная.НадбавкаЗаСтандарты * КоличествоДней / КоличествоДнейМесяц);

Возврат СуммаНадбавкаЗаСтандарты;
КонецФункции


&НаСервере
Функция СуммаОтпуск(Горничная) 
Если Горничная.ВсегоДнейОтпуска = 0 Тогда Возврат 0; КонецЕсли;
	
ДнейОтпуска = 0;
Отпуска = Горничная.Отпуска;
Для Каждого Строка Из Отпуска Цикл
	Если Строка.ДатаНачалаОтпуска >= Объект.ДН И Строка.ДатаНачалаОтпуска <= Объект.ДК Тогда  
		РазницаВДнях = ((НачалоДня(Строка.ДатаОкончанияОтпуска) - НачалоДня(Строка.ДатаНачалаОтпуска)) / (60 * 60 * 24)) + 1;
		ДнейОтпуска = ДнейОтпуска + РазницаВДнях;
	КонецЕсли;
КонецЦикла;
Если ДнейОтпуска = 0 Тогда Возврат 0; КонецЕсли;

СуммаОтпуск = Окр( ДнейОтпуска * Горничная.Отпуск / Горничная.ВсегоДнейОтпуска);

Возврат СуммаОтпуск;
КонецФункции

&НаСервере
Функция СуммаОклад(Горничная) 
//Если Горничная.Наименование = "Сонникова Людмила" Тогда
//	ш= 1;
//КонецЕсли;
ОкладКоличествоДней = КоличествоРасчетныхДней(Горничная); 
	
КоличествоДнейМесяц = День(КонецМесяца(Объект.МесяцРасчета));
СуммаОклад = Окр(Горничная.Оклад * ОкладКоличествоДней / КоличествоДнейМесяц);

Возврат СуммаОклад;
КонецФункции

&НаСервере
Функция КоличествоРасчетныхДней(Горничная) 
//Если Горничная.Наименование = "Сонникова Людмила" Тогда
//	ш= 1;
//КонецЕсли;

РазницаВДняхОбщая = ((НачалоДня(Объект.ДК) - НачалоДня(Объект.ДН)) / (60 * 60 * 24)) + 1;

Если Горничная.ВсегоДнейОтпуска = 0 Тогда Возврат РазницаВДняхОбщая; КонецЕсли;
	
ДнейОтпуска = 0;
Отпуска = Горничная.Отпуска;
Для Каждого Строка Из Отпуска Цикл
	РазницаВДнях = 0;
	
	Если Строка.ДатаНачалаОтпуска >= Объект.ДН И Строка.ДатаОкончанияОтпуска <= Объект.ДК Тогда  
		РазницаВДнях = ((НачалоДня(Строка.ДатаОкончанияОтпуска) - НачалоДня(Строка.ДатаНачалаОтпуска)) / (60 * 60 * 24)) + 1;
		
	ИначеЕсли Строка.ДатаНачалаОтпуска < Объект.ДН И Строка.ДатаОкончанияОтпуска > Объект.ДК Тогда
		РазницаВДнях = ((НачалоДня(Объект.ДК) - НачалоДня(Объект.ДН)) / (60 * 60 * 24)) + 1;
		
	ИначеЕсли Строка.ДатаНачалаОтпуска >= Объект.ДН И Строка.ДатаНачалаОтпуска <= Объект.ДК 
	И Строка.ДатаОкончанияОтпуска > Объект.ДК Тогда  
		РазницаВДнях = ((НачалоДня(Объект.ДК) - НачалоДня(Строка.ДатаНачалаОтпуска)) / (60 * 60 * 24)) + 1;
		
	ИначеЕсли Строка.ДатаНачалаОтпуска < Объект.ДН 	И Строка.ДатаОкончанияОтпуска >= Объект.ДН   
	И Строка.ДатаОкончанияОтпуска <= Объект.ДК Тогда
		РазницаВДнях = ((НачалоДня(Строка.ДатаОкончанияОтпуска) - НачалоДня(Объект.ДН)) / (60 * 60 * 24)) + 1;
		
	КонецЕсли;
	
	ДнейОтпуска = ДнейОтпуска + РазницаВДнях;
КонецЦикла;

ДнейОклад = РазницаВДняхОбщая - ДнейОтпуска; 

Возврат ДнейОклад;
КонецФункции
