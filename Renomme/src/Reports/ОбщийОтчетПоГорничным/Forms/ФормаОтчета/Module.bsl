&НаСервере
Функция МанипуляцияДопМестоКоличество(Регистратор)
МДМ_Количество = 0;	
Если Регистратор.МанипуляцияДопМесто_1 Тогда 	
	МДМ_Количество = МДМ_Количество + 1; 	
КонецЕсли;	
Если Регистратор.МанипуляцияДопМесто_2 Тогда 	
	МДМ_Количество = МДМ_Количество + 1; 	
КонецЕсли;	

Возврат МДМ_Количество;
КонецФункции


&НаСервере
Функция МинибарСтрока(Регистратор)
МинибраСтрока = "";
Для Каждого Строка Из Регистратор.Минибар Цикл
	Если ЗначениеЗаполнено(Строка.НоменклатураМинибара) Тогда
		МинибраСтрока = МинибраСтрока + Строка.НоменклатураМинибара;
	Иначе
		МинибраСтрока = МинибраСтрока + "* " + Строка.НоменклатураМинибараНаименованиеВыгрузка;
	КонецЕсли;
	
	МинибраСтрока = МинибраСтрока + ": " + Строка.Количество + " * " + Строка.Цена + " = " + Строка.Количество * Строка.Цена;	
	
	МинибраСтрока = МинибраСтрока + Символы.ПС;
КонецЦикла;

Если МинибраСтрока <> "" Тогда МинибраСтрока = Лев(МинибраСтрока, СтрДлина(МинибраСтрока) - 1); КонецЕсли;
	
Возврат МинибраСтрока;	
КонецФункции

