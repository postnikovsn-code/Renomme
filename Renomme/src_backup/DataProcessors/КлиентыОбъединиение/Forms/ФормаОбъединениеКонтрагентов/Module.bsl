&НаКлиенте
Процедура ДобавитьКлиента(Команда)
ПараметрыФормы = Новый Структура();	
//ПараметрыФормы.Вставить("РежимВыбора", Истина);
ПараметрыФормы.Вставить("ЗакрыватьПриВыборе", Ложь);

ОткрытьФорму("Обработка.КлиентыОбъединиение.Форма.ФормаВыбораКлиентов", ПараметрыФормы, Элементы.ТаблицаОтбор
		,,,,, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца); 
КонецПроцедуры

&НаКлиенте
Процедура ТаблицаОтборОбработкаВыбора(Элемент, ВыбранноеЗначение, СтандартнаяОбработка)
СтандартнаяОбработка = Ложь;

ТаблицаОтборОбработкаВыбораНаСервере(ВыбранноеЗначение);
КонецПроцедуры

&НаСервере
Процедура ТаблицаОтборОбработкаВыбораНаСервере(ВыбранноеЗначение)
ОтборСтроки = Новый Структура("Клиент", ВыбранноеЗначение);	
НайденныеСтроки = ТаблицаОтбор.НайтиСтроки(ОтборСтроки);
Если НайденныеСтроки.Количество() > 0 Тогда Возврат; КонецЕсли; 

Запрос = Новый Запрос("ВЫБРАТЬ
                      |	Клиенты.Ссылка КАК Клиент,
                      |	Клиенты.ИНН КАК ИНН,
                      |	Клиенты.КПП КАК КПП,
                      |	Клиенты.ПометкаУдаления КАК ПометкаУдаления,
                      |	Заявки.ЗаявкиКоличество КАК ЗаявкиКоличество,
                      |	ГрупповыеСчета.ГрупповыеСчетаКоличество КАК ГрупповыеСчетаКоличество,
                      |	Выписки.ВыпискиКоличество КАК ВыпискиКоличество
                      |ИЗ
                      |	Справочник.Клиенты КАК Клиенты
                      |		ЛЕВОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
                      |			ЗаявкаНаБронирование.Оплачивает КАК Оплачивает,
                      |			КОЛИЧЕСТВО(РАЗЛИЧНЫЕ ЗаявкаНаБронирование.Ссылка) КАК ЗаявкиКоличество
                      |		ИЗ
                      |			Документ.ЗаявкаНаБронирование КАК ЗаявкаНаБронирование
                      |		
                      |		СГРУППИРОВАТЬ ПО
                      |			ЗаявкаНаБронирование.Оплачивает) КАК Заявки
                      |		ПО Клиенты.Ссылка = Заявки.Оплачивает
                      |		ЛЕВОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
                      |			ГрупповыеСчета.Контрагент КАК Контрагент,
                      |			КОЛИЧЕСТВО(РАЗЛИЧНЫЕ ГрупповыеСчета.Ссылка) КАК ГрупповыеСчетаКоличество
                      |		ИЗ
                      |			Документ.ГрупповыеСчета КАК ГрупповыеСчета
                      |		
                      |		СГРУППИРОВАТЬ ПО
                      |			ГрупповыеСчета.Контрагент) КАК ГрупповыеСчета
                      |		ПО Клиенты.Ссылка = ГрупповыеСчета.Контрагент
                      |		ЛЕВОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
                      |			ВыпискаБанка.ОтКого КАК ОтКого,
                      |			КОЛИЧЕСТВО(РАЗЛИЧНЫЕ ВыпискаБанка.Ссылка) КАК ВыпискиКоличество
                      |		ИЗ
                      |			Документ.ВыпискаБанка КАК ВыпискаБанка
                      |		
                      |		СГРУППИРОВАТЬ ПО
                      |			ВыпискаБанка.ОтКого) КАК Выписки
                      |		ПО Клиенты.Ссылка = Выписки.ОтКого
                      |ГДЕ
                      |	Клиенты.Ссылка = &Ссылка");

Запрос.УстановитьПараметр("Ссылка", ВыбранноеЗначение);
ТЗ = Запрос.Выполнить().Выгрузить();
СтрокаТЗ = ТЗ[0];

НоваяСтрока = ТаблицаОтбор.Добавить();
НоваяСтрока.Клиент = СтрокаТЗ.Клиент;

НоваяСтрока.ИНН = СтрокаТЗ.ИНН;
НоваяСтрока.КПП = СтрокаТЗ.КПП;
НоваяСтрока.ПометкаУдаления = СтрокаТЗ.ПометкаУдаления;

ТекущийРодитель = "";
ОбщийФункционалСервер.ПолнаяПапкаРодитель(СтрокаТЗ.Клиент, ТекущийРодитель);
НоваяСтрока.ПолнаяПапкаРодитель = ТекущийРодитель;

НоваяСтрока.ЗаявкиКоличество = СтрокаТЗ.ЗаявкиКоличество;
НоваяСтрока.ГрупповыеСчетаКоличество = СтрокаТЗ.ГрупповыеСчетаКоличество;
НоваяСтрока.ВыпискиКоличество = СтрокаТЗ.ВыпискиКоличество;
КонецПроцедуры
