                      |						КОГДА ЗаявкаНаБронированиеРаспределениеОплатДолги.ДокументОплаты.ВидОперации = ЗНАЧЕНИЕ(Справочник.ВидыОпераций.оverbooking)
                      |							ТОГДА 8
                      |						КОГДА ЗаявкаНаБронированиеРаспределениеОплатДолги.ДокументОплаты.СуммаНаличные = 0
                      |								И ЗаявкаНаБронированиеРаспределениеОплатДолги.ДокументОплаты.СуммаКарта > 0
                      |							ТОГДА 1
                      |						ИНАЧЕ ВЫБОР
                      |								КОГДА ЗаявкаНаБронированиеРаспределениеОплатДолги.ДокументОплаты.СуммаНаличные > 0
                      |										И ЗаявкаНаБронированиеРаспределениеОплатДолги.ДокументОплаты.СуммаКарта = 0
                      |									ТОГДА 2
                      |								ИНАЧЕ 0
                      |							КОНЕЦ
                      |					КОНЕЦ
                      |			КОНЕЦ
                      |	КОНЕЦ КАК ТипОплаты,
                      |	ВЫБОР
                      |		КОГДА ТИПЗНАЧЕНИЯ(ЗаявкаНаБронированиеРаспределениеОплатДолги.ДокументОплаты) = ТИП(Документ.ВыпискаБанка)
                      |			ТОГДА ЗаявкаНаБронированиеРаспределениеОплатДолги.ДокументОплаты.ЭтоЭквайринг
                      |		ИНАЧЕ ЛОЖЬ
                      |	КОНЕЦ КАК ЭтоЭквайринг,
                      |	ЗаявкаНаБронированиеРаспределениеОплатДолги.ДокументОплаты.Сумма КАК СуммаДокументаОплаты,
                      |	ЗаявкаНаБронированиеРаспределениеОплатДолги.ДокументОплаты.ДатаОплаты КАК ДокументОплатыДатаОплаты,
                      |	ЗаявкаНаБронированиеРаспределениеОплатДолги.ДокументОплаты.ОтКого КАК ДокументОплатыОтКого,
                      |	ВЫБОР
                      |		КОГДА ЗаявкаНаБронированиеРаспределениеОплатДолги.ДокументОплаты.ОтКого.ТипКлиента = ЗНАЧЕНИЕ(Перечисление.ТипыКлиентов.ЮрЛицо)
                      |			ТОГДА ЗаявкаНаБронированиеРаспределениеОплатДолги.ДокументОплаты.ОтКого.НаименованиеЮрЛица
                      |		ИНАЧЕ ЗаявкаНаБронированиеРаспределениеОплатДолги.ДокументОплаты.ОтКого.Наименование
                      |	КОНЕЦ КАК КонтрагентНаименование,
                      |	ЗаявкаНаБронированиеПроживание.ДеньПроживания КАК ДеньПроживания,
                      |	ЗаявкаНаБронированиеДопУслуги.ДатаУслуги КАК ДатаУслуги,
                      |	ЗаявкаНаБронированиеДопУслуги.Услуга КАК ДопУслугиУслуга,
                      |	ЕСТЬNULL(КассоваяСмена.НачалоКассовойСмены, ДАТАВРЕМЯ(1, 1, 1)) КАК ДатаСменыККМ
                      |ИЗ
                      |	Документ.ЗаявкаНаБронирование.РаспределениеОплатДолги КАК ЗаявкаНаБронированиеРаспределениеОплатДолги
                      |		ЛЕВОЕ СОЕДИНЕНИЕ Документ.ЗаявкаНаБронирование.Проживание КАК ЗаявкаНаБронированиеПроживание
                      |		ПО ЗаявкаНаБронированиеРаспределениеОплатДолги.Ссылка = ЗаявкаНаБронированиеПроживание.Ссылка
                      |			И ЗаявкаНаБронированиеРаспределениеОплатДолги.ДолгиГУИД = ЗаявкаНаБронированиеПроживание.ГУИД
                      |		ЛЕВОЕ СОЕДИНЕНИЕ Документ.ЗаявкаНаБронирование.ДопУслуги КАК ЗаявкаНаБронированиеДопУслуги
                      |		ПО ЗаявкаНаБронированиеРаспределениеОплатДолги.Ссылка = ЗаявкаНаБронированиеДопУслуги.Ссылка
                      |			И ЗаявкаНаБронированиеРаспределениеОплатДолги.ДолгиГУИД = ЗаявкаНаБронированиеДопУслуги.ГУИД
                      |		ЛЕВОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
                      |			КассовыйДокумент.Ссылка КАК ДокументОплаты,
                      |			КассоваяСмена.НомерСменыККТ КАК НомерСменыККТ,
                      |			МАКСИМУМ(КассоваяСмена.НачалоКассовойСмены) КАК НачалоКассовойСмены
                      |		ИЗ
                      |			Документ.КассовыйДокумент КАК КассовыйДокумент
                      |				ЛЕВОЕ СОЕДИНЕНИЕ Документ.КассоваяСмена КАК КассоваяСмена
                      |				ПО КассовыйДокумент.НомерСменыККМ = КассоваяСмена.НомерСменыККТ
                      |					И (ВЫБОР
                      |						КОГДА КассоваяСмена.НачалоКассовойСмены ЕСТЬ NULL
                      |							ТОГДА ИСТИНА
                      |						ИНАЧЕ НАЧАЛОПЕРИОДА(КассоваяСмена.НачалоКассовойСмены, ГОД) = НАЧАЛОПЕРИОДА(КассовыйДокумент.ДатаОплаты, ГОД)
                      |					КОНЕЦ)
                      |		
                      |		СГРУППИРОВАТЬ ПО
                      |			КассовыйДокумент.Ссылка,
                      |			КассоваяСмена.НомерСменыККТ) КАК КассоваяСмена
                      |		ПО ЗаявкаНаБронированиеРаспределениеОплатДолги.ДокументОплаты = КассоваяСмена.ДокументОплаты
                      |ГДЕ
                      |	ЗаявкаНаБронированиеРаспределениеОплатДолги.ДокументОплаты.ДатаОплаты = &ДатаОплаты
                      |
                      |УПОРЯДОЧИТЬ ПО
                      |	ЗаявкаНаБронированиеРаспределениеОплатДолги.Ссылка,
                      |	ДатаУслуги,
                      |	ДокументОплатыДатаОплаты,
                      |	ДокументОплаты");

Запрос.УстановитьПараметр("ДатаОплаты", ДатаОплатыОтбор);
ТЗ_Оплаты = Запрос.Выполнить().Выгрузить();	

Для Каждого Строка Из ТЗ_Оплаты Цикл
	Если НЕ ЗначениеЗаполнено(Строка.КонтрагентНаименование) Тогда
		Строка.КонтрагентНаименование = Строка.ДокументОплатыОтКого.Наименование;	
	КонецЕсли;
КонецЦикла;

ТЗ_Оплаты.Колонки.Добавить("ПроцентЭквайринга");
ТЗ_Оплаты.Колонки.Добавить("ПроцентЭквайрингаСБП");
Для Каждого Строка Из ТЗ_Оплаты Цикл
	Запрос = Новый Запрос("ВЫБРАТЬ ПЕРВЫЕ 1
	                      |	ПроцентыЭквайринга.ПроцентЭквайринга КАК ПроцентЭквайринга,
	                      |	ПроцентыЭквайринга.ПроцентЭквайрингаСБП КАК ПроцентЭквайрингаСБП
	                      |ИЗ
	                      |	РегистрСведений.ПроцентыЭквайринга КАК ПроцентыЭквайринга
	                      |ГДЕ
	                      |	ПроцентыЭквайринга.ДатаУстановкиПроцентаЭквайринга < &ДатаУстановкиПроцентаЭквайринга
	                      |
	                      |УПОРЯДОЧИТЬ ПО
	                      |	ПроцентыЭквайринга.ДатаУстановкиПроцентаЭквайринга УБЫВ");

	Запрос.УстановитьПараметр("ДатаУстановкиПроцентаЭквайринга", Строка.ДокументОплаты.ДатаОплаты);

	ТЗ = Запрос.Выполнить().Выгрузить();
	ПроцентЭквайринга = ?(ТЗ.Количество() = 0, 0, ТЗ[0].ПроцентЭквайринга); 			
	ПроцентЭквайрингаСБП = ?(ТЗ.Количество() = 0, 0, ТЗ[0].ПроцентЭквайрингаСБП); 			
	
	Строка.ПроцентЭквайринга = ПроцентЭквайринга;
	Строка.ПроцентЭквайрингаСБП = ПроцентЭквайрингаСБП;
КонецЦикла;

Для Каждого СтрокаОплаты Из ТЗ_Оплаты Цикл
	Если ФормаОплатыОтбор <> "" Тогда
		Если ФормаОплатыОтбор <> ОтчетыСервер.ТипОплатыНаименование(СтрокаОплаты.ТипОплаты) 
		Тогда Продолжить; КонецЕсли;
	КонецЕсли;	
	
	Область = Макет.ПолучитьОбласть("СтрокаОплаты|КолонкиЛево");
	
	//Область.Параметры.Дата = ".";
	
	НомерПредставление = "" + СтрокаОплаты.Заявка.НомерВРезерв + " / "
		 + ОбщийФункционалКлиентСервер.УбратьНезначащиеНули(СтрокаОплаты.Заявка.Номер) + " от " + Формат(СтрокаОплаты.Заявка.Дата, "ДФ=dd.MM.yy");
	Область.Параметры.Номер = НомерПредставление;
	Область.Параметры.РасшифровкаНомер = СтрокаОплаты.Заявка;
	
	Область.Параметры.ЗаявкаНомер = СтрокаОплаты.Заявка.Номер;
	Область.Параметры.ЗаявкаДата = СтрокаОплаты.Заявка.Дата;
	
	Область.Параметры.РасшифровкаЗаявка = СтрокаОплаты.Заявка;
	
	Область.Параметры.ТипОплаты = ОтчетыСервер.ТипОплатыНаименование(СтрокаОплаты.ТипОплаты);
	Область.Параметры.ДатаОплаты = Формат(СтрокаОплаты.ДокументОплаты.ДатаОплаты, "ДФ=dd.MM.yy");
	
	Если ЗначениеЗаполнено(СтрокаОплаты.ДатаСменыККМ) Тогда
		Область.Параметры.ДатаОткрытияСмены = Формат(СтрокаОплаты.ДатаСменыККМ, "ДФ=dd.MM.yy");
	КонецЕсли;
	
	Область.Параметры.РасшифровкаДокументОплаты = СтрокаОплаты.ДокументОплаты;
	
	//Область.Параметры.Оплатил = СтрокаОплаты.ДокументОплаты.ОтКого;
	//Область.Параметры.Оплатил = ОплатилНаименование(СтрокаОплаты);
	Область.Параметры.Оплатил = ОтчетыСервер.ОплатилНаименование(СтрокаОплаты);
	
	СуммаОплаты = СтрокаОплаты.СуммаОплаты;
	Область.Параметры.СуммаОплаты = СуммаОплаты;
	
	СуммаЭквайринга = ОтчетыСервер.СуммаЭквайринга(СтрокаОплаты);
	Область.Параметры.СуммаЭквайринга = СуммаЭквайринга;
	
	Если СтрокаОплаты.Услуга Тогда
		Область.Параметры.Дата = Формат(СтрокаОплаты.ДатаУслуги, "ДФ=dd.MM.yy");
		ПолеОтчета.Вывести(Область, 0);
					
		Для Каждого СтрокаРодительУслуги Из ТЗ_РодительУслуги Цикл
			
			Результат = Справочники.ДопУслуги.ПустаяСсылка();
			Ссылка = СтрокаОплаты.ДопУслугиУслуга; 
			ОбщийФункционалСервер.ВерхняяПапка(Ссылка, Результат);
			
			ЕстьСтрока = Ложь;
			Если Результат = СтрокаРодительУслуги.Папка Тогда
				ЕстьСтрока = Истина;
			КонецЕсли;
			
			ОбластьУслуги = Макет.ПолучитьОбласть("СтрокаОплаты|КолонкаУслуги");
			Если ЕстьСтрока Тогда
				ОбластьУслуги.Параметры.СуммаУслуги = СтрокаОплаты.СуммаОплаты;
			КонецЕсли;
			
			ПолеОтчета.Присоединить(ОбластьУслуги, 0);
		КонецЦикла;
	
	Иначе
		Область.Параметры.Дата = Формат(СтрокаОплаты.ДеньПроживания, "ДФ=dd.MM.yy");
		Область.Параметры.СуммаПроживание = СтрокаОплаты.СуммаОплаты;
		
		ПолеОтчета.Вывести(Область, 0);
	КонецЕсли;
	
	
////
	//ИтогиДень.КоличествоНочей = ИтогиДень.КоличествоНочей + 1;
	//ИтогиДень.КоличествоСутокТариф = ИтогиДень.КоличествоСутокТариф + КоличествоСутокТариф;
	//
	//ИтогиДень.СуммаЦенаПроживание = ИтогиДень.СуммаЦенаПроживание + ЦенаПроживание;
	
	//ИтогиДень.СуммаНомера = ИтогиДень.СуммаНомера + СуммаНомера;
	
	ИтогиДень.СуммаОплаты = ИтогиДень.СуммаОплаты + СуммаОплаты;
	
	ИтогиДень.СуммаЭквайринга = ИтогиДень.СуммаЭквайринга + СуммаЭквайринга;  
	
	//ИтогиДень.СуммаКомиссии = ИтогиДень.СуммаКомиссии + СуммаКомиссии;
	//ИтогиДень.ПолнаяСуммаКомиссии = ИтогиДень.ПолнаяСуммаКомиссии + ПолнаяСуммаКомиссии;
	
	//Если НЕ (СтрокаЗаявка.Статус = Перечисления.СтатусБрони.ОтменаБронирования 
	//ИЛИ СтрокаЗаявка.Статус = Перечисления.СтатусБрони.ОтказОтБронирования) 
	//Тогда 
	//	ИтогиДень.КоличествоСтатус = ИтогиДень.КоличествоСтатус + 1;
	//КонецЕсли;
	//
	//Если НЕ (СтрокаЗаявка.Статус = Перечисления.СтатусБрони.ОтменаБронирования 
	//ИЛИ СтрокаЗаявка.Статус = Перечисления.СтатусБрони.ОтказОтБронирования) 
	//Тогда 
	//	ИтогиДень.КоличествоЗавтраки = КоличествоЗавтраки;
	//КонецЕсли;
		
	Если СтрокаОплаты.Услуга Тогда
		Результат = Справочники.ДопУслуги.ПустаяСсылка();
		Ссылка = СтрокаОплаты.ДопУслугиУслуга; 
		ОбщийФункционалСервер.ВерхняяПапка(Ссылка, Результат);
		
		ОтборСтроки = Новый Структура("УслугаРодитель", Результат); 
		НайденныеСтроки = ИтогиДень.УслугиДеньИтоги.НайтиСтроки(ОтборСтроки);
		Для Каждого НайденнаяСтрока Из НайденныеСтроки Цикл
			НайденнаяСтрока.СуммаУслуги = НайденнаяСтрока.СуммаУслуги + СтрокаОплаты.СуммаОплаты;
		КонецЦикла;
	Иначе	
		ИтогиДень.СуммаПроживание = ИтогиДень.СуммаПроживание + СтрокаОплаты.СуммаОплаты;
	КонецЕсли;		
	
КонецЦикла;

// + Нераспределенные оплаты
Запрос = Новый Запрос("ВЫБРАТЬ
                      |	NULL КАК Заявка,
                      |	КассовыйДокумент.Ссылка КАК ДокументОплаты,
                      |	NULL КАК СчетГУИД,
                      |	NULL КАК Услуга,
                      |	NULL КАК ДолгиГУИД,
                      |	КассовыйДокумент.Сумма - ЕСТЬNULL(Возвраты.Сумма, 0) - ЕСТЬNULL(ДолгиОплата_КД.Сумма, 0) КАК СуммаОплаты,
                      |	КассовыйДокумент.Сумма КАК СуммаДокументаОплаты,
                      |	КассовыйДокумент.Сумма КАК СуммаДокументОплатыКасса,
                      |	КассовыйДокумент.СуммаНаличные КАК СуммаНаличные,
                      |	КассовыйДокумент.ОтКого КАК ОтКого,
                      |	ВЫБОР
                      |		КОГДА КассовыйДокумент.ОтКого.ТипКлиента = ЗНАЧЕНИЕ(Перечисление.ТипыКлиентов.ЮрЛицо)
                      |			ТОГДА КассовыйДокумент.ОтКого.НаименованиеЮрЛица
                      |		ИНАЧЕ КассовыйДокумент.ОтКого.Наименование
                      |	КОНЕЦ КАК КонтрагентНаименование,
                      |	КассовыйДокумент.СуммаКарта КАК СуммаКарта,
                      |	ВЫБОР
                      |		КОГДА КассовыйДокумент.СуммаНаличные = 0
                      |				И КассовыйДокумент.СуммаКарта > 0
                      |			ТОГДА 1
                      |		ИНАЧЕ ВЫБОР
                      |				КОГДА КассовыйДокумент.СуммаНаличные > 0
                      |						И КассовыйДокумент.СуммаКарта = 0
                      |					ТОГДА 2
                      |				ИНАЧЕ 0
                      |			КОНЕЦ
                      |	КОНЕЦ КАК ТипОплаты,
                      |	ЛОЖЬ КАК ЭтоЭквайринг
                      |ИЗ
                      |	Документ.КассовыйДокумент КАК КассовыйДокумент
                      |		ЛЕВОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
                      |			КассовыйДокументДолгиОплата.Ссылка КАК Ссылка,
                      |			СУММА(КассовыйДокументДолгиОплата.Сумма) КАК Сумма
                      |		ИЗ
                      |			Документ.КассовыйДокумент.ДолгиОплата КАК КассовыйДокументДолгиОплата
                      |		
                      |		СГРУППИРОВАТЬ ПО
                      |			КассовыйДокументДолгиОплата.Ссылка) КАК ДолгиОплата_КД
                      |		ПО КассовыйДокумент.Ссылка = ДолгиОплата_КД.Ссылка
                      |		ЛЕВОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
                      |			КассовыйДокумент.ВозвратДокумент КАК ВозвратДокумент,
                      |			СУММА(КассовыйДокумент.Сумма) КАК Сумма
                      |		ИЗ
                      |			Документ.КассовыйДокумент КАК КассовыйДокумент
                      |		ГДЕ
                      |			КассовыйДокумент.ПометкаУдаления = ЛОЖЬ
                      |		
                      |		СГРУППИРОВАТЬ ПО
                      |			КассовыйДокумент.ВозвратДокумент) КАК Возвраты
                      |		ПО КассовыйДокумент.Ссылка = Возвраты.ВозвратДокумент
                      |ГДЕ
                      |	КассовыйДокумент.ПометкаУдаления = ЛОЖЬ
                      |	И КассовыйДокумент.Сумма - ЕСТЬNULL(Возвраты.Сумма, 0) - ЕСТЬNULL(ДолгиОплата_КД.Сумма, 0) <> 0
                      |	И КассовыйДокумент.Возврат = ЛОЖЬ
                      |	И НЕ КассовыйДокумент.ЭтоПроизвольныйЧек
                      |	И КассовыйДокумент.ДатаОплаты = &ДатаОплаты");		

Запрос.УстановитьПараметр("ДатаОплаты", ДатаОплатыОтбор);		
ТЗ = Запрос.Выполнить().Выгрузить();	

ТЗ_НераспределенныеОплаты = ТЗ.СкопироватьКолонки();
Колонка_ДокументОплаты = ТЗ_НераспределенныеОплаты.Колонки.Найти("ДокументОплаты");
ТЗ_НераспределенныеОплаты.Колонки.Удалить(Колонка_ДокументОплаты);
ТЗ_НераспределенныеОплаты.Колонки.Добавить("ДокументОплаты");

Для Каждого Строка Из ТЗ Цикл
	НоваяСтрока = ТЗ_НераспределенныеОплаты.Добавить();
	ЗаполнитьЗначенияСвойств(НоваяСтрока, Строка);
	
	Если НЕ ЗначениеЗаполнено(Строка.КонтрагентНаименование) Тогда
		Строка.КонтрагентНаименование = Строка.ДокументОплатыОтКого.Наименование;	
	КонецЕсли;
КонецЦикла;

Запрос = Новый Запрос("ВЫБРАТЬ
                      |	NULL КАК Заявка,
                      |	ВыпискаБанка.Ссылка КАК ДокументОплаты,
                      |	NULL КАК СчетГУИД,
                      |	NULL КАК Услуга,
                      |	ВыпискаБанка.Сумма - ЕСТЬNULL(Возвраты.Сумма, 0) - ЕСТЬNULL(ДолгиОплата_ВБ.Сумма, 0) КАК СуммаОплаты,
                      |	ВыпискаБанка.Сумма КАК СуммаДокументаОплаты,
                      |	0 КАК СуммаДокументОплатыКасса,
                      |	0 КАК СуммаНаличные,
                      |	ВЫБОР
                      |		КОГДА ВыпискаБанка.ЭтоЭквайринг
                      |			ТОГДА ВЫБОР
                      |					КОГДА ВыпискаБанка.ТекстПлатежа ПОДОБНО ""%СБП""
                      |						ТОГДА 5
                      |					ИНАЧЕ 4
                      |				КОНЕЦ
                      |		ИНАЧЕ 3
                      |	КОНЕЦ КАК ТипОплаты,
                      |	ВыпискаБанка.ЭтоЭквайринг КАК ЭтоЭквайринг
                      |ИЗ
                      |	Документ.ВыпискаБанка КАК ВыпискаБанка
                      |		ЛЕВОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
                      |			ВыпискаБанкаДолгиОплата.Ссылка КАК Ссылка,
                      |			СУММА(ВыпискаБанкаДолгиОплата.Сумма) КАК Сумма
                      |		ИЗ
                      |			Документ.ВыпискаБанка.ДолгиОплата КАК ВыпискаБанкаДолгиОплата
                      |		
                      |		СГРУППИРОВАТЬ ПО
                      |			ВыпискаБанкаДолгиОплата.Ссылка) КАК ДолгиОплата_ВБ
                      |		ПО ВыпискаБанка.Ссылка = ДолгиОплата_ВБ.Ссылка
                      |		ЛЕВОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
                      |			ВыпискаБанка.ВозвратДокумент КАК ВозвратДокумент,
                      |			СУММА(ВыпискаБанка.Сумма) КАК Сумма
                      |		ИЗ
                      |			Документ.ВыпискаБанка КАК ВыпискаБанка
                      |		ГДЕ
                      |			ВыпискаБанка.ПометкаУдаления = ЛОЖЬ
                      |		
                      |		СГРУППИРОВАТЬ ПО
                      |			ВыпискаБанка.ВозвратДокумент) КАК Возвраты
                      |		ПО ВыпискаБанка.Ссылка = Возвраты.ВозвратДокумент
                      |ГДЕ
                      |	ВыпискаБанка.ПометкаУдаления = ЛОЖЬ
                      |	И ВыпискаБанка.Сумма - ЕСТЬNULL(Возвраты.Сумма, 0) - ЕСТЬNULL(ДолгиОплата_ВБ.Сумма, 0) <> 0
                      |	И ВыпискаБанка.Возврат = Ложь
                      |	И ВыпискаБанка.ДатаОплаты = &ДатаОплаты");

Запрос.УстановитьПараметр("ДатаОплаты", ДатаОплатыОтбор);		
ТЗ = Запрос.Выполнить().Выгрузить();
	
Для Каждого Строка Из ТЗ Цикл
	НоваяСтрока = ТЗ_НераспределенныеОплаты.Добавить();
	ЗаполнитьЗначенияСвойств(НоваяСтрока, Строка);
КонецЦикла;

ТЗ_НераспределенныеОплаты.Колонки.Добавить("ПроцентЭквайринга");
Для Каждого Строка Из ТЗ_НераспределенныеОплаты Цикл
	Запрос = Новый Запрос("ВЫБРАТЬ ПЕРВЫЕ 1
	                  |	ПроцентыЭквайринга.ПроцентЭквайринга КАК ПроцентЭквайринга
	                  |ИЗ
	                  |	РегистрСведений.ПроцентыЭквайринга КАК ПроцентыЭквайринга
	                  |ГДЕ
	                  |	ПроцентыЭквайринга.ДатаУстановкиПроцентаЭквайринга < &ДатаУстановкиПроцентаЭквайринга
	                  |
	                  |УПОРЯДОЧИТЬ ПО
	                  |	ПроцентыЭквайринга.ДатаУстановкиПроцентаЭквайринга УБЫВ");

	Запрос.УстановитьПараметр("ДатаУстановкиПроцентаЭквайринга", Строка.ДокументОплаты.ДатаОплаты);

	ТЗ = Запрос.Выполнить().Выгрузить();
	ПроцентЭквайринга = ?(ТЗ.Количество() = 0, 0, ТЗ[0].ПроцентЭквайринга); 			
	
	Строка.ПроцентЭквайринга = ПроцентЭквайринга;
КонецЦикла;

Для Каждого СтрокаНераспределенныеОплаты Из ТЗ_НераспределенныеОплаты Цикл
	Если ФормаОплатыОтбор <> "" Тогда
		Если ФормаОплатыОтбор <> ОтчетыСервер.ТипОплатыНаименование(СтрокаНераспределенныеОплаты.ТипОплаты) 
		Тогда Продолжить; КонецЕсли;
	КонецЕсли;	
	
	Область = Макет.ПолучитьОбласть("СтрокаНераспределенныеОплатыДополнение|КолонкиЛево");
	
	Область.Параметры.Дата = ".";
	
	Область.Параметры.ТипОплаты = ОтчетыСервер.ТипОплатыНаименование(СтрокаНераспределенныеОплаты.ТипОплаты);
	Область.Параметры.ДатаОплаты = Формат(СтрокаНераспределенныеОплаты.ДокументОплаты.ДатаОплаты, "ДФ=dd.MM.yy");
	
	СуммаОплаты = СтрокаНераспределенныеОплаты.СуммаОплаты;
	Область.Параметры.СуммаОплаты = СуммаОплаты;
	Область.Параметры.РасшифровкаДокументОплаты = СтрокаНераспределенныеОплаты.ДокументОплаты;
	
	//Область.Параметры.Оплатил = СтрокаНераспределенныеОплаты.ДокументОплаты.ОтКого;
	Область.Параметры.Оплатил = ОтчетыСервер.ОплатилНаименование(СтрокаНераспределенныеОплаты);
	
	СуммаЭквайринга = ОтчетыСервер.СуммаЭквайринга(СтрокаНераспределенныеОплаты);
	Область.Параметры.СуммаЭквайринга = СуммаЭквайринга;
	
	ПолеОтчета.Вывести(Область, 0);
	
	ИтогиДень.СуммаОплаты = ИтогиДень.СуммаОплаты + СуммаОплаты;
	
	ИтогиДень.СуммаЭквайринга = ИтогиДень.СуммаЭквайринга + СуммаЭквайринга;  

КонецЦикла;

	// - Нераспределенные оплаты

Область = Макет.ПолучитьОбласть("ИтогиДень|КолонкиЛево");

//Дата = Формат(ДатаОплатыОтбор, "ДФ='д.МММ гг'" );  
//Область.Параметры.Дата = Дата;		
Область.Параметры.Дата = ".";		


//Месяц = Формат(Дата_П, "ДФ='МММ гг'" );  
//Область.Параметры.Месяц = Месяц;		

//ДеньНедели = Формат(Дата_П, "ДФ=дддд");   
//Область.Параметры.ДеньНедели = ДеньНедели;

//Область.Параметры.Номер = "Итого Ночей:";
//Область.Параметры.КатегорияНомера = ИтогиДень.КоличествоНочей;
//Область.Параметры.ЦенаПроживание = ИтогиДень.СуммаЦенаПроживание;
Область.Параметры.СуммаПроживание = ИтогиДень.СуммаПроживание;
//Область.Параметры.КоличествоСутокТариф = ИтогиДень.КоличествоСутокТариф;
//Область.Параметры.СуммаКомиссии = ИтогиДень.СуммаКомиссии;
//Область.Параметры.ПолнаяСуммаКомиссии = ИтогиДень.ПолнаяСуммаКомиссии;
Область.Параметры.СуммаОплаты = ИтогиДень.СуммаОплаты;
Область.Параметры.СуммаЭквайринга = ИтогиДень.СуммаЭквайринга;
//Область.Параметры.СуммаНомера = ИтогиДень.СуммаНомера;

//Область.Параметры.КоличествоСтатус = ИтогиДень.КоличествоСтатус;
//Область.Параметры.КоличествоЗавтраки = ИтогиДень.КоличествоЗавтраки;
ПолеОтчета.Вывести(Область, 0);

Для Каждого СтрокаУслугиИтого Из ИтогиДень.УслугиДеньИтоги Цикл
	ОбластьУслуги = Макет.ПолучитьОбласть("ИтогиДень|КолонкаУслуги");
	Если СтрокаУслугиИтого.СуммаУслуги <> 0 Тогда
		ОбластьУслуги.Параметры.СуммаУслуги = СтрокаУслугиИтого.СуммаУслуги;
	КонецЕсли;	
	ПолеОтчета.Присоединить(ОбластьУслуги, 0);
КонецЦикла;

Возврат ПолеОтчета;
КонецФункции

