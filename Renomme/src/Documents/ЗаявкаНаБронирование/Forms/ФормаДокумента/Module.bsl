&НаКлиенте
Процедура КатегорияНомераПриИзменении(Элемент)
Если НЕ ЗначениеЗаполнено(Объект.КатегорияНомера) Тогда Возврат; КонецЕсли;
Если НЕ ЗначениеЗаполнено(КатегорияНомера_OldValue) Тогда Возврат; КонецЕсли;

Если Объект.КатегорияНомера <> КатегорияНомера_OldValue Тогда 
	Если ЗначениеЗаполнено(КатегорияНомера_OldValue) Тогда 
		ПоказатьПредупреждение(, "ВНИМАНИЕ ! Изменилась категория номера." 
		+ Символы.ПС + Символы.ПС + "Перезаполните расчет проживания (при необходимости)");  		
	КонецЕсли;			
	
	КатегорияНомера_OldValue = Объект.КатегорияНомера;
КонецЕсли;

КонецПроцедуры

//// + НомерВрезерв
&НаКлиенте
Процедура НомерВРезервПриИзменении(Элемент)
Если НЕ (ЗначениеЗаполнено(Объект.РезервС) И ЗначениеЗаполнено(Объект.РезервПо)) Тогда 
	Объект.НомерВРезерв = Неопределено;
	Возврат; 
КонецЕсли;

Если ЗначениеЗаполнено(Объект.НомерВРезерв) Тогда	
	Объект.ЛистОжидания = Ложь;
КонецЕсли;

Если НЕ ЗначениеЗаполнено(Объект.КатегорияНомера) Тогда 
	КатегорияНомера = ОбщийФункционалСервер.ЗначениеРеквизитаНаСервере(Объект.НомерВРезерв, "КатегорияНомера"); 
	Объект.КатегорияНомера = КатегорияНомера;
КонецЕсли;
	
Если ДеньНедели(Объект.РезервС)>=5 или  ДеньНедели(Объект.РезервС)=1 тогда
	Если ЗаявкаСервер.ПроверкаСоседей(Объект.НомерВРезерв, Объект.РезервС, Объект.РезервПо) тогда
		ПоказатьПредупреждение(,"Внимание! на период проживания в соседних номерах есть гости");	
	КонецЕсли;
КонецЕсли;
КонецПроцедуры

