//Перем ПеретН,ПеретК,ТекКоорд,ТЗШахм,Ошибка,ТекДатаШахматки;
Перем ПеретН, ПеретК, ТекКоорд, Ошибка;  

//
&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
Коворкинг = Константы.Коворкинг.Получить();
Элементы.ПодменюКоворкинг.Видимость = Коворкинг;

Если НЕ НастройкиСервер.ТекущийПользовательКодРавноАдминистратор() Тогда
	Минибар_Нет = Константы.Минибар_Нет.Получить();
	ЕстьПраво = НастройкиСервер.ПользовательЕстьПраво(Перечисления.ПраваПользователя.МинибарРасчет);
	
	Минибар_Видимость = (НЕ Минибар_Нет) И ЕстьПраво; 
	Элементы.ПодменюМинибар.Видимость = Минибар_Видимость;	
	
	ЕстьПраво = НастройкиСервер.ПользовательЕстьПраво(Перечисления.ПраваПользователя.Горничные);
	Элементы.ПодменюГорничные.Видимость = ЕстьПраво;
	
	ОбменСГорничными = Константы.ОбменСГорничными.Получить();
	Если ОбменСГорничными Тогда
		//Если ЕстьПраво Тогда
			//Помещения_Есть = Константы.Помещения_Да.Получить();
			Запрос = Новый Запрос("ВЫБРАТЬ
			                      |	ГорничныеПомещения.Ссылка КАК Ссылка
			                      |ИЗ
			                      |	Справочник.ГорничныеПомещения КАК ГорничныеПомещения
			                      |ГДЕ
			                      |	ГорничныеПомещения.ПометкаУдаления = ЛОЖЬ");
			
			Результат = Запрос.Выполнить();
			Помещения_Есть = НЕ Результат.Пустой(); 
			
			Элементы.ОтчетГорничныеПомещения.Видимость = Помещения_Есть;
		//КонецЕсли;
		
		Элементы.ГорничныеПомещенияСправочник.Видимость = Ложь;
	Иначе
		//Элементы.ПодменюГорничные.Видимость = Ложь;
		
		Элементы.ГорничныеПомещенияСправочник.Видимость = Истина;
		
		Элементы.ОтчетПоГорничнымКоманда.Видимость = Ложь;
		
		Элементы.ОтчетПоГорничнымКоманда_Подменю.Видимость = Ложь;
		Элементы.ОтчетГорничныеПомещения.Видимость = Ложь;
		Элементы.ОтчетГорничныеЗакрытиеСмены.Видимость = Ложь;
	КонецЕсли;	
	
	Если НастройкиСервер.ЭтоДомСоветов() 
	ИЛИ НастройкиСервер.ЭтоСтритАрт()
	Тогда
		Элементы.ГорничныеПрачечная.Видимость = Ложь;
	КонецЕсли;
	
	ЕстьПраво = НастройкиСервер.ПользовательЕстьПраво(Перечисления.ПраваПользователя.Администраторы);
	Элементы.ПодменюЗарплатаАдминистраторы.Видимость = ЕстьПраво;
	
	ЭтоАдминистратор = НастройкиСервер.ЭтоАдминистратор();
	Элементы.ПодменюКалендарьЦен.Видимость = ЭтоАдминистратор;
	
	ЕстьПраво = НастройкиСервер.ПользовательЕстьПраво(Перечисления.ПраваПользователя.СписаниеДолгов);
	Элементы.ПодменюЗакрытие.Видимость = ЕстьПраво;
	
	ЕстьПраво = НастройкиСервер.ПользовательЕстьПраво(Перечисления.ПраваПользователя.Бухгалтерия);
	Элементы.Бухгалтерия.Видимость = ЕстьПраво;
	
	//Если НастройкиСервер.ЭтоРеноме()
	//ИЛИ НастройкиСервер.ЭтоДомСоветов()
	//Тогда
	//	Элементы.БезналРаспределениеКоворкинг.Видимость = Ложь;
	//	Элементы.БезналРаспределениеОтель.Видимость = Ложь;
	//	
	//	Элементы.ПодменюКоворкингОперации.Видимость = Ложь;
	//Иначе
	//	Элементы.БезналРаспределение.Видимость = Ложь;
	//	
	//	//Если НЕ НастройкиСервер.ЭтоСтритАрт() Тогда
	//		Элементы.ПодменюКоворкингОперации.Видимость = Ложь;
	//	//Иначе
	//		//ТекущаяОрганизация = НастройкиСервер.ПолучитьТекущуюОрганизацию();
	//		//КоворкингОрганизацияЕсть = ОбщийФункционалСервер.ЗначениеРеквизитаНаСервере(ТекущаяОрганизация, "КоворкингОрганизацияЕсть");
	//		//Элементы.ПодменюКоворкингОперации.Видимость = КоворкингОрганизацияЕсть;
	//	//КонецЕсли;
	//КонецЕсли;
	
	Элементы.БезналРаспределениеКоворкинг.Видимость = Ложь;
	Элементы.БезналРаспределениеОтель.Видимость = Ложь;
	Элементы.ПодменюКоворкингОперации.Видимость = Ложь;
	
	Если НастройкиСервер.ЭтоСтритАрт() Тогда
		Разрешено = НастройкиСервер.ЭтоАдмин();
		Если Разрешено Тогда
			Элементы.ЧекПроизвольный.Видимость = Истина;
		Иначе	
			Элементы.ЧекПроизвольный.Видимость = Ложь;
		КонецЕсли;
	Иначе	
		Элементы.ЧекПроизвольный.Видимость = Ложь;
	КонецЕсли;
	
	Если НастройкиСервер.ЭтоРеноме() 	
	ИЛИ НастройкиСервер.ЭтоЧехов() 
	ИЛИ НастройкиСервер.ЭтоСтритАрт() 
	Тогда
		Элементы.СайтЗаявки.Видимость = Истина;
	Иначе
		Элементы.СайтЗаявки.Видимость = Ложь;
	КонецЕсли;
	
	Если НастройкиСервер.ЭтоЛайв() Тогда
		Элементы.ОтчетТрэвелЛайн.Видимость = Истина;
	Иначе
		Элементы.ОтчетТрэвелЛайн.Видимость = Ложь;
	КонецЕсли;
	
	Если НастройкиСервер.ЭтоРеноме() Тогда
		Элементы.ЕжедневныйОтчетФактСводный.Видимость = Истина;
	Иначе
		Элементы.ЕжедневныйОтчетФактСводный.Видимость = Ложь;
	КонецЕсли;	
	
	//Если НЕ НастройкиСервер.ЭтоСтритАрт() Тогда
	//	Элементы.ЗаполнитьДанныеОрганизацияСДанныхКоворкинг.Видимость = Ложь;		
	//КонецЕсли;
	
КонецЕсли;
КонецПроцедуры
//


//// + Переговорная
&НаСервере
Функция ВывестиШахматкуЧасы(ДатаС, ДатаПо)

ТЗШахматкаЧасы.Очистить();

//ДатаС=?(Детализация="День",НачалоДня(ДатаС),НачалоЧаса(ДатаС));
ДатаС = НачалоЧаса(ДатаС);
ДатаПо = НачалоЧаса(ДатаПо);

Запрос=Новый Запрос("ВЫБРАТЬ
                    |	ЗанятостьНомеровКоворкинг.Регистратор КАК Регистратор,
                    |	ЗанятостьНомеровКоворкинг.Регистратор.КоворкингЗаявка.КоворкингНомер КАК КоворкингНомер,
                    |	ЗанятостьНомеровКоворкинг.Регистратор.КоворкингЗаявка.Клиент КАК Клиент,
                    |	ЗанятостьНомеровКоворкинг.ПериодРезерва КАК ПериодРезерва,
                    |	ЗанятостьНомеровКоворкинг.Регистратор.Сумма КАК СуммаСчета,
                    |	Оплаты.СуммаРаспределено КАК СуммаРаспределено
                    |ИЗ
                    |	РегистрСведений.ЗанятостьНомеровКоворкинг КАК ЗанятостьНомеровКоворкинг
                    |		ЛЕВОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
                    |			КоворкингСчетаДокументыОплаты.Ссылка КАК СчетСсылка,
                    |			СУММА(КоворкингСчетаДокументыОплаты.СуммаРаспределено) КАК СуммаРаспределено
                    |		ИЗ
                    |			Документ.КоворкингСчета.ДокументыОплаты КАК КоворкингСчетаДокументыОплаты
                    |		
                    |		СГРУППИРОВАТЬ ПО
                    |			КоворкингСчетаДокументыОплаты.Ссылка) КАК Оплаты
                    |		ПО ЗанятостьНомеровКоворкинг.Регистратор.Ссылка = Оплаты.СчетСсылка
                    |ГДЕ
                    |	ЗанятостьНомеровКоворкинг.Регистратор.ПочасоваяОплата = ИСТИНА
                    |	И ТИПЗНАЧЕНИЯ(ЗанятостьНомеровКоворкинг.Регистратор) = ТИП(Документ.КоворкингСчета)
                    |	И ЗанятостьНомеровКоворкинг.ПериодРезерва МЕЖДУ &ДатаС И &ДатаПо");

Запрос.УстановитьПараметр("ДатаС",ДатаС);						
Запрос.УстановитьПараметр("ДатаПо",ДатаПо);
ТЗЗапроса = Запрос.Выполнить().Выгрузить(); 

ТЗЗапроса.Колонки.Добавить("Статус");
Для Каждого Строка Из ТЗЗапроса Цикл
	//Если Строка.СуммаСчета = Null Тогда
	//	Строка.Статус = "НЕТ СЧЕТОВ";
	//Иначе
		Если Строка.СуммаРаспределено = Null Тогда
			Строка.Статус = "НЕТ ОПЛАТ";
		ИначеЕсли Строка.СуммаРаспределено = 0 Тогда
			Строка.Статус = "НЕТ ОПЛАТ";
		ИначеЕсли Строка.СуммаРаспределено < Строка.СуммаСчета Тогда
			Строка.Статус = "ЧАСТИЧНО ОПЛАЧЕНО";
		Иначе
			Строка.Статус = "ОПЛАЧЕНО";
	    КонецЕсли;
	//КонецЕсли;
КонецЦикла;

ТЗКлиентов = ТЗЗапроса.Скопировать();
ТЗКлиентов.Свернуть("Клиент, Регистратор, Статус") ;
ТЗКлиентов.Колонки.Добавить("Цвет");

Сч=0;

//Если ТипЗнч(ТекРегистратор) = Тип("ДокументСсылка.КоворкингЗаявка") Тогда
//	Цвет_П = Новый Цвет(210, 245, 220); 
//	ШрифтПолужирный_П = Ложь;
//ИначеЕсли СтрокаСчета.РегистраторСуммаРаспределено = 0 Тогда
//	Цвет_П = Новый Цвет(220, 220, 220); 
//	ШрифтПолужирный_П = Истина;
//ИначеЕсли СтрокаСчета.РегистраторСумма > СтрокаСчета.РегистраторСуммаРаспределено Тогда
//	Цвет_П = Новый Цвет(200, 240, 240); 
//	ШрифтПолужирный_П = Истина;
//Иначе
//	Цвет_П = WebЦвета.Белый;  				
//	ШрифтПолужирный_П = Истина;
//КонецЕсли;

Для каждого Клиент Из ТЗКлиентов Цикл	
	Если Клиент.Статус = "ОПЛАЧЕНО" тогда
		Клиент.Цвет=Новый Цвет(255,255,255);
	иначеесли Клиент.Статус = "ЧАСТИЧНО ОПЛАЧЕНО" тогда
		Клиент.Цвет=Новый Цвет(200, 240, 240);
	иначеесли Клиент.Статус = "НЕТ ОПЛАТ" тогда
		Клиент.Цвет=Новый Цвет(220, 220, 220);   
	иначе
		Если Клиент.Клиент.ЦветR<>0 Или  Клиент.Клиент.ЦветG<>0 или  Клиент.Клиент.ЦветB<>0 тогда	
			Клиент.Цвет=Новый Цвет(Клиент.Клиент.ЦветR,Клиент.Клиент.ЦветG,Клиент.Клиент.ЦветB);
		иначе
			Клиент.Цвет = СлучайныйЦвет(ТЗКлиентов);
		КонецЕсли;
	конецесли;
КонецЦикла; 

ПолеШахматкиЧасы.Очистить();

ИмяОбработки = ОбщийФункционалКлиентСервер.ИмяОбработки(ЭтаФорма);
//Макет = Обработки.КоворкингШахматка.ПолучитьМакет("МакетШахматкаДни");
Макет = Обработки[ИмяОбработки].ПолучитьМакет("МакетШахматкаДни");

НачальныйЧас = Константы.КоворкингНачальныйЧас.Получить();
Если НачальныйЧас = 0 Тогда НачальныйЧас = 8; КонецЕсли;

КонечныйЧас = Константы.КоворкингКонечныйЧас.Получить() - 1;
Если КонечныйЧас = 0 Тогда КонечныйЧас = 21; КонецЕсли;
КонечныйЧас = КонечныйЧас - 1;

ТемпС = ДатаС;
ТемпПо = ДатаПо;

ТабДок=Новый ТабличныйДокумент;
Обл=Макет.ПолучитьОбласть("Шапка|ШапкаВерх");
ТабДок.Присоединить(Обл);

ТЗОбъеденения=Новый ТаблицаЗначений();
ТЗОбъеденения.Колонки.Добавить("КолонкаС");
ТЗОбъеденения.Колонки.Добавить("КолонкаПо");
ТЗОбъеденения.Колонки.Добавить("ДТ");

Обл=Макет.ПолучитьОбласть("Шапка|СтрПериод");

Нов=ТЗОбъеденения.Добавить();
Нов.КолонкаС=2;
Нов.КолонкаПо=2;

ТемпДень=НачалоДня(ТемпС);
Нов.ДТ=Формат(ТемпДень, "ДФ=dd.MM");

ТекКол=2;

Пока ТемпС<=ТемпПо цикл
	Час = Час(ТемпС);
	Если Час >= НачальныйЧас И Час <= КонечныйЧас Тогда 
		Если НачалоДня(ТемпС)>ТемпДень тогда
			// новый день
			Нов.КолонкаПо=ТекКол-1;
			Нов=ТЗОбъеденения.Добавить();
			Нов.КолонкаС=ТекКол;
			Нов.КолонкаПо=ТекКол+1;
			ТемпДень=НачалоДня(ТемпС);
			Нов.ДТ=Формат(ТемпДень, "ДФ=dd.MM");	
		конецесли;
	
		//Обл.Параметры.Период = Формат(ТемпС, "ДФ='HH:mm'");
		Обл.Параметры.Период = Формат(ТемпС, "ДФ='HH'");
		ТабДок.Присоединить(Обл);
	
		ТекКол=ТекКол+1;
	КонецЕсли; 	
	
	//ТемпС=ТемпС+?(Детализация="День",86400,3600*6);
	ТемпС = ТемпС + 3600;
КонецЦикла;

Нов.КолонкаПо=ТекКол-1;
Для каждого Об Из ТЗОбъеденения Цикл
	ТабДок.Область(2,Об.КолонкаС+1,2,Об.КолонкаС+1).Текст=Об.ДТ;
	
	ТабДок.Область(2,Об.КолонкаС+1,2,Об.КолонкаПо+1).Объединить();
КонецЦикла; 

ПолеШахматкиЧасы.Вывести(ТабДок);
////// + Вывод Верхних строк с датами

//Возврат Неопределено;

Запрос = Новый Запрос("ВЫБРАТЬ
                      |	КоворкингНомера.Ссылка КАК Ссылка,
                      |	КоворкингНомера.Наименование КАК Наименование,
                      |	КоворкингНомера.ОписаниеНомера КАК ОписаниеНомера,
                      |	КоворкингНомера.ЦветНомераB КАК ЦветНомераB,
                      |	КоворкингНомера.ЦветНомераG КАК ЦветНомераG,
                      |	КоворкингНомера.ЦветНомераR КАК ЦветНомераR
                      |ИЗ
                      |	Справочник.КоворкингНомера КАК КоворкингНомера
                      |ГДЕ
                      |	КоворкингНомера.ПометкаУдаления = ЛОЖЬ
                      |	И КоворкингНомера.ПочасоваяОплата = ИСТИНА");
СпрНомеров = Запрос.Выполнить().Выбрать();

Х=0;
У=0;

Пока СпрНомеров.Следующий() цикл
	//Если СпрНомеров.ПометкаУдаления Тогда Продолжить; КонецЕсли;
	
	У=У+1;
	
	ТабДок=Новый ТабличныйДокумент;
	
	Обл=Макет.ПолучитьОбласть("Строка|ШапкаВерх");
	Обл.Параметры.Номер=СпрНомеров.Наименование;
	Если Не СпрНомеров.ЦветНомераB+СпрНомеров.ЦветНомераG+СпрНомеров.ЦветНомераR=0 тогда
		Обл.Область(1,2,1,2).ЦветФона=Новый Цвет(СпрНомеров.ЦветНомераR,СпрНомеров.ЦветНомераG,СпрНомеров.ЦветНомераB);
		Обл.Область(1,2,1,2).ЦветТекста = ОбщийФункционалСервер.ПолучитьЦветТекстаПоЦветуФона(Обл.Область(1,2,1,2).ЦветФона);
	конецесли;
	
    Обл.Область(1,1,1,1).Расшифровка=СпрНомеров.ОписаниеНомера;
	ТабДок.Присоединить(Обл);
	
	ТемпКл=Справочники.Клиенты.ПустаяСсылка();
	
	ТемпРегистратор=Документы.КоворкингСчета.ПустаяСсылка();
	
	СписОб=Новый СписокЗначений;                            
	Сч=2;
	НачИ=3;	
	Х=0;
	
	ТемпС=ДатаС;
	ТемпПо=ДатаПо;
	
	Пока ТемпС<=ТемпПо цикл
		//Х=Х+1;	
		
		ПС = НачалоЧаса(ТемпС);
		ПК = КонецЧаса(ТемпС);
		
		Час = Час(ПС); 
		Если Час >= НачальныйЧас И Час <= КонечныйЧас Тогда 
		
			Х=Х+1;	
			
			Отбор=Новый Структура("ПериодРезерва, КоворкингНомер", ПС, СпрНомеров.Ссылка);
			СтрокиНом=ТЗЗапроса.НайтиСтроки(Отбор);
			Обл=Макет.ПолучитьОбласть("Строка|СтрПериод");

			Если СтрокиНом.Количество() <> 0 тогда
				ТекКл = СтрокиНом[0].Клиент;
				ТекРегистратор = СтрокиНом[0].Регистратор;
				
				//ТекСтатус = СтрокиНом[0].Статус;
				
				ОтборСтроки = Новый Структура("Клиент, Регистратор", ТекКл, ТекРегистратор); 
				НайденныеСтроки = ТЗКлиентов.НайтиСтроки(ОтборСтроки);
				КлСтат = НайденныеСтроки[0];
				Цв = КлСтат.Цвет;
				
				Обл.Область(1,1,1,1).ЦветФона=Цв;
				Обл.Область(1,1,1,1).ЦветТекста = ОбщийФункционалСервер.ПолучитьЦветТекстаПоЦветуФона(Обл.Область(1,1,1,1).ЦветФона);
					
				ШрифтПолужирный_П = (КлСтат.Статус <> "НЕТ СЧЕТОВ");  
				ШрифтТекста = Новый Шрифт(Обл.Область(1,1,1,1).Шрифт,,,ШрифтПолужирный_П);
