&НаСервере
Процедура ВыполнитьКомандаНаСервере()  
Для каждого СтрТаб Из Объект.ДанныеПоМинибару Цикл
	Если СтрТаб.Принять тогда
		ОбДок=СтрТаб.Бронь.ПолучитьОбъект();
		СпрТов=Справочники.Товары.Выбрать();
		Пока СпрТов.Следующий() цикл
			
			КолВо=СтрЧислоВхождений(СтрТаб.МиниБарОтГорничной,СпрТов.НазваниеУГорничной);
			Если КолВо>0 тогда
				ПоискУсл=Справочники.ДопУслуги.НайтиПоРеквизиту("Товар",СпрТов.Ссылка);
				Если НЕ ПоискУсл.Пустая() тогда
				НовТов=ОбДок.ДопУслуги.Добавить();
				НовТов.ВремяУборки=СтрТаб.ВремяУборки;
				НовТов.ДатаУслуги= Объект.ДатаУборки;  
				НовТов.КолВо=КолВо;
				НовТов.ОтГорничной=Истина;
				НовТов.Услуга=ПоискУсл.Ссылка;
				НовТов.Цена=ПоискУсл.Цена;
				конецесли;
			конецесли;
			
		КонецЦикла;
		 ОбДок.Записать(РежимЗаписиДокумента.Проведение,РежимПроведенияДокумента.Неоперативный);
		 НЗ=РегистрыСведений.УборкиНомеров.СоздатьНаборЗаписей();
		 НЗ.Отбор.ВремяУброки.Установить(СтрТаб.ВремяУборки);
		 НЗ.Отбор.Комната.Установить(СтрТаб.НомерКомнаты);
		 НЗ.Прочитать();
		 Для каждого Стр Из НЗ Цикл			 
			 Стр.КомментарийАдминистрации=Стр.КомментарийАдминистрации+"<Минибар зафиксирован>";
		 КонецЦикла;      
		 НЗ.Записать();
		 
	 конецесли;
	
		
	

 КонецЦикла; 
 
 ЗаполнитьТаблицуНаСервере();
 
