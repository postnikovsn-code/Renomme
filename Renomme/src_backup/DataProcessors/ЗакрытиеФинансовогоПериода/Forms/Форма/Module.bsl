&НаКлиенте
Процедура ЗаполнитьКомментарийПолеОтчета(Комментарий, Заявка, Полеотчета, НомерКомментарий)
ОбластьНайдено = Полеотчета.НайтиТекст(Заявка); 	

Если ОбластьНайдено = Неопределено Тогда Возврат; КонецЕсли;

Имя = ОбластьНайдено.Имя;
Индекс = СтрНайти(Имя, "C") - 2;
ИмяСтроки = "R" + Сред(Имя, 2, Индекс);
ИмяОбласть = ИмяСтроки + "C" + Строка(НомерКомментарий);

ПолеОтчета.Область(ИмяОбласть).Значение = Комментарий;
КонецПроцедуры

