Процедура ПечатьГрупповогоУПД(ТабДок, Номер, Дата, Групповойсчет) Экспорт
Макет = ПолучитьОбщийМакет("ПФ_MXL_УниверсальныйПередаточныйДокумент2026");

ДатаУчетаНДС = ГрупповойСчетСервер.ДатаУчетаНДС(Групповойсчет);

ТекущаяОрганизация = НастройкиСервер.ПолучитьТекущуюОрганизацию();
СтавкаНДС = ТекущаяОрганизация.СтавкаНДС; СтавкаНДС = ДокументыСервер.СтавкаНДСТекущая(СтавкаНДС, ДатаУчетаНДС);
ВсеСНДС = ТекущаяОрганизация.ВсеСНДС;

Контрагент = Групповойсчет.Контрагент; 
СвернутьВСчете = Групповойсчет.СвернутьВСчете;

Область = Макет.ПолучитьОбласть("Шапка");

Область.Параметры.СтатусУПД = 1;    

Область.Параметры.Номер = Номер;
Область.Параметры.Дата = Формат(Дата, "ДФ=dd.MM.yyyy");

ДокументОтгрузки = "Акт № " + Номер + " от " + Формат(Дата, "ДФ=dd.MM.yyyy"); 
Область.Параметры.ДокументыОбОтгрузке = ДокументОтгрузки;
	
Продавец = ТекущаяОрганизация.ОрганизацияДляДокументов;
АдресПродавца = ТекущаяОрганизация.ОрганизацияАдресДляДокументов;
ИННКПППродавца = ТекущаяОрганизация.ИНН + "/" + ТекущаяОрганизация.КПП;

Область.Параметры.ПредставлениеПоставщика = Продавец;
Область.Параметры.АдресПоставщика = АдресПродавца;
Область.Параметры.ИННПоставщика = ИННКПППродавца;

Область.Параметры.ПредставлениеПокупателя = ?(ЗначениеЗаполнено(Контрагент.НаименованиеЮрЛица)
									, Контрагент.НаименованиеЮрЛица, Контрагент.Наименование);
Область.Параметры.АдресПокупателя = Контрагент.Адрес;
Область.Параметры.ИННПокупателя = Контрагент.ИНН + "/" + Контрагент.КПП;

ТабДок.Вывести(Область);

Область = Макет.ПолучитьОбласть("ЗаголовокТаблицы");
ТабДок.Вывести(Область);

//
ДокументыДолги = ГрупповойСчет.ДокументыДолги; 

сч=0;

ИтогоСумма = 0;
ИтогоСуммаБезНДС = 0;
ИтогоСуммаНДС = 0;

СтрокиСчетаФактуры = ГрупповойСчетФактурыСтроки(Групповойсчет);

Для каждого СчетФактураСтрока Из СтрокиСчетаФактуры Цикл
	Область = Макет.ПолучитьОбласть("Строка");
	
	Область.Параметры.НомерСтроки = СчетФактураСтрока.НомерСтроки;
	Область.Параметры.ТоварНаименование	 = СчетФактураСтрока.НаименованиеТовара;
	Область.Параметры.ЕдиницаИзмеренияКод = СчетФактураСтрока.КодЕдиницыИзмерения;
	Область.Параметры.ЕдиницаИзмеренияКод = СчетФактураСтрока.ЕдиницаИзмерения;
	Область.Параметры.Количество = СчетФактураСтрока.Количество;
	Область.Параметры.Цена = СчетФактураСтрока.Цена;
	Область.Параметры.Стоимость = СчетФактураСтрока.СуммаБезНДС;
	Область.Параметры.СтавкаНДС = СчетФактураСтрока.НалоговаяСтавка;
	Область.Параметры.СуммаНДС = СчетФактураСтрока.СуммаНДС;
	Область.Параметры.Всего = СчетФактураСтрока.СуммаСНДС;

	ТабДок.Вывести(Область);

	ИтогоСумма = ИтогоСумма + СчетФактураСтрока.СуммаСНДС;
	ИтогоСуммаБезНДС = ИтогоСуммаБезНДС + СчетФактураСтрока.СуммаБезНДС;
	ИтогоСуммаНДС = ИтогоСуммаНДС + СчетФактураСтрока.СуммаНДС;
КонецЦикла;

//
Область = Макет.ПолучитьОбласть("Итого");

Область.Параметры.ИтогоСтоимость = ИтогоСуммаБезНДС;
Область.Параметры.ИтогоСуммаНДС = ИтогоСуммаНДС;
Область.Параметры.ИтогоВсего = ИтогоСумма;

ТабДок.Вывести(Область);

Область = Макет.ПолучитьОбласть("Подвал");

Область.Параметры.ФИОРуководителя =  ТекущаяОрганизация.ОрганизацияФИОРуководительДляДокументов;
Область.Параметры.ФИОГлавногоБухгалтера =  ТекущаяОрганизация.ОрганизацияФИОБухгалтерДляСчетаФактуры;

ТабДок.Вывести(Область);
//

ТабДок.ОриентацияСтраницы = ОриентацияСтраницы.Ландшафт;
ТабДок.АвтоМасштаб = Истина;
КонецПроцедуры
