ТабличноеПолеСМС.Отбор.Элементы.Очистить();

НовЭлементОтбора = ТабличноеПолеСМС.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
НовЭлементОтбора.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("Бронь"); 
НовЭлементОтбора.ВидСравнения = ВидСравненияКомпоновкиДанных.Равно;
