	Область.Параметры.РезервПо = Формат(Строка.РезервПо, "ДФ=dd.MM.yy");
	
	Область.Параметры.Заявка = Строка.ЗаявкаНаБронирование.Номер + " от " + Формат(Строка.ЗаявкаНаБронирование.Дата, "ДФ=dd.MM.yy");
	Область.Параметры.ЗаявкаНаБронирование = Строка.ЗаявкаНаБронирование;
	
	Если Строка.СуммаПроживаниеСчета <> Строка.СуммаПроживание Тогда
		Область.Область(1, НомерКолонкиСуммаПроживание, 1, НомерКолонкиСуммаПроживание).ЦветТекста = WebЦвета.Красный;
	КонецЕсли;
	
	Если Строка.СуммаУслугиСчета <> Строка.СуммаУслуги Тогда
		Область.Область(1, НомерКолонкиСуммаУслуги, 1, НомерКолонкиСуммаУслуги).ЦветТекста = WebЦвета.Красный;
	КонецЕсли;
	
	//
	Запрос = Новый Запрос("ВЫБРАТЬ
	                      |	ЗаявкаНаБронированиеРаспределениеОплатДолги.Ссылка КАК Ссылка,
	                      |	СУММА(ЗаявкаНаБронированиеРаспределениеОплатДолги.СуммаОплаты) КАК СуммаОплаты,
	                      |	ЗаявкаНаБронированиеРаспределениеОплатДолги.ДокументОплаты.ВидОперации КАК ДокументОплатыВидОперации,
	                      |	ЗаявкаНаБронированиеРаспределениеОплатДолги.Услуга КАК Услуга,
	                      |	ЗаявкаНаБронированиеРаспределениеОплатДолги.ДолгиГУИД КАК ДолгиГУИД
	                      |ИЗ
	                      |	Документ.ЗаявкаНаБронирование.РаспределениеОплатДолги КАК ЗаявкаНаБронированиеРаспределениеОплатДолги
	                      |ГДЕ
	                      |	ЗаявкаНаБронированиеРаспределениеОплатДолги.Ссылка = &ДокументДолг
	                      |	И ТИПЗНАЧЕНИЯ(ЗаявкаНаБронированиеРаспределениеОплатДолги.ДокументОплаты) = ТИП(Документ.ПрочиеОплаты)
	                      |	И (ЗаявкаНаБронированиеРаспределениеОплатДолги.ДокументОплаты.ВидОперации = ЗНАЧЕНИЕ(Справочник.ВидыОпераций.Списание)
	                      |			ИЛИ ЗаявкаНаБронированиеРаспределениеОплатДолги.ДокументОплаты.ВидОперации = ЗНАЧЕНИЕ(Справочник.ВидыОпераций.СписаниеЗачет)
	                      |			ИЛИ ЗаявкаНаБронированиеРаспределениеОплатДолги.ДокументОплаты.ВидОперации = ЗНАЧЕНИЕ(Справочник.ВидыОпераций.СписаниеДопУслуг))
	                      |
	                      |СГРУППИРОВАТЬ ПО
	                      |	ЗаявкаНаБронированиеРаспределениеОплатДолги.Ссылка,
	                      |	ЗаявкаНаБронированиеРаспределениеОплатДолги.ДокументОплаты.ВидОперации,
	                      |	ЗаявкаНаБронированиеРаспределениеОплатДолги.Услуга,
	                      |	ЗаявкаНаБронированиеРаспределениеОплатДолги.ДолгиГУИД
	                      |
	                      |УПОРЯДОЧИТЬ ПО
	                      |	ДокументОплатыВидОперации");

	Запрос.УстановитьПараметр("ДокументДолг", Строка.ДокументДолг); 

	ТЗ_СписанияДолгиГУИД = Запрос.Выполнить().Выгрузить();
	
	ТЗ_Списания = ТЗ_СписанияДолгиГУИД.Скопировать();
	ТЗ_Списания.Свернуть("Ссылка, ДокументОплатыВидОперации", "СуммаОплаты");  
	
	Если ТЗ_Списания.Количество() = 1 Тогда  
		Область.Параметры.ВидОперации = ТЗ_Списания[0].ДокументОплатыВидОперации;
	КонецЕсли;	
	//	
	
	//ИмяОбласти = "R1C" + Строка(НомерКомментарий_Списание);
	//Область.Область(ИмяОбласти).Значение = Строка.КомментарийОтветственного;
	ТабДок.Вывести(Область);
	
	//НоваяСтрока = ДанныеСписание.Добавить();        
	//ЗаполнитьЗначенияСвойств(НоваяСтрока, Строка);
	
	//	
	Запрос = Новый Запрос("ВЫБРАТЬ
	                      |	ЗаявкаНаБронирование.Ссылка КАК ДокументДолг,
	                      |	ДопУслугиОплаты.Услуга КАК Услуга,
	                      |	ЕСТЬNULL(ДопУслугиОплаты.СуммаДолг, 0) КАК СуммаДолг,
	                      |	ЕСТЬNULL(ДопУслугиОплаты.СуммаОплаты, 0) КАК СуммаОплаты
	                      |ИЗ
	                      |	Документ.ЗаявкаНаБронирование КАК ЗаявкаНаБронирование
	                      |		ЛЕВОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
	                      |			ЗаявкаНаБронированиеДопУслуги.Ссылка КАК Ссылка,
	                      |			ЗаявкаНаБронированиеДопУслуги.Услуга КАК Услуга,
	                      |			ЗаявкаНаБронированиеДопУслуги.Цена * ЗаявкаНаБронированиеДопУслуги.Количество КАК СуммаДолг,
	                      |			ЗаявкаНаБронированиеРаспределениеОплатДолги.СуммаОплаты КАК СуммаОплаты
	                      |		ИЗ
	                      |			Документ.ЗаявкаНаБронирование.ДопУслуги КАК ЗаявкаНаБронированиеДопУслуги
	                      |				ЛЕВОЕ СОЕДИНЕНИЕ Документ.ЗаявкаНаБронирование.РаспределениеОплатДолги КАК ЗаявкаНаБронированиеРаспределениеОплатДолги
	                      |				ПО ЗаявкаНаБронированиеДопУслуги.Ссылка = ЗаявкаНаБронированиеРаспределениеОплатДолги.Ссылка
	                      |					И ЗаявкаНаБронированиеДопУслуги.ГУИД = ЗаявкаНаБронированиеРаспределениеОплатДолги.ДолгиГУИД
