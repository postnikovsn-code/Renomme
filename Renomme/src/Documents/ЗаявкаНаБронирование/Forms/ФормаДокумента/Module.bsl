&НаСервере
Функция СуммаДолгиСчет(СчетГУИД) 
ОтборСтроки = Новый Структура("СчетГУИД", СчетГУИД);
НайденныеСтроки = Объект.СчетаДетальноДолги.НайтиСтроки(ОтборСтроки);

СуммаСчета = 0;
Для Каждого Строка Из НайденныеСтроки Цикл
	СуммаСчета = СуммаСчета + Строка.СуммаДолг; 		
КонецЦикла;

Возврат СуммаСчета;
КонецФункции	

&НаСервере
Функция СуммаОплатыСчет(СчетГУИД) 
ОтборСтроки = Новый Структура("СчетГУИД", СчетГУИД);
НайденныеСтроки = Объект.РаспределениеОплатДолги.НайтиСтроки(ОтборСтроки);

СуммаОплаты = 0;
Для Каждого Строка Из НайденныеСтроки Цикл
	СуммаОплаты = СуммаОплаты + Строка.СуммаОплаты; 		
КонецЦикла;

Возврат СуммаОплаты;
КонецФункции	

&НаСервере
Функция СуммаКЗакрытиюСчет(СчетГУИД) 
ОтборСтроки = Новый Структура("СчетГУИД", СчетГУИД);
НайденныеСтроки = Объект.СчетаДетальноДолги.НайтиСтроки(ОтборСтроки);

СуммаКЗакрытию = 0;
Для Каждого Строка Из НайденныеСтроки Цикл
	СуммаКЗакрытию = СуммаКЗакрытию + Строка.СуммаКЗакрытию; 		
КонецЦикла;

Возврат СуммаКЗакрытию;
КонецФункции	

&НаСервере
Функция НомерСчетаГУИД(ГУИД) 
ОтборСтроки = Новый Структура("ДолгиГУИД", ГУИД);
НайденныеСчетаДетальноДолги = Объект.СчетаДетальноДолги.НайтиСтроки(ОтборСтроки);	
Если НайденныеСчетаДетальноДолги.Количество() = 0 Тогда Возврат ""; КонецЕсли;

ТЗ = Новый ТаблицаЗначений;
КЧ = Новый КвалификаторыЧисла(12,0);

Массив = Новый Массив;
Массив.Добавить(Тип("Число"));
ОписаниеТиповЧ = Новый ОписаниеТипов(Массив, , ,КЧ);

ТЗ.Колонки.Добавить("НомерСчета", ОписаниеТиповЧ); 

НомерСчета = "";
Для Каждого СтрокаНайденныеСчетаДетальноДолги Из НайденныеСчетаДетальноДолги Цикл 
	СчетГУИД = СтрокаНайденныеСчетаДетальноДолги.СчетГУИД;
	ОтборСтроки = Новый Структура("СчетГУИД", СчетГУИД);
	НайденныеСчета = Объект.Счета.НайтиСтроки(ОтборСтроки);
	Если НайденныеСчета.Количество() = 0 Тогда Продолжить; КонецЕсли;
	
	НоваяСтрока = ТЗ.Добавить();
	НоваяСтрока.НомерСчета = НайденныеСчета[0].НомерСчета;
КонецЦикла;

ТЗ.Сортировать("НомерСчета");
Для Каждого Строка Из ТЗ Цикл 
	НомерСчетаДобавление = Строка(Строка.НомерСчета);
	НомерСчета = ОбщийФункционалКлиентСервер.ДобавитьТекст(НомерСчета, НомерСчетаДобавление, ", ");
КонецЦикла;

Возврат НомерСчета;
КонецФункции	
