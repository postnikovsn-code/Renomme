&НаСервере
Функция ЗаполнитьОтчетНаСервере_ПокаСохранить()  
ТабДок = Новый ТабличныйДокумент;

Запрос = Новый Запрос;
ТекстЗапроса = "ВЫБРАТЬ
               |	ЗаявкаНаБронирование.Ссылка КАК ЗаявкаНаБронирование,
               |	ЗаявкаНаБронирование.РезервС КАК РезервС,
               |	ЗаявкаНаБронирование.РезервПо КАК РезервПо,
               |	ЗаявкаНаБронирование.НомерВРезерв КАК НомерВРезерв,
               |	ЗаявкаНаБронирование.Клиент КАК Клиент,
               |	ЗаявкаНаБронирование.Оплачивает КАК Оплачивает,
               |	ЗаявкаНаБронирование.Статус КАК Статус,
               |	ПроживаниеСумма.Сумма КАК СуммаПроживание,
               |	УслугиСумма.Сумма КАК СуммаУслуги,
               |	ЕСТЬNULL(ПроживаниеСумма.Сумма, 0) + ЕСТЬNULL(УслугиСумма.Сумма, 0) КАК СуммаЗаявки,
               |	ЕСТЬNULL(СчетаПроживание.СуммаДолг, 0) + ЕСТЬNULL(СчетаУслуги.СуммаДолг, 0) КАК СуммаЗаявкиСчета,
               |	СчетаПроживание.СуммаДолг КАК СуммаПроживаниеСчета,
               |	СчетаУслуги.СуммаДолг КАК СуммаУслугиСчета,
               |	СчетаПроживание.СуммаКЗакрытию КАК СуммаДолгаПроживание,
               |	СчетаУслуги.СуммаКЗакрытию КАК СуммаДолгаУслуги,
               |	СписаниеПроживания.СуммаОплаты КАК СуммаСписанияПроживание,
               |	СписаниеУслуги.СуммаОплаты КАК СуммаСписанияУслуги,
               |	ЕСТЬNULL(СчетаПроживание.СуммаКЗакрытию, 0) + ЕСТЬNULL(СчетаУслуги.СуммаКЗакрытию, 0) КАК СуммаДолга,
               |	ЗаявкаНаБронирование.КомментарийОтветственного КАК КомментарийОтветственного
               |ИЗ
               |	Документ.ЗаявкаНаБронирование КАК ЗаявкаНаБронирование
               |		ЛЕВОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
               |			ЗаявкаНаБронированиеПроживание.Ссылка КАК Ссылка,
               |			СУММА(ЗаявкаНаБронированиеПроживание.Сумма) КАК Сумма
               |		ИЗ
               |			Документ.ЗаявкаНаБронирование.Проживание КАК ЗаявкаНаБронированиеПроживание
               |		
               |		СГРУППИРОВАТЬ ПО
               |			ЗаявкаНаБронированиеПроживание.Ссылка) КАК ПроживаниеСумма
               |		ПО ЗаявкаНаБронирование.Ссылка = ПроживаниеСумма.Ссылка
               |		ЛЕВОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
               |			ЗаявкаНаБронированиеДопУслуги.Ссылка КАК Ссылка,
               |			СУММА(ЗаявкаНаБронированиеДопУслуги.Количество * ЗаявкаНаБронированиеДопУслуги.Цена) КАК Сумма
               |		ИЗ
               |			Документ.ЗаявкаНаБронирование.ДопУслуги КАК ЗаявкаНаБронированиеДопУслуги
               |		ГДЕ
               |			ЗаявкаНаБронированиеДопУслуги.ВСчет = ИСТИНА
               |		
               |		СГРУППИРОВАТЬ ПО
               |			ЗаявкаНаБронированиеДопУслуги.Ссылка) КАК УслугиСумма
               |		ПО ЗаявкаНаБронирование.Ссылка = УслугиСумма.Ссылка
               |		ЛЕВОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
               |			ЗаявкаНаБронированиеСчетаДетальноДолги.Ссылка КАК Ссылка,
               |			СУММА(ЗаявкаНаБронированиеСчетаДетальноДолги.СуммаДолг) КАК СуммаДолг,
               |			СУММА(ЗаявкаНаБронированиеСчетаДетальноДолги.СуммаКЗакрытию) КАК СуммаКЗакрытию
               |		ИЗ
               |			Документ.ЗаявкаНаБронирование.СчетаДетальноДолги КАК ЗаявкаНаБронированиеСчетаДетальноДолги
               |		ГДЕ
               |			ЗаявкаНаБронированиеСчетаДетальноДолги.Услуга = ЛОЖЬ
               |		
               |		СГРУППИРОВАТЬ ПО
               |			ЗаявкаНаБронированиеСчетаДетальноДолги.Ссылка) КАК СчетаПроживание
               |		ПО ЗаявкаНаБронирование.Ссылка = СчетаПроживание.Ссылка
               |		ЛЕВОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
               |			ЗаявкаНаБронированиеСчетаДетальноДолги.Ссылка КАК Ссылка,
               |			СУММА(ЗаявкаНаБронированиеСчетаДетальноДолги.СуммаДолг) КАК СуммаДолг,
               |			СУММА(ЗаявкаНаБронированиеСчетаДетальноДолги.СуммаКЗакрытию) КАК СуммаКЗакрытию
               |		ИЗ
               |			Документ.ЗаявкаНаБронирование.СчетаДетальноДолги КАК ЗаявкаНаБронированиеСчетаДетальноДолги
               |		ГДЕ
               |			ЗаявкаНаБронированиеСчетаДетальноДолги.Услуга = ИСТИНА
               |		
               |		СГРУППИРОВАТЬ ПО
               |			ЗаявкаНаБронированиеСчетаДетальноДолги.Ссылка) КАК СчетаУслуги
               |		ПО ЗаявкаНаБронирование.Ссылка = СчетаУслуги.Ссылка
               |		ЛЕВОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
               |			ЗаявкаНаБронированиеРаспределениеОплатДолги.Ссылка КАК Ссылка,
               |			СУММА(ЗаявкаНаБронированиеРаспределениеОплатДолги.СуммаОплаты) КАК СуммаОплаты
               |		ИЗ
               |			Документ.ЗаявкаНаБронирование.РаспределениеОплатДолги КАК ЗаявкаНаБронированиеРаспределениеОплатДолги
               |		ГДЕ
               |			ТИПЗНАЧЕНИЯ(ЗаявкаНаБронированиеРаспределениеОплатДолги.ДокументОплаты) = ТИП(Документ.ПрочиеОплаты)
               |			И ЗаявкаНаБронированиеРаспределениеОплатДолги.Услуга = ЛОЖЬ
               |			И (ЗаявкаНаБронированиеРаспределениеОплатДолги.ДокументОплаты.ВидОперации = ЗНАЧЕНИЕ(Справочник.ВидыОпераций.Списание)
               |					ИЛИ ЗаявкаНаБронированиеРаспределениеОплатДолги.ДокументОплаты.ВидОперации = ЗНАЧЕНИЕ(Справочник.ВидыОпераций.СписаниеЗачет))
               |		
               |		СГРУППИРОВАТЬ ПО
               |			ЗаявкаНаБронированиеРаспределениеОплатДолги.Ссылка) КАК СписаниеПроживания
               |		ПО ЗаявкаНаБронирование.Ссылка = СписаниеПроживания.Ссылка
               |		ЛЕВОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
               |			ЗаявкаНаБронированиеРаспределениеОплатДолги.Ссылка КАК Ссылка,
               |			СУММА(ЗаявкаНаБронированиеРаспределениеОплатДолги.СуммаОплаты) КАК СуммаОплаты
               |		ИЗ
               |			Документ.ЗаявкаНаБронирование.РаспределениеОплатДолги КАК ЗаявкаНаБронированиеРаспределениеОплатДолги
               |		ГДЕ
               |			ТИПЗНАЧЕНИЯ(ЗаявкаНаБронированиеРаспределениеОплатДолги.ДокументОплаты) = ТИП(Документ.ПрочиеОплаты)
               |			И ЗаявкаНаБронированиеРаспределениеОплатДолги.Услуга = ИСТИНА
               |			И (ЗаявкаНаБронированиеРаспределениеОплатДолги.ДокументОплаты.ВидОперации = ЗНАЧЕНИЕ(Справочник.ВидыОпераций.Списание)
               |					ИЛИ ЗаявкаНаБронированиеРаспределениеОплатДолги.ДокументОплаты.ВидОперации = ЗНАЧЕНИЕ(Справочник.ВидыОпераций.СписаниеЗачет)
               |					ИЛИ ЗаявкаНаБронированиеРаспределениеОплатДолги.ДокументОплаты.ВидОперации = ЗНАЧЕНИЕ(Справочник.ВидыОпераций.СписаниеДопУслуг))
               |		
               |		СГРУППИРОВАТЬ ПО
               |			ЗаявкаНаБронированиеРаспределениеОплатДолги.Ссылка) КАК СписаниеУслуги
               |		ПО ЗаявкаНаБронирование.Ссылка = СписаниеУслуги.Ссылка
               |ГДЕ
               |	ЗаявкаНаБронирование.ПометкаУдаления = ЛОЖЬ
               |	И (ЗаявкаНаБронирование.Статус = ЗНАЧЕНИЕ(Перечисление.СтатусБрони.Выехал)
               |			ИЛИ ЗаявкаНаБронирование.Статус = ЗНАЧЕНИЕ(Перечисление.СтатусБрони.Неустойка))
               |	И ЗаявкаНаБронирование.РезервПо <= &ДатаПо
               |	И ЗаявкаНаБронирование.РезервПо >= &ДатаС";

//                      |	И ЕСТЬNULL(СчетаПроживание.СуммаКЗакрытию, 0) + ЕСТЬNULL(СчетаУслуги.СуммаКЗакрытию, 0) - ЕСТЬNULL(СписаниеПроживания.СуммаОплаты, 0) - ЕСТЬNULL(СписаниеУслуги.СуммаОплаты, 0) - ЕСТЬNULL(Списание.СуммаОплаты, 0) > 0
//                      |
//                      |УПОРЯДОЧИТЬ ПО
//                      |	РезервС,
//                      |	НомерВРезерв";	

Запрос.Текст = ТекстЗапроса;

Запрос.Текст = Запрос.Текст + "
                      |	И ЕСТЬNULL(СчетаПроживание.СуммаКЗакрытию, 0) + ЕСТЬNULL(СчетаУслуги.СуммаКЗакрытию, 0) > 0
                      |
                      |УПОРЯДОЧИТЬ ПО
                      |	РезервС,
                      |	НомерВРезерв";

Запрос.УстановитьПараметр("ДатаС", ДатаС);	
Запрос.УстановитьПараметр("ДатаПо", ДатаПо);

ТЗ = Запрос.Выполнить().Выгрузить();

//МакетОбработки = Обработки.ЗакрытиеФинансовогоПериода_2.ПолучитьМакет("Макет");
Обработка = РеквизитФормыВЗначение("Объект");
МакетОбработки = Обработка.ПолучитьМакет("МакетДолги");

//ПолеОтчета.Очистить();
Область = МакетОбработки.ПолучитьОбласть("Заголовок");
ОтельСсылка = НастройкиСервер.ПолучитьТекущуюОрганизацию();
Отель = ОтельСсылка.Наименование;
Область.Параметры.Отель = Отель;
Область.Параметры.ДатаС = Формат(ДатаС, "ДФ=dd.MM.yy");
Область.Параметры.ДатаПо = Формат(ДатаПо, "ДФ=dd.MM.yy");
ТабДок.Вывести(Область);

//
Запрос = Новый Запрос("ВЫБРАТЬ
                      |	КОЛИЧЕСТВО(РАЗЛИЧНЫЕ ЗаявкаНаБронирование.Ссылка) КАК КоличествоЗаявок,
                      |	СУММА(ДолгиКЗакрытию.СуммаДолг) КАК СуммаЗаявок
                      |ИЗ
                      |	Документ.ЗаявкаНаБронирование КАК ЗаявкаНаБронирование
                      |		ВНУТРЕННЕЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
                      |			ЗаявкаНаБронированиеСчетаДетальноДолги.Ссылка КАК Ссылка,
                      |			СУММА(ЗаявкаНаБронированиеСчетаДетальноДолги.СуммаКЗакрытию) КАК СуммаКЗакрытию,
                      |			СУММА(ЗаявкаНаБронированиеСчетаДетальноДолги.СуммаДолг) КАК СуммаДолг
                      |		ИЗ
                      |			Документ.ЗаявкаНаБронирование.СчетаДетальноДолги КАК ЗаявкаНаБронированиеСчетаДетальноДолги
                      |		
                      |		СГРУППИРОВАТЬ ПО
                      |			ЗаявкаНаБронированиеСчетаДетальноДолги.Ссылка) КАК ДолгиКЗакрытию
                      |		ПО ЗаявкаНаБронирование.Ссылка = ДолгиКЗакрытию.Ссылка
                      |ГДЕ
                      |	ЗаявкаНаБронирование.ПометкаУдаления = ЛОЖЬ
                      |	И (ЗаявкаНаБронирование.Статус = ЗНАЧЕНИЕ(Перечисление.СтатусБрони.Выехал)
                      |			ИЛИ ЗаявкаНаБронирование.Статус = ЗНАЧЕНИЕ(Перечисление.СтатусБрони.Неустойка))
                      |	И ЗаявкаНаБронирование.РезервПо <= &ДатаПо
                      |	И ЗаявкаНаБронирование.РезервПо >= &ДатаС
                      |	И ДолгиКЗакрытию.СуммаКЗакрытию = 0");

Запрос.УстановитьПараметр("ДатаС", ДатаС);	
Запрос.УстановитьПараметр("ДатаПо", ДатаПо);

ТЗ_ЗакрытоЗаявок = Запрос.Выполнить().Выгрузить();
Если ТЗ_ЗакрытоЗаявок.Количество() = 0 Тогда
	КоличествоЗаявок = 0; 	
	СуммаЗаявок = 0;
Иначе
	КоличествоЗаявок = ТЗ_ЗакрытоЗаявок[0].КоличествоЗаявок; 	
	СуммаЗаявок = ТЗ_ЗакрытоЗаявок[0].СуммаЗаявок;
КонецЕсли;
	
Область = МакетОбработки.ПолучитьОбласть("ЗакрытоЗаявок");
Область.Параметры.КоличествоЗаявок = Строка(КоличествоЗаявок);
Область.Параметры.СуммаЗаявок = Строка(СуммаЗаявок);
ТабДок.Вывести(Область);
//

//
Область = МакетОбработки.ПолучитьОбласть("Шапка");
ТабДок.Вывести(Область);

ДанныеДолги.Очистить();
НомерКомментарий_Долги = Область.ШиринаТаблицы;

ДолгиСдвиг_Долги = ТабДок.ВысотаТаблицы;

НомерКолонкиСуммаПроживание = 10;
Для Каждого Строка Из ТЗ Цикл
	Область = МакетОбработки.ПолучитьОбласть("Строка");
	
	Область.Параметры.Заполнить(Строка);
	Область.Параметры.РезервС = Формат(Строка.РезервС, "ДФ=dd.MM.yy");
	Область.Параметры.РезервПо = Формат(Строка.РезервПо, "ДФ=dd.MM.yy");
	
	Область.Параметры.Заявка = Строка.ЗаявкаНаБронирование.Номер + " от " + Формат(Строка.ЗаявкаНаБронирование.Дата, "ДФ=dd.MM.yy");
	Область.Параметры.ЗаявкаНаБронирование = Строка.ЗаявкаНаБронирование;
	
	Если Строка.СуммаПроживаниеСчета = Строка.СуммаПроживание Тогда
		Область.Область(1, НомерКолонкиСуммаПроживание, 1, НомерКолонкиСуммаПроживание).ЦветТекста = WebЦвета.Красный;
	КонецЕсли;
	
	ИмяОбласти = "R1C" + Строка(НомерКомментарий_Долги);
	Область.Область(ИмяОбласти).Значение = Строка.КомментарийОтветственного;
	ТабДок.Вывести(Область);
	
	НоваяСтрока = ДанныеДолги.Добавить();
	ЗаполнитьЗначенияСвойств(НоваяСтрока, Строка);
	НоваяСтрока.ТипСтроки = "Долги";
КонецЦикла;

Область = МакетОбработки.ПолучитьОбласть("Подножие");
//Область.Параметры.СуммаЗаявки = ТЗ.Итог("СуммаЗаявки");
//Область.Параметры.СуммаПроживаниеСчета = ТЗ.Итог("СуммаПроживаниеСчета");
//Область.Параметры.СуммаПроживание = ТЗ.Итог("СуммаПроживание");
