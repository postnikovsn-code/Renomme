&НаКлиенте
Процедура СдельноПриОкончанииРедактирования(Элемент, НоваяСтрока, ОтменаРедактирования)
ТД = Элемент.ТекущиеДанные;
Если ТД = Неопределено Тогда Возврат; КонецЕсли;

ТС = Элемент.ТекущаяСтрока;

Текст = "";
Если НЕ ЗначениеЗаполнено(ТД.Горничная) Тогда
	Текст = ОбщийФункционалКлиентСервер.ДобавитьТекст(Текст, "Горничная должна быть заполнена.", Символы.ПС);
КонецЕсли;	
Если НЕ ЗначениеЗаполнено(ТД.Дата) Тогда
	Текст = ОбщийФункционалКлиентСервер.ДобавитьТекст(Текст, "Дата должна быть заполнена.", Символы.ПС);
КонецЕсли;	

Если Текст <> "" Тогда
	ПоказатьПредупреждение(,Текст);	
КонецЕсли;

ОбновитьСдельноСтрокаИзКлиента(ТС);
			
ГорничнаяСдельноИтогоДействие(ТД);	
КонецПроцедуры

&НаСервере
Процедура ОбновитьСдельноСтрокаИзКлиента(ТС)
