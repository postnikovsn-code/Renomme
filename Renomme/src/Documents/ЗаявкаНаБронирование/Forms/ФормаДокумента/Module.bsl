//
&НаКлиенте
Процедура СчетаПередУдалением(Элемент, Отказ)
Если НЕ	ЭтаФорма.Записать(Новый Структура("РежимЗаписи", РежимЗаписиДокумента.Проведение)) Тогда Отказ = Истина; Возврат; КонецЕсли;
	
ТС = Элемент.ТекущаяСтрока;  	
Если ТС = Неопределено Тогда Возврат; КонецЕсли;	
ТД = Объект.Счета.НайтиПоИдентификатору(ТС);

Если ЗначениеЗаполнено(ТД.ГрупповойСчет) Тогда 
	ПоказатьПредупреждение(, "Групповой счет.
							|
							|УДАЛЕНИЕ НЕ РАЗРЕШЕНО ...");
	Отказ = Истина; 
	Возврат; 
КонецЕсли;

СчетГУИД = ТД.СчетГУИД;

Если ЕстьОплатыСчета(СчетГУИД) Тогда 
	ПоказатьПредупреждение(, "Есть оплаты счета.
							|
							|УДАЛЕНИЕ НЕ РАЗРЕШЕНО ...
							|
							|Для удаления счета удалите оплаты счета");
	Отказ = Истина; 
	Возврат; 
КонецЕсли;

ТекстВопроса = ""; 
Если ТД.Закрыт Тогда 
	ПоказатьПредупреждение(,"Счет закрыт
	|
	|УДАЛЕНИЕ НЕ РАЗРЕШЕНО ...
	|
	|Для удаления счета снимите галочку 'Счет закрыт'");
	
	Отказ = Истина; 
	Возврат; 
КонецЕсли;

Оповещение = Новый ОписаниеОповещения("ЗавершениеВопросаПодтвердитеУдалениеСчета", ЭтаФорма);

ТекстВопроса = ОбщийФункционалКлиентСервер.ДобавитьТекст(ТекстВопроса, "ПОДТВЕРДИТЕ УДАЛЕНИЕ ...", Символы.ПС + Символы.ПС);  
ПоказатьВопрос(Оповещение, ТекстВопроса, РежимДиалогаВопрос.ОКОтмена);
Отказ = Истина;
КонецПроцедуры

&НаКлиенте
Процедура ЗавершениеВопросаПодтвердитеУдалениеСчета(Результат, ДополнительныеПараметры) Экспорт
Если Результат = КодВозвратаДиалога.Отмена Тогда Возврат; КонецЕсли;

УдалитьСчетНаСервере();
КонецПроцедуры

&НаСервере
Процедура УдалитьСчетНаСервере()
НачатьТранзакцию();	

ТекущаяСтрока = Элементы.Счета.ТекущаяСтрока;
ТекущиеДанные = Объект.Счета.НайтиПоИдентификатору(ТекущаяСтрока);
СчетГУИД = ТекущиеДанные.СчетГУИД;

ЗаявкаСервер.УдалитьДанныеСчета(СчетГУИД, Объект);

СчетаДетальноСтроки = Объект.СчетаДетальноСтроки;
ОтборСтроки = Новый Структура("СчетГУИД", СчетГУИД);
НайденныеСтроки = СчетаДетальноСтроки.НайтиСтроки(ОтборСтроки);
Для Каждого Строка Из НайденныеСтроки Цикл
	СчетаДетальноСтроки.Удалить(Строка);
КонецЦикла;

Объект.Счета.Удалить(ТекущиеДанные);

ЭтаФорма.Записать(Новый Структура("РежимЗаписи", РежимЗаписиДокумента.Проведение));
ЗафиксироватьТранзакцию();	
КонецПроцедуры
