	ТД["СуммаЗавтракиДомСоветов_" + Дата_И] = СуммаЗавтракиДомСоветов;
	
	КоличествоЗавтракиЛайв = ТД["КоличествоЗавтракиЛайв_" + Дата_И];
	СуммаЗавтракиЛайв  = СуммаЗавтракиЛайвЗаСмену(ТД.Администратор, КоличествоЗавтракиЛайв);
	ТД["СуммаЗавтракиЛайв_" + Дата_И] = СуммаЗавтракиЛайв;
	
	Если НомерСмены = 0 Тогда	
		ТД["Часы_" + Дата_И] = "";

		Имя_П = "ДлинаСмены_" + Дата_И;
		ТД[Имя_П] = 0;
		
		Имя_П = "Оклад_" + Дата_И;
		ТД[Имя_П] = 0; 
		Имя_П = "Оклад_" + Дата_И + "_Р";
		ТД[Имя_П] = 0; 
		Имя_П = "Оклад_" + Дата_И + "_Есть";
		ТД[Имя_П] = Ложь; 
		ТД["Оклад_" + Дата_И + "_Э"] = 0;

		Имя_П = "СуммаЗаПроживающих_" + Дата_И;
		ТД[Имя_П] = 0; 
		
		Имя_П = "КоличествоЗаселенийЛайв_" + Дата_И;
		ТД[Имя_П] = 0; 
		Имя_П = "КоличествоЗаселенийЛайв_" + Дата_И + "_Р";
		ТД[Имя_П] = 0; 
		Имя_П = "КоличествоЗаселенийЛайв_" + Дата_И + "_Э";
		ТД[Имя_П] = 0; 
		ТД["СуммаЗаселенийЛайв_" + Дата_И] = 0;
		
		Имя_П = "КоличествоЗаселенийДомСоветов_" + Дата_И;
		ТД[Имя_П] = 0; 
		Имя_П = "КоличествоЗаселенийДомСоветов_" + Дата_И + "_Р";
		ТД[Имя_П] = 0;	
		Имя_П = "КоличествоЗаселенийДомСоветов_" + Дата_И + "_Э";
		ТД[Имя_П] = 0;	
		ТД["СуммаЗаселенийДомСоветов_" + Дата_И] = 0;
		
		Имя_П = "КоличествоЗаселенийСтритАрт_" + Дата_И;
		ТД[Имя_П] = 0; 
		Имя_П = "КоличествоЗаселенийСтритАрт_" + Дата_И + "_Р";
		ТД[Имя_П] = 0;	
		Имя_П = "КоличествоЗаселенийСтритАрт_" + Дата_И + "_Э";
		ТД[Имя_П] = 0;
		ТД["СуммаЗаселенийСтритАрт_" + Дата_И] = 0;
		
		ТД["Часы_" + Дата_И] = "00-0/00";
		
		Перейти ~ВЫХОД;
	КонецЕсли;	
	
	Если НомерСмены = 3 Тогда	
		ТД["Часы_" + Дата_И] = "";

		Имя_П = "ДлинаСмены_" + Дата_И;
		ТД[Имя_П] = 0;
		
		ТД["Оклад_" + Дата_И] = СтавкаЗаОтпуск(ТД.Администратор); 
		Имя_П = "Оклад_" + Дата_И + "_Р";
		ТД[Имя_П] = 0; 
		Имя_П = "Оклад_" + Дата_И + "_Есть";
		ТД[Имя_П] = Ложь; 
		ТД["Оклад_" + Дата_И + "_Э"] = ТД["Оклад_" + Дата_И];
		
		Имя_П = "СуммаЗаПроживающих_" + Дата_И;
		ТД[Имя_П] = 0; 

		Имя_П = "КоличествоЗаселенийЛайв_" + Дата_И;
		ТД[Имя_П] = 0; 
		Имя_П = "КоличествоЗаселенийЛайв_" + Дата_И + "_Р";
		ТД[Имя_П] = 0; 
		Имя_П = "КоличествоЗаселенийЛайв_" + Дата_И + "_Э";
		ТД[Имя_П] = 0; 
		ТД["СуммаЗаселенийЛайв_" + Дата_И] = 0;
		
		Имя_П = "КоличествоЗаселенийДомСоветов_" + Дата_И;
		ТД[Имя_П] = 0; 
		Имя_П = "КоличествоЗаселенийДомСоветов_" + Дата_И + "_Р";
		ТД[Имя_П] = 0; 
		Имя_П = "КоличествоЗаселенийДомСоветов_" + Дата_И + "_Э";
		ТД[Имя_П] = 0; 
		ТД["СуммаЗаселенийДомСоветов_" + Дата_И] = 0;
		
		Имя_П = "КоличествоЗаселенийСтритАрт_" + Дата_И;
		ТД[Имя_П] = 0; 
		Имя_П = "КоличествоЗаселенийСтритАрт_" + Дата_И + "_Р";
		ТД[Имя_П] = 0; 
