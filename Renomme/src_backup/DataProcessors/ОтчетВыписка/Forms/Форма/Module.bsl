
&НаКлиенте
Процедура ОтчетОплатыДолгиСформировать(Команда)
ОтчетОплатыДолгиСформироватьНаСервере();
КонецПроцедуры

&НаСервере
Процедура ОтчетОплатыДолгиСформироватьНаСервере()
ЗаполнитьОтчетТаблица();

ОтчетПоле.Очистить();
ОтчетПоле.ФиксацияСверху = 1;
ОтчетПоле.ОриентацияСтраницы = ОриентацияСтраницы.Ландшафт;
//ОтчетПоле.ОтображатьСетку = Истина;

Макет =  Обработки.ОтчетВыписка.ПолучитьМакет("ОтчетВыписка");

Шапка = Макет.ПолучитьОбласть("Шапка");
ОтчетПоле.Вывести(Шапка);
	
ДатаСвертка = '00010101';
ДокументОплаты_П = Неопределено;
Счетчик = 0;
Для Каждого СтрокаТаблица Из ОтчетТаблица Цикл
	Если НачалоДня(СтрокаТаблица.ДатаОплаты) <> ДатаСвертка Тогда  
		ОтчетПоле.ЗакончитьАвтогруппировкуСтрок();
		
		ОтчетПоле.НачатьАвтогруппировкуСтрок();
		
		СтрокаОтчета = Макет.ПолучитьОбласть("СтрокаЗаголовок");
		СтрокаОтчета.Параметры.ДатаОплаты = Формат(СтрокаТаблица.ДатаОплаты, "ДФ=dd.MM.yy"); 
		
		ИтогСуммаВыпискиДата = ИтогСуммаВыпискиДата(СтрокаТаблица.ДатаОплаты, Счетчик);
		СтрокаОтчета.Параметры.СуммаВыписки = ИтогСуммаВыпискиДата;  
		
		ОтчетПоле.Вывести(СтрокаОтчета, 1);
		
		ДатаСвертка = НачалоДня(СтрокаТаблица.ДатаОплаты);
	КонецЕсли;
	
	СтрокаОтчета = Макет.ПолучитьОбласть("Строка");
	СтрокаОтчета.Параметры.ДатаОплаты = Формат(СтрокаТаблица.ДатаОплаты, "ДФ=dd.MM.yy"); 
	СтрокаОтчета.Параметры.Контрагент = СтрокаТаблица.Контрагент; 
	//СтрокаОтчета.Параметры.ВыпискаДокумент = СтрокаТаблица.ДокументОплаты; 
	СтрокаОтчета.Параметры.ВыпискаДокумент = ДокументПредставление(СтрокаТаблица.ДокументОплаты); 
	СтрокаОтчета.Параметры.СуммаВыписки = СтрокаТаблица.ДокументОплаты.Сумма;   
	СтрокаОтчета.Параметры.ЗакрытВыписка = ?(СтрокаТаблица.ЗакрытВыписка, "V", ""); 
	
	
	Если СтрокаТаблица.ДокументОплаты <> ДокументОплаты_П Тогда
		ДокументОплаты_П = СтрокаТаблица.ДокументОплаты;  
		ИтогВыпискаДокументОплаты = ИтогВыпискаДокументОплаты(СтрокаТаблица.ДокументОплаты, Счетчик);
		СуммаОстатокВыписки = СтрокаТаблица.ДокументОплаты.Сумма 
			- СтрокаТаблица.СуммаВозврат
			- ИтогВыпискаДокументОплаты;
			
		СтрокаОтчета.Параметры.СуммаВозврат = СтрокаТаблица.СуммаВозврат; 
		СтрокаОтчета.Параметры.СуммаОстатокВыписки = СуммаОстатокВыписки;
	КонецЕсли;	
		
//	СтрокаОтчета.Параметры.ДокументДолг = СтрокаТаблица.ДокументДолг; 
	СтрокаОтчета.Параметры.ДокументДолг = ДокументПредставление(СтрокаТаблица.ДокументДолг); 
	
	СтрокаОтчета.Параметры.НомерСчета = СтрокаТаблица.НомерСчета; 
	СтрокаОтчета.Параметры.ДатаСчета = Формат(СтрокаТаблица.ДатаСчета, "ДФ=dd.MM.yy"); 
	СтрокаОтчета.Параметры.СуммаРаспределено = СтрокаТаблица.СуммаОплаты; 
	
	Если ТипЗнч(СтрокаТаблица.ДокументДолг) = Тип("ДокументСсылка.ЗаявкаНаБронирование") Тогда
		СтрокаОтчета.Параметры.НомерВРезерв = СтрокаТаблица.ДокументДолг.НомерВРезерв; 
		СтрокаОтчета.Параметры.ДатаРезерваС = Формат(СтрокаТаблица.ДокументДолг.РезервС, "ДФ=dd.MM.yy"); 
	ИначеЕсли ТипЗнч(СтрокаТаблица.ДокументДолг) = Тип("ДокументСсылка.КоворкингСчета") Тогда
		СтрокаОтчета.Параметры.НомерВРезерв = СтрокаТаблица.ДокументДолг.КоворкингЗаявка.КоворкингНомер; 
		СтрокаОтчета.Параметры.ДатаРезерваС = Формат(СтрокаТаблица.ДокументДолг.ДатаС, "ДФ=dd.MM.yy"); 
	КонецЕсли;
	
	СтрокаОтчета.Параметры.ДокументДолгРасшифровка = СтрокаТаблица.ДокументДолг; 
	СтрокаОтчета.Параметры.ВыпискаДокументРасшифровка = СтрокаТаблица.ДокументОплаты;
	
	ОтчетПоле.Вывести(СтрокаОтчета, 2);
	
	Счетчик = Счетчик + 1;
КонецЦикла;

ОтчетПоле.ЗакончитьАвтогруппировкуСтрок();
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьОтчетТаблица()
Запрос = Новый Запрос("ВЫБРАТЬ
                      |	ВыпискаБанка.Дата КАК Дата,
                      |	ВыпискаБанка.Ссылка КАК ДокументОплаты,
                      |	ВыпискаБанка.ДатаОплаты КАК ДатаОплаты,
                      |	ВыпискаБанка.ОтКого КАК Контрагент,
                      |	ВыпискаБанка.Сумма КАК Сумма,
                      |	ВыпискаБанка.Закрыт КАК ЗакрытВыписка,
                      |	ЗаявкиСчета.Ссылка КАК ДокументДолг,
                      |	ЗаявкиСчета.НомерСчета КАК НомерСчета,
                      |	ЗаявкиСчета.ДатаСчета КАК ДатаСчета,
                      |	ЗаявкиСчета.СуммаОплаты КАК СуммаОплаты,
                      |	ЕСТЬNULL(Возвраты.СуммаВозврат, 0) КАК СуммаВозврат,
                      |	ИСТИНА КАК ДокументДолгЗаполнен
                      |ИЗ
                      |	Документ.ВыпискаБанка КАК ВыпискаБанка
                      |		ВНУТРЕННЕЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
                      |			ЗаявкаРаспределениеОплат.Ссылка КАК Ссылка,
                      |			ЗаявкаРаспределениеОплат.СчетГУИД КАК СчетГУИД,
                      |			ЗаявкаНаБронированиеСчета.НомерСчета КАК НомерСчета,
                      |			ЗаявкаНаБронированиеСчета.ДатаСчета КАК ДатаСчета,
                      |			ЗаявкаРаспределениеОплат.ДокументОплаты КАК ДокументОплаты,
                      |			ЗаявкаРаспределениеОплат.СуммаОплаты КАК СуммаОплаты
                      |		ИЗ
                      |			(ВЫБРАТЬ
                      |				ЗаявкаНаБронированиеРаспределениеОплатДолги.Ссылка КАК Ссылка,
                      |				ЗаявкаНаБронированиеРаспределениеОплатДолги.ДокументОплаты КАК ДокументОплаты,
                      |				ЗаявкаНаБронированиеРаспределениеОплатДолги.СчетГУИД КАК СчетГУИД,
                      |				СУММА(ЗаявкаНаБронированиеРаспределениеОплатДолги.СуммаОплаты) КАК СуммаОплаты
                      |			ИЗ
                      |				Документ.ЗаявкаНаБронирование.РаспределениеОплатДолги КАК ЗаявкаНаБронированиеРаспределениеОплатДолги
                      |			
                      |			СГРУППИРОВАТЬ ПО
                      |				ЗаявкаНаБронированиеРаспределениеОплатДолги.Ссылка,
                      |				ЗаявкаНаБронированиеРаспределениеОплатДолги.СчетГУИД,
                      |				ЗаявкаНаБронированиеРаспределениеОплатДолги.ДокументОплаты) КАК ЗаявкаРаспределениеОплат
                      |				ЛЕВОЕ СОЕДИНЕНИЕ Документ.ЗаявкаНаБронирование.Счета КАК ЗаявкаНаБронированиеСчета
                      |				ПО ЗаявкаРаспределениеОплат.Ссылка = ЗаявкаНаБронированиеСчета.Ссылка
                      |					И ЗаявкаРаспределениеОплат.СчетГУИД = ЗаявкаНаБронированиеСчета.СчетГУИД
                      |		ГДЕ
                      |			ЗаявкаНаБронированиеСчета.ГрупповойСчет = ЗНАЧЕНИЕ(Документ.ГрупповыеСчета.ПустаяСсылка)) КАК ЗаявкиСчета
                      |		ПО ВыпискаБанка.Ссылка = ЗаявкиСчета.ДокументОплаты
                      |		ЛЕВОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
                      |			ВыпискаБанка.ВозвратДокумент КАК ВозвратДокумент,
                      |			СУММА(ВыпискаБанка.Сумма) КАК СуммаВозврат
                      |		ИЗ
                      |			Документ.ВыпискаБанка КАК ВыпискаБанка
                      |		ГДЕ
                      |			ВыпискаБанка.ПометкаУдаления = ЛОЖЬ
                      |		
                      |		СГРУППИРОВАТЬ ПО
                      |			ВыпискаБанка.ВозвратДокумент) КАК Возвраты
                      |		ПО ВыпискаБанка.Ссылка = Возвраты.ВозвратДокумент
                      |ГДЕ
                      |	ВыпискаБанка.ПометкаУдаления = ЛОЖЬ
                      |	И ЗаявкиСчета.Ссылка.ПометкаУдаления = ЛОЖЬ
                      |	И ВЫБОР
                      |			КОГДА &ДатаС = ДАТАВРЕМЯ(1, 1, 1, 0, 0, 0)
                      |				ТОГДА ИСТИНА
                      |			ИНАЧЕ НАЧАЛОПЕРИОДА(ВыпискаБанка.ДатаОплаты, ДЕНЬ) >= &ДатаС
                      |		КОНЕЦ
                      |	И ВЫБОР
                      |			КОГДА &ДатаПо = ДАТАВРЕМЯ(1, 1, 1, 0, 0, 0)
                      |				ТОГДА ИСТИНА
                      |			ИНАЧЕ НАЧАЛОПЕРИОДА(ВыпискаБанка.ДатаОплаты, ДЕНЬ) <= &ДатаПо
                      |		КОНЕЦ
                      |	И ВЫБОР
                      |			КОГДА &КонтрагентОтбор = ЗНАЧЕНИЕ(Справочник.Клиенты.ПустаяСсылка)
                      |				ТОГДА ИСТИНА
                      |			ИНАЧЕ ВыпискаБанка.ОтКого = &КонтрагентОтбор
                      |		КОНЕЦ");	

Запрос.УстановитьПараметр("ДатаС", ОтчетДатаС); 
Запрос.УстановитьПараметр("ДатаПо", ОтчетДатаПо); 
Запрос.УстановитьПараметр("КонтрагентОтбор", ОтчетКонтрагентОтбор); 

ТЗ = Запрос.Выполнить().Выгрузить();
ОтчетТаблица.Очистить();
Для Каждого Строка Из ТЗ Цикл
	НоваяСтрока = ОтчетТаблица.Добавить();
	ЗаполнитьЗначенияСвойств(НоваяСтрока, Строка);
КонецЦикла;

Запрос = Новый Запрос("ВЫБРАТЬ
                      |	ВыпискаБанка.Дата КАК Дата,
                      |	ВыпискаБанка.Ссылка КАК ДокументОплаты,
                      |	ВыпискаБанка.ДатаОплаты КАК ДатаОплаты,
                      |	ВыпискаБанка.ОтКого КАК Контрагент,
                      |	ВыпискаБанка.Сумма КАК Сумма,
                      |	ВыпискаБанка.Закрыт КАК ЗакрытВыписка,
                      |	ГрупповыеСчета.Ссылка КАК ДокументДолг,
                      |	ГрупповыеСчета.Ссылка.НомерСчета КАК НомерСчета,
                      |	ГрупповыеСчета.Ссылка.ДатаСчета КАК ДатаСчета,
                      |	ГрупповыеСчета.СуммаОплаты КАК СуммаОплаты,
                      |	ЕСТЬNULL(Возвраты.СуммаВозврат, 0) КАК СуммаВозврат,
                      |	ИСТИНА КАК ДокументДолгЗаполнен
                      |ИЗ
                      |	Документ.ВыпискаБанка КАК ВыпискаБанка
                      |		ВНУТРЕННЕЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
                      |			ГрупповыеСчетаДокументыОплаты.Ссылка КАК Ссылка,
                      |			ГрупповыеСчетаДокументыОплаты.ДокументОплаты КАК ДокументОплаты,
                      |			СУММА(ГрупповыеСчетаДокументыОплаты.СуммаРаспределено) КАК СуммаОплаты
                      |		ИЗ
                      |			Документ.ГрупповыеСчета.ДокументыОплаты КАК ГрупповыеСчетаДокументыОплаты
                      |		
                      |		СГРУППИРОВАТЬ ПО
                      |			ГрупповыеСчетаДокументыОплаты.Ссылка,
                      |			ГрупповыеСчетаДокументыОплаты.ДокументОплаты) КАК ГрупповыеСчета
                      |		ПО ВыпискаБанка.Ссылка = ГрупповыеСчета.ДокументОплаты
                      |		ЛЕВОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
                      |			ВыпискаБанка.ВозвратДокумент КАК ВозвратДокумент,
                      |			СУММА(ВыпискаБанка.Сумма) КАК СуммаВозврат
                      |		ИЗ
                      |			Документ.ВыпискаБанка КАК ВыпискаБанка
                      |		ГДЕ
                      |			ВыпискаБанка.ПометкаУдаления = ЛОЖЬ
                      |		
                      |		СГРУППИРОВАТЬ ПО
                      |			ВыпискаБанка.ВозвратДокумент) КАК Возвраты
                      |		ПО ВыпискаБанка.Ссылка = Возвраты.ВозвратДокумент
                      |ГДЕ
                      |	ВыпискаБанка.ПометкаУдаления = ЛОЖЬ
                      |	И ВЫБОР
                      |			КОГДА &ДатаС = ДАТАВРЕМЯ(1, 1, 1, 0, 0, 0)
                      |				ТОГДА ИСТИНА
                      |			ИНАЧЕ НАЧАЛОПЕРИОДА(ВыпискаБанка.ДатаОплаты, ДЕНЬ) >= &ДатаС
                      |		КОНЕЦ
                      |	И ВЫБОР
                      |			КОГДА &ДатаПо = ДАТАВРЕМЯ(1, 1, 1, 0, 0, 0)
                      |				ТОГДА ИСТИНА
                      |			ИНАЧЕ НАЧАЛОПЕРИОДА(ВыпискаБанка.ДатаОплаты, ДЕНЬ) <= &ДатаПо
                      |		КОНЕЦ
                      |	И ВЫБОР
                      |			КОГДА &КонтрагентОтбор = ЗНАЧЕНИЕ(Справочник.Клиенты.ПустаяСсылка)
                      |				ТОГДА ИСТИНА
                      |			ИНАЧЕ ВыпискаБанка.ОтКого = &КонтрагентОтбор
                      |		КОНЕЦ");	

Запрос.УстановитьПараметр("ДатаС", ОтчетДатаС); 
Запрос.УстановитьПараметр("ДатаПо", ОтчетДатаПо); 
Запрос.УстановитьПараметр("КонтрагентОтбор", ОтчетКонтрагентОтбор); 

ТЗ = Запрос.Выполнить().Выгрузить();
Для Каждого Строка Из ТЗ Цикл
	НоваяСтрока = ОтчетТаблица.Добавить();
	ЗаполнитьЗначенияСвойств(НоваяСтрока, Строка);
КонецЦикла;

Запрос = Новый Запрос("ВЫБРАТЬ
                      |	ВыпискаБанка.Дата КАК Дата,
                      |	ВыпискаБанка.Ссылка КАК ДокументОплаты,
                      |	ВыпискаБанка.ДатаОплаты КАК ДатаОплаты,
                      |	ВыпискаБанка.ОтКого КАК Контрагент,
                      |	ВыпискаБанка.Сумма КАК Сумма,
                      |	ВыпискаБанка.Закрыт КАК ЗакрытВыписка,
                      |	КоворкингСчета.Ссылка КАК ДокументДолг,
                      |	КоворкингСчета.Ссылка.Номер КАК НомерСчета,
                      |	КоворкингСчета.Ссылка.Дата КАК ДатаСчета,
                      |	КоворкингСчета.СуммаОплаты КАК СуммаОплаты,
                      |	ЕСТЬNULL(Возвраты.СуммаВозврат, 0) КАК СуммаВозврат,
                      |	ИСТИНА КАК ДокументДолгЗаполнен
                      |ИЗ
                      |	Документ.ВыпискаБанка КАК ВыпискаБанка
                      |		ВНУТРЕННЕЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
                      |			КоворкингСчетаДокументыОплаты.Ссылка КАК Ссылка,
                      |			КоворкингСчетаДокументыОплаты.ДокументОплаты КАК ДокументОплаты,
                      |			СУММА(КоворкингСчетаДокументыОплаты.СуммаРаспределено) КАК СуммаОплаты
                      |		ИЗ
                      |			Документ.КоворкингСчета.ДокументыОплаты КАК КоворкингСчетаДокументыОплаты
                      |		
                      |		СГРУППИРОВАТЬ ПО
                      |			КоворкингСчетаДокументыОплаты.Ссылка,
                      |			КоворкингСчетаДокументыОплаты.ДокументОплаты) КАК КоворкингСчета
                      |		ПО ВыпискаБанка.Ссылка = КоворкингСчета.ДокументОплаты
                      |		ЛЕВОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
                      |			ВыпискаБанка.ВозвратДокумент КАК ВозвратДокумент,
                      |			СУММА(ВыпискаБанка.Сумма) КАК СуммаВозврат
                      |		ИЗ
                      |			Документ.ВыпискаБанка КАК ВыпискаБанка
                      |		ГДЕ
                      |			ВыпискаБанка.ПометкаУдаления = ЛОЖЬ
                      |		
                      |		СГРУППИРОВАТЬ ПО
                      |			ВыпискаБанка.ВозвратДокумент) КАК Возвраты
                      |		ПО ВыпискаБанка.Ссылка = Возвраты.ВозвратДокумент
                      |ГДЕ
                      |	ВыпискаБанка.ПометкаУдаления = ЛОЖЬ
                      |	И ВЫБОР
                      |			КОГДА &ДатаС = ДАТАВРЕМЯ(1, 1, 1, 0, 0, 0)
                      |				ТОГДА ИСТИНА
