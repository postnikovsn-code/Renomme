//// + Неиспользуется

// + Удаление Счета
Процедура СчетаПередУдалением(КоворкингЗаявка, СчетСсылка, Счета) Экспорт
Если КоворкингСервер.ЕстьОплатыСчет(КоворкингЗаявка) Тогда
	ПоказатьПредупреждение(, "Есть оплата Счета.
	| 
	|УДАЛЕНИЕ НЕ РАЗРЕШЕНО ..."); 
	
	Возврат;
КонецЕсли;

ДопПараметры = Новый Структура;
ДопПараметры.Вставить("СчетСсылка", СчетСсылка);
ДопПараметры.Вставить("Счета", Счета);

Оповещение = Новый ОписаниеОповещения("ЗавершениеВопросаПодтвердитеУдалениеСчета", ЭтотОбъект, ДопПараметры);

ПоказатьВопрос(Оповещение, "ПОДТВЕРДИТЕ УДАЛЕНИЕ ...", РежимДиалогаВопрос.ОКОтмена);
КонецПроцедуры

Процедура ЗавершениеВопросаПодтвердитеУдалениеСчета(Результат, ДополнительныеПараметры) Экспорт
Если Результат = КодВозвратаДиалога.Отмена Тогда Возврат; КонецЕсли;

СчетСсылка = ДополнительныеПараметры.СчетСсылка;
КоворкингСервер.УдалитьСчет(СчетСсылка);

Счета = ДополнительныеПараметры.Счета;
ОтборСтроки = Новый Структура("СчетСсылка", СчетСсылка); 
НайденныеСтроки = Счета.НайтиСтроки(ОтборСтроки);
ТД = НайденныеСтроки[0];
Счета.Удалить(ТД);
КонецПроцедуры	
// - Удаление Счета

