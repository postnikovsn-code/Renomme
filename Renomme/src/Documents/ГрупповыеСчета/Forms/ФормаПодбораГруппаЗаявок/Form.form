  <allowFormCustomize>true</allowFormCustomize>
  <enabled>true</enabled>
  <showTitle>true</showTitle>
  <showCloseButton>true</showCloseButton>
  <attributes>
    <name>Список</name>
    <id>1</id>
    <valueType>
      <types>DynamicList</types>
    </valueType>
    <view>
      <common>true</common>
    </view>
    <edit>
      <common>true</common>
    </edit>
    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>Список.Ссылка</segments>
    </notDefaultUseAlwaysAttributes>
    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>Список.СуммаДолг</segments>
    </notDefaultUseAlwaysAttributes>
    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>Список.СуммаОплаты</segments>
    </notDefaultUseAlwaysAttributes>
    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>Список.СуммаПроживание</segments>
    </notDefaultUseAlwaysAttributes>
    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>Список.СуммаУслуги</segments>
    </notDefaultUseAlwaysAttributes>
    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>Список.СчетГУИД</segments>
    </notDefaultUseAlwaysAttributes>
    <main>true</main>
    <extInfo xsi:type="form:DynamicListExtInfo">
      <queryText>ВЫБРАТЬ
	ЗаявкаНаБронированиеСчета.Ссылка КАК Ссылка,
	ЗаявкаНаБронированиеСчета.СчетГУИД КАК СчетГУИД,
	ЗаявкаНаБронированиеСчета.Контрагент КАК Оплачивает,
	ЗаявкаНаБронированиеСчета.Ссылка.Клиент КАК Клиент,
	ЗаявкаНаБронированиеСчета.Ссылка.Бронирует КАК Бронирует,
	ЗаявкаНаБронированиеСчета.Ссылка.РезервС КАК РезервС,
	ЗаявкаНаБронированиеСчета.Ссылка.РезервПо КАК РезервПо,
	ЗаявкаНаБронированиеСчета.Ссылка.НомерВРезерв КАК НомерВРезерв,
	ЕСТЬNULL(ДолгиПроживание.СуммаДолг, 0) + ЕСТЬNULL(ДолгиУслуги.СуммаДолг, 0) КАК СуммаДолг,
	ЕСТЬNULL(ДолгиПроживание.СуммаДолг, 0) КАК СуммаПроживание,
	ЕСТЬNULL(ДолгиУслуги.СуммаДолг, 0) КАК СуммаУслуги,
	ЕСТЬNULL(ОплатыСумма.СуммаОплаты, 0) КАК СуммаОплаты,
	ЗаявкаНаБронированиеСчета.Ссылка.Номер КАК Номер,
	ЗаявкаНаБронированиеСчета.Ссылка.Дата КАК Дата,
	ЗаявкаНаБронированиеСчета.Ссылка.Статус КАК Статус,
	ЗаявкаНаБронированиеСчета.НомерСчета КАК НомерСчета,
	ЗаявкаНаБронированиеСчета.ДатаСчета КАК ДатаСчета,
	ЗаявкаНаБронированиеСчета.ТолькоПроживание КАК ТолькоПроживание,
	ЗаявкаНаБронированиеСчета.ТолькоУслуги КАК ТолькоУслуги
ИЗ
	Документ.ЗаявкаНаБронирование.Счета КАК ЗаявкаНаБронированиеСчета
		ЛЕВОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
			ЗаявкаНаБронированиеРаспределениеОплатДолги.Ссылка КАК Ссылка,
			ЗаявкаНаБронированиеРаспределениеОплатДолги.СчетГУИД КАК СчетГУИД,
			СУММА(ЗаявкаНаБронированиеРаспределениеОплатДолги.СуммаОплаты) КАК СуммаОплаты
		ИЗ
			Документ.ЗаявкаНаБронирование.РаспределениеОплатДолги КАК ЗаявкаНаБронированиеРаспределениеОплатДолги
		
		СГРУППИРОВАТЬ ПО
			ЗаявкаНаБронированиеРаспределениеОплатДолги.Ссылка,
			ЗаявкаНаБронированиеРаспределениеОплатДолги.СчетГУИД) КАК ОплатыСумма
		ПО ЗаявкаНаБронированиеСчета.Ссылка = ОплатыСумма.Ссылка
			И ЗаявкаНаБронированиеСчета.СчетГУИД = ОплатыСумма.СчетГУИД
		ЛЕВОЕ СОЕДИНЕНИЕ Документ.ГрупповыеСчета.ДокументыДолги КАК ГрупповыеСчетаДокументыДолги
		ПО ЗаявкаНаБронированиеСчета.Ссылка = ГрупповыеСчетаДокументыДолги.ДокументДолг
			И ЗаявкаНаБронированиеСчета.СчетГУИД = ГрупповыеСчетаДокументыДолги.СчетГУИД
		ЛЕВОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
			ЗаявкаСчетаДетальноДолги.Ссылка КАК Ссылка,
			ЗаявкаСчетаДетальноДолги.СчетГУИД КАК СчетГУИД,
			ЗаявкаСчетаДетальноДолги.СуммаДолг КАК СуммаДолг
		ИЗ
			(ВЫБРАТЬ
				ЗаявкаНаБронированиеСчетаДетальноДолги.Ссылка КАК Ссылка,
				ЗаявкаНаБронированиеСчетаДетальноДолги.СчетГУИД КАК СчетГУИД,
				СУММА(ЗаявкаНаБронированиеСчетаДетальноДолги.СуммаДолг) КАК СуммаДолг
			ИЗ
				Документ.ЗаявкаНаБронирование.СчетаДетальноДолги КАК ЗаявкаНаБронированиеСчетаДетальноДолги
			ГДЕ
				ЗаявкаНаБронированиеСчетаДетальноДолги.Услуга = ЛОЖЬ
			
			СГРУППИРОВАТЬ ПО
				ЗаявкаНаБронированиеСчетаДетальноДолги.Ссылка,
				ЗаявкаНаБронированиеСчетаДетальноДолги.СчетГУИД) КАК ЗаявкаСчетаДетальноДолги
				ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.ЗаявкаНаБронирование.Счета КАК ЗаявкаНаБронированиеСчета
				ПО ЗаявкаСчетаДетальноДолги.Ссылка = ЗаявкаНаБронированиеСчета.Ссылка
					И ЗаявкаСчетаДетальноДолги.СчетГУИД = ЗаявкаНаБронированиеСчета.СчетГУИД
		ГДЕ
			ВЫБОР
					КОГДА &amp;ТолькоПроживание
						ТОГДА ЗаявкаНаБронированиеСчета.ТолькоПроживание = &amp;ТолькоПроживание
					ИНАЧЕ ИСТИНА
				КОНЕЦ) КАК ДолгиПроживание
		ПО ЗаявкаНаБронированиеСчета.Ссылка = ДолгиПроживание.Ссылка
			И ЗаявкаНаБронированиеСчета.СчетГУИД = ДолгиПроживание.СчетГУИД
		ЛЕВОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
			ЗаявкаСчетДетальноДолги.Ссылка КАК Ссылка,
			ЗаявкаСчетДетальноДолги.СчетГУИД КАК СчетГУИД,
			ЗаявкаСчетДетальноДолги.СуммаДолг КАК СуммаДолг
		ИЗ
			(ВЫБРАТЬ
				ЗаявкаНаБронированиеСчетаДетальноДолги.Ссылка КАК Ссылка,
				ЗаявкаНаБронированиеСчетаДетальноДолги.СчетГУИД КАК СчетГУИД,
				СУММА(ЗаявкаНаБронированиеСчетаДетальноДолги.СуммаДолг) КАК СуммаДолг
			ИЗ
				Документ.ЗаявкаНаБронирование.СчетаДетальноДолги КАК ЗаявкаНаБронированиеСчетаДетальноДолги
			ГДЕ
				ЗаявкаНаБронированиеСчетаДетальноДолги.Услуга = ИСТИНА
			
			СГРУППИРОВАТЬ ПО
				ЗаявкаНаБронированиеСчетаДетальноДолги.Ссылка,
				ЗаявкаНаБронированиеСчетаДетальноДолги.СчетГУИД) КАК ЗаявкаСчетДетальноДолги
				ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.ЗаявкаНаБронирование.Счета КАК ЗаявкаНаБронированиеСчета
				ПО ЗаявкаСчетДетальноДолги.Ссылка = ЗаявкаНаБронированиеСчета.Ссылка
					И ЗаявкаСчетДетальноДолги.СчетГУИД = ЗаявкаНаБронированиеСчета.СчетГУИД
		ГДЕ
			ВЫБОР
					КОГДА &amp;ТолькоУслуги
						ТОГДА ЗаявкаНаБронированиеСчета.ТолькоУслуги = &amp;ТолькоУслуги
					ИНАЧЕ ИСТИНА
				КОНЕЦ) КАК ДолгиУслуги
		ПО ЗаявкаНаБронированиеСчета.Ссылка = ДолгиУслуги.Ссылка
			И ЗаявкаНаБронированиеСчета.СчетГУИД = ДолгиУслуги.СчетГУИД
ГДЕ
	ЗаявкаНаБронированиеСчета.Ссылка.ПометкаУдаления = ЛОЖЬ
	И ЗаявкаНаБронированиеСчета.Ссылка.Проведен = ИСТИНА
	И ЗаявкаНаБронированиеСчета.ЭтоПредварительныйГрупповойСчет = ИСТИНА
	И ВЫБОР
			КОГДА &amp;ТолькоПроживание
				ТОГДА ЕСТЬNULL(ДолгиПроживание.СуммаДолг, 0) > 0
			КОГДА &amp;ТолькоУслуги
				ТОГДА ЕСТЬNULL(ДолгиУслуги.СуммаДолг, 0) > 0
			ИНАЧЕ ЕСТЬNULL(ДолгиПроживание.СуммаДолг, 0) + ЕСТЬNULL(ДолгиУслуги.СуммаДолг, 0) > 0
		КОНЕЦ
	И ЗаявкаНаБронированиеСчета.Ссылка.РезервС >= &amp;РезервС
	И ЗаявкаНаБронированиеСчета.Ссылка.РезервПо &lt;= &amp;РезервПо
	И ЗаявкаНаБронированиеСчета.Контрагент = &amp;КонтрагентОтбор
	И ГрупповыеСчетаДокументыДолги.Ссылка ЕСТЬ NULL</queryText>
      <autoFillAvailableFields>true</autoFillAvailableFields>
      <customQuery>true</customQuery>
      <getInvisibleFieldPresentations>true</getInvisibleFieldPresentations>
    </extInfo>
