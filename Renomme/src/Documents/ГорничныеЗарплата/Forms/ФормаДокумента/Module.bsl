&НаСервере
Процедура РасчитатьЗарплатуНаСервере()
ДН = Объект.ДН; 
ДК = КонецДня(Объект.ДК);

ЗаполнитьЦеныУборки();

//
Запрос = Новый Запрос;
Запрос.Текст = ГорничныеЗарплата.ЗапросГорничныеДанные();

Запрос.УстановитьПараметр("ДН", ДН);
Запрос.УстановитьПараметр("ДК", ДК);

ТЗ_Уборки = Запрос.Выполнить().Выгрузить();

Запрос = Новый Запрос("ВЫБРАТЬ
                      |	ГорничныеПрачечнаяПрачечная.Горничная КАК Горничная,
                      |	СУММА(ГорничныеПрачечнаяПрачечная.СуммаПрачечная) КАК СуммаПрачечная
                      |ИЗ
                      |	Документ.ГорничныеПрачечная.Прачечная КАК ГорничныеПрачечнаяПрачечная
                      |ГДЕ
                      |	ГорничныеПрачечнаяПрачечная.Ссылка.ПометкаУдаления = ЛОЖЬ
                      |	И ГорничныеПрачечнаяПрачечная.ДатаУслуги МЕЖДУ &ДН И &ДК
                      |
                      |СГРУППИРОВАТЬ ПО
                      |	ГорничныеПрачечнаяПрачечная.Горничная");   

Запрос.УстановитьПараметр("ДН", ДН);
Запрос.УстановитьПараметр("ДК", ДК);
ТЗ_Прачечная = Запрос.Выполнить().Выгрузить();

Запрос = Новый Запрос;
Запрос.Текст = "ВЫБРАТЬ
               |	ГорничныеСмены.Горничная КАК Горничная,
               |	КОЛИЧЕСТВО(РАЗЛИЧНЫЕ ГорничныеСмены.ДатаСмены) КАК КоличествоСмен
               |ИЗ
               |	Документ.ГорничныеСмены КАК ГорничныеСмены
               |ГДЕ
               |	ГорничныеСмены.ПометкаУдаления = ЛОЖЬ
               |	И ГорничныеСмены.ДатаСмены МЕЖДУ &ДН И &ДК
               |
               |СГРУППИРОВАТЬ ПО
               |	ГорничныеСмены.Горничная
               |
               |УПОРЯДОЧИТЬ ПО
               |	ГорничныеСмены.Горничная";

Запрос.УстановитьПараметр("ДН", ДН);
Запрос.УстановитьПараметр("ДК", ДК);
ТЗ_Смены = Запрос.Выполнить().Выгрузить();
//

//
ТЗ_Зарплата = Объект.Зарплата.Выгрузить(); 

Объект.Зарплата.Очистить();
Для Каждого Строка Из ГорничныеСправочник Цикл
	НоваяСтрока = Объект.Зарплата.Добавить(); 
	НоваяСтрока.Горничная = Строка.Горничная; 
КонецЦикла;

Для Каждого Строка Из Объект.Зарплата Цикл
	
	ОтборСтроки = Новый Структура("Горничная", Строка.Горничная);
	
	НайденныеСтроки = ТЗ_Смены.НайтиСтроки(ОтборСтроки);
	Если НайденныеСтроки.Количество() > 0 Тогда
		НайденнаяСтрока = НайденныеСтроки[0];
		Строка.КоличествоСмен = НайденнаяСтрока.КоличествоСмен;
	КонецЕсли;
	
	НайденныеСтроки = ГорничныеСправочник.НайтиСтроки(ОтборСтроки);
	Если НайденныеСтроки.Количество() > 0 Тогда
		НайденнаяСтрока = НайденныеСтроки[0];

		Строка.Оклад = СуммаОклад(НайденнаяСтрока.Горничная);
		Строка.Отпуск = СуммаОтпуск(НайденнаяСтрока.Горничная);
		
		Если НастройкиСервер.ЭтоЛайв()
		ИЛИ НастройкиСервер.ЭтоЧехов()
		ИЛИ НастройкиСервер.ЭтоРеноме()
		ИЛИ НастройкиСервер.ЭтоДомСоветов()
		Тогда	
			//НадбавкаЗаСтаж = СуммаНадбавкаЗаСтаж(НайденнаяСтрока.ДатаПриема);
			НадбавкаЗаСтаж = СуммаНадбавкаЗаСтаж(НайденнаяСтрока);
			Строка.НадбавкаЗаСтаж = НадбавкаЗаСтаж;
		КонецЕсли;	
			
		Если НастройкиСервер.ЭтоЛайв()
		ИЛИ НастройкиСервер.ЭтоЧехов()
		ИЛИ НастройкиСервер.ЭтоРеноме()
		ИЛИ НастройкиСервер.ЭтоДомСоветов()
		Тогда	
			//Строка.НадбавкаЗаСтандарты = НайденнаяСтрока.НадбавкаЗаСтандарты;
			Строка.НадбавкаЗаСтандарты = СуммаНадбавкаЗаСтандарты(Строка.Горничная);		КонецЕсли;	
	КонецЕсли;	
	
	НайденныеСтроки = ТЗ_Прачечная.НайтиСтроки(ОтборСтроки);
	Если НайденныеСтроки.Количество() > 0 Тогда
		НайденнаяСтрока = НайденныеСтроки[0];
		Строка.СуммаПрачечная = НайденнаяСтрока.СуммаПрачечная;
	КонецЕсли;	
	
	Если Строка.Горничная.УчетУборок Тогда
		НайденныеСтроки = ТЗ_Уборки.НайтиСтроки(ОтборСтроки);
		Если НайденныеСтроки.Количество() > 0 Тогда
			НайденнаяСтрока = НайденныеСтроки[0];
			Строка.Г_Количество = НайденнаяСтрока.Г;
			Строка.Г_Сумма = Объект.Г_Цена * НайденнаяСтрока.Г;
			Строка.Т_Количество = НайденнаяСтрока.Т;
			Строка.Т_Сумма = Объект.Т_Цена * НайденнаяСтрока.Т;
			Строка.ТС_Количество = НайденнаяСтрока.ТС;
			Строка.ТС_Сумма = Объект.ТС_Цена * НайденнаяСтрока.ТС;
			Строка.РК_Количество = НайденнаяСтрока.РК;
			Строка.РК_Сумма = Объект.РК_Цена * НайденнаяСтрока.РК;
			
			Строка.МК_Количество = НайденнаяСтрока.МК;
			Строка.МК_Сумма = Объект.МК_Цена * НайденнаяСтрока.МК;
			
			Строка.МДМ_Количество = НайденнаяСтрока.МДМ;
			Строка.МДМ_Сумма = Объект.МДМ_Цена * НайденнаяСтрока.МДМ;
		КонецЕсли;	
	КонецЕсли;	
		
	ОтборСтроки = Новый Структура("Горничная", Строка.Горничная);
	НайденныеСтроки = ТЗ_Зарплата.НайтиСтроки(ОтборСтроки);
	Если НайденныеСтроки.Количество() > 0 Тогда
		СтрокаТЗ_Зарплата = НайденныеСтроки[0];
		Если СтрокаТЗ_Зарплата.Оклад_Есть Тогда Строка.Оклад_Есть = Истина; Строка.Оклад_Р = СтрокаТЗ_Зарплата.Оклад_Р; КонецЕсли;		
		Если СтрокаТЗ_Зарплата.Отпуск_Есть Тогда Строка.Отпуск_Есть = Истина; Строка.Отпуск_Р = СтрокаТЗ_Зарплата.Отпуск_Р; КонецЕсли;		
		Если СтрокаТЗ_Зарплата.НадбавкаЗаСтаж_Есть Тогда Строка.НадбавкаЗаСтаж_Есть = Истина; Строка.НадбавкаЗаСтаж_Р = СтрокаТЗ_Зарплата.НадбавкаЗаСтаж_Р; КонецЕсли;		
		Если СтрокаТЗ_Зарплата.НадбавкаЗаСтандарты_Есть Тогда Строка.НадбавкаЗаСтандарты_Есть = Истина; Строка.НадбавкаЗаСтандарты_Р = СтрокаТЗ_Зарплата.НадбавкаЗаСтандарты_Р; КонецЕсли;		
		Если СтрокаТЗ_Зарплата.СуммаПрачечная_Есть Тогда Строка.СуммаПрачечная_Есть = Истина; Строка.СуммаПрачечная_Р = СтрокаТЗ_Зарплата.СуммаПрачечная_Р; КонецЕсли;		
		Если СтрокаТЗ_Зарплата.КоличествоСмен_Есть Тогда Строка.КоличествоСмен_Есть = Истина; Строка.КоличествоСмен_Р = СтрокаТЗ_Зарплата.КоличествоСмен_Р; КонецЕсли;		
		
		//Строка.Г_Количество_Р = СтрокаТЗ_Зарплата.Г_Количество_Р;		
		//Строка.Т_Количество_Р = СтрокаТЗ_Зарплата.Т_Количество_Р;		
		//Строка.ТС_Количество_Р = СтрокаТЗ_Зарплата.ТС_Количество_Р;		
		//Строка.РК_Количество_Р = СтрокаТЗ_Зарплата.РК_Количество_Р;		
		//Строка.МК_Количество_Р = СтрокаТЗ_Зарплата.МК_Количество_Р;	
		//Строка.МДМ_Количество_Р = СтрокаТЗ_Зарплата.МДМ_Количество_Р;	
		
		Если СтрокаТЗ_Зарплата.Г_Количество_Р <> 0 Тогда
			Г_КоличествоРазница = Строка.Г_Количество - СтрокаТЗ_Зарплата.Г_Количество; 
			Строка.Г_Количество_Р = СтрокаТЗ_Зарплата.Г_Количество_Р - Г_КоличествоРазница;		
		КонецЕсли;	
			
		Если СтрокаТЗ_Зарплата.Т_Количество_Р <> 0 Тогда
			Т_КоличествоРазница = Строка.Т_Количество - СтрокаТЗ_Зарплата.Т_Количество; 
			Строка.Т_Количество_Р = СтрокаТЗ_Зарплата.Т_Количество_Р - Т_КоличествоРазница;		
		КонецЕсли;	
		
		Если СтрокаТЗ_Зарплата.ТС_Количество_Р <> 0 Тогда
			ТС_КоличествоРазница = Строка.ТС_Количество - СтрокаТЗ_Зарплата.ТС_Количество; 
			Строка.ТС_Количество_Р = СтрокаТЗ_Зарплата.ТС_Количество_Р - ТС_КоличествоРазница;		
		КонецЕсли;	
		
		Если СтрокаТЗ_Зарплата.РК_Количество_Р <> 0 Тогда
			РК_КоличествоРазница = Строка.РК_Количество - СтрокаТЗ_Зарплата.РК_Количество; 
			Строка.РК_Количество_Р = СтрокаТЗ_Зарплата.РК_Количество_Р - РК_КоличествоРазница;
		КонецЕсли;	
		
		Если СтрокаТЗ_Зарплата.МК_Количество_Р <> 0 Тогда
			МК_КоличествоРазница = Строка.МК_Количество - СтрокаТЗ_Зарплата.МК_Количество; 
			Строка.МК_Количество_Р = СтрокаТЗ_Зарплата.МК_Количество_Р - МК_КоличествоРазница;	
		КонецЕсли;	
		
		Если СтрокаТЗ_Зарплата.МДМ_Количество_Р <> 0 Тогда
			МДМ_КоличествоРазница = Строка.МДМ_Количество - СтрокаТЗ_Зарплата.МДМ_Количество; 
			Строка.МДМ_Количество_Р = СтрокаТЗ_Зарплата.МДМ_Количество_Р - МДМ_КоличествоРазница;	
		КонецЕсли;	
		
		Строка.Больничный = СтрокаТЗ_Зарплата.Больничный;	
		Строка.Премия = СтрокаТЗ_Зарплата.Премия;	
		
		Строка.ДопРаботы = СтрокаТЗ_Зарплата.ДопРаботы;	
		
		//Строка.Сдельно = СтрокаТЗ_Зарплата.Сдельно;	
		//Если СтрокаТЗ_Зарплата.Сдельно_Есть Тогда 
		//	Строка.Сдельно_Есть = Истина; Строка.Сдельно_Р = СтрокаТЗ_Зарплата.Сдельно_Р; 
		//КонецЕсли;		
		
		Сдельно = 0;
		Для Каждого СтрокаСдельно Из Объект.Сдельно Цикл
			Если СтрокаСдельно.Горничная <> Строка.Горничная Тогда Продолжить; КонецЕсли;
			Если НЕ (СтрокаСдельно.Дата >= Объект.ДН И СтрокаСдельно.Дата <= Объект.ДК) Тогда Продолжить; КонецЕсли;

			СдельноИтого = СдельноИтого(СтрокаСдельно);
			Сдельно = Сдельно + СдельноИтого;
		КонецЦикла;
		Строка.Сдельно = Сдельно;

		Если СтрокаТЗ_Зарплата.Сдельно_Есть Тогда 
			Строка.Сдельно_Есть = Истина; Строка.Сдельно_Р = СтрокаТЗ_Зарплата.Сдельно_Р; 
		КонецЕсли;
		
		Строка.КорректировкаДопНачислено = СтрокаТЗ_Зарплата.КорректировкаДопНачислено;	
		
		Строка.Аванс_кк = СтрокаТЗ_Зарплата.Аванс_кк;	
		Строка.Аванс_нал = СтрокаТЗ_Зарплата.Аванс_нал;	
		Строка.Зарплата_кк = СтрокаТЗ_Зарплата.Зарплата_кк;	
		Строка.Отпуск_кк = СтрокаТЗ_Зарплата.Отпуск_кк;	
		Строка.Отпуск_нал = СтрокаТЗ_Зарплата.Отпуск_нал;	
		
		Строка.Сдельно_нал = СтрокаТЗ_Зарплата.Сдельно_нал;	
		Если СтрокаТЗ_Зарплата.Сдельно_нал_Есть Тогда 
			Строка.Сдельно_нал_Есть = Истина; Строка.Сдельно_нал_Р = СтрокаТЗ_Зарплата.Сдельно_нал_Р; 
		КонецЕсли;	
		
		Строка.ИныеВыплаты_нал = СтрокаТЗ_Зарплата.ИныеВыплаты_нал;	
		
		Строка.КоличествоЧасов = КоличествоЧасовНаСервере(СтрокаТЗ_Зарплата, СтрокаТЗ_Зарплата.КоличествоСмен_Э);	
		Если СтрокаТЗ_Зарплата.КоличествоЧасов_Есть Тогда 
			Строка.КоличествоЧасов_Есть = Истина; Строка.КоличествоЧасов_Р = СтрокаТЗ_Зарплата.КоличествоЧасов_Р; 
		КонецЕсли;	
		
	КонецЕсли;		
КонецЦикла;
//

//
ТЗ_ЗарплатаПомещения = Объект.ЗарплатаПомещения.Выгрузить();
Объект.ЗарплатаПомещения.Очистить();

Запрос = Новый Запрос;
Запрос.Текст = ГорничныеЗарплата.ЗапросГорничныеПомещенияДанные();

Запрос.УстановитьПараметр("ДН", ДН);
Запрос.УстановитьПараметр("ДК", ДК);
ТЗ_ПомещенияУборки = Запрос.Выполнить().Выгрузить();
Если НЕ ЕстьОбменСГорничными Тогда
	ТЗ_ПомещенияУборки.Очистить();
КонецЕсли;
	
Для Каждого СтрокаГорничные Из ГорничныеСправочник Цикл
	Если НЕ СтрокаГорничные.Горничная.УчетУборок Тогда Продолжить; КонецЕсли;

	Для Каждого СтрокаПомещения Из ПомещенияСправочник Цикл
		НоваяСтрока = Объект.ЗарплатаПомещения.Добавить();
		НоваяСтрока.Горничная = СтрокаГорничные.Горничная;
		НоваяСтрока.Помещение = СтрокаПомещения.Помещение;
		
		ОтборСтрок = Новый Структура("Горничная, Помещение", СтрокаГорничные.Горничная, СтрокаПомещения.Помещение);
		НайденныеСтроки = ТЗ_ПомещенияУборки.НайтиСтроки(ОтборСтрок);
		Если НайденныеСтроки.Количество() > 0 Тогда 
			НоваяСтрока.Количество = НайденныеСтроки[0].Количество;
		КонецЕсли;
		
		ОтборСтрок = Новый Структура("Горничная, Помещение", СтрокаГорничные.Горничная, СтрокаПомещения.Помещение);
		НайденныеСтроки = ТЗ_ЗарплатаПомещения.НайтиСтроки(ОтборСтрок);
		Если НайденныеСтроки.Количество() > 0 Тогда
			НайденнаяСтрока = НайденныеСтроки[0];
			Если НайденнаяСтрока.Количество_Р <> 0 Тогда
				Разница = НоваяСтрока.Количество - НайденнаяСтрока.Количество;
				НоваяСтрока.Количество_Р = НайденныеСтроки[0].Количество_Р - Разница;
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
КонецЦикла;
