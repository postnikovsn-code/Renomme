&НаКлиенте
Перем MSWord, ДокументWord;

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
Параметры.Свойство("ИмяФайла", ИмяФайла);
Параметры.Свойство("ПолноеИмяФайла", ПолноеИмяФайла);
Параметры.Свойство("ДокументДолгСсылка", ДокументДолгСсылка);
Параметры.Свойство("СчетГУИД", СчетГУИД);

//Если НЕ ЗначениеЗаполнено(СчетГУИД) Тогда
//	Отказ = Истина;
//	Возврат;
//КонецЕсли;
	
ЭтоРеноме = НастройкиСервер.ЭтоРеноме();

ЗаполнитьДанныеБрони();
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьДанныеБрони()
Если ТипЗнч(ДокументДолгСсылка) = Тип("ДокументСсылка.ЗаявкаНаБронирование") Тогда
	Если ЭтоРеноме Тогда		
		ЗаполнитьДанныеБрониЗаявкаРеноме(ДокументДолгСсылка, СчетГУИД);
	Иначе
		ЗаполнитьДанныеБрониЗаявка(ДокументДолгСсылка, СчетГУИД);
	КонецЕсли;	
ИначеЕсли ТипЗнч(ДокументДолгСсылка) = Тип("ДокументСсылка.ГрупповыеСчета") Тогда	
	Если ЭтоРеноме Тогда		
		ЗаполнитьДанныеБрониГрупповойСчетРеноме(ДокументДолгСсылка);
	Иначе
		ЗаполнитьДанныеБрониГрупповойСчет(ДокументДолгСсылка);
	КонецЕсли;	
КонецЕсли;
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьДанныеБрониЗаявка(ДокументДолгСсылка, СчетГУИД)
ОтборСтроки = Новый Структура("СчетГУИД", СчетГУИД);
Счета = ДокументДолгСсылка.Счета.НайтиСтроки(ОтборСтроки);
Если Счета.Количество() = 0 Тогда Возврат; КонецЕсли;
Счет = Счета[0];

Результат = ПечатьСервер.ДокументТелоСтроки(ДокументДолгСсылка, Счет, Ложь);	
ТЗСтроки = Результат.ТЗСтроки;

Для Каждого Строка Из ТЗСтроки Цикл
	Нов = ДанныеБрони.Добавить();

	Нов.Бронь = ДокументДолгСсылка;

	//Нов.ЭтоУслуга = Строка.ЭтоУслуга;
	Нов.Клиент = Строка.Клиент;

	//Нов.Наименование = Строка.НаименованиеТовара;
	
	Нов.РезервС = Формат(Строка.ДатаС, "ДФ=dd.MM.yy");
	Нов.РезервПо = Формат(Строка.ДатаПо + 86400, "ДФ=dd.MM.yy");

	Нов.КолвоЧеловек = ДокументДолгСсылка.КолВоЧеловек;
	//Нов.Категория = ДокументДолгСсылка.КатегорияНомера.Наименование;

	Нов.КолвоНочей = Строка.Количество;

	Нов.СТ = Строка.Цена;	

	//Нов.ОСТ = Строка.СуммаСНДС;
КонецЦикла;
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьДанныеБрониЗаявкаРеноме(ДокументДолгСсылка, СчетГУИД)
	
ОтборСтроки = Новый Структура("СчетГУИД", СчетГУИД);
Счета = ДокументДолгСсылка.Счета.НайтиСтроки(ОтборСтроки);
Если Счета.Количество() = 0 Тогда Возврат; КонецЕсли;
Счет = Счета[0];

Результат = ПечатьСервер.ДокументТелоСтроки(ДокументДолгСсылка, Счет, Ложь);	

ТЗСтроки = Результат.ТЗСтроки;

Для Каждого Строка Из ТЗСтроки Цикл
	Нов = ДанныеБрониРеноме.Добавить();

	Нов.Бронь = ДокументДолгСсылка;

	Нов.ЭтоУслуга = Строка.ЭтоУслуга;
	Нов.Клиент = Строка.Клиент;

	Нов.Наименование = Строка.НаименованиеТовара;
	
	Нов.РезервС = Формат(Строка.ДатаС, "ДФ=dd.MM.yy");
	Нов.РезервПо = Формат(Строка.ДатаПо + 86400, "ДФ=dd.MM.yy");

	Нов.КолвоЧеловек = ДокументДолгСсылка.КолВоЧеловек;
	Нов.Категория = ДокументДолгСсылка.КатегорияНомера.Наименование;

	Нов.КолвоНочей = Строка.Количество;

	Нов.Количество = Строка.Количество; 
	
	Нов.СТ = Строка.Цена;	

	Нов.ОСТ = Строка.СуммаСНДС;
КонецЦикла;

КонецПроцедуры

&НаСервере
