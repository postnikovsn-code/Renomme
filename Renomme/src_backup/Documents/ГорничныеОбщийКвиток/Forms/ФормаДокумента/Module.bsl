&НаКлиенте
Процедура КвитокПечать(Команда)
ЭтаФорма.Записать(Новый Структура("РежимЗаписи", РежимЗаписиДокумента.Проведение)); 	
	
ТД = Элементы.Горничные.ТекущиеДанные;	
Если ТД = Неопределено Тогда Возврат; КонецЕсли;

ТС = Элементы.Горничные.ТекущаяСтрока;	

ТабДок = КвитокПечатьНаСервере(ТС);

ПараметрыФормы = Новый Структура("ПолеОтчета, ЗаголовокОтчета", ТабДок, "Квиток " + ТД.Горничная); 
ОткрытьФорму("ОбщаяФорма.ВыводОтчета", ПараметрыФормы, ,Истина);
КонецПроцедуры

&НаСервере
Функция КвитокПечатьНаСервере(ТС)
ТабДок = Новый ТабличныйДокумент;
	
ТД = Горничные.НайтиПоИдентификатору(ТС);

Макет = Документы.ГорничныеОбщийКвиток.ПолучитьМакет("МакетКвиток");

Область = Макет.ПолучитьОбласть("Шапка");
Область.Параметры.Горничная = ТД.Горничная;
ТабДок.Вывести(Область);

Для Каждого Строка Из Квиток Цикл
	Область = Макет.ПолучитьОбласть("Строка");
	Область.Параметры.Наименование = Строка.Наименование;
	Область.Параметры.Количество  = Строка.Количество_Э;
	Область.Параметры.Сумма  = Строка.Сумма_Э;
	
	Если Строка.КодЗаполнения = "ИтогоНачисления" 
	ИЛИ Строка.КодЗаполнения = "ОстатокКВыплате" 
	Тогда
		Область.Область(1,1,1,3).Шрифт = Новый Шрифт(, , Истина, Истина);
		Область.Область(1,1,1, 3).ЦветФона = Новый Цвет(240, 240, 240);
	КонецЕсли;
	
	ТабДок.Вывести(Область);
КонецЦикла;

