// Модуль формы обработки "Настройки сканера PassportBox".
// Реквизиты формы: IP, Порт, Таймаут, Активность.
// При открытии - заполняются из констант. Кнопка "Сохранить" - пишет обратно.
// Кнопка "Проверить связь" - посылает Snapshot-запрос с текущими значениями полей (без сохранения).

#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	IP         = Константы.PassportBoxIP.Получить();
	Порт       = Константы.PassportBoxПорт.Получить();
	Таймаут    = Константы.PassportBoxТаймаут.Получить();
	Активность = Константы.PassportBoxАктивность.Получить();

	// Подставим разумные дефолты, если константы пусты при первом открытии.
	Если Порт = 0 Тогда
		Порт = 80;
	КонецЕсли;
	Если Таймаут = 0 Тогда
		Таймаут = 30;
	КонецЕсли;
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура Сохранить(Команда)
	СохранитьНаСервере();
	ПоказатьСообщение("Настройки PassportBox сохранены.");
КонецПроцедуры

&НаКлиенте
Процедура ПроверитьСвязь(Команда)
	Если НЕ ЗначениеЗаполнено(IP) Тогда
		ПоказатьСообщение("Заполните IP-адрес сканера, прежде чем проверять связь.");
		Возврат;
	КонецЕсли;
	Результат = ПроверитьСвязьНаСервере();
	Если Результат.Успех Тогда
		ПоказатьСообщение("Связь установлена. " + Результат.Описание);
	Иначе
		ПоказатьСообщение("Сканер недоступен. " + Результат.Описание);
	КонецЕсли;
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаСервере
Процедура СохранитьНаСервере()
	Константы.PassportBoxIP.Установить(СокрЛП(IP));
	Константы.PassportBoxПорт.Установить(?(Порт = 0, 80, Порт));
	Константы.PassportBoxТаймаут.Установить(?(Таймаут = 0, 30, Таймаут));
	Константы.PassportBoxАктивность.Установить(Активность);
КонецПроцедуры

&НаСервере
Функция ПроверитьСвязьНаСервере()
	Соединение = PassportBoxВызовСервера.СоздатьСоединение(
		СокрЛП(IP),
		?(Порт = 0, 80, Порт),
		?(Таймаут = 0, 30, Таймаут));
	Если Соединение.Ошибка Тогда
		Возврат НовыйРезультатПроверки(Ложь, Соединение.Описание);
	КонецЕсли;
	Снимок = PassportBoxВызовСервера.ПолучитьКартинку(Соединение, "Snapshot");
	Если Снимок.Ошибка Тогда
		Возврат НовыйРезультатПроверки(Ложь, Снимок.Описание);
	КонецЕсли;
	РазмерБайт = Формат(Снимок.ДанныеКартинки.Размер(), "ЧГ=0");
	Возврат НовыйРезультатПроверки(Истина, "Snapshot получен (" + РазмерБайт + " байт).");
КонецФункции

&НаСервереБезКонтекста
Функция НовыйРезультатПроверки(Знач Успех, Знач Описание)
	Результат = Новый Структура;
	Результат.Вставить("Успех", Успех);
	Результат.Вставить("Описание", Описание);
	Возврат Результат;
КонецФункции

&НаКлиенте
Процедура ПоказатьСообщение(Знач Текст)
	Сообщение = Новый СообщениеПользователю;
	Сообщение.Текст = Текст;
	Сообщение.Сообщить();
КонецПроцедуры

#КонецОбласти
