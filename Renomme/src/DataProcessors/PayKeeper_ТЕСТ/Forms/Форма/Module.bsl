
&НаКлиенте
Процедура СоздатьПлатеж(Команда)
СоединениеPayKeeper = ПолучитьСоединение();
Если СоединениеPayKeeper.Ошибка Тогда Сообщить(СоединениеPayKeeper.Описание); Возврат; КонецЕсли;

Плательщик = "ПСН";
НомерСчёта = "Тест Номер счета";
НаименованиеУслуги = "Тест Услуга";
СуммаПлатежа = 1;
EmailОтсылкиЧека = "psn.invina@gmail.com";
ТелефонОтсылкиСМСУведомления = "+79826236241";

Результат = PayKeeper.ПолучитьQRКод(СоединениеPayKeeper, Плательщик, НомерСчёта, НаименованиеУслуги, СуммаПлатежа, EmailОтсылкиЧека, ТелефонОтсылкиСМСУведомления) ;
Если Результат.Ошибка Тогда Сообщить(Результат.Описание); Возврат; КонецЕсли;

ИдПлатежа = Результат.ИдПлатежа;
АдресКартинки = Результат.АдресКартинки;

ДанныеКартинкиBase64 = Результат.ДанныеКартинкиBase64; 
ДвоичныеДанныеКартинки = Base64Значение(ДанныеКартинкиBase64);

Если ЭтаФорма.КлючУникальности = Неопределено Тогда
	УникальныйИдентификаторФормы = Новый УникальныйИдентификатор();
Иначе
	УникальныйИдентификаторФормы = Новый УникальныйИдентификатор(ЭтаФорма.КлючУникальности);
КонецЕсли;	
QR_Картинка = ПоместитьВоВременноеХранилище(Новый Картинка(ДвоичныеДанныеКартинки), УникальныйИдентификаторФормы);

ИмяФайла = ПолучитьИмяВременногоФайла("jpg");
ДвоичныеДанныеКартинки.Записать(ИмяФайла);
МассивФайлов = Новый Массив;
МассивФайлов.Добавить(ИмяФайла);

МассивПолучатели = Новый Массив;
EmailПолучателя = "psn.invina@gmail.com";
МассивПолучатели.Добавить(EmailПолучателя);

Тема = "Счет на оплату";

ТекстСообщения = "";
ТекстСообщения = ТекстСообщения + "Счет";

ТекстСообщения = ТекстСообщения + Символы.ПС + + Символы.ПС;  
ТекстСообщения = "Адрес картинки: " + АдресКартинки;

Если ЭтаФорма.КлючУникальности = Неопределено Тогда
	УникальныйИдентификаторФормы = Новый УникальныйИдентификатор();
Иначе
	УникальныйИдентификаторФормы = Новый УникальныйИдентификатор(ЭтаФорма.КлючУникальности);
КонецЕсли;	
ФайлыКУдалению = МассивФайлов;

СлужебныеКлиент.ОтправитьEmail(Тема, МассивФайлов, МассивПолучатели, ТекстСообщения
	, ФайлыКУдалению, УникальныйИдентификаторФормы);

//СлужебныеСервер.ОтправитьWhatsApp("+79826236241", АдресКартинки);
МесенджерСервер.ОтправитьДанные_Месенджер("ОтправитьСсылка", "+79826236241", "", Неопределено, АдресКартинки);

Картинка = ПолучитьИзВременногоХранилища(QR_Картинка);
ДвоичныеДанныеКартинки = Картинка.ПолучитьДвоичныеДанные(); 
Изображение = Base64Строка(ДвоичныеДанныеКартинки);
//СлужебныеСервер.ОтправитьWhatsApp("+79826236241", Изображение);
МесенджерСервер.ОтправитьДанные_Месенджер("ОтправитьФайлИТекст", "+79826236241", Изображение, Неопределено, Неопределено );

СлужебныеСервер.ОтправитьBytehand("+79826236241", АдресКартинки);

КонецПроцедуры

