Функция ОтчетМесяцНаСервере(ДТО)
	//ЭлементыФормы.ПолеОтчета.Очистить();
	ПолеОтчета.Очистить();
	
	ЗапросОстатков=Новый Запрос("ВЫБРАТЬ
	|	СУММА(ДеньгиОстатки.СуммаОстаток) КАК СуммаОстаток,
	|	ДеньгиОстатки.ВидОплаты
	|ИЗ
	|	РегистрНакопления.Деньги.Остатки(&ДТ, ) КАК ДеньгиОстатки
	|ГДЕ
	|	ДеньгиОстатки.КредитнаяКарта = ЛОЖЬ
	|
	|СГРУППИРОВАТЬ ПО
	|	ДеньгиОстатки.ВидОплаты");
	
	ЗапросОстатков.УстановитьПараметр("ДТ",НачалоДня(ДТО));								
	ТЗОст=ЗапросОстатков.Выполнить().Выгрузить();
	
	//Макет=ПолучитьМакет("Макет");
	Макет = Отчеты.ЕжемесячныеФинансы.ПолучитьМакет("Макет");
	
	ЗапросПоДням=Новый Запрос("ВЫБРАТЬ
	|	НАЧАЛОПЕРИОДА(Деньги.Период, ДЕНЬ) КАК ДТ,
	|	Деньги.Регистратор,
	|	Деньги.ВидОплаты,
	|	СУММА(ВЫБОР
	|			КОГДА Деньги.ВидДвижения = &ВидД
	|				ТОГДА Деньги.Сумма
	|			ИНАЧЕ Деньги.Сумма * -1
	|		КОНЕЦ) КАК Сумма,
	|	Деньги.ВидОперации,
	|	Деньги.ВидДвижения,
	|	Деньги.ДокументОплаты,
	|	Деньги.КредитнаяКарта,
	|	Деньги.Оплата
	|ИЗ
	|	РегистрНакопления.Деньги КАК Деньги
	|ГДЕ
	|	Деньги.Период >= &Период
	|
	|СГРУППИРОВАТЬ ПО
	|	Деньги.Регистратор,
	|	Деньги.ВидОплаты,
	|	Деньги.ВидОперации,
	|	Деньги.ВидДвижения,
	|	НАЧАЛОПЕРИОДА(Деньги.Период, ДЕНЬ),
	|	Деньги.ДокументОплаты,
	|	Деньги.КредитнаяКарта,
	|	Деньги.Оплата");	
	ЗапросПоДням.УстановитьПараметр("Период",НачалоМесяца(ДТО));
	ЗапросПоДням.УстановитьПараметр("ВидД",ВидДвиженияНакопления.Приход);
	
	ТЗПодням=ЗапросПоДням.Выполнить().Выгрузить();
	ТЗПодням.Колонки.Добавить("ОплатаСтр");
	Для Каждого ТЗД из ТЗПодням цикл
		////  Если ТипЗнч(ТЗД.Оплата)=Тип("ДокументСсылка.ЗаявкаНаБронирование") тогда
		//
		//
		////	ТЗД.ОплатаСтр=?(ТипЗнч(ТЗД.Оплата)=Тип("ДокументСсылка.ЗаявкаНаБронирование"),"Проживание",ТЗД.Оплата.Родитель.Наименование);	  
		////иначе
		Попытка
			ТЗД.ОплатаСтр=?(ТЗД.Оплата.Пустая(),ТЗД.ВидОперации.Наименование,ТЗД.ОплатаСтр);	  
		Исключение
			ТЗД.ОплатаСтр="";
		КонецПопытки;
		////конецесли;
	конеццикла;
	
	Обл=Макет.ПолучитьОбласть("ШапкаОбщ");
	ОстатокПоКассе=ТЗОст.Найти(Перечисления.ВидОплаты.Наличные,"ВидОплаты");
	ОстатокПоБанку=ТЗОст.Найти(Перечисления.ВидОплаты.Безнал,"ВидОплаты");
	Обл.Параметры.Касса=?(ОстатокПоКассе=Неопределено,"--",ОстатокПоКассе.СуммаОстаток);
	Обл.Параметры.Банк=?(ОстатокПоБанку=Неопределено,"--",ОстатокПоБанку.СуммаОстаток);
	
	//ЭлементыФормы.ПолеОтчета.Вывести(Обл);
	ПолеОтчета.Вывести(Обл);
	
	// по дням
	
	Для каждого Вывод Из ТЗПодням Цикл
		Если ТипЗнч(Вывод.Оплата)=Тип("ДокументСсылка.ЗаявкаНаБронирование") тогда			  
			Если Вывод.ВидОплаты=Перечисления.ВидОплаты.Наличные или Вывод.КредитнаяКарта тогда
				Если Вывод.Оплата.Бронирует.Турагентство тогда		
					НовВывод=ТЗПодням.Добавить();
					НовВывод.ДТ=Вывод.ДТ;
					НовВывод.ВидОплаты=Вывод.ВидОплаты;
					НовВывод.ВидДвижения=ВидДвиженияНакопления.Приход;
					НовВывод.КредитнаяКарта=Вывод.КредитнаяКарта;
					НовВывод.ОплатаСтр="агентское вознаграждение";
					НовВывод.Сумма=Вывод.сумма*(Вывод.Оплата.Бронирует.ПроцентАгент_OLD/100);	
				конецесли;					
			конецесли;
		иначеесли Вывод.Оплата=Справочники.ДопУслуги.НайтиПоКоду("000000160") тогда
			Вывод.ОплатаСтр="агентское вознаграждение";
			
		конецесли;
	КонецЦикла; 
	
	ТЗДней=ТЗПодням.Скопировать();
	ТЗДней.Свернуть("ДТ","Сумма");
	ТЗКатегорий=ТЗПодням.Скопировать();
	ТЗКатегорий.Свернуть("ВидОплаты,ВидДвижения,ДокументОплаты","Сумма");
	ТЗДляВывода=ТЗПодням.Скопировать();
	ТЗДляВывода.Свернуть("ВидОплаты,ВидДвижения,КредитнаяКарта,ОплатаСтр","Сумма");
	
	ТЗВидПоДням=ТЗПодням.Скопировать();
	ТЗВидПоДням.Свернуть("ВидОплаты,ВидОперации,ДТ","Сумма");
	ТаблДок=Новый ТабличныйДокумент;
	Обл=Макет.ПолучитьОбласть("Шапка|ШапкаВерх");
	ТаблДок.Присоединить(Обл);
	Обл=Макет.ПолучитьОбласть("Шапка|ДТ");
	Для каждого ДТ Из ТЗДней Цикл
		Обл.Параметры.Период=Формат(ДТ.ДТ, "ДФ=dd.MM.yy");			
		ТаблДок.Присоединить(Обл);
	КонецЦикла;
	Обл=Макет.ПолучитьОбласть("Шапка|Итог");
	
	
	ТаблДок.Присоединить(Обл);
	
	//ЭлементыФормы.ПолеОтчета.Вывести(ТаблДок);
	ПолеОтчета.Вывести(ТаблДок);
	
	ТЗДляВывода.Колонки.Добавить("ВидДеятельности");
	ТЗДляВывода.Колонки.Добавить("ВидОплатыСтр");
	
	Для каждого Вывод Из ТЗДляВывода Цикл
		Вывод.ВидДеятельности=ОпределитьВидДеятельности(Справочники.ВидыОпераций.ПустаяСсылка());
		Вывод.ВидОплатыСтр=?(Вывод.ВидОплаты=Перечисления.ВидОплаты.Безнал,"Безналичный расчет","Наличные");
		Вывод.ВидОплатыСтр=?(Вывод.КредитнаяКарта,"Кредитная карта",Вывод.ВидОплатыСтр);
		
		
		Вывод.Сумма=?(Вывод.КредитнаяКарта,Вывод.Сумма-Вывод.Сумма*0.019,Вывод.Сумма);
		
	КонецЦикла; 
	
	ТЗДляВывода.Сортировать("ВидДеятельности,ВидДвижения,ВидОплатыСтр,ОплатаСтр");
	Для каждого Вывод Из ТЗДляВывода Цикл
		ТаблДок=Новый ТабличныйДокумент;
		Обл=Макет.ПолучитьОбласть("КатМал|ШапкаВерх");
		Обл.Параметры.КатегорияБол=Вывод.ВидОплатыСтр;
		////Обл.Параметры.Категория=Вывод.ВидОперации;
		Обл.Параметры.ВидОперации=Вывод.ВидДвижения;
		Обл.Параметры.ВидДеятельности=Вывод.ВидДеятельности;
		Обл.Параметры.Статья=Вывод.ОплатаСтр;
		
		ТаблДок.Присоединить(Обл);
		Обл=Макет.ПолучитьОбласть("КатМал|ДТ");
		Для каждого ДТ Из ТЗДней Цикл
			Отбор=Новый Структура("ДТ,ВидОплаты,ВидДвижения,ОплатаСтр,КредитнаяКарта",ДТ.ДТ,Вывод.ВидОплаты,Вывод.ВидДвижения,Вывод.ОплатаСтр,Вывод.КредитнаяКарта);
			СуммаДляВывода=0;
			СтрокиДТ=ТЗПодням.НайтиСтроки(Отбор);
			
			Для каждого СтрДТ Из СтрокиДТ Цикл
				Если Вывод.КредитнаяКарта тогда
					СтрДТ.Сумма=СтрДТ.Сумма-СтрДТ.Сумма*0.019;
				конецесли;
				
				СуммаДляВывода=СуммаДляВывода+СтрДТ.Сумма;
				
			КонецЦикла; 
			Обл.Параметры.Сумма=Формат(СуммаДляВывода, "ЧГ=");  
			ТаблДок.Присоединить(Обл);			  
		КонецЦикла;	
		Обл=Макет.ПолучитьОбласть("КатМал|Итог");
		
		Обл.Параметры.Сумма=Формат(Вывод.Сумма, "ЧГ=");  
		ТаблДок.Присоединить(Обл);
		
		//ЭлементыФормы.ПолеОтчета.Вывести(ТаблДок);
		ПолеОтчета.Вывести(ТаблДок);
		
	КонецЦикла; 
	ТаблДок=Новый ТабличныйДокумент;
	Обл=Макет.ПолучитьОбласть("ИтогНиз|ШапкаВерх");
	ТаблДок.Присоединить(Обл);
	СуммаДляВывода=0;
	Обл=Макет.ПолучитьОбласть("КатМал|Итог");
	
	Для каждого ДТ Из ТЗДней Цикл
		Обл.Параметры.Сумма=Формат(ДТ.Сумма, "ЧГ=");
		СуммаДляВывода=СуммаДляВывода+ДТ.Сумма;
		ТаблДок.Присоединить(Обл);			  
	КонецЦикла;	
	Обл.Параметры.Сумма=Формат(СуммаДляВывода, "ЧГ=");
	ТаблДок.Присоединить(Обл);	
	
	//ЭлементыФормы.ПолеОтчета.Вывести(ТаблДок);
	ПолеОтчета.Вывести(ТаблДок);
	
	// ГОСТ
	
	Обл=Макет.ПолучитьОбласть("ГОСТ");
	// Долги
	
	ЗапросДенег=Новый Запрос("ВЫБРАТЬ
	|	СУММА(Деньги.Сумма) КАК Сумма,
	|	Деньги.Оплата,
