	//	ПланыОбмена.ЗарегистрироватьИзменения(Узел, ЭтотОбъект);
	//КонецЕсли;
	
ИначеЕсли НастройкиСервер.ЭтоРеноме() Тогда
	//Если Данные.СуммаСтритАрт > 0 Тогда
	//	Узел = ПланыОбмена.ОбменГостиницы.НайтиПоКоду("СТРИТАРТ");	
	//	ПланыОбмена.ЗарегистрироватьИзменения(Узел, ЭтотОбъект);
