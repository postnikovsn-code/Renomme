&НаСервере
Функция ОтчетЗарплатаОбщийНаСервере()
ТабДок = Новый ТабличныйДокумент;

Макет = ПолучитьОбщийМакет("МакетЗарплатаОбщий");	

//Область = Макет.ПолучитьОбласть("Заголовок");
//ТабДок.Вывести(Область);

Область = Макет.ПолучитьОбласть("Шапка");
Если НастройкиСервер.ЭтоСтритАрт() Тогда
	Область.Параметры.Оклад = "Оклад \ коворкинг";
Иначе
	Область.Параметры.Оклад = "Оклад";
КонецЕсли;

ТабДок.Вывести(Область);

Зарплата = Объект.Зарплата;
Для Каждого Строка Из Зарплата Цикл
	Область = Макет.ПолучитьОбласть("Строка");
	
	Область.Параметры.Сотрудник = Строка.Горничная;
	Область.Параметры.ТипДолжности = Строка.Горничная.Должность.ТипДолжности;
	Область.Параметры.Должность = Строка.Горничная.Должность;
	
	Область.Параметры.КоличествоСмен = Строка.КоличествоСмен_Э;
	КоличествоЧасовОтчет = Строка.КоличествоЧасов;
	Область.Параметры.КоличествоЧасовОтчет = КоличествоЧасовОтчет;
	
	Область.Параметры.Оклад = Строка.Оклад_Э;
	Область.Параметры.НадбавкаЗаСтаж = Строка.НадбавкаЗаСтаж_Э;
	Область.Параметры.НадбавкаЗаСтандарты = Строка.НадбавкаЗаСтандарты_Э;
	
	Область.Параметры.Отпуск = Строка.Отпуск_Э;
	Область.Параметры.Больничный = Строка.Больничный;
	Область.Параметры.Премия = Строка.Премия;
	
	Область.Параметры.ДопРаботы = Строка.ДопРаботы;
	Область.Параметры.Сдельно = Строка.Сдельно;
	
	Область.Параметры.КорректировкаДопНачислено = Строка.КорректировкаДопНачислено;      
	
	Область.Параметры.СуммаПрачечная = Строка.СуммаПрачечная_Э;
	
	Область.Параметры.СуммаУборки = Строка.СуммаУборки;
	Область.Параметры.СуммаПомещения = Строка.СуммаПомещения;
	
	Область.Параметры.Итого = Строка.Итого;      
	Область.Параметры.ЗарплатаИтого = Строка.ЗарплатаИтого;      
	
	Область.Параметры.Аванс_кк = Строка.Аванс_кк;      
	Область.Параметры.Аванс_нал = Строка.Аванс_нал;      
	Область.Параметры.Зарплата_кк = Строка.Зарплата_кк;      
	Область.Параметры.Отпуск_кк = Строка.Отпуск_кк;      
	Область.Параметры.Отпуск_нал = Строка.Отпуск_нал;      
	Область.Параметры.Сдельно_нал = Строка.Сдельно_нал_Э;      
	Область.Параметры.ИныеВыплаты_нал = Строка.ИныеВыплаты_нал;      
	
	Выдано =  Строка.Аванс_кк + Строка.Аванс_нал + Строка.Зарплата_кк 
		+ Строка.Отпуск_кк + Строка.Отпуск_нал 
		+ Строка.Сдельно_нал_Э + Строка.ИныеВыплаты_нал; 
	ОстатокКВыдаче = Строка.ЗарплатаИтого - Выдано;     
	Область.Параметры.ОстатокКВыдаче = ОстатокКВыдаче;      
	
	Область.Параметры.СуммаМинимум = Строка.СуммаМинимум;      
	
	ТабДок.Вывести(Область);
КонецЦикла;

ТабДок.ОриентацияСтраницы = ОриентацияСтраницы.Ландшафт;

Возврат ТабДок;
КонецФункции

