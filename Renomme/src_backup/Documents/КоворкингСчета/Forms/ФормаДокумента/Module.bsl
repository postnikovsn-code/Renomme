//                                                                           
&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
Если РаботаСИнтерфейсомСервер.УстановитьТолькоПросмотр(ЭтаФорма) Тогда Отказ = Истина; Возврат; КонецЕсли;

РаботаСИнтерфейсомКлиентСервер.УбратьКнопкуКоманднойПанелиФормы(ЭтаФорма.КоманднаяПанель,"ФормаУдалить");

Если НЕ ЗначениеЗаполнено(Объект.Ссылка) Тогда 	
	Параметры.Свойство("КоворкингЗаявка", Объект.КоворкингЗаявка);
	Если НЕ ЗначениеЗаполнено(Объект.КоворкингЗаявка) Тогда Отказ = Истина;	Возврат; КонецЕсли;
КонецЕсли;

ЭтоАдминистратор = НастройкиСервер.ЭтоАдминистратор();
Элементы.КоворкингЗаявка.ТолькоПросмотр = НЕ ЭтоАдминистратор;

НастройкаФормы();

Если НастройкиСервер.ЭтоЛайв()
ИЛИ НастройкиСервер.ЭтоЧехов()	
Тогда
	Элементы.ФормаЧекСчет.Доступность = Ложь;
	
	//Элементы.ФормаПодменю.Доступность = Ложь;
	Элементы.ФормаВозвратОплаты.Доступность = Ложь;
	Элементы.ФормаДобавитьОплатаКассаОтменные.Доступность = Ложь;
	Элементы.ФормаДобавитьОплатаКассаОстаткиОплаты.Доступность = Ложь;

	Элементы.ФормаОтправитьВPayKeeper.Доступность = Ложь;
	Элементы.ФормаПроверитьОплатуPayKeepr.Доступность = Ложь;
КонецЕсли;

КонецПроцедуры

&НаСервере
Процедура НастройкаФормы()
ПочасоваяОплата = Объект.КоворкингЗаявка.ПочасоваяОплата;

//Элементы.ДатаПо.Видимость = НЕ ПочасоваяОплата; 
Элементы.ЧасС.Видимость = ПочасоваяОплата; 
Элементы.ЧасПо.Видимость = ПочасоваяОплата; 
//Элементы.ВключатьВыходные.Видимость = НЕ ПочасоваяОплата; 

Если ПочасоваяОплата Тогда
	КоворкингСервер.ЗаполнитьЧасыСписокВыбора(Элементы.ЧасС.СписокВыбора, Элементы.ЧасПо.СписокВыбора);
КонецЕсли;
КонецПроцедуры
//

//
&НаСервере
Процедура ПриЧтенииНаСервере(ТекущийОбъект)
ОбновитьДанные();
КонецПроцедуры

&НаСервере
Процедура ПослеЗаписиНаСервере(ТекущийОбъект, ПараметрыЗаписи)
ОбновитьДанные();
КонецПроцедуры


&НаСервере
Процедура ОбновитьДанные()
ОбновитьУслуги();
ОбновитьСтрокиДокументыОплаты();

УстановитьШапкаТолькоПросмотр();
КонецПроцедуры

&НаСервере
Процедура ОбновитьУслуги()

СуммаОплаченоИтогоДопУслуги = 0;
СуммаИтогоДопУслуги = 0;
Для Каждого Строка Из Объект.ДопУслугиКоворкинг Цикл
	СуммаИтогоДопУслуги = СуммаИтогоДопУслуги + Строка.Сумма;
	
	СуммаОплатыДолгиГУИД = 0;
	ОтборСтроки = Новый Структура("ГУИДДолги", Строка.ГУИД);
	НайденныеСтроки = Объект.РаспределениеОплатКоворкинг.НайтиСтроки(ОтборСтроки);
	Для Каждого НайденнаяСтрока Из НайденныеСтроки Цикл
		СуммаОплатыДолгиГУИД = СуммаОплатыДолгиГУИД + НайденнаяСтрока.СуммаОплаты;
	КонецЦикла;
	Строка.СуммаОплачено = СуммаОплатыДолгиГУИД;	
	
	СуммаОплаченоИтогоДопУслуги = СуммаОплаченоИтогоДопУслуги + Строка.СуммаОплачено;
КонецЦикла;
КонецПроцедуры

&НаСервере
Процедура ОбновитьСтрокиДокументыОплаты()
МассивДокументовДолг = Новый Массив;
СуммаРаспределеноИтогоОплаты = 0;

ОплатыОбщееСервер.ОбновитьДанныеКолонокДокументыОплаты(СуммаРаспределеноИтогоОплаты
	, Объект.ДокументыОплаты, Объект, МассивДокументовДолг);	
	
Для Каждого Строка Из Объект.ДокументыОплаты Цикл
	ДокументОплаты = Строка.ДокументОплаты;
	Строка.ДатаОплаты = ДокументОплаты.ДатаОплаты;
	
	Если ТипЗнч(ДокументОплаты) = Тип("ДокументСсылка.КассовыйДокумент") Тогда
		Строка.Аванс = ДокументОплаты.Аванс;	
	КонецЕсли;	
КонецЦикла;	
КонецПроцедуры

&НаСервере
Процедура УстановитьШапкаТолькоПросмотр()
ОтборСтроки = Новый Структура("ЭтоУслуга", Ложь);
НайденныеСтроки = Объект.РаспределениеОплатКоворкинг.НайтиСтроки(ОтборСтроки);
	
ТолькоПросмотр_П = (НайденныеСтроки.Количество() <> 0);	
Элементы.Цена.ТолькоПросмотр = ТолькоПросмотр_П; 	
КонецПроцедуры
