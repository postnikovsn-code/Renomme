&НаСервере
Процедура ДобавитьГрупповыеСчета(ТабДок)

ТекущаяОрганизация = НастройкиСервер.ПолучитьТекущуюОрганизацию();
СтавкаНДС = ТекущаяОрганизация.СтавкаНДС; СтавкаНДС = ДокументыСервер.СтавкаНДСТекущая(СтавкаНДС);
ВсеСНДС = ТекущаяОрганизация.ВсеСНДС;
СтавкаНДСЧисло = ДокументыСервер.СтавкаНДСЧисло(СтавкаНДС);

Запрос = Новый Запрос;
Запрос.Текст = ЗапросТекстГрупповыеСчета();

Запрос.УстановитьПараметр("ВсеСНДС", ВсеСНДС);	
Запрос.УстановитьПараметр("СтавкаНДС", СтавкаНДСЧисло);	

Запрос.УстановитьПараметр("ДатаС", ДатаС);
Запрос.УстановитьПараметр("ДатаПо", ДатаПо);

ТЗ = Запрос.Выполнить().Выгрузить();

Если ТЗ.Количество() = 0 Тогда Возврат; КонецЕсли;

Макет = Обработки.ОтчетДокументыДляСчетовФактур_РазныйНДС.ПолучитьМакет("МакетГрупповыеСчета");

Область = Макет.ПолучитьОбласть("Заголовок");
ТабДок.Вывести(Область);

Область = Макет.ПолучитьОбласть("Шапка");
ТабДок.Вывести(Область);

Для Каждого Строка Из ТЗ Цикл
	
	Ответ = ДокументыСервер.ПроверитьГрупповойСчет(Строка.ГрупповойСчет);
	Если Ответ.ТекстОшибки <> "" Тогда
		Текст = "Групповой счет " + Строка.ГрупповойСчет + ". " + Символы.ПС + Ответ.ТекстОшибки;
		Область = Макет.ПолучитьОбласть("СтрокаОшибки");
		Область.Параметры.Сообщение = Текст; 
		ТабДок.Вывести(Область);
		
		Продолжить;
	КонецЕсли;
	
	Текст = Ответ.ТекстПредупреждения;
	Если Текст <> "" Тогда
		Текст = "Групповой счет " + Строка.ГрупповойСчет + ". " + Символы.ПС + Текст 
			+ ". В расчет НЕ включены Заявки со статусом 'Бронь'";		
		Область = Макет.ПолучитьОбласть("СтрокаСообщения");
		Область.Параметры.Сообщение = Текст; 
		ТабДок.Вывести(Область);
	КонецЕсли;
	
	Область = Макет.ПолучитьОбласть("Строка"); 
	ОбластьПараметры = Область.Параметры;
	
	ОбластьПараметры.ГрупповойСчетРасшифровка = Строка.ГрупповойСчет;
	
	ОбластьПараметры.НомерСчета = Строка.НомерСчета;
	ОбластьПараметры.ДатаСчета = Формат(Строка.ДатаСчета, "ДФ=dd.MM.yy");
	//ОбластьПараметры.ГрупповойСчет = Строка.ГрупповойСчет;

	ОбластьПараметры.Контрагент = Строка.Контрагент;
	ОбластьПараметры.КонтрагентРасшифровка = Строка.Контрагент;
	
	ГрупповойСчетНомерДата = ПечатьСервер.ГрупповойСчетНомерДата(Строка.ГрупповойСчет);

	Если Строка.Контрагент.ТипКлиента = Перечисления.ТипыКлиентов.ФизЛицо Тогда
		ОбластьПараметры.ТипДокумента = "Гр. счет ФизЛицу";
		
		ОбластьПараметры.НомерСчетаФактуры = "";
		ОбластьПараметры.ДатаСчетаФактуры = "";
	ИначеЕсли НЕ Строка.Контрагент.Турагентство Тогда
		ОбластьПараметры.ТипДокумента = "Гр. счет ЮрЛицу";
		
		ОбластьПараметры.НомерСчетаФактуры = ГрупповойСчетНомерДата.Номер;
		ОбластьПараметры.ДатаСчетаФактуры = Формат(ГрупповойСчетНомерДата.Дата, "ДФ=dd.MM.yy");
	ИначеЕсли Строка.Контрагент.Турагентство Тогда
		ОбластьПараметры.ТипДокумента = "Гр. счет Турагентству";
		
		ОбластьПараметры.НомерСчетаФактуры = "";
		ОбластьПараметры.ДатаСчетаФактуры = "";
	КонецЕсли;

	ГрупповойСчетФактурыСтроки = ПечатьСервер.ГрупповойСчетФактурыСтроки(Строка.Групповойсчет);	
	Стоимость = ГрупповойСчетФактурыСтроки.Итог("СуммаСНДС");	
	СуммаНДС = ГрупповойСчетФактурыСтроки.Итог("СуммаНДС");	
	
	ОбластьПараметры.Стоимость = Стоимость; 
	ОбластьПараметры.СуммаНДС = СуммаНДС; 
	
	ТабДок.Вывести(Область);
КонецЦикла;
	
КонецПроцедуры

