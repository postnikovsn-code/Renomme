ДокументАкт = СтрЗаменить(Параметры.ДокументАкт, "/", "-");
ДокументСчетФактура = СтрЗаменить(Параметры.ДокументСчетФактура, "/", "-");

////
ЭтаФорма.АвтоЗаголовок = Ложь;
Заголовок = "Отправка Акта и счета-фактуры для ";	
ЭтаФорма.Заголовок = Заголовок + Контрагент;

Почта = Контрагент.ЭлПочта;

ПочтаТема = ПочтаТема();
ПочтаТекстСообщения = ПочтаТекстСообщения();
КонецПроцедуры

&НаСервере
Функция ПочтаТема()
ПочтаТема = ПечатьСервер.ОрганизацияНаименование() + ". Акт и Счет-фактура для " + Контрагент;

Возврат ПочтаТема;
КонецФункции

&НаСервере
Функция ПочтаТекстСообщения() 
ПочтаТекстСообщения = "Уважаемые коллеги!!!";
ПочтаТекстСообщения = "" + ПочтаТекстСообщения + Символы.ПС  + Символы.ПС;

ПочтаТекстСообщения = "" + ПочтаТекстСообщения
	+ "Во вложении к письму направляем Вам образы  закрывающих документов за проживание: Акт выполненных работ и счет-фактуру." 
	+ Символы.ПС;
 
ПочтаТекстСообщения = "" + ПочтаТекстСообщения  
	+ "Если по оформлению все подходит, готовы предоставить оригиналы по ЭДО или Почтой России, пожалуйста, сообщите удобный способ." 
	+ Символы.ПС
	+ Символы.ПС;
 
