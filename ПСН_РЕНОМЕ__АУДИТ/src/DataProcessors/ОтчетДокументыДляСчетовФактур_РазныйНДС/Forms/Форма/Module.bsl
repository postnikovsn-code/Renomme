&НаСервереБезКонтекста
Процедура СписокСчетаПриПолученииДанныхНаСервере(ИмяЭлемента, Настройки, Строки)
Для каждого Элемент Из Строки Цикл
	СтрокаСписка = Строки[Элемент.Ключ];

    Заявка = Элемент.Значение.Данные["Заявка"];
	НомерСчета = Элемент.Значение.Данные["НомерСчета"];
	ДатаПо = Элемент.Значение.Данные["ДатаПо"];
	ГрупповойСчет = Элемент.Значение.Данные["ГрупповойСчет"];

	ТипДокумента = Элемент.Значение.Данные["ТипДокумента"];
	Если ТипДокумента = "Счет Юрлицу" Тогда
		НомерДатаДокумента = ПечатьСервер.НомерДатаДокумента(Заявка, НомерСчета, ДатаПо);
		СтрокаСписка.Данные["НомерСчетаФактуры"] =  НомерДатаДокумента.Номер;
		СтрокаСписка.Данные["ДатаСчетаФактуры"] =  НомерДатаДокумента.Дата;
	ИначеЕсли ТипДокумента = "Входит в групповой счет Юрлицу" Тогда
		Если ЗначениеЗаполнено(ГрупповойСчет) Тогда
			ГрупповойСчетНомерДата = ПечатьСервер.ГрупповойСчетНомерДата(ГрупповойСчет);
			СтрокаСписка.Данные["НомерСчетаФактуры"] = ГрупповойСчетНомерДата.Номер;
			СтрокаСписка.Данные["ДатаСчетаФактуры"] = ГрупповойСчетНомерДата.Дата;
		КонецЕсли;
	КонецЕсли;
КонецЦикла; 
КонецПроцедуры

