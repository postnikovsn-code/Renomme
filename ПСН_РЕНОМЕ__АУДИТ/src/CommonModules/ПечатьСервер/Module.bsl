Процедура ПечатьГрупповогоСчетаФактуры(ТабДок, Номер, Дата, Групповойсчет) Экспорт
Макет = ПолучитьОбщийМакет("СчетФактураМакет");

ДатаУчетаНДС = ГрупповойСчетСервер.ДатаУчетаНДС(Групповойсчет);

ТекущаяОрганизация = НастройкиСервер.ПолучитьТекущуюОрганизацию();
СтавкаНДС = ТекущаяОрганизация.СтавкаНДС; СтавкаНДС = ДокументыСервер.СтавкаНДСТекущая(СтавкаНДС, ДатаУчетаНДС);
ВсеСНДС = ТекущаяОрганизация.ВсеСНДС;

Контрагент = Групповойсчет.Контрагент; 
СвернутьВСчете = Групповойсчет.СвернутьВСчете;

Область = Макет.ПолучитьОбласть("Заголовок");

Область.Параметры.Номер = Номер;
Область.Параметры.Дата = Формат(Дата, "ДФ=dd.MM.yyyy");

ДокументОтгрузки = "Акт № " + Номер + " от " + Формат(Дата, "ДФ=dd.MM.yyyy"); 
Область.Параметры.ДокументОтгрузки = ДокументОтгрузки;
	
Продавец = ТекущаяОрганизация.ОрганизацияДляДокументов;
АдресПродавца = ТекущаяОрганизация.ОрганизацияАдресДляДокументов;
ИННКПППродавца = ТекущаяОрганизация.ИНН + "/" + ТекущаяОрганизация.КПП;

Область.Параметры.Продавец = Продавец;
Область.Параметры.АдресПродавца = АдресПродавца;
Область.Параметры.ИННКПППродавца = ИННКПППродавца;

Область.Параметры.Покупатель = ?(ЗначениеЗаполнено(Контрагент.НаименованиеЮрЛица)
									, Контрагент.НаименованиеЮрЛица, Контрагент.Наименование);
Область.Параметры.АдресПокупателя = Контрагент.Адрес;
Область.Параметры.ИННКПППокупателя = Контрагент.ИНН + "/" + Контрагент.КПП;

ТабДок.Вывести(Область);

Область = Макет.ПолучитьОбласть("Шапка");
ТабДок.Вывести(Область);

//
ДокументыДолги = ГрупповойСчет.ДокументыДолги; 

сч=0;

ИтогоСумма = 0;
ИтогоСуммаБезНДС = 0;
ИтогоСуммаНДС = 0;

СтрокиСчетаФактуры = ГрупповойСчетФактурыСтроки(Групповойсчет);

Для каждого СчетФактураСтрока Из СтрокиСчетаФактуры Цикл
	Область = Макет.ПолучитьОбласть("Строка");
	
	Область.Параметры.НомерСтроки = СчетФактураСтрока.НомерСтроки;
	Область.Параметры.НаименованиеТовара = СчетФактураСтрока.НаименованиеТовара;
	Область.Параметры.КодЕдиницыИзмерения = СчетФактураСтрока.КодЕдиницыИзмерения;
	Область.Параметры.ЕдиницаИзмерения = СчетФактураСтрока.ЕдиницаИзмерения;
	Область.Параметры.Количество = СчетФактураСтрока.Количество;
	Область.Параметры.Цена = СчетФактураСтрока.Цена;
	Область.Параметры.СуммаБезНДС = СчетФактураСтрока.СуммаБезНДС;
	Область.Параметры.НалоговаяСтавка = СчетФактураСтрока.НалоговаяСтавка;
	Область.Параметры.СуммаНДС = СчетФактураСтрока.СуммаНДС;
	Область.Параметры.СуммаСНДС = СчетФактураСтрока.СуммаСНДС;

	ТабДок.Вывести(Область);

	ИтогоСумма = ИтогоСумма + СчетФактураСтрока.СуммаСНДС;
	ИтогоСуммаБезНДС = ИтогоСуммаБезНДС + СчетФактураСтрока.СуммаБезНДС;
	ИтогоСуммаНДС = ИтогоСуммаНДС + СчетФактураСтрока.СуммаНДС;
КонецЦикла;

//
Область = Макет.ПолучитьОбласть("Итоги");

Область.Параметры.СуммаБезНДС = ИтогоСуммаБезНДС;
Область.Параметры.СуммаНДС = ИтогоСуммаНДС;
Область.Параметры.СуммаСНДС = ИтогоСумма;

ТабДок.Вывести(Область);

Область = Макет.ПолучитьОбласть("Подвал");

Область.Параметры.Руководитель =  ТекущаяОрганизация.ОрганизацияФИОРуководительДляДокументов;
Область.Параметры.Бухгалтер =  ТекущаяОрганизация.ОрганизацияФИОБухгалтерДляСчетаФактуры;

ТабДок.Вывести(Область);
//

ТабДок.ОриентацияСтраницы = ОриентацияСтраницы.Ландшафт;
ТабДок.АвтоМасштаб = Истина;
КонецПроцедуры

Функция ГрупповойСчетФактурыСтроки(Групповойсчет) Экспорт   
ДатаУчетаНДС = ГрупповойСчетСервер.ДатаУчетаНДС(Групповойсчет);
	
ТекущаяОрганизация = НастройкиСервер.ПолучитьТекущуюОрганизацию();
СтавкаНДС = ТекущаяОрганизация.СтавкаНДС; СтавкаНДС = ДокументыСервер.СтавкаНДСТекущая(СтавкаНДС, ДатаУчетаНДС);
ВсеСНДС = ТекущаяОрганизация.ВсеСНДС;

СвернутьВСчете = Групповойсчет.СвернутьВСчете;


ДокументыДолги = ГрупповойСчет.ДокументыДолги; 

ТЗ = Новый ТаблицаЗначений;
ТЗ.Колонки.Добавить("НомерСтроки");
ТЗ.Колонки.Добавить("НаименованиеТовара");
ТЗ.Колонки.Добавить("КодЕдиницыИзмерения");
ТЗ.Колонки.Добавить("ЕдиницаИзмерения");
ТЗ.Колонки.Добавить("Количество");
ТЗ.Колонки.Добавить("Цена");
ТЗ.Колонки.Добавить("СуммаБезНДС");
ТЗ.Колонки.Добавить("НалоговаяСтавка");
ТЗ.Колонки.Добавить("СуммаНДС");
ТЗ.Колонки.Добавить("СуммаСНДС");
ТЗ.Колонки.Добавить("ЭтоУслуга");
ТЗ.Колонки.Добавить("Дата");

сч=0;

ИтогоСумма = ИтогоСумма = 0;
ИтогоСуммаБезНДС = 0;
ИтогоСуммаНДС = 0;

Для каждого СтрокаТаблицы Из ДокументыДолги Цикл
	Если СтрокаТаблицы.ДокументДолг.Статус = Перечисления.СтатусБрони.Бронь 
	Тогда Продолжить; КонецЕсли;	

	Если СтрокаТаблицы.ДокументДолг.Статус = Перечисления.СтатусБрони.ОтменаБронирования 
	Тогда Продолжить; КонецЕсли;		
	
	Если СтрокаТаблицы.ДокументДолг.Статус = Перечисления.СтатусБрони.ОтказОтБронирования 
	Тогда Продолжить; КонецЕсли;		
	
	ДокументДолг = СтрокаТаблицы.ДокументДолг;
	СчетГУИД = СтрокаТаблицы.СчетГУИД;
	
	ОтборСтроки = Новый Структура("СчетГУИД", СчетГУИД); 
	Счета_М = ДокументДолг.Счета.НайтиСтроки(ОтборСтроки); 
	Если Счета_М.Количество() = 0 Тогда Продолжить; КонецЕсли; 
	Счет = Счета_М[0]; 
	
	СчетаДетальноДолги_М = ДокументДолг.СчетаДетальноДолги.НайтиСтроки(ОтборСтроки); 
	
	ТоварКлиент = "" + ТоварКлиент(ДокументДолг, Счет) + ". ";
	
	ИтогиЗаявка = ИтогиЗаявка(СчетаДетальноДолги_М, СтавкаНДС, ВсеСНДС);
	
	СуммаПроживаниеЗаявка = ИтогиЗаявка.СуммаПроживание;
	КоличествоСутокЗаявка = ИтогиЗаявка.КоличествоПроживание;
	СуммаУслугиЗаявка = ИтогиЗаявка.СуммаУслуги;
	СуммаНДСЗаявка = ИтогиЗаявка.СуммаНДС;
	
	Если СуммаПроживаниеЗаявка <> 0 Тогда
		СтрокаСчетаФактуры = ТЗ.Добавить();
		
		сч = сч + 1;	
	    СтрокаСчетаФактуры.НомерСтроки = сч;
		
		ДатаПо_Проживание = ИтогиЗаявка.ДатаПо_Проживание + 24 * 60 * 60;
		НаименованиеТовара = ТоварКлиент + "Услуги гостиницы" 
			+ " с "+ Формат(ИтогиЗаявка.ДатаС_Проживание, "ДФ=dd.MM.yy")+ " по "+ Формат(ДатаПо_Проживание, "ДФ=dd.MM.yy");
		СтрокаСчетаФактуры.НаименованиеТовара = НаименованиеТовара;
		
		СтрокаСчетаФактуры.КодЕдиницыИзмерения = "359";
		СтрокаСчетаФактуры.ЕдиницаИзмерения = "сутки";
		
		Если КоличествоСутокЗаявка = 0 Тогда 
			Количество = 1;
		Иначе
		    Количество = КоличествоСутокЗаявка;
		Конецесли;
		СтрокаСчетаФактуры.Количество = Количество;
		
		СтрокаСчетаФактуры.Цена = Окр(СуммаПроживаниеЗаявка / Количество, 2);
		
		Если ВсеСНДС Тогда
			СтрокаСчетаФактуры.НалоговаяСтавка = СтавкаНДС;
			
			СуммаНДС = СуммаНДСЗаявка;
			СуммаБезНДС = ДокументыСервер.СуммаБезНДС(СтавкаНДС, СуммаПроживаниеЗаявка);
		Иначе
			Если СтавкаНДС = Перечисления.СтавкиНДС.БезНДС
			ИЛИ СтавкаНДС = Перечисления.СтавкиНДС.ПустаяСсылка()
			Тогда 
				СтавкаНДС_П = СтавкаНДС;
			Иначе	
				СтавкаНДС_П = Перечисления.СтавкиНДС.НДС0;
			КонецЕсли;
			
			СтрокаСчетаФактуры.НалоговаяСтавка = СтавкаНДС_П;
			
			СуммаНДС = 0;
			СуммаБезНДС = СуммаПроживаниеЗаявка;
		КонецЕсли;

		СтрокаСчетаФактуры.СуммаНДС = СуммаНДС;
		СтрокаСчетаФактуры.СуммаБезНДС = СуммаБезНДС;
		СтрокаСчетаФактуры.СуммаСНДС = СуммаПроживаниеЗаявка;
		
		СтрокаСчетаФактуры.ЭтоУслуга = Ложь;
		СтрокаСчетаФактуры.Дата = '00010101';
	КонецЕсли;
//
	Если СвернутьВСчете Тогда
		Если СуммаУслугиЗаявка <> 0 Тогда
			СтрокаСчетаФактуры = ТЗ.Добавить();
			
			сч = сч + 1;	
			СтрокаСчетаФактуры.НомерСтроки = сч;
			
			НаименованиеТовара = ТоварКлиент + ". Дополнительные услуги гостиницы" 
				+ " с "+ Формат(Счет.ДатаС, "ДФ=dd.MM.yy")+ " по "+ Формат(Счет.ДатаПо, "ДФ=dd.MM.yy");
			СтрокаСчетаФактуры.НаименованиеТовара = НаименованиеТовара;
			
			СтрокаСчетаФактуры.КодЕдиницыИзмерения = "796";
			СтрокаСчетаФактуры.ЕдиницаИзмерения = "шт";
			
			Количество = 1;

			СтрокаСчетаФактуры.Количество = Количество;
			
			СтрокаСчетаФактуры.Цена = СуммаУслугиЗаявка;
			
			СуммаБезНДС = ДокументыСервер.СуммаБезНДС(СтавкаНДС, СуммаУслугиЗаявка); 
			СтрокаСчетаФактуры.СуммаБезНДС = СуммаБезНДС;
			СтрокаСчетаФактуры.НалоговаяСтавка = СтавкаНДС;
			
			СуммаНДС = ДокументыСервер.СуммаНДС(СтавкаНДС, СуммаУслугиЗаявка);
			СтрокаСчетаФактуры.СуммаНДС = СуммаНДС;

			СтрокаСчетаФактуры.СуммаСНДС = СуммаУслугиЗаявка;
			
			СтрокаСчетаФактуры.ЭтоУслуга = Истина;
			СтрокаСчетаФактуры.Дата = '00010101';
		КонецЕсли;
	Иначе
		Для Каждого Строка Из СчетаДетальноДолги_М Цикл
			Если НЕ Строка.Услуга Тогда Продолжить; КонецЕсли;
			Если Строка.ПрограммныйКодУслуги = Перечисления.ПрограммныйКодУслуги.ПРОЖИВАНИЕ_УСЛУГИ
			Тогда Продолжить; КонецЕсли;
			
			СтрокаСчетаФактуры = ТЗ.Добавить();
			
			сч = сч + 1;	
		    СтрокаСчетаФактуры.НомерСтроки = сч;
			
			СтрокаСчетаФактуры.НаименованиеТовара = "" + ТоварКлиент 
				+ " " + ?(ЗначениеЗаполнено(Строка.НазваниеДляЧека), Строка.НазваниеДляЧека, Строка.НаименованиеДолг)
				+ ". " + Формат(Строка.ДатаДолг, "ДФ=dd.MM.yy"); 
			
			СтрокаСчетаФактуры.КодЕдиницыИзмерения = "796";
			СтрокаСчетаФактуры.ЕдиницаИзмерения = "шт";
			
			СтрокаСчетаФактуры.Количество = Строка.Количество;
			СтрокаСчетаФактуры.Цена = Строка.Цена;
			
			СтрокаСчетаФактуры.НалоговаяСтавка = СтавкаНДС;
			
			СуммаБезНДС = ДокументыСервер.СуммаБезНДС(СтавкаНДС, Строка.СуммаДолг);
			СтрокаСчетаФактуры.СуммаБезНДС = СуммаБезНДС;
			
			СуммаНДС = ДокументыСервер.СуммаНДС(СтавкаНДС, Строка.СуммаДолг);;
			СтрокаСчетаФактуры.СуммаНДС = СуммаНДС;

			СтрокаСчетаФактуры.СуммаСНДС = Строка.СуммаДолг;
			
			СтрокаСчетаФактуры.ЭтоУслуга = Истина;
			СтрокаСчетаФактуры.Дата = '00010101';
		КонецЦикла;	
	КонецЕсли;
КонецЦикла; 

Возврат ТЗ;
КонецФункции
