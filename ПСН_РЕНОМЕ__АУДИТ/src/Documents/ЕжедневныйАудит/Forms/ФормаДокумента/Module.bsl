Функция СуммаЗаПроживаниеОтклонение(СтрокаДанные, СтрокаПроживание, ДанныеЗаявка, Двухместный) 
СуммаЗаПроживаниеОтклонение = 0;

//ЦенаНаДеньБезЗавтрака = ДокументыСервер.ЦенаНаДень(СтрокаПроживание.ДеньПроживания, ДанныеЗаявка.КатегорияНомера, Истина, Двухместный); 
//ЦенаНаДеньБезЗавтрака = ДокументыСервер.СуммаСоСкидкойСкидка(ЦенаНаДеньБезЗавтрака, СтрокаПроживание.ПроцентСкидкиКлиента); 
//ЦенаНаДеньСЗавтраком = ДокументыСервер.ЦенаНаДень(СтрокаПроживание.ДеньПроживания, ДанныеЗаявка.КатегорияНомера, Ложь, Двухместный); 
//СтоимостьЗавтрака = ЦенаНаДеньСЗавтраком - ЦенаНаДеньБезЗавтрака; 

ЦенаНаДень = Окр(СтрокаПроживание.Сумма / СтрокаПроживание.Количество, 2);
ЦенаЗаЧас = Окр(ЦенаНаДень / 24, 2);

Заезд = СтрокаДанные.Заезд;
Если НачалоДня(Заезд) = Объект.ДатаОтбора Тогда
	Если ДанныеЗаявка.РезервС = Объект.ДатаОтбора Тогда  	
		Если Час(Заезд) < 6 Тогда	
			Если ДанныеЗаявка.ВремяЗаезда = Перечисления.ВремяЗаезда.Вр6 
			ИЛИ СтрокаПроживание.Количество = 1.5 
			Тогда
				СуммаЗаПроживаниеОтклонение = ЦенаНаДень * 0.5;
				//СуммаЗаПроживаниеОтклонение = ЦенаНаДеньБезЗавтрака * 0.5;
			ИначеЕсли ДанныеЗаявка.ВремяЗаезда = Перечисления.ВремяЗаезда.Вр14 
			ИЛИ СтрокаПроживание.Количество = 1 
			Тогда
				СуммаЗаПроживаниеОтклонение = ЦенаНаДень;
				//СуммаЗаПроживаниеОтклонение = ЦенаНаДеньБезЗавтрака;
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
КонецЕсли;

Выезд = СтрокаДанные.Выезд;
Если НачалоДня(Выезд) = Объект.ДатаОтбора Тогда
	Если ДанныеЗаявка.РезервПо = Объект.ДатаОтбора Тогда 	
		
		ЧасВыезд = Час(Выезд);
		Если ЧасВыезд > 14 И ЧасВыезд < 18 Тогда
			Если ДанныеЗаявка.ВремяВыезда = Перечисления.ВремяВыезда.Вр12 
			ИЛИ СтрокаПроживание.Количество = 1
			Тогда
				СуммаЗаПроживаниеОтклонение = ЦенаНаДень * 0.5;
			КонецЕсли;
		ИначеЕсли ЧасВыезд >= 18 И ЧасВыезд < 23 Тогда	
			Если ДанныеЗаявка.ВремяВыезда = Перечисления.ВремяВыезда.Вр12
			ИЛИ СтрокаПроживание.Количество = 1
			Тогда
				СуммаЗаПроживаниеОтклонение = ЦенаНаДень * 0.5;
			КонецЕсли;
		ИначеЕсли ЧасВыезд = 23 Тогда
			Если ДанныеЗаявка.ВремяВыезда = Перечисления.ВремяВыезда.Вр12
			ИЛИ СтрокаПроживание.Количество = 2
			Тогда
				СуммаЗаПроживаниеОтклонение = ЦенаНаДень;
			ИначеЕсли ДанныеЗаявка.ВремяВыезда = Перечисления.ВремяВыезда.Вр18
			ИЛИ СтрокаПроживание.Количество = 1.5
			Тогда
				СуммаЗаПроживаниеОтклонение = ЦенаНаДень * 0.5;
			КонецЕсли;
		КонецЕсли;
		
	КонецЕсли;
КонецЕсли;

Возврат СуммаЗаПроживаниеОтклонение;	
КонецФункции

&НаСервере
Функция ПроживаниеОтклонение(СтрокаДанные, СтрокаПроживание, ДанныеЗаявка, Двухместный)
Результат = Новый Структура("СуммаЗаПроживаниеОтклонение, ЦенаНаДень, КоличествоОтклонениеЧасы, СуммаЗаПроживаниеОтклонениеЧасы, ЦенаЗаЧас");	

СуммаЗаПроживаниеОтклонение = 0;
КоличествоОтклонениеЧасы = 0;
СуммаЗаПроживаниеОтклонениеЧасы = 0;

//ЦенаНаДеньБезЗавтрака = ДокументыСервер.ЦенаНаДень(СтрокаПроживание.ДеньПроживания, ДанныеЗаявка.КатегорияНомера, Истина, Двухместный); 
//ЦенаНаДеньБезЗавтрака = ДокументыСервер.СуммаСоСкидкойСкидка(ЦенаНаДеньБезЗавтрака, СтрокаПроживание.ПроцентСкидкиКлиента); 
//ЦенаНаДеньСЗавтраком = ДокументыСервер.ЦенаНаДень(СтрокаПроживание.ДеньПроживания, ДанныеЗаявка.КатегорияНомера, Ложь, Двухместный); 
//СтоимостьЗавтрака = ЦенаНаДеньСЗавтраком - ЦенаНаДеньБезЗавтрака; 

Если СтрокаПроживание = Неопределено Тогда
	БезЗавтрака = ДанныеЗаявка.БезЗавтрака;
	ЦенаНаДень = ДокументыСервер.ЦенаНаДень(Объект.ДатаОтбора, ДанныеЗаявка.КатегорияНомера, БезЗавтрака, Двухместный); 
Иначе
	ЦенаНаДень = Окр(СтрокаПроживание.Сумма / СтрокаПроживание.Количество, 2);
КонецЕсли;

ЦенаЗаЧас = Окр(ЦенаНаДень / 24, 2);
СтрокаПроживаниеКоличество = ?(СтрокаПроживание = Неопределено, 1, СтрокаПроживание.Количество);

Заезд = СтрокаДанные.Заезд;
ЗаездНачалоДня = НачалоДня(Заезд);
Если ЗаездНачалоДня = Объект.ДатаОтбора Тогда
	ЧасЗаезд = Час(Заезд);
	
	Если ДанныеЗаявка.РезервС = ЗаездНачалоДня Тогда  	
		Если ЧасЗаезд < 6 Тогда	
			Если ДанныеЗаявка.ВремяЗаезда = Перечисления.ВремяЗаезда.Вр6 
			ИЛИ СтрокаПроживаниеКоличество = 1.5 
			Тогда
				СуммаЗаПроживаниеОтклонение = ЦенаНаДень * 0.5;
				//СуммаЗаПроживаниеОтклонение = ЦенаНаДеньБезЗавтрака * 0.5;
				
				КоличествоОтклонениеЧасы = 6 - ЧасЗаезд;
				СуммаЗаПроживаниеОтклонениеЧасы = ЦенаЗаЧас * КоличествоОтклонениеЧасы; 
				
			ИначеЕсли ДанныеЗаявка.ВремяЗаезда = Перечисления.ВремяЗаезда.Вр14 
			ИЛИ СтрокаПроживаниеКоличество = 1 
			Тогда
				СуммаЗаПроживаниеОтклонение = ЦенаНаДень;
				//СуммаЗаПроживаниеОтклонение = ЦенаНаДеньБезЗавтрака;
				
				КоличествоОтклонениеЧасы = 14 - ЧасЗаезд;
				СуммаЗаПроживаниеОтклонениеЧасы = ЦенаЗаЧас * КоличествоОтклонениеЧасы; 
				
			КонецЕсли;
		КонецЕсли;
		
	//ИначеЕсли ДанныеЗаявка.РезервС > ЗаездНачалоДня Тогда  	
	//	КоличествоДнейОтклонение = (ДанныеЗаявка.РезервС - ЗаездНачалоДня) / 24*60*60 ;
	//	СуммаЗаПроживаниеОтклонение = ЦенаНаДень * КоличествоДнейОтклонение;
	//	
	//	Если ЧасЗаезд < 6 Тогда	
	//		КоличествоОтклонениеЧасы = 6 - ЧасЗаезд;
	//		СуммаЗаПроживаниеОтклонениеЧасы = ЦенаЗаЧас * (КоличествоДнейОтклонение*24 + КоличествоОтклонениеЧасы); 			
	//	КонецЕсли;
		
	КонецЕсли;
КонецЕсли;

Выезд = СтрокаДанные.Выезд;
ВыездНачалоДня = НачалоДня(Выезд);
Если ВыездНачалоДня = Объект.ДатаОтбора Тогда
	
	ЧасВыезд = Час(Выезд);
	Если ДанныеЗаявка.РезервПо = ВыездНачалоДня Тогда 	
		
		Если ЧасВыезд > 13 И ЧасВыезд < 18 Тогда
			Если ДанныеЗаявка.ВремяВыезда = Перечисления.ВремяВыезда.Вр12 
			ИЛИ СтрокаПроживаниеКоличество = 1
			Тогда
				СуммаЗаПроживаниеОтклонение = ЦенаНаДень * 0.5;
				
				КоличествоОтклонениеЧасы = ЧасВыезд - 13;
				СуммаЗаПроживаниеОтклонениеЧасы = ЦенаЗаЧас * КоличествоОтклонениеЧасы; 
			КонецЕсли;
			
		ИначеЕсли ЧасВыезд > 17 И ЧасВыезд < 23 Тогда	
			Если ДанныеЗаявка.ВремяВыезда = Перечисления.ВремяВыезда.Вр12
			ИЛИ СтрокаПроживаниеКоличество = 1
			Тогда
				СуммаЗаПроживаниеОтклонение = ЦенаНаДень * 0.5;
				
				КоличествоОтклонениеЧасы = ЧасВыезд - 17;
				СуммаЗаПроживаниеОтклонениеЧасы = ЦенаЗаЧас * КоличествоОтклонениеЧасы; 
			КонецЕсли;
			
		ИначеЕсли ЧасВыезд = 23 Тогда
			Если ДанныеЗаявка.ВремяВыезда = Перечисления.ВремяВыезда.Вр12
			ИЛИ СтрокаПроживаниеКоличество = 2
			Тогда
				СуммаЗаПроживаниеОтклонение = ЦенаНаДень;
				
				КоличествоОтклонениеЧасы = ЧасВыезд - 13;
				СуммаЗаПроживаниеОтклонениеЧасы = ЦенаЗаЧас * КоличествоОтклонениеЧасы; 
				
			ИначеЕсли ДанныеЗаявка.ВремяВыезда = Перечисления.ВремяВыезда.Вр18
			ИЛИ СтрокаПроживаниеКоличество = 1.5
			Тогда
				СуммаЗаПроживаниеОтклонение = ЦенаНаДень * 0.5;
				
				КоличествоОтклонениеЧасы = ЧасВыезд - 17;
				СуммаЗаПроживаниеОтклонениеЧасы = ЦенаЗаЧас * КоличествоОтклонениеЧасы; 
			КонецЕсли;
			
		КонецЕсли;
		
	//ИначеЕсли ДанныеЗаявка.РезервПо < ВыездНачалоДня Тогда 	
	//	КоличествоДнейОтклонение = (ВыездНачалоДня - ДанныеЗаявка.РезервПо) / 24*60*60;  		
	//	СуммаЗаПроживаниеОтклонение = ЦенаНаДень * КоличествоДнейОтклонение;
	//	
	//	Если ЧасВыезд > 13 И ЧасВыезд < 18 Тогда
	//		СуммаЗаПроживаниеОтклонение = СуммаЗаПроживаниеОтклонение + ЦенаНаДень * 0.5;
	//	ИначеЕсли ЧасВыезд >= 18 Тогда	
	//		СуммаЗаПроживаниеОтклонение = СуммаЗаПроживаниеОтклонение + ЦенаНаДень;
	//	КонецЕсли;
	//	
	//	КоличествоОтклонениеЧасы = ЧасВыезд - 13;
	//	СуммаЗаПроживаниеОтклонениеЧасы = ЦенаЗаЧас * (КоличествоДнейОтклонение*24 + КоличествоОтклонениеЧасы); 
		
	КонецЕсли;
КонецЕсли;

Результат.СуммаЗаПроживаниеОтклонение = СуммаЗаПроживаниеОтклонение;
Результат.КоличествоОтклонениеЧасы = КоличествоОтклонениеЧасы;
Результат.СуммаЗаПроживаниеОтклонениеЧасы = СуммаЗаПроживаниеОтклонениеЧасы;
Результат.ЦенаНаДень = ЦенаНаДень;
Результат.ЦенаЗаЧас = ЦенаЗаЧас;

Возврат Результат;	
КонецФункции
