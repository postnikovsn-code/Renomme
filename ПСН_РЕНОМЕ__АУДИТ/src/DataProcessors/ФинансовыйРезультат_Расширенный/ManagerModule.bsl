Функция ПлатежиКонтрагентуРаспределение(ДатаОтчетаС, ДатаОтчетаПо) Экспорт

Запрос = Новый Запрос("ВЫБРАТЬ
                      |	ГрупповыеСчетаКомиссияДокументыДолги.Ссылка КАК ГрупповойСчет,
                      |	ГрупповыеСчетаКомиссияДокументыДолги.ДокументДолг КАК ДокументДолг,
                      |	ГрупповыеСчетаКомиссияДокументыДолги.СуммаКомиссииКонтрагент КАК СуммаКомиссииКонтрагент
                      |ИЗ
                      |	Документ.ГрупповыеСчета.КомиссияДокументыДолги КАК ГрупповыеСчетаКомиссияДокументыДолги
                      |		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.Клиенты КАК Клиенты
                      |		ПО ГрупповыеСчетаКомиссияДокументыДолги.Ссылка.Контрагент = Клиенты.Ссылка
                      |ГДЕ
                      |	ГрупповыеСчетаКомиссияДокументыДолги.ДокументДолг В
                      |			(ВЫБРАТЬ
                      |				ЗаявкаНаБронирование.Ссылка КАК Ссылка
                      |			ИЗ
                      |				Документ.ЗаявкаНаБронирование КАК ЗаявкаНаБронирование
                      |			ГДЕ
                      |				(ЗаявкаНаБронирование.ПометкаУдаления = ЛОЖЬ
                      |						И НЕ(ЗаявкаНаБронирование.РезервС < &ДатаС
                      |								И ЗаявкаНаБронирование.РезервПо < &ДатаС)
                      |					ИЛИ ЗаявкаНаБронирование.РезервС > &ДатаПо))
                      |
                      |УПОРЯДОЧИТЬ ПО
                      |	ГрупповойСчет,
                      |	ДокументДолг");

Запрос.УстановитьПараметр("ДатаС", ДатаОтчетаС);
Запрос.УстановитьПараметр("ДатаПо", ДатаОтчетаПо);

ТЗ = Запрос.Выполнить().Выгрузить();

ТЗ_Комиссия = Новый ТаблицаЗначений;
ТЗ_Комиссия.Колонки.Добавить("ГрупповойСчет");
ТЗ_Комиссия.Колонки.Добавить("Заявка");
ТЗ_Комиссия.Колонки.Добавить("СуммаРаспределено");
ТЗ_Комиссия.Колонки.Добавить("ДокументПлатежа");

//ТЗ_Комиссия.Колонки.Добавить("ПроцентКомиссии");

ТЗ_ДокументыПлатежа = Новый ТаблицаЗначений;
ТЗ_ДокументыПлатежа.Колонки.Добавить("ДокументПлатежа");

СуммаОплаты = 0;
ОстатокОплаты = 0;
ГрупповойСчет_П = Неопределено;

Для Каждого Строка Из ТЗ Цикл
	Если Строка.ГрупповойСчет <> ГрупповойСчет_П Тогда  
		ГрупповойСчет_П = Строка.ГрупповойСчет;
		
		ТЗ_ДокументыПлатежа.Очистить();
		Для Каждого СтрокаОплаты Из ГрупповойСчет_П.ДокументыОплаты Цикл
			Если ТипЗнч(СтрокаОплаты.ДокументОплаты) = Тип("ДокументСсылка.ПрочиеОплаты") Тогда 
				НоваяСтрокаДокументыПлатежа = ТЗ_ДокументыПлатежа.Добавить();
				НоваяСтрокаДокументыПлатежа.ДокументПлатежа = СтрокаОплаты.ДокументОплаты;
			КонецЕсли;
		КонецЦикла;
		
		Для Каждого СтрокаОплаты Из ГрупповойСчет_П.ДокументыПлатежиКонтрагенту Цикл
			НоваяСтрокаДокументыПлатежа = ТЗ_ДокументыПлатежа.Добавить();
			НоваяСтрокаДокументыПлатежа.ДокументПлатежа = СтрокаОплаты.ДокументПлатежа;
		КонецЦикла;
	КонецЕсли;
	
	Если Строка.СуммаКомиссииКонтрагент = 0 Тогда
		СуммаИтогоПроживание = Строка.ДокументДолг.Проживание.Итог("СуммаБезСкидки");
		
		ПроцентКомиссии = ДокументыСервер.ПроцентКомиссииКлиента(Строка.ДокументДолг.Бронирует, Строка.ДокументДолг.РезервС); //, Строка.ДокументДолг.В2В);
		
		СуммаКомиссии = ДокументыСервер.СуммаКомиссии(Строка.ДокументДолг, СуммаИтогоПроживание
			, Строка.ДокументДолг.Счета, Строка.ДокументДолг.СчетаДетальноДолги, Строка.ДокументДолг.ДопУслуги, ПроцентКомиссии);
		
	Иначе
		СуммаКомиссии = Строка.СуммаКомиссииКонтрагент;
	КонецЕсли;		
	
	Для Каждого СтрокаДокументПлатежа Из ТЗ_ДокументыПлатежа Цикл
		ОстатокОплаты = СтрокаДокументПлатежа.ДокументПлатежа.Сумма;
		
		НоваяСтрока = ТЗ_Комиссия.Добавить();
		
		НоваяСтрока.ГрупповойСчет = Строка.ГрупповойСчет;
		НоваяСтрока.Заявка = Строка.ДокументДолг;
		НоваяСтрока.ДокументПлатежа = СтрокаДокументПлатежа.ДокументПлатежа;
		
		Если ОстатокОплаты >= СуммаКомиссии Тогда  
			НоваяСтрока.СуммаРаспределено = СуммаКомиссии;
			
			ОстатокОплаты = ОстатокОплаты - СуммаКомиссии;
			СуммаКомиссии = 0;
			
			Прервать;
		Иначе
			НоваяСтрока.СуммаРаспределено = ОстатокОплаты;
			СуммаКомиссии = СуммаКомиссии - ОстатокОплаты;
			
			ОстатокОплаты = 0;
		КонецЕсли;
	КонецЦикла;
КонецЦикла;

ТЗ_КомиссияРаспределение = Новый ТаблицаЗначений;
ТЗ_КомиссияРаспределение.Колонки.Добавить("ГрупповойСчет");
ТЗ_КомиссияРаспределение.Колонки.Добавить("Заявка");
ТЗ_КомиссияРаспределение.Колонки.Добавить("Дата");
ТЗ_КомиссияРаспределение.Колонки.Добавить("СуммаКомиссииКЗачету");
ТЗ_КомиссияРаспределение.Колонки.Добавить("СуммаРаспределено");
ТЗ_КомиссияРаспределение.Колонки.Добавить("ДокументПлатежа");

Для Каждого СтрокаКомиссия Из ТЗ_Комиссия Цикл
	
	ОстатокСуммаКомиссии = СтрокаКомиссия.СуммаРаспределено;
	
	Если СтрокаКомиссия.Заявка.Проживание.Количество() = 0 Тогда
		Для Каждого СтрокаУслуги Из СтрокаКомиссия.Заявка.ДопУслуги Цикл
			Если НЕ СтрокаУслуги.ВСчет Тогда Продолжить; КонецЕсли;      
			
			ОтборСтроки = Новый Структура("ДолгиГУИД", СтрокаУслуги.ГУИД);
			ЗаявкаСчетаДетальноДолги = СтрокаКомиссия.Заявка.СчетаДетальноДолги.Выгрузить(ОтборСтроки);
			ЗаявкаДопУслуги = СтрокаКомиссия.Заявка.ДопУслуги.Выгрузить(ОтборСтроки);
			
			//ПроцентКомиссии = СтрокаКомиссия.Заявка.Бронирует.ПроцентКомиссии;
			ПроцентКомиссии = ДокументыСервер.ПроцентКомиссииКлиента(СтрокаКомиссия.Заявка.Бронирует, СтрокаКомиссия.РезервС); //, СтрокаКомиссия.Заявка.В2В);
			
			СуммаКомиссии = ДокументыСервер.СуммаКомиссии(СтрокаКомиссия.Заявка, 0
				, СтрокаКомиссия.Заявка.Счета, ЗаявкаСчетаДетальноДолги, ЗаявкаДопУслуги, ПроцентКомиссии);
			
			Если СуммаКомиссии = 0 Тогда Продолжить; КонецЕсли;
					
			НоваяСтрока = ТЗ_КомиссияРаспределение.Добавить();
			
			НоваяСтрока.ГрупповойСчет = СтрокаКомиссия.ГрупповойСчет;
			НоваяСтрока.Заявка = СтрокаКомиссия.Заявка;
			НоваяСтрока.ДокументПлатежа = СтрокаКомиссия.ДокументПлатежа;
			
			НоваяСтрока.Дата = СтрокаУслуги.ДатаУслуги;
			
			СуммаРаспределено = СуммаКомиссии;
			
			Если ОстатокСуммаКомиссии >= СуммаРаспределено Тогда  
				НоваяСтрока.СуммаРаспределено = СуммаРаспределено;
				НоваяСтрока.СуммаКомиссииКЗачету = СуммаРаспределено;
				
				ОстатокСуммаКомиссии = ОстатокСуммаКомиссии - НоваяСтрока.СуммаРаспределено;
			Иначе
				НоваяСтрока.СуммаРаспределено = ОстатокСуммаКомиссии;
				НоваяСтрока.СуммаКомиссииКЗачету = ОстатокСуммаКомиссии;
				
				ОстатокСуммаКомиссии = 0;
				
				Прервать;
			КонецЕсли;
		КонецЦикла;
		
	Иначе		
		
		Для Каждого СтрокаПроживание Из СтрокаКомиссия.Заявка.Проживание Цикл
			НоваяСтрока = ТЗ_КомиссияРаспределение.Добавить();
			
			НоваяСтрока.ГрупповойСчет = СтрокаКомиссия.ГрупповойСчет;
			НоваяСтрока.Заявка = СтрокаКомиссия.Заявка;

			НоваяСтрока.ДокументПлатежа = СтрокаКомиссия.ДокументПлатежа;
			
			НоваяСтрока.Дата = СтрокаПроживание.ДеньПроживания;
			
			ОтборСтроки = Новый Структура("ДатаДолг", СтрокаПроживание.ДеньПроживания);
			ЗаявкаСчетаДетальноДолги = СтрокаКомиссия.Заявка.СчетаДетальноДолги.Выгрузить(ОтборСтроки);
		
			ОтборСтроки = Новый Структура("ДатаУслуги", СтрокаПроживание.ДеньПроживания);
			ЗаявкаДопУслуги = СтрокаКомиссия.Заявка.ДопУслуги.Выгрузить(ОтборСтроки);
		
			//ПроцентКомиссии = СтрокаКомиссия.Заявка.Бронирует.ПроцентКомиссии;
			ПроцентКомиссии = ДокументыСервер.ПроцентКомиссииКлиента(СтрокаКомиссия.Заявка.Бронирует, СтрокаКомиссия.Заявка.РезервС); //, СтрокаКомиссия.Заявка.В2В);
			
			СуммаКомиссии = ДокументыСервер.СуммаКомиссии(СтрокаКомиссия.Заявка, СтрокаПроживание.СуммаБезСкидки
				, СтрокаКомиссия.Заявка.Счета, ЗаявкаСчетаДетальноДолги, ЗаявкаДопУслуги, ПроцентКомиссии);
			
			СуммаРаспределено = СуммаКомиссии;
			
			Если ОстатокСуммаКомиссии >= СуммаРаспределено Тогда  
				НоваяСтрока.СуммаРаспределено = СуммаРаспределено;
				НоваяСтрока.СуммаКомиссииКЗачету = СуммаРаспределено;
				
				ОстатокСуммаКомиссии = ОстатокСуммаКомиссии - НоваяСтрока.СуммаРаспределено;
			Иначе
				НоваяСтрока.СуммаРаспределено = ОстатокСуммаКомиссии;
				НоваяСтрока.СуммаКомиссииКЗачету = ОстатокСуммаКомиссии;
				
				ОстатокСуммаКомиссии = 0;
				
				Прервать;
			КонецЕсли;
		КонецЦикла;	
	КонецЕсли;
КонецЦикла;

Возврат ТЗ_КомиссияРаспределение;	
КонецФункции
