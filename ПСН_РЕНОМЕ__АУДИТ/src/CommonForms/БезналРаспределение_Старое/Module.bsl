КонецПроцедуры


//
&НаКлиенте
Процедура ЭквайрингСчетаЗагрузить(Команда)
ЭквайрингСчетаЗагрузитьНаСервере();
КонецПроцедуры

&НаСервере
Процедура ЭквайрингСчетаЗагрузитьНаСервере()
ЭквайрингВыпискаСчета.Очистить();

Запрос = Новый Запрос("ВЫБРАТЬ
                      |	0 КАК ТипДокумента,
                      |	""ЗБ"" КАК ТипДокументаПредставление,
                      |	ЗаявкаНаБронированиеСчета.Ссылка КАК ДокументДолг,
                      |	ЗаявкаНаБронированиеСчета.СчетГУИД КАК СчетГУИД,
                      |	ЗаявкаНаБронированиеСчета.Контрагент КАК Контрагент,
                      |	ВЫБОР
                      |		КОГДА ЗаявкаНаБронированиеСчета.Контрагент.ТипКлиента = ЗНАЧЕНИЕ(Перечисление.ТипыКлиентов.ЮрЛицо)
                      |			ТОГДА ЗаявкаНаБронированиеСчета.Контрагент.НаименованиеЮрЛица
                      |		ИНАЧЕ ЗаявкаНаБронированиеСчета.Контрагент.Наименование
                      |	КОНЕЦ КАК КонтрагентНаименование,
                      |	ЗаявкаНаБронированиеСчета.НомерСчета КАК НомерСчета,
                      |	ЗаявкаНаБронированиеСчета.ДатаСчета КАК ДатаСчета,
                      |	ЕСТЬNULL(Долги.СуммаКЗакрытию, 0) КАК ОстатокКЗакрытию,
                      |	ЕСТЬNULL(Долги.СуммаДолг, 0) КАК СуммаДолг,
                      |	ЕСТЬNULL(ДолгиПроживание.СуммаДолгПроживание, 0) КАК СуммаДолгПроживание,
                      |	ЕСТЬNULL(Долги.СуммаДолг, 0) - ЕСТЬNULL(ДолгиПроживание.СуммаДолгПроживание, 0) КАК СуммаДолгУслуги
                      |ИЗ
                      |	Документ.ЗаявкаНаБронирование.Счета КАК ЗаявкаНаБронированиеСчета
                      |		ЛЕВОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
                      |			ЗаявкаНаБронированиеСчетаДетальноДолги.Ссылка КАК Ссылка,
                      |			ЗаявкаНаБронированиеСчетаДетальноДолги.СчетГУИД КАК СчетГУИД,
                      |			СУММА(ЗаявкаНаБронированиеСчетаДетальноДолги.СуммаКЗакрытию) КАК СуммаКЗакрытию,
                      |			СУММА(ЗаявкаНаБронированиеСчетаДетальноДолги.СуммаДолг) КАК СуммаДолг
                      |		ИЗ
                      |			Документ.ЗаявкаНаБронирование.СчетаДетальноДолги КАК ЗаявкаНаБронированиеСчетаДетальноДолги
                      |		
                      |		СГРУППИРОВАТЬ ПО
                      |			ЗаявкаНаБронированиеСчетаДетальноДолги.СчетГУИД,
                      |			ЗаявкаНаБронированиеСчетаДетальноДолги.Ссылка) КАК Долги
                      |		ПО ЗаявкаНаБронированиеСчета.Ссылка = Долги.Ссылка
                      |			И ЗаявкаНаБронированиеСчета.СчетГУИД = Долги.СчетГУИД
                      |		ЛЕВОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
                      |			ЗаявкаСчетаДетальноДолгиПроживание.Ссылка КАК Ссылка,
                      |			ЗаявкаСчетаДетальноДолгиПроживание.СчетГУИД КАК СчетГУИД,
                      |			СУММА(ЗаявкаСчетаДетальноДолгиПроживание.СуммаДолг) КАК СуммаДолгПроживание
                      |		ИЗ
                      |			Документ.ЗаявкаНаБронирование.СчетаДетальноДолги КАК ЗаявкаСчетаДетальноДолгиПроживание
                      |		
                      |		СГРУППИРОВАТЬ ПО
                      |			ЗаявкаСчетаДетальноДолгиПроживание.СчетГУИД,
                      |			ЗаявкаСчетаДетальноДолгиПроживание.Ссылка) КАК ДолгиПроживание
                      |		ПО ЗаявкаНаБронированиеСчета.Ссылка = ДолгиПроживание.Ссылка
                      |			И ЗаявкаНаБронированиеСчета.СчетГУИД = ДолгиПроживание.СчетГУИД
                      |ГДЕ
                      |	ЗаявкаНаБронированиеСчета.Ссылка.ПометкаУдаления = ЛОЖЬ
                      |	И ЗаявкаНаБронированиеСчета.Ссылка.Проведен = ИСТИНА
                      |	И ЗаявкаНаБронированиеСчета.ГрупповойСчет = ЗНАЧЕНИЕ(Документ.ГрупповыеСчета.ПустаяСсылка)
                      |	И ЗаявкаНаБронированиеСчета.ЭтоПредварительныйГрупповойСчет = ЛОЖЬ
                      |	И ВЫБОР
                      |			КОГДА &Все
                      |				ТОГДА ИСТИНА
                      |			ИНАЧЕ ЕСТЬNULL(Долги.СуммаКЗакрытию, 0) > 0
                      |		КОНЕЦ
                      |	И ВЫБОР
                      |			КОГДА &ДатаСчетаС = ДАТАВРЕМЯ(1, 1, 1, 0, 0, 0)
                      |				ТОГДА ИСТИНА
                      |			ИНАЧЕ ЗаявкаНаБронированиеСчета.Ссылка.РезервС >= &ДатаСчетаС
                      |		КОНЕЦ
                      |	И ВЫБОР
                      |			КОГДА &ДатаСчетаПо = ДАТАВРЕМЯ(1, 1, 1, 0, 0, 0)
                      |				ТОГДА ИСТИНА
                      |			ИНАЧЕ ЗаявкаНаБронированиеСчета.Ссылка.РезервС <= &ДатаСчетаПо
                      |		КОНЕЦ
                      |	И ВЫБОР
                      |			КОГДА &КонтрагентОтбор = ЗНАЧЕНИЕ(Справочник.Клиенты.ПустаяСсылка)
                      |				ТОГДА ИСТИНА
                      |			ИНАЧЕ ЗаявкаНаБронированиеСчета.Контрагент = &КонтрагентОтбор
                      |		КОНЕЦ");

					  //|	И ВЫБОР
					  //|			КОГДА &ДатаСчетаС = ДАТАВРЕМЯ(1, 1, 1, 0, 0, 0)
					  //|				ТОГДА ИСТИНА
					  //|			ИНАЧЕ ЗаявкаНаБронированиеСчета.ДатаСчета >= &ДатаСчетаС
					  //|		КОНЕЦ
					  //|	И ВЫБОР
					  //|			КОГДА &ДатаСчетаПо = ДАТАВРЕМЯ(1, 1, 1, 0, 0, 0)
					  //|				ТОГДА ИСТИНА
					  //|			ИНАЧЕ ЗаявкаНаБронированиеСчета.ДатаСчета <= &ДатаСчетаПо
					  //|		КОНЕЦ


Запрос.УстановитьПараметр("КонтрагентОтбор",  ЭквайрингВыпискаСчетаКонтрагентОтбор);
Запрос.УстановитьПараметр("ДатаСчетаС", ЭквайрингВыпискаДатаСчетаС);
Запрос.УстановитьПараметр("ДатаСчетаПо",  ЭквайрингВыпискаДатаСчетаПо);
Запрос.УстановитьПараметр("Все",  ЭквайрингВыпискаСчетаВсе);

ТЗ = Запрос.Выполнить().Выгрузить(); 
Для Каждого Строка Из ТЗ Цикл
	НоваяСтрока = ЭквайрингВыпискаСчета.Добавить();		
	ЗаполнитьЗначенияСвойств(НоваяСтрока, Строка);
	
	Если НЕ ЗначениеЗаполнено(Строка.КонтрагентНаименование) Тогда
		Строка.КонтрагентНаименование = Строка.Контрагент.Наименование;	
	КонецЕсли;		
КонецЦикла;

Запрос = Новый Запрос("ВЫБРАТЬ
                      |	1 КАК ТипДокумента,
                      |	""ГС"" КАК ТипДокументаПредставление,
                      |	ГрупповыеСчета.Ссылка КАК ДокументДолг,
                      |	ГрупповыеСчета.Контрагент КАК Контрагент,
                      |	ВЫБОР
                      |		КОГДА ГрупповыеСчета.Контрагент.ТипКлиента = ЗНАЧЕНИЕ(Перечисление.ТипыКлиентов.ЮрЛицо)
                      |			ТОГДА ГрупповыеСчета.Контрагент.НаименованиеЮрЛица
                      |		ИНАЧЕ ГрупповыеСчета.Контрагент.Наименование
                      |	КОНЕЦ КАК КонтрагентНаименование,
                      |	ГрупповыеСчета.СчетГУИД КАК СчетГУИД,
                      |	ГрупповыеСчета.НомерСчета КАК НомерСчета,
                      |	ГрупповыеСчета.ДатаСчета КАК ДатаСчета,
                      |	ЕСТЬNULL(Долги.СуммаДолг, 0) КАК СуммаДолг,
                      |	ЕСТЬNULL(Долги.СуммаКЗакрытию, 0) КАК ОстатокКЗакрытию
                      |ИЗ
                      |	Документ.ГрупповыеСчета КАК ГрупповыеСчета
                      |		ВНУТРЕННЕЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
                      |			ГрупповыеСчетаДокументыДолги.Ссылка КАК Ссылка,
                      |			СУММА(ЗаявкиДолги.СуммаДолг) КАК СуммаДолг,
                      |			СУММА(ЗаявкиДолги.СуммаКЗакрытию) КАК СуммаКЗакрытию
                      |		ИЗ
                      |			Документ.ГрупповыеСчета.ДокументыДолги КАК ГрупповыеСчетаДокументыДолги
                      |				ЛЕВОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
                      |					ЗаявкаНаБронированиеСчетаДетальноДолги.СчетГУИД КАК СчетГУИД,
                      |					СУММА(ЗаявкаНаБронированиеСчетаДетальноДолги.СуммаДолг) КАК СуммаДолг,
                      |					СУММА(ЗаявкаНаБронированиеСчетаДетальноДолги.СуммаКЗакрытию) КАК СуммаКЗакрытию
                      |				ИЗ
                      |					Документ.ЗаявкаНаБронирование.СчетаДетальноДолги КАК ЗаявкаНаБронированиеСчетаДетальноДолги
                      |				ГДЕ
                      |					ЗаявкаНаБронированиеСчетаДетальноДолги.Ссылка.ПометкаУдаления = ЛОЖЬ
                      |					И ЗаявкаНаБронированиеСчетаДетальноДолги.Ссылка.Статус <> ЗНАЧЕНИЕ(Перечисление.СтатусБрони.ОтменаБронирования)
                      |					И ЗаявкаНаБронированиеСчетаДетальноДолги.Ссылка.Статус <> ЗНАЧЕНИЕ(Перечисление.СтатусБрони.ОтказОтБронирования)
                      |				
                      |				СГРУППИРОВАТЬ ПО
                      |					ЗаявкаНаБронированиеСчетаДетальноДолги.СчетГУИД) КАК ЗаявкиДолги
                      |				ПО ГрупповыеСчетаДокументыДолги.СчетГУИД = ЗаявкиДолги.СчетГУИД
                      |		
                      |		СГРУППИРОВАТЬ ПО
                      |			ГрупповыеСчетаДокументыДолги.Ссылка) КАК Долги
                      |		ПО ГрупповыеСчета.Ссылка = Долги.Ссылка
                      |ГДЕ
                      |	ГрупповыеСчета.ПометкаУдаления = ЛОЖЬ
                      |	И ГрупповыеСчета.Проведен = ИСТИНА
                      |	И ВЫБОР
                      |			КОГДА &Все
                      |				ТОГДА ИСТИНА
                      |			ИНАЧЕ ЕСТЬNULL(Долги.СуммаКЗакрытию, 0) > 0
                      |		КОНЕЦ
                      |	И ВЫБОР
                      |			КОГДА &ДатаСчетаС = ДАТАВРЕМЯ(1, 1, 1, 0, 0, 0)
                      |				ТОГДА ИСТИНА
