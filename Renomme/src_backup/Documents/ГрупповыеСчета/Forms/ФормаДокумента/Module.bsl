&НаКлиенте
Процедура ТипГрупповогоСчетаПриИзменении(Элемент)
Если ЕстьДокументыПредупреждение() Тогда 
	
	ТипГрупповогоСчета_OldValue = ОбщийФункционалСервер.ЗначениеРеквизитаНаСервере(Объект.Ссылка, "ТипГрупповогоСчета");
	Объект.ТипГрупповогоСчета = ТипГрупповогоСчета_OldValue;
	
	Возврат;
КонецЕсли;

Объект.Контрагент = Неопределено;
//Элементы.Контрагент.ОбновитьТекстРедактирования();

ЭтаФормаНастройка();

Если ЗначениеЗаполнено(Объект.Ссылка) Тогда
	ЭтаФорма.Записать(Новый Структура("РежимЗаписи", РежимЗаписиДокумента.Проведение));
КонецЕсли;
КонецПроцедуры
//
	

//
&НаКлиенте
Процедура КонтрагентПриИзменении(Элемент)
Если ЗначениеЗаполнено(Объект.Контрагент) Тогда 	
	Если ЕстьДокументыПредупреждение() Тогда 
		Контрагент_OldValue = ОбщийФункционалСервер.ЗначениеРеквизитаНаСервере(Объект.Ссылка, "Контрагент");
		Объект.Контрагент = Контрагент_OldValue;
		
		Возврат;
	КонецЕсли;

	Если ПроверкаКонтрагента() Тогда
		Контрагент_OldValue = ОбщийФункционалСервер.ЗначениеРеквизитаНаСервере(Объект.Ссылка, "Контрагент");
		Объект.Контрагент = Контрагент_OldValue;
		
		ПоказатьПредупреждение(, "Контрагент не подходит для отбора");
		
		Возврат;
	КонецЕсли;
КонецЕсли;

ЮрЛицо = КлиентыСервер.ЭтоЮрЛицо(Объект.Контрагент);

ЭтаФормаНастройка();

Если ЗначениеЗаполнено(Объект.Ссылка) Тогда
	ЭтаФорма.Записать(Новый Структура("РежимЗаписи", РежимЗаписиДокумента.Проведение));
КонецЕсли;
КонецПроцедуры

&НаСервере
Функция ПроверкаКонтрагента()
ПараметрыОтбора	= КонтрагентНачалоВыбораПараметрыОтбора(Объект.ТипГрупповогоСчета);

Если Объект.Контрагент.Турагентство <> ПараметрыОтбора.Турагентство Тогда Возврат Истина; КонецЕсли;

СписокЗначенийТипыОплатыСчета = Неопределено;
Если ПараметрыОтбора.Свойство("СписокЗначенийТипыОплатыСчета", СписокЗначенийТипыОплатыСчета) Тогда
	Для Каждого Элемент Из СписокЗначенийТипыОплатыСчета Цикл
		Возврат Ложь;				
	КонецЦикла;
	
	Возврат Истина;				
КонецЕсли;

Возврат Ложь;				
КонецФункции

&НаКлиенте
Процедура КонтрагентНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
СтандартнаяОбработка = Ложь;

Если НЕ ЗначениеЗаполнено(Объект.ТипГрупповогоСчета) Тогда Возврат; КонецЕсли;

ПараметрыФормы = КонтрагентНачалоВыбораПараметрыОтбора(Объект.ТипГрупповогоСчета);
Если НЕ ПараметрыФормы.Свойство("Турагентство") Тогда Возврат; КонецЕсли;

ОткрытьФорму("Документ.ГрупповыеСчета.Форма.ФормаВыбораКонтрагента", ПараметрыФормы, Элементы.Контрагент
	,,,,, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
КонецПроцедуры

&НаСервереБезКонтекста
Функция КонтрагентНачалоВыбораПараметрыОтбора(ТипГрупповогоСчета)
ПараметрыФормы = Новый Структура;
Если ТипГрупповогоСчета = Перечисления.ТипыГрупповогоСчета.ГруппаЗаявок Тогда
	ПараметрыФормы.Вставить("Турагентство", Ложь);
	
ИначеЕсли ТипГрупповогоСчета = Перечисления.ТипыГрупповогоСчета.ТурагентствоВзаимозачет Тогда
	ПараметрыФормы.Вставить("Турагентство", Истина);
	
	СписокЗначенийТипыОплатыСчета = Новый СписокЗначений;
	СписокЗначенийТипыОплатыСчета.Добавить(Перечисления.ТипОплатыСчета.Взаимозачет);
	
	ПараметрыФормы.Вставить("СписокЗначенийТипыОплатыСчета", СписокЗначенийТипыОплатыСчета);
	
ИначеЕсли ТипГрупповогоСчета = Перечисления.ТипыГрупповогоСчета.ТурагентствоДолги Тогда
	ПараметрыФормы.Вставить("Турагентство", Истина);
	
 	СписокЗначенийТипыОплатыСчета = Новый СписокЗначений;
	СписокЗначенийТипыОплатыСчета.Добавить(Перечисления.ТипОплатыСчета.ОплатаТурагентствомСоСкидкой);
	СписокЗначенийТипыОплатыСчета.Добавить(Перечисления.ТипОплатыСчета.ПолнаяОплатаТурагентствомСВозвратомКомиссии);
	
	ПараметрыФормы.Вставить("СписокЗначенийТипыОплатыСчета", СписокЗначенийТипыОплатыСчета);
Иначе
	
КонецЕсли;

Возврат ПараметрыФормы;
КонецФункции

&НаКлиенте
Процедура КонтрагентАвтоПодбор(Элемент, Текст, ДанныеВыбора, ПараметрыПолученияДанных, Ожидание, СтандартнаяОбработка)
Если НЕ ЗначениеЗаполнено(Текст) Тогда Возврат; КонецЕсли;	
	
ПараметрыОтбора = КонтрагентНачалоВыбораПараметрыОтбора(Объект.ТипГрупповогоСчета);	
ДанныеВыбора = КонтаргентДанныеВыбора(Текст, ПараметрыОтбора);
СтандартнаяОбработка = Ложь;
КонецПроцедуры

&НаКлиенте
Процедура КонтрагентОкончаниеВводаТекста(Элемент, Текст, ДанныеВыбора, ПараметрыПолученияДанных, СтандартнаяОбработка)
Если НЕ ЗначениеЗаполнено(Текст) Тогда Возврат; КонецЕсли;	
	
ПараметрыОтбора = КонтрагентНачалоВыбораПараметрыОтбора(Объект.ТипГрупповогоСчета);	
ДанныеВыбора = КонтаргентДанныеВыбора(Текст, ПараметрыОтбора);
СтандартнаяОбработка = Ложь;
КонецПроцедуры

&НаСервереБезКонтекста
Функция КонтаргентДанныеВыбора(Наименование, ПараметрыОтбора)
ДанныеВыбора = Новый СписокЗначений();

Если НЕ ПараметрыОтбора.Свойство("Турагентство") Тогда Возврат ДанныеВыбора; КонецЕсли;	
	
Запрос = Новый Запрос;
Запрос.Текст = "ВЫБРАТЬ
                      |	Клиенты.Ссылка КАК Ссылка,
                      |	Клиенты.Наименование КАК Наименование
                      |ИЗ
                      |	Справочник.Клиенты КАК Клиенты
                      |ГДЕ
                      |	Клиенты.ПометкаУдаления = ЛОЖЬ
                      |	И Клиенты.Турагентство = &Турагентство
                      |	И Клиенты.Наименование ПОДОБНО &Наименование";

Если ПараметрыОтбора.Свойство("СписокЗначенийТипыОплатыСчета") Тогда
	Запрос.Текст = Запрос.Текст + "
		| И Клиенты.ТипОплатыСчета В (&Список)";
	
	Запрос.УстановитьПараметр("Список", ПараметрыОтбора.СписокЗначенийТипыОплатыСчета); 
КонецЕсли;	

Запрос.УстановитьПараметр("Турагентство", ПараметрыОтбора.Турагентство);
Запрос.УстановитьПараметр("Наименование", "%" + Наименование+ "%");

Выборка = Запрос.Выполнить().Выбрать();
Пока Выборка.Следующий() Цикл
	
	ДанныеВыбора.Добавить(Выборка.Ссылка);	
КонецЦикла;
			
Возврат ДанныеВыбора;	
КонецФункции

