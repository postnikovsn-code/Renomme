Функция ТабличныйДокументСчетКоворкинг(ДокументДолгСсылка) Экспорт
ТабДок = Новый ТабличныйДокумент;

ПечатьСчета_СчетКоворкинг(ТабДок, ДокументДолгСсылка);
	
ТабДок.ОтображатьСетку = Ложь; ТабДок.Защита = Ложь; ТабДок.ТолькоПросмотр = Истина; ТабДок.ОтображатьЗаголовки = Ложь;

Возврат ТабДок;	
КонецФункции	

Процедура ПечатьСчета_СчетКоворкинг(ТабДок,  ДокументДолгСсылка) Экспорт
МакСчетЮрЛицо = "СчетКоворкинг";
МакСчетФизЛицо = "СчетКоворкинг";

Оплачивает = КоворкингСервер.ОплачиваетСчет(ДокументДолгСсылка);
Если Оплачивает.ТипКлиента = Перечисления.ТипыКлиентов.ПустаяСсылка() Тогда
	Сообщить("У клиента: " + Оплачивает + " не заполнен 'Тип клиента'. ПЕЧАТЬ СЧЕТА ОТМЕНЯЕТСЯ ...");
	
	Возврат;
КонецЕсли;

ОплачиваетЮрЛицо = КлиентыСервер.ЭтоЮрЛицо(Оплачивает);
Если ОплачиваетЮрЛицо Тогда
	//МакетЮрЛицо = ПолучитьМакетДокументаСчетКоворкинг(МакСчетЮрЛицо);
	МакетЮрЛицо = ПолучитьОбщийМакет(МакСчетЮрЛицо);
	
	ПечатьСчетаЮрЛицо_СчетКоворкинг(ТабДок, МакетЮрЛицо, ДокументДолгСсылка); 
	
Иначе	
	//МакетФизЛицо = ПолучитьМакетДокументаСчетКоворкинг(МакСчетФизЛицо);
	МакетФизЛицо = ПолучитьОбщийМакет(МакСчетФизЛицо);

	ПечатьСчетаФизЛицо_СчетКоворкинг(ТабДок, МакетФизЛицо, ДокументДолгСсылка);
КонецЕсли;
КонецПроцедуры

Функция ПолучитьМакетДокументаСчетКоворкинг(ИмяМакета) Экспорт
МакетИмя = НастройкиСервер.ПолучитьИмяТекущаяОрганизация();	
МакетИмя = ИмяМакета + "_" + МакетИмя;

Макет = Документы.КоворкингСчета.ПолучитьМакет(МакетИмя);
Возврат Макет;
КонецФункции


