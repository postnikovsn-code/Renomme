Функция ПечатьАктаДействие(КоворкингОбъект) Экспорт
ТабДок = Новый ТабличныйДокумент;

//МакАкт="Акт";
//Макет = КоворкингПечатьСервер.ПолучитьМакетДокументаСчетКоворкинг(МакАкт);
Макет = ПолучитьОбщийМакет("АктКоворкинг");

ДатаУчетаНДС = КоворкингОбъект.ДатаПо;
СтавкаНДС = ДокументыСервер.СтавкаНДС(Истина);  СтавкаНДС = ДокументыСервер.СтавкаНДСТекущая(СтавкаНДС, ДатаУчетаНДС);

УчитыватьНДС =  ДокументыСервер.УчитыватьНДС(КоворкингОбъект.ДатаПо);

НомерАкта = ОбщийФункционалКлиентСервер.УбратьНезначащиеНули(КоворкингОбъект.Номер);
ДатаАкта = НачалоДня(КоворкингОбъект.ДатаПо);

Если ЗначениеЗаполнено(КоворкингОбъект.ОплачиваетСчет) Тогда 
	Контрагент = КоворкингОбъект.ОплачиваетСчет;	
Иначе
	Контрагент = КоворкингОбъект.КоворкингЗаявка.Клиент;	
КонецЕсли;

ТекстЗаголовка = ПечатьАкта_Шапка(ТабДок, Макет, НомерАкта, ДатаАкта, Контрагент);  

СчетчикСтрок = 0; СуммаИтого = 0;
ПечатьКоворкингТело(ТабДок, Макет, КоворкингОбъект, Ложь);

ПечатьАкта_Подвал(ТабДок, Макет, ТекстЗаголовка); 

Возврат ТабДок;
КонецФункции

Функция ПечатьАкта_Шапка(ТабДок, Макет, Номер, Дата, Контрагент) 
// Заголовок

//ДанныеОрганизации = Справочники.Организации.ПолучитьДанныеОрганизации(Истина);
ТекущаяОрганизация = НастройкиСервер.ПолучитьТекущуюОрганизацию();

ТекстЗаголовка="Акт № " + Номер + " от "+ Формат(Дата, "ДФ=dd.MM.yy");

Область = Макет.ПолучитьОбласть("Заголовок");
Область.Параметры.ТекстЗаголовка = ТекстЗаголовка;
Область.Параметры.ЗаголовокАкт = "Коворкинг " + ТекущаяОрганизация.НаименованииеОтеляДляДокументов 
	+ " ИНН " + ТекущаяОрганизация.КоворкингИНН + " КПП " + ТекущаяОрганизация.КоворкингКПП
	+ " " + ТекущаяОрганизация.КоворкингОрганизацияДляДокументов; 
Область.Параметры.АдресАкт = ТекущаяОрганизация.КоворкингАдресДляДокументов;

ТабДок.Вывести(Область);

Область = Макет.ПолучитьОбласть("Покупатель");
ПредставлениеКлиента = ОбщееСервер.ПолучитьПредставлениеКлиента(Контрагент);	

Область.Параметры.Заказчик = ПредставлениеКлиента;	
ТабДок.Вывести(Область);

Возврат ТекстЗаголовка;
КонецФункции

Функция ПечатьАкта_Подвал(ТабДок, Макет, ТекстЗаголовка)

ИтогоСтр=Макет.ПолучитьОбласть("Подписи");
ТабДок.Вывести(ИтогоСтр);

ТабДок.ВерхнийКолонтитул.ТекстВЦентре = ТекстЗаголовка;
ТабДок.ВерхнийКолонтитул.ВертикальноеПоложение = ВертикальноеПоложение.Центр;
ТабДок.ВерхнийКолонтитул.НачальнаяСтраница = 2;
мШрифт = Новый Шрифт(, 9, Истина, , , );
ТабДок.ВерхнийКолонтитул.Шрифт = мШрифт;
//ТабДок.ВерхнийКолонтитул.Выводить = Истина;
ТабДок.ВерхнийКолонтитул.Выводить = Ложь;

ТабДок.НижнийКолонтитул.ТекстСправа = "[&НомерСтраницы] из [&СтраницВсего]";
ТабДок.НижнийКолонтитул.НачальнаяСтраница = 2;
мШрифт = Новый Шрифт(, 9, Истина, , , );
ТабДок.НижнийКолонтитул.Шрифт = мШрифт;
//ТабДок.НижнийКолонтитул.Выводить = Истина;
ТабДок.НижнийКолонтитул.Выводить = Ложь;

Возврат ТабДок;
КонецФункции
