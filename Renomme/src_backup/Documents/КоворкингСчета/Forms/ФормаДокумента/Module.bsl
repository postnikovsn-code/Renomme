&НаКлиенте
Процедура ДобавитьОплатаБезнал(Команда)
ДанныеОбъект = Объект;	
СуммаКоплате = КоворкингСервер.СуммаКОплатеКоворкинг(ДанныеОбъект);
Если СуммаКоплате = 0 Тогда
	ПоказатьПредупреждение(,"Сумма счета к оплате = 0"	
		+ Символы.ПС + Символы.ПС + "ОПЛАТА НЕ РАЗРЕШЕНА ...");		
		
	Возврат;
КонецЕсли;

Если НЕ ЭтаФорма.Записать(Новый Структура("РежимЗаписи", РежимЗаписиДокумента.Проведение)) Тогда Возврат; КонецЕсли;

ПараметрыФормы = Новый Структура();

Клиент = ОбщийФункционалСервер.ЗначениеРеквизитаНаСервере(Объект.КоворкингЗаявка, "Клиент");	
Контрагент = ?(ЗначениеЗаполнено(Объект.ОплачиваетСчет), Объект.ОплачиваетСчет, Клиент); 

СписокКонтрагентыЗаявка = Новый СписокЗначений; 
СписокКонтрагентыЗаявка.Добавить(Контрагент);
ПараметрыФормы.Вставить("ОтКого", СписокКонтрагентыЗаявка);

ПараметрыФормы.Вставить("КонтрагентТолькоПросмотр", Истина);

ДанныеОбъект = Объект;
СуммаКОплате = КоворкингСервер.СуммаКОплатеКоворкинг(ДанныеОбъект);
Если СуммаКОплате <= 0 Тогда ЭтаФорма.Модифицированность = Ложь; Возврат; КонецЕсли;
ПараметрыФормы.Вставить("СуммаКОплате", СуммаКОплате);

ДопПараметры = Новый Структура();
ДопПараметры.Вставить("СуммаКОплате", СуммаКОплате);

Оповещение = Новый ОписаниеОповещения("ЗавершениеФормаВыбораОплата_ОплатаБезнал", ЭтаФорма, ДопПараметры);
ОткрытьФорму("Документ.ВыпискаБанка.Форма.ФормаВыбораОплата", ПараметрыФормы , ЭтаФорма
	,,,, Оповещение, РежимОткрытияОкнаФормы .БлокироватьОкноВладельца);
КонецПроцедуры

