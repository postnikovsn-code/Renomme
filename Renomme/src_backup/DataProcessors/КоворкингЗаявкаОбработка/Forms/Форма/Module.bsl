КонецПроцедуры

&НаСервере
Процедура ОбновитьСчета() Экспорт
Элементы.Счета.Обновить();	

Если ЗначениеЗаполнено(ТекущийСчет) Тогда 
	Элементы.Счета.ТекущаяСтрока = ТекущийСчет;
КонецЕсли;	
КонецПроцедуры

&НаКлиенте
Асинх Процедура ДобавитьСчет(Команда)
ТД = Элементы.Заявки.ДанныеСтроки(Элементы.Заявки.ТекущаяСтрока);
Если ТД = Неопределено Тогда Возврат; КонецЕсли;

ПочасоваяОплата = ОбщийФункционалСервер.ЗначениеРеквизитаНаСервере(ТД.Ссылка, "ПочасоваяОплата");
Если НЕ ПочасоваяОплата Тогда
	СледующийСчетДатаС = КоворкингСервер.СледующийСчетДатаС(ТД.Ссылка);

	Если СледующийСчетДатаС > ТД.ДатаПо Тогда
		Текст = "'Следующая 'Дата C' счета: " + Формат(СледующийСчетДатаС, "ДФ=dd.MM.yyyy")
			+ " БОЛЬШЕ 'Дата По' Заявки: " + Формат(ТД.ДатаПо, "ДФ=dd.MM.yyyy") + ".";
		ПоказатьПредупреждение(, Текст);
		
		Возврат;
		
		//Результат = Ждать ВопросАсинх("Дата счета: " + Формат(СледующийСчетДатаС, "ДФ=dd.MM.yyyy")
		//	+ " больше даты по Заявки: " + Формат(ТД.ДатаПо, "ДФ=dd.MM.yyyy") + "
		//	|
		//	|ПРОДОЛЖИТЬ ..."		
		//	, РежимДиалогаВопрос.ОКОтмена); 
		//Если Результат = КодВозвратаДиалога.Отмена Тогда СледующийСчетДатаС = Неопределено; Возврат; КонецЕсли;
	КонецЕсли;
КонецЕсли;

ДобавитьСчетНаСервере(ТД.Ссылка);
КонецПроцедуры

&НаСервере
Функция ЭтоПочасоваяОплата() Экспорт
	
КонецФункции

&НаСервере
Процедура ДобавитьСчетНаСервере(КоворкингЗаявка)
КоворкингЗаявкаОбъект = КоворкингЗаявка.ПолучитьОбъект();	

Если КоворкингЗаявкаОбъект.ПочасоваяОплата Тогда 
	ТекущийСчет = КоворкингСервер.ДобавитьСчетЧасы(КоворкингЗаявкаОбъект);
Иначе		
	ТекущийСчет = КоворкингСервер.ДобавитьСчетДни(КоворкингЗаявкаОбъект);
КонецЕсли;
Если ТекущийСчет = Неопределено Тогда Возврат; КонецЕсли; 

ОбновитьСчета();
КонецПроцедуры

