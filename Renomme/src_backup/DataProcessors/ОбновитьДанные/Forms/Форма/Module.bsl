//
&НаКлиенте
Процедура ЗаполнитьЗаявкиГорничные(Команда)
	ЗаполнитьЗаявкиГорничныеНаСервере();
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьЗаявкиГорничныеНаСервере()
Запрос = Новый Запрос("ВЫБРАТЬ
                      |	ЗаявкаНаБронирование.Ссылка КАК Ссылка,
                      |	ЗаявкаНаБронирование.Статус КАК Статус
                      |ИЗ
                      |	Документ.ЗаявкаНаБронирование КАК ЗаявкаНаБронирование
                      |ГДЕ
                      |	ЗаявкаНаБронирование.РезервПо >= &РезервПо
                      |	И (ЗаявкаНаБронирование.Статус = ЗНАЧЕНИЕ(Перечисление.СтатусБрони.Проживает)
                      |			ИЛИ ЗаявкаНаБронирование.Статус = ЗНАЧЕНИЕ(Перечисление.СтатусБрони.Бронь))");

Запрос.УстановитьПараметр("РезервПо", НачалоДня(ТекущаяДата()));
	
ТЗ = Запрос.Выполнить().Выгрузить();

Для Каждого Строка Из ТЗ Цикл
	Если Строка.Статус = Перечисления.СтатусБрони.Бронь Тогда
		Событие = "Бронирование";
	ИначеЕсли Строка.Статус = Перечисления.СтатусБрони.Проживает Тогда
		 Событие = "Заезд";
	Иначе           
		Продолжить;
	КонецЕсли;
	
	//ЗаявкаОбъект = Строка.Ссылка.ПолучитьОбъект();
