Процедура ВыполнитьОперациюПоПлатежнойКарте(Форма, ТипТранзакции, ИмяОповещенияОЗавершении)
	
	ОчиститьСообщения();
	ПараметрыОперации = Новый Структура();
	ПараметрыОперации.Вставить("ТипТранзакции"               , ТипТранзакции);
	
	ПараметрыОперации.Вставить("УказатьДополнительныеДанные" , Истина);
	Если ТипТранзакции = "AuthorizeSales" Тогда ПараметрыОперации.УказатьДополнительныеДанные = Ложь; КонецЕсли;
	
	ПараметрыОперации.Вставить("ЗапретРедактированияСуммы"   , Ложь);
	
	Если ТипТранзакции = "AuthorizeRefund" 
	ИЛИ  ТипТранзакции = "AuthorizeVoid" 
	Тогда
		ПараметрыОперации.Вставить("ПоказыватьНомерКарты" , Истина);
	КонецЕсли;	
		
	ПараметрыОперации.Вставить("ФормаУникальныйИдентификатор"   , Форма.УникальныйИдентификатор);
	
	ПараметрыОперации.Вставить("ИмяОповещенияОЗавершении"   , ИмяОповещенияОЗавершении);
	
	ОписаниеОповещения = Новый ОписаниеОповещения("ВыполнитьОперациюПоПлатежнойКартеЗавершение", ЭтотОбъект, ПараметрыОперации);
	
	Если ТипТранзакции = "AuthorizeSales"       
	ИЛИ  ТипТранзакции = "AuthorizeRefund" 
	ИЛИ  ТипТранзакции = "AuthorizeVoid" 
	Тогда
		//ОткрытьФорму("Справочник.ПодключаемоеОборудование.Форма.ФормаАвторизацииЭТ_ПСН", ПараметрыОперации, Форма 
		//	,,  ,, ОписаниеОповещения, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
		ОткрытьФорму("ОбщаяФорма.ФормаАвторизацииЭТ_ПСН", ПараметрыОперации, Форма 
			,,,, ОписаниеОповещения, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	Иначе
		//ОткрытьФорму("Справочник.ПодключаемоеОборудование.Форма.ФормаАвторизацииЭТ", ПараметрыОперации, Форма
		//	,,  ,, ОписаниеОповещения, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	КонецЕсли;	
КонецПроцедуры


Процедура ВыполнитьОперациюПоПлатежнойКартеЗавершение(Результат, Параметры) Экспорт
	
	Если ТипЗнч(Результат) = Тип("Структура") Тогда
		
		Если НЕ Параметры.Свойство("ТипТранзакции") Тогда
			ТекстСообщения = НСтр("ru = 'Не указан тип транзакции.'");
			ОбщегоНазначенияБПОКлиент.СообщитьПользователю(ТекстСообщения);
			Возврат;
		КонецЕсли;
		
		//Форма = Результат.Форма;
		
		ФормаУникальныйИдентификатор = Параметры.ФормаУникальныйИдентификатор;
		Форма = НайтиУправляемуюФорму(ФормаУникальныйИдентификатор);
		
		Форма.Доступность = Ложь;
		
		ПараметрыОперации = ОборудованиеПлатежныеСистемыКлиентСервер.ПараметрыВыполненияЭквайринговойОперации();
		ПараметрыОперации.ТипТранзакции  = Параметры.ТипТранзакции;
		ПараметрыОперации.СуммаОперации  = Результат.Сумма;
		ПараметрыОперации.НомерЧека      = ?(Результат.Свойство("НомерЧека")  , Результат.НомерЧека, "");
		ПараметрыОперации.НомерЧекаЭТ    = ?(Результат.Свойство("НомерЧекаЭТ"), Результат.НомерЧекаЭТ, "");

		ПараметрыОперации.СсылочныйНомер = Результат.СсылочныйНомер;
		
		ДанныеОперации = Новый Структура();
		ДанныеОперации.Вставить("ТипТранзакции", Параметры.ТипТранзакции);
		ДанныеОперации.Вставить("ДанныеКарты", ?(Результат.Свойство("ДанныеКарты")  , Результат.ДанныеКарты, ""));
		ДанныеОперации.Вставить("ТипКарты", ?(Результат.Свойство("ТипКарты")  , Результат.ТипКарты, 0));
		ДанныеОперации.Вставить("НомерЧека", ?(Результат.Свойство("НомерЧека")  , Результат.НомерЧека, ""));
		
		ДанныеОперации.Вставить("СсылочныйНомерВозврат", Результат.СсылочныйНомер);
		
		ДанныеОперации.Вставить("ФормаУникальныйИдентификатор",  Параметры.ФормаУникальныйИдентификатор);
		
		ДанныеОперации.Вставить("ЭтоКоворкинг",  Форма.ЭтоКоворкинг);
		
		//Оповещение = Новый ОписаниеОповещения("ВыполнитьОперациюЗавершение", ЭтотОбъект, ДанныеОперации);
		ИмяОповещенияОЗавершении = Параметры.ИмяОповещенияОЗавершении;
		Если ЗначениеЗаполнено(ИмяОповещенияОЗавершении) Тогда
			Оповещение = Новый ОписаниеОповещения(Параметры.ИмяОповещенияОЗавершении , Форма, ДанныеОперации);
		Иначе
			Оповещение = Новый ОписаниеОповещения("ВыполнитьОперациюЗавершениеПоУмолчанию", ЭтотОбъект, ДанныеОперации);
		КонецЕсли;
		ОборудованиеПлатежныеСистемыКлиент.НачатьВыполнениеОперацииНаЭквайринговомТерминале(Оповещение
			, ФормаУникальныйИдентификатор, Неопределено, ПараметрыОперации);
		
	КонецЕсли;
	
КонецПроцедуры


Функция НайтиУправляемуюФорму(УникальныйИдентификатор) 
 
    Перем Окно, СодержимоеОкна;
 
    Для Каждого Окно Из ПолучитьОкна() Цикл
        Для Каждого СодержимоеОкна Из Окно.Содержимое Цикл
            Если ТипЗнч(СодержимоеОкна) = Тип("УправляемаяФорма")
                    И СодержимоеОкна.УникальныйИдентификатор = УникальныйИдентификатор Тогда
                Возврат СодержимоеОкна;
            КонецЕсли;
        КонецЦикла;
    КонецЦикла;
    Возврат Неопределено;
 
    // Для демонстрации
	//Сообщить(Формат(Отказ, "БЛ=Нашел!; БИ='Не нашел!'"));
 
КонецФункции

