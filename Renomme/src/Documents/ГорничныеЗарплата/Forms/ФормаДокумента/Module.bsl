&НаКлиенте
Процедура ПомещенияУборкиПриОкончанииРедактирования(Элемент, НоваяСтрока, ОтменаРедактирования)
ТД = Элемент.ТекущиеДанные;

СуммаИтого = 0;
Для Каждого Строка Из ПомещенияСправочник Цикл	
	Имя = "Количество_" + Строка(Строка.Номер);
	Количество = ТД[Имя];
	Имя = "Количество_" + Строка(Строка.Номер) + "_Р";
	Количество_Р = ТД[Имя];
	Имя = "Количество_" + Строка(Строка.Номер) + "_Э";
	Количество_Э = ТД[Имя];
	
	Имя = "ПомещениеЦена_" + Строка(Строка.Номер);
	Цена = ЭтаФорма[Имя];
	
	ОтборСтроки = Новый Структура("Горничная, Помещение", ТД.Горничная, Строка.Помещение);
	НайденныеСтроки = Объект.ЗарплатаПомещения.НайтиСтроки(ОтборСтроки);
	Если НайденныеСтроки.Количество() = 0 Тогда
		СтрокаЗарплатаПомещения = Объект.ЗарплатаПомещения.Добавить();
		СтрокаЗарплатаПомещения.Горничная = ТД.Горничная;
		СтрокаЗарплатаПомещения.Помещение = Строка.Помещение;
	Иначе	
		СтрокаЗарплатаПомещения = НайденныеСтроки[0];
	КонецЕсли;
	СтрокаЗарплатаПомещения.Количество = Количество;			
	СтрокаЗарплатаПомещения.Количество_Р = Количество_Р;			
	
	СуммаИтого = СуммаИтого + Количество_Э * Цена;
КонецЦикла;
	
ТД.СуммаИтого = СуммаИтого;	

ОбновитьСтрокаЗарплата(ТД.Горничная, СуммаИтого);
КонецПроцедуры

&НаСервере
Процедура ОбновитьСтрокаЗарплата(Горничная, СуммаИтого)
ОтборСтроки = Новый Структура("Горничная", Горничная);	
НайденныеСтроки = Объект.Зарплата.НайтиСтроки(ОтборСтроки);	

Строка = НайденныеСтроки[0];
Строка.СуммаПомещения = СуммаИтого;

ОбновитьЗарплатаИтого(Строка);
КонецПроцедуры	
	
