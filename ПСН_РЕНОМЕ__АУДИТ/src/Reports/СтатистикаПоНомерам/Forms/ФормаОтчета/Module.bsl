	ВремяЗаездаТочное = Стр.Ссылка.ВремяЗаездаТочное;
	ВремяЗаездаТочное_П = Формат(ВремяЗаездаТочное, "ДФ=dd.MM.yy") + " " + Формат(ВремяЗаездаТочное, "ДФ=HH:mm");
	Обл.Параметры.ДатаЗ = ВремяЗаездаТочное_П;
	
	ВремяВыездаТочное = Стр.Ссылка.ВремяВыездаТочное;
