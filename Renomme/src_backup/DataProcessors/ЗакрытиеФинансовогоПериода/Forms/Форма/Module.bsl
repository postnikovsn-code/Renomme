Запрос.Текст = Запрос.Текст + "
	|	И (ЕСТЬNULL(СписаниеПроживания.СуммаОплаты, 0) <> 0 
	| ИЛИ ЕСТЬNULL(СписаниеУслуги.СуммаОплаты, 0) <> 0)
	|
	|УПОРЯДОЧИТЬ ПО
	|	РезервС,
	|	НомерВРезерв";	
	
Запрос.УстановитьПараметр("ДатаС", ДатаС);	
Запрос.УстановитьПараметр("ДатаПо", ДатаПо);

ТЗ = Запрос.Выполнить().Выгрузить();

Обработка = РеквизитФормыВЗначение("Объект");
МакетОбработки = Обработка.ПолучитьМакет("МакетСписание");

Область = МакетОбработки.ПолучитьОбласть("Заголовок");
ОтельСсылка = НастройкиСервер.ПолучитьТекущуюОрганизацию();
Отель = ОтельСсылка.Наименование;
Область.Параметры.Отель = Отель;
Область.Параметры.ДатаС = Формат(ДатаС, "ДФ=dd.MM.yy");
Область.Параметры.ДатаПо = Формат(ДатаПо, "ДФ=dd.MM.yy");
ТабДок.Вывести(Область);

Область = МакетОбработки.ПолучитьОбласть("Шапка|Лево");
ТабДок.Вывести(Область);

Для Каждого Строка Из УслугиРодительСправочник Цикл
	ОбластьУслуги = МакетОбработки.ПолучитьОбласть("Шапка|Услуга");
	ОбластьУслуги.Параметры.ШапкаУслуга = Строка.ЗаголовокОтчеты;
	ТабДок.Присоединить(ОбластьУслуги);
КонецЦикла;

//Возврат ТабДок_1;

НомерСтрокиШапкаСписание = ТабДок.ВысотаТаблицы;     

//Данные.Очистить();
НомерКомментарий_Списание = Область.ШиринаТаблицы;
НомерСтрокиШапкаСписание = ТабДок.ВысотаТаблицы;

НомерКолонкиСуммаПроживание = 10;
НомерКолонкиСуммаУслуги = 12;

Для Каждого Строка Из ТЗ Цикл
	Область = МакетОбработки.ПолучитьОбласть("Строка|Лево");
	
