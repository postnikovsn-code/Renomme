      <userSettingsGroup>СписокКомпоновщикНастроекПользовательскиеНастройки</userSettingsGroup>
    </extInfo>
  </items>
  <autoCommandBar>
    <name>ФормаКоманднаяПанель</name>
    <id>-1</id>
    <horizontalAlign>Left</horizontalAlign>
    <autoFill>true</autoFill>
  </autoCommandBar>
  <handlers>
    <event>OnCreateAtServer</event>
    <name>ПриСозданииНаСервере</name>
  </handlers>
  <windowOpeningMode>LockOwnerWindow</windowOpeningMode>
  <saveWindowSettings>true</saveWindowSettings>
  <autoUrl>true</autoUrl>
  <group>Vertical</group>
  <autoFillCheck>true</autoFillCheck>
  <allowFormCustomize>true</allowFormCustomize>
  <enabled>true</enabled>
  <showTitle>true</showTitle>
  <showCloseButton>true</showCloseButton>
  <attributes>
    <name>Список</name>
    <id>1</id>
    <valueType>
      <types>DynamicList</types>
    </valueType>
    <view>
      <common>true</common>
    </view>
    <edit>
      <common>true</common>
    </edit>
    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>Список.ДокументДолг</segments>
    </notDefaultUseAlwaysAttributes>
    <main>true</main>
    <extInfo xsi:type="form:DynamicListExtInfo">
      <queryText>ВЫБРАТЬ
	ДолгиОплаты.ДокументДолг КАК ДокументДолг,
	СУММА(ДолгиОплаты.СуммаДолгОплата) КАК СуммаДолгОплата,
	ВЫБОР
		КОГДА ТИПЗНАЧЕНИЯ(ДолгиОплаты.ДокументДолг) = ТИП(Документ.ЗаявкаНаБронирование)
			ТОГДА 1
		КОГДА ТИПЗНАЧЕНИЯ(ДолгиОплаты.ДокументДолг) = ТИП(Документ.ГрупповыеСчета)
			ТОГДА 2
		КОГДА ТИПЗНАЧЕНИЯ(ДолгиОплаты.ДокументДолг) = ТИП(Документ.КоворкингСчета)
			ТОГДА 3
		ИНАЧЕ 0
	КОНЕЦ КАК ТипДокумента,
	ВЫБОР
		КОГДА ТИПЗНАЧЕНИЯ(ДолгиОплаты.ДокументДолг) = ТИП(Документ.ЗаявкаНаБронирование)
			ТОГДА &quot;ЗБ&quot;
		КОГДА ТИПЗНАЧЕНИЯ(ДолгиОплаты.ДокументДолг) = ТИП(Документ.ГрупповыеСчета)
			ТОГДА &quot;ГС&quot;
		КОГДА ТИПЗНАЧЕНИЯ(ДолгиОплаты.ДокументДолг) = ТИП(Документ.КоворкингСчета)
			ТОГДА &quot;КВ&quot;
		ИНАЧЕ &quot;&quot;
	КОНЕЦ КАК ТипДокументаПредставление
ИЗ
	(ВЫБРАТЬ
		КассовыйДокументДолги.Ссылка КАК Ссылка,
		КассовыйДокументДолги.ДокументДолг КАК ДокументДолг,
		КассовыйДокументДолги.Сумма КАК СуммаДолгОплата
	ИЗ
		(ВЫБРАТЬ
			КассовыйДокументДолгиОплата.Ссылка КАК Ссылка,
			КассовыйДокументДолгиОплата.ДокументДолг КАК ДокументДолг,
			СУММА(КассовыйДокументДолгиОплата.Сумма) КАК Сумма
		ИЗ
			Документ.КассовыйДокумент.ДолгиОплата КАК КассовыйДокументДолгиОплата
		
		СГРУППИРОВАТЬ ПО
			КассовыйДокументДолгиОплата.Ссылка,
			КассовыйДокументДолгиОплата.ДокументДолг) КАК КассовыйДокументДолги
			ВНУТРЕННЕЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
				КассовыйДокумент.Ссылка КАК ДокументОплаты,
				КассовыйДокумент.Сумма КАК СуммаДокумента,
				ЕСТЬNULL(Возвраты.Сумма, 0) КАК СуммаВозврата,
				КассовыйДокумент.Сумма - ЕСТЬNULL(Возвраты.Сумма, 0) КАК ОстатокДокумента
			ИЗ
				Документ.КассовыйДокумент КАК КассовыйДокумент
					ЛЕВОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
						КассовыйДокумент.ВозвратДокумент КАК ВозвратДокумент,
						СУММА(КассовыйДокумент.Сумма) КАК Сумма
					ИЗ
						Документ.КассовыйДокумент КАК КассовыйДокумент
					ГДЕ
						КассовыйДокумент.ПометкаУдаления = ЛОЖЬ
					
					СГРУППИРОВАТЬ ПО
						КассовыйДокумент.ВозвратДокумент) КАК Возвраты
					ПО КассовыйДокумент.Ссылка = Возвраты.ВозвратДокумент) КАК КассовыйДокументОстатки
			ПО КассовыйДокументДолги.Ссылка = КассовыйДокументОстатки.ДокументОплаты
	ГДЕ
		КассовыйДокументОстатки.ОстатокДокумента > 0
		И КассовыйДокументДолги.Ссылка.ПометкаУдаления = ЛОЖЬ
		И КассовыйДокументДолги.Ссылка.Приход = ИСТИНА
		И КассовыйДокументДолги.Ссылка.ОтКого В(&amp;КонтрагентыОтбор)) КАК ДолгиОплаты

СГРУППИРОВАТЬ ПО
	ДолгиОплаты.ДокументДолг</queryText>
      <autoFillAvailableFields>true</autoFillAvailableFields>
      <customQuery>true</customQuery>
      <autoSaveUserSettings>true</autoSaveUserSettings>
      <getInvisibleFieldPresentations>true</getInvisibleFieldPresentations>
    </extInfo>
  </attributes>
  <attributes>
    <name>КонтрагентыОтбор</name>
    <title>
      <key>ru</key>
      <value>Контрагенты отбор</value>
    </title>
    <id>2</id>
    <valueType>
      <types>ValueList</types>
    </valueType>
    <view>
      <common>true</common>
    </view>
    <edit>
      <common>true</common>
    </edit>
    <extInfo xsi:type="form:ValueListExtInfo">
      <itemValueType/>
    </extInfo>
  </attributes>
  <commandInterface>
    <navigationPanel/>
    <commandBar/>
  </commandInterface>
  <extInfo xsi:type="form:DynamicListFormExtInfo"/>
</form:Form>
