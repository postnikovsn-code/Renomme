&НаСервере
Функция ОпределитьВидДеятельности(Вид) 
	Попытка
		Если Вид.Пустая() или Вид.Код="000000001" тогда
			Возврат "1) Основная деятельность";
		иначеесли Найти(Вид.Наименование,"Продукты")>0 или Найти(Вид.Наименование,"продукты")>0 тогда
			Возврат "2) Бар";
		иначеесли Найти(Вид.Наименование,"Транспорт")>0 тогда
			Возврат "3) Транспорт";
		иначе
			Возврат "4) Другое";
		конецесли;
	Исключение
		Возврат "1 Основная деятельность";
	КонецПопытки;
	
