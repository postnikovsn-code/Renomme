Функция РасчитатьДолг(Бронь) Экспорт

ЗапросДолга=Новый запрос("ВЫБРАТЬ
                         |	ЕСТЬNULL(ПроживаниеСумма.Сумма, 0) КАК СуммаПроживание,
                         |	ЕСТЬNULL(Услуги.Сумма, 0) КАК СуммаУслуги,
                         |	ЕСТЬNULL(Оплаты.СуммаРаспределено, 0) КАК СуммаРаспределено,
                         |	ЕСТЬNULL(ПроживаниеСумма.Сумма, 0) + ЕСТЬNULL(Услуги.Сумма, 0) - ЕСТЬNULL(Оплаты.СуммаРаспределено, 0) КАК СуммаДолг
                         |ИЗ
                         |	Документ.ЗаявкаНаБронирование КАК ЗаявкаНаБронирование
                         |		ЛЕВОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
                         |			ЗаявкаНаБронированиеПроживание.Ссылка КАК Ссылка,
                         |			СУММА(ЗаявкаНаБронированиеПроживание.Сумма) КАК Сумма
                         |		ИЗ
                         |			Документ.ЗаявкаНаБронирование.Проживание КАК ЗаявкаНаБронированиеПроживание
                         |		
                         |		СГРУППИРОВАТЬ ПО
                         |			ЗаявкаНаБронированиеПроживание.Ссылка) КАК ПроживаниеСумма
                         |		ПО ЗаявкаНаБронирование.Ссылка = ПроживаниеСумма.Ссылка
                         |		ЛЕВОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
                         |			ЗаявкаНаБронированиеДопУслуги.Ссылка КАК Ссылка,
                         |			СУММА(ЗаявкаНаБронированиеДопУслуги.Цена * ЗаявкаНаБронированиеДопУслуги.Количество) КАК Сумма
                         |		ИЗ
                         |			Документ.ЗаявкаНаБронирование.ДопУслуги КАК ЗаявкаНаБронированиеДопУслуги
                         |		ГДЕ
                         |			ЗаявкаНаБронированиеДопУслуги.ВСчет = ИСТИНА
                         |		
                         |		СГРУППИРОВАТЬ ПО
                         |			ЗаявкаНаБронированиеДопУслуги.Ссылка) КАК Услуги
                         |		ПО ЗаявкаНаБронирование.Ссылка = Услуги.Ссылка
                         |		ЛЕВОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
                         |			ЗаявкаНаБронированиеСчетаДетальноОплаты.Ссылка КАК Ссылка,
                         |			СУММА(ЗаявкаНаБронированиеСчетаДетальноОплаты.СуммаРаспределено) КАК СуммаРаспределено
                         |		ИЗ
                         |			Документ.ЗаявкаНаБронирование.СчетаДетальноОплаты КАК ЗаявкаНаБронированиеСчетаДетальноОплаты
                         |		
                         |		СГРУППИРОВАТЬ ПО
                         |			ЗаявкаНаБронированиеСчетаДетальноОплаты.Ссылка) КАК Оплаты
                         |		ПО ЗаявкаНаБронирование.Ссылка = Оплаты.Ссылка
                         |ГДЕ
                         |	ЗаявкаНаБронирование.Ссылка = &Ссылка");

ЗапросДолга.УстановитьПараметр("Ссылка",Бронь.Ссылка);
//	 ЗапросДолга.УстановитьПараметр("ДТ",Дата);
ТЗДолг=ЗапросДолга.Выполнить().Выгрузить();
Долг=ТЗДолг[0].СуммаДолг;

Возврат Долг;
КонецФункции
