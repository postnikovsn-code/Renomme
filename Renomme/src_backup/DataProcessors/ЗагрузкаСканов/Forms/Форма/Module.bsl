&НаКлиенте
Процедура ПрикрепитьФотоДействие()
Счетчик = 0;

//КаталогБаза = ОбщийФункционалСервер.ПолучитьЗначениеКонстанты("Папка_C_BASE");
//КаталогПриемник = КаталогБаза + "SCAN\";
//КаталогАрхив = КаталогБаза + "SCAN_АРХИВ\";

КаталогПриемник = СлужебныеСервер.КаталогСканов();
КаталогАрхив = СлужебныеСервер.КаталогСкановАрхив();

МассивКУдалению = Новый Массив;
Для Каждого СтрФото Из Объект.СканыДокументов Цикл
	Если НЕ СтрФото.Клиент.Пустая() тогда
		
		Файл = Новый Файл(СтрФото.ПутьДоФото);
		ГУИДКлиентаСтрока = ГУИДКлиентаСтрока(СтрФото.Клиент);
		
		ПутьДоФото = ПереместитьФайлВПутьДоФото(Файл, КаталогПриемник, ГУИДКлиентаСтрока, КаталогАрхив);   
		Если ПутьДоФото = Неопределено Тогда
			Сообщить("Ошибка перемещения файла " + Файл.ПолноеИмя);
			
			Продолжить;
		КонецЕсли;
		
		ЗаписатьКлиентСканыДокументов(Счетчик, ПутьДоФото);
		
		МассивКУдалению.Добавить(СтрФото);

		Если НЕ ЕстьФормаКлиента(СтрФото.Клиент) Тогда 
			ПараметрФормы = Новый Структура("Ключ", СтрФото.Клиент);
			
			ОткрытьФорму("Справочник.Клиенты.Форма.ФормаЭлемента", ПараметрФормы, ЭтаФорма);
		КонецЕсли;		
	КонецЕсли;
	
	Счетчик = Счетчик + 1; 
КонецЦикла;

Для Каждого Строка Из МассивКУдалению Цикл
	Объект.СканыДокументов.Удалить(Строка);
КонецЦикла;
КонецПроцедуры

