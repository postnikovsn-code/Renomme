// HTTP-клиент сканера паспортов PassportBox.
// Перенесён из проекта "Паспорт" (CommonModule.PassportBox), адаптирован для конфигурации "ОТЕЛЬ":
// - Серверный модуль (без клиентских контекстов).
// - Удалена зависимость от Приложение_СеансПользователя_Сервер (кэш соединения не используется).
// - Удалены неиспользуемые внутренние функции (Взвесить).
// - Сохранены публичные API (Экспорт): СоздатьСоединение, ПолучитьРазворот23, ПолучитьРегистрацию,
//   РаспознатьДокумент, ПолучитьКартинку, СтрокаВДату.

#Область ПрограммныйИнтерфейс

// Создаёт "соединение" - структуру с параметрами для последующих вызовов.
//
// Параметры:
//   Адрес   - Строка - IP-адрес сканера.
//   Порт    - Число  - Порт HTTP (по умолчанию 80).
//   Таймаут - Число  - Таймаут HTTP-запроса в секундах (по умолчанию 30).
//
// Возвращаемое значение:
//   Структура - результат с полями:
//     * Параметры - Структура - { Адрес (Строка), Порт (Число), Таймаут (Число) }.
//     * Ошибка    - Булево    - признак ошибки.
//     * Описание  - Строка    - текст ошибки.
Функция СоздатьСоединение(Знач Адрес, Знач Порт = 80, Знач Таймаут = 30) Экспорт
	Попытка
		Параметры = Новый Структура;
		Параметры.Вставить("Адрес", Адрес);
		Параметры.Вставить("Порт", Порт);
		Параметры.Вставить("Таймаут", Таймаут);
		Результат = Новый Структура;
		Результат.Вставить("Параметры", Параметры);
		Результат.Вставить("Ошибка", Ложь);
		Результат.Вставить("Описание", "");
		Возврат Результат;
	Исключение
		Возврат НоваяОшибка(ОписаниеОшибки());
	КонецПопытки;
КонецФункции

// Распознаёт разворот 2-3 паспорта РФ. Параметры подключения берутся из настроек
// сканера (НастройкиСервер.PassportBoxНастройки); соединение строится внутри.
//
// Возвращаемое значение:
//   Структура - результат с полями:
//     * Ошибка     - Булево    - признак ошибки.
//     * Описание   - Строка    - текст ошибки.
//     * Реквизиты  - Структура - { Серия, Номер, ДатаВыдачи, КодПодразделения,
//                                   НазваниеПодразделения, Фамилия, Имя, Отчество, Пол,
//                                   ДатаРождения, МестоРождения } - все Строка.
//     * Фотографии - Структура - { Страница2, Страница3 } - ДвоичныеДанные.
Функция ПолучитьРазворот23() Экспорт
	Попытка
		Соединение = ПолучитьСоединениеПоНастройкам();
		Если Соединение.Ошибка Тогда
			Возврат Соединение;
		КонецЕсли;
		ОтветРаспознавания = РаспознатьДокумент(Соединение);
		Если ОтветРаспознавания.Ошибка Тогда
			Возврат ОтветРаспознавания;
		КонецЕсли;
		Реквизиты = НоваяСтруктураРеквизитовПаспорта();
		// Источники в порядке возрастания приоритета: page3 < OCR разворота < MRZ.
		// Более приоритетное непустое значение перезаписывает менее приоритетное.
		ИсточникиСоответствий = Новый Массив;
		ИсточникиСоответствий.Добавить(СоответствиеПолейПаспортаPage3());
		ИсточникиСоответствий.Добавить(СоответствиеПолейПаспорта());
		ИсточникиСоответствий.Добавить(СоответствиеПолейПаспортаMRZ());
		ОшибкаЗаполнения = ЗаполнитьПоляИзJSON(
			Реквизиты,
			ИсточникиСоответствий,
			ОтветРаспознавания.ДанныеJSON.fields,
			"rus.passport.national");
		Если ОшибкаЗаполнения <> "" Тогда
			Возврат НоваяОшибка(ОшибкаЗаполнения);
		КонецЕсли;
		// Сканер возвращает ФИО прописными буквами; приводим к виду "Иванов Иван Иванович".
		// ТРег корректно обрабатывает составные фамилии через дефис (напр., "ПЕТРОВ-ВОДКИН").
		Реквизиты.Фамилия = ТРег(Реквизиты.Фамилия);
		Реквизиты.Имя = ТРег(Реквизиты.Имя);
		Реквизиты.Отчество = ТРег(Реквизиты.Отчество);
		ОшибкаПолей = ПроверитьОбязательныеПоля(Реквизиты, ОбязательныеПоляПаспорта());
		Если ОшибкаПолей <> "" Тогда
			Возврат НоваяОшибка(ОшибкаПолей);
		КонецЕсли;
		Фотографии = ПолучитьФотографииПаспорта(Соединение, ОтветРаспознавания.ДанныеJSON.images);
		Если Фотографии.Ошибка Тогда
			Возврат Фотографии;
		КонецЕсли;
		Возврат НовыйРезультатДанных(Реквизиты, Фотографии.Значение);
	Исключение
		Возврат НоваяОшибка("Ошибка: " + ОписаниеОшибки());
	КонецПопытки;
КонецФункции

// Распознаёт страницу регистрации паспорта РФ. Параметры подключения берутся из настроек
// сканера (НастройкиСервер.PassportBoxНастройки); соединение строится внутри.
//
// Возвращаемое значение:
//   Структура - результат с полями:
//     * Ошибка     - Булево    - признак ошибки.
//     * Описание   - Строка    - текст ошибки.
//     * Реквизиты  - Структура - { Регион, Город, Улица, Дом, Корпус, Квартира,
//                                   КодПодразделения, НазваниеПодразделения,
//                                   ДатаРегистрации } - все Строка.
//     * Фотографии - Структура - { Регистрация } - ДвоичныеДанные.
Функция ПолучитьРегистрацию() Экспорт
	Попытка
		Соединение = ПолучитьСоединениеПоНастройкам();
		Если Соединение.Ошибка Тогда
			Возврат Соединение;
		КонецЕсли;
		ОтветРаспознавания = РаспознатьДокумент(Соединение);
		Если ОтветРаспознавания.Ошибка Тогда
			Возврат ОтветРаспознавания;
		КонецЕсли;
		Реквизиты = НоваяСтруктураРеквизитовРегистрации();
		ИсточникиСоответствий = Новый Массив;
		ИсточникиСоответствий.Добавить(СоответствиеПолейРегистрации());
		ОшибкаЗаполнения = ЗаполнитьПоляИзJSON(
			Реквизиты,
			ИсточникиСоответствий,
			ОтветРаспознавания.ДанныеJSON.fields,
			"rus.passport.registration");
		Если ОшибкаЗаполнения <> "" Тогда
			Возврат НоваяОшибка(ОшибкаЗаполнения);
		КонецЕсли;
		ОшибкаПолей = ПроверитьОбязательныеПоля(Реквизиты, ОбязательныеПоляРегистрации());
		Если ОшибкаПолей <> "" Тогда
			Возврат НоваяОшибка(ОшибкаПолей);
		КонецЕсли;
		Фотография = ПолучитьФотографиюРегистрации(Соединение, ОтветРаспознавания.ДанныеJSON.images);
		Если Фотография.Ошибка Тогда
			Возврат Фотография;
		КонецЕсли;
		Возврат НовыйРезультатДанных(Реквизиты, Фотография.Значение);
	Исключение
		Возврат НоваяОшибка("Ошибка: " + ОписаниеОшибки());
	КонецПопытки;
КонецФункции

// Низкоуровневый запрос распознавания документа.
//
// Параметры:
//   Соединение - Структура - см. СоздатьСоединение.
//   Путь       - Строка    - путь HTTP (по умолчанию /CaptureDocument).
//                            Если задан явно - возвращаются двоичные данные картинки.
//
// Возвращаемое значение:
//   Структура - { ДанныеJSON, Ошибка, Описание } либо { Ошибка, Описание }.
Функция РаспознатьДокумент(Знач Соединение, Знач Путь = Неопределено) Экспорт
	Попытка
		Если ТипЗнч(Соединение) <> Тип("Структура") Тогда
			ВызватьИсключение "PassportBoxВызовСервера.РаспознатьДокумент: ожидается тип Структура для параметра Соединение";
		КонецЕсли;
		Картинка = Истина;
		Если Путь = Неопределено Тогда
			Путь = "/CaptureDocument";
			Картинка = Ложь;
		КонецЕсли;
		Данные = ВыполнитьЗапрос(Соединение, Путь, Картинка);
		ОбъектОшибка = Неопределено;
		Если ТипЗнч(Данные) = Тип("Структура") И Данные.Свойство("error", ОбъектОшибка) Тогда
			Результат = Новый Структура;
			Результат.Вставить("Ошибка", ОбъектОшибка.Code);
			Результат.Вставить("Описание", ОбъектОшибка.message);
			Возврат Результат;
		КонецЕсли;
		Результат = Новый Структура;
		Результат.Вставить("ДанныеJSON", Данные);
		Результат.Вставить("Ошибка", Ложь);
		Результат.Вставить("Описание", "");
		Возврат Результат;
	Исключение
		Возврат НоваяОшибка(ОписаниеОшибки());
	КонецПопытки;
КонецФункции

// Получает картинку (двоичные данные) от сканера по имени.
//
// Параметры:
//   Соединение  - Структура - см. СоздатьСоединение.
//   ИмяКартинки - Строка    - "Snapshot" для произвольного снимка,
//                             иначе - конкретное имя из ответа РаспознатьДокумент (поле images).
//
// Возвращаемое значение:
//   Структура - { ДанныеКартинки (ДвоичныеДанные), Ошибка (Булево), Описание (Строка) }.
Функция ПолучитьКартинку(Знач Соединение, Знач ИмяКартинки) Экспорт
	Попытка
		Если ТипЗнч(Соединение) <> Тип("Структура") Тогда
			ВызватьИсключение "PassportBoxВызовСервера.ПолучитьКартинку: ожидается тип Структура для параметра Соединение";
		КонецЕсли;
		Если ИмяКартинки = "Snapshot" Тогда
			Путь = "/TakeSnapshot";
		Иначе
			Путь = "/Image?name=" + ИмяКартинки;
		КонецЕсли;
		Данные = ВыполнитьЗапрос(Соединение, Путь, Истина);
		Результат = Новый Структура;
		Результат.Вставить("ДанныеКартинки", Данные);
		Результат.Вставить("Ошибка", Ложь);
		Результат.Вставить("Описание", "");
		Возврат Результат;
	Исключение
		Возврат НоваяОшибка(ОписаниеОшибки());
	КонецПопытки;
КонецФункции

// Парсер строкового представления даты в формате "ДД.ММ.ГГГГ" / "ДД.ММ.ГГ" - как возвращает PassportBox.
//
// Параметры:
//   ДатаСтрока - Строка - исходное представление даты.
//
// Возвращаемое значение:
//   Дата - распарсенная дата, либо пустая дата при некорректном вводе.
Функция СтрокаВДату(Знач ДатаСтрока) Экспорт
	ПозицияПробела = СтрНайти(ДатаСтрока, " ", НаправлениеПоиска.СНачала);
	Если ПозицияПробела > 0 Тогда
		ДатаСтрока = Лев(ДатаСтрока, ПозицияПробела - 1);
	КонецЕсли;
	ДатаСтрока = СокрЛП(СтрЗаменить(ДатаСтрока, ".", ""));
	// BSLLS:MagicNumber-off
	// Перестановка позиций "ДДММГГ[ГГ]" -> "ГГ[ГГ]ММДД" для приведения к Дате через ОписаниеТипов.
	ДатаСтрока = Сред(ДатаСтрока, 5) + Сред(ДатаСтрока, 3, 2) + Лев(ДатаСтрока, 2);
	Если СтрДлина(ДатаСтрока) = 6 Тогда
		ДатаСтрока = "20" + ДатаСтрока;
	КонецЕсли;
	// BSLLS:MagicNumber-on
	ОписаниеТипа = Новый ОписаниеТипов("Дата");
	Возврат ОписаниеТипа.ПривестиЗначение(ДатаСтрока);
КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Строит соединение со сканером по сохранённым настройкам (константы PassportBox*
// через НастройкиСервер.PassportBoxНастройки). Проверяет активность и заполненность IP.
//
// Возвращаемое значение:
//   Структура - см. СоздатьСоединение; при ошибке Ошибка = Истина и заполнено Описание.
Функция ПолучитьСоединениеПоНастройкам()
	Настройки = PassportBox_Настройки.PassportBoxНастройки();
	Если НЕ Настройки.Активность Тогда
		Возврат НоваяОшибка("Сканер паспортов не активирован в настройках. Откройте обработку «Настройки сканера PassportBox» и включите.");
	КонецЕсли;
	Если НЕ ЗначениеЗаполнено(Настройки.IP) Тогда
		Возврат НоваяОшибка("Не задан IP сканера PassportBox. Откройте обработку «Настройки сканера PassportBox».");
	КонецЕсли;
	Возврат СоздатьСоединение(Настройки.IP, Настройки.Порт, Настройки.Таймаут);
КонецФункции

// Выполняет HTTP-запрос к сканеру и возвращает результат (JSON-данные или двоичные данные картинки).
//
// Параметры:
//   Соединение - Структура - см. СоздатьСоединение.
//   Путь       - Строка    - путь HTTP-запроса.
//   Картинка   - Булево    - Истина = вернуть тело как ДвоичныеДанные, Ложь = распарсить JSON.
//
// Возвращаемое значение:
//   Произвольный - либо ДвоичныеДанные (если Картинка = Истина),
//                  либо распарсенный JSON (Структура/Соответствие/Массив).
Функция ВыполнитьЗапрос(Соединение, Путь, Картинка)
	Таймаут = ТаймаутСоединения(Соединение);
	HTTP = Новый HTTPСоединение(
		Соединение.Параметры.Адрес,
		Соединение.Параметры.Порт,
		,
		,
		,
		Таймаут);
	Заголовки = Новый Соответствие;
	ЗапросHTTP = Новый HTTPЗапрос(Путь, Заголовки);
	Заголовки.Вставить("Content-Type", "application/x-www-form-urlencoded");
	Если Картинка Тогда
		Заголовки.Вставить("Content-Encoding", "base64");
	КонецЕсли;
	ОтветHTTP = HTTP.Получить(ЗапросHTTP);
	Если Картинка Тогда
		Возврат ОтветHTTP.ПолучитьТелоКакДвоичныеДанные();
	КонецЕсли;
	Стр = ОтветHTTP.ПолучитьТелоКакСтроку();
	ЧтениеJSON = Новый ЧтениеJSON();
	ЧтениеJSON.УстановитьСтроку(Стр);
	Результат = ПрочитатьJSON(ЧтениеJSON);
	ЧтениеJSON.Закрыть();
	Возврат Результат;
КонецФункции

// Возвращает таймаут (в секундах) из параметров соединения; по умолчанию 30.
//
// Параметры:
//   Соединение - Структура - см. СоздатьСоединение.
//
// Возвращаемое значение:
//   Число - таймаут в секундах.
Функция ТаймаутСоединения(Знач Соединение)
	ТаймаутПоУмолчанию = 30; // BSLLS:MagicNumber-off
	Если Соединение.Параметры.Свойство("Таймаут") И Соединение.Параметры.Таймаут > 0 Тогда
		Возврат Соединение.Параметры.Таймаут;
	КонецЕсли;
	Возврат ТаймаутПоУмолчанию;
КонецФункции

// Возвращает заготовку структуры реквизитов паспорта со всеми пустыми значениями.
//
// Возвращаемое значение:
//   Структура - реквизиты паспорта (см. ПолучитьРазворот23).
Функция НоваяСтруктураРеквизитовПаспорта()
	Реквизиты = Новый Структура;
	Реквизиты.Вставить("Серия", "");
	Реквизиты.Вставить("Номер", "");
	Реквизиты.Вставить("ДатаВыдачи", "");
	Реквизиты.Вставить("КодПодразделения", "");
	Реквизиты.Вставить("НазваниеПодразделения", "");
	Реквизиты.Вставить("Фамилия", "");
	Реквизиты.Вставить("Имя", "");
	Реквизиты.Вставить("Отчество", "");
	Реквизиты.Вставить("Пол", "");
	Реквизиты.Вставить("ДатаРождения", "");
	Реквизиты.Вставить("МестоРождения", "");
	Возврат Реквизиты;
КонецФункции

// Возвращает заготовку структуры реквизитов регистрации со всеми пустыми значениями.
//
// Возвращаемое значение:
//   Структура - реквизиты регистрации (см. ПолучитьРегистрацию).
Функция НоваяСтруктураРеквизитовРегистрации()
	Реквизиты = Новый Структура;
	Реквизиты.Вставить("Регион", "");
	Реквизиты.Вставить("Город", "");
	Реквизиты.Вставить("Улица", "");
	Реквизиты.Вставить("Дом", "");
	Реквизиты.Вставить("Корпус", "");
	Реквизиты.Вставить("Квартира", "");
	Реквизиты.Вставить("КодПодразделения", "");
	Реквизиты.Вставить("НазваниеПодразделения", "");
	Реквизиты.Вставить("ДатаРегистрации", "");
	Возврат Реквизиты;
КонецФункции

// Соответствие "json-ключ" -> "ключ структуры реквизитов" для паспорта.
//
// Возвращаемое значение:
//   Соответствие - { Ключ (Строка json) - Значение (Строка ключ реквизита) }.
Функция СоответствиеПолейПаспорта()
	Карта = Новый Соответствие;
	Карта.Вставить("series", "Серия");
	Карта.Вставить("number", "Номер");
	Карта.Вставить("issue_date", "ДатаВыдачи");
	Карта.Вставить("authority_code", "КодПодразделения");
	Карта.Вставить("authority", "НазваниеПодразделения");
	Карта.Вставить("surname", "Фамилия");
	Карта.Вставить("name", "Имя");
