Функция ТоварКлиент_Олд(ДокументДолгСсылка, Счет) Экспорт
Если ДокументДолгСсылка.Оплачивает.Турагентство Тогда
	Клиент = ДокументДолгСсылка.Клиент;	
	Клиент2 = ДокументДолгСсылка.Клиент2;
Иначе
	Если Счет.РазделитьСчет Тогда
		Клиент = Счет.Клиент;	
		Клиент2 = ДокументДолгСсылка.Клиент2;
	Иначе
		Клиент = Счет.Клиент;	
		Клиент2 = Неопределено;
	КонецЕсли;
КонецЕсли;

ТоварКлиент = "" + Клиент;
Если ЗначениеЗаполнено(Клиент2) Тогда 
	Если Клиент <> Клиент2 Тогда 
		ТоварКлиент = ТоварКлиент + ", " + Клиент2;
	КонецЕсли;
КонецЕсли;

Возврат ТоварКлиент;
КонецФункции

Функция НаименованиеДляДокумента(Строка)
Если Строка.Услуга Тогда	
	НаименованиеДляДокумента = ?(ЗначениеЗаполнено(Строка.НазваниеДляЧека), Строка.НазваниеДляЧека
					       , Строка.НаименованиеДолг) + " " + Формат(Строка.ДатаДолг, "ДФ=dd.MM.yy");
Иначе
	ДатаПо = Строка.ДатаДолг + 24 * 60 * 60;						   
	//НаименованиеДляДокумента = "Проживание с " + Формат(Строка.ДатаДолг, "ДФ=dd.MM.yy") + " по " + Формат(ДатаПо, "ДФ=dd.MM.yy") 					   
	НаименованиеДляДокумента = "Услуги по предоставлению мест для временного проживания в гостинице" + " с " + Формат(Строка.ДатаДолг, "ДФ=dd.MM.yy") + " по " + Формат(ДатаПо, "ДФ=dd.MM.yy"); 					   
КонецЕсли;	
Возврат НаименованиеДляДокумента;
КонецФункции

Функция ИтогиЗаявка(СчетаДетальноДолги, СтавкаНДС, ВсеСНДС)
СуммаПроживание = 0;
КоличествоПроживание = 0;
СуммаУслуги = 0;
СуммаНДС = 0;

ДатаС_Проживание = '30010101';
ДатаПо_Проживание = '00010101';

ДатаС_Услуги = '30010101';
ДатаПо_Услуги = '00010101';

ЕстьНДС0 = Ложь;
ЕстьНДСНе0 = Ложь;
Для Каждого Строка Из СчетаДетальноДолги Цикл
	Если Строка.Услуга Тогда
		Если Строка.ПрограммныйКодУслуги = Перечисления.ПрограммныйКодУслуги.ПРОЖИВАНИЕ_УСЛУГИ Тогда
			СуммаПроживание = СуммаПроживание + Строка.СуммаДолг;
			
			Если ВсеСНДС Тогда
				СуммаНДС = СуммаНДС + ДокументыСервер.СуммаНДС(СтавкаНДС, Строка.СуммаДолг);
			КонецЕсли;
			
			ЕстьНДС0 = Истина;
		Иначе
			СуммаУслуги = СуммаУслуги + Строка.СуммаДолг;
			СуммаНДС = СуммаНДС + ДокументыСервер.СуммаНДС(СтавкаНДС, Строка.СуммаДолг);
			
			ЕстьНДСНе0 = Истина;
		КонецЕсли;
		
		ДатаС_Услуги = Мин(ДатаС_Услуги, Строка.ДатаДолг); 
		ДатаПо_Услуги = Макс(ДатаПо_Услуги, Строка.ДатаДолг); 
		
	Иначе
		ДатаС_Проживание = Мин(ДатаС_Проживание, Строка.ДатаДолг); 
		ДатаПо_Проживание = Макс(ДатаПо_Проживание, Строка.ДатаДолг); 
		
		СуммаПроживание = СуммаПроживание + Строка.СуммаДолг;
		КоличествоПроживание = КоличествоПроживание + Строка.Количество;
		
		Если ВсеСНДС Тогда
			СуммаНДС = СуммаНДС + ДокументыСервер.СуммаНДС(СтавкаНДС, Строка.СуммаДолг);
		КонецЕсли;
		
		ЕстьНДС0 = Истина;
	КонецЕсли;		
КонецЦикла;

Если ДатаС_Проживание = '30010101' Тогда ДатаС_Проживание = '00010101'; КонецЕсли;
Если ДатаС_Услуги = '30010101' Тогда ДатаС_Услуги = '00010101'; КонецЕсли;

Возврат Новый Структура("СуммаПроживание, КоличествоПроживание, СуммаУслуги, СуммаНДС" 
					+ ", ДатаС_Проживание, ДатаПо_Проживание, ДатаС_Услуги, ДатаПо_Услуги"
					+ ", ЕстьНДС0, ЕстьНДСНе0"
						, СуммаПроживание, КоличествоПроживание, СуммаУслуги, СуммаНДС
						, ДатаС_Проживание, ДатаПо_Проживание, ДатаС_Услуги, ДатаПо_Услуги						
						, ЕстьНДС0, ЕстьНДСНе0
						);
КонецФункции
