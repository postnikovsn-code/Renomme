&НаСервере
Процедура РасчитатьСтрокаЗарплатаСменыСмена(Строка, Имя_Право)
Администратор = Строка.Администратор;

//
ПереработкаЧасы = Строка["ПереработкаЧасы_" + Имя_Право];	
СуммаПереработка = СуммаПереработкаЗаСмену(Администратор, ПереработкаЧасы);
//Имя_П = "СуммаПереработка_" + Имя_Право;
//Строка[Имя_П] = СуммаПереработка; 
//

ДатаСмены = Строка["Дата_" + Имя_Право];

ИмяНомерСмены = "НомерСмены_" + Имя_Право;
НомерСмены = Строка[ИмяНомерСмены];	

//
ИмяДлинаСмены = "ДлинаСмены_" + Имя_Право;
ДлинаСмены = Строка[ИмяДлинаСмены];	

Строка["Часы_" + Имя_Право] = Строка_0(ДлинаСмены, 2) + "-" + Строка_0(НомерСмены, 1) + "/" + Строка_0(ПереработкаЧасы, 2);  

~ВЫХОД:
КонецПроцедуры

&НаСервере
Функция Строка_0(Число, Длина)
Строка = Строка(Число);  	
Длина_0 = Длина - СтрДлина(Строка); 
Если Длина_0 > 0 Тогда
	Результат = "";
	Для Счетчик = 1 По Длина_0 Цикл
		Результат = Результат + "0";
	КонецЦикла;
	
	Строка = Строка + Результат;
КонецЕсли;

Возврат Строка;
КонецФункции

