Функция ПроверкаЗаполнения()
ТекстСообщения = ДокументыСервер.ПроверкаЗаполненияЗаявкаНабронированиеТекстСообщения(ЭтотОбъект, " ");
Если ТекстСообщения <> "" Тогда
	ТекстСообщения = ТекстСообщения + "ЗАПИСЬ ОТМЕНЯЕТСЯ."; 

	Сообщить(ТекстСообщения);
	Возврат Ложь;
КонецЕсли;	

Возврат Истина;	
КонецФункции
