&НаКлиенте
Функция ПереместитьКонтрагентаИзАрхива(Контрагент, Элемент)
Если НЕ ЭтоАрхивКонтрагентов(Контрагент) Тогда Возврат Ложь; КонецЕсли;	
	
ПараметрыФормы = Новый Структура();		
ПараметрыФормы.Вставить("Ключ", Контрагент); 

ДопПараметры = Новый Структура();
ДопПараметры.Вставить("Элемент", Элемент); 

Оповещение = Новый ОписаниеОповещения("ЗавершениеФормы_ФормаПеремещениеКлиента", ЭтаФорма, ДопПараметры);
ОткрытьФорму("Справочник.Клиенты.Форма.ФормаПеремещениеКлиента", ПараметрыФормы, ЭтаФорма
	,,,, Оповещение, РежимОткрытияОкнаФормы.БлокироватьВесьИнтерфейс);
	
Возврат Истина;	
КонецФункции

&НаКлиенте
Процедура ЗавершениеФормы_ФормаПеремещениеКлиента(Результат, ДополнительныеПараметры) Экспорт
Элемент = ДополнительныеПараметры.Элемент;

ЭлементИмя = Элемент.Имя;
Если ЭлементИмя = "Бронирует" Тогда
	БронируетПриИзмененииОбработка(Элемент);		
ИначеЕсли ЭлементИмя = "Клиент" Тогда
	КлиентПриИзмененииОбработка(Элемент)
ИначеЕсли ЭлементИмя = "Клиент2" Тогда
	Клиент2ПриИзмененииОбработка(Элемент)
ИначеЕсли ЭлементИмя = "Оплачивает" Тогда
	ОплачиваетПриИзмененииОбработка(Элемент)
КонецЕсли;	
КонецПроцедуры

&НаСервере
Функция ЭтоАрхивКонтрагентов(Контрагент)
Родитель = Контрагент.Родитель;
Если Родитель = Справочники.Клиенты.ПустаяСсылка() Тогда Возврат Ложь; КонецЕсли;

Пока Истина Цикл
	Если Родитель = Справочники.Клиенты.ПустаяСсылка() Тогда Возврат Ложь; КонецЕсли;
	РодительНаименование = ВРег(Родитель.Наименование);
	Индекс = СтрНайти(РодительНаименование, "АРХИВ");
	Если Индекс > 0 Тогда Возврат Истина; КонецЕсли; 
	
	Родитель = Родитель.Родитель;
КонецЦикла
	
КонецФункции
