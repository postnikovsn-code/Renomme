
Функция ПрошлыйПериодДопУслуги_ТекстЗапроса() Экспорт
ТекстЗапроса = "ВЫБРАТЬ
               |	ТЗ.ПрочиеОплатыДокументОплаты КАК ДокументОплаты,
               |	ТЗ.ПрочиеОплатыДокументДолг КАК ДокументДолг,
               |	ТЗ.Сумма КАК Сумма
               |ПОМЕСТИТЬ ТЗ
               |ИЗ
               |	&ТЗ КАК ТЗ
               |;
               |
               |////////////////////////////////////////////////////////////////////////////////
               |ВЫБРАТЬ
               |	ПрочиеОплаты.Ссылка КАК ДокументОплаты,
               |	Долги.ДокументДолг КАК ДокументДолг,
               |	Долги.ДокументДолг.РезервПо КАК ДатаДолга,
               |	ЕСТЬNULL(Закрыто.СуммаЗакрыто, 0) КАК СуммаЗакрыто,
               |	ЕСТЬNULL(Долги.Сумма, 0) КАК СуммаДолга,
               |	ЕСТЬNULL(ТЗ.Сумма, 0) КАК СуммаТекущая,
               |	ЕСТЬNULL(Долги.Сумма, 0) - ЕСТЬNULL(Закрыто.СуммаЗакрыто, 0) - ЕСТЬNULL(ТЗ.Сумма, 0) КАК СуммаКЗакрытию
               |ИЗ
               |	Документ.ПрочиеОплаты КАК ПрочиеОплаты
               |		ВНУТРЕННЕЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
               |			ПрочиеОплатыДолгиОплата.Ссылка КАК Ссылка,
               |			ПрочиеОплатыДолгиОплата.ДокументДолг КАК ДокументДолг,
               |			СУММА(ПрочиеОплатыДолгиОплата.Сумма) КАК Сумма
               |		ИЗ
               |			Документ.ПрочиеОплаты.ДолгиОплата КАК ПрочиеОплатыДолгиОплата
               |		ГДЕ
               |			ТИПЗНАЧЕНИЯ(ПрочиеОплатыДолгиОплата.ДокументДолг) = ТИП(Документ.ЗаявкаНаБронирование)
               |		
               |		СГРУППИРОВАТЬ ПО
               |			ПрочиеОплатыДолгиОплата.Ссылка,
               |			ПрочиеОплатыДолгиОплата.ДокументДолг) КАК Долги
               |		ПО ПрочиеОплаты.Ссылка = Долги.Ссылка
               |		ЛЕВОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
               |			ПрочиеОплатыДолгиЗакрыто.Ссылка КАК Ссылка,
               |			ПрочиеОплатыДолгиЗакрыто.ДокументДолг КАК ДокументДолг,
               |			СУММА(ПрочиеОплатыДолгиЗакрыто.СуммаЗакрыто) КАК СуммаЗакрыто
               |		ИЗ
               |			Документ.ПрочиеОплаты.ДолгиЗакрыто КАК ПрочиеОплатыДолгиЗакрыто
               |		
               |		СГРУППИРОВАТЬ ПО
               |			ПрочиеОплатыДолгиЗакрыто.Ссылка,
               |			ПрочиеОплатыДолгиЗакрыто.ДокументДолг) КАК Закрыто
               |		ПО ПрочиеОплаты.Ссылка = Закрыто.Ссылка
               |		ЛЕВОЕ СОЕДИНЕНИЕ ТЗ КАК ТЗ
               |		ПО ПрочиеОплаты.Ссылка = ТЗ.ДокументОплаты
               |ГДЕ
               |	ПрочиеОплаты.ПометкаУдаления = ЛОЖЬ
               |	И ПрочиеОплаты.Приход = ИСТИНА
               |	И ПрочиеОплаты.ВидОперации = ЗНАЧЕНИЕ(Справочник.ВидыОпераций.СписаниеДопУслуг)";
	
Возврат ТекстЗапроса;	
КонецФункции

//////// + Заявка на бронирование
Функция ТекущийСчетСтруктура(ТекущаяСтрока, Объект) Экспорт
Счет = Объект.Счета.НайтиПоИдентификатору(ТекущаяСтрока);
СчетСтруктура = ОбщийФункционалСервер.СтруктураИзТабличнаяЧастьДокумента("ЗаявкаНаБронирование", "Счета");
ОбщийФункционалСервер.СкопироватьДанныеВСтруктуру(СчетСтруктура, Счет);

Возврат СчетСтруктура;
КонецФункции	
//
Процедура ОбновитьСчетИзСчетНаОплату(Счет, ДанныеСчета, Объект) Экспорт
СчетГУИД = Счет.СчетГУИД;

//// + Счета 
ОтборСтроки = Новый Структура("СчетГУИД", СчетГУИД); 

НайденыСтроки = Объект.Счета.НайтиСтроки(ОтборСтроки);
Если НайденыСтроки.Количество() = 0 Тогда
	// Это новый счет
	СчетОбъекта = Объект.Счета.Добавить();
Иначе
	СчетОбъекта = НайденыСтроки[0];
КонецЕсли;	
ЗаполнитьЗначенияСвойств(СчетОбъекта, Счет); 
//// - Счета

// + Замена СчетаДетальноДолги, РаспределениеОплатДолги счета и СчетаДетальноОплаты из ДанныеСчета
СчетаДетальноДолги = ДанныеСчета.СчетаДетальноДолги;
РаспределениеОплатДолги = ДанныеСчета.РаспределениеОплатДолги;

СчетаДетальноДанныеСчета = ДанныеСчета.СчетаДетальноДолги;
СчетаДетальноРезультат = Объект.СчетаДетальноДолги;
ОтборСтроки = Новый Структура("СчетГУИД", СчетГУИД);
НайденныеСтроки = СчетаДетальноРезультат.НайтиСтроки(ОтборСтроки);
ОбщийФункционалСервер.УдалитьСтроки(СчетаДетальноРезультат, НайденныеСтроки);
ОбщийФункционалСервер.ДобавитьСтроки(СчетаДетальноРезультат, СчетаДетальноДанныеСчета);

СчетаДетальноДанныеСчета = ДанныеСчета.РаспределениеОплатДолги; 
СчетаДетальноРезультат = Объект.РаспределениеОплатДолги;
ОтборСтроки = Новый Структура("СчетГУИД", СчетГУИД);
НайденныеСтроки = СчетаДетальноРезультат.НайтиСтроки(ОтборСтроки);
ОбщийФункционалСервер.УдалитьСтроки(СчетаДетальноРезультат, НайденныеСтроки);
ОбщийФункционалСервер.ДобавитьСтроки(СчетаДетальноРезультат, СчетаДетальноДанныеСчета);

СчетаДетальноДанныеСчета = ДанныеСчета.СчетаДетальноОплаты; 
СчетаДетальноРезультат = Объект.СчетаДетальноОплаты;
Для Каждого Строка Из СчетаДетальноДанныеСчета Цикл
	ОтборСтроки = Новый Структура("ДокументОплаты", Строка.ДокументОплаты);   
	ОбщийФункционалСервер.УдалитьСтрокиОтборСтроки(ОтборСтроки, СчетаДетальноРезультат);
	
	НоваяСтрока = СчетаДетальноРезультат.Добавить();
	ЗаполнитьЗначенияСвойств(НоваяСтрока, Строка); 
КонецЦикла;
// - Замена СчетаДетальноДолги, РаспределениеОплатДолги счета и СчетаДетальноОплаты из ДанныеСчета

// + Обновление ДокументОплатыДолгОплата из ДанныеСчета.СчетаДетальноОплаты 
Для Каждого СтрокаОплаты Из ДанныеСчета.СчетаДетальноОплаты Цикл
	ДокументОплаты = СтрокаОплаты.ДокументОплаты;
	
	ОтборСтроки = Новый Структура("ДокументОплаты, СчетГУИД", ДокументОплаты, СчетГУИД);
	ТЗ = Объект.РаспределениеОплатДолги.Выгрузить(ОтборСтроки, "СуммаОплаты");
	СуммаОплаты = ТЗ.Итог("СуммаОплаты");
	
	ОплатыОбщееСервер.ДобавитьЗаменитьДокументОплатыДолгОплата(ДокументОплаты, Объект.Ссылка, СчетГУИД, СуммаОплаты, Истина);   
КонецЦикла;
// - Обновление ДокументОплатыДолгОплата из ДанныеСчета.СчетаДетальноОплаты 

// + Удаление УдаленныеОплаты 
Для Каждого Строка Из ДанныеСчета.УдаленныеОплаты Цикл
	ДокументОплаты = Строка.ДокументОплаты;
	
	ОтборСтроки = Новый Структура("ДокументОплаты", ДокументОплаты);   
	ОбщийФункционалСервер.УдалитьСтрокиОтборСтроки(ОтборСтроки, Объект.СчетаДетальноОплаты);
			
	ОплатыОбщееСервер.УдалитьДокументОплатыДолгОплатыИДокументОплаты(ДокументОплаты, Объект.Ссылка, СчетГУИД);   
КонецЦикла;
// - Удаление УдаленныеОплаты 

// + Удаление пустого счета 
Если ДанныеСчета.СчетаДетальноДолги.Количество() = 0 Тогда
	ОтборСтроки = Новый Структура("СчетГУИД", СчетГУИД); 
	НайденыСтроки = Объект.Счета.НайтиСтроки(ОтборСтроки);
	ОбщийФункционалСервер.УдалитьСтроки(Объект.Счета, НайденыСтроки); 
КонецЕсли;
// - Удаление пустого счета 

//Закрыт = ОбщийМодульОплатыСервер.СчетЗакрыт(Объект.СчетаДетальноДолги, СчетГУИД);
//СчетОбъекта.Закрыт = Закрыт;
КонецПроцедуры

Функция ОбновитьСчетЗаявка(Счет, ТекущийОбъект, ОбновитьСчет) Экспорт 
Результат = Ложь;

Если ОбновитьСчет Тогда
	ДополнительныеСтрокиДетальноДолги = ЗаявкаСервер.ДополнительныеСтрокиДетальноДолги(Ложь
		, ТекущийОбъект, Счет, ТекущийОбъект.СчетаДетальноДолги, Ложь);
		
	ОбщийФункционалСервер.ДобавитьСтроки(ТекущийОбъект.СчетаДетальноДолги, ДополнительныеСтрокиДетальноДолги); 
	
	Результат = (ДополнительныеСтрокиДетальноДолги.Количество() = 0); 
КонецЕсли;

// + Получить МассивОплат счета (СчетГУИД)
СчетГУИД = Счет.СчетГУИД;
ОтборОплаты = Новый Структура("СчетГУИД", СчетГУИД);
Оплаты = ТекущийОбъект.РаспределениеОплатДолги.Выгрузить(ОтборОплаты, "ДокументОплаты");
Оплаты.Свернуть("ДокументОплаты");

МассивОплат = Новый Массив;
Для Каждого Строка Из Оплаты Цикл
	ОтборСтроки = Новый Структура("ДокументОплаты", Строка.ДокументОплаты);
	НайденныеСтроки = ТекущийОбъект.СчетаДетальноОплаты.НайтиСтроки(ОтборСтроки);
	Для Каждого НайленнаяСтрока Из НайденныеСтроки Цикл
		МассивОплат.Добавить(НайленнаяСтрока);		
	КонецЦикла;
КонецЦикла;
// - Получить МассивОплат счета (СчетГУИД)

//// + Очистка СчетаДетальноДолги, Строки оплат Массива Оплат, 
РаспределениеОплатДолги = ТекущийОбъект.РаспределениеОплатДолги;
// + Очистка сумм СчетаДетальноДолги в части СчетГУИД
Для Каждого СтрокаОплаты Из МассивОплат Цикл
	ОтборСтрокиОплаты = Новый Структура("ДокументОплаты, СчетГУИД", СтрокаОплаты.ДокументОплаты, Счет.СчетГУИД);
	НайденыеСтрокиРаспределениеОплатДолги = РаспределениеОплатДолги.НайтиСтроки(ОтборСтрокиОплаты);

	Для Каждого НайденаяСтрокаРаспределениеОплатДолги Из НайденыеСтрокиРаспределениеОплатДолги Цикл
		ОтборСтрокиДолги = Новый Структура("ДолгиГУИД", НайденаяСтрокаРаспределениеОплатДолги.ДолгиГУИД);
		НайденныеСтрокиСчетаДетальноДолги = ТекущийОбъект.СчетаДетальноДолги.НайтиСтроки(ОтборСтрокиДолги); 
		
		Для Каждого НайденаяСтрокаСчетаДетальноДолги Из НайденныеСтрокиСчетаДетальноДолги Цикл
			НайденаяСтрокаСчетаДетальноДолги.СуммаОплачено = НайденаяСтрокаСчетаДетальноДолги.СуммаОплачено 
				- НайденаяСтрокаРаспределениеОплатДолги.СуммаОплаты;
				
			НайденаяСтрокаСчетаДетальноДолги.СуммаКЗакрытию = НайденаяСтрокаСчетаДетальноДолги.СуммаКЗакрытию 
				+ НайденаяСтрокаРаспределениеОплатДолги.СуммаОплаты;
		КонецЦикла;
	КонецЦикла;
КонецЦикла;
// - Очистка СчетаДетальноДолги в части СчетГУИД

// + Очистка сумм МассивОплат в части СчетГУИД, удаление РаспределениеОплатДолги в части СчетГУИД 
Для Каждого СтрокаОплаты Из МассивОплат Цикл
	ОтборСтрокиОплаты = Новый Структура("ДокументОплаты, СчетГУИД", СтрокаОплаты.ДокументОплаты, Счет.СчетГУИД);
	ЗаявкаСервер.ОчиститьСтрокаОплатыОтборСтроки(ОтборСтрокиОплаты, РаспределениеОплатДолги, СтрокаОплаты); 
КонецЦикла;
// - Очистка сумм МассивОплат в части СчетГУИД, удаление РаспределениеОплатДолги в части СчетГУИД 
//// + Очистка СчетаДетальноДолги, Строки оплат Массива Оплат, 

// + Распределить МассивОплат счета (СчетГУИД) на СчетаДетальноДолги счета (СчетГУИД)
ОтборСтроки = Новый Структура("СчетГУИД", СчетГУИД);
СчетаДетальноДолги = ТекущийОбъект.СчетаДетальноДолги.НайтиСтроки(ОтборСтроки); 
Для Каждого СтрокаОплаты Из МассивОплат Цикл
	Если СтрокаОплаты.ГрупповаяОплата Тогда Продолжить; КонецЕсли;
	
	ДокументОплаты = СтрокаОплаты.ДокументОплаты;
	
	ОплатаОстатокКРаспределению = ОплатыОбщееСервер.ОплатаОстатокКРаспределению(ДокументОплаты, ТекущийОбъект); 
	Если ОплатаОстатокКРаспределению = 0 Тогда Продолжить; КонецЕсли;

	СуммаКЗакрытию = 0;
	Для Каждого Строка из СчетаДетальноДолги Цикл
		СуммаКЗакрытию = СуммаКЗакрытию + Строка.СуммаКЗакрытию;
	КонецЦикла;
	
	//Если СуммаКЗакрытию = 0 Тогда Продолжить; КонецЕсли;
	
	Если ОплатаОстатокКРаспределению > СуммаКЗакрытию Тогда 
		СуммаОплаты = СуммаКЗакрытию;
	Иначе
		СуммаОплаты = ОплатаОстатокКРаспределению;
	КонецЕсли;

	ЗаявкаСервер.РаспределитьСтрокаОплатаСчетаДетальноДолги(СтрокаОплаты, СуммаОплаты, СчетаДетальноДолги
		, ТекущийОбъект.РаспределениеОплатДолги);
	
	Если СтрокаОплаты.СуммаРаспределено = 0 Тогда
		ОплатыОбщееСервер.УдалитьДокументОплатыДолгОплатыИДокументОплаты(ДокументОплаты, ТекущийОбъект.Ссылка, СчетГУИД);
	Иначе		
		ОплатыОбщееСервер.ДобавитьЗаменитьДокументОплатыДолгОплата(ДокументОплаты, ТекущийОбъект.Ссылка, СчетГУИД
			, СтрокаОплаты.СуммаРаспределено, Истина);
	КонецЕсли;	
КонецЦикла;
// - Распределить МассивОплат от контрагента счета (СчетГУИД) на СчетаДетальноДолги счета (СчетГУИД)

Если НЕ Счет.ТолькоУслуги Тогда 
	ОтборСтроки = Новый Структура("СчетГУИД", Счет.СчетГУИД);
	СчетаДетальноДолги = ТекущийОбъект.СчетаДетальноДолги.НайтиСтроки(ОтборСтроки); 
	НайденныеСтроки = ТекущийОбъект.Счета.НайтиСтроки(ОтборСтроки);
	ТекущийОбъектСчет = НайденныеСтроки[0];
	ЗаявкаСервер.ДатаСДатаПо(ТекущийОбъектСчет.ДатаС, ТекущийОбъектСчет.ДатаПо, СчетаДетальноДолги);	
КонецЕсли;

Возврат Результат;
КонецФункции
//

