&НаСервере
Функция ПолучитьМакетСправкаОПроживанииВДвоичныхДанных()
	Макет = ПечатьСервер.ПолучитьМакетДокументаЗаявкаНаБронирование("СправкаОПроживании");
	
	ИмяВрем = ПолучитьИмяВременногоФайла(".doc");
	Макет.Записать(ИмяВрем);
	
	МойДокументВДвоичныхДанных = Новый ДвоичныеДанные(ИмяВрем);
	Возврат МойДокументВДвоичныхДанных;			
КонецФункции

&НаСервере
Функция ПолучитьСтруктуруРеквизитовСправкаОПроживанииНаСервере()
Ответ = Новый Структура;

Ответ.Вставить("ИсходящийНомер", ИсходящийНомер);
Ответ.Вставить("ИсходящяяДата", Формат(Дата_По, "ДФ=dd.MM.yyyy"));

Ответ.Вставить("ФИО", Клиент.Наименование);
Ответ.Вставить("Дата_С", Формат(Дата_С, "ДФ=dd.MM.yyyy"));
Ответ.Вставить("Дата_По", Формат(Дата_По, "ДФ=dd.MM.yyyy"));
//Ответ.Вставить("Категория", КатегорияНомера.Наименование);
//Если КатегорияНомера.ТолькоОдноместный Тогда
//	Ответ.Вставить("ТипНомераМест", "одноместный");
//Иначе
//	Ответ.Вставить("ТипНомераМест", "двухместный");
//КонецЕсли;	
Ответ.Вставить("Отель", Отель);

Возврат Ответ;
КонецФункции	
