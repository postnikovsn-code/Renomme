&НаКлиенте
Функция ПечатьАнкетыВыполнить(ДляОтправки=Ложь)
	ТабДок = СформироватьАнкету();

	Если Не ДляОтправки тогда
		
		ТабДок.Показать();
		
	иначе
		//ИмяФ="C:\BASE\REP\Ank_"+?(Бронь.Пустая(),Формат(Дата, "ДФ=ddMMyyHHmm"),Бронь.Номер)+".xls";
		//ТабДок.Записать(ИмяФ,ТипФайлаТабличногоДокумента.XLS97);
		//Возврат ИмяФ;
		
		ИмяФ = ОбщийФункционалСервер.ПолучитьЗначениеКонстанты("Папка_C_BASE");
		БроньПустая = НЕ ЗначениеЗаполнено(Объект.Бронь);
		БроньНомер = ОбщийФункционалСервер.ПолучитьЗначениеРеквизитаНаСервере(Объект.Бронь, "Номер");
		
		ИмяФ =  ИмяФ + "REP\Ank_"+?(БроньПустая, Формат(Объект.Дата, "ДФ=ddMMyyHHmm"), БроньНомер)+".xls";
		
		//ТабДок.Записать(ИмяФ,ТипФайлаТабличногоДокумента.XLS97);
		ДопПараметры = Новый Структура("ИмяФ", ИмяФ); 
		Оповещение = Новый ОписаниеОповещения("ЗавершениеНачатьЗапись", ЭтаФорма, ДопПараметры);
		ТабДок.НачатьЗапись(Оповещение, ИмяФ, ТипФайлаТабличногоДокумента.XLS97);
		
		Возврат ИмяФ;
	конецесли;
	
	Возврат Неопределено;
КонецФункции

