/////// + Отправка СМС, СоздатьЗаданиеГорничной при измениии статуса
&НаКлиенте
Процедура ПослеЗаписи(ПараметрыЗаписи)
Если ТекстПредупрежденияПослеЗаписи <> "" Тогда
	 ПоказатьПредупреждение(, ТекстПредупрежденияПослеЗаписи); 
КонецЕсли;
	
ОбработкаСтатусаПослеЗаписи();

СсылкаСтатус_OldValue = Объект.Статус;
Статус_OldValue = Объект.Статус;

КатегорияНомера_OldValue = Объект.КатегорияНомера;

Если фл_ОтправитьСМС Тогда 
	фл_ОтправитьСМС = Ложь; 
	
	ОтправитьСМСПослеЗаписи(); 	
КонецЕсли;

Оповестить("ИзменениеЗаявкиНаБронирование");
КонецПроцедуры

// + Задание горничным, Зарегистрировать Клиента В БонуснойБазе 
&НаСервере
Процедура ОбработкаСтатусаПослеЗаписи()
Если Объект.ЛистОжидания Тогда Возврат; КонецЕсли;	
	
Если (Объект.Статус = СсылкаСтатус_OldValue) И (НЕ ГорничныеЕстьИзменения) Тогда Возврат; КонецЕсли;  

Событие = "";
Если (Объект.Статус <> СсылкаСтатус_OldValue) Тогда
	Если Объект.Статус = Перечисления.СтатусБрони.Бронь Тогда 
		Если СсылкаСтатус_OldValue = Перечисления.СтатусБрони.Проживает тогда
			Событие = "ОтменаЗаезда";
		Иначе
			Событие = "Бронирование";
		КонецЕсли;
		
	ИначеЕсли Объект.Статус = Перечисления.СтатусБрони.Проживает тогда
		Если СсылкаСтатус_OldValue = Перечисления.СтатусБрони.Выехал тогда
			Событие = "ОтменаВыезда";
		ИначеЕсли СсылкаСтатус_OldValue = Перечисления.СтатусБрони.Бронь тогда
			Событие = "Заезд";
		КонецЕсли;
		
	ИначеЕсли Объект.Статус= Перечисления.СтатусБрони.Выехал Тогда
		Событие = "Выезд";
			
	ИначеЕсли Объект.Статус = Перечисления.СтатусБрони.ОтменаБронирования тогда
	    Событие = "ОтменаБронирования";

	ИначеЕсли Объект.Статус= Перечисления.СтатусБрони.ОтказОтБронирования Тогда
		Событие = "ОтказОтБронирования";
		
	КонецЕсли;
КонецЕсли;
	
Если Событие <> "" ИЛИ ГорничныеЕстьИзменения Тогда
	ОбменГорничныеСервер.СоздатьЗаявку(Объект.Ссылка, Событие);	
КонецЕсли;	
КонецПроцедуры	

&НаСервере
Функция ЗарегистрироватьКлиентаВБонуснойБазе()
СтруктураОтвета = Новый Структура("ЕстьОшибка, ТекстОтвета", Ложь, "");

Попытка
	База =СлужебныеСервер.ConnectБаза_BONUS();;
	
	Рез=База.ЗарегистрироватьКлиента(Объект.Клиент.Фамилия, Объект.Клиент.Имя, Объект.Клиент.Отчество
		, Объект.Клиент.ДатаРождения, Объект.Клиент.Код);
	
	СтруктураОтвета.ТекстОтвета = Рез.РезультатРегистрации;
//				Сообщить(Рез.РезультатРегистрации);
Исключение
	СтруктураОтвета.ЕстьОшибка = Истина;
	СтруктураОтвета.ТекстОтвета = "Не получилось выполнить регистрацию в бонусной базе";
//				Сообщить("Не получилось выполнить регистрацию в бонусной базе");
КонецПопытки; 	

Возврат СтруктураОтвета; 
КонецФункции
// - Задание горничным, Зарегистрировать Клиента В БонуснойБазе 


