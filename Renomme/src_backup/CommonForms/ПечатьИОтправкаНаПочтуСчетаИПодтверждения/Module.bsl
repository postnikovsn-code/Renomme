&НаКлиенте
Процедура СоздатьПодтверждение(Команда)
ПараметрыФормы = Новый Структура();
ПараметрыФормы.Вставить("ДокументДолгСсылка", ДокументДолгСсылка);
ПараметрыФормы.Вставить("СчетГУИД", СчетГУИД);

ИмяФайлаПодтверждение = "Подтверждение бронирования " + ПечатьСервер.ДополнениеТекст(ДокументДолгСсылка); 
ПараметрыФормы.Вставить("ИмяФайла", ИмяФайлаПодтверждение);

ПараметрыФормы.Вставить("ПолноеИмяФайла", ПолноеИмяФайлаПодтверждение);

ПараметрыФормы.Вставить("НаАнглийском", НаАнглийском);

Оповещение = Новый ОписаниеОповещения("ЗавершениеФормыСозданиеПодтверждения", ЭтаФорма);	
Если ПодтверждениеWORD Тогда
	Форма = ОткрытьФорму("ОбщаяФорма.СозданиеПодтвержденияWORD", ПараметрыФормы , ЭтаФорма
	,,,,Оповещение, РежимОткрытияОкнаФормы.БлокироватьВесьИнтерфейс);
Иначе	
	Форма = ОткрытьФорму("ОбщаяФорма.СозданиеПодтвержденияEXCEL", ПараметрыФормы , ЭтаФорма
		,,,,Оповещение, РежимОткрытияОкнаФормы.БлокироватьВесьИнтерфейс);
КонецЕсли;

Если Форма <> Неопределено Тогда	
	Форма.Запустить();	
КонецЕсли;	
КонецПроцедуры

&НаКлиенте
Процедура ЗавершениеФормыСозданиеПодтверждения(Результат, ДополнительныеПараметры) Экспорт
Если Результат = Неопределено Тогда Возврат; КонецЕсли;	

Если Результат.ТекстОшибки <> "" Тогда 
	СообщитьТекстОшибкиФайл(Результат);
	
	ВключитьПодтверждениеВПочту = Ложь;
Иначе
	ВключитьПодтверждениеВПочту = Истина;
КонецЕсли;

ПочтаТема = ПочтаТема();
ПочтаТекстСообщения = ПочтаТекстСообщения();
КонецПроцедуры

&НаКлиенте
Функция ПроверитьПодтверждение()
//Если ПолноеИмяФайлаПодтверждение = "" Тогда 	
//    ПоказатьПредупреждение(,"Предупреждение не создано");
//	Возврат Истина;
//КонецЕсли;

ФайлНаДиске = Новый Файл(ПолноеИмяФайлаПодтверждение);
Если НЕ ФайлНаДиске.Существует() Тогда
    ПоказатьПредупреждение(,"Файл предупреждения отсутствует");
	Возврат Истина;
КонецЕсли;	

Возврат Ложь;
КонецФункции

&НаКлиенте
Процедура СообщитьТекстОшибкиФайл(Результат) 
ТекстОшибки = Результат.ТекстОшибки;
ОписаниеОшибки = Результат.ОписаниеОшибки;

Если СтрНайти(ОписаниеОшибки,"Ошибка совместного доступа к файлу") > 0 Тогда
	ТекстПредупреждения = "Ошибка совместного доступа к файлу подтверждения
							|
							|ЗАКРОЙТЕ ОТКРЫТЫЙ ФАЙЛ ПОДТВЕРЖДЕНИИЯ ...";
	
	ТекстСообщения =  ТекстОшибки + ". ЗАКРОЙТЕ ОТКРЫТЫЙ ФАЙЛ ПОДТВЕРЖДЕНИИЯ."; 
Иначе	
	ТекстПредупреждения = ТекстОшибки;	
	ТекстСообщения =  ТекстОшибки + ": " + ОписаниеОшибки + ". ОБРАТИТЕСЬ К АДМИНИСТРАТОРУ ПРОГРАММЫ."; 
КонецЕсли;

ПоказатьПредупреждение(, ТекстПредупреждения);
Сообщить(ТекстСообщения);
КонецПроцедуры

&НаКлиенте
Асинх Процедура ОткрытьПодтверждение(Команда)
Если ПроверитьПодтверждение() Тогда Возврат; КонецЕсли;

Если ПодтверждениеWORD Тогда
	MSWord = Новый COMОбъект("Word.Application");
	MSWord.Visible = Истина;
	Документ = MSWord.Documents.Open(ПолноеИмяФайлаПодтверждение);

	MSWord.Activate();
Иначе
	
	КнопкиСписок = Новый СписокЗначений;
	КнопкиСписок.Добавить("PDF", "PDF");
	КнопкиСписок.Добавить("EXCEL", "EXCEL");
	КнопкиСписок.Добавить("Отмена");
	Результат = Ждать ВопросАсинх("Открыть в формате",КнопкиСписок);
	
	Если Результат = "PDF" Тогда
		ВременныйФайлПодтверждение = КаталогВременныхФайлов() + ИмяФайлаПодтверждение + ".PDF";
		СохранитьПодтверждениеPDF(ВременныйФайлПодтверждение);
		ЗапуститьПриложение(ВременныйФайлПодтверждение);
	ИначеЕсли Результат = "EXCEL" Тогда
		
		MSExcel = Новый COMОбъект("Excel.Application");

		MSExcel.Visible = Истина;
		MSExcel.Workbooks.Open(ПолноеИмяФайлаПодтверждение); 
		
		xlNormalView = 1;
		MSExcel.ActiveWindow.View = xlNormalView;
	КонецЕсли;	
КонецЕсли;	
	
КонецПроцедуры
