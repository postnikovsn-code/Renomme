  <attributes>
    <name>Список</name>
    <id>1</id>
    <valueType>
      <types>DynamicList</types>
    </valueType>
    <view>
      <common>true</common>
    </view>
    <edit>
      <common>true</common>
    </edit>
    <notDefaultUseAlwaysAttributes xsi:type="form:DataPath">
      <segments>Список.Ссылка</segments>
    </notDefaultUseAlwaysAttributes>
    <main>true</main>
    <extInfo xsi:type="form:DynamicListExtInfo">
      <queryText>ВЫБРАТЬ
	ВЫРАЗИТЬ(&quot;&quot; КАК СТРОКА(500)) КАК ПолнаяПапка,
	СправочникКлиенты.Ссылка КАК Ссылка,
	СправочникКлиенты.ПометкаУдаления КАК ПометкаУдаления,
	СправочникКлиенты.Родитель КАК Родитель,
	СправочникКлиенты.ЭтоГруппа КАК ЭтоГруппа,
	СправочникКлиенты.Код КАК Код,
	ВЫБОР
		КОГДА СправочникКлиенты.ТипКлиента = ЗНАЧЕНИЕ(перечисление.ТипыКлиентов.ЮрЛицо)
			ТОГДА СправочникКлиенты.НаименованиеЮрЛица
		ИНАЧЕ СправочникКлиенты.Наименование
	КОНЕЦ КАК НаименованиеКлиента,
	СправочникКлиенты.НаименованиеЮрЛица КАК НаименованиеЮрЛица,
	СправочникКлиенты.Наименование КАК Наименование,
	СправочникКлиенты.Адрес КАК Адрес,
	СправочникКлиенты.Балкон КАК Балкон,
	СправочникКлиенты.Ванна КАК Ванна,
	СправочникКлиенты.ВидИзОкна КАК ВидИзОкна,
	СправочникКлиенты.ВидКлиента КАК ВидКлиента,
	СправочникКлиенты.Город КАК Город,
	СправочникКлиенты.ГражданствоФМС_NEW КАК ГражданствоФМС_NEW,
	СправочникКлиенты.ДатаВъездаВРФФМС КАК ДатаВъездаВРФФМС,
	СправочникКлиенты.ДатаВыдачи КАК ДатаВыдачи,
	СправочникКлиенты.ДатаДействияДокументаФМС КАК ДатаДействияДокументаФМС,
	СправочникКлиенты.ДатаПропискиПо_NEW КАК ДатаПропискиПо_NEW,
	СправочникКлиенты.ДатаПропискиС КАК ДатаПропискиС,
	СправочникКлиенты.ДатаРегистрации КАК ДатаРегистрации,
	СправочникКлиенты.ДатаРешения_NEW КАК ДатаРешения_NEW,
	СправочникКлиенты.ДатаРождения КАК ДатаРождения,
	СправочникКлиенты.ДопПринадлежности КАК ДопПринадлежности,
	СправочникКлиенты.ЖелательныйЭтаж КАК ЖелательныйЭтаж,
	СправочникКлиенты.Завтрак КАК Завтрак,
	СправочникКлиенты.ЗагрузкаГИУДСтрока КАК ЗагрузкаГИУДСтрока,
	СправочникКлиенты.ИдентификаторВизыФМС КАК ИдентификаторВизыФМС,
	СправочникКлиенты.Имя КАК Имя,
	СправочникКлиенты.ИмяЛатиницей КАК ИмяЛатиницей,
	СправочникКлиенты.ИНН КАК ИНН,
	СправочникКлиенты.Иное КАК Иное,
	СправочникКлиенты.ИностранныйГражданин КАК ИностранныйГражданин,
	СправочникКлиенты.Категория КАК Категория,
	СправочникКлиенты.КемВыдан КАК КемВыдан,
	СправочникКлиенты.КодОргана КАК КодОргана,
	СправочникКлиенты.КПП КАК КПП,
	СправочникКлиенты.КратностьВизыФМС_NEW КАК КратностьВизыФМС_NEW,
	СправочникКлиенты.Курит КАК Курит,
	СправочникКлиенты.Менеджер КАК Менеджер,
	СправочникКлиенты.МиграционнаяКартаНомер КАК МиграционнаяКартаНомер,
	СправочникКлиенты.МиграционнаяКартаСерия КАК МиграционнаяКартаСерия,
	СправочникКлиенты.Номер КАК Номер,
	СправочникКлиенты.НомерРешения_NEW КАК НомерРешения_NEW,
	СправочникКлиенты.ОснованиеКатегории КАК ОснованиеКатегории,
	СправочникКлиенты.Отчество КАК Отчество,
	СправочникКлиенты.Пол КАК Пол,
	СправочникКлиенты.ПребываниеВидДокументаФМС_NEW КАК ПребываниеВидДокументаФМС_NEW,
	СправочникКлиенты.ПребываниеДатаВыдачиДокументаНаПребывание КАК ПребываниеДатаВыдачиДокументаНаПребывание,
