&НаСервере
Функция ПечатьНаСервере()
ИмяМакета = НастройкиСервер.ПолучитьИмяТекущаяОрганизация();
Если не Объект.Аннулированно тогда
	ИмяМакета="Подтверждение_" + ИмяМакета;	
иначе
	ИмяМакета="Аннуляция_" + ИмяМакета;	
конецесли;

//Макет = ПолучитьМакетНаСервере(ИмяМакета);	 
Макет = Документы.ПодтверждениеБронирования.ПолучитьМакет(ИмяМакета);	 

ТабДок=Новый ТабличныйДокумент;

Обл=Макет.ПолучитьОбласть("Шапка");
Обл.Параметры.Кому=Объект.Кому.Наименование;
Обл.Параметры.Факс=Объект.Факс;
ТабДок.Вывести(Обл);

Обл=Макет.ПолучитьОбласть("Строка");
Для каждого Ном Из Объект.Номера Цикл
	Обл.Параметры.ФИО=Ном.Бронь.Клиент.Наименование + "   " + Ном.Бронь.КатегорияНомера.Наименование;	
	Обл.Параметры.ДатаЗаезда=Формат(Ном.Бронь.РезервС, "ДФ=dd.MM.yy")+" ("+Ном.Бронь.ВремяЗаезда+")";
	Обл.Параметры.ДатаВыезда=Формат(Ном.Бронь.РезервПо, "ДФ=dd.MM.yy")+" ("+Ном.Бронь.ВремяВыезда+")";
	Обл.Параметры.Колво=Ном.Бронь.КолВоДней;	
	
	//Обл.Параметры.Стоимость = Ном.Бронь.Тариф.Цена-?(Ном.Бронь.Клиент.Категория.Пустая(),0,Ном.Бронь.Тариф.Цена*(Ном.Бронь.Клиент.Категория.Скидка/100));	
	
	Обл.Параметры.Номер=Формат(Объект.Номер, "ЧГ=");	
	ТабДок.Вывести(Обл);
	//ФИО													ДатаЗаезда					Колво				ДатаВыезда					Стоимость			Номер		
	
КонецЦикла; 
Обл=Макет.ПолучитьОбласть("Подвал");
ТабДок.Вывести(Обл);

ТабДок.ОтображатьСетку = Ложь;
ТабДок.ОтображатьЗаголовки = Ложь;

Возврат ТабДок;
КонецФункции

