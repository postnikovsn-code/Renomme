&НаСервере
Процедура ЗаменитьОплачивает(Оплачивает_OldValue, ЗаменитьСкидку, Клиент_OldValue)
Если ЗаменитьСкидку Тогда ЗаменаПроцентСкидки(); КонецЕсли;

Если ЗначениеЗаполнено(Оплачивает_OldValue) Тогда
	Контрагент_OldValue = Оплачивает_OldValue;
Иначе
	Контрагент_OldValue = Клиент_OldValue;
КонецЕсли;		

Если ЗначениеЗаполнено(Объект.Оплачивает) Тогда
	Контрагент = Объект.Оплачивает;
Иначе
	Контрагент = Объект.Клиент;
КонецЕсли;

//Замена = Истина;
//Если КлиентыСервер.ЭтоЮрЛицо(Клиент_OldValue) И КлиентыСервер.ЭтоЮрЛицо(Контрагент) Тогда

//ИначеЕсли (КлиентыСервер.ЭтоЮрЛицо(Клиент_OldValue)) И (НЕ КлиентыСервер.ЭтоЮрЛицо(Контрагент)) Тогда
//	
//ИначеЕсли (НЕ КлиентыСервер.ЭтоЮрЛицо(Клиент_OldValue)) И (КлиентыСервер.ЭтоЮрЛицо(Контрагент)) Тогда
//	Замена = Ложь;
//	
//ИначеЕсли (НЕ КлиентыСервер.ЭтоЮрЛицо(Клиент_OldValue)) И (НЕ КлиентыСервер.ЭтоЮрЛицо(Контрагент)) Тогда
//	
//КонецЕсли;

Замена = ПроверкаЗаменыКонтрагентОплачивает(Контрагент, Контрагент_OldValue);

Для Каждого Счет из Объект.Счета Цикл
	Если ЗначениеЗаполнено(Счет.ГрупповойСчет) Тогда Продолжить; КонецЕсли;

	Если Счет.Контрагент = Контрагент_OldValue Тогда
		
		Если Счет.РазделитьСчет Тогда
			Счет.Контрагент = Счет.Клиент;
		Иначе
		
			Если Замена Тогда
				Счет.Контрагент = Контрагент;
			Иначе	
				Если НЕ Счет.ТолькоУслуги Тогда
					Счет.Контрагент = Контрагент;
				КонецЕсли;
			КонецЕсли;
		
		КонецЕсли;
	КонецЕсли;
КонецЦикла;

Если Замена Тогда		
	ЗаменитьКонтрагентаДокументОплатыКасса(Объект.Оплачивает, Оплачивает_OldValue);
КонецЕсли;
	
УдалитьДокументыОплатыВыписка(Контрагент_OldValue);
КонецПроцедуры	

&НаСервере
Функция ПроверкаЗаменыКонтрагентОплачивает(Контрагент, Контрагент_OldValue)
Замена = Истина;
Если КлиентыСервер.ЭтоЮрЛицо(Контрагент_OldValue) И КлиентыСервер.ЭтоЮрЛицо(Контрагент) Тогда
	
ИначеЕсли (КлиентыСервер.ЭтоЮрЛицо(Контрагент_OldValue)) И (НЕ КлиентыСервер.ЭтоЮрЛицо(Контрагент)) Тогда
	
ИначеЕсли (НЕ КлиентыСервер.ЭтоЮрЛицо(Контрагент_OldValue)) И (КлиентыСервер.ЭтоЮрЛицо(Контрагент)) Тогда
	Замена = Ложь;
	
ИначеЕсли (НЕ КлиентыСервер.ЭтоЮрЛицо(Контрагент_OldValue)) И (НЕ КлиентыСервер.ЭтоЮрЛицо(Контрагент)) Тогда
	
КонецЕсли;

Возврат Замена;
КонецФункции	
	
&НаСервере
Процедура УдалитьДокументыОплатыВыписка(Контрагент_OldValue)
Для Каждого Строка Из Объект.СчетаДетальноОплаты Цикл
	Если Строка.ГрупповаяОплата Тогда Продолжить; КонецЕсли; 
	
	ДокументОплаты = Строка.ДокументОплаты;

	Если ДокументОплаты.ОтКого <> Контрагент_OldValue Тогда Продолжить; КонецЕсли;
	
	Если ТипЗнч(ДокументОплаты) = Тип("ДокументСсылка.ВыпискаБанка") Тогда

		ЗаявкаСервер.УдалитьДокументОплатыДокументДолгДолгОплата(ДокументОплаты, Объект.Ссылка);

		ЗаявкаСервер.ОчиститьСчетаДетальноДолгиДокументОплаты(ДокументОплаты
			, Объект.РаспределениеОплатДолги, Объект.СчетаДетальноДолги); 	
			
		Объект.СчетаДетальноОплаты.Удалить(Строка);
	КонецЕсли; 
КонецЦикла;
Конецпроцедуры	
