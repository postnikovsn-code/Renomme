&НаСервере
Процедура ЗаполнитьОшибкиЗаменыКонтрагентовНаСервере()
	
Запрос = Новый Запрос("ВЫБРАТЬ
                      |	ЗаявкаНаБронирование.Ссылка КАК Ссылка,
                      |	ЗаявкаНаБронирование.Оплачивает КАК Оплачивает
                      |ИЗ
                      |	Документ.ЗаявкаНаБронирование КАК ЗаявкаНаБронирование
                      |ГДЕ
                      |	ЗаявкаНаБронирование.ПометкаУдаления = ЛОЖЬ
                      |	И ЗаявкаНаБронирование.Оплачивает.Турагентство = ИСТИНА");	
	
ТЗ = Запрос.Выполнить().Выгрузить();

Для каждого Строка Из ТЗ Цикл 
	ЗаявкаОбъект = Строка.Ссылка.ПолучитьОбъект();
	
	ТЗ_Счета = ЗаявкаОбъект.Счета;
	ЕстьСчет = Ложь;

	Для Каждого СтрокаСчет Из ТЗ_Счета Цикл
		Если СтрокаСчет.Контрагент = Строка.Оплачивает Тогда
			Если СтрокаСчет.ТолькоУслуги Тогда 
				ЕстьСчет = Истина;
				Сообщить("Счет " + Строка.Ссылка);
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
		
	ЕстьКассовыйДокумент = Ложь;				
	ТЗ_Оплаты = ЗаявкаОбъект.СчетаДетальноОплаты;
	Для Каждого СтрокаОплата Из ТЗ_Оплаты Цикл
		Если ТипЗнч(СтрокаОплата.ДокументОплаты) = Тип("ДокументСсылка.КассовыйДокумент") Тогда
			Если СтрокаОплата.ДокументОплаты.ОтКого = Строка.Оплачивает Тогда
				ЕстьКассовыйДокумент = Истина;				
				Сообщить("КассовыйДокумент " + Строка.Ссылка);
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	
	Если ЕстьСчет ИЛИ ЕстьКассовыйДокумент Тогда
		НоваяСтрока = ТЗ_Данные.Добавить();
		НоваяСтрока.Заявка = ЗаявкаОбъект.Ссылка;
		НоваяСтрока.Счет = ЕстьСчет;
		НоваяСтрока.КД = ЕстьКассовыйДокумент;
	КонецЕсли;
КонецЦикла;

КонецПроцедуры


&НаСервере
Функция УстранитьОшибкиЗаменыКонтрагентовНаСервере()

Для каждого Строка Из ТЗ_Данные Цикл 
	Если НЕ (Строка.Счет ИЛИ Строка.КД) Тогда Продолжить; КонецЕсли;
	
	ЗаявкаОбъект = Строка.Заявка.ПолучитьОбъект();
	
	ТЗ_Счета = ЗаявкаОбъект.Счета;
	ЗаписатьОбъект = Ложь;

	Для Каждого СтрокаСчет Из ТЗ_Счета Цикл
		Если СтрокаСчет.Контрагент = ЗаявкаОбъект.Оплачивает Тогда
			Если СтрокаСчет.ТолькоУслуги Тогда 
				Если Строка.Счет Тогда 
					СтрокаСчет.Контрагент = ЗаявкаОбъект.Клиент;	
					ЗаписатьОбъект = Истина;
				КонецЕсли;
				Сообщить("Счет " + ЗаявкаОбъект.Ссылка);
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	
	Если ЗаписатьОбъект Тогда
		Попытка 
			ЗаявкаОбъект.Записать(РежимЗаписиДокумента.Проведение);
		Исключение
			Сообщить("Ошибка записи " + ЗаявкаОбъект.Ссылка + " Описание ошибки: " + ОписаниеОшибки()); 			
		КонецПопытки;
	КонецЕсли;	
		
	ТЗ_Оплаты = ЗаявкаОбъект.СчетаДетальноОплаты;
	
	Для Каждого СтрокаОплата Из ТЗ_Оплаты Цикл
		Если ТипЗнч(СтрокаОплата.ДокументОплаты) = Тип("ДокументСсылка.КассовыйДокумент") Тогда
			Если СтрокаОплата.ДокументОплаты.ОтКого = ЗаявкаОбъект.Оплачивает Тогда
				Если Строка.КД Тогда
					КассовыйДокументОбъект = СтрокаОплата.ДокументОплаты.Ссылка.ПолучитьОбъект();
					КассовыйДокументОбъект.ОтКого = ЗаявкаОбъект.Клиент;	
					Попытка 
						КассовыйДокументОбъект.Записать(РежимЗаписиДокумента.Проведение);
					Исключение
						Сообщить("Ошибка записи " + КассовыйДокументОбъект.Ссылка + " Описание ошибки: " + ОписаниеОшибки()); 			
					КонецПопытки;
				КонецЕсли;
				
				Сообщить("КассовыйДокумент " + КассовыйДокументОбъект.Ссылка);
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
КонецЦикла;

КонецФункции
