Функция ПользовательПрава() Экспорт
ИмяПользователя = ИмяПользователя();

Запрос = Новый Запрос("ВЫБРАТЬ
                      |	ПользователиПрава.Право КАК Право
                      |ИЗ
                      |	Справочник.Пользователи.Права КАК ПользователиПрава
                      |ГДЕ
                      |	ПользователиПрава.Ссылка.Код = &Код");
Запрос.УстановитьПараметр("Код", ИмяПользователя);

ПользователиПрава = Запрос.Выполнить().Выгрузить();

Возврат ПользователиПрава;
КонецФункции

Функция ПользовательЕстьПраво(Право) Экспорт
Если НастройкиСервер.ЭтоАдминистратор() Тогда Возврат Истина; КонецЕсли;	
	
ПользовательПрава = ПользовательПрава();
НайденнаяСтрока = ПользовательПрава.Найти(Право, "Право");

Возврат НЕ (НайденнаяСтрока = Неопределено); 
КонецФункции
