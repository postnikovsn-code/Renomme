&НаСервере
Функция ОкладЗаСмену(Администратор, ДлинаСмены)

АдминистраторСправочник = АдминистраторСправочник(Администратор);

Если ДлинаСмены = 0 Тогда	
	ОкладЗаСмену = 0;
ИначеЕсли ДлинаСмены <= 12 Тогда	
	ОкладЗаСмену = Окр(АдминистраторСправочник.СтавкаЗаСмену12 * (ДлинаСмены / 12));	
Иначе
	Если ДлинаСмены > 12 И ДлинаСмены <= 24 Тогда	
		ОкладЗаСмену = Окр(АдминистраторСправочник.СтавкаЗаСмену24 * (ДлинаСмены / 24));
	Иначе
		ОкладЗаСмену = АдминистраторСправочник.СтавкаЗаСмену24;
	КонецЕсли;
КонецЕсли;

Возврат ОкладЗаСмену;
КонецФункции

