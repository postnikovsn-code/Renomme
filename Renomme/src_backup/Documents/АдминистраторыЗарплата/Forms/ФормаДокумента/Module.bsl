&НаКлиенте
Процедура ПрочееПриНачалеРедактирования(Элемент, НоваяСтрока, Копирование)
ТД = Элемент.ТекущиеДанные;
ПрочееАдминистратор_OldValue = ТД.Администратор;
ПрочееДата_OldValue = ТД.Дата;
ПрочееСумма_OldValue = ТД.Сумма;
КонецПроцедуры

&НаКлиенте
Процедура ПрочееПриОкончанииРедактирования(Элемент, НоваяСтрока, ОтменаРедактирования)
ТД = Элемент.ТекущиеДанные;
Если ТД = Неопределено Тогда Возврат; КонецЕсли;

Текст = "";
Если НЕ ЗначениеЗаполнено(ТД.Администратор) Тогда
	Текст = ОбщийФункционалКлиентСервер.ДобавитьТекст(Текст, "Администратор должен быть заполнен.", Символы.ПС);
КонецЕсли;	
Если НЕ ЗначениеЗаполнено(ТД.Дата) Тогда
	Текст = ОбщийФункционалКлиентСервер.ДобавитьТекст(Текст, "Дата должна быть заполнена.", Символы.ПС);
КонецЕсли;	

Если Текст <> "" Тогда
	ПоказатьПредупреждение(,Текст);	
КонецЕсли;

ТС = Элемент.ТекущаяСтрока;
ОбновитьПрочееСтрокаИзКлиента(ТС);
			
АдминистраторПрочееИтогоДействие(ТД);	
КонецПроцедуры

&НаСервере
Процедура ОбновитьПрочееСтрокаИзКлиента(ТС)
