Процедура СформироватьГорничныеСтраница()
//	
Запрос = Новый Запрос("ВЫБРАТЬ
                      |	Горничные.Ссылка КАК Горничная
                      |ИЗ
                      |	Справочник.Горничные КАК Горничные
                      |ГДЕ
                      |	Горничные.ПометкаУдаления = ЛОЖЬ
                      |
                      |УПОРЯДОЧИТЬ ПО
                      |	Горничные.Сортировка,
                      |	Горничные.Наименование");

ТЗ_Горничные = Запрос.Выполнить().Выгрузить();
//	

//	
Запрос = Новый Запрос("ВЫБРАТЬ
                      |	ГорничныеПомещения.Ссылка КАК Помещение
					  |ИЗ
                      |	Справочник.ГорничныеПомещения КАК ГорничныеПомещения
                      |ГДЕ
                      |	ГорничныеПомещения.ПометкаУдаления = ЛОЖЬ
                      |
                      |УПОРЯДОЧИТЬ ПО
                      |	ГорничныеПомещения.Сортировка,
                      |	ГорничныеПомещения.Наименование");

ТЗ_Помещения = Запрос.Выполнить().Выгрузить();
//	


Запрос=Новый Запрос;
Запрос.Текст = ГорничныеЗарплата.ЗапросГорничныеДанные();

Запрос.УстановитьПараметр("ДН",Отчет.ДатаС);
Запрос.УстановитьПараметр("ДК",КонецДня(Отчет.ДатаПо));

ТЗ_НомераУборки = Запрос.Выполнить().Выгрузить();

Запрос=Новый Запрос;
Запрос.Текст = ГорничныеЗарплата.ЗапросГорничныеПомещенияДанные();

Запрос.УстановитьПараметр("ДН",Отчет.ДатаС);
Запрос.УстановитьПараметр("ДК",КонецДня(Отчет.ДатаПо));

ТЗ_ГорничныеПомещения = Запрос.Выполнить().Выгрузить();

//Макет = Отчеты.ОбщийОтчетПоГорничным.ПолучитьМакет("МакетГорничные");
ОтчетОбъект = РеквизитФормыВЗначение("Отчет");
Макет = ОтчетОбъект.ПолучитьМакет("МакетГорничные");

ПолеОтчета.Очистить();

ШапкаЛево = Макет.ПолучитьОбласть("Шапка|Лево");
ПолеОтчета.Вывести(ШапкаЛево);
Для Каждого Строка Из ТЗ_Помещения Цикл
	ОбластьПомещение = Макет.ПолучитьОбласть("Шапка|Помещение");
	ОбластьПомещение.Параметры.Помещение = Строка.Помещение;
	
	ПолеОтчета.Присоединить(ОбластьПомещение);
КонецЦикла;
ШапкаПраво = Макет.ПолучитьОбласть("Шапка|Право");
ПолеОтчета.Присоединить(ШапкаПраво);

Для Каждого СтрокаГорничные Из ТЗ_Горничные Цикл
	ОтборСтроки = Новый Структура("Горничная", СтрокаГорничные.Горничная);
	СтрокиНомераУборки = ТЗ_НомераУборки.НайтиСтроки(ОтборСтроки);
	СтрокиГорничныеПомещения = ТЗ_ГорничныеПомещения.НайтиСтроки(ОтборСтроки);
	
	Если СтрокиНомераУборки.Количество() = 0 
	И СтрокиГорничныеПомещения.Количество() = 0 
	Тогда Продолжить; КонецЕсли;
	
	Обл=Макет.ПолучитьОбласть("Строка|Лево");
	Обл.Параметры.Горничная = СтрокаГорничные.Горничная;
	
	Если СтрокиНомераУборки.Количество() = 0 Тогда
	 	ПолеОтчета.Вывести(Обл);
	Иначе
		СтрокаНомераУборки = СтрокиНомераУборки[0];
		Обл.Параметры.Заполнить(СтрокаНомераУборки);
		
		ПолеОтчета.Вывести(Обл);
	КонецЕсли;
	
	Для Каждого СтрокаПомещения Из ТЗ_Помещения Цикл
		ОбластьПомещение = Макет.ПолучитьОбласть("Строка|Помещение");
		
		ОтборСтроки = Новый Структура("Горничная, Помещение", СтрокаГорничные.Горничная, СтрокаПомещения.Помещение);
		СтрокиГорничныеПомещения = ТЗ_ГорничныеПомещения.НайтиСтроки(ОтборСтроки);
		Если СтрокиГорничныеПомещения.Количество() > 0 Тогда 
			ОбластьПомещение.Параметры.ПомещениеКоличество = СтрокиГорничныеПомещения[0].Количество;
		КонецЕсли;
		
		ПолеОтчета.Присоединить(ОбластьПомещение);
	КонецЦикла;
	
	СтрокаПраво = Макет.ПолучитьОбласть("Строка|Право");
	ПолеОтчета.Присоединить(СтрокаПраво);
КонецЦикла; 
КонецПроцедуры

