//ЗаявкаСервер.УдалитьДокументОплаты(ДокументОплаты, ДокументДолгОбъект); 
СчетаДетальноОплаты.Удалить(СтрокаСчетаДетальноОплаты);

Если ОстатокКРаспределению_П > 0 Тогда 
	СтрокаОплаты = ЗаявкаСервер.ДобавитьОплатаСчетаДетальноОплаты(СчетаДетальноОплаты
		, ДокументОплаты, Ложь);
		
	СуммаВозврата_П = СуммаВозврата;
	Для Каждого Счет Из СчетаДокументаОплаты Цикл
		//СуммаРаспределениеОплатДолги = СуммаРаспределениеОплатДолги(ДокументДолгОбъект, Счет.СчетГУИД);
		ОчиститьСчетРаспределениеОплатДетальноДолги(РаспределениеОплатДолги, СчетаДетальноДолги, Счет.СчетГУИД);
		
		Если ОстатокКРаспределению_П = 0 Тогда 
			
			//СуммаВозврата_П = СуммаРаспределениеОплатДолги; 
			//ДобавитьИсторияВозвратов(ДокументДолг, Счет.СчетГУИД, СуммаВозврата_П, ДокументВозврата);
			
		Иначе
			ЗаявкаСервер.РаспределитьСтрокаОплатыНаСчет(СтрокаОплаты, ОстатокКРаспределению_П, Счет.СчетГУИД, ДокументДолгОбъект);  	
			
			//СуммаВозврата_П = СуммаВозврата_П - ОстатокКРаспределению_П; 
			//ДобавитьИсторияВозвратов(ДокументДолг, Счет.СчетГУИД, СуммаВозврата_П, ДокументВозврата);
		
		КонецЕсли;
	КонецЦикла;
Иначе
	Для Каждого Счет Из СчетаДокументаОплаты Цикл

		//СуммаРаспределениеОплатДолги = СуммаРаспределениеОплатДолги(ДокументДолгОбъект, Счет.СчетГУИД);
		//СуммаВозврата_П = СуммаРаспределениеОплатДолги; 
		//ДобавитьИсторияВозвратов(ДокументДолг, Счет.СчетГУИД, СуммаВозврата_П, ДокументВозврата);
		
		ОчиститьСчетРаспределениеОплатДетальноДолги(РаспределениеОплатДолги, СчетаДетальноДолги, Счет.СчетГУИД);
	КонецЦикла;
КонецЕсли;

ДокументДолгОбъект.Записать(РежимЗаписиДокумента.Проведение);

ЗафиксироватьТранзакцию();

Возврат ОстатокСуммаВозврата;
КонецФункции	

Процедура ДобавитьИсторияВозвратов_НеИспользуется(ДокументДолг, СчетГУИД, СуммаВозврата, ДокументВозврата)
МенеджерЗаписей = РегистрыСведений.ИсторияВозвратов_КУдалению.СоздатьМенеджерЗаписи();

МенеджерЗаписей.ДатаВозврата = ДокументВозврата.ДатаОплаты;
МенеджерЗаписей.ДокументДолг = ДокументДолг;
МенеджерЗаписей.СчетГУИД = СчетГУИД;
МенеджерЗаписей.ДокументВозврата = ДокументВозврата;
МенеджерЗаписей.Прочитать();

Если МенеджерЗаписей.Выбран() Тогда
	МенеджерЗаписей.СуммаВозврата = МенеджерЗаписей.СуммаВозврата + СуммаВозврата;
Иначе
	МенеджерЗаписей.СуммаВозврата = СуммаВозврата;
КонецЕсли;

МенеджерЗаписей.Записать();
КонецПроцедуры

Функция СуммаРаспределениеОплатДолги(ДокументДолгОбъект, СчетГУИД)
РаспределениеОплатДолги = ДокументДолгОбъект.РаспределениеОплатДолги;
ОтборСтроки = Новый Структура("СчетГУИД", СчетГУИД);
ТЗ = РаспределениеОплатДолги.Выгрузить(ОтборСтроки, "СуммаОплаты");
СуммаРаспределениеОплатДолги = ТЗ.Итог("СуммаОплаты"); 
	
Возврат СуммаРаспределениеОплатДолги;
КонецФункции
	
Процедура ОчиститьСчетРаспределениеОплатДетальноДолги(РаспределениеОплатДолги, СчетаДетальноДолги, СчетГУИД)
ОтборСтроки = Новый Структура("СчетГУИД", СчетГУИД);
НайденныеСтрокиРаспределениеОплат = РаспределениеОплатДолги.НайтиСтроки(ОтборСтроки);

Для Каждого НайденнаяСтрокаРаспределениеОплат Из НайденныеСтрокиРаспределениеОплат Цикл
	ОтборСтрокиСчетаДетальноДолги = Новый Структура("ДолгиГУИД, СчетГУИД"
		, НайденнаяСтрокаРаспределениеОплат.ДолгиГУИД, НайденнаяСтрокаРаспределениеОплат.СчетГУИД);
	
	НайденныеСтроки = СчетаДетальноДолги.НайтиСтроки(ОтборСтрокиСчетаДетальноДолги);
	Для Каждого НайденнаяСтрока Из НайденныеСтроки Цикл
		НайденнаяСтрока.СуммаОплачено = НайденнаяСтрока.СуммаОплачено - НайденнаяСтрокаРаспределениеОплат.СуммаОплаты;
		НайденнаяСтрока.СуммаКЗакрытию = НайденнаяСтрока.СуммаКЗакрытию + НайденнаяСтрокаРаспределениеОплат.СуммаОплаты;
	КонецЦикла;	
КонецЦикла;

ОбщийФункционалСервер.УдалитьСтроки(РаспределениеОплатДолги, НайденныеСтрокиРаспределениеОплат);
КонецПроцедуры
