Функция ВозможностьЧтенияДанных(ЧтениеXML) Экспорт
// Получить тип данных XML, который может быть считан в данный момент.
ТипXML = ПолучитьXMLТип(ЧтениеXML);

Если ТипXML = Неопределено Тогда
	Возврат Ложь;
КонецЕсли;

Если ТипXML.ИмяТипа = "DocumentObject.Выписка.Вручную" И ТипXML.URIПространстваИмен = "" Тогда
	Возврат Истина;
КонецЕсли;

Возврат ВозможностьЧтенияXML(ЧтениеXML);
КонецФункции

Функция ПрочитатьДанные(ЧтениеXML) Экспорт
ТипXML = ПолучитьXMLТип(ЧтениеXML);

Если ТипXML = Неопределено Тогда
	Возврат Неопределено;
КонецЕсли;

Если ТипXML.ИмяТипа = "DocumentObject.Выписка.Вручную" И ТипXML.URIПространстваИмен = "" Тогда
	Возврат ПрочитатьXMLВыписка(ЧтениеXML);
КонецЕсли;

// Прочитать значение из объекта ЧтениеXML стандартным образом.
//Возврат ПрочитатьXML(ЧтениеXML);
КонецФункции

Функция ПрочитатьXMLВыписка(ЧтениеXML) Экспорт
Если ЧтениеXML.ТипУзла <> ТипУзлаXML.НачалоЭлемента Тогда
	ВызватьИсключение "Ошибка чтения XML";
КонецЕсли;

// Прочитать следующий узел XML-документа.
ЧтениеXML.Прочитать();

Удаление = ПрочитатьXML(ЧтениеXML);

// Прочитать ссылку на элемент справочника Номенклатура.
ВыпискаСсылка = ПрочитатьXML(ЧтениеXML);
//Если ТипЗнч(ВыпискаСсылка) <> Тип("ДокументСсылка.Выписка") Тогда
//	ВызватьИсключение "Ошибка чтения XML";
//КонецЕсли;

РезультатВыписка = Новый Структура();

РезультатВыписка.Вставить("Удаление", Удаление); 
РезультатВыписка.Вставить("ВыпискаСсылка", ВыпискаСсылка); 

Если НЕ Удаление Тогда
	ПометкаУдаления = ПрочитатьXML(ЧтениеXML);
	РезультатВыписка.Вставить("ПометкаУдаления", ПометкаУдаления); 
	
	ВыпискаДата = ПрочитатьXML(ЧтениеXML);
	РезультатВыписка.Вставить("ДатаДокументаИсточника", ВыпискаДата); 

	ВыпискаНомер = ПрочитатьXML(ЧтениеXML);
	РезультатВыписка.Вставить("НомерДокументаИсточника", ВыпискаНомер); 

	ВыпискаОрганизация = ПрочитатьXML(ЧтениеXML);
	РезультатВыписка.Вставить("Организация", ВыпискаОрганизация); 

	ВыпискаОрганизацияИНН = ПрочитатьXML(ЧтениеXML);
	РезультатВыписка.Вставить("ОрганизацияИНН", ВыпискаОрганизацияИНН); 

	ВыпискаОрганизацияКПП = ПрочитатьXML(ЧтениеXML);
	РезультатВыписка.Вставить("ОрганизацияКПП", ВыпискаОрганизацияКПП); 
	
	ВыпискаСумма = ПрочитатьXML(ЧтениеXML);
	РезультатВыписка.Вставить("Сумма", ВыпискаСумма); 

	КонтрагентНаименование = ПрочитатьXML(ЧтениеXML);
	РезультатВыписка.Вставить("КонтрагентНаименование", КонтрагентНаименование); 
	
	КонтрагентИНН = ПрочитатьXML(ЧтениеXML);
	РезультатВыписка.Вставить("КонтрагентИНН", КонтрагентИНН); 
	
	КонтрагентКПП = ПрочитатьXML(ЧтениеXML);
	РезультатВыписка.Вставить("КонтрагентКПП", КонтрагентКПП); 
	
	ДатаОплаты = ПрочитатьXML(ЧтениеXML);
	// + Аудит
	//РезультатВыписка.Вставить("ДатаОплаты ", ДатаОплаты); 
	РезультатВыписка.Вставить("ДатаОплаты", ДатаОплаты); 
	// - Аудит
	
	ТекстПлатежа  = ПрочитатьXML(ЧтениеXML);
	РезультатВыписка.Вставить("ТекстПлатежа", ТекстПлатежа); 
КонецЕсли;

// Проверить, что текущим узлом является КонецЭлемента.
Если ЧтениеXML.ТипУзла <> ТипУзлаXML.КонецЭлемента Тогда
	ВызватьИсключение "Ошибка чтения XML";
КонецЕсли;

// Прочитать следующий узел для завершение чтения элемента XML-документа.
ЧтениеXML.Прочитать();

Возврат РезультатВыписка;
КонецФункции  

Функция ЗаписатьПолученныеДанные(РезультатВыписка) Экспорт
ОтборСтроки = Новый Структура("ГУИДИсточникаСтрока", РезультатВыписка.ВыпискаСсылка);	
Выборка = РегистрыСведений.БезналЗагрузка.Выбрать(ОтборСтроки);

Если РезультатВыписка.Удаление Тогда 
	Если Выборка.Следующий() Тогда
		НаборЗаписей = РегистрыСведений.БезналЗагрузка.СоздатьНаборЗаписей();
		НаборЗаписей.Отбор.ГУИД.Установить(Выборка.ГУИД);
		НаборЗаписей.Прочитать();
		
		НаборЗаписей.ОбменДанными.Загрузка = Истина;

		НаборЗаписей.Очистить();
	КонецЕсли; 
	
	Возврат -1;
КонецЕсли;	

Если Выборка.Следующий() Тогда
	НаборЗаписей = РегистрыСведений.БезналЗагрузка.СоздатьНаборЗаписей();
	НаборЗаписей.Отбор.ГУИД.Установить(Выборка.ГУИД);
	НаборЗаписей.Прочитать();
	
	НаборЗаписей.ОбменДанными.Загрузка = Истина;
	
	Запись = НаборЗаписей[0];
	Запись.ДатаИзменения = ТекущаяДата();
	
	Изменение = 1;	
Иначе	
	НаборЗаписей = РегистрыСведений.БезналЗагрузка.СоздатьНаборЗаписей();
	ГУИД = Новый УникальныйИдентификатор(); 
	НаборЗаписей.Отбор.ГУИД.Установить(ГУИД);
	НаборЗаписей.Прочитать();
	
	НаборЗаписей.ОбменДанными.Загрузка = Истина;

	Запись = НаборЗаписей.Добавить(); 
	Запись.ГУИД = ГУИД;
	Запись.ГУИДИсточникаСтрока = РезультатВыписка.ВыпискаСсылка;
	Запись.ИсточникПлатежа = "БУХГАЛТЕРИЯ";
	
	Изменение = 0;
КонецЕсли;

Запись.ДатаЗагрузки = ТекущаяДата();

ЗаполнитьЗначенияСвойств(Запись, РезультатВыписка);

НаборЗаписей.Записать(Истина);

Возврат Изменение;
КонецФункции
