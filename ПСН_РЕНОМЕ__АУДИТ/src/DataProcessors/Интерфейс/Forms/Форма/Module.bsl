КонецПроцедуры

&НаСервере
Функция КалендарьЦенНаМесяцКомандаНаСервере()
Макет=Обработки.Интерфейс.ПолучитьМакет("КалендарьЦен");

ТабДок=Новый ТабличныйДокумент;

//ТабДок.Защита = Истина;
ТабДок.ОтображатьЗаголовки = Ложь;
ТабДок.ТолькоПросмотр = Истина;

Обл=Макет.ПолучитьОбласть("Шапка|СтолбецДата");
ТабДок.Вывести(Обл);

КатегорияНомера = Справочники.КатегорииНомеров.Выбрать();
Пока КатегорияНомера.Следующий() Цикл
	Если КатегорияНомера.ПометкаУдаления Тогда Продолжить; КонецЕсли;  
	
	Обл=Макет.ПолучитьОбласть("Шапка|СтолбецКатегория");
	КатегорияНомераНаименование = КатегорияНомера.Наименование;
	Обл.Параметры.КатегорияНомера = КатегорияНомераНаименование;
	ТабДок.Присоединить(Обл);
КонецЦикла;	

ДТН=НачалоДня(ТекущаяДата());
ДТК=НачалоДня(ТекущаяДата() + 86400*30);

Пока ДТН<ДТК цикл
	Вых=?(ДеньНедели(ДТН)>=5,Истина,Ложь);
	
	Обл=?(Вых,Макет.ПолучитьОбласть("СтрокаВых|СтолбецДата"), Макет.ПолучитьОбласть("Строка|СтолбецДата"));
	Обл.Параметры.ДТ=Формат(ДТН, "ДФ=dd.MM.yy");
	ТабДок.Вывести(Обл);
	
	КатегорияНомера = Справочники.КатегорииНомеров.Выбрать();
	Пока КатегорияНомера.Следующий() Цикл
		Если КатегорияНомера.ПометкаУдаления Тогда Продолжить; КонецЕсли;  
		
		КатегорияНомераСсылка = КатегорияНомера.Ссылка;
		Если КатегорияНомера.ТолькоОдноместный Тогда
			ЦенаДвух = 0;
		Иначе
			ЦенаДвух = ДокументыСервер.ПолучитьЦенуПоЦеновойПолитике(ДТН, КатегорияНомераСсылка, Ложь, Истина);
		КонецЕсли;	
		//ЦенаДвух = ДокументыСервер.ОкруглитьЦену(ЦенаДвух); 
		
		Если КатегорияНомера.ТолькоОдноместный Тогда
			ЦенаБезЗавтракаДвух = 0;
		Иначе
			ЦенаБезЗавтракаДвух = ДокументыСервер.ПолучитьЦенуПоЦеновойПолитике(ДТН, КатегорияНомераСсылка, Истина, Истина);
		КонецЕсли;	
		//ЦенаБезЗавтракаДвух = ДокументыСервер.ОкруглитьЦену(ЦенаБезЗавтракаДвух); 
		
		Цена = ДокументыСервер.ПолучитьЦенуПоЦеновойПолитике(ДТН, КатегорияНомераСсылка, Ложь, Ложь);
		//Цена = ДокументыСервер.ОкруглитьЦену(Цена); 
		
		ЦенаБезЗавтрака = ДокументыСервер.ПолучитьЦенуПоЦеновойПолитике(ДТН, КатегорияНомераСсылка, Истина, Ложь);
		//ЦенаБезЗавтрака = ДокументыСервер.ОкруглитьЦену(ЦенаБезЗавтрака); 
		
		Обл=?(Вых,Макет.ПолучитьОбласть("СтрокаВых|СтолбецКатегория"), Макет.ПолучитьОбласть("Строка|СтолбецКатегория"));
		//Дт	СТ_1	СТ_2	СТ_В_1	СТ_В2	ПЛ_1	ПЛ_2	ПЛ_В_1	ПЛ_В_2	Л_1	Л_2	Л_В_1	Л_В_2
		Если Не Вых тогда
			Обл.Параметры.СТ_1 = Формат(Цена, "ЧДЦ=2") + " / " + Формат(ЦенаБезЗавтрака, "ЧДЦ=2");
			Если НЕ КатегорияНомера.ТолькоОдноместный Тогда
				Обл.Параметры.СТ_2 = Формат(ЦенаДвух, "ЧДЦ=2") + " / " + Формат(ЦенаБезЗавтракаДвух, "ЧДЦ=2");
			КонецЕсли;
		иначе
			Обл.Параметры.СТ_В_1=Формат(Цена, "ЧДЦ=2") + " / " + Формат(ЦенаБезЗавтрака, "ЧДЦ=2");
			Если НЕ КатегорияНомера.ТолькоОдноместный Тогда
				Обл.Параметры.СТ_В_2=Формат(ЦенаДвух, "ЧДЦ=2") + " / " + Формат(ЦенаБезЗавтракаДвух, "ЧДЦ=2");
			КонецЕсли;
		конецесли;
		
		ТабДок.Присоединить(Обл);
	КонецЦикла;
	
	ДТН=ДТН+86400;		
КонецЦикла;

Возврат  ТабДок;
КонецФункции
