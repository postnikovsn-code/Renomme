&НаСервере
Процедура ЗаполнитьГрупповыеСчетаРаспределениеОплатСчетГУИДНаСервере()
Запрос = Новый Запрос("ВЫБРАТЬ
                      |	ГрупповыеСчета.Ссылка КАК ГрупповойСчет
                      |ИЗ
                      |	Документ.ГрупповыеСчета КАК ГрупповыеСчета");

ТЗ = Запрос.Выполнить().Выгрузить();
Для Каждого Строка Из ТЗ Цикл
	ГрупповойСчетОбъект = Строка.ГрупповойСчет.ПолучитьОбъект();
	
	РаспределениеОплат = ГрупповойСчетОбъект.РаспределениеОплат;
	РаспределениеОплат.Очистить();
	
	Для Каждого СтрокаОплаты Из ГрупповойСчетОбъект.ДокументыОплаты Цикл
		Для Каждого СтрокаДолги Из ГрупповойСчетОбъект.ДокументыДолги Цикл
			Запрос = Новый Запрос("ВЫБРАТЬ
			                      |	СУММА(ЗаявкаНаБронированиеРаспределениеОплатДолги.СуммаОплаты) КАК СуммаОплаты
			                      |ИЗ
			                      |	Документ.ЗаявкаНаБронирование.РаспределениеОплатДолги КАК ЗаявкаНаБронированиеРаспределениеОплатДолги
			                      |ГДЕ
			                      |	ЗаявкаНаБронированиеРаспределениеОплатДолги.Ссылка = &Ссылка
			                      |	И ЗаявкаНаБронированиеРаспределениеОплатДолги.СчетГУИД = &СчетГУИД
			                      |	И ЗаявкаНаБронированиеРаспределениеОплатДолги.ДокументОплаты = &ДокументОплаты
			                      |
			                      |СГРУППИРОВАТЬ ПО
			                      |	ЗаявкаНаБронированиеРаспределениеОплатДолги.Ссылка,
			                      |	ЗаявкаНаБронированиеРаспределениеОплатДолги.СчетГУИД,
			                      |	ЗаявкаНаБронированиеРаспределениеОплатДолги.ДокументОплаты");
			
			Запрос.УстановитьПараметр("Ссылка", СтрокаДолги.ДокументДолг);
			Запрос.УстановитьПараметр("СчетГУИД", СтрокаДолги.СчетГУИД);
			Запрос.УстановитьПараметр("ДокументОплаты", СтрокаОплаты.ДокументОплаты);
			
			Выборка = Запрос.Выполнить().Выбрать();
			
			Если Выборка.Следующий() Тогда
				СуммаОплаты = Выборка.СуммаОплаты; 
			Иначе
				СуммаОплаты = 0;
			КонецЕсли;
			
			СтрокаРаспределениеОплат = РаспределениеОплат.Добавить();
			
			СтрокаРаспределениеОплат.ДокументОплаты = СтрокаОплаты.ДокументОплаты;
			СтрокаРаспределениеОплат.ДокументДолг = СтрокаДолги.ДокументДолг;
			СтрокаРаспределениеОплат.СчетГУИД = СтрокаДолги.СчетГУИД;
			
			СтрокаРаспределениеОплат.СуммаОплаты = СуммаОплаты;
		КонецЦикла;
	КонецЦикла;
	
	Попытка 
		ГрупповойСчетОбъект.Записать(РежимЗаписиДокумента.Проведение);
	Исключение
		Сообщить("" + ГрупповойСчетОбъект.Ссылка + " Описание ошибки " + ОписаниеОшибки());
	КонецПопытки;
КонецЦикла;

	
КонецПроцедуры
