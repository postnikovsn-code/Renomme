Функция СуммаВ2В(СтрокаЗаявка, ПроцентВ2В, СтрокаПроживание) Экспорт
Если ПроцентВ2В <> 0  
И СтрокаЗаявка.В2В Тогда 
	СуммаВ2В = (Окр(СтрокаПроживание.Цена / ((100 - ПроцентВ2В)/ 100) - СтрокаПроживание.Цена) * СтрокаПроживание.Количество);
Иначе
	СуммаВ2В = 0;
КонецЕсли;

Возврат СуммаВ2В;
КонецФункции

//// + Цены, Суммы

Функция ДатаПереходаНаНовыйКалендарьЦен() Экспорт
Возврат '20240401';	
КонецФункции

// + ПСН
Функция ОкруглитьЦену(Цена) Экспорт
Возврат Цел(Цена);
КонецФункции

Функция ОкруглитьЦену_25(Цена) Экспорт
    Сотен = 100 * Цел(Цена/100);
    Рублей = Цена - Сотен;
    Если Рублей>=75 Тогда
        Рублей = 100;
    ИначеЕсли Рублей >= 25 Тогда
        Рублей = 50;
    Иначе
        Рублей = 0;        
    КонецЕсли;
    Возврат Сотен+Рублей;
КонецФункции

Функция ОкруглитьСумма(Сумма) Экспорт
//  Возврат Цел(Сумма);
Возврат Окр(Сумма, 2);
КонецФункции
// - ПСН

//
Функция ЦенаПроцентСкидкиБезЗавтрака(Цена, ПроцентСкидкиБезЗавтрака) Экспорт
Цена_П = Цена * (100.00 - ПроцентСкидкиБезЗавтрака)/100.00; 
Цена_П = ДокументыСервер.ОкруглитьЦену(Цена_П);

Возврат Цена_П;	
КонецФункции
//
Функция ПолучитьБонШансЦена(ДатаЦены)
Запрос = Новый Запрос("ВЫБРАТЬ ПЕРВЫЕ 1
                      |	ЦеныБонШанс.Цена КАК Цена
                      |ИЗ
                      |	РегистрСведений.ЦеныБонШанс КАК ЦеныБонШанс
                      |ГДЕ
                      |	ЦеныБонШанс.ДатаЦены <= &ДатаЦены
                      |
                      |УПОРЯДОЧИТЬ ПО
                      |	ЦеныБонШанс.ДатаЦены УБЫВ");
Запрос.УстановитьПараметр("ДатаЦены", ДатаЦены); 

Выборка = Запрос.Выполнить().Выбрать();

Если Выборка.Следующий() Тогда 
	Возврат Выборка.Цена;
Иначе 
	БонШансЦена = Константы.БонШансЦена.Получить();
	Возврат БонШансЦена;
КонецЕсли;
КонецФункции

// + ЗаполнитьТаблицуПроживания_Таблица 
Функция ЗаполнитьТаблицуПроживания_Таблица(Объект, Двухместный) Экспорт
//	
Если Объект.РезервПо < ДатаПереходаНаНовыйКалендарьЦен() Тогда
	ТЗ = ДокументыСервер_Старый.ЗаполнитьТаблицуПроживания_Таблица(Объект, Двухместный);
	Возврат ТЗ;
КонецЕсли;	
//

ПроцентСкидки = ИтогоСкидкаКлиент(Объект, Истина); 

Массив = Новый Массив();
ТЗ = Объект.Проживание.Выгрузить(Массив);

Если Объект.РезервС = Объект.РезервПо Тогда
	Если Объект.БонШанс Тогда
		НовДТ = ТЗ.Добавить();
		
		НовДТ.ДеньПроживания = Объект.РезервС;
		НовДТ.Количество = 1;
		
		Цена = ПолучитьБонШансЦена(НовДТ.ДеньПроживания);
		НовДТ.Цена = Цена;
		НовДТ.СуммаБезСкидки = НовДТ.Цена * НовДТ.Количество;
		НовДТ.Сумма = НовДТ.Цена * НовДТ.Количество;
		
	Иначе
		НовДТ = ТЗ.Добавить();
		
		НовДТ.ДеньПроживания = Объект.РезервС;
		
		НовДТ.Количество = 1;
		
		//Если Объект.ВремяЗаезда=Перечисления.ВремяЗаезда.Вр0 Тогда
		//	НовДТ.Количество = 2;
		//ИначеЕсли Объект.ВремяЗаезда=Перечисления.ВремяЗаезда.Вр6 Тогда
		//	НовДТ.Количество = 1.5;
		//Иначе
		//	НовДТ.Количество = 1;
		//КонецЕсли;		
		//
		//Если Объект.ВремяВыезда=Перечисления.ВремяВыезда.Вр18 Тогда	
		//	НовДТ.Количество = НовДТ.Количество + 0.5;
		//ИначеЕсли Объект.ВремяВыезда=Перечисления.ВремяВыезда.Вр0 Тогда	
		//	НовДТ.Количество = НовДТ.Количество + 1;
		//КонецЕсли;		
		
		ЗаполнитьЦенаСуммыСтрокаПроживание(НовДТ, Объект, Двухместный, ПроцентСкидки);
	КонецЕсли;		
	
Иначе

	ДТН=НачалоДня(Объект.РезервС);

	Пока ДТН<=НачалоДня(Объект.РезервПо - 86400) Цикл 
		НовДТ = ТЗ.Добавить();
		
		НовДТ.ДеньПроживания=ДТН;
		
		Если ДТН=НачалоДня(Объект.РезервС) Тогда 
			Если Объект.ВремяЗаезда=Перечисления.ВремяЗаезда.Вр0 Тогда
				НовДТ.Количество = 2;
			ИначеЕсли Объект.ВремяЗаезда=Перечисления.ВремяЗаезда.Вр6 Тогда
				НовДТ.Количество = 1.5;
			Иначе
				НовДТ.Количество = 1;
			КонецЕсли;		
		ИначеЕсли ДТН=НачалоДня(Объект.РезервПо-86400) Тогда // дата выезда
			Если Объект.ВремяВыезда=Перечисления.ВремяВыезда.Вр18 Тогда	
				НовДТ.Количество = 1.5;
			ИначеЕсли Объект.ВремяВыезда=Перечисления.ВремяВыезда.Вр0 Тогда	
				НовДТ.Количество = 2;
			Иначе	
				НовДТ.Количество = 1;
			КонецЕсли;
		Иначе 
			НовДТ.Количество=1;
		КонецЕсли;
		
		ЗаполнитьЦенаСуммыСтрокаПроживание(НовДТ, Объект, Двухместный, ПроцентСкидки);
		
		ДТН=ДТН+86400;
	КонецЦикла;
КонецЕсли;

Возврат ТЗ;
КонецФункции

Процедура ЗаполнитьЦенаСуммыСтрокаПроживание(Строка, Объект, Двухместный, ПроцентСкидки) Экспорт
ТарифныйПлан = Объект.ТарифныйПлан;

Если ЗначениеЗаполнено(ТарифныйПлан) Тогда
	Цена =  ДокументыСервер.ЦенаНаДеньТарифныйПлан(Строка.ДеньПроживания, ТарифныйПлан
		, Объект.КатегорияНомера, Объект.БезЗавтрака, Двухместный);
		
	Если Цена = 0 Тогда Перейти ~ЦЕНОВАЯ_ПОЛИТИКА; КонецЕсли;	

	Строка.Цена =  Цена;	
	Строка.СуммаБезСкидки = Строка.Цена * Строка.Количество;		
	
	Строка.Сумма = Строка.СуммаБезСкидки;
	
	Возврат;
КонецЕсли;

~ЦЕНОВАЯ_ПОЛИТИКА:	
Строка.Цена =  ДокументыСервер.ЦенаНаДень(Строка.ДеньПроживания, Объект.КатегорияНомера
	, Объект.БезЗавтрака, Двухместный);

Строка.СуммаБезСкидки = Строка.Цена * Строка.Количество;

ЗаполнитьСтрокаПроживаниеСкидкаСумма(Строка, ПроцентСкидки);
КонецПроцедуры

Функция ЦенаНаДень(ДТН, КатегорияНомера, БезЗавтрака, Двухместный) Экспорт
//	
Если ДТН < ДатаПереходаНаНовыйКалендарьЦен() Тогда
	Цена = ДокументыСервер_Старый.ПолучитьЦенуПоЦеновойПолитике(ДТН, КатегорияНомера, БезЗавтрака, Двухместный);
	Возврат Цена;
КонецЕсли;	
//
	
Цена = ПолучитьЦенуПоЦеновойПолитике(ДТН, КатегорияНомера, БезЗавтрака, Двухместный);
Возврат Цена;
КонецФункции	

Функция ЦенаНаДеньТарифныйПлан(ДТН, ТарифныйПлан, КатегорияНомера
			, Знач БезЗавтрака, Двухместный) Экспорт
	Если НЕ ЗначениеЗаполнено(ТарифныйПлан) Тогда Возврат 0; КонецЕсли; 
	
	Если Двухместный = Неопределено Тогда Возврат 0; КонецЕсли;	

	БезЗавтракаПараметр = БезЗавтрака;	
	
	ВыходнойДень = ДеньНедели(ДТН) > 4;
	
	ТарифныйПланСтроки = ТарифныйПлан.ТарифныйПланСтроки.Выгрузить();
	
	ТарифныйПланСтроки.Сортировать("ДатаТарифаС, ДатаТарифаПо");
	
	СтрокаТарифа = Неопределено;
	Для Каждого Строка Из ТарифныйПланСтроки Цикл
		Если ЗначениеЗаполнено(Строка.ДатаТарифаС) Тогда
			Если Строка.ДатаТарифаС > ДТН Тогда
				Продолжить;
			КонецЕсли;
		КонецЕсли;	
		
		Если ЗначениеЗаполнено(Строка.ДатаТарифаПо) Тогда
			Если Строка.ДатаТарифаПо < ДТН Тогда
				Продолжить;
			КонецЕсли;
		КонецЕсли;
		
		Если ЗначениеЗаполнено(Строка.КатегорияНомера) Тогда
			Если Строка.КатегорияНомера <> КатегорияНомера Тогда
				Продолжить;
			КонецЕсли;
		КонецЕсли;           
		
		СтрокаТарифа = Строка;
		Прервать;
	КонецЦикла;
	
	Если СтрокаТарифа = Неопределено Тогда Возврат 0; КонецЕсли;	
	
	Если ВыходнойДень И Двухместный И БезЗавтракаПараметр  Тогда
		ЦенаВыходныеДвухБезЗавтрака = ?(СтрокаТарифа.ЦенаВыходныеДвухБезЗавтрака = 0
			, СтрокаТарифа.ЦенаВыходныеДвух, СтрокаТарифа.ЦенаВыходныеДвухБезЗавтрака); 
		
		Цена	= ЦенаВыходныеДвухБезЗавтрака;
	ИначеЕсли ВыходнойДень И Двухместный И (НЕ БезЗавтракаПараметр) Тогда
		Цена	= СтрокаТарифа.ЦенаВыходныеДвух;
		
	ИначеЕсли ВыходнойДень И (НЕ Двухместный) И БезЗавтракаПараметр  Тогда
		ЦенаВыходныеБезЗавтрака = ?(СтрокаТарифа.ЦенаВыходныеБезЗавтрака = 0
			, СтрокаТарифа.ЦенаВыходные, СтрокаТарифа.ЦенаВыходныеБезЗавтрака); 
		
		Цена	= ЦенаВыходныеБезЗавтрака;
	ИначеЕсли ВыходнойДень И (НЕ Двухместный) И (НЕ БезЗавтракаПараметр) Тогда
		Цена	= СтрокаТарифа.ЦенаВыходные;
		
//		
	ИначеЕсли (НЕ ВыходнойДень) И Двухместный И БезЗавтракаПараметр  Тогда
		ЦенаБудниДвухБезЗавтрака = ?(СтрокаТарифа.ЦенаБудниДвухБезЗавтрака = 0
			, СтрокаТарифа.ЦенаБудниДвух, СтрокаТарифа.ЦенаБудниДвухБезЗавтрака); 
			
		Цена	= ЦенаБудниДвухБезЗавтрака;
	ИначеЕсли (НЕ ВыходнойДень) И Двухместный И (НЕ БезЗавтракаПараметр) Тогда
		Цена	= СтрокаТарифа.ЦенаБудниДвух;
		
	ИначеЕсли (НЕ ВыходнойДень) И (НЕ Двухместный) И БезЗавтракаПараметр  Тогда
		ЦенаБудниБезЗавтрака = ?(СтрокаТарифа.ЦенаБудниБезЗавтрака = 0
			, СтрокаТарифа.ЦенаБудни, СтрокаТарифа.ЦенаБудниБезЗавтрака); 
		
		Цена	= ЦенаБудниБезЗавтрака;
	ИначеЕсли (НЕ ВыходнойДень) И (НЕ Двухместный) И (НЕ БезЗавтракаПараметр) Тогда
		Цена	= СтрокаТарифа.ЦенаБудни;
	КонецЕсли;

	Возврат Цена;
КонецФункции

Функция ПолучитьЦенуПоЦеновойПолитике(ДТН, КатегорияНомера, БезЗавтрака, Двухместный) Экспорт
	
Если ДТН < ДатаПереходаНаНовыйКалендарьЦен() Тогда
	Цена = ДокументыСервер_Старый.ПолучитьЦенуПоЦеновойПолитике(ДТН, КатегорияНомера, БезЗавтрака, Двухместный);
	Возврат Цена;
КонецЕсли;	

Результат = КалендарьЦен.ПолучитьТекущаяЦенаДня(ДТН, КатегорияНомера, БезЗавтрака);	
Если Двухместный Тогда
	Цена = Результат.ТекущаяЦенаДняДвухместный;
Иначе
	Цена = Результат.ТекущаяЦенаДняОдноместный;
КонецЕсли;

Возврат Цена;
КонецФункции

Процедура ЗаполнитьСтрокаПроживаниеСкидкаСумма(Строка, ПроцентСкидки) Экспорт
	//Строка.ПроцентСкидкиКлиента = ДокументыСервер.ИтогоСкидка(Объект);
	Строка.ПроцентСкидкиКлиента = ПроцентСкидки;
	ЗаполнитьСуммаСоСкидкойСтрокаПроживание(Строка);
КонецПроцедуры

Процедура ЗаполнитьСуммаСоСкидкойСтрокаПроживание(Строка) Экспорт
Строка.Сумма = ДокументыСервер.ОкруглитьСумма((Строка.СуммаБезСкидки * (1 - (Строка.ПроцентСкидкиКлиента/100))));
КонецПроцедуры	

Функция ИтогоСкидкаКлиент(Объект, ИзЗаявки) Экспорт
ИтогоСкидка = ДокументыСервер.ИтогоСкидка(Объект);	

Если ИзЗаявки Тогда
	СкидкаКлиент = Объект.СкидкаКлиента;
Иначе
	Результат = СкидкаКлиента(Объект);
	СкидкаКлиент = Результат.Скидка;
КонецЕсли;

Если ИтогоСкидка > СкидкаКлиент Тогда
	Возврат ИтогоСкидка;
Иначе
	Возврат СкидкаКлиент;
КонецЕсли;

КонецФункции


Функция СкидкаКлиента(Объект) Экспорт
Результат = Новый Структура("Скидка, Уровень", 0, 0);	
	
Если НЕ НастройкиСервер.ЭтоРеноме()	Тогда Возврат Результат; КонецЕсли;
	
Если НЕ ЗначениеЗаполнено(Объект.Клиент) Тогда Возврат Результат; КонецЕсли;

Если НЕ ЗначениеЗаполнено(Объект.РезервС) Тогда Возврат Результат; КонецЕсли;

Если Объект.Клиент.ТипКлиента = Перечисления.ТипыКлиентов.ЮрЛицо Тогда Возврат Результат; КонецЕсли;

Запрос = Новый Запрос("ВЫБРАТЬ
                      |	ЗаявкаНаБронированиеСчета.Ссылка КАК Ссылка,
                      |	ЗаявкаНаБронированиеСчета.СчетГУИД КАК СчетГУИД,
                      |	СчетаДолги.КоличествоНочей КАК КоличествоНочей,
                      |	ЗаявкаНаБронированиеСчета.ГрупповойСчет КАК ГрупповойСчет,
                      |	ЗаявкаНаБронированиеСчета.ЭтоПредварительныйГрупповойСчет КАК ЭтоПредварительныйГрупповойСчет,
                      |	ЗаявкаНаБронированиеСчета.Контрагент КАК Контрагент,
                      |	ЗаявкаНаБронированиеСчета.Клиент КАК Клиент,
                      |	ЗаявкаНаБронированиеСчета.Ссылка.Бронирует КАК Бронирует
                      |ИЗ
                      |	Документ.ЗаявкаНаБронирование.Счета КАК ЗаявкаНаБронированиеСчета
                      |		ВНУТРЕННЕЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
                      |			ЗаявкаНаБронированиеСчетаДетальноДолги.Ссылка КАК Ссылка,
                      |			ЗаявкаНаБронированиеСчетаДетальноДолги.СчетГУИД КАК СчетГУИД,
                      |			КОЛИЧЕСТВО(РАЗЛИЧНЫЕ ЗаявкаНаБронированиеСчетаДетальноДолги.ДолгиГУИД) КАК КоличествоНочей
                      |		ИЗ
                      |			Документ.ЗаявкаНаБронирование.СчетаДетальноДолги КАК ЗаявкаНаБронированиеСчетаДетальноДолги
                      |		ГДЕ
                      |			ЗаявкаНаБронированиеСчетаДетальноДолги.Услуга = ЛОЖЬ
                      |		
                      |		СГРУППИРОВАТЬ ПО
                      |			ЗаявкаНаБронированиеСчетаДетальноДолги.Ссылка,
                      |			ЗаявкаНаБронированиеСчетаДетальноДолги.СчетГУИД) КАК СчетаДолги
                      |		ПО ЗаявкаНаБронированиеСчета.Ссылка = СчетаДолги.Ссылка
                      |			И ЗаявкаНаБронированиеСчета.СчетГУИД = СчетаДолги.СчетГУИД
                      |ГДЕ
                      |	ЗаявкаНаБронированиеСчета.Ссылка.ПометкаУдаления = ЛОЖЬ
                      |	И ЗаявкаНаБронированиеСчета.Ссылка.Статус = ЗНАЧЕНИЕ(Перечисление.СтатусБрони.Выехал)
                      |	И ЗаявкаНаБронированиеСчета.Клиент = &Клиент
                      |	И ЗаявкаНаБронированиеСчета.Ссылка.РезервС < &РезервС
                      |	И ЗаявкаНаБронированиеСчета.Ссылка.РезервС >= &НачалоСкидкаКлиента");

Запрос.УстановитьПараметр("РезервС", Объект.РезервС);
Запрос.УстановитьПараметр("Клиент", Объект.Клиент);
НачалоСкидкаКлиента = НачалоСкидкаКлиента();
Запрос.УстановитьПараметр("НачалоСкидкаКлиента", НачалоСкидкаКлиента);

ТЗ = Запрос.Выполнить().Выгрузить();

КоличествоНочей = 0;
Для Каждого Строка Из ТЗ Цикл 
	//Если Строка.Бронирует.Турагентство 
	//ИЛИ Строка.Бронирует.ТипКлиента = Перечисления.ТипыКлиентов.ЮрЛицо 
	//Тогда Продолжить; КонецЕсли;
	
	Если Строка.ЭтоПредварительныйГрупповойСчет 
	ИЛИ ЗначениеЗаполнено(Строка.ГрупповойСчет) 
	Тогда
		Если Строка.Клиент <> Строка.Бронирует Тогда Продолжить; КонецЕсли;
	КонецЕсли;
	
	КоличествоНочей = КоличествоНочей + Строка.КоличествоНочей; 	
КонецЦикла;

Если КоличествоНочей = 0 Тогда Возврат Результат; КонецЕсли;

Запрос = Новый Запрос("ВЫБРАТЬ
                      |	СкидкиКлиента.КоличествоНочей КАК КоличествоНочей,
                      |	СкидкиКлиента.Скидка КАК Скидка,
                      |	СкидкиКлиента.Уровень КАК Уровень
                      |ИЗ
                      |	РегистрСведений.СкидкиКлиента КАК СкидкиКлиента
                      |
                      |УПОРЯДОЧИТЬ ПО
                      |	КоличествоНочей");

ТЗ = Запрос.Выполнить().Выгрузить();

СкидкаКлиента = 0;
Для Каждого Строка Из ТЗ Цикл
	Если Строка.КоличествоНочей >= КоличествоНочей Тогда Прервать; КонецЕсли;
 	
	СкидкаКлиента = Строка.Скидка;		
	Уровень = Строка.Уровень;	
КонецЦикла;

Результат.Скидка = СкидкаКлиента;
Результат.Уровень = Уровень;
Возврат Результат;
КонецФункции

Функция НачалоСкидкаКлиента() 
НачалоСкидкаКлиента = '20250601';	
Возврат НачалоСкидкаКлиента;	
КонецФункции

Функция ИтогоСкидка(Объект) Экспорт
ИтогоСкидка = 0;
Если ЗначениеЗаполнено(Объект.Бронирует) Тогда 
	Если Объект.Бронирует.Турагентство Тогда 
		Если ЗначениеЗаполнено(Объект.Оплачивает) Тогда
			Если Объект.Бронирует = Объект.Оплачивает Тогда 		
				Если Объект.Бронирует.ТипОплатыСчета = Перечисления.ТипОплатыСчета.Взаимозачет
				ИЛИ Объект.Бронирует.ТипОплатыСчета = Перечисления.ТипОплатыСчета.ОплатаТурагентствомСоСкидкой 
				Тогда
					ИтогоСкидка = ПроцентКомиссииКлиента(Объект.Бронирует, Объект.РезервС);
				Иначе	
					ИтогоСкидка=Объект.Оплачивает.Категория.Скидка;
				КонецЕсли;
			Иначе
				ИтогоСкидка=Объект.Оплачивает.Категория.Скидка;
			КонецЕсли;
		Иначе
			ИтогоСкидка=Объект.Клиент.Категория.Скидка;
		КонецЕсли;	
	Иначе
		Если ЗначениеЗаполнено(Объект.Оплачивает) Тогда
			ИтогоСкидка = Объект.Оплачивает.Категория.Скидка;
		Иначе
			ИтогоСкидка=Объект.Клиент.Категория.Скидка;
		КонецЕсли;		
	КонецЕсли;	
Иначе
	Если ЗначениеЗаполнено(Объект.Оплачивает) Тогда
		ИтогоСкидка=Объект.Оплачивает.Категория.Скидка;
	Иначе
		ИтогоСкидка=Объект.Клиент.Категория.Скидка;
	КонецЕсли;		
КонецЕсли;		

Возврат ИтогоСкидка;
КонецФункции	

Функция ПроцентКомиссииКлиента(Клиент, ДатаНачалаДействия) Экспорт
