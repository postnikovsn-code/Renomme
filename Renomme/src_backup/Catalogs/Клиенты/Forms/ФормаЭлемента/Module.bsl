Процедура КодОрганаПриИзменении(Элемент)
Если СокрЛП(Объект.КодОргана) = "" Тогда Перейти ~ВЫХОД; КонецЕсли;

ТипДокументаФМС_ID = ОбщийФункционалСервер.ЗначениеРеквизитаНаСервере(Объект.ТипДокументаФМС_NEW, "ID");
Если НЕ КодОрганаРазрешен(ТипДокументаФМС_ID) Тогда Перейти ~ВЫХОД; КонецЕсли;

НовыйМассив = Новый Массив;

Результат = КлиентыСервер.ПунктыВыдачиФМС(Объект.КодОргана, Объект.ДатаВыдачи); 
ПунктыВыдачиФМС = Результат.ПунктыВыдачиФМС; 

НовыйМассив = Новый Массив;
Если ЗначениеЗаполнено(ПунктыВыдачиФМС) Тогда
	Объект.ПунктыВыдачиФМС_NEW = ПунктыВыдачиФМС;
	
	Если Результат.СостояниеВыбора = "НЕТ ДАННЫХ" Тогда
		ПоказатьПредупреждение(, "Уточните 'Кем выдан'");
	ИначеЕсли Результат.СостояниеВыбора = "НЕТ ДАТЫ" Тогда
		ПоказатьПредупреждение(, "'Дата выдачи' - пусто
			| Уточните 'Кем выдан'");
	КонецЕсли;
	
	НовыйПараметр = Новый ПараметрВыбора("Отбор.CODE_0", Объект.КодОргана);
	НовыйМассив.Добавить(НовыйПараметр);

Иначе
	ТекстПредупреждения = "У Клиента: " + Объект.Наименование + " 
		| некорректный реквизит 'код органа, выдавшего паcпорт'.
		|
		|Тип документа - паспорт РФ или разрешение на временное проживание ЛБГ.";  	

	ПоказатьПредупреждение(, ТекстПредупреждения);
	Сообщить(ТекстПредупреждения);
КонецЕсли;	

~ВЫХОД:
НовыеПараметры = Новый ФиксированныйМассив(НовыйМассив);
Элементы.ПунктыВыдачиФМС.ПараметрыВыбора = НовыеПараметры;
