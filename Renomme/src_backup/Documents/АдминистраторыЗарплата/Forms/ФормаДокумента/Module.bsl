&НаКлиенте
Процедура УстановитьПрочееОтбор()
ОтборСтрок = Новый Структура;
Если ЗначениеЗаполнено(ПрочееАдминистраторОтбор) Тогда
	ОтборСтрок.Вставить("Администратор", ПрочееАдминистраторОтбор);
КонецЕсли;

Если ЗначениеЗаполнено(ПрочееДатаОтбор) Тогда
	ОтборСтрок.Вставить("Дата", ПрочееДатаОтбор);
КонецЕсли;

Если ЗначениеЗаполнено(ПрочееНаименованиеОтбор) Тогда
	ОтборСтрок.Вставить("Наименование", ПрочееНаименованиеОтбор);
КонецЕсли;

Если ОтборСтрок.Количество() = 0 Тогда
	Элементы.Прочее.ОтборСтрок = Неопределено;
Иначе
	Элементы.Прочее.ОтборСтрок = Новый ФиксированнаяСтруктура(ОтборСтрок);
КонецЕсли;	
КонецПроцедуры
