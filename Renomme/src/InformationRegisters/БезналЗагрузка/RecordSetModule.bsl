
Процедура ПередЗаписью(Отказ, Замещение)
Если ОбменДанными.Загрузка Тогда Возврат; КонецЕсли; 
	
Если ЭтотОбъект.Количество() = 0 Тогда	
	Запрос = Новый Запрос("ВЫБРАТЬ
	                      |	БезналЗагрузка.ПолучательПлатежа КАК ПолучательПлатежа,
	                      |	БезналЗагрузка.СуммаЧехов КАК СуммаЧехов,
	                      |	БезналЗагрузка.СуммаЛайв КАК СуммаЛайв,
	                      |	БезналЗагрузка.СуммаДомСоветов КАК СуммаДомСоветов,
	                      |	БезналЗагрузка.СуммаРеноме КАК СуммаРеноме,
	                      |	БезналЗагрузка.СуммаСтритАрт КАК СуммаСтритАрт
	                      |ИЗ
	                      |	РегистрСведений.БезналЗагрузка КАК БезналЗагрузка
	                      |ГДЕ
	                      |	БезналЗагрузка.ГУИД = &ГУИД");
	Запрос.УстановитьПараметр("ГУИД", Отбор.ГУИД.Значение);
	Выборка = Запрос.Выполнить().Выбрать();
	Выборка.Следующий();
	
	Данные = Выборка;	
Иначе
	Данные = ЭтотОбъект[0];
КонецЕсли;

Если НастройкиСервер.ЭтоЛайв() Тогда
	Если Данные.СуммаЧехов > 0 Тогда
		Узел = ПланыОбмена.ОбменГостиницы.НайтиПоКоду("ЧЕХОВ");	
		ПланыОбмена.ЗарегистрироватьИзменения(Узел, ЭтотОбъект);
	КонецЕсли;
	
