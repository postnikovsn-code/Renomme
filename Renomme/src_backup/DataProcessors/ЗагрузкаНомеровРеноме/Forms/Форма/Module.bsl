&НаСервере
Процедура ЗагрузитьНомераНаСервере()
ПараметрыСоединения = ПараметрыСоединения();
Соединение = Новый COMОбъект("V83.COMConnector");
Попытка
	База = Соединение.Connect(ПараметрыСоединения);
Исключение
	Сообщить("Ошибка подключения! " + ОписаниеОшибки());
	Возврат ;
КонецПопытки;

Запрос = База.NewObject("Запрос");
Запрос.Текст = 
  "ВЫБРАТЬ
                       |	НомернойФонд.Ссылка,
                       |	НомернойФонд.Код,
                       |	НомернойФонд.Наименование,
                       |	НомернойФонд.Этаж,
                       |	НомернойФонд.КатегорияНомера,
                       |	НомернойФонд.Курящий
                       |ИЗ
                       |	Справочник.НомернойФонд КАК НомернойФонд
                       |ГДЕ
                       |	НомернойФонд.ПометкаУдаления = ЛОЖЬ";

	
ТЗ = Запрос.Выполнить().Выгрузить(); 	

Для Каждого Строка Из ТЗ Цикл
	НомерОтель = Справочники.НомернойФонд.НайтиПоКоду(Строка.Код);
	Если НЕ ЗначениеЗаполнено(НомерОтель) Тогда
		НомерОтельОбъект = Справочники.НомернойФонд.СоздатьЭлемент();
		
		НомерОтельОбъект.Код = Строка.Код;
		НомерОтельОбъект.Наименование = Строка.Наименование;
		
		НомерОтельОбъект.Этаж = Строка.Этаж;
		
		КатегорияНомера = Справочники.КатегорииНомеров.НайтиПоКоду(Строка.КатегорияНомера.Код);
		НомерОтельОбъект.КатегорияНомера = КатегорияНомера;
		
		НомерОтельОбъект.Курящий = Строка.Курящий;
		
		НомерОтельОбъект.Записать();
	КонецЕсли;	
	
КонецЦикла;	
КонецПроцедуры

Функция ИмяЗначенияПеречисление(Соединение, Значение) 
Если Значение.Пустая() Тогда Возврат ""; КонецЕсли;
     
//получаем как названо перечисление в конфигураторе
ИмяПеречисления = Значение.Метаданные().Имя;

//теперь получим индекс где хранится то что нам надо
НужныйИндекс = Соединение.Перечисления[ИмяПеречисления].Индекс(Значение);

//и вот счастье. то что нам надо - идентификатор!!! всего-то четыре строчки кода
//ИмяЗначения = Соединение.Метаданные.Перечисления[ИмяПеречисления].ЗначенияПеречисления[НужныйИндекс].Имя;     
ЗначенияПеречисления = Соединение.Метаданные.Перечисления[ИмяПеречисления].ЗначенияПеречисления;
Индекс = 0;
Для Каждого ЗначениеПеречисления Из ЗначенияПеречисления Цикл
	Если Индекс = НужныйИндекс Тогда  Возврат ЗначениеПеречисления.Имя;	КонецЕсли;
	Индекс = Индекс + 1;
КонецЦикла;	

Возврат "";     
КонецФункции


