&НаСервере
Процедура ЗагрузитьКатегорииНомеровНаСервере()
ПараметрыСоединения = ПараметрыСоединения();
Соединение = Новый COMОбъект("V83.COMConnector");
Попытка
	База = Соединение.Connect(ПараметрыСоединения);
Исключение
	Сообщить("Ошибка подключения! " + ОписаниеОшибки());
	Возврат ;
КонецПопытки;

Запрос = База.NewObject("Запрос");
Запрос.Текст = 
    "ВЫБРАТЬ
    |	КатегорииНомеров.Код КАК Код,
    |	КатегорииНомеров.Наименование КАК Наименование
    |ИЗ
    |	Справочник.КатегорииНомеров КАК КатегорииНомеров
    |ГДЕ
    |	КатегорииНомеров.ПометкаУдаления = ЛОЖЬ";
	
ТЗ = Запрос.Выполнить().Выгрузить(); 	

Для Каждого Строка Из ТЗ Цикл
	КатегорияНомера = Справочники.КатегорииНомеров.НайтиПоКоду(Строка.Код);
	Если НЕ ЗначениеЗаполнено(КатегорияНомера) Тогда
		КатегорияНомераОбъект = Справочники.КатегорииНомеров.СоздатьЭлемент();
		КатегорияНомераОбъект.Код = Строка.Код;
		КатегорияНомераОбъект.Наименование = Строка.Наименование;
		КатегорияНомераОбъект.Записать();
	КонецЕсли;	
КонецЦикла;	
КонецПроцедуры


