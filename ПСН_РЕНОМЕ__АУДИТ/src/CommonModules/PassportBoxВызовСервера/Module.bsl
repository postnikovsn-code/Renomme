// Заполняет реквизиты по полям ответа JSON через набор соответствий ключей.
// ПО сканера PassportBox для одного и того же логического поля может вернуть
// до трёх вариантов значения из разных источников (OCR разворота, MRZ, отдельный
// снимок 3-й страницы) с разными именами json-ключей. Маппинги для этих
// источников передаются в массиве ИсточникиСоответствий в порядке возрастания
// приоритета: более приоритетный непустой источник перезаписывает менее
// приоритетный. Пустые значения никогда не перезаписывают уже заполненное.
//
// Параметры:
//   Реквизиты              - Структура - целевая структура, заполняется по месту.
//   ИсточникиСоответствий  - Массив из Соответствие - маппинги "json-ключ" -> "ключ реквизита"
//                            в порядке возрастания приоритета (последний выигрывает).
//   ПоляJSON               - Массив   - элементы ответа JSON (поля Ключ/Значение).
//   ОжидаемыйТипДокумента  - Строка   - проверяемое значение поля "doc_type".
//
// Возвращаемое значение:
//   Строка - описание ошибки (например, неверный тип документа) или "" при успехе.
Функция ЗаполнитьПоляИзJSON(Реквизиты, ИсточникиСоответствий, ПоляJSON, ОжидаемыйТипДокумента)
	Для Каждого Поле Из ПоляJSON Цикл
		Если Поле.Ключ = "doc_type" И Поле.Значение <> ОжидаемыйТипДокумента Тогда
			Возврат "Неверный тип документа: " + Поле.Значение;
		КонецЕсли;
	КонецЦикла;
	Для Каждого Соответствие Из ИсточникиСоответствий Цикл
		Для Каждого Поле Из ПоляJSON Цикл
			КлючРеквизита = Соответствие.Получить(Поле.Ключ);
			Если КлючРеквизита <> Неопределено И Поле.Значение <> "" Тогда
				Реквизиты.Вставить(КлючРеквизита, Поле.Значение);
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;
	Возврат "";
КонецФункции

// Проверяет, что все обязательные поля реквизитов заполнены непустыми строками.
//
// Параметры:
//   Реквизиты  - Структура       - проверяемые реквизиты.
//   ИменаПолей - Массив из Строка - имена обязательных полей.
//
// Возвращаемое значение:
//   Строка - описание ошибки или "" при успехе.
Функция ПроверитьОбязательныеПоля(Реквизиты, ИменаПолей)
	Для Каждого Имя Из ИменаПолей Цикл
		Если Реквизиты[Имя] = "" Тогда
			Возврат "Страница не распознана: отсутствует поле " + Имя;
		КонецЕсли;
	КонецЦикла;
	Возврат "";
КонецФункции

// Загружает с устройства фотографии разворота 2-3 паспорта.
//
// Параметры:
//   Соединение         - Структура - см. СоздатьСоединение.
//   СписокИзображений  - Массив из Строка - имена изображений из ответа РаспознатьДокумент.
//
// Возвращаемое значение:
//   Структура - { Ошибка, Описание, Значение } где Значение -
//               Структура { Страница2, Страница3 } - ДвоичныеДанные.
Функция ПолучитьФотографииПаспорта(Соединение, СписокИзображений)
	Страница2Найдена = Ложь;
	Страница3Найдена = Ложь;
	Для Каждого ИмяКартинки Из СписокИзображений Цикл
		Если ИмяКартинки = "rus.passport.national:page2" Тогда
			Страница2Найдена = Истина;
		КонецЕсли;
		Если ИмяКартинки = "rus.passport.national:page3" Тогда
			Страница3Найдена = Истина;
		КонецЕсли;
	КонецЦикла;
//	Если Не Страница2Найдена Тогда
//		Возврат НоваяОшибка("Отсутствует фотография 2ой страницы");
//	КонецЕсли;
	Если Не Страница3Найдена Тогда
		Возврат НоваяОшибка("Отсутствует фотография 3ей страницы");
	КонецЕсли;
//	Картинка2 = ПолучитьКартинку(Соединение, "rus.passport.national:page2");
//	Если Картинка2.Ошибка Тогда
//		Возврат НоваяОшибка("Ошибка получения фотографии 2ой страницы: " + Картинка2.Описание);
//	КонецЕсли;
	Картинка3 = ПолучитьКартинку(Соединение, "rus.passport.national:page3");
	Если Картинка3.Ошибка Тогда
		Возврат НоваяОшибка("Ошибка получения фотографии 3ей страницы: " + Картинка3.Описание);
	КонецЕсли;
	Фотографии = Новый Структура;
//	Фотографии.Вставить("Страница2", Картинка2.ДанныеКартинки);
	Фотографии.Вставить("Страница3", Картинка3.ДанныеКартинки);
	Возврат НовоеЗначение(Фотографии);
КонецФункции

// Загружает с устройства фотографию страницы регистрации.
//
// Параметры:
//   Соединение         - Структура - см. СоздатьСоединение.
//   СписокИзображений  - Массив из Строка - имена изображений из ответа РаспознатьДокумент.
//
// Возвращаемое значение:
//   Структура - { Ошибка, Описание, Значение } где Значение -
//               Структура { Регистрация } - ДвоичныеДанные.
Функция ПолучитьФотографиюРегистрации(Соединение, СписокИзображений)
	ИмяКартинкиРегистрации = "";
	Для Каждого ИмяКартинки Из СписокИзображений Цикл
		Если СтрНайти(ИмяКартинки, "rus.passport.registration:") = 1 Тогда
			ИмяКартинкиРегистрации = ИмяКартинки;
		КонецЕсли;
	КонецЦикла;
	Если ИмяКартинкиРегистрации = "" Тогда
		Возврат НоваяОшибка("Отсутствует фотография страницы регистрации");
	КонецЕсли;
	Картинка = ПолучитьКартинку(Соединение, ИмяКартинкиРегистрации);
	Если Картинка.Ошибка Тогда
		Возврат НоваяОшибка("Ошибка получения фотографии страницы прописки: " + Картинка.Описание);
	КонецЕсли;
	Фотографии = Новый Структура;
	Фотографии.Вставить("Регистрация", Картинка.ДанныеКартинки);
	Возврат НовоеЗначение(Фотографии);
КонецФункции

// Конструктор результата-ошибки.
//
// Параметры:
//   Описание - Строка - текст ошибки.
//
// Возвращаемое значение:
//   Структура - { Ошибка = Истина, Описание = Описание }.
Функция НоваяОшибка(Знач Описание)
	Результат = Новый Структура;
	Результат.Вставить("Ошибка", Истина);
	Результат.Вставить("Описание", Описание);
	Возврат Результат;
КонецФункции

// Конструктор результата-успеха с произвольным значением.
//
// Параметры:
//   Значение - Произвольный - полезная нагрузка результата.
//
// Возвращаемое значение:
//   Структура - { Ошибка = Ложь, Описание = "", Значение }.
Функция НовоеЗначение(Знач Значение)
	Результат = Новый Структура;
	Результат.Вставить("Ошибка", Ложь);
	Результат.Вставить("Описание", "");
	Результат.Вставить("Значение", Значение);
	Возврат Результат;
КонецФункции

// Конструктор результата распознавания.
//
// Параметры:
//   Реквизиты  - Структура - распознанные реквизиты документа.
//   Фотографии - Структура - двоичные данные фотографий страниц.
//
// Возвращаемое значение:
//   Структура - { Ошибка = Ложь, Описание = "", Реквизиты, Фотографии }.
Функция НовыйРезультатДанных(Знач Реквизиты, Знач Фотографии)
	Результат = Новый Структура;
	Результат.Вставить("Ошибка", Ложь);
	Результат.Вставить("Описание", "");
	Результат.Вставить("Реквизиты", Реквизиты);
	Результат.Вставить("Фотографии", Фотографии);
	Возврат Результат;
КонецФункции

#КонецОбласти
