//
Процедура ОбновитьИсториюКлиента(ЭтотОбъект) Экспорт 
Клиент = ЭтотОбъект.Клиент;	
//Заявка = ЭтотОбъект.Ссылка;	
ЗаявкаГУИД = ЭтотОбъект.Ссылка.УникальныйИдентификатор();
	
ИсторияКлиента = РегистрыСведений.ИсторияКлиента.СоздатьНаборЗаписей();

//ИсторияКлиента.Отбор.Клиент.Установить(Клиент);
//ИсторияКлиента.Отбор.Заявка.Установить(Заявка);
//ИсторияКлиента.Отбор.ЗаявкаГУИД.Установить(ГУИД);

ИсторияКлиента.Отбор.ЗаявкаГУИД.Установить(ЗаявкаГУИД);
Для Каждого Строка Из ИсторияКлиента Цикл
	ИсторияКлиента.Удалить(Строка);
КонецЦикла;
	
НоваяЗапись = ИсторияКлиента.Добавить();

НоваяЗапись.Клиент = Клиент;
//НоваяЗапись.Заявка = Заявка;
НоваяЗапись.ЗаявкаГУИД = ЗаявкаГУИД;

НоваяЗапись.ДатаЗаявки = ЭтотОбъект.Дата;
НоваяЗапись.РезервС = ЭтотОбъект.РезервС;
НоваяЗапись.РезервПо = ЭтотОбъект.РезервПо;
НоваяЗапись.НомерВрезерв = ЭтотОбъект.НомерВрезерв.Наименование;

НоваяЗапись.Статус = ЭтотОбъект.Статус;
	
ИсторияКлиента.Записать(Истина);
	
ИсторияКлиентаДопПожелания = РегистрыСведений.ИсторияКлиентаДопПожелания.СоздатьНаборЗаписей();
//ИсторияКлиентаДопПожелания.Отбор.Клиент.Установить(Клиент);
//ИсторияКлиентаДопПожелания.Отбор.Заявка.Установить(Заявка);
//ИсторияКлиентаДопПожелания.Отбор.ЗаявкаГУИД.Установить(ГУИД);

ИсторияКлиентаДопПожелания.Отбор.ЗаявкаГУИД.Установить(ЗаявкаГУИД);
Для Каждого Строка Из ИсторияКлиентаДопПожелания Цикл
	ИсторияКлиентаДопПожелания.Удалить(Строка);
КонецЦикла;

Индекс = 0;
Для Каждого Строка Из ЭтотОбъект.ДопПожелания Цикл
	НоваяЗапись = ИсторияКлиентаДопПожелания.Добавить();
	
	НоваяЗапись.Клиент = Клиент;
	//НоваяЗапись.Заявка = Заявка;
	НоваяЗапись.ЗаявкаГУИД = ЗаявкаГУИД;
