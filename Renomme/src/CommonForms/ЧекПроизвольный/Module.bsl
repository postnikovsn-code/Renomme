Процедура ВывестиЧек() 
ВыполнитьОперацию_ФУ();
КонецПроцедуры

&НаКлиенте
Процедура ВыполнитьОперацию_ФУ()
	ПоддерживаемыеТипыВО = Новый Массив();
	//ПоддерживаемыеТипыВО.Добавить("ФискальныйРегистратор");
	//ПоддерживаемыеТипыВО.Добавить("ПринтерЧеков");
	ПоддерживаемыеТипыВО.Добавить("ККТ");
	
	ДопПараметры = Новый Структура("ЭтоКоворкинг", ЭтоКоворкинг);
			 
	ОписаниеОповещения = Новый ОписаниеОповещения("ВыполнитьОперациюВыбораУстройства_ФУ", ЭтотОбъект, ДопПараметры); 
	МенеджерОборудованияКлиент.ВыбратьУстройство(ОписаниеОповещения, ПоддерживаемыеТипыВО,
		НСтр("ru='Выберите фискальное устройство'"), 
		НСтр("ru='Фискальное устройство не подключено.'"), 
		НСтр("ru='Фискальное устройство не выбрано.'"));
КонецПроцедуры

&НаКлиенте
Процедура ВыполнитьОперациюВыбораУстройства_ФУ(РезультатВыбора, ДополнительныеПараметры) Экспорт
Если НЕ РезультатВыбора.Результат Тогда
	ТекстСообщения = ТекстСообщения + "Ошибка выбора ККМ: " + РезультатВыбора.ОписаниеОшибки;      
	ТекстПредупреждения = ТекстПредупреждения + "Ошибка выбора ККМ.";      
	
	ОшибкаОперации = Истина;	
	ФУ_Сервер.ЗаписатьОшибкуКММ(РезультатВыбора.ОписаниеОшибки);		
	
	ЗавершитьОтбитиеЧека();
	Возврат;
КонецЕсли;              

ЭтаФорма.Доступность = Ложь;

СуммаБезналЧекККМ = СуммаКарта;
СуммаНалЧекККМ = СуммаНаличные;

ТипРасчета = ПредопределенноеЗначение("Перечисление.ТипыРасчетаДенежнымиСредствами.ПриходДенежныхСредств");

ТаблицаПозицииЧека_П = ТаблицаПозицииЧека;

ОбщиеПараметры = ФУ_Клиент.ПолучитьШаблонЧека_ЧекПроизвольный(
	ТипРасчета, СуммаБезналЧекККМ, СуммаНалЧекККМ, СуммаПредыдущихОплат, ЭтоАванс, ТаблицаПозицииЧека_П
		, ЭтоКоворкинг);

ОповещениеПриЗавершении = Новый ОписаниеОповещения("ПечатьЧекаЗавершение_ФУ", ЭтотОбъект);
ОборудованиеЧекопечатающиеУстройстваКлиент.НачатьФискализациюЧекаНаФискальномУстройстве(
	ОповещениеПриЗавершении, УникальныйИдентификатор, РезультатВыбора.ИдентификаторУстройства, ОбщиеПараметры);
КонецПроцедуры

&НаКлиенте
Функция ТаблицаПозицииЧека()
Массив = Новый Массив;

Строка = Новый Структура("Наименование, Количество, Цена, Сумма, НомерСекции, СтавкаНДС, ЦенаСоСкидками"
	, "Коворкинг", 1, СуммаОплаты, СуммаОплаты, 0, Неопределено, СуммаОплаты); 

Массив.Добавить(Строка);
Возврат Массив;
КонецФункции

