&НаСервере                                
Процедура ДобавитьЭлемент(ИсходныйЭлемент, ИмяРеквизитаФормы, ЭлементРодитель)
Имя = Сред(ИсходныйЭлемент.Имя, 16);
Имя = ИмяРеквизитаФормы + Имя;
НовыйЭлемент = Элементы.Добавить(Имя, Тип("ПолеФормы"), ЭлементРодитель);  

НовыйЭлемент.Вид = ИсходныйЭлемент.Вид;  
ПутьКДанным = Сред(ИсходныйЭлемент.ПутьКДанным, 24);
НовыйЭлемент.ПутьКДанным = ИмяРеквизитаФормы + "." + ПутьКДанным;

НовыйЭлемент.Заголовок = ИсходныйЭлемент.Заголовок;  

НовыйЭлемент.Видимость = ИсходныйЭлемент.Видимость;

НовыйЭлемент.ТолькоПросмотр = ИсходныйЭлемент.ТолькоПросмотр;
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьПроданныеНомераОтклонения()
ЭтаФорма["ПроданныеНомераОтклонения"].Очистить();

Для Каждого Строка Из Объект.ПроданныеНомера Цикл
	Если Строка.СуммаЗаПроживаниеОтклонение = 0 
	И Строка.СуммаЗаПроживаниеОтклонениеЧасы = 0
	И Строка.СуммаОплатыИтого = Строка.СуммаЗаПроживаниеФактЧасы
	Тогда Продолжить; КонецЕсли;
	
	НоваяСтрока = ЭтаФорма["ПроданныеНомераОтклонения"].Добавить();	
	ЗаполнитьЗначенияСвойств(НоваяСтрока, Строка);
КонецЦикла;
КонецПроцедуры

