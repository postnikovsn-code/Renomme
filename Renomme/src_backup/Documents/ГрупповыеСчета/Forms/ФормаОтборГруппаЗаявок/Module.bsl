
&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
Параметры.Свойство("ВызовИзДокумента", ВызовИзДокумента);

Параметры.Свойство("ТипГрупповогоСчета", ТипГрупповогоСчета);
Если ЗначениеЗаполнено(ТипГрупповогоСчета) Тогда 
	Элементы.ТипГрупповогоСчета.ТолькоПросмотр = Истина; 
	
	ТипГрупповогоСчетаПриИзмененииНаСервере();
КонецЕсли;

Параметры.Свойство("Контрагент", Контрагент);
Если ЗначениеЗаполнено(Контрагент) Тогда
	КонтрагентОтбор = Контрагент;
	Элементы.Контрагент.ТолькоПросмотр = Истина; 
КонецЕсли;

Если НЕ Параметры.Свойство("ТолькоПроживание", ТолькоПроживание) Тогда
	ТолькоПроживание = Ложь;
КонецЕсли;	

Если НЕ Параметры.Свойство("ТолькоУслуги", ТолькоУслуги) Тогда
	ТолькоУслуги = Ложь;
КонецЕсли;

Если ТолькоПроживание И ТолькоУслуги Тогда
	ТолькоПроживание = Ложь;
	ТолькоУслуги = Ложь;
КонецЕсли;

Параметры.Свойство("ДатаС", ДатаОтбораС);
Параметры.Свойство("ДатаПо", ДатаОтбораПо);

УстановитьДекорацияТолькоПроживаниеТолькоУслуги(ТолькоПроживание, ТолькоУслуги);

Неоплачено = Истина;

УсловноеОформлениеЗагрузить();
КонецПроцедуры

&НаСервере
Процедура УстановитьДекорацияТолькоПроживаниеТолькоУслуги(ТолькоПроживание, ТолькоУслуги)
Если ТолькоПроживание Тогда
	Элементы.ДекорацияТолькоПроживаниеТолькоУслуги.Заголовок = "Только проживание";
ИначеЕсли ТолькоУслуги Тогда
	Элементы.ДекорацияТолькоПроживаниеТолькоУслуги.Заголовок = "Только услуги";
Иначе
	Элементы.ДекорацияТолькоПроживаниеТолькоУслуги.Заголовок = "Проживание и услуги";
КонецЕсли;	
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
ЮрЛицо = КлиентыСервер.ЭтоЮрЛицо(КонтрагентОтбор);
Если ВызовИзДокумента Тогда 
	Отобрать(Неопределено);
КонецЕсли;		
КонецПроцедуры

//
&НаСервере
Процедура УсловноеОформлениеЗагрузить()
ЭлементыТабНаФормеИмя = Элементы.ТаблицаОтбора.Имя;

ПутьКПолюОтбора = "ТаблицаОтбора.Отметка";
Вид_Сравнения = ВидСравненияКомпоновкиДанных.Равно;

УсловноеОформление.Элементы.Очистить();

ПравоеЗначение = Истина;
Web_Цвета = WebЦвета.БледноЗолотистый;

ОбщийФункционалСервер.УсловноеОформлениеДобавитьПоле(УсловноеОформление,
	ЭлементыТабНаФормеИмя,ПутьКПолюОтбора,Вид_Сравнения, ПравоеЗначение, Web_Цвета );
КонецПроцедуры
