Оповещение = Новый ОписаниеОповещения("ЗавершениеВопросаПодтвердитеУдаление", ЭтаФорма);
ПоказатьВопрос(Оповещение, "ПОДТВЕРДИТЕ ОТМЕНУ ОПЛАТЫ ...", РежимДиалогаВопрос.ОКОтмена);

Отказ = Истина;
КонецПроцедуры

