&НаКлиенте
Процедура ВыпискаСчетаОтметкаПриИзменении(Элемент)
ВыпискаСчетаТекущаяСтрока = Элементы.ВыпискаСчета.ТекущаяСтрока;
Если ВыпискаСчетаТекущаяСтрока = Неопределено Тогда Возврат; КонецЕсли;
ВыпискаСчетаТекущиеДанные = ВыпискаСчета.НайтиПоИдентификатору(ВыпискаСчетаТекущаяСтрока);
	
ВыпискаОплатыТекущаяСтрока = Элементы.ВыпискаОплаты.ТекущаяСтрока;
Если ВыпискаОплатыТекущаяСтрока = Неопределено Тогда 
	ВыпискаСчетаТекущиеДанные.Отметка = Ложь; 
	
	Возврат; 
КонецЕсли;
ВыпискаОплатыТекущиеДанные = ВыпискаОплаты.НайтиПоИдентификатору(ВыпискаОплатыТекущаяСтрока);

Если ВыпискаОплатыТекущиеДанные.ОстатокОплаты = 0 Тогда 
	ВыпискаСчетаТекущиеДанные.Отметка = Ложь; 

	Возврат; 
КонецЕсли;

ТекстОшибки = КонтрагентыНеРавныТекстОшибки(ВыпискаОплатыТекущиеДанные.ДокументОплаты, ВыпискаСчетаТекущиеДанные.Контрагент);
Если ТекстОшибки <> ""  Тогда 
	//ТекстОшибки = "Контрагент в документе оплаты не равен контрагенту в счете";
	ПоказатьПредупреждение(, ТекстОшибки); 

	ВыпискаСчетаТекущиеДанные.Отметка = Ложь; 
	
	Возврат; 
КонецЕсли;

Если ВыпискаСчетаТекущиеДанные.ОстатокКЗакрытию = 0 Тогда 
	ВыпискаСчетаТекущиеДанные.Отметка = Ложь; 

	Возврат; 
КонецЕсли;
	
Если ВыпискаСчетаТекущиеДанные.Отметка Тогда
	ВыпискаСчетаОтмеченоИтого = ВыпискаСчетаОтмеченоИтого + ВыпискаСчетаТекущиеДанные.ОстатокКЗакрытию; 
Иначе
	ВыпискаСчетаОтмеченоИтого = ВыпискаСчетаОтмеченоИтого - ВыпискаСчетаТекущиеДанные.ОстатокКЗакрытию; 
КонецЕсли;
КонецПроцедуры
