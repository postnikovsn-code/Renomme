

&НаКлиенте
Процедура Сформировать(Команда)
	СформироватьНаСервере();
КонецПроцедуры

&НаСервере
Процедура СформироватьНаСервере()
ПолеОтчета.Очистить();

ОбластьШапка = ПолеОтчета.Область("R1"); 
ПолеОтчета.ПовторятьПриПечатиСтроки = ОбластьШапка;

ПолеОтчета.ФиксацияСверху = 2;
ПолеОтчета.НачатьАвтогруппировкуСтрок();

ОтчетОбъект = РеквизитФормыВЗначение("Объект");

МакетИмя = "МакетСтатистика";
Макет = ОтчетОбъект.ПолучитьМакет(МакетИмя);

ОбластьЛево = Макет.ПолучитьОбласть("Шапка|КолонкиЛево");
ПолеОтчета.Вывести(ОбластьЛево, 0);

КоличествоКолонок = ОбластьЛево.ШиринаТаблицы;
//
Запрос = Новый Запрос("ВЫБРАТЬ
                      |	КатегорииНомеров.Ссылка КАК Категория
					  |ИЗ
                      |	Справочник.КатегорииНомеров КАК КатегорииНомеров
                      |ГДЕ
                      |	КатегорииНомеров.ПометкаУдаления = ЛОЖЬ
                      |
                      |УПОРЯДОЧИТЬ ПО
                      |	КатегорииНомеров.Номер_пп");

ТЗ_КатегорииНомеров = Запрос.Выполнить().Выгрузить();

ОбластьКатегории = Макет.ПолучитьОбласть("Шапка|КолонкиЦенаКатегория");
ОбластьКатегорииНачало = ОбластьЛево.ШиринаТаблицы + 1; 
ОбластьКатегорииКонец = ОбластьЛево.ШиринаТаблицы; 
Для Каждого Строка Из ТЗ_КатегорииНомеров Цикл
	ОбластьКатегории.Параметры.ШапкаКатегорияНомера = Строка.Категория;
	
	ПолеОтчета.Присоединить(ОбластьКатегории, 0);
	
	ОбластьКатегорииКонец = ОбластьКатегорииКонец + 1;
	
	КоличествоКолонок = КоличествоКолонок + 1;
КонецЦикла;
Если ОбластьКатегорииНачало <= ОбластьКатегорииКонец Тогда
	ПолеОтчета.Область(1, ОбластьКатегорииНачало, 1, ОбластьКатегорииКонец).Объединить();
КонецЕсли;	
//

//
Запрос = Новый Запрос("ВЫБРАТЬ
                      |	Клиенты.Ссылка КАК Турагентство
                      |ИЗ
                      |	Справочник.Клиенты КАК Клиенты
                      |ГДЕ
                      |	Клиенты.ПометкаУдаления = ЛОЖЬ
                      |	И Клиенты.Турагентство = ИСТИНА
                      |	И Клиенты.ПоказыватьВСтатистике = ИСТИНА
                      |
                      |УПОРЯДОЧИТЬ ПО
                      |	Клиенты.Наименование,
                      |	Клиенты.Ссылка");

ТЗ_Турагентства = Запрос.Выполнить().Выгрузить();

ОбластьТурагентства = Макет.ПолучитьОбласть("Шапка|КолонкиТурагентства");
ОбластьТурагентстваНачало = КоличествоКолонок + 1; 
ОбластьТурагентстваКонец = КоличествоКолонок; 
Для Каждого Строка Из ТЗ_Турагентства Цикл
	ОбластьТурагентства.Параметры.ШапкаТурагентство = Строка.Турагентство;
	
	ПолеОтчета.Присоединить(ОбластьТурагентства, 0);
	
	ОбластьТурагентстваКонец = ОбластьТурагентстваКонец + 1;
КонецЦикла;
Если ОбластьТурагентстваНачало <= ОбластьТурагентстваКонец Тогда
	ПолеОтчета.Область(1, ОбластьТурагентстваНачало, 1, ОбластьТурагентстваКонец).Объединить();
КонецЕсли;

Запрос = Новый Запрос("ВЫБРАТЬ
                      |	КОЛИЧЕСТВО(РАЗЛИЧНЫЕ НомернойФонд.Ссылка) КАК КоличествоНомеров
                      |ИЗ
                      |	Справочник.НомернойФонд КАК НомернойФонд
                      |ГДЕ
                      |	НомернойФонд.ПометкаУдаления = ЛОЖЬ");

ТЗ = Запрос.Выполнить().Выгрузить();
ОбщееКоличествоНомеров = ТЗ[0].КоличествоНомеров;

Итоги = Новый Структура();
Итоги.Вставить("Номеров", 0);
Итоги.Вставить("Гостей", 0);
Итоги.Вставить("ГостейБезЗавтрака", 0);
Итоги.Вставить("ГостейСЗавтраком", 0);
Итоги.Вставить("Романтик", 0);

Итоги.Вставить("ПостоянныхГостей", 0);
Итоги.Вставить("КоличествоНомеров", 0);

Итоги.Вставить("НомеровСоСкидкой_0", 0);
Итоги.Вставить("НомеровСоСкидкой_1_9", 0);
Итоги.Вставить("НомеровСоСкидкой_10_14", 0);
Итоги.Вставить("НомеровСоСкидкой_15_19", 0);
Итоги.Вставить("НомеровСоСкидкой_20", 0);
Итоги.Вставить("НомеровСТарифныйПлан", 0);

Итоги.Вставить("ПостоянныхГостей", 0);

Итоги.Вставить("СуммаНомера", 0);

КатегорииИтоги = Новый ТаблицаЗначений;
КатегорииИтоги.Колонки.Добавить("Категория");
КатегорииИтоги.Колонки.Добавить("СуммаНомера");
КатегорииИтоги.Колонки.Добавить("ПроживаниеКоличество");
Для Каждого Строка Из ТЗ_КатегорииНомеров Цикл
	НоваяСтрока = КатегорииИтоги.Добавить();
	НоваяСтрока.Категория = Строка.Категория;	
	НоваяСтрока.СуммаНомера = 0;	
	НоваяСтрока.ПроживаниеКоличество = 0;	
КонецЦикла;
Итоги.Вставить("КатегорииИтоги", КатегорииИтоги);

ТурагентстваИтоги = Новый ТаблицаЗначений;
ТурагентстваИтоги.Колонки.Добавить("Турагентство");
ТурагентстваИтоги.Колонки.Добавить("НомеровОтТурагентства");
Для Каждого Строка Из ТЗ_Турагентства Цикл
	НоваяСтрока = ТурагентстваИтоги.Добавить();
	НоваяСтрока.Турагентство = Строка.Турагентство;	
	НоваяСтрока.НомеровОтТурагентства = 0;	
КонецЦикла;
Итоги.Вставить("ТурагентстваИтоги", ТурагентстваИтоги);
////

////
ИтогиМесяц = Новый Структура();
Итоги.Вставить("КоличествоНомеров", 0);

ИтогиМесяц.Вставить("Номеров", 0);
ИтогиМесяц.Вставить("Гостей", 0);
ИтогиМесяц.Вставить("ГостейБезЗавтрака", 0);
ИтогиМесяц.Вставить("ГостейСЗавтраком", 0);
ИтогиМесяц.Вставить("Романтик", 0);

ИтогиМесяц.Вставить("ПостоянныхГостей", 0);
ИтогиМесяц.Вставить("КоличествоНомеров", 0);

ИтогиМесяц.Вставить("НомеровСоСкидкой_0", 0);
ИтогиМесяц.Вставить("НомеровСоСкидкой_1_9", 0);
ИтогиМесяц.Вставить("НомеровСоСкидкой_10_14", 0);
ИтогиМесяц.Вставить("НомеровСоСкидкой_15_19", 0);
ИтогиМесяц.Вставить("НомеровСоСкидкой_20", 0);
ИтогиМесяц.Вставить("НомеровСТарифныйПлан", 0);

ИтогиМесяц.Вставить("ПостоянныхГостей", 0);

ИтогиМесяц.Вставить("СуммаНомера", 0);

КатегорииИтогиМесяц = Новый ТаблицаЗначений;
КатегорииИтогиМесяц.Колонки.Добавить("Категория");
КатегорииИтогиМесяц.Колонки.Добавить("СуммаНомера");
КатегорииИтогиМесяц.Колонки.Добавить("ПроживаниеКоличество");
Для Каждого Строка Из ТЗ_КатегорииНомеров Цикл
	НоваяСтрока = КатегорииИтогиМесяц.Добавить();
	НоваяСтрока.Категория = Строка.Категория;	
	НоваяСтрока.СуммаНомера = 0;	
	НоваяСтрока.ПроживаниеКоличество = 0;	
КонецЦикла;
ИтогиМесяц.Вставить("КатегорииИтогиМесяц", КатегорииИтогиМесяц);

ТурагентстваИтогиМесяц = Новый ТаблицаЗначений;
ТурагентстваИтогиМесяц.Колонки.Добавить("Турагентство");
ТурагентстваИтогиМесяц.Колонки.Добавить("НомеровОтТурагентства");
Для Каждого Строка Из ТЗ_Турагентства Цикл
	НоваяСтрока = ТурагентстваИтогиМесяц.Добавить();
	НоваяСтрока.Турагентство = Строка.Турагентство;	
	НоваяСтрока.НомеровОтТурагентства = 0;	
КонецЦикла;
ИтогиМесяц.Вставить("ТурагентстваИтогиМесяц", ТурагентстваИтогиМесяц);
////

КоличествоЗаписей = 0;
КоличествоЗаписейМесяц = 0;


Запрос = Новый Запрос("ВЫБРАТЬ
                      |	ЗаявкаПроживание.ДеньПроживания КАК ДеньПроживания,
                      |	ЗаявкаПроживание.ПроцентСкидкиКлиента КАК ПроцентСкидкиКлиента,
                      |	1 КАК КоличествоНомеров,
                      |	ЗаявкаПроживание.Количество КАК КоличествоПроживание,
                      |	ЗаявкаПроживание.Ссылка.КолВоЧеловек КАК КолВоЧеловек,
                      |	ВЫБОР
                      |		КОГДА ЗаявкаПроживание.Ссылка.БезЗавтрака
                      |				ИЛИ ЗаявкаПроживание.Ссылка.БонШанс
                      |			ТОГДА ЗаявкаПроживание.Ссылка.КолВоЧеловек
                      |		ИНАЧЕ 0
                      |	КОНЕЦ КАК КолВоЧеловекБезЗавтрака,
                      |	ВЫБОР
                      |		КОГДА НЕ ЗаявкаПроживание.Ссылка.БезЗавтрака
                      |			ТОГДА ЗаявкаПроживание.Ссылка.КолВоЧеловек
                      |		ИНАЧЕ 0
                      |	КОНЕЦ КАК КолВоЧеловекСЗавтраком,
                      |	ВЫБОР
                      |		КОГДА ЗаявкаПроживание.Ссылка.БонШанс
                      |			ТОГДА 1
                      |		ИНАЧЕ 0
                      |	КОНЕЦ КАК БонШанс,
                      |	ЗаявкаПроживание.Ссылка КАК Заявка,
                      |	ЕСТЬNULL(ПостоянныеГости.ПостоянныйГость, 0) КАК ПостоянныеГости,
                      |	ЗаявкаПроживание.Сумма КАК Сумма,
                      |	ЗаявкаПроживание.СуммаБезСкидки КАК СуммаБезСкидки,
                      |	ЗаявкаПроживание.Количество КАК ПроживаниеКоличество
                      |ИЗ
                      |	(ВЫБРАТЬ
                      |		ЗаявкаНаБронированиеПроживание.Ссылка КАК Ссылка,
                      |		ЗаявкаНаБронированиеПроживание.НомерСтроки КАК НомерСтроки,
                      |		ЗаявкаНаБронированиеПроживание.ГУИД КАК ГУИД,
                      |		ЗаявкаНаБронированиеПроживание.ДеньПроживания КАК ДеньПроживания,
                      |		ЗаявкаНаБронированиеПроживание.Сумма КАК Сумма,
                      |		ЗаявкаНаБронированиеПроживание.СуммаБезСкидки КАК СуммаБезСкидки,
                      |		ЗаявкаНаБронированиеПроживание.Цена КАК Цена,
                      |		ЗаявкаНаБронированиеПроживание.Количество КАК Количество,
                      |		ЗаявкаНаБронированиеПроживание.ПроцентСкидкиКлиента КАК ПроцентСкидкиКлиента
                      |	ИЗ
                      |		Документ.ЗаявкаНаБронирование.Проживание КАК ЗаявкаНаБронированиеПроживание) КАК ЗаявкаПроживание
                      |		ЛЕВОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
                      |			КлиентыКоличество.Клиент КАК Клиент,
                      |			ВЫБОР
                      |				КОГДА КлиентыКоличество.КлиентКоличество > 2
                      |					ТОГДА 1
                      |				ИНАЧЕ 0
                      |			КОНЕЦ КАК ПостоянныйГость
                      |		ИЗ
                      |			(ВЫБРАТЬ
                      |				ИсторияКлиента.Клиент КАК Клиент,
                      |				КОЛИЧЕСТВО(ИсторияКлиента.ЗаявкаГУИД) КАК КлиентКоличество
                      |			ИЗ
                      |				РегистрСведений.ИсторияКлиента КАК ИсторияКлиента
                      |			ГДЕ
                      |				ИсторияКлиента.Статус = ЗНАЧЕНИЕ(Перечисление.СтатусБрони.Выехал)
                      |				И ИсторияКлиента.Клиент.НеПоказыватьИсторию = ЛОЖЬ
                      |			
                      |			СГРУППИРОВАТЬ ПО
                      |				ИсторияКлиента.Клиент) КАК КлиентыКоличество
                      |		ГДЕ
                      |			КлиентыКоличество.КлиентКоличество > 2) КАК ПостоянныеГости
                      |		ПО ЗаявкаПроживание.Ссылка.Клиент = ПостоянныеГости.Клиент
                      |ГДЕ
                      |	ЗаявкаПроживание.Ссылка.ПометкаУдаления = ЛОЖЬ
                      |	И ЗаявкаПроживание.Ссылка.ТипБронирования <> &ТипБронирования
                      |	И ЗаявкаПроживание.Ссылка.Проведен = ИСТИНА
                      |	И (ЗаявкаПроживание.Ссылка.Статус = ЗНАЧЕНИЕ(перечисление.СтатусБрони.Проживает)
                      |			ИЛИ ЗаявкаПроживание.Ссылка.Статус = ЗНАЧЕНИЕ(перечисление.СтатусБрони.Выехал))
                      |	И ЗаявкаПроживание.ДеньПроживания >= &ДатаНачала
                      |	И ЗаявкаПроживание.ДеньПроживания <= &ДатаОкончания
                      |
                      |УПОРЯДОЧИТЬ ПО
                      |	ДеньПроживания");

Запрос.УстановитьПараметр("ДатаНачала", ДатаОтчетаС);		
Запрос.УстановитьПараметр("ДатаОкончания", ДатаОтчетаПо);		
Запрос.УстановитьПараметр("ТипБронирования", Справочники.ТипБронирования.Ремонт);		

ТЗ_0 = Запрос.Выполнить().Выгрузить();
Если ТЗ.Количество() = 0 Тогда Возврат;  КонецЕсли;

ТЗ_0.Колонки.Добавить("СуммаНомера");
ТЗ_0.Колонки.Добавить("СуммаКомиссии");
ТЗ_0.Колонки.Добавить("СуммаЭквайрингаПроживание");

ТЗ_0.Колонки.Добавить("СуммаПроживание");

ТЗ_0.Колонки.Добавить("ПроцентСкидкиКлиента_0");
ТЗ_0.Колонки.Добавить("ПроцентСкидкиКлиента_1_9");
ТЗ_0.Колонки.Добавить("ПроцентСкидкиКлиента_10_14");
ТЗ_0.Колонки.Добавить("ПроцентСкидкиКлиента_15_19");
ТЗ_0.Колонки.Добавить("ПроцентСкидкиКлиента_20");
ТЗ_0.Колонки.Добавить("ТарифныйПлан");

Для Каждого Строка Из ТЗ_0 Цикл
	Если Строка.Заявка.Бронирует.Турагентство Тогда
		СуммаПроживание = Строка.СуммаБезСкидки;
	Иначе
		СуммаПроживание = Строка.Сумма;
	КонецЕсли;	
	Строка.СуммаПроживание = СуммаПроживание;
	
	Заявка = Строка.Заявка; 
	//ПроцентКомиссии = Заявка.Бронирует.ПроцентКомиссии;
	ПроцентКомиссии = ДокументыСервер.ПроцентКомиссииКлиента(Заявка.Бронирует, Заявка.РезервС); //, Заявка.В2В);
	
	//ТЗ_Услуги = ОтчетыСервер.ТЗ_УслугиЗаявкаДеньПроживания(Заявка, Строка.ДеньПроживания); 
	ТЗ_Услуги = ОтчетыСервер.ТЗ_УслугиЗаявкаДеньПроживания_ЧерезЗапрос(Заявка, Строка.ДеньПроживания); 
	СуммаКомиссии = ДокументыСервер.СуммаКомиссии(Заявка, Строка.СуммаБезСкидки
			, Заявка.Счета, Заявка.СчетаДетальноДолги, ТЗ_Услуги, ПроцентКомиссии);
			
	Строка.СуммаКомиссии = СуммаКомиссии;

	//ТЗ_Оплаты = ОтчетыСервер.ТЗ_ОплатыЗаявка(Заявка);
	ТЗ_Оплаты = ОтчетыСервер.ТЗ_ОплатыЗаявка_ЧерезЗапрос(Заявка);
	
	//ТЗ_Проживание = ОтчетыСервер.ТЗ_ПроживаниеЗаявкаДеньПроживания(Заявка, Строка.ДеньПроживания);
	ТЗ_Проживание = ОтчетыСервер.ТЗ_ПроживаниеЗаявкаДеньПроживания_ЧерезЗапрос(Заявка, Строка.ДеньПроживания);
	
	СуммаЭквайрингаПроживание = ОтчетыСервер.СуммаЭквайрингаПроживание(ТЗ_Проживание, ТЗ_Оплаты); 
	Строка.СуммаЭквайрингаПроживание = ОтчетыСервер.СуммаЭквайрингаПроживание(ТЗ_Проживание, ТЗ_Оплаты); 
	
	СуммаНомера = СуммаПроживание - СуммаКомиссии - СуммаЭквайрингаПроживание;    
	
	Строка.СуммаНомера = СуммаНомера;
	
	Если Строка.ПроцентСкидкиКлиента = 0 Тогда
		Если Заявка.Ссылка.Бронирует.Турагентство Тогда 
			Строка.ПроцентСкидкиКлиента = ДокументыСервер.ПроцентКомиссииКлиента(Заявка.Ссылка.Бронирует, Заявка.Ссылка.РезервС); //, Заявка.Ссылка.В2В);
		КонецЕсли;
	КонецЕсли;
	
	Строка.ПроцентСкидкиКлиента = Окр(Строка.ПроцентСкидкиКлиента); 
	
	Если Строка.ПроцентСкидкиКлиента = 0 
	Тогда Строка.ПроцентСкидкиКлиента_0 = 1; Иначе Строка.ПроцентСкидкиКлиента_0 = 0; КонецЕсли;
	
	Если Строка.ПроцентСкидкиКлиента > 0 И Строка.ПроцентСкидкиКлиента < 10
	Тогда Строка.ПроцентСкидкиКлиента_1_9 = 1; Иначе Строка.ПроцентСкидкиКлиента_1_9 = 0; КонецЕсли;
   
	Если Строка.ПроцентСкидкиКлиента >= 10 И Строка.ПроцентСкидкиКлиента < 15
	Тогда Строка.ПроцентСкидкиКлиента_10_14 = 1; Иначе Строка.ПроцентСкидкиКлиента_10_14 = 0; КонецЕсли;
   
