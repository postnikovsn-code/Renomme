&НаКлиенте
Асинх Процедура ДобавитьСписаниеОплата(Команда)
Ответ = ПроверкаВозможностиСписания();
	
Если Ответ.Ошибка Тогда Возврат; КонецЕсли;	

СуммаКСписанию_П = Ответ.СуммаКСписанию;
Обещание = ВвестиЧислоАсинх(СуммаКСписанию_П, "Сумма к списанию");
Результат = Ждать Обещание;

Если Результат = Неопределено Тогда Возврат; КонецЕсли;

Если Результат > Ответ.СуммаКСписанию Тогда  
	ПоказатьПредупреждение(, "Сумма к списанию должна быть меньше либо равна " + Ответ.СуммаКСписанию);
	
	Возврат;	
КонецЕсли;

Если Результат <= 0  Тогда  
	ПоказатьПредупреждение(, "Сумма к списанию должна быть больше 0. ");
	
	Возврат;	
КонецЕсли;

ДобавитьСписаниеОплатаНаСервере(Результат);
КонецПроцедуры

&НаКлиенте
Функция ПроверкаВозможностиСписания()
Ответ = Новый Структура("Ошибка, СуммаКСписанию", Ложь, 0); 

Разрешение = НастройкиСервер.ЭтоАдмин() ИЛИ НастройкиСервер.ЭтоАдминистратор();
Если НЕ Разрешение Тогда 
	ПоказатьПредупреждение(, "Вы не являетесь администратором программы.
							|
							|СПИСАНИЕ ДОЛГА НЕ РАЗРЕШЕНО ...");
	
	Ответ.Ошибка = Истина; Возврат Ответ; 
КонецЕсли;

Если НЕ ЭтаФорма.Записать(Новый Структура("РежимЗаписи", РежимЗаписиДокумента.Проведение)) 
Тогда Ответ.Ошибка = Истина; Возврат Ответ; КонецЕсли;


//
