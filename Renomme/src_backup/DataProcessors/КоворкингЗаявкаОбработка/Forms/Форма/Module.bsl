
&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
ТекущийПользватель = ПараметрыСеанса.ТекущийПользователь;
Если ТекущийПользватель.ТолькоПросмотр Тогда
	ЭтаФорма.ТолькоПросмотр = Истина;	
КонецЕсли;

Если Параметры.Свойство("ТолькоПочасоваяОплата") Тогда
	ТолькоПочасоваяОплата = Параметры.ТолькоПочасоваяОплата;	
КонецЕсли;

РаботаСИнтерфейсомКлиентСервер.УбратьКнопкуКоманднойПанелиФормы(Элементы.Заявки.КоманднаяПанель,"ЗаявкиУдалить");
РаботаСИнтерфейсомКлиентСервер.УбратьКнопкуКоманднойПанелиФормы(Элементы.Счета.КоманднаяПанель,"СчетаУдалить");

//ЗаполнитьНомерКоворкинг();
ЗаполнитьНомерКоворкингДерево();
	
Заявки.Параметры.УстановитьЗначениеПараметра("КоворкингНомер", Справочники.КоворкингНомера.ПустаяСсылка());
Счета.Параметры.УстановитьЗначениеПараметра("КоворкингЗаявка", Документы.КоворкингЗаявка.ПустаяСсылка());
Оплаты.Параметры.УстановитьЗначениеПараметра("КоворкингСчет", Документы.КоворкингСчета.ПустаяСсылка());
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьНомерКоворкинг()
Запрос = Новый Запрос("ВЫБРАТЬ
                      |	КоворкингНомера.Ссылка КАК НомерКоворкинг,
                      |	КоворкингНомера.ПочасоваяОплата КАК ПочасоваяОплата
                      |ИЗ
                      |	Справочник.КоворкингНомера КАК КоворкингНомера
                      |ГДЕ
                      |	КоворкингНомера.ПометкаУдаления = ЛОЖЬ
                      |	И ВЫБОР
                      |			КОГДА &ТолькоПочасоваяОплата
                      |				ТОГДА КоворкингНомера.ПочасоваяОплата = ИСТИНА
                      |			ИНАЧЕ ИСТИНА
                      |		КОНЕЦ
                      |
                      |УПОРЯДОЧИТЬ ПО
                      |	ПочасоваяОплата,
                      |	КоворкингНомера.Номер_пп");

Запрос.УстановитьПараметр("ТолькоПочасоваяОплата", ТолькоПочасоваяОплата);

ТЗ = Запрос.Выполнить().Выгрузить();
Для Каждого Строка Из ТЗ Цикл
	НоваяСтрока = НомераКоворкинг.Добавить();
	НоваяСтрока.НомерКоворкинг = Строка.НомерКоворкинг; 
	НоваяСтрока.ПочасоваяОплата = Строка.ПочасоваяОплата; 
КонецЦикла;
КонецПроцедуры

