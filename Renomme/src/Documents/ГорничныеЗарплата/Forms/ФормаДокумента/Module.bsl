  
//
&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
ТолькоПросмотр = РаботаСИнтерфейсомСервер.ПользовательТолькоПросмотр();
ЭтаФорма.ТолькоПросмотр = ТолькоПросмотр; 	
	
КлючСохраненияПоложенияОкна = Новый УникальныйИдентификатор;	

Для Каждого Элемент Из Элементы.Зарплата.ПодчиненныеЭлементы Цикл
	Если Элемент = Элементы.ЗарплатаНомерСтроки Тогда Продолжить; КонецЕсли;
	Если Элемент = Элементы.ЗарплатаГорничная Тогда Продолжить; КонецЕсли;
	
	Элемент.Ширина = 7;	
КонецЦикла;
Элементы.ЗарплатаНомерСтроки.ФиксацияВТаблице = ФиксацияВТаблице.Лево;
Элементы.ЗарплатаГорничная.ФиксацияВТаблице = ФиксацияВТаблице.Лево;
//Элементы.ЗарплатаЗарплатаИтого.ФиксацияВТаблице = ФиксацияВТаблице.Право;

Для Каждого Элемент Из Элементы.Сдельно.ПодчиненныеЭлементы Цикл
	Если Элемент = Элементы.СдельноНомерСтроки Тогда 
		Элемент.Ширина = 2;	
		Продолжить; 
	КонецЕсли;
	Если Элемент = Элементы.СдельноГорничная Тогда Продолжить; КонецЕсли;
	Если Элемент = Элементы.СдельноДата Тогда 
		Элемент.Ширина = 9;	
		Продолжить; 
	КонецЕсли;
	Если Элемент = Элементы.СдельноИтого Тогда 
		Элемент.Ширина = 7;	
		Продолжить; 
	КонецЕсли;
	
	Если Элемент.Вид = ВидГруппыФормы.ГруппаКолонок Тогда 
		Для Каждого ЭлементГруппы Из Элемент.ПодчиненныеЭлементы Цикл
			ЭлементГруппы.Ширина = 7;
	    КонецЦикла;
	Иначе
		Если Элемент.Вид <> ВидПоляФормы.ПолеФлажка Тогда 
			Элемент.Ширина = 7;	
	    КонецЕсли;
    КонецЕсли;
КонецЦикла;
Элементы.СдельноНомерСтроки.ФиксацияВТаблице = ФиксацияВТаблице.Лево;
Элементы.СдельноГорничная.ФиксацияВТаблице = ФиксацияВТаблице.Лево;
Элементы.СдельноДата.ФиксацияВТаблице = ФиксацияВТаблице.Лево;
Элементы.СдельноИтого.ФиксацияВТаблице = ФиксацияВТаблице.Право;
Элементы.СдельноВыплатыСумма.ФиксацияВТаблице = ФиксацияВТаблице.Право;
Элементы.СдельноВыплатыДата.ФиксацияВТаблице = ФиксацияВТаблице.Право;

ЗаполнитьСправочныеДанные();
 
ЕстьОбменСГорничными = Константы.ОбменСГорничными.Получить();

//Если НастройкиСервер.ЭтоРеноме() 
//ИЛИ НастройкиСервер.ЭтоЧехов() 	
//ИЛИ НастройкиСервер.ЭтоЛайв()
//Тогда
//Если ЕстьОбменСГорничными Тогда
	УсловноеОформлениеУстановить();
//Конецесли;

ОбновитьДанныеГорничных = Истина;
Если НЕ ЕстьОбменСГорничными Тогда
	Элементы.ОбновитьДанныеГорничных.Видимость = Ложь;
	ОбновитьДанныеГорничных = Ложь;
Конецесли;

ДобавитьРеквизитыПомещения();
ЗаполнитьПомещенияЦенаНаФорме();

////
Если НастройкиСервер.ЭтоДомСоветов() Тогда
	//Элементы.ЗарплатаНадбавкаЗаСтаж_Э.Видимость = Ложь;
	//Элементы.ЗарплатаНадбавкаЗаСтандарты_Э.Видимость = Ложь;
	
	//Элементы.ЗарплатаПремия.Видимость = Ложь;
	Элементы.ЗарплатаБольничный.Видимость = Ложь;
	
	//Элементы.ЗарплатаДопРаботы.Видимость = Ложь;
	//Элементы.ЗарплатаСдельно.Видимость = Ложь;
	
	//Элементы.ЗарплатаСуммаПрачечная_Э.Видимость = Ложь;
	
	//Элементы.МК_Цена.Видимость = Ложь;
	//Элементы.ЗарплатаМК_Количество_Э.Видимость = Ложь;
	//Элементы.ЗарплатаМК_Сумма.Видимость = Ложь;
	
	//Элементы.ЗарплатаСуммаПомещения.Видимость = Ложь;
	
	//Элементы.ЗарплатаИтого.Видимость = Ложь;
	
ИначеЕсли НастройкиСервер.ЭтоСтритАрт() Тогда
	Элементы.ЗарплатаНадбавкаЗаСтаж_Э.Видимость = Ложь;
	Элементы.ЗарплатаНадбавкаЗаСтандарты_Э.Видимость = Ложь;
	
	//Элементы.ЗарплатаПремия.Видимость = Ложь;
	Элементы.ЗарплатаБольничный.Видимость = Ложь;
	
	//Элементы.ЗарплатаДопРаботы.Видимость = Ложь;
	//Элементы.ЗарплатаСдельно.Видимость = Ложь;

	//Элементы.ЗарплатаСуммаПрачечная_Э.Видимость = Ложь;
	
	Элементы.МК_Цена.Видимость = Ложь;
	Элементы.ЗарплатаМК_Количество_Э.Видимость = Ложь;
	Элементы.ЗарплатаМК_Сумма.Видимость = Ложь;
	
	Элементы.МДМ_Цена.Видимость = Ложь;
	Элементы.ЗарплатаМДМ_Количество_Э.Видимость = Ложь;
	Элементы.ЗарплатаМДМ_Сумма.Видимость = Ложь;
	
	//Элементы.ЗарплатаСуммаПомещения.Видимость = Ложь;
	
	//Элементы.ЗарплатаИтого.Видимость = Ложь;
	
КонецЕсли;	

//
Запрос = Новый Запрос("ВЫБРАТЬ ПЕРВЫЕ 1
                      |	ГорничныеПомещения.Ссылка КАК Ссылка
                      |ИЗ
                      |	Справочник.ГорничныеПомещения КАК ГорничныеПомещения
                      |ГДЕ
                      |	ГорничныеПомещения.ПометкаУдаления = ЛОЖЬ");

Результат = Запрос.Выполнить();
Помещения_Есть = НЕ Результат.Пустой(); 

Элементы.ЗарплатаСуммаПомещения.Видимость = Помещения_Есть;
Элементы.ГруппаПомещенияЦены.Видимость = Помещения_Есть;
Элементы.ПомещенияУборки.Видимость = Помещения_Есть;
Элементы.ФормаОчиститьПомещения.Видимость = Помещения_Есть; 
//
////

СдельноГорничная_СписокВыбора = Элементы.СдельноГорничная.СписокВыбора;
Для Каждого Строка Из ГорничныеСправочник Цикл
	НоваяСтрока = СдельноГорничная_СписокВыбора.Добавить(Строка.Горничная);	
КонецЦикла;

ПриЧтенииНаСервере(Объект);
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьСправочныеДанные()
Если Объект.Г_Цена = 0 И Объект.Т_Цена = 0 И Объект.ТС_Цена = 0 И Объект.ТС_Цена = 0 
	И Объект.РК_Цена = 0 И Объект.МК_Цена = 0 И Объект.МДМ_Цена = 0  
	И Объект.ПомещенияЦены.Количество() = 0 	
Тогда
	ЗаполнитьЦеныУборки(); 
КонецЕсли;
ЗаполнитьЦеныУборкиСдельно();
//
ПомещенияЦена.Очистить();
Для Каждого Строка Из Объект.ПомещенияЦены Цикл
	НоваяСтрока = ПомещенияЦена.Добавить();	
	
	ЗаполнитьЗначенияСвойств(НоваяСтрока, Строка); 
КонецЦикла;
//

Запрос = Новый Запрос("ВЫБРАТЬ
                      |	ГорничныеПомещения.Ссылка КАК Помещение
                      |ИЗ
                      |	Справочник.ГорничныеПомещения КАК ГорничныеПомещения
                      |ГДЕ
                      |	ГорничныеПомещения.ПометкаУдаления = ЛОЖЬ
                      |
                      |УПОРЯДОЧИТЬ ПО
                      |	ГорничныеПомещения.Сортировка,
                      |	ГорничныеПомещения.Наименование");
	
ТЗ = Запрос.Выполнить().Выгрузить();

ПомещенияСправочник.Очистить();
Номер = 1;
Для Каждого Строка Из ТЗ Цикл
	НоваяСтрока = ПомещенияСправочник.Добавить();
	
	ЗаполнитьЗначенияСвойств(НоваяСтрока, Строка); 
	
	НоваяСтрока.Номер = Номер;
	Номер = Номер + 1;
	
	ОтборСтроки = Новый Структура("Помещение", Строка.Помещение);
	НайденныеСтроки = ПомещенияЦена.НайтиСтроки(ОтборСтроки);
	Если НайденныеСтроки.Количество() > 0 Тогда
		НоваяСтрока.Цена = НайденныеСтроки[0].Цена;
	КонецЕсли;
КонецЦикла;
//

//
Запрос = Новый Запрос("ВЫБРАТЬ
                      |	Горничные.Ссылка КАК Горничная,
                      |	Горничные.Оклад КАК Оклад,
                      |	Горничные.ДатаПриема КАК ДатаПриема,
                      |	Горничные.НадбавкаЗаСтандарты КАК НадбавкаЗаСтандарты,
                      |	0 КАК НадбавкаЗаСтаж
                      |ИЗ
                      |	Справочник.Горничные КАК Горничные
                      |ГДЕ
                      |	Горничные.ПометкаУдаления = ЛОЖЬ
                      |	И Горничные.НеРаботает = ЛОЖЬ
                      |
                      |УПОРЯДОЧИТЬ ПО
                      |	Горничные.Сортировка,
                      |	Горничные.Наименование");
	
ТЗ = Запрос.Выполнить().Выгрузить();
ГорничныеСправочник.Очистить();
Для Каждого Строка Из ТЗ Цикл
	НоваяСтрока = ГорничныеСправочник.Добавить();
	
	ЗаполнитьЗначенияСвойств(НоваяСтрока, Строка); 
	
	НоваяСтрока.НадбавкаЗаСтаж = СуммаНадбавкаЗаСтажЗаполнение(Строка.ДатаПриема);
КонецЦикла;
//

Запрос = Новый Запрос("ВЫБРАТЬ
                      |	ГорничныеНадбавкаЗаСтаж.ДатаНазначения КАК ДатаНазначения,
                      |	ГорничныеНадбавкаЗаСтаж.РазницаВДняхС КАК РазницаВДняхС,
                      |	ГорничныеНадбавкаЗаСтаж.РазницаВДняхПо КАК РазницаВДняхПо,
                      |	ГорничныеНадбавкаЗаСтаж.Сумма КАК Сумма
                      |ИЗ
                      |	РегистрСведений.ГорничныеНадбавкаЗаСтаж КАК ГорничныеНадбавкаЗаСтаж
                      |ГДЕ
                      |	ГорничныеНадбавкаЗаСтаж.ДатаНазначения <= &ДатаНазначения
                      |
                      |УПОРЯДОЧИТЬ ПО
                      |	ДатаНазначения УБЫВ,
                      |	РазницаВДняхС");

ДатаУчета = Объект.ДК;
Запрос.УстановитьПараметр("ДатаНазначения", ДатаУчета);

ТЗ = Запрос.Выполнить().Выгрузить();
Если ТЗ.Количество() > 0 Тогда 
	ГорничныеНадбавкаЗаСтаж.Очистить();
	ДатаНазначения = ТЗ[0].ДатаНазначения;
	Для Каждого Строка Из ТЗ Цикл
		Если Строка.ДатаНазначения <> ДатаНазначения Тогда Прервать; КонецЕсли;
		
		НоваяСтрока = ГорничныеНадбавкаЗаСтаж.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, Строка); 
	КонецЦикла;
КонецЕсли;

КонецПроцедуры

&НаСервере
Процедура ЗаполнитьЦеныУборки()
//
Запрос = Новый Запрос("ВЫБРАТЬ ПЕРВЫЕ 1
                      |	ГорничныеСтоимостьУборок.ДатаНазначенияЦены КАК ДатаНазначенияЦены,
                      |	ГорничныеСтоимостьУборок.Г_Цена КАК Г_Цена,
                      |	ГорничныеСтоимостьУборок.Т_Цена КАК Т_Цена,
                      |	ГорничныеСтоимостьУборок.ТС_Цена КАК ТС_Цена,
                      |	ГорничныеСтоимостьУборок.РК_Цена КАК РК_Цена,
                      |	ГорничныеСтоимостьУборок.МК_Цена КАК МК_Цена,
                      |	ГорничныеСтоимостьУборок.МДМ_Цена КАК МДМ_Цена,
                      |	ГорничныеСтоимостьУборок.ЦеныПомещения.(
                      |		Ссылка КАК Ссылка,
                      |		НомерСтроки КАК НомерСтроки,
                      |		Помещение КАК Помещение,
                      |		Цена КАК Цена
                      |	) КАК ЦеныПомещения
                      |ИЗ
                      |	Справочник.ГорничныеСтоимостьУборок КАК ГорничныеСтоимостьУборок
                      |ГДЕ
                      |	ГорничныеСтоимостьУборок.ПометкаУдаления = ЛОЖЬ
                      |	И ГорничныеСтоимостьУборок.ДатаНазначенияЦены <= &ДатаНазначенияЦены
                      |
                      |УПОРЯДОЧИТЬ ПО
                      |	ДатаНазначенияЦены УБЫВ");

Запрос.УстановитьПараметр("ДатаНазначенияЦены", Объект.ДН);

ТЗ = Запрос.Выполнить().Выгрузить();
Если ТЗ.Количество() = 0 Тогда Возврат; КонецЕсли;

Строка = ТЗ[0];
Объект.Г_Цена = Строка.Г_Цена;
Объект.Т_Цена = Строка.Т_Цена;
Объект.ТС_Цена = Строка.ТС_Цена;
Объект.РК_Цена = Строка.РК_Цена;
Объект.МК_Цена = Строка.МК_Цена;
Объект.МДМ_Цена = Строка.МДМ_Цена;

ТЗ_ЦеныПомещения = Строка.ЦеныПомещения;
ПомещенияЦена.Очистить();
Объект.ПомещенияЦены.Очистить();

Для Каждого Строка Из ТЗ_ЦеныПомещения Цикл
	НоваяСтрока = Объект.ПомещенияЦены.Добавить();	
	ЗаполнитьЗначенияСвойств(НоваяСтрока, Строка); 
	
	НоваяСтрока = ПомещенияЦена.Добавить();	
	ЗаполнитьЗначенияСвойств(НоваяСтрока, Строка); 
КонецЦикла;

ЗаполнитьПомещенияЦенаНаФорме();

КонецПроцедуры

&НаСервере
Процедура ЗаполнитьЦеныУборкиСдельно()
//
Запрос = Новый Запрос("ВЫБРАТЬ ПЕРВЫЕ 1
                      |	ГорничныеСтоимостьУборок.ДатаНазначенияЦены КАК ДатаНазначенияЦены,
                      |	ГорничныеСтоимостьУборок.Г_ЦенаСдельно КАК Г_ЦенаСдельно,
                      |	ГорничныеСтоимостьУборок.Т_ЦенаСдельно КАК Т_ЦенаСдельно,
                      |	ГорничныеСтоимостьУборок.ТС_ЦенаСдельно КАК ТС_ЦенаСдельно,
                      |	ГорничныеСтоимостьУборок.МК_ЦенаСдельно КАК МК_ЦенаСдельно,
                      |	ГорничныеСтоимостьУборок.МДМ_ЦенаСдельно КАК МДМ_ЦенаСдельно,
                      |	ГорничныеСтоимостьУборок.ВыходСдельно КАК ВыходСдельно,
                      |	ГорничныеСтоимостьУборок.ПоЧасамСдельно КАК ПоЧасамСдельно
                      |ИЗ
                      |	Справочник.ГорничныеСтоимостьУборок КАК ГорничныеСтоимостьУборок
                      |ГДЕ
                      |	ГорничныеСтоимостьУборок.ПометкаУдаления = ЛОЖЬ
                      |	И ГорничныеСтоимостьУборок.ДатаНазначенияЦены <= &ДатаНазначенияЦены
                      |
                      |УПОРЯДОЧИТЬ ПО
                      |	ДатаНазначенияЦены УБЫВ");

Запрос.УстановитьПараметр("ДатаНазначенияЦены", Объект.ДН);

ТЗ = Запрос.Выполнить().Выгрузить();
Если ТЗ.Количество() = 0 Тогда Возврат; КонецЕсли;

Строка = ТЗ[0];

СдельноГ_Цена = Строка.Г_ЦенаСдельно;
СдельноТ_Цена = Строка.Т_ЦенаСдельно;
СдельноТС_Цена = Строка.ТС_ЦенаСдельно;
СдельноМК_Цена = Строка.МК_ЦенаСдельно;
СдельноМДМ_Цена = Строка.МДМ_ЦенаСдельно;
СдельноВыход = Строка.ВыходСдельно;
СдельноПоЧасам_Цена = Строка.ПоЧасамСдельно
КонецПроцедуры

&НаСервере
Процедура УсловноеОформлениеУстановить() 
УО = ЭтаФорма.УсловноеОформление; 
УО.Элементы.Очистить(); 

ЭлементУО = УО.Элементы.Добавить(); 
УсловноеОформлениеПолеДобавить(ЭлементУО, "ЗарплатаОклад_Э", "Объект.Зарплата.Оклад_Есть", Истина, ВидСравненияКомпоновкиДанных.Равно);
ЭлементУО.Оформление.УстановитьЗначениеПараметра("ЦветТекста",WebЦвета.Красный); 

ЭлементУО = УО.Элементы.Добавить(); 
УсловноеОформлениеПолеДобавить(ЭлементУО, "ЗарплатаОтпуск_Э", "Объект.Зарплата.Отпуск_Есть", Истина, ВидСравненияКомпоновкиДанных.Равно);
ЭлементУО.Оформление.УстановитьЗначениеПараметра("ЦветТекста",WebЦвета.Красный); 

ЭлементУО = УО.Элементы.Добавить(); 
УсловноеОформлениеПолеДобавить(ЭлементУО, "ЗарплатаНадбавкаЗаСтаж_Э", "Объект.Зарплата.НадбавкаЗаСтаж_Есть", Истина, ВидСравненияКомпоновкиДанных.Равно);
ЭлементУО.Оформление.УстановитьЗначениеПараметра("ЦветТекста",WebЦвета.Красный); 

