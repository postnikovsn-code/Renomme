Функция ПолучитьФинансы()
	ОперацияЗавтрак=Справочники.ВидыОпераций.НайтиПоКоду("000000003");
	ОперацияПрачечная=Справочники.ВидыОпераций.НайтиПоКоду("000000005");
	Запрос=Новый Запрос("ВЫБРАТЬ РАЗЛИЧНЫЕ
	                    |	СУММА(Деньги.Сумма) КАК Сумма
	                    |ИЗ
	                    |	РегистрНакопления.Деньги КАК Деньги
	                    |ГДЕ
	                    |	Деньги.ВидДвижения = &ВидДвижения
	                    |	И Деньги.ВидОперации = &ВидОперации
	                    |	И Деньги.Период МЕЖДУ &ДН И &ДК");
	 Запрос.УстановитьПараметр("ВидОперации",ОперацияЗавтрак);
	 Запрос.УстановитьПараметр("ВидДвижения",ВидДвиженияНакопления.Расход);
	 Запрос.УстановитьПараметр("ДН",НачалоДня(Отчет.ДН));
	 Запрос.УстановитьПараметр("ДК",КонецДня(Отчет.ДК));
	 
	 ТЗЗавтрак=Запрос.Выполнить().Выгрузить();
	 
	 Запрос=Новый Запрос("ВЫБРАТЬ РАЗЛИЧНЫЕ
	                    |	СУММА(Деньги.Сумма) КАК Сумма
	                    |ИЗ
	                    |	РегистрНакопления.Деньги КАК Деньги
	                    |ГДЕ
	                    |	Деньги.ВидДвижения = &ВидДвижения
	                    |	И Деньги.ВидОперации = &ВидОперации
	                    |	И Деньги.Период МЕЖДУ &ДН И &ДК");
	 Запрос.УстановитьПараметр("ВидОперации",ОперацияПрачечная);
	 Запрос.УстановитьПараметр("ВидДвижения",ВидДвиженияНакопления.Расход);
	 Запрос.УстановитьПараметр("ДН",НачалоДня(Отчет.ДН));
	 Запрос.УстановитьПараметр("ДК",КонецДня(Отчет.ДК));
	 
	 ТЗПрачечная=Запрос.Выполнить().Выгрузить();
	 
	 
	 
	 Рез=Новый Структура("Завтрак,Прачечная");
	 Рез.Завтрак=ТЗЗавтрак.Итог("Сумма");
	 Рез.Прачечная=ТЗПрачечная.Итог("Сумма");
     Возврат Рез;
	
