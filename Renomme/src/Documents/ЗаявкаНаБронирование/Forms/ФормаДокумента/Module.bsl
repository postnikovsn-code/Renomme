		сч=сч+1;
		СтрокаТабл.Параметры.НомерСтроки=сч;
		
		НаименованиеДолг = ЗаявкаСервер.НаименованиеДолг(Усл, Истина);
	    Товар = ТоварКлиент + НаименованиеДолг;
		
		СтрокаТабл.Параметры.Товар = Товар;
		
		СтрокаТабл.Параметры.ЕдиницаИзмерения="услуга";
		
		СтрокаТабл.Параметры.Количество=Усл.Количество;
		СтрокаТабл.Параметры.Цена=Усл.Цена;
		
		Сумма = Усл.Цена*Усл.Количество;
		СтрокаТабл.Параметры.Сумма = Сумма;
		
		ТабДок.Вывести(СтрокаТабл);
		
		СуммаДляПечати = СуммаДляПечати + Сумма;
	КонецЦикла; 
конецесли;

// проживание 
ИтогоСтр=Макет.ПолучитьОбласть("Итого");
