	                             |	ЗанятостьНомеров.Регистратор.Тариф_НеИспользуется КАК Тариф_НеИспользуется,
	                             |	ЗанятостьНомеров.Регистратор.ВремяЗаездаТочное КАК Заезд,
	                             |	ЗанятостьНомеров.Регистратор.ВремяВыездаТочное КАК Выезд,
	                             |	ЗанятостьНомеров.Номер.Наименование КАК НомерНаименование
	                             |ИЗ
	                             |	РегистрСведений.ЗанятостьНомеров КАК ЗанятостьНомеров
	                             |ГДЕ
	                             |	ЗанятостьНомеров.Регистратор.Статус = &Статус
	                             |	И ЗанятостьНомеров.ПериодРезерва МЕЖДУ &ДН И &ДК
	                             |
	                             |УПОРЯДОЧИТЬ ПО
	                             |	НомерНаименование");
	
	
	ЗапросНезаездов.УстановитьПараметр("Статус",Перечисления.СтатусБрони.Бронь);								   
	ЗапросНезаездов.УстановитьПараметр("ДН",НачалоДня(Объект.Дата));								   
	ЗапросНезаездов.УстановитьПараметр("ДК",КонецДня(Объект.Дата));	
	ЗапросНезаездов.УстановитьПараметр("ДН2",КонецДня(Объект.Дата));								   
	ЗапросНезаездов.УстановитьПараметр("ДК2",КонецДня(Объект.Дата)+8*60*60);	
	ЗапросНезаездов.УстановитьПараметр("ДН3",НачалоДня(Объект.Дата));								   
	ЗапросНезаездов.УстановитьПараметр("ДК3",НачалоДня(Объект.Дата)+8*60*60);	
	ТЗ=ЗапросНезаездов.Выполнить().Выгрузить();
	
	Для каждого Стр Из ТЗ Цикл
		
		
		Нов=Объект.Незаезды.Добавить();
		Нов.Бронь=Стр.Регистратор;
