&НаСервере
Функция СоздатьЕжедневныйАудит()
ПоискДок=Документы.ЕжедневныйАудит.Выбрать(НачалоДня(ТекущаяДата()-86400),КонецДня(ТекущаяДата()-86400));
Если ПоискДок.Следующий() тогда
иначе
	
	НовДок=Документы.ЕжедневныйАудит.СоздатьДокумент();
	
	//НовДок.Автор=ТекПол;
	НовДок.Автор=ПараметрыСеанса.ТекущийПользователь;
	
	НовДок.Дата=НачалоДня(ТекущаяДата()-86400);
	НовДок.Записать(РежимЗаписиДокумента.Запись);
	
	Возврат НовДок.Ссылка;
	
	//ФРМ=НовДок.ПолучитьФорму();
	//ФРМ.Открыть();
конецесли;

Возврат Неопределено;
КонецФункции

