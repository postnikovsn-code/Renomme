Функция ПереносЗначенияКласификатора(ИмяСправочника, Значение)
Наименование = Значение.Description;	 
Если СокрЛП(Наименование) = "" Тогда Возврат Неопределено; КонецЕсли;	
	
Справочник = Справочники[ИмяСправочника];	
Ссылка = Справочник.НайтиПоНаименованию(Наименование, Истина); 	
Если ЗначениеЗаполнено(Ссылка) Тогда Возврат Ссылка; КонецЕсли;

НовыйЭлемент = Справочник.СоздатьЭлемент();
НовыйЭлемент.Наименование = Наименование;

//НовыйЭлемент.Записать();
Возврат НовыйЭлемент.Ссылка; 
КонецФункции

Функция ПереносЗначенияКатегория(Значение)
Скидка = Значение.Скидка;
Если Скидка = 0 Тогда Возврат Неопределено; КонецЕсли;	

Справочник = Справочники.КатегорииКлиентов;
Ссылка = Справочник.НайтиПоРеквизиту("Скидка", Скидка);	
Если ЗначениеЗаполнено(Ссылка) Тогда Возврат Ссылка; КонецЕсли;

НовыйЭлемент = Справочник.СоздатьЭлемент();
НовыйЭлемент.Наименование = Значение.Description;
НовыйЭлемент.Скидка = Скидка;

//НовыйЭлемент.Записать();
Возврат НовыйЭлемент.Ссылка; 
КонецФункции

Функция ПереносЗначенияАдресРегистрации(Значение)
Наименование = Значение.Description;	
Если СокрЛП(Наименование) = "" Тогда Возврат Неопределено; КонецЕсли;	

Справочник = Справочники.Адреса;
Ссылка = Справочник.НайтиПоНаименованию(Наименование, Истина);
Если ЗначениеЗаполнено(Ссылка) Тогда Возврат Ссылка; КонецЕсли;

МассивИменаПолей = Новый Массив;
МассивИменаПолей.Добавить("Страна_НеИспользуется");
МассивИменаПолей.Добавить("Город");
МассивИменаПолей.Добавить("Адрес");
МассивИменаПолей.Добавить("Примечание");
МассивИменаПолей.Добавить("Район");
МассивИменаПолей.Добавить("Область");
МассивИменаПолей.Добавить("Дом");
МассивИменаПолей.Добавить("Квартира");
МассивИменаПолей.Добавить("Улица");
МассивИменаПолей.Добавить("ПолныйАдрес");

НовыйЭлемент = Справочник.СоздатьЭлемент();
НовыйЭлемент.Наименование = Значение.Description;
ЗаполнитьЗначенияАдрес(НовыйЭлемент, Значение, МассивИменаПолей);

//НовыйЭлемент.Записать();
Возврат НовыйЭлемент.Ссылка; 
КонецФункции

Процедура ЗаполнитьЗначенияАдрес(Получатель, Источник, МассивИменаПолей)
	
Для Каждого Имя Из МассивИменаПолей Цикл
	//Если Имя = "Ссылка" 
	//ИЛИ Имя = "Родитель" 
	//Тогда Продолжить; КонецЕсли;	
	
	Значение = Источник[Имя];
	Если ТипЗнч(Значение) = Тип("COMОбъект") Тогда
		Если Имя = "Страна_НеИспользуется" тогда
			Получатель[Имя] = ПереносЗначенияКласификатора("Страны", Значение);
			
		ИначеЕсли Имя = "Город" тогда
			Получатель[Имя] = ПереносЗначенияКласификатора("Города", Значение);
			
		ИначеЕсли Имя = "Район" тогда
			Получатель[Имя] = ПереносЗначенияКласификатора("Районы", Значение);
			
		ИначеЕсли Имя = "Область" тогда
			Получатель[Имя] = ПереносЗначенияКласификатора("Области", Значение);
			
		ИначеЕсли Имя = "Улица" тогда
			Получатель[Имя] = ПереносЗначенияКласификатора("Улицы", Значение);
		КонецЕсли;
	Иначе	
		Получатель[Имя] = Источник[Имя];
	КонецЕсли;   
КонецЦикла;
КонецПроцедуры	

Функция ИмяЗначенияПеречисление(Соединение, Значение) Экспорт
Если Значение.Пустая() Тогда Возврат ""; КонецЕсли;
     
//получаем как названо перечисление в конфигураторе
ИмяПеречисления = Значение.Метаданные().Имя;

//теперь получим индекс где хранится то что нам надо
НужныйИндекс = Соединение.Перечисления[ИмяПеречисления].Индекс(Значение);

//и вот счастье. то что нам надо - идентификатор!!! всего-то четыре строчки кода
//ИмяЗначения = Соединение.Метаданные.Перечисления[ИмяПеречисления].ЗначенияПеречисления[НужныйИндекс].Имя;     
ЗначенияПеречисления = Соединение.Метаданные.Перечисления[ИмяПеречисления].ЗначенияПеречисления;
Индекс = 0;
Для Каждого ЗначениеПеречисления Из ЗначенияПеречисления Цикл
	Если Индекс = НужныйИндекс Тогда  Возврат ЗначениеПеречисления.Имя;	КонецЕсли;
	Индекс = Индекс + 1;
КонецЦикла;	

Возврат "";     
КонецФункции

Функция СоздатьГруппуКлиентов(РодительСсылка, НачальныйРодитель , СоединениеПустаяСсылка)
ГруппаИмя = "";	
ИмяГруппы(ГруппаИмя, РодительСсылка, НачальныйРодитель, СоединениеПустаяСсылка);

ГруппаИмяПромежуточное = ГруппаИмя;

//ТекущийРодитель = Справочники.Клиенты.ПустаяСсылка();
ТекущийРодитель = НачальныйРодитель;
Пока Истина Цикл
	Индекс = СтрНайти(ГруппаИмяПромежуточное, "\");
	Если Индекс = 0 Тогда Прервать; КонецЕсли;
	
	ГруппаНаименование = Лев(ГруппаИмяПромежуточное, Индекс - 1); 
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
               |	Клиенты.Ссылка КАК Ссылка,
               |	Клиенты.Наименование КАК Наименование
               |ИЗ
               |	Справочник.Клиенты КАК Клиенты
               |ГДЕ
               |	Клиенты.ЭтоГруппа = ИСТИНА
               |	И Клиенты.Наименование = &Наименование
               |	И Клиенты.Родитель = &Родитель";

	Запрос.УстановитьПараметр("Наименование", ГруппаНаименование); 
	Запрос.УстановитьПараметр("Родитель", ТекущийРодитель); 
	
	ТЗГруппы = Запрос.Выполнить().Выгрузить();
	Если ТЗГруппы.Количество() = 0 Тогда
		НоваяГруппа = Справочники.Клиенты.СоздатьГруппу();
		НоваяГруппа.Наименование = ГруппаНаименование;
		НоваяГруппа.Родитель = ТекущийРодитель;
		НоваяГруппа.Записать();
		
		ТекущийРодитель = НоваяГруппа.Ссылка;	
	Иначе
		ТекущийРодитель = ТЗГруппы[0].Ссылка;
	КонецЕсли;	
	
	ГруппаИмяПромежуточное = Сред(ГруппаИмяПромежуточное, Индекс + 1);
КонецЦикла;	
КонецФункции	

Процедура ИмяГруппы(ГруппаИмя, Группа, НачальнаяГруппа, ПустаяСсылка)
Если Группа = ПустаяСсылка Тогда Возврат; КонецЕсли;
Если Группа = НачальнаяГруппа Тогда Возврат; КонецЕсли;

ГруппаИмя = Группа.Наименование + "\" + ГруппаИмя;

Группа = Группа.Родитель;

ИмяГруппы(ГруппаИмя, Группа, НачальнаяГруппа, ПустаяСсылка);		
КонецПроцедуры
