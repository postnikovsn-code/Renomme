&НаСервере
Процедура ДатаЗаездаПриИзмененииНаСервере()
ВыборкаБроней=Новый Запрос("ВЫБРАТЬ
                           |	ЗаявкаНаБронирование.Ссылка КАК Ссылка,
                           |	ЗаявкаНаБронирование.Клиент КАК Клиент,
                           |	ЗаявкаНаБронирование.Клиент2 КАК Клиент2
                           |ИЗ
                           |	Документ.ЗаявкаНаБронирование КАК ЗаявкаНаБронирование
                           |ГДЕ
                           |	ЗаявкаНаБронирование.ПометкаУдаления = ЛОЖЬ
                           |	И НАЧАЛОПЕРИОДА(ЗаявкаНаБронирование.ВремяЗаездаТочное, ДЕНЬ) = &ВремяЗаездаТочное");

ВыборкаБроней.УстановитьПараметр("ВремяЗаездаТочное",НачалоДня(Объект.ДатаЗаезда));
ТЗБ=ВыборкаБроней.Выполнить().Выгрузить();   

Объект.ТаблицаДляВыгрузки.Очистить();   

Для каждого Стр Из ТЗБ Цикл
   Нов= Объект.ТаблицаДляВыгрузки.Добавить();
   Нов.Выгружать=Истина;
   Нов.Бронирование=Стр.ссылка;
   Нов.Клиент=Стр.Клиент;
   
   Если НЕ Стр.Клиент2.Пустая() тогда
	   Нов=Объект.ТаблицаДляВыгрузки.Добавить();
	   Нов.Выгружать=Истина;
	   Нов.Бронирование=Стр.ссылка;
	   Нов.Клиент=Стр.Клиент2;
	   
   конецесли;
   
КонецЦикла; 
КонецПроцедуры
