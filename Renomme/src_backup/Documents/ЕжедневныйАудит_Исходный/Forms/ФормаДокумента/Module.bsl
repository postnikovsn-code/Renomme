	//|)
	//|
	//|УПОРЯДОЧИТЬ ПО
	//|	ЗанятостьНомеров.Номер.Наименование");
	
	ЗапросНезаездов=Новый запрос("ВЫБРАТЬ РАЗЛИЧНЫЕ
	                             |	ЗанятостьНомеров.Регистратор КАК Регистратор,
