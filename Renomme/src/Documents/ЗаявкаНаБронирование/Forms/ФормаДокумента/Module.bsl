&НаКлиенте
Процедура РезервСПриИзменении(Элемент)
Если ЗначениеЗаполнено(Объект.ВремяЗаездаТочное) Тогда
	ПоказатьПредупреждение(, "Заполнено точное время заезда
	|
	|ИЗМЕНЕНИЕ НЕ РАЗРЕШЕНО ...");
	
	Дата_OldValue = ОбщийФункционалСервер.ЗначениеРеквизитаНаСервере(Объект.Ссылка, "РезервС");
	Объект.РезервС = Дата_OldValue; 
	
	Возврат;
КонецЕсли;	
	
Если НЕ ЗначениеЗаполнено(Объект.РезервС) тогда
	ПоказатьПредупреждение(, "Дата заезда - пусто");
	Возврат;
КонецЕсли;	

ДеньПроживанияМинимум = ЗаявкаОбщееКлиентСервер.ДеньПроживанияМинимум(Объект.Проживание);
Если НЕ ЗначениеЗаполнено(ДеньПроживанияМинимум) Тогда Возврат; КонецЕсли;
	
Если Объект.РезервС > ДеньПроживанияМинимум Тогда
	ПоказатьПредупреждение(, "Дата заезда: " + Объект.РезервС + "
							|	
							|Дата заезда больше минимальной даты проживания в расчете проживания");
	
	РезервС_OldValue = ОбщийФункционалСервер.ПолучитьЗначениеРеквизитаНаСервере(Объект.Ссылка, "РезервС"); 
	Объект.РезервС = РезервС_OldValue;
	Возврат;
КонецЕсли;	

Если НЕ ЗначениеЗаполнено(Объект.РезервПо) тогда Возврат; КонецЕсли;	

Если ДатыРезервПроверить() тогда Объект.РезервС = Объект.РезервПо; КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура РезервПоПриИзменении(Элемент)   
Если НЕ ЗначениеЗаполнено(Объект.РезервПо) тогда
	ПоказатьПредупреждение(, "Дата выезда - пусто");
	Возврат;
КонецЕсли;	

ДеньПроживанияМаксимум = ЗаявкаОбщееКлиентСервер.ДеньПроживанияМаксимум(Объект.Проживание);
Если НЕ ЗначениеЗаполнено(ДеньПроживанияМаксимум) Тогда Возврат; КонецЕсли;

//ДеньПроживанияМаксимум = ДеньПроживанияМаксимум + 86400; 
Если Объект.РезервПо < ДеньПроживанияМаксимум Тогда
	ПоказатьПредупреждение(,  "Дата выезда: " + Объект.РезервПо + "
							|	
							|Дата выезда меньше максимальной даты проживания в расчете проживания");
	
	РезервПо_OldValue = ОбщийФункционалСервер.ПолучитьЗначениеРеквизитаНаСервере(Объект.Ссылка, "РезервПо"); 
	Объект.РезервПо = РезервПо_OldValue;
	
	Возврат;
КонецЕсли;

Если НЕ ЗначениеЗаполнено(Объект.РезервС) тогда Возврат; КонецЕсли;	

Если ДатыРезервПроверить() тогда
	Объект.РезервПо = Объект.РезервС;
КонецЕсли;
КонецПроцедуры

&НаКлиенте
Функция ДатыРезервПроверить()
	
Если Объект.РезервПо < Объект.РезервС тогда
	ПоказатьПредупреждение(, "Дата выезда меньше даты заезда!");
	Возврат Истина;
КонецЕсли;

Возврат Ложь;
КонецФункции
