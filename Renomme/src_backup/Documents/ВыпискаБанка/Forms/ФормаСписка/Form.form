      <segments>Список.ОтКого</segments>
    </notDefaultUseAlwaysAttributes>
    <main>true</main>
    <extInfo xsi:type="form:DynamicListExtInfo">
      <queryText>ВЫБРАТЬ
	ДокументВыпискаБанка.Ссылка КАК Ссылка,
	ДокументВыпискаБанка.ПометкаУдаления КАК ПометкаУдаления,
	ДокументВыпискаБанка.Номер КАК Номер,
	ДокументВыпискаБанка.Дата КАК Дата,
	ДокументВыпискаБанка.Проведен КАК Проведен,
	ДокументВыпискаБанка.ДатаОплаты КАК ДатаОплаты,
	ДокументВыпискаБанка.ОтКого КАК ОтКого,
	ВЫБОР
		КОГДА ДокументВыпискаБанка.ОтКого.ТипКлиента = ЗНАЧЕНИЕ(Перечисление.ТипыКлиентов.ЮрЛицо)
			ТОГДА ВЫБОР
					КОГДА ДокументВыпискаБанка.ОтКого.НаименованиеЮрЛица = &quot;&quot;
						ТОГДА ДокументВыпискаБанка.ОтКого.Наименование
					ИНАЧЕ ДокументВыпискаБанка.ОтКого.НаименованиеЮрЛица
				КОНЕЦ
		ИНАЧЕ ДокументВыпискаБанка.ОтКого.Наименование
	КОНЕЦ КАК ОтКогоНаименование,
	ДокументВыпискаБанка.Приход КАК Приход,
	ДокументВыпискаБанка.Сумма КАК Сумма,
	ДокументВыпискаБанка.ВидОперации КАК ВидОперации,
	ДокументВыпискаБанка.ТекстПлатежа КАК ТекстПлатежа,
	ДокументВыпискаБанка.Примечание КАК Примечание,
	ДокументВыпискаБанка.Возврат КАК Возврат,
	ДокументВыпискаБанка.ВозвратДокумент КАК ВозвратДокумент,
	ДокументВыпискаБанка.ЭтоЭквайринг КАК ЭтоЭквайринг,
	ДокументВыпискаБанка.Закрыт КАК Закрыт,
	ДокументВыпискаБанка.ГУИДИсточникЗагрузка КАК ГУИДИсточникЗагрузка,
	ДокументВыпискаБанка.ГУИДЗагрузка КАК ГУИДЗагрузка,
	ДокументВыпискаБанка.ГУИДИсточникЗагрузка = &quot;&quot; КАК РучнойВвод
ИЗ
	Документ.ВыпискаБанка КАК ДокументВыпискаБанка</queryText>
      <mainTable>Document.ВыпискаБанка</mainTable>
      <autoFillAvailableFields>true</autoFillAvailableFields>
      <customQuery>true</customQuery>
      <autoSaveUserSettings>true</autoSaveUserSettings>
      <getInvisibleFieldPresentations>true</getInvisibleFieldPresentations>
    </extInfo>
