&НаСервере
Функция РасчитатьСтоимостьПлан(СтрокаТЗ)
	
	//Стоимость=?(СтрокаТЗ.Бронь.НовыйРассчет, ПолучитьСтоимостьНовыйРасчет(СтрокаТЗ.Бронь,НачалоДня(Объект.Дата))
	//	, СтрокаТЗ.Тариф.Цена*?(СтрокаТЗ.Бронь.Оплачивает.Категория.Пустая(),1,1-СтрокаТЗ.Бронь.Оплачивает.Категория.Скидка/100));
		
	Стоимость = ПолучитьСтоимостьНовыйРасчет(СтрокаТЗ.Бронь,НачалоДня(Объект.Дата));
	
	Коэф=1;
	Если СтрокаТЗ.Тариф_НеИспользуется.Код="000000001" или Найти(СтрокаТЗ.Тариф_НеИспользуется.Наименование,"Бон Шанс")>0 тогда
		
		Если (СтрокаТЗ.Заезд-НачалоДня(СтрокаТЗ.Заезд))<6*60*60  и НачалоДня(СтрокаТЗ.Заезд)=НачалоДня(Объект.Дата) тогда // прошлые сутки
			Коэф=0;
			Возврат 0;			
		иначе
			ВремяВНомере=СтрокаТЗ.Выезд-СтрокаТЗ.Заезд;
			СуммаСверх=?(ВремяВНомере>(3600*4-1),(Цел(ВремяВНомере/3600)-3)*200,0);
			Возврат (Стоимость)+СуммаСверх;
		конецесли;
	конецесли;
	Если (СтрокаТЗ.Выезд-СтрокаТЗ.Заезд)<86400 и (СтрокаТЗ.Выезд-СтрокаТЗ.Заезд)>0 и НАчалоДня(СтрокаТЗ.Выезд)=НачалоДня(Объект.Дата) и НАчалоДня(СтрокаТЗ.Заезд)=НачалоДня(Объект.Дата) тогда // нет суток
		Если НАчалоДня(СтрокаТЗ.Заезд)=НачалоДня(Объект.Дата) тогда // сегодня ночью заехал
			Если (СтрокаТЗ.Заезд-НачалоДня(СтрокаТЗ.Заезд))<6*60*60 тогда // прошлые сутки
				Коэф=0;
				Возврат 0;			
			конецесли;
		конецесли;
		Возврат (Стоимость);
	конецесли;
	//Если (СтрокаТЗ.Выезд-СтрокаТЗ.Заезд)<86400 и (СтрокаТЗ.Выезд-СтрокаТЗ.Заезд)>0 и НАчалоДня(СтрокаТЗ.Выезд)=НачалоДня(Дата) тогда // нет суток
	//	Возврат 0;	
	//конецесли;
	//СтрокаТЗ=ПроданныеНомера.Добавить();
	Сумма=(Стоимость);
	РезервС=?(СтрокаТЗ.Заезд<Дата(2000,1,1),СтрокаТЗ.Бронь.РезервС,СтрокаТЗ.Заезд);	
	РезервПО=?(СтрокаТЗ.Выезд<Дата(2000,1,1),СтрокаТЗ.Бронь.РезервПо,СтрокаТЗ.Выезд);	
	
	
	//Если НАчалоДня(РезервС)=НачалоДня(Дата) тогда //сегодня заехал.
	Если НАчалоДня(СтрокаТЗ.Заезд)=НачалоДня(Объект.Дата+86400) тогда //"Завтра" заехал.
		//Если НАчалоДня(РезервС)=НачалоДня(СтрокаТЗ.Заезд) тогда
		//Если Час(СтрокаТЗ.Заезд)<6 тогда // двойной тариф (+прошлые сутки)
		//	Сумма=Сумма;
		//иначеесли Час(СтрокаТЗ.Заезд)>=6 и Час(СтрокаТЗ.Заезд)<=8 тогда // 1,5 тариф (+половина прошлые сутки)
		//	Сумма=Сумма*0.5;	
		//конецесли;
			Если СтрокаТЗ.Бронь.НовыйРассчет и Сумма=0 Тогда 
				Сумма=ПолучитьСтоимостьНовыйРасчет(СтрокаТЗ.Бронь,НачалоДня(Объект.Дата+86400));
			КонецЕсли;
		Если (СтрокаТЗ.Заезд-НачалоДня(СтрокаТЗ.Заезд))<6*60*60 тогда // двойной тариф (+прошлые сутки)
			Сумма=Сумма*1;
			Коэф=Коэф*1;
		иначеесли (СтрокаТЗ.Заезд-НачалоДня(СтрокаТЗ.Заезд))>=6*60*60-40 и (СтрокаТЗ.ЗаездКоррекция-НачалоДня(СтрокаТЗ.ЗаездКоррекция))<=9*60*60 тогда // 1,5 тариф (+половина прошлые сутки)
			Сумма=Сумма*0.5;	
			Коэф=Коэф*0.5;
		конецесли;		
		//конецесли;
	конецесли;
	Если Найти(СтрокаТЗ.Тариф_НеИспользуется.Наименование,"Свадебный")>0 тогда // можно до 6 выезжать
		Если НАчалоДня(РезервПо)=НачалоДня(Объект.Дата) тогда //сегодня выехал.
			Если (Час(СтрокаТЗ.Выезд)-12)<=6 тогда // можно до 6 выезжать
				Сумма=0;
			иначеесли (Час(СтрокаТЗ.Выезд)-12)>0 тогда
				Сумма=Сумма;	
				СтрокаТЗ.Коэф=1;
			иначе
				Сумма=0;
			конецесли;
		конецесли;
	иначе
		
		Если НАчалоДня(РезервПо)=НачалоДня(Объект.Дата) тогда //сегодня выехал.
			Если СтрокаТЗ.Бронь.НовыйРассчет и Сумма=0 Тогда 
				Сумма=ПолучитьСтоимостьНовыйРасчет(СтрокаТЗ.Бронь,НачалоДня(Объект.Дата-86400));
			КонецЕсли;
			Если (Час(СтрокаТЗ.Выезд)-12)<5 и (Час(СтрокаТЗ.Выезд)-12)>2 тогда // почасовая прибавка
				Сумма=Сумма*((Час(СтрокаТЗ.Выезд)+?(Минута(СтрокаТЗ.Выезд)>30,1,0)-12)/24);
				Коэф=((Час(СтрокаТЗ.Выезд)+?(Минута(СтрокаТЗ.Выезд)>30,1,0)-12)/24);
			иначеесли (Час(СтрокаТЗ.Выезд)-12)<=12 и (Час(СтрокаТЗ.Выезд)-12)>2 тогда // 1,5 тариф (+половина след. сутки)
				Сумма=Сумма*0.5;
				Коэф=Коэф*0.5;
			иначеесли (Час(СтрокаТЗ.Выезд)-12)>2 тогда
				Сумма=Сумма;	
				Коэф=СтрокаТЗ.Коэф*1;
			иначе
				Сумма=0;
			конецесли;
		конецесли;
	конецесли;
	СтрокаТЗ.Скидка=(?(СтрокаТЗ.Тариф_НеИспользуется.БазовыйТариф.Пустая(),0,СтрокаТЗ.Тариф_НеИспользуется.БазовыйТариф.Цена-Стоимость)+(Стоимость))*Коэф;
	Если Сумма=0 тогда
		СтрокаТЗ.Скидка=0;
	конецесли;
	
	Возврат Сумма;
	
КонецФункции


&НаСервереБезКонтекста
Функция РасчитатьСтоимостьФакт(ОснРеквизит, СтрокаТЗ)
	ОбъектЗначение = ДанныеФормыВЗначение(ОснРеквизит, Тип("ДокументОбъект.ЕжедневныйАудит"));
	
	Стоимость=?(СтрокаТЗ.Бронь.НовыйРассчет,ПолучитьСтоимостьНовыйРасчет(СтрокаТЗ.Бронь,НачалоДня(ОбъектЗначение.Дата)),СтрокаТЗ.Тариф_НеИспользуется.Цена*?(СтрокаТЗ.Бронь.Оплачивает.Категория.Пустая(),1,1-СтрокаТЗ.Бронь.Оплачивает.Категория.Скидка/100));
	СтоимостьФакт=?(СтрокаТЗ.Бронь.НовыйРассчет,ПолучитьСтоимостьНовыйРасчет(СтрокаТЗ.Бронь,НачалоДня(ОбъектЗначение.Дата)),СтрокаТЗ.ТарифКоррекция.Цена*?(СтрокаТЗ.Бронь.Оплачивает.Категория.Пустая(),1,1-СтрокаТЗ.Бронь.Оплачивает.Категория.Скидка/100));
	
	СтрокаТЗ.Коэф=1;
	Если СтрокаТЗ.ТарифКоррекция.Код="000000001" или Найти(СтрокаТЗ.ТарифКоррекция.Наименование,"Бон Шанс")>0 тогда
		Если (СтрокаТЗ.ЗаездКоррекция-НачалоДня(СтрокаТЗ.ЗаездКоррекция))<6*60*60  и НачалоДня(СтрокаТЗ.ЗаездКоррекция)=НачалоДня(ОбъектЗначение.Дата)  тогда // прошлые сутки
			СтрокаТЗ.Коэф=0;
			Возврат 0;			
		иначе			
			ВремяВНомере=СтрокаТЗ.ВыездКоррекция-СтрокаТЗ.ЗаездКоррекция;
			СуммаСверх=?(ВремяВНомере>(3600*4-1),(Цел(ВремяВНомере/3600)-3)*200,0);
			Возврат (Стоимость)+СуммаСверх+СтрокаТЗ.СуммаКоррекция;
		КонецЕсли;
	конецесли;
	
	
	Если (СтрокаТЗ.ВыездКоррекция-СтрокаТЗ.ЗаездКоррекция)<86400 и (СтрокаТЗ.ВыездКоррекция-СтрокаТЗ.ЗаездКоррекция)>0 и НАчалоДня(СтрокаТЗ.ВыездКоррекция)=НачалоДня(ОбъектЗначение.Дата) и НАчалоДня(СтрокаТЗ.ЗаездКоррекция)=НачалоДня(ОбъектЗначение.Дата) тогда // нет суток
		Если НАчалоДня(СтрокаТЗ.ЗаездКоррекция)=НачалоДня(ОбъектЗначение.Дата) тогда // сегодня ночью заехал
			Если (СтрокаТЗ.ЗаездКоррекция-НачалоДня(СтрокаТЗ.ЗаездКоррекция))<6*60*60 тогда // прошлые сутки
				СтрокаТЗ.Коэф=0;
				Возврат 0;			
			конецесли;
		конецесли;
		//	
		СтрокаТЗ.Коэф=1;
		Возврат (СтоимостьФакт)+СтрокаТЗ.СуммаКоррекция;	
	конецесли;
	
	//
	//Если (СтрокаТЗ.ВыездКоррекция-СтрокаТЗ.ЗаездКоррекция)<86400 и (СтрокаТЗ.ВыездКоррекция-СтрокаТЗ.ЗаездКоррекция)>0 и НАчалоДня(СтрокаТЗ.ВыездКоррекция)=НачалоДня(Дата) тогда // нет суток
	//	СтрокаТЗ.Коэф=0;
	//	Возврат 0;	
	//конецесли;
	
	РезервС=?(СтрокаТЗ.ЗаездКоррекция<Дата(2000,1,1),СтрокаТЗ.Бронь.РезервС,СтрокаТЗ.ЗаездКоррекция);	
	РезервПО=?(СтрокаТЗ.ВыездКоррекция<Дата(2000,1,1),СтрокаТЗ.Бронь.РезервПо,СтрокаТЗ.ВыездКоррекция);	
	
	Сумма=(СтоимостьФакт);
	Если НАчалоДня(СтрокаТЗ.ЗаездКоррекция)=НачалоДня(ОбъектЗначение.Дата+86400) тогда //"Завтра" заехал.
		Если СтрокаТЗ.Бронь.НовыйРассчет и Сумма=0 Тогда 
				Сумма=ПолучитьСтоимостьНовыйРасчет(СтрокаТЗ.Бронь,НачалоДня(ОбъектЗначение.Дата+86400));
			КонецЕсли;
		//Если НАчалоДня(РезервС)=НачалоДня(СтрокаТЗ.ЗаездКоррекция) тогда
		Если (СтрокаТЗ.ЗаездКоррекция-НачалоДня(СтрокаТЗ.ЗаездКоррекция))<6*60*60 тогда // двойной тариф (+прошлые сутки)
			Сумма=Сумма*1;
			СтрокаТЗ.Коэф=СтрокаТЗ.Коэф*1;
		иначеесли (СтрокаТЗ.ЗаездКоррекция-НачалоДня(СтрокаТЗ.ЗаездКоррекция))>=6*60*60-40 и (СтрокаТЗ.ЗаездКоррекция-НачалоДня(СтрокаТЗ.ЗаездКоррекция))<=9*60*60 тогда // 1,5 тариф (+половина прошлые сутки)
			Сумма=Сумма*0.5;	
			СтрокаТЗ.Коэф=СтрокаТЗ.Коэф*0.5;
		конецесли;			
		//Конецесли;
	конецесли;
	Если Найти(СтрокаТЗ.ТарифКоррекция.Наименование,"Свадебный")>0 тогда // можно до 6 выезжать
		Если НАчалоДня(РезервПо)=НачалоДня(ОбъектЗначение.Дата) тогда //сегодня выехал.
			Если (Час(СтрокаТЗ.ВыездКоррекция)-12)<=6 тогда // можно до 6 выезжать
				Сумма=0;
			иначеесли (Час(СтрокаТЗ.ВыездКоррекция)-12)>0 тогда
				Сумма=Сумма;	
				СтрокаТЗ.Коэф=1;
			иначе
				Сумма=0;
			конецесли;
		конецесли;
	иначе
		Если НАчалоДня(РезервПо)=НачалоДня(ОбъектЗначение.Дата) тогда //сегодня выехал.
			Если СтрокаТЗ.Бронь.НовыйРассчет и Сумма=0 Тогда 
				Сумма=ПолучитьСтоимостьНовыйРасчет(СтрокаТЗ.Бронь,НачалоДня(ОбъектЗначение.Дата-86400));
			КонецЕсли;
			
			
			
			Если (Час(СтрокаТЗ.ВыездКоррекция)-12)<5 и (Час(СтрокаТЗ.ВыездКоррекция)-12)>2 тогда // почасовая прибавка
				Сумма=Сумма*((Час(СтрокаТЗ.ВыездКоррекция)+?(Минута(СтрокаТЗ.ВыездКоррекция)>30,1,0)-12)/24);
				СтрокаТЗ.Коэф=(Час(СтрокаТЗ.ВыездКоррекция)+?(Минута(СтрокаТЗ.ВыездКоррекция)>30,1,0)-12)/24;
				
			иначеесли (Час(СтрокаТЗ.ВыездКоррекция)-12)<=12 и (Час(СтрокаТЗ.ВыездКоррекция)-12)>2 тогда // 1,5 тариф (+половина след. сутки)
				Сумма=Сумма*0.5;
				СтрокаТЗ.Коэф=0.5;
			иначеесли (Час(СтрокаТЗ.ВыездКоррекция)-12)>2 тогда
				Сумма=Сумма;	
				СтрокаТЗ.Коэф=1;
			иначе
				Сумма=0;
			конецесли;
		конецесли;
	конецесли;
	
	СтрокаТЗ.СкидкаКоррекция=(?(СтрокаТЗ.ТарифКоррекция.БазовыйТариф.Пустая(),0,СтрокаТЗ.ТарифКоррекция.БазовыйТариф.Цена-СтоимостьФакт) + (СтоимостьФакт))*СтрокаТЗ.Коэф;
	Если Сумма=0 тогда
		СтрокаТЗ.СкидкаКоррекция=0;
	конецесли;
	Возврат Сумма+СтрокаТЗ.СуммаКоррекция;
	
КонецФункции

