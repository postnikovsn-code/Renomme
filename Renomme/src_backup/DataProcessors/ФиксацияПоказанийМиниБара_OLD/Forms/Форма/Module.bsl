 //   ТЗ= Объект.ДанныеПоМинибару.НайтиСтроки(ПоискСтр);
 //   Если ТЗ.Количество()=1 тогда
 //   	ТекСтр.Принять=Истина;
 //   конецесли;

 //   	
 //   
 //   КонецЦикла; 
 //
