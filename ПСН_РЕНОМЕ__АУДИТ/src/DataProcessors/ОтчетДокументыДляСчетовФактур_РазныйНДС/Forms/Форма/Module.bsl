	//СтрокаТаблицыПараметры.ДатаСчетаФактуры = Формат(Строка.ДатаСчетаФактуры, "ДФ=dd.MM.yy");
	//СтрокаТаблицыПараметры.НомерСчетаФактуры = ПечатьСервер.НомерСчетаДляПечати(Строка.НомерЗаявки, Строка.НомерСчета);
	//СтрокаТаблицыПараметры.ДатаСчетаФактуры =  Строка.ДатаСчетаПо;
	
