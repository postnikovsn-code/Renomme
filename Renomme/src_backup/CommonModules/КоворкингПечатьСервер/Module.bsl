Функция ПечатьСчетаЮрЛицоШапка_СчетКоворкинг(ТабДок, Макет, ДокументДолгСсылка)  Экспорт  
НомерСчета = ДокументДолгСсылка.Номер;
ДатаСчета = ДокументДолгСсылка.Дата;

Оплачивает = КоворкингСервер.ОплачиваетСчет(ДокументДолгСсылка);	

//ДанныеОрганизация = Справочники.Организации.ПолучитьДанныеОрганизации(Истина);
ТекущаяОрганизация = НастройкиСервер.ПолучитьТекущуюОрганизацию();

Область = Макет.ПолучитьОбласть("ЗаголовокСчета");
Область.Параметры.ЗаголовокСчета = "Коворкинг " + ТекущаяОрганизация.НаименованииеОтеляДляДокументов 
	+ " ИНН " + ТекущаяОрганизация.КоворкингИНН 
	+ ?(ЗначениеЗаполнено(ТекущаяОрганизация.КоворкингКПП), " КПП " + ТекущаяОрганизация.КоворкингКПП, "")
	+ " " + ТекущаяОрганизация.КоворкингОрганизацияДляДокументов
	+ Символы.ПС + ТекущаяОрганизация.КоворкингАдресДляДокументов;	
	;
	
Область.Параметры.Получатель = "Коворкинг " + ТекущаяОрганизация.НаименованииеОтеляДляДокументов 
	+ " ИНН " + ТекущаяОрганизация.КоворкингИНН 
	+ ?(ЗначениеЗаполнено(ТекущаяОрганизация.КоворкингКПП), " КПП " + ТекущаяОрганизация.КоворкингКПП, "")
	+ " " + ТекущаяОрганизация.КоворкингОрганизацияДляДокументов
	;	

Область.Параметры.БанкПолучателя = ТекущаяОрганизация.КоворкингСчетБанкПолучателя;
Область.Параметры.БИКБанкаПолучателя = ТекущаяОрганизация.КоворкингСчетБИКБанкаПолучателя;	
Область.Параметры.КорСчетБанкаПолучателя = ТекущаяОрганизация.КоворкингСчетКорСчетБанкаПолучателя;	
Область.Параметры.СчетБанкаПолучателя = ТекущаяОрганизация.КоворкингСчетСчетБанкаПолучателя;	
Область.Параметры.ЗаголовокИНН = ТекущаяОрганизация.КоворкингИНН;	
Область.Параметры.ЗаголовокКПП = ТекущаяОрганизация.КоворкингКПП;	

ТабДок.Вывести(Область);

Область = Макет.ПолучитьОбласть("Заголовок");
ТекстЗаголовка="Счет № " + НомерСчета + " от " + Формат(ДатаСчета, "ДФ=dd.MM.yy");	
Область.Параметры.ТекстЗаголовка = ТекстЗаголовка; 
ТабДок.Вывести(Область);

Область = Макет.ПолучитьОбласть("Поставщик");
ПредставлениеПолучателя = ОбщееСервер.ПолучитьПредставлениеКлиента(Оплачивает);
Область.Параметры.ПредставлениеПолучателя = ПредставлениеПолучателя;
ТабДок.Вывести(Область);

//Область = Макет.ПолучитьОбласть("Покупатель");
//Область.Параметры.ПредставлениеПолучателя=ОбщийМодульСервер.ПолучитьПредставлениеКлиента(Клиент);	
//ТабДок.Вывести(Область);

Возврат ТекстЗаголовка;  
КонецФункции

Процедура ПечатьСчетаЮрЛицоПодвал_СчетКоворкинг(ТабДок, Макет) 
