// Адаптер сканера паспортов PassportBox к текущей конфигурации "ОТЕЛЬ".
// Содержит функции преобразования значений и приведения типов, зависящие от
// метаданных конкретной конфигурации (перечисления, справочники).
// Универсальный HTTP-клиент сканера - см. PassportBoxВызовСервера.

#Область ПрограммныйИнтерфейс

// Преобразует строковое представление пола от PassportBox в перечисление Пол.
//
// Параметры:
//   СтрокаПола - Строка - значение, полученное от сканера.
//
// Возвращаемое значение:
//   ПеречислениеСсылка.Пол - Мужской/Женский, либо пустая ссылка, если значение не распознано.
Функция Пол_СтрокуВПеречисление(Знач СтрокаПола) Экспорт
	НормСтрока = ВРег(СокрЛП(СтрокаПола));
	Если НормСтрока = "M" ИЛИ НормСтрока = "МУЖ" ИЛИ НормСтрока = "МУЖ." ИЛИ НормСтрока = "МУЖСКОЙ" ИЛИ НормСтрока = "MALE" Тогда
		Возврат Перечисления.Пол.Мужской;
	ИначеЕсли НормСтрока = "F" ИЛИ НормСтрока = "W" ИЛИ НормСтрока = "ЖЕН" ИЛИ НормСтрока = "ЖЕН." ИЛИ НормСтрока = "ЖЕНСКИЙ" ИЛИ НормСтрока = "FEMALE" Тогда
		Возврат Перечисления.Пол.Женский;
	Иначе
		Возврат Перечисления.Пол.ПустаяСсылка();
	КонецЕсли;
КонецФункции

#КонецОбласти
