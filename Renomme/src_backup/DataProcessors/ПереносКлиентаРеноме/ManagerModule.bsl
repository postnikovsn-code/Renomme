Функция ПолучитьПодключениеКФайловойБД(ПутьКФайловойБазе, ИмяПользователя, Пароль)
//Параметры = "File=""C:\1CBase"";Usr=""login"";Pwd=""password"";";

ПараметрыСоединения = "File=""" + ПутьКФайловойБазе + """;Usr=""" + ИмяПользователя + """;Pwd=""" + Пароль + """;";

COMConnector= Новый COMОбъект("V83.COMConnector");
Попытка
Возврат COMConnector.Connect(ПараметрыСоединения);
Исключение
Сообщить("Ошибка подключения! " + ОписаниеОшибки() );
Возврат Неопределено;
КонецПопытки;

КонецФункции

Процедура ЗаполнитьЗначенияКлиент(Получатель, Источник, МассивИменаПолей, Соединение)
	
Для Каждого Имя Из МассивИменаПолей Цикл
	Если Имя = "Ссылка" 
	ИЛИ Имя = "Родитель" 
	//ИЛИ Имя = "РодительНаименование" 
	ИЛИ Имя = "ЭтоГруппа" 
	ИЛИ Имя = "Код" 
	
