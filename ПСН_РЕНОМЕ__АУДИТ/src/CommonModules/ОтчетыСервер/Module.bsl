Функция ТЗ_УслугиЗаявки(Заявки) Экспорт
Запрос = Новый Запрос("ВЫБРАТЬ
                      |	ЗаявкаНаБронированиеДопУслуги.Ссылка КАК Заявка,
                      |	ЗаявкаНаБронированиеДопУслуги.ГУИД КАК ГУИД,
                      |	ЗаявкаНаБронированиеДопУслуги.Услуга КАК Услуга,
                      |	ЗаявкаНаБронированиеДопУслуги.Цена КАК Цена,
                      |	ЗаявкаНаБронированиеДопУслуги.Количество КАК Количество,
                      |	ЗаявкаНаБронированиеДопУслуги.ВСчет КАК ВСчет,
                      |	ЗаявкаНаБронированиеДопУслуги.ДатаУслуги КАК ДатаУслуги,
                      |	ЗаявкаНаБронированиеДопУслуги.Цена * ЗаявкаНаБронированиеДопУслуги.Количество КАК Сумма,
                      |	ЗаявкаНаБронированиеДопУслуги.Цена * ЗаявкаНаБронированиеДопУслуги.Количество КАК СуммаУслугиДолг,
                      |	ЗаявкаНаБронированиеСчетаДетальноДолги.СчетГУИД КАК СчетГУИД,
                      |	ЕСТЬNULL(ЗаявкаДопУслугиОплаты.СуммаОплаты, 0) КАК СуммаУслугиОплата
                      |ИЗ
                      |	Документ.ЗаявкаНаБронирование.ДопУслуги КАК ЗаявкаНаБронированиеДопУслуги
                      |		ЛЕВОЕ СОЕДИНЕНИЕ Документ.ЗаявкаНаБронирование.СчетаДетальноДолги КАК ЗаявкаНаБронированиеСчетаДетальноДолги
                      |		ПО ЗаявкаНаБронированиеДопУслуги.Ссылка = ЗаявкаНаБронированиеСчетаДетальноДолги.Ссылка
                      |			И ЗаявкаНаБронированиеДопУслуги.ГУИД = ЗаявкаНаБронированиеСчетаДетальноДолги.ДолгиГУИД
                      |		ЛЕВОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
                      |			ЗаявкаНаБронированиеРаспределениеОплатДолги.Ссылка КАК Ссылка,
                      |			ЗаявкаНаБронированиеРаспределениеОплатДолги.ДолгиГУИД КАК ДолгиГУИД,
                      |			СУММА(ЗаявкаНаБронированиеРаспределениеОплатДолги.СуммаОплаты) КАК СуммаОплаты
                      |		ИЗ
                      |			Документ.ЗаявкаНаБронирование.РаспределениеОплатДолги КАК ЗаявкаНаБронированиеРаспределениеОплатДолги
                      |		
                      |		СГРУППИРОВАТЬ ПО
                      |			ЗаявкаНаБронированиеРаспределениеОплатДолги.Ссылка,
                      |			ЗаявкаНаБронированиеРаспределениеОплатДолги.ДолгиГУИД) КАК ЗаявкаДопУслугиОплаты
                      |		ПО ЗаявкаНаБронированиеДопУслуги.Ссылка = ЗаявкаДопУслугиОплаты.Ссылка
                      |			И ЗаявкаНаБронированиеДопУслуги.ГУИД = ЗаявкаДопУслугиОплаты.ДолгиГУИД
                      |ГДЕ
                      |	ЗаявкаНаБронированиеДопУслуги.Ссылка В (&Заявки)
                      |	И ЗаявкаНаБронированиеДопУслуги.ВСчет = ИСТИНА
                      |	");
	
	Запрос.УстановитьПараметр("Заявки", Заявки);
	ТЗ_Услуги = Запрос.Выполнить().Выгрузить(); 
	
Возврат ТЗ_Услуги;	
КонецФункции

