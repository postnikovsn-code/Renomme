// Модуль объекта документа «Расходная накладная».
//
// Документ списывает товар со склада: при проведении в регистр
// «ОстаткиТоваров» записываются движения «Расход», но только если
// остатка достаточно — иначе проведение прерывается с подсказкой.

#Область ОбработчикиСобытий

Процедура ОбработкаЗаполнения(ДанныеЗаполнения, СтандартнаяОбработка)

	Если Не ЗначениеЗаполнено(Склад) Тогда
		Склад = СкладПовтИсп.ОсновнойСклад();
	КонецЕсли;

КонецПроцедуры

Процедура ПередЗаписью(Отказ, ПараметрыЗаписи)

	Если ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;

	РассчитатьСуммыСтрок();

КонецПроцедуры

Процедура ОбработкаПроведения(Отказ, РежимПроведения)

	// Проведение с предварительным контролем остатков на складе.
	СкладСервер.ОтгрузитьТовары(ЭтотОбъект, Отказ);

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Процедура РассчитатьСуммыСтрок()

	Для Каждого СтрокаТЧ Из Товары Цикл
		СтрокаТЧ.Сумма = Окр(СтрокаТЧ.Количество * СтрокаТЧ.Цена, 2);
	КонецЦикла;

КонецПроцедуры

#КонецОбласти
