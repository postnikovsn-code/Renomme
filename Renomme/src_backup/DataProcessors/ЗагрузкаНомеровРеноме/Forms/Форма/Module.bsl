&НаСервере
Процедура ЗагрузитьДанныеНомеровНаСервере()
//ПараметрыСоединения = "File=""D:\DB"";Usr=""Администратор"";Pwd=""123"";";
ПараметрыСоединения = ПараметрыСоединения();

Соединение = Новый COMОбъект("V83.COMConnector");
Попытка
	База = Соединение.Connect(ПараметрыСоединения);
Исключение
	Сообщить("Ошибка подключения! " + ОписаниеОшибки());
	Возврат ;
КонецПопытки;

Запрос = База.NewObject("Запрос");
Запрос.Текст = 
    "ВЫБРАТЬ
    |	НомернойФонд.Код КАК Код,
    |	НомернойФонд.ОбщийКондиционер КАК ОбщийКондиционер,
    |	НомернойФонд.ЦветНомераR КАК ЦветНомераR,
    |	НомернойФонд.ЦветНомераG КАК ЦветНомераG,
    |	НомернойФонд.ЦветНомераB КАК ЦветНомераB,
     |	НомернойФонд.РаздельныеКровати КАК РаздельныеКровати,
    |	НомернойФонд.Балкон КАК Балкон,
    |	НомернойФонд.ОписаниеНомера КАК ОписаниеНомера,
   |	НомернойФонд.Соседи.(
    |		СоседнийНомер КАК СоседнийНомер
    |	) КАК Соседи
    |ИЗ
    |	Справочник.НомернойФонд КАК НомернойФонд";

ТЗ = Запрос.Выполнить().Выгрузить(); 	

Для Каждого Строка Из ТЗ Цикл
	НомерОтель = Справочники.НомернойФонд.НайтиПоКоду(Строка.Код);
	
	Если ЗначениеЗаполнено(НомерОтель) Тогда
		НомерОтельОбъект = НомерОтель.ПолучитьОбъект();
		
		ОбщийКондиционер = Справочники.НомернойФонд.НайтиПоКоду(Строка.ОбщийКондиционер.Код);
		НомерОтельОбъект.ОбщийКондиционер = ОбщийКондиционер;
		
		НомерОтельОбъект.ЦветНомераR = Строка.ЦветНомераR;
		НомерОтельОбъект.ЦветНомераG = Строка.ЦветНомераG;
		НомерОтельОбъект.ЦветНомераB = Строка.ЦветНомераB;
		НомерОтельОбъект.РаздельныеКровати = Строка.РаздельныеКровати;
		НомерОтельОбъект.Балкон = Строка.Балкон;
		НомерОтельОбъект.ОписаниеНомера = Строка.ОписаниеНомера;
		
		
		//Если НомерОтельОбъект.Соседи.Количество() > 0 Тогда Продолжить; КонецЕсли;
		НомерОтельОбъект.Соседи.Очистить();
		Для Каждого СтрокаСоседи Из Строка.Соседи Цикл
			
			СоседнийНомер = Справочники.НомернойФонд.НайтиПоКоду(СтрокаСоседи.СоседнийНомер.Код);
			Если НЕ ЗначениеЗаполнено(СоседнийНомер) Тогда Продолжить; КонецЕсли;

			НоваяСтрокаСоседи =  НомерОтельОбъект.Соседи.Добавить();
			НоваяСтрокаСоседи.СоседнийНомер = СоседнийНомер;
		КонецЦикла;
		
		НомерОтельОбъект.Записать();
		
	КонецЕсли;	
	
КонецЦикла;	
КонецПроцедуры
