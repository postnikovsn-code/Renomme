
Функция СуммаЭквайринга(Строка) Экспорт
ТипОплаты = Строка.ТипОплаты;
ПроцентЭквайринга = Строка.ПроцентЭквайринга;

Проверить = Ложь;
Если ЗначениеЗаполнено(Строка.ДокументОплаты) Тогда
	Если ТипЗнч(Строка.ДокументОплаты) = Тип("УникальныйИдентификатор") Тогда
		Проверить = Истина;
	ИначеЕсли Строка.ДокументОплаты.ПолучитьОбъект() <> Неопределено Тогда 
		Проверить = Истина;
	КонецЕсли;
КонецЕсли;	
	
Если Проверить Тогда
	Если ТипОплаты = 1	Тогда 
		Сумма = Строка.СуммаОплаты;
	ИначеЕсли ТипОплаты = 0	Тогда 
		Сумма = Окр(Строка.СуммаОплаты * (Строка.СуммаДокументаОплатыКарта / Строка.СуммаДокументаОплаты), 2);
	ИначеЕсли ТипОплаты = 4	Тогда 
		Сумма = Строка.СуммаОплаты;
	ИначеЕсли ТипОплаты = 5	Тогда 
		Сумма = Строка.СуммаОплаты;
		ПроцентЭквайринга = Строка.ПроцентЭквайрингаСБП;
	Иначе
		Сумма = 0; 
	КонецЕсли;
Иначе
	Сумма = 0; 
КонецЕсли;

СуммаЭквайринга = Окр(Сумма * ПроцентЭквайринга / 100, 2);     

Возврат СуммаЭквайринга; 
КонецФункции

//
Функция СуммаЭквайрингаПроживание(ТЗ_Проживание, ТЗ_Оплаты) Экспорт
СуммаЭквайрингаПроживание = 0;
Для Каждого СтрокаОплаты Из ТЗ_Оплаты Цикл
	Для Каждого СтрокаПроживание Из ТЗ_Проживание Цикл 
		Если СтрокаПроживание.ГУИД = СтрокаОплаты.ДолгиГУИД Тогда
			СуммаЭквайрингаПроживание = СуммаЭквайрингаПроживание + СуммаЭквайринга(СтрокаОплаты);			
		КонецЕсли;		
	КонецЦикла;
КонецЦикла;
		
Возврат СуммаЭквайрингаПроживание;		
КонецФункции

