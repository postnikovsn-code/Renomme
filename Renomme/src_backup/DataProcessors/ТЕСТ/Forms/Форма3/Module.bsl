КонецФункции


//
&НаКлиенте
Процедура ОбновитьСкидкаКлиентаБоншанс(Команда)
	ОбновитьСкидкаКлиентаБоншансНаСервере();
КонецПроцедуры

&НаСервере
Процедура ОбновитьСкидкаКлиентаБоншансНаСервере()
Запрос = Новый Запрос("ВЫБРАТЬ
                      |	ЗаявкаНаБронирование.Ссылка КАК Ссылка
                      |ИЗ
                      |	Документ.ЗаявкаНаБронирование КАК ЗаявкаНаБронирование
                      |ГДЕ
                      |	ЗаявкаНаБронирование.БонШанс = ИСТИНА
                      |	И ЗаявкаНаБронирование.ПометкаУдаления = ЛОЖЬ
                      |	И ЗаявкаНаБронирование.СкидкаКлиента <> 0");

ТЗ = Запрос.Выполнить().Выгрузить();

Для Каждого Строка Из ТЗ Цикл
	ЗаявкаОбъект = Строка.Ссылка.ПолучитьОбъект();
	ЗаявкаОбъект.СкидкаКлиента = 0;
	ЗаявкаОбъект.УровеньСкидкиКлиента = 0;
	
	Попытка
		ЗаявкаОбъект.Записать(РежимЗаписиДокумента.Проведение);
	Исключение
		Сообщить("Ошибка проведения " + ЗаявкаОбъект.Ссылка + " - " +ОписаниеОшибки());
	КонецПопытки;		
КонецЦикла;
КонецПроцедуры
//


//
&НаКлиенте
Процедура УстановитьУровеньСкидки(Команда)
	УстановитьУровеньСкидкиНаСервере();
КонецПроцедуры

&НаСервере
Процедура УстановитьУровеньСкидкиНаСервере()
ЗапросЗаявки = Новый Запрос("ВЫБРАТЬ
                      |	ЗаявкаНаБронирование.Ссылка КАК Ссылка
                      |ИЗ
                      |	Документ.ЗаявкаНаБронирование КАК ЗаявкаНаБронирование
                      |ГДЕ
                      |	ЗаявкаНаБронирование.БонШанс = ЛОЖЬ
                      |	И ЗаявкаНаБронирование.ПометкаУдаления = ЛОЖЬ
                      |	И ЗаявкаНаБронирование.СкидкаКлиента <> 0");
ТЗЗаявки = ЗапросЗаявки.Выполнить().Выгрузить();	

ЗапросСкидки = Новый Запрос("ВЫБРАТЬ
                      |	СкидкиКлиента.КоличествоНочей КАК КоличествоНочей,
                      |	СкидкиКлиента.Скидка КАК Скидка,
                      |	СкидкиКлиента.Уровень КАК Уровень
                      |ИЗ
                      |	РегистрСведений.СкидкиКлиента КАК СкидкиКлиента
                      |ГДЕ
                      |	СкидкиКлиента.Скидка = &Скидка
                      |
                      |УПОРЯДОЧИТЬ ПО
                      |	КоличествоНочей");

СкидкаКлиента = 0;
Для Каждого Строка Из ТЗЗаявки Цикл
	ЗаявкаОбъект = Строка.Ссылка.ПолучитьОбъект();
	
	ЗапросСкидки.УстановитьПараметр("Скидка", Строка.Ссылка.СкидкаКлиента); 
	
	ТЗСкидки = ЗапросСкидки.Выполнить().Выгрузить();
	Если ТЗСкидки.Количество() = 0 Тогда Продолжить; КонецЕсли;
	
	ЗаявкаОбъект.УровеньСкидкиКлиента = ТЗСкидки[0].Уровень;
	
	Попытка
		ЗаявкаОбъект.Записать(РежимЗаписиДокумента.Проведение);
	Исключение
		Сообщить("Ошибка проведения " + ЗаявкаОбъект.Ссылка + " - " +ОписаниеОшибки());
	КонецПопытки;	
КонецЦикла;
КонецПроцедуры
//
