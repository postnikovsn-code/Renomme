Функция КлиентКемВыдан(Клиент)
ПунктыВыдачиФМС_NEW = Клиент.ПунктыВыдачиФМС_NEW;
Если ТипЗнч(ПунктыВыдачиФМС_NEW) = Тип("СправочникСсылка.ПунктыВыдачиФМС_NEW") Тогда
	КлиентКемВыдан = ПунктыВыдачиФМС_NEW.Наименование;
ИначеЕсли ТипЗнч(ПунктыВыдачиФМС_NEW) = Тип("Строка") Тогда
	КлиентКемВыдан = ПунктыВыдачиФМС_NEW;
Иначе
	КлиентКемВыдан = "";
КонецЕсли;	 

Возврат КлиентКемВыдан;
