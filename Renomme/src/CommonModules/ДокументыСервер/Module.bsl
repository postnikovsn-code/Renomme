Функция ДвухМестный(ДанныеОбъект) Экспорт
Если ДанныеОбъект.КатегорияНомера.ТолькоОдноместный Тогда 
	Двухместный=Ложь;
	
	Возврат Двухместный;
КонецЕсли;
	
Если ДанныеОбъект.КолВоЧеловек = 1 Тогда
	Двухместный=Ложь;
ИначеЕсли ДанныеОбъект.КолВоЧеловек > 1 Тогда 
	Двухместный=Истина;
Иначе 
	Двухместный = Неопределено;
КонецЕсли;
 
Возврат Двухместный;  
КонецФункции

Функция ПроверкаЗаполненияЗаявкаНабронированиеТекстСообщения(ДанныеОбъект, Разделитель) Экспорт
ТекстСообщения = "";

Если ДанныеОбъект.Клиент.Пустая() тогда
	ТекстСообщения = ОбщийФункционалКлиентСервер.ДобавитьТекст(ТекстСообщения, "Незаполнен клиент.", Разделитель);
конецесли;

Если ДанныеОбъект.КатегорияНомера.Пустая() тогда
	ТекстСообщения = ОбщийФункционалКлиентСервер.ДобавитьТекст(ТекстСообщения, "Незаполнена категория номера.", Разделитель);
конецесли;

Если ДанныеОбъект.НомерВРезерв.Пустая() И НЕ ДанныеОбъект.ЛистОжидания тогда
	ТекстСообщения = ОбщийФункционалКлиентСервер.ДобавитьТекст(ТекстСообщения, "Незаполнен номер.", Разделитель);
конецесли;

Если НЕ ЗначениеЗаполнено(ДанныеОбъект.РезервС) тогда
	ТекстСообщения = ОбщийФункционалКлиентСервер.ДобавитьТекст(ТекстСообщения, "Незаполнено Резерв С.", Разделитель);
конецесли;

Если ДанныеОбъект.ВремяЗаезда.Пустая() тогда
	ТекстСообщения = ОбщийФункционалКлиентСервер.ДобавитьТекст(ТекстСообщения, "Незаполнено время заезда.", Разделитель);
конецесли;

Если НЕ ЗначениеЗаполнено(ДанныеОбъект.РезервПо) тогда
	ТекстСообщения = ОбщийФункционалКлиентСервер.ДобавитьТекст(ТекстСообщения, "Незаполнено Резерв По.", Разделитель);
конецесли;

Если ДанныеОбъект.ВремяВыезда.Пустая() тогда
	ТекстСообщения = ОбщийФункционалКлиентСервер.ДобавитьТекст(ТекстСообщения, "Незаполнено время выезда.", Разделитель);
конецесли;

Если ДанныеОбъект.РезервС > ДанныеОбъект.РезервПо Тогда
	ТекстСообщения = ОбщийФункционалКлиентСервер.ДобавитьТекст(ТекстСообщения, "Резерв С > Резерв По.", Разделитель);
конецесли;

Если НЕ ЗначениеЗаполнено(ДанныеОбъект.КаналБронирования) Тогда
	ТекстСообщения = ОбщийФункционалКлиентСервер.ДобавитьТекст(ТекстСообщения, "Не заполнен Канал бронирования.", Разделитель);
конецесли;

Если НЕ ЗначениеЗаполнено(ДанныеОбъект.ТипБронирования) Тогда
	ТекстСообщения = ОбщийФункционалКлиентСервер.ДобавитьТекст(ТекстСообщения, "Не заполнен Тип бронирования.", Разделитель);
конецесли;

Возврат ТекстСообщения;

// + ПСН
//Если Тариф.Пустая() тогда
//	Сообщить("Незаполнен Тариф");
//	Возврат Ложь;
//конецесли;
// - ПСН
КонецФункции

