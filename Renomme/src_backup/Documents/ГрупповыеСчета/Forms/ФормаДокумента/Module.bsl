&НаСервере
Функция ДобавитьСчетЗаявкиВДокументДолгиИзОбработкаВыбора(ВыбранноеЗначение)
СтандартнаяОбработка = Ложь;

ДокументДолг = ВыбранноеЗначение.ЗаявкаСсылка;	
СчетГУИД = ВыбранноеЗначение.СчетГУИД;

ТолькоПроживание = ВыбранноеЗначение.ТолькоПроживание;
ТолькоУслуги = ВыбранноеЗначение.ТолькоУслуги;

НачатьТранзакцию();

Результат = ДобавитьСчетЗаявкиВДокументДолгиНаСервере(ДокументДолг, СчетГУИД, Объект, Объект.Ссылка, ТолькоПроживание, ТолькоУслуги);	
Если НЕ Результат Тогда
	ЭтаФорма.Записать(Новый Структура("РежимЗаписи", РежимЗаписиДокумента.Проведение));
КонецЕсли;

ЗафиксироватьТранзакцию();

Возврат Результат;
КонецФункции

