		ОтправитьПоПочтеНаКлиенте(ИмяВремPDF);
	КонецЕсли;
	
	Перейти ~ЗАКРЫТЬ; 
	
Иначе	
	
	Если ЕстьИзменения Тогда
		wdDialogFileSaveAs = 84;
		Диалог = MSWord.Dialogs(wdDialogFileSaveAs);
		Диалог.Name = ИмяФайла;
