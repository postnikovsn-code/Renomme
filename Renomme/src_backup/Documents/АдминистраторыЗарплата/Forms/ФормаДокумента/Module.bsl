Функция СуммаНадбавкаЗаСтандарты(Строка) 
//КоличествоРасчетныхДней = КоличествоРасчетныхДней(Строка); 
КоличествоРасчетныхДней = ((НачалоДня(Объект.ДК) - НачалоДня(Объект.ДН)) / (60 * 60 * 24)) + 1;

МесяцРасчета = Объект.ДН;
КоличествоДнейМесяц = День(КонецМесяца(МесяцРасчета));

АдминистраторСправочник = АдминистраторСправочник(Строка.Администратор);
СуммаНадбавкаЗаСтандарты = Окр(АдминистраторСправочник.НадбавкаЗаСтандарты * КоличествоРасчетныхДней / КоличествоДнейМесяц);

Возврат СуммаНадбавкаЗаСтандарты;
КонецФункции

