&НаСервере
Процедура УдалитьСканыКлиентовНаСервере()
Запрос = Новый Запрос;
Запрос.Текст = "ВЫБРАТЬ
|	Клиенты.Ссылка Как Ссылка
|ИЗ
|	Справочник.Клиенты КАК Клиенты
              |ГДЕ
              |	Клиенты.ПометкаУдаления = ЛОЖЬ
              |	И Клиенты.ЗагрузкаГИУДСтрока <> """"
              |	И Клиенты.ЭтоГруппа = ЛОЖЬ";

ТЗ = Запрос.Выполнить().Выгрузить();
Для Каждого Строка Из ТЗ Цикл
	КлиентОбъект = Строка.Ссылка.ПолучитьОбъект();
	Если КлиентОбъект.СканыДокументов.Количество() = 0 Тогда Продолжить; КонецЕсли;
	
	МассивКУдалению = Новый Массив;
	Для Каждого СтрокаСканы Из КлиентОбъект.СканыДокументов Цикл
		ПутьДоФото = СтрокаСканы.ПутьДоФото;
		Если СтрДлина(ПутьДоФото) < 40 Тогда Продолжить; КонецЕсли;
		Попытка 
			УдалитьФайлы(ПутьДоФото);
		Исключение
			Сообщить("Ошибка удаления файла: " + ПутьДоФото + " Описание ошибки: " + ОписаниеОшибки());
		КонецПопытки;
		
		МассивКУдалению.Добавить(СтрокаСканы);
	КонецЦикла;

	Для Каждого СтрокаСканы Из МассивКУдалению Цикл
		КлиентОбъект.СканыДокументов.Удалить(СтрокаСканы);
	КонецЦикла;
	КлиентОбъект.Записать();
КонецЦикла;
КонецПроцедуры








