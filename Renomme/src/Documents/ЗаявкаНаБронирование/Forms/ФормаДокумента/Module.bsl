	Сумма = Строка.СуммаКЗакрытию; 
	НоваяСтрока.Цена = Сумма;
	НоваяСтрока.Сумма = Сумма;
	
	НоваяСтрока.ПрочиеОплатыДокументОплаты = Строка.ДокументОплаты;
	НоваяСтрока.ПрочиеОплатыДокументДолг = Строка.ДокументДолг;
	
	//
