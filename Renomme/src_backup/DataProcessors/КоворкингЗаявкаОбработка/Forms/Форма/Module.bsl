&НаКлиенте
Процедура ДобавитьЗаявку(Команда)
ТС = Элементы.НомерКоворкингДерево.ТекущаяСтрока;
Если ТС = Неопределено Тогда Возврат; КонецЕсли;

ТД = НомерКоворкингДерево.НайтиПоИдентификатору(ТС);
НомерКоворкинг = ТД.НомерКоворкинг;

ЭтоГруппа = ОбщийФункционалСервер.ЗначениеРеквизитаНаСервере(НомерКоворкинг, "ЭтоГруппа");
Если ЭтоГруппа Тогда Возврат; КонецЕсли;

ПараметрыФормы = Новый Структура;
ПараметрыФормы.Вставить("КоворкингНомер", НомерКоворкинг);  

ОткрытьФорму("Документ.КоворкингЗаявка.Форма.ФормаДокумента", ПараметрыФормы, ЭтаФорма
	,,,,, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца); 
КонецПроцедуры

