// + Печать
&НаКлиенте
Процедура ПечатьСчета(Команда)
ТекущиеДанные = Элементы.Список.ТекущиеДанные;	
Если ТекущиеДанные = Неопределено Тогда Возврат; КонецЕсли;

Счет = Элементы.Список.ТекущаяСтрока;
	
ТабличныйДокумент = ПечатьСчетаНаСервере(Счет);	
Если ТабличныйДокумент = Неопределено Тогда Возврат; КонецЕсли;	

ПечатьКлиент.ОткрытьФормуПечатьСчетаИПодтверждения(ЭтаФорма, Счет, ТекущиеДанные.Контрагент
	, ТабличныйДокумент, Истина);
КонецПроцедуры

&НаСервере
Функция ПечатьСчетаНаСервере(Счет)
ТабличныйДокумент = ПечатьСервер.ПечатьГрупповогоСчета(Счет);		
Возврат ТабличныйДокумент; 
КонецФункции

&НаКлиенте
Процедура ПечатьАкта(Команда)
ТекущиеДанные = Элементы.Список.ТекущиеДанные;	
Если ТекущиеДанные = Неопределено Тогда Возврат; КонецЕсли;

Счет = Элементы.Список.ТекущаяСтрока;
	
ТабличныйДокумент = ПечатьАктаНаСервере(Счет);	
Если ТабличныйДокумент = Неопределено Тогда Возврат; КонецЕсли;	

ТабличныйДокумент.Показать("Групповой Акт");
КонецПроцедуры

&НаСервере
Функция ПечатьАктаНаСервере(Счет)
ДокументыДолгиТаблица = Счет.ДокументыДолги.Выгрузить();	
ДокументыДолгиТаблица.Сортировать("ДокументДолг");

//ТабличныйДокумент = ПечатьСервер.ПечатьГрупповогоАкта(Счет.ДокументыДолги, Счет.Контрагент, Счет.СвернутьВСчете);	
ТабличныйДокумент = ПечатьСервер.ПечатьГрупповогоАкта(ДокументыДолгиТаблица, Счет.Контрагент, Счет.СвернутьВСчете);	
Возврат ТабличныйДокумент; 
КонецФункции

&НаКлиенте
Процедура Подтверждение(Команда)
ТекущиеДанные = Элементы.Список.ТекущиеДанные;	
Если ТекущиеДанные = Неопределено Тогда Возврат; КонецЕсли;

Счет = Элементы.Список.ТекущаяСтрока;
	
ТабличныйДокумент = Неопределено;
Контрагент = ТекущиеДанные.Контрагент;      
ПечатьКлиент.ОткрытьФормуПечатьСчетаИПодтверждения(ЭтаФорма, Счет, Контрагент
	, ТабличныйДокумент, Истина);
КонецПроцедуры
