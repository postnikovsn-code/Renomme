  <attributes>
    <name>Список</name>
    <id>1</id>
    <valueType>
      <types>DynamicList</types>
    </valueType>
    <view>
      <common>true</common>
    </view>
    <edit>
      <common>true</common>
    </edit>
    <main>true</main>
    <extInfo xsi:type="form:DynamicListExtInfo">
      <queryText>ВЫБРАТЬ
	ДокументКассовыйДокумент.Ссылка КАК Ссылка,
	ДокументКассовыйДокумент.ПометкаУдаления КАК ПометкаУдаления,
	ДокументКассовыйДокумент.Номер КАК Номер,
	ДокументКассовыйДокумент.Дата КАК Дата,
	ДокументКассовыйДокумент.Проведен КАК Проведен,
	ДокументКассовыйДокумент.ОтКого КАК ОтКого,
	ДокументКассовыйДокумент.ОтКого.НаименованиеЮрЛица КАК ОтКогоНаименованиеЮрЛица,
	ВЫБОР
		КОГДА ДокументКассовыйДокумент.ОтКого.ТипКлиента = ЗНАЧЕНИЕ(Перечисление.ТипыКлиентов.ЮрЛицо)
			ТОГДА ДокументКассовыйДокумент.ОтКого.НаименованиеЮрЛица
		ИНАЧЕ ДокументКассовыйДокумент.ОтКого.Наименование
	КОНЕЦ КАК ОтКогоНаименование,
	ДокументКассовыйДокумент.Приход КАК Приход,
	ДокументКассовыйДокумент.Сумма КАК Сумма,
	ДокументКассовыйДокумент.ДокументДолг КАК ДокументДолг,
	ДокументКассовыйДокумент.ВидОперации КАК ВидОперации,
	ДокументКассовыйДокумент.Примечание КАК Примечание,
	ДокументКассовыйДокумент.КредитнаяКарта КАК КредитнаяКарта,
	ДокументКассовыйДокумент.ДатаОплаты КАК ДатаОплаты,
	ДокументКассовыйДокумент.СуммаКарта КАК СуммаКарта,
	ДокументКассовыйДокумент.СуммаНаличные КАК СуммаНаличные,
	ДокументКассовыйДокумент.НомерСменыККМ КАК НомерСменыККМ,
	ДокументКассовыйДокумент.НомерЧекаККМ КАК НомерЧекаККМ,
	ДокументКассовыйДокумент.ВозвратДокумент КАК ВозвратДокумент,
	Возвраты.Сумма КАК СуммаВозврат,
	ДокументКассовыйДокумент.Сумма - ЕСТЬNULL(Возвраты.Сумма, 0) - ЕСТЬNULL(ЗаявкиРаспределение.СуммаОплаты, 0) КАК ОстатокОплаты,
	ДокументКассовыйДокумент.Аванс КАК Аванс,
	ДокументКассовыйДокумент.ДокументДолг = &amp;ОтмененныйДокументДолг КАК Отмена
ИЗ
	Документ.КассовыйДокумент КАК ДокументКассовыйДокумент
		ЛЕВОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
			КассовыйДокумент.ВозвратДокумент КАК ВозвратДокумент,
			СУММА(КассовыйДокумент.Сумма) КАК Сумма
		ИЗ
			Документ.КассовыйДокумент КАК КассовыйДокумент
		ГДЕ
			КассовыйДокумент.ПометкаУдаления = ЛОЖЬ
		
		СГРУППИРОВАТЬ ПО
			КассовыйДокумент.ВозвратДокумент) КАК Возвраты
		ПО ДокументКассовыйДокумент.Ссылка = Возвраты.ВозвратДокумент
		ЛЕВОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
			ЗаявкаНаБронированиеРаспределениеОплатДолги.ДокументОплаты КАК ДокументОплаты,
			СУММА(ЗаявкаНаБронированиеРаспределениеОплатДолги.СуммаОплаты) КАК СуммаОплаты
		ИЗ
			Документ.ЗаявкаНаБронирование.РаспределениеОплатДолги КАК ЗаявкаНаБронированиеРаспределениеОплатДолги
		ГДЕ
			ЗаявкаНаБронированиеРаспределениеОплатДолги.Ссылка.ПометкаУдаления = ЛОЖЬ
		
		СГРУППИРОВАТЬ ПО
			ЗаявкаНаБронированиеРаспределениеОплатДолги.ДокументОплаты) КАК ЗаявкиРаспределение
		ПО ДокументКассовыйДокумент.Ссылка = ЗаявкиРаспределение.ДокументОплаты
ГДЕ
	ДокументКассовыйДокумент.ПометкаУдаления = ЛОЖЬ
	И ДокументКассовыйДокумент.Приход = ИСТИНА
	И ДокументКассовыйДокумент.Сумма - ЕСТЬNULL(Возвраты.Сумма, 0) - ЕСТЬNULL(ЗаявкиРаспределение.СуммаОплаты, 0) > 0
	И ВЫБОР
			КОГДА &amp;ВсеЗаписи
				ТОГДА ДокументКассовыйДокумент.ОтКого В (&amp;СписокКонтрагентов)
			ИНАЧЕ ДокументКассовыйДокумент.ДокументДолг = &amp;ОтмененныйДокументДолг
		КОНЕЦ
	И ДокументКассовыйДокумент.ЭтоПроизвольныйЧек = ЛОЖЬ</queryText>
      <mainTable>Document.КассовыйДокумент</mainTable>
      <autoFillAvailableFields>true</autoFillAvailableFields>
      <customQuery>true</customQuery>
      <autoSaveUserSettings>true</autoSaveUserSettings>
      <getInvisibleFieldPresentations>true</getInvisibleFieldPresentations>
    </extInfo>
  </attributes>
