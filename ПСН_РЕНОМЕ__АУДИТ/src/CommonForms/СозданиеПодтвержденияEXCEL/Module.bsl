&НаСервере
Функция СкопироватьОбразецПодтверждение(ФайлПолучатель, НаАнглийском)
Результат = Новый Структура("Ошибка, ОписаниеОшибки", Ложь, "");
	
ИмяОрганизации = НастройкиСервер.ПолучитьИмяТекущаяОрганизация();
КаталогОбразец = ОбщийФункционалСервер.ПолучитьЗначениеКонстанты("Папка_C_BASE");
КаталогОбразец = КаталогОбразец + "ОбразцыДокументов\";

Если НаАнглийском тогда
	ПолноеИмяОбразца = КаталогОбразец + "НовоеПодтверждение_А_" + ИмяОрганизации;	
иначе
	ПолноеИмяОбразца =  КаталогОбразец + "НовоеПодтверждение_" + ИмяОрганизации; 
конецесли;

ПолноеИмяОбразца = ПолноеИмяОбразца + ".xls";

Попытка 
	КопироватьФайл(ПолноеИмяОбразца, ФайлПолучатель);
Исключение
	Результат.Ошибка = Истина;
	Результат.ОписаниеОшибки = ОписаниеОшибки();
КонецПопытки;

Возврат Результат;
КонецФункции

&НаСервере
Функция ПолучитьМакетПодтверждениеВДвоичныхДанных_НеИспользуется(НаАнглийском)
	ИмяМакета = НастройкиСервер.ПолучитьИмяТекущаяОрганизация();
	Если НаАнглийском тогда
		ИмяМакета = "НовоеПодтверждение_А_" + ИмяМакета;	
		//Макет = ПолучитьМакетНаСервере(ИмяМакета);	
			
	иначе
		ИмяМакета = "НовоеПодтверждение_" + ИмяМакета; 
		//Макет = ПолучитьМакетНаСервере(ИмяМакета);		
	конецесли;
	Макет = Документы.ПодтверждениеБронирования.ПолучитьМакет(ИмяМакета);	
	
	//Получим путь во временной директории для сохранения туда файла
	ИмяВрем = ПолучитьИмяВременногоФайла(".doc");

	Макет.Записать(ИмяВрем);
	МойДокументВДвоичныхДанных = Новый ДвоичныеДанные(ИмяВрем);

	Возврат МойДокументВДвоичныхДанных;
КонецФункции

&НаСервере
Функция ПолучитьФИО_Категория(Бронь)
ФИО = Бронь.Клиент.Наименование +"(" + Бронь.КатегорияНомера.Наименование+")";	
Возврат ФИО;
КонецФункции	

&НаСервере
Функция ПолучитьФИО(Бронь)
ФИО = Бронь.Клиент.Наименование;	
Возврат ФИО;
КонецФункции

&НаСервере
Функция ПолучитьКатегорияНомера(Бронь)
КатегорияНомера = Бронь.КатегорияНомера.Наименование;	
Возврат КатегорияНомера;
КонецФункции


&НаКлиенте
Процедура ПриЗакрытии(ЗавершениеРаботы)
Если MsExcel = Неопределено Тогда Возврат; КонецЕсли;

Попытка
	MsExcel.Quit(); 
Исключение
	Сообщить(ОписаниеОшибки());
КонецПопытки;

MsExcel = Неопределено;
КонецПроцедуры

