&НаКлиенте
Процедура ПриОткрытии(Отказ)
ТекстСообщения = "Открытие Зарплата Администраторы
			|
			|Идет загрука данных. 
			|
			|ПОДОЖДИТЕ ...";	
ПараметрыФормы = Новый Структура("ТекстСообщения", ТекстСообщения);
Форма = ОткрытьФорму("Документ.АдминистраторыЗарплата.Форма.СообщениеОперация", ПараметрыФормы,ЭтаФорма
	,,,,, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);

ЗаполнитьСправочныеДанные();

ТекстОшибки = "";
Если ЗначениеЗаполнено(Объект.ДН) И ЗначениеЗаполнено(Объект.ДК)	
Тогда
	ТекстОшибки = ЗаполнитьСправочныеДанныеПоДНиДК();
	ЗаполнитьЗарплатаСмены();
КонецЕсли;

Форма.Закрыть();

Если ТекстОшибки <> "" Тогда
	Сообщить(ТекстОшибки);
КонецЕсли;

КонецПроцедуры

&НаСервере
Процедура ЗаполнитьСправочныеДанные()
Запрос = Новый Запрос("ВЫБРАТЬ
                      |	Администраторы.Ссылка КАК Администратор,
                      |	Администраторы.ДатаПриема КАК ДатаПриема,
                      |	Администраторы.НеНачислятьЗаСтаж КАК НеНачислятьЗаСтаж,
                      |	Администраторы.АдминистраторКодЛайв КАК АдминистраторКодЛайв,
                      |	Администраторы.АдминистраторКодСтритАрт КАК АдминистраторКодСтритАрт,
                      |	Администраторы.Постоянный КАК Постоянный,
                      |	Администраторы.Начисления.(
                      |		Ссылка КАК Ссылка,
                      |		НомерСтроки КАК НомерСтроки,
                      |		ДатаУстановки КАК ДатаУстановки,
                      |		СтавкаЗаСмену12 КАК СтавкаЗаСмену12,
                      |		СтавкаЗаСмену24 КАК СтавкаЗаСмену24,
                      |		СтавкаЗаПереработку КАК СтавкаЗаПереработку,
                      |		НадбавкаЗаСтандарты КАК НадбавкаЗаСтандарты,
                      |		НадбавкаЗаИнЯзыки КАК НадбавкаЗаИнЯзыки,
                      |		СтавкаЗаЗаселение КАК СтавкаЗаЗаселение,
                      |		СтавкаЗаОтпуск КАК СтавкаЗаОтпуск,
                      |		СтавкаЗавтракиЧехов КАК СтавкаЗавтракиЧехов,
                      |		СтавкаЗавтракиДомСоветов КАК СтавкаЗавтракиДомСоветов,
                      |		СтавкаЗавтракиЛайв КАК СтавкаЗавтракиЛайв,
                      |		СуммаОклад КАК СуммаОклад,
                      |		НадбавкаЗаПроживающих КАК НадбавкаЗаПроживающих
                      |	) КАК Начисления
                      |ИЗ
                      |	Справочник.Администраторы КАК Администраторы
                      |ГДЕ
                      |	Администраторы.ПометкаУдаления = ЛОЖЬ
                      |	И Администраторы.НеРаботает = ЛОЖЬ
                      |
                      |УПОРЯДОЧИТЬ ПО
                      |	Администраторы.Сортировка");

ТЗ = Запрос.Выполнить().Выгрузить();
АдминистраторыСправочник.Очистить();
ДатаУчета = Объект.ДК;
Для Каждого Строка Из ТЗ Цикл
	НоваяСтрока = АдминистраторыСправочник.Добавить();
	                                                    
	ЗаполнитьЗначенияСвойств(НоваяСтрока, Строка); 
	
	Начисления = Строка.Начисления;
	Начисления.Сортировать("ДатаУстановки УБЫВ");
	Для Каждого СтрокаНачисления Из Начисления Цикл
		Если ДатаУчета < СтрокаНачисления.ДатаУстановки Тогда Продолжить; КонецЕсли;		
		
		ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаНачисления);
		Прервать;
	КонецЦикла;	
КонецЦикла;

ПрочееАдминистратор_СписокВыбора = Элементы.ПрочееАдминистратор.СписокВыбора;

Для Каждого Строка Из АдминистраторыСправочник Цикл
	ПрочееАдминистратор_СписокВыбора.Добавить(Строка.Администратор);
КонецЦикла;
КонецПроцедуры

&НаКлиенте
Функция ЗаполнитьСправочныеДанныеПоДНиДК()
ЗаполнитьСправочныеДанныеПоДНиДКНаСервере();	
	
ЗаполнитьПроживающие();
ПроживающиеЗагружены = Истина;

ТекстОшибки = "";	
Если ОтельИмя = "Реноме" Тогда
	Ответ = ЗагрузитьЗаселенияЛайв_HTTP();
	Если Ответ.Ошибка Тогда
		ТекстОшибки = Ответ.ТекстОшибки + Символы.ПС 
			+ "ЗАСЕЛЕНИЯ В ЛАЙВ НЕ ЗАГРУЖЕНЫ";
		ЗаселенияВЛайвЗагружены = Ложь;
	Иначе	
		ЗаселенияВЛайвЗагружены = Истина;
	КонецЕсли;
КонецЕсли;

Если ОтельИмя = "Чехов" Тогда	
	Ответ = ЗагрузитьЗаселенияДомСоветов_HTTP();
	Если Ответ.Ошибка Тогда
		ТекстОшибки = ОбщийФункционалКлиентСервер.ДобавитьТекст(ТекстОшибки, Ответ.ТекстОшибки, Символы.ПС);
		ТекстОшибки = ТекстОшибки + Символы.ПС + "ЗАСЕЛЕНИЯ В ДОМ СОВЕТОВ НЕ ЗАГРУЖЕНЫ";
		ЗаселенияВДомСоветовЗагружены = Ложь;
	Иначе	
		ЗаселенияВДомСоветовЗагружены = Истина;
	КонецЕсли;

	Ответ = ЗагрузитьЗаселенияСтритАрт_HTTP();
	Если Ответ.Ошибка Тогда
		ТекстОшибки = ОбщийФункционалКлиентСервер.ДобавитьТекст(ТекстОшибки, Ответ.ТекстОшибки, Символы.ПС);
		ТекстОшибки = ТекстОшибки + Символы.ПС + "ЗАСЕЛЕНИЯ В СТРИТ АРТ НЕ ЗАГРУЖЕНЫ";
	ЗаселенияВДомСоветовЗагружены = Ложь;
	Иначе	
		ЗаселенияВСтритАртЗагружены = Истина;
	КонецЕсли;
КонецЕсли;

Возврат ТекстОшибки;
КонецФункции	

&НаСервере
Процедура ЗаполнитьСправочныеДанныеПоДНиДКНаСервере()
Запрос = Новый Запрос("ВЫБРАТЬ
                      |	АдминистраторыНадбавкаЗаСтаж.ДатаНазначения КАК ДатаНазначения,
                      |	АдминистраторыНадбавкаЗаСтаж.РазницаВДняхС КАК РазницаВДняхС,
                      |	АдминистраторыНадбавкаЗаСтаж.РазницаВДняхПо КАК РазницаВДняхПо,
                      |	АдминистраторыНадбавкаЗаСтаж.Сумма КАК Сумма
                      |ИЗ
                      |	РегистрСведений.АдминистраторыНадбавкаЗаСтаж КАК АдминистраторыНадбавкаЗаСтаж
                      |ГДЕ
                      |	АдминистраторыНадбавкаЗаСтаж.ДатаНазначения <= &ДатаНазначения
                      |
                      |УПОРЯДОЧИТЬ ПО
                      |	ДатаНазначения УБЫВ,
                      |	РазницаВДняхС");

ДатаУчета = Объект.ДК;
Запрос.УстановитьПараметр("ДатаНазначения", ДатаУчета);

ТЗ = Запрос.Выполнить().Выгрузить();
Если ТЗ.Количество() > 0 Тогда 
	АдминистраторыНадбавкаЗаСтаж.Очистить();
	ДатаНазначения = ТЗ[0].ДатаНазначения;
	Для Каждого Строка Из ТЗ Цикл
		Если Строка.ДатаНазначения <> ДатаНазначения Тогда Прервать; КонецЕсли;
		
		НоваяСтрока = АдминистраторыНадбавкаЗаСтаж.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, Строка); 
	КонецЦикла;
КонецЕсли;
//

//
Запрос = Новый Запрос("ВЫБРАТЬ
                      |	АдминистраторыСуммаЗаПроживающих.ДатаНазначения КАК ДатаНазначения,
                      |	АдминистраторыСуммаЗаПроживающих.КоличествоНомеровС КАК КоличествоНомеровС,
                      |	АдминистраторыСуммаЗаПроживающих.КоличествоНомеровПо КАК КоличествоНомеровПо,
                      |	АдминистраторыСуммаЗаПроживающих.Сумма_12 КАК Сумма_12,
                      |	АдминистраторыСуммаЗаПроживающих.Сумма_24 КАК Сумма_24
                      |ИЗ
                      |	РегистрСведений.АдминистраторыСуммаЗаПроживающих КАК АдминистраторыСуммаЗаПроживающих
                      |ГДЕ
                      |	АдминистраторыСуммаЗаПроживающих.ДатаНазначения <= &ДатаНазначения
                      |
                      |УПОРЯДОЧИТЬ ПО
                      |	ДатаНазначения УБЫВ,
                      |	КоличествоНомеровС");

ДатаУчета = Объект.ДК;
Запрос.УстановитьПараметр("ДатаНазначения", ДатаУчета);

ТЗ = Запрос.Выполнить().Выгрузить();
Если ТЗ.Количество() > 0 Тогда 
	АдминистраторыСуммаЗаПроживающих.Очистить();
	ДатаНазначения = ТЗ[0].ДатаНазначения;
	Для Каждого Строка Из ТЗ Цикл
		Если Строка.ДатаНазначения <> ДатаНазначения Тогда Прервать; КонецЕсли;
		
		НоваяСтрока = АдминистраторыСуммаЗаПроживающих.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, Строка); 
	КонецЦикла;
КонецЕсли;
//

КонецПроцедуры

&НаСервере
Процедура ЗаполнитьЗарплатаСмены()
//Если НЕ (ЗначениеЗаполнено(Объект.ДН) И ЗначениеЗаполнено(Объект.ДК)) Тогда Возврат; КонецЕсли; 

ДН_П = НачалоМесяца(Объект.ДН);
ДК_П = КонецМесяца(Объект.ДК);
	
ДобавляемыеРеквизиты = РеквизитыЗарплатаСмены(ДН_П, ДК_П);

Дата_П = ДН_П;
Пока Дата_П <= ДК_П Цикл
	Дата_С = Формат(Дата_П, "ДФ=dd.MM.yy");
	Дата_И = СтрЗаменить(Дата_С, ".", "");
	
	//
	Имя = "Часы_" + Дата_И;
	НовыйРеквизит = Новый РеквизитФормы(Имя, Новый ОписаниеТипов("Строка", , , , Новый КвалификаторыСтроки(4))
		, "ЗарплатаСмены_OldValue");
	ДобавляемыеРеквизиты.Добавить(НовыйРеквизит);
	
	Имя = "НомерСмены_" + Дата_И;
	НовыйРеквизит = Новый РеквизитФормы(Имя, Новый ОписаниеТипов("Число", , , Новый КвалификаторыЧисла(1, 0))
		, "ЗарплатаСмены_OldValue");
	ДобавляемыеРеквизиты.Добавить(НовыйРеквизит);
	
	Имя = "ДлинаСмены_" + Дата_И;
	НовыйРеквизит = Новый РеквизитФормы(Имя, Новый ОписаниеТипов("Число", , , , Новый КвалификаторыЧисла(2, 0))
		, "ЗарплатаСмены_OldValue");
	ДобавляемыеРеквизиты.Добавить(НовыйРеквизит);
	
	Имя = "ПереработкаЧасы_" + Дата_И;
	НовыйРеквизит = Новый РеквизитФормы(Имя, Новый ОписаниеТипов("Число", , , , Новый КвалификаторыЧисла(2, 0))
		, "ЗарплатаСмены_OldValue");
	ДобавляемыеРеквизиты.Добавить(НовыйРеквизит);
	//
	
	Дата_П = Дата_П + 24 * 60 * 60;	
КонецЦикла;	
// Добавим новые реквизиты в форму
ИзменитьРеквизиты(ДобавляемыеРеквизиты);	

ЭлементТаблицаИмя = "ЗарплатаСмены";
Дата_П = Объект.ДН;
Пока Дата_П <= Объект.ДК Цикл
	Дата_С = Формат(Дата_П, "ДФ=dd.MM.yy");
	Дата_И = СтрЗаменить(Дата_С, ".", "");
	
	Имя = ЭлементТаблицаИмя + "Группа1_" + Дата_И;  
	ГруппаФормы1 = Элементы.Добавить(Имя, Тип("ГруппаФормы"), Элементы.ЗарплатаСмены);

  	ГруппаФормы1.Вид                        = ВидГруппыФормы.ГруппаКолонок;
    ГруппаФормы1.Группировка                = ГруппировкаКолонок.Вертикальная;
	
	Имя = ЭлементТаблицаИмя + "Группа2_" + Дата_И;  
	ГруппаФормы2 = Элементы.Добавить(Имя, Тип("ГруппаФормы"), ГруппаФормы1);
  	ГруппаФормы2.Вид                        = ВидГруппыФормы.ГруппаКолонок;
    ГруппаФормы2.Группировка                = ГруппировкаКолонок.Горизонтальная;
	
	ИмяРеквизита = "Дата_" + Дата_И;
    ИмяЭлемента = ЭлементТаблицаИмя + ИмяРеквизита;
	НовыйЭлемент = Элементы.Добавить(ИмяЭлемента, Тип("ПолеФормы"), ГруппаФормы2);
    НовыйЭлемент.ПутьКДанным                  = ЭлементТаблицаИмя + "." + ИмяРеквизита;
    НовыйЭлемент.Вид                          = ВидПоляФормы.ПолеВвода;
	НовыйЭлемент.Заголовок                    = Дата_С;
	НовыйЭлемент.Формат = "ДФ=dd.MM.yy";
	НовыйЭлемент.Ширина		                  = 7;
	НовыйЭлемент.ГоризонтальноеПоложение = ГоризонтальноеПоложениеЭлемента.Центр; 
	НовыйЭлемент.ГоризонтальноеПоложениеВШапке = ГоризонтальноеПоложениеЭлемента.Центр;
	НовыйЭлемент.Шрифт = Новый Шрифт(,,Истина);
	НовыйЭлемент.ШрифтЗаголовка = Новый Шрифт(,,Истина);
	НовыйЭлемент.ТолькоПросмотр               = Истина;
	//НовыйЭлемент.УстановитьДействие("ПриИзменении", "НомерСмены_ПриИзменении");	
	
	ИмяРеквизита = "НомерСмены_" + Дата_И;
    ИмяЭлемента = ЭлементТаблицаИмя + ИмяРеквизита;
	НовыйЭлемент = Элементы.Добавить(ИмяЭлемента, Тип("ПолеФормы"), ГруппаФормы2);
    НовыйЭлемент.ПутьКДанным                  = ЭлементТаблицаИмя + "." + ИмяРеквизита;
    НовыйЭлемент.Вид                          = ВидПоляФормы.ПолеВвода;
	НовыйЭлемент.Заголовок                    = "Смена";
	НовыйЭлемент.Ширина		                  = 5;
	НовыйЭлемент.ГоризонтальноеПоложение = ГоризонтальноеПоложениеЭлемента.Центр; 
	НовыйЭлемент.ГоризонтальноеПоложениеВШапке = ГоризонтальноеПоложениеЭлемента.Центр;
	НовыйЭлемент.Шрифт = Новый Шрифт(,,Истина);
	НовыйЭлемент.ШрифтЗаголовка = Новый Шрифт(,,Истина);
	//НовыйЭлемент.ТолькоПросмотр               = Истина;
	НовыйЭлемент.УстановитьДействие("ПриИзменении", "НомерСмены_ПриИзменении");	
	
	ИмяРеквизита = "ДлинаСмены_" + Дата_И;
    ИмяЭлемента = ЭлементТаблицаИмя + ИмяРеквизита;
	НовыйЭлемент = Элементы.Добавить(ИмяЭлемента, Тип("ПолеФормы"), ГруппаФормы2);
    НовыйЭлемент.ПутьКДанным                  = ЭлементТаблицаИмя + "." + ИмяРеквизита;
    НовыйЭлемент.Вид                          = ВидПоляФормы.ПолеВвода;
	НовыйЭлемент.Заголовок                    = "Длит.";
	НовыйЭлемент.Ширина		                  = 5;
	НовыйЭлемент.ГоризонтальноеПоложение = ГоризонтальноеПоложениеЭлемента.Центр; 
	НовыйЭлемент.ГоризонтальноеПоложениеВШапке = ГоризонтальноеПоложениеЭлемента.Центр; 
	//НовыйЭлемент.ТолькоПросмотр               = Истина;
	НовыйЭлемент.УстановитьДействие("ПриИзменении", "ДлинаСмены_ПриИзменении");	
	
   	ИмяРеквизита = "ПереработкаЧасы_" + Дата_И;
    ИмяЭлемента = ЭлементТаблицаИмя + ИмяРеквизита;
	НовыйЭлемент = Элементы.Добавить(ИмяЭлемента, Тип("ПолеФормы"), ГруппаФормы2);
    НовыйЭлемент.ПутьКДанным                  = ЭлементТаблицаИмя + "." + ИмяРеквизита;
    НовыйЭлемент.Вид                          = ВидПоляФормы.ПолеВвода;
	НовыйЭлемент.Заголовок                    = "Кол" + Символы.ПС + "Пер.";
	НовыйЭлемент.Ширина		                  = 5;
	НовыйЭлемент.ГоризонтальноеПоложение = ГоризонтальноеПоложениеЭлемента.Центр; 
	НовыйЭлемент.ГоризонтальноеПоложениеВШапке = ГоризонтальноеПоложениеЭлемента.Центр; 
	НовыйЭлемент.УстановитьДействие("ПриИзменении", "ПереработкаЧасы_ПриИзменении");	
	
	ИмяРеквизита = "КоличествоЗаселенийЛайв_" + Дата_И + "_Э";
   	ИмяЭлемента = ЭлементТаблицаИмя + ИмяРеквизита;
	НовыйЭлемент = Элементы.Добавить(ИмяЭлемента, Тип("ПолеФормы"), ГруппаФормы2);
    НовыйЭлемент.ПутьКДанным                  = ЭлементТаблицаИмя + "." + ИмяРеквизита;
    НовыйЭлемент.Вид                          = ВидПоляФормы.ПолеВвода;
   	НовыйЭлемент.Заголовок                    = "Кол. Лайв";
	НовыйЭлемент.Ширина		                  = 7;
 	НовыйЭлемент.ГоризонтальноеПоложениеВШапке = ГоризонтальноеПоложениеЭлемента.Центр;
