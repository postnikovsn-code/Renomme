&НаКлиенте
Процедура ТелефонПриИзменении(Элемент)
Результат = ТелефонНормализованный();	
Если Результат.Ошибка Тогда
	Текст = Результат.Текст;
	ПоказатьПредупреждение(, Текст); 
	
	Объект.ТелефонНормализованный = "";	
Иначе	
	Объект.ТелефонНормализованный = Результат.Текст;	
