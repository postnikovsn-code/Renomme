# Сборочный вывод EDT (пересобирается из исходников)
/bin/*
.agents/
.claude/
.fff/
.metadata/
# .reversa: служебное состояние прогона не версионируем, но план и визуальную
# документацию — да. Паттерн со звёздочкой (не «.reversa/»), иначе git не входит
# в исключённый каталог и правила-исключения «!» внутри него не срабатывают.
.reversa/*
!.reversa/plan.md
!.reversa/documentation/
.rtk/
graphify-out/
.mcp.json
.kimi/
# Подпроекты со своим git — только в корне (неякорный паттерн матчил бы
# и kimi-plugin/skills/graphify/)
/graphify/
/graphity/
/tree-sitter-bsl/
/research-md/
# Тестовые/примерные данные
prompt-example-*.txt
# Исходные PDF/DjVu — 192 МБ, пересобирать .md из них через pdf2md.py.
# Исключение — результат распознавания: книга-скан собирается из .jsonl, а не из
# PDF, и повторный прогон модели даёт другой текст. Без него .md не пересобрать
# нигде, кроме машины, где он получен. Промежуточные .bak* остаются вне репозитория.
/_source/*
!/_source/ocr/
/_source/ocr/*
!/_source/ocr/*.jsonl
# Отчёт о сведении свидетелей: гейт читает его и без него не проходит.
!/_source/ocr/reconcile-blocks.json
__pycache__/
# Крупные бинарники 1С вычищены из истории (git filter-repo): лимит GitHub и
# размер pack. Файлы остаются на диске, хранятся вне git.
*.cf
/ПСН_РЕНОМЕ__АУДИТ/src/CommonTemplates/ДрайверАТОЛККТ54ФЗ107X_ru/Template.addin
/ПСН_РЕНОМЕ__АУДИТ/src/CommonTemplates/ДрайверАТОЛККТ54ФЗ10XФФД12X_ru/Template.addin
/ПСН_РЕНОМЕ__АУДИТ/src/CommonTemplates/ДрайверАТОЛККТ54ФЗ10XФФД12_ru/Template.addin
node_modules/
temp_*
