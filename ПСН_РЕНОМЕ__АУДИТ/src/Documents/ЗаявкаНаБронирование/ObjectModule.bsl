Процедура ОбработкаПроведения(Отказ, Режим)
Отказ=Не ПроверкаЗаполнения();
Если Отказ Тогда Возврат; КонецЕсли;

Если ЛистОжидания тогда Возврат; КонецЕсли;

Если Статус=Перечисления.СтатусБрони.ОтменаБронирования тогда Возврат; КонецЕсли;
Если Статус=Перечисления.СтатусБрони.ОтказОтБронирования тогда Возврат; КонецЕсли;

Ответ = ДокументыСервер.ЗанятостьНомераПроверить(РезервС, РезервПо, ВремяЗаезда, ВремяВыезда, НомерВРезерв, БонШанс, Неопределено); 
Если Ответ.Результат Тогда 
	Сообщить("Номер занят. " + Ответ.Регистратор + ". ЗАПИСЬ ОТМЕНЯЕТСЯ.");
	Отказ = Истина;
	Возврат;
КонецЕсли;

ЗаявкаСервер.ОбновитьИсториюКлиента(ЭтотОбъект);

//Если БонШанс Тогда
Если РезервС = РезервПо Тогда
	ТемпС = Ответ.НачалоПериодаРезерва;
	ТемпПо = Ответ.КонецПериодаРезерва;
	Если ТемпПо = НачалоДня(ТемпС) Тогда
		ТемпПо = НачалоДня(РезервС) + 3600 * 24;
	КонецЕсли;
	
	Если ТемпПо < ТемпС Тогда
		//ТемпС = НачалоДня(РезервС) + 3600 * 12;
		ТемпС = НачалоДня(РезервС) + 3600 * 13;
		//ТемпПо = НачалоДня(РезервС) + 3600 * 14;
		ТемпПо = НачалоДня(РезервС) + 3600 * 18;
	КонецЕсли;
Иначе	
	ТемпС = Ответ.НачалоПериодаРезерва;
	ТемпПо = Ответ.КонецПериодаРезерва;
КонецЕсли;	
ТемпПо = ТемпПо - 1;

Запрос = Новый Запрос("ВЫБРАТЬ
                      |	ЗанятостьНомеров.ПериодРезерва КАК ПериодРезерва,
                      |	ЗанятостьНомеров.Номер_пп КАК Номер_пп
                      |ИЗ
                      |	РегистрСведений.ЗанятостьНомеров КАК ЗанятостьНомеров
                      |ГДЕ
                      |	ЗанятостьНомеров.Номер = &Номер
                      |	И ЗанятостьНомеров.Клиент = &Клиент
                      |	И ЗанятостьНомеров.ПериодРезерва МЕЖДУ &ДатаС И &ДатаПо
                      |	И ЗанятостьНомеров.БонШанс = &БонШанс");

Запрос.УстановитьПараметр("Номер", НомерВРезерв); 
Запрос.УстановитьПараметр("Клиент", Клиент); 
Запрос.УстановитьПараметр("ДатаС", ТемпС); 
Запрос.УстановитьПараметр("ДатаПо", ТемпПо); 
Запрос.УстановитьПараметр("БонШанс", БонШанс); 

ТЗ = Запрос.Выполнить().Выгрузить();

Пока ТемпС < ТемпПо цикл
	Движение = Движения.ЗанятостьНомеров.Добавить();
	Движение.Номер = НомерВРезерв;
	Движение.Клиент = Клиент;
	Движение.ПериодРезерва = ТемпС;
	Движение.Зарезервирован = Истина;

	Движение.БонШанс = БонШанс;
	
	НайденнаяСтрока = ТЗ.Найти(ТемпС, "ПериодРезерва");
	Если ЗначениеЗаполнено(НайденнаяСтрока) Тогда 
		Движение.Номер_пп = НайденнаяСтрока.Номер_пп + 1;
	КонецЕсли;
	
	ТемпС=ТемпС+3600;
КонецЦикла;

Для Каждого Счет Из Счета Цикл
	Движение = Движения.Взаиморасчеты.Добавить();
	Движение.ВидДвижения = ВидДвиженияНакопления.Расход;
	
	Движение.Период = РезервС;
	
	Движение.Контрагент = Счет.Контрагент;
	
	ОтборСтроки = Новый Структура("СчетГУИД", Счет.СчетГУИД);
	ТЗ = СчетаДетальноДолги.Выгрузить(ОтборСтроки, "СуммаДолг");
	СуммаДолг = ТЗ.Итог("СуммаДолг");
	
	Движение.Сумма = СуммаДолг; 
КонецЦикла;	

Возврат;


