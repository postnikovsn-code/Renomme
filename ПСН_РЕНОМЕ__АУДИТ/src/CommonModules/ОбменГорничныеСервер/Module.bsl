		ГорничныеОбслуживаниеПомещенияОбъект.НомерОбслуживания_пп = Строка.НомерОбслуживания_пп;
		
		ГорничныеОбслуживаниеПомещенияОбъект.Горничная = Горничная;

	Иначе
		ГорничныеОбслуживаниеПомещенияОбъект = ТЗ[0].Ссылка.ПолучитьОбъект();
		
		Если ГорничныеОбслуживаниеПомещенияОбъект.РучноеИзменение Тогда Продолжить; КонецЕсли;
	КонецЕсли;
	
	Если Строка.ПометкаУдаления Тогда
		Если ЗначениеЗаполнено(ГорничныеОбслуживаниеПомещенияОбъект.Ссылка) Тогда
			ГорничныеОбслуживаниеПомещенияОбъект.УстановитьПометкуУдаления(Истина);
		Иначе
			ГорничныеОбслуживаниеПомещенияОбъект.ПометкаУдаления = Истина;
		КонецЕсли;	
	Иначе
		Если ЗначениеЗаполнено(ГорничныеОбслуживаниеПомещенияОбъект.Ссылка) Тогда
