&НаКлиенте
Процедура ОтборДат(Команда)
ДанныеВыбора = ПолеОтчета.ТекущаяОбласть.Имя;

МассивЧисел = НайтиЧислаВСтроке(ДанныеВыбора);

Если МассивЧисел.Количество() = 2 Тогда
	МассивЧисел.Добавить(МассивЧисел[0]);	
	
	МассивЧисел.Добавить(МассивЧисел[1]);	
КонецЕсли;	

НомерСтроки = МассивЧисел[0]; 
НачалоНомерСтолбца = МассивЧисел[1];
КонецНомерСтолбца = МассивЧисел[3];

НомерСтроки = МассивЧисел[0]; 
НачалоНомерСтолбца = МассивЧисел[1];
КонецНомерСтолбца = МассивЧисел[3];

ОграничениеНомераСтроки = (НомерСтроки >= ВысотаПолеОтчетаМинимум) И  (НомерСтроки <= ВысотаПоляОтчетаМаксимум);

Если ОграничениеНомераСтроки Тогда

	СтрокаШиринаПолеОтчета = ШиринаПолеОтчета[НомерСтроки - ВысотаПолеОтчетаМинимум]; 

	ОграничениеНомераСтолбца = (НачалоНомерСтолбца >= СтрокаШиринаПолеОтчета.ШиринаПолеОтчетаМинимум) 
							И  (КонецНомерСтолбца <=  СтрокаШиринаПолеОтчета.ШиринаПоляОтчетаМаксимум);

	ЭтоСтрокаДата = ЭтоСтрокаДата(МассивЧисел[0], Сдвиг);
	Если ОграничениеНомераСтроки И ОграничениеНомераСтолбца
	И ЭтоСтрокаДата 
	И МассивЧисел[0] = МассивЧисел[2]	
	Тогда

		ДатаС_ОтборДат = ПолеОтчета.Область("R" + Строка(НомерСтроки) + "C" +  Строка(МассивЧисел[1])).Текст;
		ДатаПо_ОтборДат = ПолеОтчета.Область("R" + Строка(НомерСтроки) + "C" +  Строка(МассивЧисел[3])).Текст;
		
		Элементы.ПолеОтчетаКонтекстноеМенюОтборДат.Видимость = Истина;
	
	Иначе	
		ДатаС_ОтборДат = "***";
		ДатаПо_ОтборДат = "***";
		
		Возврат;
	КонецЕсли;	
Иначе
	ДатаС_ОтборДат = "***";
	ДатаПо_ОтборДат = "***";
	
	Возврат;
КонецЕсли;

Для НомерСтолбца = НачалоНомерСтолбца По КонецНомерСтолбца Цикл
	Область = ПолеОтчета.Область(НомерСтроки, НомерСтолбца, НомерСтроки, НомерСтолбца);  
	
	ДТ=Область.Значение;
	Если ЗначениеЗаполнено(ДТ) тогда
		
		Если ДТ < ДокументыСервер.ДатаПереходаНаНовыйКалендарьЦен() Тогда
			Продолжить;
		КонецЕсли;
		
		ПоискЗНЧ=СписВыбранных.НайтиПоЗначению(ДТ);
		Если ПоискЗНЧ=Неопределено тогда
			СписВыбранных.Добавить(ДТ);
			
			ПолеОтчета.Область(Область.Верх,Область.Лево,Область.Верх + 3,Область.Лево).ЦветФона=Новый Цвет(102, 144, 198);
		иначе
			СписВыбранных.Удалить(ПоискЗНЧ);
			Если ДТ=НачалоДня(ТекущаяДата()) тогда
				ПолеОтчета.Область(Область.Верх,Область.Лево+ 1, Область.Верх + 3, Область.Лево).ЦветФона=Новый Цвет(220, 248, 88);	
			иначе
				ПолеОтчета.Область(Область.Верх + 1, Область.Лево, Область.Верх + 3, Область.Лево).ЦветФона=Новый Цвет(255, 255, 255);
			КонецЕсли;
			ПолеОтчета.Область(Область.Верх, Область.Лево, Область.Верх, Область.Лево).ЦветФона=Новый Цвет(240, 240, 24);
		конецесли;	
	КонецЕсли;
КонецЦикла;

КонецПроцедуры

