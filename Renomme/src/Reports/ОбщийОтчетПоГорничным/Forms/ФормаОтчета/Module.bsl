	СформироватьТекущий();
КонецПроцедуры

&НаКлиенте
Процедура СформироватьТекущий()
	Имя=Элементы.Страницы.ТекущаяСтраница.Имя;
	Выполнить("Сформировать"+Имя+"()");
	
	ПолеОтчета.ФиксацияСверху = 1;
КонецПроцедуры

&НаСервере
Процедура СформироватьОбщийСтраница()

ЗапросТекст = "ВЫБРАТЬ
              |	УборкиНомеров.Комната КАК Ном,
              |	УборкиНомеров.ВремяУброки КАК Дата,
              |	УборкиНомеров.Горничная КАК Горничная,
              |	УборкиНомеров.ТипУборки КАК тип,
              |	УборкиНомеров.ТипКомплектации КАК ТипКомплектации,
              |	УборкиНомеров.Температура КАК темп,
              |	УборкиНомеров.КолВоГостей КАК КолВо,
              |	УборкиНомеров.Неисправности КАК Тех,
              |	УборкиНомеров.Ущерб КАК Ущерб,
              |	УборкиНомеров.Минибар КАК Минибар,
              |	УборкиНомеров.Оборудование КАК Оборудование,
              |	УборкиНомеров.Тариф_НеИспользуется КАК Тариф_НеИспользуется,
              |	УборкиНомеров.Курит КАК Курит,
              |	УборкиНомеров.Комментарий КАК Комментарий,
              |	УборкиНомеров.КомментарийАдминистрации КАК КомментарийАдминистрации,
              |	УборкиНомеров.РаздельныеКровати КАК РаздельныеКровати,
              |	УборкиНомеров.РаздельныеКроватиОбработка КАК РаздельныеКроватиОбработка,
              |	УборкиНомеров.Регистратор КАК Регистратор,
              |	УборкиНомеров.Регистратор.МанипуляцияКровати КАК МанипуляцияКровати,
              |	УборкиНомеров.Регистратор.МанипуляцияДопМесто_1 КАК МанипуляцияДопМесто_1,
              |	УборкиНомеров.Регистратор.МанипуляцияДопМесто_2 КАК МанипуляцияДопМесто_2,
              |	УборкиНомеров.Регистратор.ТипУборкиПризнак КАК ТипУборкиПризнак,
              |	УборкиНомеров.Регистратор.ДопМесто_1_ТипДопМеста КАК РегистраторДопМесто_1_ТипДопМеста,
              |	УборкиНомеров.Регистратор.ДопМесто_2_ТипДопМеста КАК РегистраторДопМесто_2_ТипДопМеста,
              |	УборкиНомеров.Регистратор.ДатаОбслуживания КАК РегистраторДатаОбслуживания,
              |	УборкиНомеров.Регистратор.НомерОбслуживания_пп КАК РегистраторНомерОбслуживания_пп,
              |	УборкиНомеров.Комната.Наименование КАК КомнатаНаименование
              |ИЗ
              |	РегистрСведений.УборкиНомеров КАК УборкиНомеров
              |ГДЕ
              |	УборкиНомеров.ВремяУброки МЕЖДУ &ДН И &Дк";

ЗапросТекстОкончание = "
              |УПОРЯДОЧИТЬ ПО
              |	РегистраторДатаОбслуживания,
              |	КомнатаНаименование,
              |	РегистраторНомерОбслуживания_пп";
	
Запрос = Новый Запрос;
Если Отчет.Номер.Пустая() и Отчет.Этаж=0 тогда
	
	Запрос.Текст = ЗапросТекст + ЗапросТекстОкончание;
	
иначеесли не  Отчет.Номер.Пустая() тогда
	
	Запрос.Текст = ЗапросТекст + "
		                    |	И УборкиНомеров.Комната = &Комната"
			+ ЗапросТекстОкончание;
			
	Запрос.УстановитьПараметр("Комната",Отчет.Номер);
	
иначе
	Запрос.Текст = ЗапросТекст + "
	                    |	И УборкиНомеров.Комната.Этаж = &Этаж"
		+ ЗапросТекстОкончание;
	
	Запрос.УстановитьПараметр("Этаж",Отчет.Этаж);
конецесли;

Запрос.УстановитьПараметр("ДН",Отчет.ДатаС);
Запрос.УстановитьПараметр("Дк",КонецДня(Отчет.ДатаПо));

ТЗ=Запрос.Выполнить().Выгрузить();
ТЗ.Колонки.Добавить("МДМ");
Для Каждого Строка Из ТЗ Цикл 
	МДМ = 0;
	Если Строка.МанипуляцияДопМесто_1 Тогда МДМ = МДМ + 1; КонецЕсли;
	Если Строка.МанипуляцияДопМесто_2 Тогда МДМ = МДМ + 1; КонецЕсли;
	
	Строка.МДМ = МДМ;
КонецЦикла;
   
ОтчетОбъект = РеквизитФормыВЗначение("Отчет");
Макет = ОтчетОбъект.ПолучитьМакет("МакетОбщий");  

ПолеОтчета.Очистить();
ПолеОтчета.ФиксацияСверху = 1;

Шапка=Макет.ПолучитьОбласть("Шапка");
ПолеОтчета.Вывести(Шапка);

//ПоискТарифа = Новый Запрос("ВЫБРАТЬ
//	|	ЗанятостьНомеров.Регистратор.Тариф КАК Тариф
//	|ИЗ
//	|	РегистрСведений.ЗанятостьНомеров КАК ЗанятостьНомеров
//	|ГДЕ
//	|	ЗанятостьНомеров.ПериодРезерва МЕЖДУ &ДН И &ДК
//	|	И ЗанятостьНомеров.Номер = &Номер");

ПоискДатчиков= Новый Запрос("ВЫБРАТЬ
	|	ПоказанияДатчиков.Показатель
	|ИЗ
	|	РегистрСведений.ПоказанияДатчиков КАК ПоказанияДатчиков
	|ГДЕ
	|	ПоказанияДатчиков.Время МЕЖДУ &ВремяС И &ВремяПо
	|	И ПоказанияДатчиков.Датчик.НомерКомнаты = &НомерКомнаты");	

ПоискЗамечаний = новый Запрос("ВЫБРАТЬ
	|	ЗамечанияПоНомерам.Замечание,
	|	ЗамечанияПоНомерам.ВремяПроверки,
	|	ЗамечанияПоНомерам.Комментарий,
	|	ЗамечанияПоНомерам.Супервайзер
	|ИЗ
	|	РегистрСведений.ЗамечанияПоНомерам КАК ЗамечанияПоНомерам
	|ГДЕ
	|	ЗамечанияПоНомерам.Комната = &Комната
	|	И ЗамечанияПоНомерам.ВремяПроверки МЕЖДУ &ДН И &ДК
	|	И ЗамечанияПоНомерам.Супервайзер = ЛОЖЬ");

ПоискЗамечанийАудитора = новый Запрос("ВЫБРАТЬ
	|	ЗамечанияПоНомерам.Замечание,
	|	ЗамечанияПоНомерам.ВремяПроверки,
	|	ЗамечанияПоНомерам.Комментарий,
	|	ЗамечанияПоНомерам.Супервайзер
	|ИЗ
	|	РегистрСведений.ЗамечанияПоНомерам КАК ЗамечанияПоНомерам
	|ГДЕ
	|	ЗамечанияПоНомерам.Комната = &Комната
	|	И ЗамечанияПоНомерам.ВремяПроверки МЕЖДУ &ДН И &ДК
	|	И ЗамечанияПоНомерам.Супервайзер = ИСТИНА");

Для каждого Стр Из ТЗ Цикл
	ПоискЗамечаний.УстановитьПараметр("Комната",Стр.Ном);
	ПоискЗамечаний.УстановитьПараметр("ДН",НачалоДня(Стр.Дата));
	ПоискЗамечаний.УстановитьПараметр("ДК",КонецДня(Стр.Дата)); 
	ТЗЗ=ПоискЗамечаний.Выполнить().Выгрузить();
	
	ПоискЗамечанийАудитора.УстановитьПараметр("Комната",Стр.Ном);
	ПоискЗамечанийАудитора.УстановитьПараметр("ДН",НачалоДня(Стр.Дата));
	ПоискЗамечанийАудитора.УстановитьПараметр("ДК",КонецДня(Стр.Дата));
	ТЗЗА=ПоискЗамечанийАудитора.Выполнить().Выгрузить();
	
	Проверялось=?(ТЗЗ.Количество()+ТЗЗА.Количество()=0,Ложь,Истина);
	
	Обл=Макет.ПолучитьОбласть("Строка"+?(Проверялось,"1",""));
	
	//ПоискТарифа.УстановитьПараметр("Номер",Стр.Ном);
	//ПоискТарифа.УстановитьПараметр("ДН",Стр.Дата-3600);
	//ПоискТарифа.УстановитьПараметр("ДК",Стр.Дата+3600);
	//ТЗТариф=ПоискТарифа.Выполнить().Выгрузить();
	//Если ТЗТариф.Количество()>0 тогда
	//	Обл.Параметры.Тариф=ТЗТариф[0].Тариф;
	//конецесли;
	
	ПоискДатчиков.УстановитьПараметр("НомерКомнаты",Стр.Ном);
	ПоискДатчиков.УстановитьПараметр("ВремяС",Стр.Дата-3600);
	ПоискДатчиков.УстановитьПараметр("ВремяПо",Стр.Дата+3600);
	ТЗД=ПоискДатчиков.Выполнить().Выгрузить();
	Если ТЗД.Количество()>0 тогда
		Обл.Параметры.ТемпД=ТЗД[0].Показатель;
	конецесли;
	
	Обл.Параметры.Замечания="";
	Обл.Параметры.ЗамечанияА="";
	Обл.Параметры.КомментарийАдминистрации = "";
	Обл.Параметры.КомментарийПроверяющего = "";
	
	Для каждого СтрЗ Из ТЗЗ Цикл
		Обл.Параметры.ВремяПроверки=?(Проверялось,СтрЗ.ВремяПроверки,"-");
		Обл.Параметры.Замечания=Обл.Параметры.Замечания + СтрЗ.Замечание.Наименование+" ";
		Обл.Параметры.КомментарийАдминистрации = Обл.Параметры.КомментарийАдминистрации + ?(СтрЗ.Супервайзер,"",СтрЗ.Комментарий);
		Стр.КомментарийАдминистрации = Стр.КомментарийАдминистрации+ ?(СтрЗ.Супервайзер,"",СтрЗ.Комментарий);
		Обл.Параметры.КомментарийПроверяющего = Обл.Параметры.КомментарийПроверяющего + ?(СтрЗ.Супервайзер,СтрЗ.Комментарий,"");
	КонецЦикла; 
	
	Для каждого СтрЗ Из ТЗЗА Цикл
		Обл.Параметры.ВремяПроверкиА=?(Проверялось,СтрЗ.ВремяПроверки,"-");
		Обл.Параметры.ЗамечанияА=Обл.Параметры.ЗамечанияА + СтрЗ.Замечание.Наименование+" ";
		Обл.Параметры.КомментарийАдминистрации = Обл.Параметры.КомментарийАдминистрации + ?(СтрЗ.Супервайзер,"",СтрЗ.Комментарий);
		Стр.КомментарийАдминистрации = Стр.КомментарийАдминистрации+ ?(СтрЗ.Супервайзер,"",СтрЗ.Комментарий);
		Обл.Параметры.КомментарийПроверяющего = Обл.Параметры.КомментарийПроверяющего + ?(СтрЗ.Супервайзер,СтрЗ.Комментарий,"");
	КонецЦикла; 
	               
	Обл.Параметры.Заполнить(Стр);
	Обл.Параметры.НомерОбслуживания_ПП = Стр.РегистраторНомерОбслуживания_ПП;
	
	Если ЗначениеЗаполнено(Стр.ТипУборкиПризнак) Тогда
		Обл.Параметры.тип = Стр.ТипУборкиПризнак;
	КонецЕсли;
	
	Если Стр.РаздельныеКровати Тогда
		Обл.Параметры.РаздельныеКровати = "РК";
	Иначе
		Обл.Параметры.РаздельныеКровати = "";
	КонецЕсли;
	
	Если Стр.МанипуляцияКровати Тогда
		Обл.Параметры.МанипуляцияКровати = "МК";
	Иначе
		Обл.Параметры.МанипуляцияКровати = "";
	КонецЕсли;
	
	Если Стр.МДМ > 0 Тогда
		Обл.Параметры.МДМ = Стр.МДМ;
	КонецЕсли;
	
	Если Стр.РегистраторДопМесто_1_ТипДопМеста = 2 ИЛИ Стр.РегистраторДопМесто_2_ТипДопМеста = 2 Тогда
		Обл.Параметры.Манеж = "Манеж";
	Иначе
		Обл.Параметры.Манеж = "";
	КонецЕсли;
	
	Обл.Параметры.ДопМесто_1 = ДопМестоНаименование(Стр.РегистраторДопМесто_1_ТипДопМеста);
	Обл.Параметры.ДопМесто_2 = ДопМестоНаименование(Стр.РегистраторДопМесто_2_ТипДопМеста);
	
	//Обл.Параметры.МанипуляцияДопМесто = МанипуляцияДопМестоКоличество(Стр.Регистратор);
	
	Обл.Параметры.Минибар = МинибарСтрока(Стр.Регистратор);
	
	Обл.Параметры.РасшифровкаМинибар = "РасшифровкаМинибар";
	Обл.Параметры.РасшифровкаДокумент = Стр.Регистратор;
	Обл.Параметры.РасшифровкаЗаявка = Стр.Регистратор.ЗаявкаНаБронирование;
	
	Обл.Параметры.РасшифровкаНеисправности = "РасшифровкаНеисправности";
	
	ПолеОтчета.Вывести(Обл);
КонецЦикла;

Минибар_Нет = Константы.Минибар_Нет.Получить();
Если Минибар_Нет Тогда
	ПолеОтчета.Область(, 13, 13).Видимость = Ложь;	
КонецЕсли;

ПолеОтчета.ФиксацияСверху = 1;
КонецПроцедуры

