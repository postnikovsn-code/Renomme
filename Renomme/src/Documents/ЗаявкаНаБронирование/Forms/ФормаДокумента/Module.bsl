&НаСервере
Процедура УстановитьПроцентыВ2В()
ПроцентКомиссии = ДокументыСервер.ПроцентКомиссии(Объект.Бронирует, Объект.РезервС);	
	
ЭтоТурагентство = Объект.Бронирует.Турагентство;

Элементы.В2В.Видимость = ЭтоТурагентство;
Элементы.ПроцентВ2В.Видимость = ЭтоТурагентство;

ПроцентВ2В = ДокументыСервер.ПроцентВ2В(Объект.Бронирует, Объект.РезервС);
Если ПроцентВ2В = 0 Тогда
	В2В = Ложь;
	Элементы.В2В.ТолькоПросмотр = Истина;
	//Элементы.ПроцентВ2В.ТолькоПросмотр = Истина;
Иначе
	Элементы.В2В.ТолькоПросмотр = Ложь;
	//Элементы.ПроцентВ2В.ТолькоПросмотр = Ложь;
КонецЕсли;	

КонецПроцедуры

&НаКлиенте
Процедура В2ВПриИзменении(Элемент)
Если Объект.В2В Тогда  	
	ПроцентВ2В = ДокументыСервер.ПроцентВ2В(Объект.Бронирует, Объект.РезервС);
Иначе
	ПроцентВ2В = 0;
КонецЕсли;

Если ((НЕ Объект.В2В) ИЛИ Объект.В2В  И ПроцентВ2В <> 0) И Объект.Проживание.Количество() > 0 Тогда
	ПоказатьПредупреждение(, "Изменение процента В2В.
		|
		|ПЕРЕЗАПОЛНИТЕ РАСЧЕТ ПРОЖИВАНИЯ (при необходимости) ...");
КонецЕсли;	
КонецПроцедуры

&НаКлиенте
Процедура ЗакрытоПриИзменении(Элемент)
//Если Закрыто Тогда 
//	Если Объект.Статус <> ПредопределенноеЗначение("Перечисление.СтатусБрони.Выехал") Тогда 
//		Закрыто = Ложь;
//		 
//		Возврат; 
//	 КонецЕсли;	 
//КонецЕсли;			
	
Если Закрыто Тогда 
	ДанныеОбъект = Объект;		
	Результат = ЗакрытиеСервер.ЗаявкаКЗакрытию(ДанныеОбъект, Истина);
	
	Если НЕ Результат.ЗаявкаКЗакрытию Тогда
		Оповещение = Новый ОписаниеОповещения("ЗавершениеВопроса_ПодтвердитеЗакрытиеЗаявки", ЭтаФорма);
		
		ТекстПредупреждения = Результат.ОшибкаОписание;

		ПоказатьВопрос(Оповещение, ТекстПредупреждения + "
		|
		|ПОДТВЕРДИТЕ ЗАКРЫТИЕ ЗАЯВКИ ...", РежимДиалогаВопрос.ОКОтмена);
		
		Возврат;
	КонецЕсли;
КонецЕсли;

ОткрытьЗакрытьЗаявку();
КонецПроцедуры

&НаКлиенте
Процедура ЗавершениеВопроса_ПодтвердитеЗакрытиеЗаявки(Результат, ДополнительныеПараметры) Экспорт
Если Результат = КодВозвратаДиалога.Отмена Тогда 
	Закрыто = Не Закрыто;
	
	Возврат; 
КонецЕсли;
	
ОткрытьЗакрытьЗаявку();	
КонецПроцедуры

