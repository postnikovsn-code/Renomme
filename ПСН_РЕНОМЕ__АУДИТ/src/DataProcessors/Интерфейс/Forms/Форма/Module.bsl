//ИначеЕсли ОбластьВремя.ТекущаяОбласть.Текст = "14:00" Тогда 
//	ВремяВыезда = Перечисления.ВремяВыезда.Вр12;
//	
//	НачалоНомерСтолбцаДата = КонецНомерСтолбца - 2;	
//ИначеЕсли ОбластьВремя.ТекущаяОбласть.Текст = "18:00" Тогда 
//	ВремяВыезда = Перечисления.ВремяВыезда.Вр18;
//	
//	НачалоНомерСтолбцаДата = КонецНомерСтолбца - 3;	
//Иначе
//	Возврат Неопределено;
//КонецЕсли;	

Если ОбластьВремя.ТекущаяОбласть.Текст = "00:00" Тогда 
	ВремяВыезда = Перечисления.ВремяВыезда.Вр6;
	
	НачалоНомерСтолбцаДата = КонецНомерСтолбца;	
ИначеЕсли ОбластьВремя.ТекущаяОбласть.Текст = "06:00" Тогда 
	ВремяВыезда = Перечисления.ВремяВыезда.Вр12;
	
	НачалоНомерСтолбцаДата = КонецНомерСтолбца - 1;	
