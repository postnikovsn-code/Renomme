	,Новый УникальныйИдентификатор,,,,РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);  
КонецПроцедуры

&НаСервере
Функция КлиентПоИННКППСсылка()
Если СокрЛП(Объект.ИНН) = "" Тогда Возврат Неопределено; КонецЕсли;

ЗапросТекст = "ВЫБРАТЬ
                          |	Клиенты.Ссылка КАК Ссылка
                          |ИЗ
                          |	Справочник.Клиенты КАК Клиенты
                          |ГДЕ
                          |	Клиенты.Ссылка <> &Ссылка
                          |	И Клиенты.ЭтоГруппа = ЛОЖЬ
						  |	И Клиенты.ИНН = &ИНН";

ЗапросПоиска = Новый Запрос;
Если СокрЛП(Объект.КПП) <> "" Тогда 
	ЗапросТекст = ЗапросТекст + "
	| 	И Клиенты.КПП = &КПП";
	ЗапросПоиска.УстановитьПараметр("КПП",Объект.КПП);	
КонецЕсли;
ЗапросПоиска.Текст = ЗапросТекст;

ЗапросПоиска.УстановитьПараметр("Ссылка",Объект.Ссылка);							  
ЗапросПоиска.УстановитьПараметр("ИНН", Объект.ИНН);
ТЗПоиск=ЗапросПоиска.Выполнить().Выгрузить();

Если ТЗПоиск.Количество() > 0 Тогда Возврат ТЗПоиск[0].Ссылка;	КонецЕсли;

Возврат Неопределено;
КонецФункции
