Функция БлокироватьЗаявки(МассивЗаявок) Экспорт
МассивОшибок = Новый Массив;
Для Каждого Элемент Из МассивЗаявок Цикл
	ЗаявкаОбъект = Элемент.ПолучитьОбъект();   
	Ответ = ОбщийФункционалСервер.БлокироватьОбъект(ЗаявкаОбъект);
	Если Ответ.Ошибка Тогда 
		ТекстОшибки = Ответ.ТекстОшибки;
		ТекстОшибки = "Заявка на бронирование " + ЗаявкаОбъект + " заблокирована (открыта), " + ТекстОшибки;  
		МассивОшибок.Добавить(ТекстОшибки);		
	КонецЕсли;	
КонецЦикла;		

Возврат МассивОшибок;
КонецФункции
