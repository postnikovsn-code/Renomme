&НаКлиенте
Процедура ЭквайрингВыгрузкаПлатежиЗагрузитьПлатежи(Команда)
ЭквайрингВыгрузкаПлатежиЗагрузитьПлатежиНаСервере();
ЭквайрингСчетаЗагрузитьНаСервере();
КонецПроцедуры

&НаСервере
Процедура ЭквайрингВыгрузкаПлатежиЗагрузитьПлатежиНаСервере()
Запрос = Новый Запрос("ВЫБРАТЬ
                      |	БезналЗагрузка.ГУИД КАК ГУИД,
                      |	БезналЗагрузка.ГУИДИсточникаСтрока КАК ГУИДИсточникаСтрока,
                      |	БезналЗагрузка.ДатаЗагрузки КАК ДатаЗагрузки,
                      |	БезналЗагрузка.КонтрагентНаименование КАК КонтрагентНаименованиеЗагрузка,
                      |	БезналЗагрузка.КонтрагентИНН КАК КонтрагентИННЗагрузка,
                      |	БезналЗагрузка.КонтрагентКПП КАК КонтрагентКППЗагрузка,
                      |	БезналЗагрузка.ДатаОплаты КАК ДатаПлатежа,
                      |	БезналЗагрузка.Сумма КАК СуммаПлатежа,
                      |	БезналЗагрузка.СуммаАннулировано КАК СуммаАннулировано,
                      |	БезналЗагрузка.ТекстПлатежа КАК ТекстПлатежа,
                      |	БезналЗагрузка.Отменено КАК Отменено,
                      |	БезналЗагрузка.ПолучательПлатежа КАК ПолучательПлатежа,
                      |	ЕСТЬNULL(Выписка.Сумма, 0) КАК СуммаВыписки,
					  |ЕСТЬNULL(ВыпискаОплаты.Сумма, 0) КАК СуммаВыпискиОплаты,
					  |	БезналЗагрузка.Сумма - ЕСТЬNULL(Выписка.Сумма, 0) КАК ОстатокПлатежа_1,
                      |	ВЫБОР
                      |		КОГДА БезналЗагрузка.ПолучательПлатежа = """"
                      |			ТОГДА БезналЗагрузка.Сумма
                      |		ИНАЧЕ ВЫБОР
                      |				КОГДА &ПолучательПлатежа = ""ЛАЙВ""
                      |					ТОГДА БезналЗагрузка.СуммаЛайв - ЕСТЬNULL(Выписка.Сумма, 0) - БезналЗагрузка.СуммаАннулировано
                      |				КОГДА &ПолучательПлатежа = ""ЧЕХОВ""
                      |					ТОГДА БезналЗагрузка.СуммаЧехов - ЕСТЬNULL(Выписка.Сумма, 0) - БезналЗагрузка.СуммаАннулировано
                      |				КОГДА &ПолучательПлатежа = ""ДОМ СОВЕТОВ""
                      |					ТОГДА БезналЗагрузка.СуммаДомСоветов - ЕСТЬNULL(Выписка.Сумма, 0) - БезналЗагрузка.СуммаАннулировано
                      |				КОГДА &ПолучательПлатежа = ""РЕНОМЕ""
                      |					ТОГДА БезналЗагрузка.СуммаРеноме - ЕСТЬNULL(Выписка.Сумма, 0) - БезналЗагрузка.СуммаАннулировано
                      |				КОГДА &ПолучательПлатежа = ""СТРИТ АРТ""
                      |					ТОГДА БезналЗагрузка.СуммаСтритАрт - ЕСТЬNULL(Выписка.Сумма, 0) - БезналЗагрузка.СуммаАннулировано
                      |				ИНАЧЕ 0
                      |			КОНЕЦ
                      |	КОНЕЦ КАК ОстатокПлатежа,
                      |	ЕСТЬNULL(Выписка.Сумма, 0) - ЕСТЬNULL(ВыпискаОплаты.Сумма, 0) - ЕСТЬNULL(ВыпискаВозвраты.Сумма, 0) КАК ОстатокВыписки,
                      |	БезналЗагрузка.СуммаЧехов КАК СуммаЧехов,
                      |	БезналЗагрузка.СуммаЛайв КАК СуммаЛайв,
                      |	БезналЗагрузка.СуммаДомСоветов КАК СуммаДомСоветов,
                      |	БезналЗагрузка.СуммаРеноме КАК СуммаРеноме,
                      |	БезналЗагрузка.СуммаСтритАрт КАК СуммаСтритАрт
                      |ИЗ
                      |	РегистрСведений.БезналЗагрузка КАК БезналЗагрузка
                      |		ЛЕВОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
                      |			ВыпискаБанка.ГУИДЗагрузка КАК ГУИДЗагрузка,
                      |			СУММА(ВыпискаБанка.Сумма) КАК Сумма
                      |		ИЗ
                      |			Документ.ВыпискаБанка КАК ВыпискаБанка
                      |		ГДЕ
                      |			ВыпискаБанка.ПометкаУдаления = ЛОЖЬ
                      |		
                      |		СГРУППИРОВАТЬ ПО
                      |			ВыпискаБанка.ГУИДЗагрузка) КАК Выписка
                      |		ПО БезналЗагрузка.ГУИД = Выписка.ГУИДЗагрузка
                      |		ЛЕВОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
                      |			СУММА(ВыпискаБанкаДолгиОплата.Сумма) КАК Сумма,
                      |			ВыпискаБанкаДолгиОплата.Ссылка.ГУИДЗагрузка КАК ГУИДЗагрузка
                      |		ИЗ
                      |			Документ.ВыпискаБанка.ДолгиОплата КАК ВыпискаБанкаДолгиОплата
                      |		
                      |		СГРУППИРОВАТЬ ПО
                      |			ВыпискаБанкаДолгиОплата.Ссылка.ГУИДЗагрузка) КАК ВыпискаОплаты
                      |		ПО БезналЗагрузка.ГУИД = ВыпискаОплаты.ГУИДЗагрузка
                      |		ЛЕВОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
                      |			СУММА(ВыпискаБанка.Сумма) КАК Сумма,
                      |			ВыпискаБанка.ВозвратДокумент.ГУИДЗагрузка КАК ВозвратДокументГУИДЗагрузка
                      |		ИЗ
                      |			Документ.ВыпискаБанка КАК ВыпискаБанка
                      |		
                      |		СГРУППИРОВАТЬ ПО
                      |			ВыпискаБанка.ВозвратДокумент.ГУИДЗагрузка) КАК ВыпискаВозвраты
                      |		ПО БезналЗагрузка.ГУИД = ВыпискаВозвраты.ВозвратДокументГУИДЗагрузка
                      |ГДЕ
                      |	БезналЗагрузка.КонтрагентИНН В(&СписокИННЭквайринг)
                      |	И ВЫБОР
                      |			КОГДА &ДатаПлатежаС = ДАТАВРЕМЯ(1, 1, 1, 0, 0, 0)
                      |				ТОГДА ИСТИНА
                      |			ИНАЧЕ БезналЗагрузка.ДатаОплаты >= &ДатаПлатежаС
                      |		КОНЕЦ
                      |	И ВЫБОР
                      |			КОГДА &ДатаПлатежаПо = ДАТАВРЕМЯ(1, 1, 1, 0, 0, 0)
                      |				ТОГДА ИСТИНА
                      |			ИНАЧЕ БезналЗагрузка.ДатаОплаты <= &ДатаПлатежаПо
                      |		КОНЕЦ
                      |	И ВЫБОР
                      |			КОГДА &ПлатежиТолькоНеотмененные
                      |				ТОГДА БезналЗагрузка.Отменено = ЛОЖЬ
                      |			ИНАЧЕ ИСТИНА
                      |		КОНЕЦ
                      |	И ВЫБОР
                      |			КОГДА &ПлатежиТолькоС2022
                      |				ТОГДА БезналЗагрузка.ДатаОплаты >= ДАТАВРЕМЯ(2022, 1, 1, 0, 0, 0)
                      |			ИНАЧЕ ИСТИНА
                      |		КОНЕЦ
                      |	И ВЫБОР
                      |			КОГДА &ГостиницаВсе
                      |				ТОГДА ИСТИНА
                      |			ИНАЧЕ БезналЗагрузка.ПолучательПлатежа = &ГостиницаОтбор
                      |		КОНЕЦ
                      |	И ВЫБОР
                      |			КОГДА &ПлатежиТолькоНезакрытые
                      |				ТОГДА ВЫБОР
                      |						КОГДА БезналЗагрузка.ПолучательПлатежа = """"
                      |							ТОГДА БезналЗагрузка.Сумма
                      |						ИНАЧЕ ВЫБОР
                      |								КОГДА &ПолучательПлатежа = ""ЛАЙВ""
                      |									ТОГДА БезналЗагрузка.СуммаЛайв - ЕСТЬNULL(Выписка.Сумма, 0) - БезналЗагрузка.СуммаАннулировано
                      |								КОГДА &ПолучательПлатежа = ""ЧЕХОВ""
                      |									ТОГДА БезналЗагрузка.СуммаЧехов - ЕСТЬNULL(Выписка.Сумма, 0) - БезналЗагрузка.СуммаАннулировано
                      |								КОГДА &ПолучательПлатежа = ""ДОМ СОВЕТОВ""
                      |									ТОГДА БезналЗагрузка.СуммаДомСоветов - ЕСТЬNULL(Выписка.Сумма, 0) - БезналЗагрузка.СуммаАннулировано
                      |								КОГДА &ПолучательПлатежа = ""РЕНОМЕ""
                      |									ТОГДА БезналЗагрузка.СуммаРеноме - ЕСТЬNULL(Выписка.Сумма, 0) - БезналЗагрузка.СуммаАннулировано
                      |								КОГДА &ПолучательПлатежа = ""СТРИТ АРТ""
                      |									ТОГДА БезналЗагрузка.СуммаСтритАрт - ЕСТЬNULL(Выписка.Сумма, 0) - БезналЗагрузка.СуммаАннулировано
                      |								ИНАЧЕ 0
                      |							КОНЕЦ
                      |					КОНЕЦ <> 0
                      |			ИНАЧЕ ИСТИНА
                      |		КОНЕЦ
                      |
                      |УПОРЯДОЧИТЬ ПО
                      |	ДатаЗагрузки,
                      |	ДатаПлатежа,
                      |	БезналЗагрузка.КонтрагентИНН,
                      |	БезналЗагрузка.КонтрагентКПП,
                      |	СуммаПлатежа");

					  //|	ВЫБОР
					  //|			КОГДА &КонтрагентИНН = """"
					  //|				ТОГДА ИСТИНА
					  //|			ИНАЧЕ БезналЗагрузка.КонтрагентИНН = &КонтрагентИНН
					  //|		КОНЕЦ

СписокИННЭквайринг = БезналРаспределениеСервер.СписокИННЭквайринг();
Запрос.УстановитьПараметр("СписокИННЭквайринг", СписокИННЭквайринг);

Запрос.УстановитьПараметр("ДатаПлатежаС", ЭквайрингВыгрузкаДатаПлатежаС);
Запрос.УстановитьПараметр("ДатаПлатежаПо", ЭквайрингВыгрузкаДатаПлатежаПо);

Запрос.УстановитьПараметр("ПлатежиТолькоНезакрытые", ЭквайрингВыгрузкаПлатежиТолькоНезакрытые);
Запрос.УстановитьПараметр("ПлатежиТолькоНеотмененные", ЭквайрингВыгрузкаПлатежиТолькоНеотмененные);
Запрос.УстановитьПараметр("ПлатежиТолькоС2022", ЭквайрингВыгрузкаПлатежиТолькоС2022);

Запрос.УстановитьПараметр("ГостиницаВсе", ЭквайрингВыгрузкаПлатежиПолучательПлатежаВсе);
Запрос.УстановитьПараметр("ГостиницаОтбор", ЭквайрингВыгрузкаПлатежиПолучательПлатежаОтбор);

ПолучательПлатежа = ПолучательПлатежа_Константа;
Запрос.УстановитьПараметр("ПолучательПлатежа", ПолучательПлатежа);

ТЗ = Запрос.Выполнить().Выгрузить(); 
ЭквайрингВыгрузкаПлатежи.Очистить();
Для Каждого Строка Из ТЗ Цикл
	НоваяСтрока = ЭквайрингВыгрузкаПлатежи.Добавить();		
	ЗаполнитьЗначенияСвойств(НоваяСтрока, Строка);
	
	УстановитьСуммыПлатежейТолькоПросмотр(НоваяСтрока, Строка);
КонецЦикла;

ЭквайрингВыгрузкаПлатежи.Сортировать("ДатаЗагрузки, ДатаПлатежа, СуммаПлатежа");

Если ЭквайрингВыгрузкаПлатежи.Количество() = 0 Тогда
	ЭквайрингВыгрузкаПлатежиГУИД_Текущий = Неопределено;
КонецЕсли;
КонецПроцедуры
//

&НаКлиенте
Процедура ЭквайрингВыгрузкаПлатежиПриАктивизацииСтроки(Элемент)
Если Элемент.ТекущиеДанные = Неопределено Тогда	
	ЭквайрингВыгрузкаПлатежиГУИД_Текущий = Неопределено;
Иначе
	ЭквайрингВыгрузкаПлатежиГУИД_Текущий = Элемент.ТекущиеДанные.ГУИД;
КонецЕсли;

ЭквайрингСвязиЗагрузитьНаСервере();	
КонецПроцедуры

//
&НаКлиенте
Процедура ЭквайрингВыгрузкаПлатежиПередНачаломДобавления(Элемент, Отказ, Копирование, Родитель, Группа, Параметр)
Отказ = Истина;
КонецПроцедуры

&НаКлиенте
Процедура ЭквайрингВыгрузкаПлатежиПередУдалением(Элемент, Отказ)
Отказ = Истина;
КонецПроцедуры
//

//
&НаКлиенте
Процедура ЭквайрингВыгрузкаПлатежиПередНачаломИзменения(Элемент, Отказ)
ТД = Элемент.ТекущиеДанные;	
ЗапомнитьOldValueПередНачаломИзменения(ТД);	

ПолучательПлатежа_OldValue = ТД.ПолучательПлатежа;
КонецПроцедуры
//


//
&НаКлиенте
Процедура ЭквайрингВыгрузкаОтменитьВостановитьПлатежи(Команда)
Для Каждого ТС Из Элементы.ЭквайрингВыгрузкаПлатежи.ВыделенныеСтроки Цикл	
	
	ТекстОшибки = ЭквайрингВыгрузкаПроверкаОтменитьВосстановитьПлатеж(ТС);
	Если ТекстОшибки.Количество() > 0 Тогда 
		ТекстСообщения = "";
		Для Каждого Элемент Из ТекстОшибки Цикл
			ТекстСообщения = ТекстСообщения + Элемент;
		КонецЦикла;	
	
		Сообщить(ТекстСообщения);
		Продолжить; 
	КонецЕсли; 
	
	ЭквайрингВыгрузкаОтменитьВосстановитьПлатежНаСервере(ТС)
КонецЦикла;	
КонецПроцедуры


&НаКлиенте
Процедура ЭквайрингВыгрузкаОтменитьВосстановитьПлатеж(Команда)
ТС = Элементы.ЭквайрингВыгрузкаПлатежи.ТекущаяСтрока;	
Если ТС = Неопределено Тогда Возврат; КонецЕсли;   	
	
ТекстОшибки = ЭквайрингВыгрузкаПроверкаОтменитьВосстановитьПлатеж(ТС);
Если ТекстОшибки.Количество() > 0 Тогда 
	ТекстПредупреждения = "";
	Для Каждого Элемент Из ТекстОшибки Цикл
		ТекстПредупреждения = ТекстПредупреждения + Элемент + Символы.ПС;
	КонецЦикла;	
	ТекстПредупреждения = Лев(ТекстПредупреждения, СтрДлина(ТекстПредупреждения) - 1);

	
	ПоказатьПредупреждение(, ТекстПредупреждения);
	Возврат; 
КонецЕсли; 

ЭквайрингВыгрузкаОтменитьВосстановитьПлатежНаСервере(ТС);
КонецПроцедуры

&НаКлиенте
Функция ЭквайрингВыгрузкаПроверкаОтменитьВосстановитьПлатеж(ТС)
ТД = ЭквайрингВыгрузкаПлатежи.НайтиПоИдентификатору(ТС);
	
ТекстОшибки = Новый Массив;	
	
//Если ЭквайрингВыпискаСвязиОплатыСчета.Количество() > 0 Тогда 
//	ТекстОшибки = "Платеж от " 
//	| "Есть связи платежа с документами долга
//	|
//	|ДЛЯ ОТМЕНЫ ПЛАТЕЖА УДАЛИТЕ СВЯЗИ ПЛАТЕЖА С ДОКУМЕНТАМИ ДОЛГА 
//	|ИЛИ УДАЛИТЕ ВЫПИСКУ ...";
//	
//	ПоказатьПредупреждение(, ТекстОшибки);
//	
//	Возврат ТекстОшибки; 
//КонецЕсли; 


Если ТД.СуммаВыписки > 0 Тогда 
	//ТекстОшибки.Добавить("Платеж от " + ТД.ДатаПлатежа + " на сумму " + ТД.СуммаПлатежа + ". "); 
	
	Текст = ПлатежТекст(ТД);
	ТекстОшибки.Добавить(Текст);
	
	ТекстОшибки.Добавить("Есть выписки для платежа. "); 
	ТекстОшибки.Добавить(""); 
	ТекстОшибки.Добавить("ДЛЯ ОТМЕНЫ ПЛАТЕЖА УДАЛИТЕ СВЯЗИ ПЛАТЕЖА С ДОКУМЕНТАМИ ДОЛГА ИЛИ УДАЛИТЕ ВЫПИСКИ."); 
	
	Возврат ТекстОшибки; 
КонецЕсли; 

Возврат ТекстОшибки;
КонецФункции

&НаСервере
Процедура ЭквайрингВыгрузкаОтменитьВосстановитьПлатежНаСервере(ТС)
ТД = ЭквайрингВыгрузкаПлатежи.НайтиПоИдентификатору(ТС);
	
ОтменитьВосстановитьПлатеж(ТД);
КонецПроцедуры
//

//
&НаКлиенте
Процедура ЭквайрингВыгрузкаУдалитьВыписки(Команда)
ЭквайрингВыгрузкаУдалитьВыпискиНаСервере();

ЭквайрингВыгрузкаПлатежиЗагрузитьПлатежи(Неопределено);
КонецПроцедуры

&НаСервере
Функция ЭквайрингВыгрузкаУдалитьВыпискиНаСервере()
НачатьТранзакцию();

Для Каждого Строка Из ЭквайрингВыпискаСвязиОплатыСчета Цикл
	Строка.Отметка = Истина;
КонецЦикла;

ЭквайрингВыпискаСвязиУдалитьНаСервере();

ТекущиеДанныеПлатежи = ЭквайрингВыгрузкаПлатежи.НайтиПоИдентификатору(Элементы.ЭквайрингВыгрузкаПлатежи.ТекущаяСтрока);
Если ТекущиеДанныеПлатежи.СуммаВыписки <> 0 Тогда
	Запрос = Новый Запрос("ВЫБРАТЬ
	                      |	ВыпискаБанка.Ссылка КАК ВыпискаБанка
	                      |ИЗ
	                      |	Документ.ВыпискаБанка КАК ВыпискаБанка
	                      |		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.БезналЗагрузка КАК БезналЗагрузка
	                      |		ПО ВыпискаБанка.ГУИДЗагрузка = БезналЗагрузка.ГУИД
	                      |ГДЕ
	                      |	БезналЗагрузка.ГУИД = &ГУИД");
	
	Запрос.УстановитьПараметр("ГУИД", ТекущиеДанныеПлатежи.ГУИД);
	ТЗ = Запрос.Выполнить().Выгрузить();
	
	Для Каждого Строка Из ТЗ Цикл
		ВыпискаБанкаОбъект = Строка.ВыпискаБанка.ПолучитьОбъект();
		
		ВыпискаБанкаОбъект.Удалить();
	КонецЦикла;
КонецЕсли;

ЗафиксироватьТранзакцию();
КонецФункции
//


//
&НаКлиенте
Процедура ЭквайрингВыгрузкаПлатежиПолучательПлатежаПриИзменении(Элемент)
ТД = Элементы.ЭквайрингВыгрузкаПлатежи.ТекущиеДанные;

Если ТД.СуммаВыписки > 0 Тогда
	ТД.ПолучательПлатежа = ПолучательПлатежа_OldValue;
	
	ПоказатьПредупреждение(, "Есть документ оплаты (выписка) для этого платежа.
	|
	|ИЗМЕНЕНИЕ НЕ РАЗРЕШЕНО ...
	|
	|Для изменения получателя платежа удалите связи платежа и счетов."
	);
	
	Элементы.ЭквайрингВыгрузкаПлатежи.ЗакончитьРедактированиеСтроки(Ложь);
	Возврат;
КонецЕсли;

ЗаполнитьСуммаПолучательПлатежа(ТД);

Элементы.ЭквайрингВыгрузкаПлатежи.ЗакончитьРедактированиеСтроки(Ложь);
КонецПроцедуры
//

//
&НаКлиенте
Процедура ЭквайрингВыгрузкаПлатежиПередОкончаниемРедактирования(Элемент, НоваяСтрока, ОтменаРедактирования, Отказ)
Если ОтменаРедактирования Тогда Возврат; КонецЕсли;	
	
ТД = Элемент.ТекущиеДанные;

Отказ = ПроверкаСуммыПлатежейПередОкончаниемРедактирования(ТД);
КонецПроцедуры

&НаКлиенте
Процедура ЭквайрингВыгрузкаПлатежиПриОкончанииРедактирования(Элемент, НоваяСтрока, ОтменаРедактирования)
ПлатежиПриОкончанииРедактирования("ЭквайрингВыгрузкаПлатежи", Элемент, НоваяСтрока, ОтменаРедактирования);	
КонецПроцедуры
//

