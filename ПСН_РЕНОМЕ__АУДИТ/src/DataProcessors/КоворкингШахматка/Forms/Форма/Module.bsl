&НаСервере
Процедура ТЕСТНаСервере()
	Запрос=Новый Запрос("ВЫБРАТЬ
	                    |	КоворкингЗаявка.Ссылка КАК Ссылка,
	                    |	КоворкингЗаявка.Клиент КАК Клиент,
	                    |	СУММА(СчетаОплаты.СуммаСчета) КАК СуммаСчета,
	                    |	СУММА(СчетаОплаты.СуммаРаспределено) КАК СуммаРаспределено
	                    |ИЗ
	                    |	Документ.КоворкингЗаявка КАК КоворкингЗаявка
	                    |		ЛЕВОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
	                    |			КоворкингСчета.Ссылка КАК Ссылка,
	                    |			КоворкингСчета.Сумма КАК СуммаСчета,
	                    |			Оплаты.СуммаРаспределено КАК СуммаРаспределено,
	                    |			КоворкингСчета.КоворкингЗаявка КАК СчетКоворкингЗаявка
	                    |		ИЗ
	                    |			Документ.КоворкингСчета КАК КоворкингСчета,
	                    |			(ВЫБРАТЬ
	                    |				КоворкингСчетаДокументыОплаты.Ссылка КАК ОплатыСсылка,
	                    |				СУММА(КоворкингСчетаДокументыОплаты.СуммаРаспределено) КАК СуммаРаспределено
	                    |			ИЗ
	                    |				Документ.КоворкингСчета.ДокументыОплаты КАК КоворкингСчетаДокументыОплаты
	                    |			
	                    |			СГРУППИРОВАТЬ ПО
	                    |				КоворкингСчетаДокументыОплаты.Ссылка) КАК Оплаты) КАК СчетаОплаты
	                    |		ПО КоворкингЗаявка.Ссылка = СчетаОплаты.СчетКоворкингЗаявка
	                    |
	                    |СГРУППИРОВАТЬ ПО
	                    |	КоворкингЗаявка.Ссылка,
	                    |	КоворкингЗаявка.Клиент");	
	
	ТЗ =  Запрос.Выполнить().Выгрузить();
КонецПроцедуры


