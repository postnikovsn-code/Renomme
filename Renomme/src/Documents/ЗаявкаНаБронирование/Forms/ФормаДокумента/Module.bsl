Если НЕ ЗначениеЗаполнено(Объект.Ссылка) Тогда
	Если ЗначениеЗаполнено(ЗаявкаСайт) Тогда
		ЭтаФорма.Ширина = 170;
		ЭтаФорма.Высота = 60;

		ОбъектShell = Новый COMОбъект("Wscript.Shell");
		ОбъектShell.SendKeys("+%{R}");
	КонецЕсли;
КонецЕсли;

БронируетТурагентство = ОбщийФункционалСервер.ЗначениеРеквизитаНаСервере(Объект.Бронирует, "Турагентство");
