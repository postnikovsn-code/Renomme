Функция ПолучитьЦветТекстаПоЦветуФона(ЦветФона) Экспорт
////	
//Темные цвета если все три значения меньше 0.5,
//а чтобы считались светлыми, достаточно, хотябы 1 из 3х цветов был болье 0.5 
//т.е. RGB(255/2+1, 126, 126) - уже светлый, а RGB(126, 126,126) - темный. Исходя из этого можно сделать мини функцию которая определяет light or dark		

//Если НовЦвет.Зеленый < 126 И НовЦвет.Красный < 126  И НовЦвет.Синий < 126 Тогда
//	Темный = Истина;
//Иначе	
//	Темный = Ложь;
//КонецЕсли;
////

//GrayScale = 0.299 * Red + 0.587 * Green + 0.114 * Blue;
//Если
//GrayScale > 127, то фон - светлый
//Если
//GrayScale <= 127, то фон - темный

GrayScale = 0.299 * ЦветФона.Красный + 0.587 * ЦветФона.Зеленый + 0.114 * ЦветФона.Синий;

Если GrayScale > 127 ТОгда 	// то фон - светлый
	ЦветТекста = WebЦвета.Черный;
Иначе 						// то фон - темный
	ЦветТекста = WebЦвета.Белый;
КонецЕсли;
	
Возврат ЦветТекста;	
КонецФункции	

