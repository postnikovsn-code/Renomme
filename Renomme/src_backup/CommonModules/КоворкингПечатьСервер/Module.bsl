Функция НомерДатаДокумента(Документ) Экспорт
НомерДокумента = ОбщийФункционалКлиентСервер.УбратьНезначащиеНули(Документ.Номер);
ДатаДокумента = Документ.ДатаПо;

Возврат Новый Структура("Номер, Дата", НомерДокумента, ДатаДокумента);  
КонецФункции



//Функция СчетФактураСтроки(ТабДок, Номер, Дата
//	, Контрагент, ДокументОтгрузки, ДокументДолгСсылка) Экспорт
Функция СчетФактураСтроки(ДокументДолгСсылка, ИтогоСуммаБезНДС, ИтогоСуммаНДС, ИтогоСумма) Экспорт

СтавкаНДС = ДокументыСервер.СтавкаНДС(Истина); 

ДатаУчетаНДС = Неопределено;
Если ТипЗнч(ДокументДолгСсылка) = Тип("ДокументСсылка.ЗаявкаНаБронирование") Тогда
	ДатаУчетаНДС = ДокументДолгСсылка.РезервПо;
ИначеЕсли ТипЗнч(ДокументДолгСсылка) = Тип("ДокументСсылка.КоворкингСчета") Тогда
	ДатаУчетаНДС = ДокументДолгСсылка.ДатаПо;
ИначеЕсли ТипЗнч(ДокументДолгСсылка) = Тип("ДокументСсылка.ГрупповыеСчета") Тогда
	ДатаУчетаНДС = ГрупповойСчетСервер.ДатаУчетаНДС(ДокументДолгСсылка);
КонецЕсли;		

Если ЗначениеЗаполнено(ДатаУчетаНДС) Тогда
	СтавкаНДС = ДокументыСервер.СтавкаНДСТекущая(СтавкаНДС, ДатаУчетаНДС);
КонецЕсли;
//ДанныеОрганизации = Справочники.Организации.ПолучитьДанныеОрганизации(Истина);
ТекущаяОрганизация = НастройкиСервер.ПолучитьТекущуюОрганизацию();

//
ТЗ_Строки = Новый ТаблицаЗначений;
ТЗ_Строки.Колонки.Добавить("НомерСтроки");

ТЗ_Строки.Колонки.Добавить("НаименованиеТовара");
ТЗ_Строки.Колонки.Добавить("КодЕдиницыИзмерения");
ТЗ_Строки.Колонки.Добавить("ЕдиницаИзмерения");

ТЗ_Строки.Колонки.Добавить("Количество");
ТЗ_Строки.Колонки.Добавить("Цена");

ТЗ_Строки.Колонки.Добавить("НалоговаяСтавка");
ТЗ_Строки.Колонки.Добавить("СуммаБезНДС");
ТЗ_Строки.Колонки.Добавить("СуммаНДС");
ТЗ_Строки.Колонки.Добавить("СуммаСНДС");

ТЗ_Строки.Колонки.Добавить("ЭтоУслуга");
ТЗ_Строки.Колонки.Добавить("Дата");

ИтогоСуммаБезНДС = 0;
ИтогоСуммаНДС = 0;
ИтогоСумма = 0;

сч = 0;

Если ДокументДолгСсылка.Сумма <> 0 Тогда
	Строка_ТЗ_Строки = ТЗ_Строки.Добавить();
	
	сч = сч + 1;
	Строка_ТЗ_Строки.НомерСтроки = сч;

	ТоварЕдиницаИзмерения = ТоварЕдиницаИзмеренияКоворкинг(ДокументДолгСсылка);
	Строка_ТЗ_Строки.НаименованиеТовара = ТоварЕдиницаИзмерения.Товар;

	Если ДокументДолгСсылка.ПочасоваяОплата Тогда
		Строка_ТЗ_Строки.КодЕдиницыИзмерения = "356";
		Строка_ТЗ_Строки.ЕдиницаИзмерения = "час";
	Иначе
		Строка_ТЗ_Строки.КодЕдиницыИзмерения = "359";
		Строка_ТЗ_Строки.ЕдиницаИзмерения = "сутки";
	КонецЕсли;
		
	Строка_ТЗ_Строки.Количество = ДокументДолгСсылка.Количество;
	Строка_ТЗ_Строки.Цена = ДокументДолгСсылка.Цена;

	СуммаБезНДС = ДокументыСервер.СуммаБезНДС(СтавкаНДС, ДокументДолгСсылка.Сумма);
	Строка_ТЗ_Строки.СуммаБезНДС = СуммаБезНДС;

	Строка_ТЗ_Строки.НалоговаяСтавка = СтавкаНДС;

	СуммаНДС = ДокументыСервер.СуммаНДС(СтавкаНДС, ДокументДолгСсылка.Сумма);
	Строка_ТЗ_Строки.СуммаНДС = СуммаНДС;

	Строка_ТЗ_Строки.СуммаСНДС = ДокументДолгСсылка.Сумма;
	
	Строка_ТЗ_Строки.ЭтоУслуга = Ложь;
	Строка_ТЗ_Строки.Дата = ДокументДолгСсылка.ДатаС;

	ИтогоСумма = ИтогоСумма + ДокументДолгСсылка.Сумма;
	ИтогоСуммаБезНДС = ИтогоСуммаБезНДС + СуммаБезНДС;
	ИтогоСуммаНДС = ИтогоСуммаНДС + СуммаНДС;
КонецЕсли;
		
Для Каждого Строка Из ДокументДолгСсылка.ДопУслугиКоворкинг Цикл
	Строка_ТЗ_Строки = ТЗ_Строки.Добавить();
	
 	сч = сч + 1;
	Строка_ТЗ_Строки.НомерСтроки = сч;
	
	Строка_ТЗ_Строки.НаименованиеТовара = "" + Строка.Услуга + " " + Формат(Строка.ДатаУслуги, "ДФ=dd.MM.yy"); 
											
	Строка_ТЗ_Строки.КодЕдиницыИзмерения = "796";
	Строка_ТЗ_Строки.ЕдиницаИзмерения = "шт";
	
	Строка_ТЗ_Строки.Количество = Строка.Количество;
	Строка_ТЗ_Строки.Цена = Строка.Цена;
	
	СуммаБезНДС = ДокументыСервер.СуммаБезНДС(СтавкаНДС, Строка.Сумма);
	Строка_ТЗ_Строки.СуммаБезНДС = СуммаБезНДС;
	
	Строка_ТЗ_Строки.НалоговаяСтавка = СтавкаНДС;
	
	СуммаНДС = ДокументыСервер.СуммаНДС(СтавкаНДС, Строка.Сумма);
	Строка_ТЗ_Строки.СуммаНДС = СуммаНДС;
	
	Строка_ТЗ_Строки.СуммаСНДС = Строка.Сумма;
	
	Строка_ТЗ_Строки.ЭтоУслуга = Истина;
	
	ИтогоСумма = ИтогоСумма + Строка.Сумма;
	ИтогоСуммаБезНДС = ИтогоСуммаБезНДС + СуммаБезНДС;
	ИтогоСуммаНДС = ИтогоСуммаНДС + СуммаНДС;
КонецЦикла;

Возврат ТЗ_Строки;
КонецФункции



Функция ПечатьСчетаФактуры(ТабДок, Номер, Дата
	, Контрагент, ДокументОтгрузки, ДокументДолгСсылка) Экспорт
Макет = ПолучитьОбщийМакет("СчетФактураМакет");

Область = Макет.ПолучитьОбласть("Заголовок");

Область.Параметры.Номер = Номер;
Область.Параметры.Дата = Формат(Дата, "ДФ=dd.MM.yyyy");

ДатаУчетаНДС = ДокументДолгСсылка.ДатаПо;
СтавкаНДС = ДокументыСервер.СтавкаНДС(Истина); СтавкаНДС = ДокументыСервер.СтавкаНДСТекущая(СтавкаНДС, ДатаУчетаНДС);
//ДанныеОрганизации = Справочники.Организации.ПолучитьДанныеОрганизации(Истина);
ТекущаяОрганизация = НастройкиСервер.ПолучитьТекущуюОрганизацию();

Продавец = ТекущаяОрганизация.КоворкингОрганизацияДляДокументов;
АдресПродавца = ТекущаяОрганизация.КоворкингАдресДляДокументов;
ИННКПППродавца = ТекущаяОрганизация.КоворкингИНН + "/" + ТекущаяОрганизация.КоворкингИНН;

Область.Параметры.Продавец = Продавец;
Область.Параметры.АдресПродавца = АдресПродавца;
Область.Параметры.ИННКПППродавца = ИННКПППродавца;
Область.Параметры.ДокументОтгрузки = ДокументОтгрузки;

Если Контрагент.ТипКлиента = Перечисления.ТипыКлиентов.ФизЛицо Тогда 
	//Область.Параметры.Покупатель = Контрагент.Наименование;
	Область.Параметры.Покупатель = "Гость отеля";
	
	Область.Параметры.АдресПокупателя = "";
	Область.Параметры.ИННКПППокупателя = "" + "/" + "";
Иначе	
	Область.Параметры.Покупатель = ?(ЗначениеЗаполнено(Контрагент.НаименованиеЮрЛица)
										, Контрагент.НаименованиеЮрЛица, Контрагент.Наименование);
	Область.Параметры.АдресПокупателя = Контрагент.Адрес;
	Область.Параметры.ИННКПППокупателя = Контрагент.ИНН + "/" + Контрагент.КПП;
КонецЕсли;
	
ТабДок.Вывести(Область);

Область = Макет.ПолучитьОбласть("Шапка");
ТабДок.Вывести(Область);

//
ИтогоСуммаБезНДС = 0;
ИтогоСуммаНДС = 0;
ИтогоСумма = 0;

сч = 0;
ТЗ_Строки = СчетФактураСтроки(ДокументДолгСсылка, ИтогоСуммаБезНДС, ИтогоСуммаНДС, ИтогоСумма);

Для Каждого Строка Из ТЗ_Строки Цикл
	Область = Макет.ПолучитьОбласть("Строка");

	Область.Параметры.НомерСтроки = Строка.НомерСтроки;

	Область.Параметры.НаименованиеТовара = Строка.НаименованиеТовара;

	Область.Параметры.КодЕдиницыИзмерения = Строка.КодЕдиницыИзмерения;
	Область.Параметры.ЕдиницаИзмерения = Строка.ЕдиницаИзмерения;
	
	Область.Параметры.Количество = Строка.Количество;

	Область.Параметры.Цена = Строка.Цена;

	Область.Параметры.НалоговаяСтавка = Строка.НалоговаяСтавка;

	Область.Параметры.СуммаБезНДС = Строка.СуммаБезНДС;
	
	Область.Параметры.СуммаНДС = Строка.СуммаНДС;

	Область.Параметры.СуммаСНДС = Строка.СуммаСНДС;

	ТабДок.Вывести(Область);
КонецЦикла;

Область = Макет.ПолучитьОбласть("Итоги");
	
Область.Параметры.СуммаБезНДС = ИтогоСуммаБезНДС;
Область.Параметры.СуммаНДС = ИтогоСуммаНДС;
Область.Параметры.СуммаСНДС = ИтогоСумма;

ТабДок.Вывести(Область);

Область = Макет.ПолучитьОбласть("Подвал");

Область.Параметры.Руководитель =  ТекущаяОрганизация.КоворкингФИОРуководительДляДокументов;
Область.Параметры.Бухгалтер =  ТекущаяОрганизация.КоворкингФИОБухгалтерДляСчетаФактуры;

ТабДок.Вывести(Область);

ТабДок.ОриентацияСтраницы = ОриентацияСтраницы.Ландшафт;
ТабДок.АвтоМасштаб = Истина;
КонецФункции

