&НаСервере
Функция ВывестиШахматку(ДатаС,ДатаПо,Детализация)
// + ПСН Перенесено в ПриОткрытии и в ВыводШахматки  	
	//ПоказатьОповещения();
// - ПСН ПСН Перенесено в ПриОткрытии и в ВыводШахматки  	

	ТЗШахм.Очистить();
	ДатаС=?(Детализация="День",НачалоДня(ДатаС),НачалоЧаса(ДатаС));
	Запрос=Новый Запрос("ВЫБРАТЬ
	                    |	ЗанятостьНомеров.Клиент КАК Клиент,
	                    |	ЗанятостьНомеров.Регистратор.Статус КАК Статус,
	                    |	ЗанятостьНомеров.Регистратор КАК Регистратор
	                    |ИЗ
	                    |	РегистрСведений.ЗанятостьНомеров КАК ЗанятостьНомеров
	                    |ГДЕ
	                    |	ЗанятостьНомеров.ПериодРезерва МЕЖДУ &ДатаС И &ДатаПо
	                    |	И ЗанятостьНомеров.Зарезервирован = ИСТИНА
	                    |	И ЗанятостьНомеров.Регистратор.Статус <> ЗНАЧЕНИЕ(Перечисление.СтатусБрони.ОтказОтБронирования)
	                    |
	                    |УПОРЯДОЧИТЬ ПО
	                    |	Клиент");	
	
	Запрос.УстановитьПараметр("ДатаС",ДатаС);						
	Запрос.УстановитьПараметр("ДатаПо",ДатаПо);
	ТЗКлиентов=Запрос.Выполнить().Выгрузить();
	ТЗКлиентов.Колонки.Добавить("Цвет");
	
	Сч=0;
	////СписокЦветов=Новый СписокЗначений;
	Для каждого Клиент Из ТЗКлиентов Цикл	
		Если Клиент.Статус=Перечисления.СтатусБрони.Проживает тогда
			Клиент.Цвет=Новый Цвет(255,255,255);
		иначеесли Клиент.Статус=Перечисления.СтатусБрони.Выехал тогда
			Клиент.Цвет=Новый Цвет(231, 227, 217);
		иначеесли Клиент.Статус=Перечисления.СтатусБрони.ОтказОтБронирования тогда
			Клиент.Цвет=Новый Цвет(233, 150, 122);   // Лосось темный
		иначе
			Если Клиент.регистратор.ЦветR<>0 Или  Клиент.регистратор.ЦветG<>0 или  Клиент.регистратор.ЦветB<>0 тогда	
				Клиент.Цвет=Новый Цвет(Клиент.регистратор.ЦветR,Клиент.регистратор.ЦветG,Клиент.регистратор.ЦветB);
			ИначеЕсли Клиент.Клиент.ЦветR<>0 Или  Клиент.Клиент.ЦветG<>0 или  Клиент.Клиент.ЦветB<>0 тогда	
				Клиент.Цвет=Новый Цвет(Клиент.Клиент.ЦветR,Клиент.Клиент.ЦветG,Клиент.Клиент.ЦветB);
			иначе
				Клиент.Цвет = СлучайныйЦвет(ТЗКлиентов);
			КонецЕсли;
		конецесли;
	КонецЦикла; 
	
	Запрос=Новый Запрос("ВЫБРАТЬ
	                    |	ЗанятостьНомеров.Номер КАК Номер,
	                    |	ЗанятостьНомеров.Клиент КАК Клиент,
	                    |	ЗанятостьНомеров.ПериодРезерва КАК ПериодРезерва,
	                    |	ЗанятостьНомеров.Регистратор КАК Регистратор,
	                    |	ЗанятостьНомеров.БонШанс КАК БонШанс
	                    |ИЗ
	                    |	РегистрСведений.ЗанятостьНомеров КАК ЗанятостьНомеров
	                    |ГДЕ
	                    |	ЗанятостьНомеров.ПериодРезерва МЕЖДУ &ДатаС И &ДатаПо
	                    |	И ЗанятостьНомеров.Зарезервирован = ИСТИНА
	                    |	И ЗанятостьНомеров.Регистратор.Статус <> ЗНАЧЕНИЕ(Перечисление.СтатусБрони.ОтказОтБронирования)");	
	Запрос.УстановитьПараметр("ДатаС",ДатаС);						
	Запрос.УстановитьПараметр("ДатаПо",ДатаПо);
	ТЗЗапроса=Запрос.Выполнить().Выгрузить();
	
	ПолеОтчета.Очистить();
	
//// + Вывод Верхних строк с датами		
	ТемпС=ДатаС;
	ТемпПо=ДатаПо;
	
	//Макет = Обработки.Интерфейс.ПолучитьМакет("Макет");
	ОтчетОбъект = РеквизитФормыВЗначение("Объект");
	Макет = ОтчетОбъект.ПолучитьМакет("Макет");

	ТабДок=Новый ТабличныйДокумент;
	Обл=Макет.ПолучитьОбласть("Шапка|ШапкаВерх");
	ТабДок.Присоединить(Обл);
	
	ТЗОбъеденения=Новый ТаблицаЗначений();
	ТЗОбъеденения.Колонки.Добавить("КолонкаС");
	ТЗОбъеденения.Колонки.Добавить("КолонкаПо");
	ТЗОбъеденения.Колонки.Добавить("ДТ");
	
	Обл=Макет.ПолучитьОбласть("Шапка|СтрПериод");
	ТемпДень=НачалоДня(ТемпС);
	Нов=ТЗОбъеденения.Добавить();
	Нов.КолонкаС=2;
	Нов.КолонкаПо=2;
	Нов.ДТ=Формат(ТемпДень, "ДФ=dd.MM");
	ТекКол=2;
	
	ШиринаПолеОтчетаМинимум = 2;
	ШиринаПоляОтчетаМаксимум = 2;
	Пока ТемпС<=ТемпПо цикл
		Если НачалоДня(ТемпС)>ТемпДень тогда
			// новый день
			Нов.КолонкаПо=ТекКол-1;
			Нов=ТЗОбъеденения.Добавить();
			Нов.КолонкаС=ТекКол;
			Нов.КолонкаПо=ТекКол+1;
			ТемпДень=НачалоДня(ТемпС);
			Нов.ДТ=Формат(ТемпДень, "ДФ=dd.MM");	
		конецесли;
		
		// + ПСН  Замена 12:00 на 14:00
		//Обл.Параметры.Период=Формат(ТемпС, ?(Детализация="День","ДФ='dd.MM'","ДФ='HH:mm'"));
		Если Детализация="День" Тогда 
			Обл.Параметры.Период=Формат(ТемпС, "ДФ='dd.MM'");
		Иначе	
			ТемпС_Период = Формат(ТемпС, "ДФ='HH:mm'");		
			Если Лев(ТемпС_Период, 2) = "12" Тогда
				ТемпС_Период = СтрЗаменить(ТемпС_Период, "12", "14");
			КонецЕсли;
			Обл.Параметры.Период = ТемпС_Период;
		КонецЕсли;
		// - ПСН  Замена 12:00 на 14:00
		
		ТабДок.Присоединить(Обл);
		ТемпС=ТемпС+?(Детализация="День", 86400, 3600*6);
		ТекКол=ТекКол+1;
		
		ШиринаПоляОтчетаМаксимум = ШиринаПоляОтчетаМаксимум + 1;
	КонецЦикла;
	
	Нов.КолонкаПо=ТекКол-1;
	Для каждого Об Из ТЗОбъеденения Цикл
		ТабДок.Область(2,Об.КолонкаС+1,2,Об.КолонкаС+1).Текст=Об.ДТ;
		
		ТабДок.Область(2,Об.КолонкаС+1,2,Об.КолонкаПо+1).Объединить();
	КонецЦикла; 
	
	ПолеОтчета.Вывести(ТабДок);
//// + Вывод Верхних строк с датами	
	
	СпрНомеров=Справочники.НомернойФонд.Выбрать();
	Х=0;
	У=0;
	
	ВысотаПолеОтчетаМинимум = 4;
	ВысотаПоляОтчетаМаксимум = 4;
	Пока СпрНомеров.Следующий() цикл
		Если СпрНомеров.ПометкаУдаления Тогда продолжить; КонецЕсли;
				
		ВысотаПоляОтчетаМаксимум = ВысотаПоляОтчетаМаксимум + 1;
		
		У=У+1;
		
		ТабДок=Новый ТабличныйДокумент;
		
		ТемпС=ДатаС;
		ТемпПо=ДатаПо;
		
		Обл=Макет.ПолучитьОбласть("Строка|ШапкаВерх");
		Обл.Параметры.Номер=СпрНомеров.Наименование + ?(СпрНомеров.РаздельныеКровати, " / РК","")+ ?(СпрНомеров.Балкон, "/ Б ","");
		Если Не СпрНомеров.ЦветНомераB+СпрНомеров.ЦветНомераG+СпрНомеров.ЦветНомераR=0 тогда
			//Обл.Область(1,2,1,2).ЦветФона=Новый Цвет(СпрНомеров.ЦветНомераR,СпрНомеров.ЦветНомераG,СпрНомеров.ЦветНомераB);
			//Обл.Область(1,2,1,2).ЦветТекста = ОбщийФункционалСервер.ПолучитьЦветТекстаПоЦветуФона(Обл.Область(1,2,1,2).ЦветФона);
			Обл.Область(1,1,1,2).ЦветФона=Новый Цвет(СпрНомеров.ЦветНомераR,СпрНомеров.ЦветНомераG,СпрНомеров.ЦветНомераB);
			Обл.Область(1,1,1,2).ЦветТекста = ОбщийФункционалСервер.ПолучитьЦветТекстаПоЦветуФона(Обл.Область(1,2,1,2).ЦветФона);
		конецесли;
		
		//Обл.Область(1,1,1,1).Расшифровка = СпрНомеров.ОписаниеНомера;
	    Обл.Область(1,1,1,1).Расшифровка = СпрНомеров.Ссылка;
		////Обл.Область(1,1,1,1).ИспользованиеРасшифровки=ИспользованиеРасшифровкиТабличногоДокумента.
		ТабДок.Присоединить(Обл);
		
		ТемпКл=Справочники.Клиенты.ПустаяСсылка();
		
		//// + ПСН 25.04.22
		ТемпРегистратор=Документы.ЗаявкаНаБронирование.ПустаяСсылка();
		//// - ПСН 25.04.22
		
		СписОб=Новый СписокЗначений;                            
		Сч=2;
		НачИ=3;	
		Х=0;
		
		Пока ТемпС<=ТемпПо цикл
			Х=Х+1;			
			ПС=?(Детализация="День",НачалоДня(ТемпС),НачалоЧаса(ТемпС));
			//ПК=?(Детализация="День",КонецДня(ТемпС),КонецЧаса(ТемпС));
			
			Отбор=Новый Структура("ПериодРезерва,Номер",ПС,СпрНомеров.Ссылка);
			СтрокиНом=ТЗЗапроса.НайтиСтроки(Отбор);
			
			Обл=Макет.ПолучитьОбласть("Строка|СтрПериод");
			
			//// + ПСН 25.04.22
			//Политов
			//если  СпрНомеров.КатегорияНомера.Наименование="Переговорная" тогда
			//	Обл.Область(1,1,1,1).ЦветФона=Новый Цвет(184, 184, 184);
			//	Обл.Область(1,1,1,1).ЦветТекста = ОбщийФункционалСервер.ПолучитьЦветТекстаПоЦветуФона(Обл.Область(1,1,1,1).ЦветФона);
			//КонецЕсли;
			//Политов
			//// - ПСН 25.04.22

			////Если ТЗЗапроса.Количество()<>0 тогда
			Если СтрокиНом.Количество() <> 0 тогда
				////ТекКл=ТЗЗапроса[0].Клиент;
				////// + ПСН 25.04.22
				//ТекКл=СтрокиНом[0].Клиент;
				//
				//ТекРегистратор=СтрокиНом[0].Регистратор;
				////// - ПСН 25.04.22
				
				//Если СтрокиНом[0].Клиент.Наименование = "Оксана" ТОгда
				//	ш = 1;
				//КонецЕсли;
				
				Если СтрокиНом.Количество() > 1 Тогда 
					ТекКл = СтрокиНом[0].Клиент;
					
					//// + ПСН 25.04.22
					ТекРегистратор = СтрокиНом[0].Регистратор;
					//// - ПСН 25.04.22
					
					ТекСтатус = Неопределено; 
					ТекРегистратор = Неопределено;
					
					Обл.Параметры.Период = "Б/Ш " + Строка(СтрокиНом.Количество());
					Цв = Новый Цвет(0, 0, 255);
					
					////НовШ.Документ=СтрокиНом[0].Регистратор;
				Иначе	
					ТекКл=СтрокиНом[0].Клиент;
					
					//// + ПСН 25.04.22
					ТекРегистратор=СтрокиНом[0].Регистратор;
					//// - ПСН 25.04.22
					
					////	КлСтат=ТЗКлиентов.Найти(ТЗЗапроса[0].Клиент,"Клиент");
					КлСтат=ТЗКлиентов.Найти(СтрокиНом[0].Регистратор,"Регистратор");
					Цв=КлСтат.Цвет;
					
					Если ТекКл = ТемпКл Тогда
						Если ТекРегистратор <> ТемпРегистратор Тогда
							ЦветR = Цв.Красный  + 5;
							Если ЦветR > 255 Тогда
								ЦветR = ЦветR - 10;
							КонецЕсли;
									
							Цв = Новый Цвет(ЦветR, Цв.Зеленый, Цв.Синий);
						КонецЕсли;	
					КонецЕсли;	
					
					Обл.Параметры.Период=ТекКл.Наименование;
					
					ТекСтатус = КлСтат.Статус; 
				КонецЕсли;	
				
				Обл.Область(1,1,1,1).ЦветФона=Цв;
				Обл.Область(1,1,1,1).ЦветТекста = ОбщийФункционалСервер.ПолучитьЦветТекстаПоЦветуФона(Обл.Область(1,1,1,1).ЦветФона);

				//Если КлСтат.Статус=Перечисления.СтатусБрони.Проживает тогда
				Если ТекСтатус = Перечисления.СтатусБрони.Проживает тогда
					Обл.Область(1,1,1,1).Шрифт=Новый Шрифт(Обл.Область(1,1,1,1).Шрифт,,,Истина);
				КонецЕсли;
				
				//Обл.Параметры.Период=ТекКл.Наименование;
				
				НовШ=ТЗШахм.Добавить();
				НовШ.Х=Х;
				НовШ.У=У;
				НовШ.Клиент=ТекКл;
				НовШ.Номер=СпрНомеров.Ссылка;
				////НовШ.Документ=ТЗЗапроса[0].Регистратор;
				
				ДокументМассив = Новый СписокЗначений; 
				Для Каждого СтрокаДанные Из СтрокиНом Цикл
					ДокументМассив.Добавить(СтрокаДанные.Регистратор); 
				КонецЦикла;
				НовШ.Документ=ДокументМассив;
				
				НовШ.Период=?(Детализация="День",НачалоДня(ТемпС),НачалоЧаса(ТемпС));
			иначе
				ТекКл=Справочники.Клиенты.ПустаяСсылка();			
			конецесли;
			
			//// + ПСН 25.04.22
			//Если ТекКл<>ТемпКл тогда
			Если ТекКл<>ТемпКл 
			ИЛИ ТекРегистратор <> ТемпРегистратор 
			тогда
			//// - ПСН 25.04.22
				
				НовОб=новый Структура("Нач,Кон,ТекКл",НачИ,сч,ТемпКл);
				СписОб.Добавить(НовОб);
				
				ТемпКл=ТекКл;
				//// + ПСН 25.04.22
				ТемпРегистратор = ТекРегистратор;
				//// - ПСН 25.04.22
				
				НачИ=Сч+1;
			конецесли;
			
			ТабДок.Присоединить(Обл);
			
			// + ПСН 07.06.2022
			//ТемпС = ТемпС + ?(Детализация="День", 86400, 3600*6);
			
			Если Час(ТемпС) = 6 Тогда
				ТемпС = ТемпС + ?(Детализация="День", 86400, 3600*8);
			Иначе				
				ТемпС = ТемпС + ?(Детализация="День", 86400, 3600*6);
			КонецЕсли;
			
			сч=сч+1;
		КонецЦикла;
		
		НовОб=новый Структура("Нач,Кон,ТекКл",НачИ,сч,ТемпКл);
		СписОб.Добавить(НовОб);
		
		Первый=Истина;
		Для каждого Об Из СписОб Цикл
			если Первый Тогда
				Первый=Ложь;
				Продолжить;
				
			конецесли;
			Если Об.Значение.ТекКл=Справочники.Клиенты.ПустаяСсылка() тогда
				Продолжить;
			конецесли;
			
			ТабДок.Область(1,Об.Значение.Нач,1,Об.Значение.Кон).Объединить();
		КонецЦикла; 
		
		ПолеОтчета.Вывести(ТабДок);
	КонецЦикла;
	
	ПолеОтчета.ФиксацияСлева=2;
	ПолеОтчета.ФиксацияСверху=3;
	
	ПолеОтчета.Область(1, , 1).Видимость = Ложь;

	ПолеОтчета.УстановитьРастягиваниеПоГоризонтали(Истина);
КонецФункции

&НаКлиенте
Процедура ПолеОтчетаОбработкаРасшифровки(Элемент, Расшифровка, СтандартнаяОбработка, ДополнительныеПараметры)
Если ТипЗнч(Расшифровка) = Тип("СправочникСсылка.НомернойФонд") Тогда
	СтандартнаяОбработка = Ложь;	
	
	ОбменСГорничными = ОбщийФункционалСервер.ПолучитьЗначениеКонстанты("ОбменСГорничными");
	Если ОбменСГорничными Тогда
		ПараметрыФормы = Новый Структура("Номер", Расшифровка);
		ОткрытьФорму("ОбщаяФорма.СостояниеНомера", ПараметрыФормы, ЭтаФорма
			,,,,, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	Иначе	
		ОписаниеНомера = ОбщийФункционалСервер.ЗначениеРеквизитаНаСервере(Расшифровка, "ОписаниеНомера");	
		Если НЕ ЗначениеЗаполнено(ОписаниеНомера) Тогда
			ОписаниеНомера = "Описание номера отсутствует";
		КонецЕсли;
		ПоказатьЗначение(,ОписаниеНомера);
	КонецЕсли;	
КонецЕсли;		
КонецПроцедуры
