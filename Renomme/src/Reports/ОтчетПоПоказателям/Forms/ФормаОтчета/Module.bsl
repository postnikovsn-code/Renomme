&НаСервере
Процедура СформироватьКомандаНаСервере()
	//ЭлементыФормы.ПолеОтчета.Очистить();
	ПолеОтчета.Очистить();
	
	КолВоДней=Окр((КонецДня(Отчет.ДК)-НачалоДня(Отчет.ДН))/86400);
	ТарифРомантик=Справочники.Тариф_НеИспользуется.НайтиПоКоду("000000001");
	Заселяемость=ПолучитьПроцентЗаселяемости();
	Финансы=ПолучитьФинансы();
	КолВоДнейВых=0;
	ДТН=НачалоДня(Отчет.ДН);
	ДТК=КонецДня(Отчет.ДК);
	Пока ДТН<=ДТК цикл
		Если ДеньНедели(ДТН)>5 тогда
			КолВоДнейВых=КолВоДнейВых+1;
		конецесли;		
		ДТН=ДТН+86400;		
	КонецЦикла;
	
	//Макет=ПолучитьМакет("Макет");
	Макет = Отчеты.ОтчетПоПоказателям.ПолучитьМакет("Макет");
	
	Обл=Макет.ПолучитьОбласть("Шапка");
	//ЭлементыФормы.ПолеОтчета.Вывести(Обл);
	ПолеОтчета.Вывести(Обл);
	
	////Рез=Новый Структура("НомерДень,ЧеловекДень,НомерДеньВых,ЧеловекДеньВых,НомерДеньБезВых,ЧеловекДеньБезВых");
	
	Обл=Макет.ПолучитьОбласть("Строка");
	Обл.Параметры.Показатель="Процент заселяемости (номеров)";
	Обл.Параметры.Значение=Формат(?(КолВоДней=0,0,(Заселяемость.НомерДень/(КолВоДней*20))*100), "ЧДЦ=2; ЧГ=")+"%";
	//ЭлементыФормы.ПолеОтчета.Вывести(Обл);
	ПолеОтчета.Вывести(Обл);

	Обл=Макет.ПолучитьОбласть("Строка");
	Обл.Параметры.Показатель="Процент заселяемости (номеров) вар.2";
	Обл.Параметры.Значение=Формат(?(КолВоДней=0,0,(Заселяемость.НомерДень2/(КолВоДней*20))*100), "ЧДЦ=2; ЧГ=")+"%";
	//ЭлементыФормы.ПолеОтчета.Вывести(Обл);
	ПолеОтчета.Вывести(Обл);

	
	Обл=Макет.ПолучитьОбласть("Строка");
	Обл.Параметры.Показатель="Процент заселяемости (Человек)";
	Обл.Параметры.Значение=Формат(?(КолВоДней=0,0,(Заселяемость.ЧеловекДень/(КолВоДней*40))*100), "ЧДЦ=2; ЧГ=")+"%";
	//ЭлементыФормы.ПолеОтчета.Вывести(Обл);
	ПолеОтчета.Вывести(Обл);
	
	Обл=Макет.ПолучитьОбласть("Строка");
	Обл.Параметры.Показатель="Процент заселяемости (Ежедневный)";
	Обл.Параметры.Значение=Формат(?(КолВоДней=0,0,(Заселяемость.НомерЧас/(КолВоДней*20*24))*100), "ЧДЦ=2; ЧГ=")+"%";
	//ЭлементыФормы.ПолеОтчета.Вывести(Обл);
	ПолеОтчета.Вывести(Обл);
	
	Обл=Макет.ПолучитьОбласть("Строка");
	Обл.Параметры.Показатель="Процент заселяемости в выходные (номеров)";
	Обл.Параметры.Значение=Формат(?(КолВоДнейВых=0,0,(Заселяемость.НомерДеньВых/(КолВоДнейВых*20))*100), "ЧДЦ=2; ЧГ=")+"%";
	//ЭлементыФормы.ПолеОтчета.Вывести(Обл);
